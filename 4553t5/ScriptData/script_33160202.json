{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0046" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、隊長さん。奇遇ですねっ！　もしかして、隊長さんもここでトレーニ\nングをするんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204101" ]},
		{"command":[ "SETCHARA", "0", "char_00031602_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「だったら、一緒にトレーニングしましょう！　一人よりも二人の方が、楽し\nいと思いますよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204102" ]},
		{"command":[ "SETCHARA", "0", "char_00031602_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「えっ？　せっかくだから、二人で出来るトレーニングをしたい？　それはい\nいですけど……いったい、何をするんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204103" ]},
		{"command":[ "SETCHARA", "0", "char_00031602_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「んっ……あっ、あぅっ……！　あの、隊長さん……これ、本当にトレーニン\nグなんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204104" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「こんな格好で密着して……あんんっ！　た、隊長さんのオチンポが、オマン\nコにあたってますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204105" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「えっと、これはエッチなことだけど、体幹を鍛えるトレーニングでもあるん\nですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「こうした不安定な状態で、オマンコにオチンポを挿れて擦ると、いい刺激に\nなると……へー、そうだったんですねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「よーし。それじゃあ、トレーニングを始めましょうっ！　私のオマンコに、\nこの太くてカタいオチンポを挿れてくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　んっ、あっ！　ち、ちょっとっ！　なんでもう動いてるんで\nすかっ！　まだオチンポ挿れてませんよっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204109" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「いきなり挿れると怪我しやすい？　なるほど……まずはストレッチをして、\nオマンコをヌルヌルにするんですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204110" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「んっ、あっ！　うっ、んぅっ……！　あの……オマンコのストレッチが必要\nなのは分かったんですけど、どうして密着する必要があるんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「それにおっぱいまで揉んでっ……ひゃ、あうぅっ！　オマンコだけじゃなく\nて、おっぱいのストレッチも必要なんですかっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204112" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「いや、あの……別にイヤとか、そういうことじゃなくて……私、さっきまで\n運動してて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204113" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「汗をいっぱいかいたから、全身が濡れてて……それに、匂いもキツいと思う\nんですけどっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ふぇ……？　すごくいい匂いだから、ずっと嗅いでいたい？　それに、汗も\n舐めたいだなんて……ひゃ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「やっ、あっ！　そんなっ……！　オマンコスリスリされながら、首筋を舐め\nられたらっ……お、おヘソの下が疼いてっ……んぅぅぅ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204116" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はっ、はふっ！　あっ、はぁっ！　オマンコから、どんどんお汁が出てきち\nゃいますっ……オマンコぐちょぐちょになっちゃうぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「そろそろストレッチも終わりにして、本格的なトレーニングに入りたい……\n？　わ、分かりました……どうぞ、オチンポ挿れてくださいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204118" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「んんっ！　うっ、あぁぁぁっ！　オマンコに熱いのが、どんどん入ってきま\nすぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204119" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「私のアソコ、大きいので拡げられてっ……隊長さんのオチンポで、いっぱい\nになってぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204120" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「これ、すっごく気持ちいいですっ……！　気持ちよすぎて、ヘンな汗が出ち\nゃいますっ……あっ、あっ！　んぁっ、あはぁぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「お、おぉっ……奥まで、入ってぇ……！　オマンコキツいっ……これ、もう\n少しストレッチした方がよかったんじゃ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204122" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「今からたくさん動いて、オマンコをほぐしていくんですか？　は、はいっ…\n…お願いしますっ……オマンコ、オチンポでほぐしてくださいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204123" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ひぎっ、あっ、んぁっ！　ひゃ、あっうっ！　ぐぐっ、ふんぐっ！　ほっ、\nおっ！　ひんぎっ！　ふっぎゅうぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204124" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「オマンコズポズポされてますっ！　隊長さんのたくましいオチンポで、お腹\nの中をかき回されてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「それにおっぱいもぎゅーってされてっ！　あっ、あっ！　気持ちいいっ！　\nオマンコ気持ちいいですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204126" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「奥を突かれるたびに、子宮がきゅんってなって……こんなの初めてっ！　こ\nのトレーニング、かなり効いてる気がしますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「でも、こんな変態みたいな恰好……は、恥ずかしいですっ……んひゃっ！？\n　あっ、おっ！　また、首筋を舐められてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204128" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「もっと大きな声を出してたくさん感じれば、恥ずかしくなくなるんですか？\n　わ、分かりました……いっぱい、声を出しますねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204129" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あぁぁぁんっ！　あっ、ひっ！　んぎっ！　あっはぁぁぁっ！　おっ、おぉ\nぉっ！　ふぎっ！　んっぐっ！　あっひぃ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204130" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「オマンコ刺激されると、声が勝手に出ちゃうぅ！　隊長さんに捕まれてるか\nら、深くまでオチンポ刺さるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204131" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「こ、これ、ダメっ！　すぐにイッちゃうっ！　オマンコイッちゃうぅぅぅっ\n！　ひあっ、んっ、はっ！　あぁぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ひっぎっ！？　た、隊長さんのオチンポが、オマンコの中で暴れてっ……！\n？　も、もしかして、イキそうなんですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204133" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「な、膣内に出すのも必要なトレーニングなんですねっ！　なら、出してくだ\nさいっ！　私のオマンコに、いっぱいザーメン出してぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204134" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「おぉぉぉっ！　イグッ、イグぅ！　あっ、あっ！　隊長さんっ！　た、隊長\nさんっ！　私、イキますっ……！　オマンコイキますぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ぐっ、うぅぅぅっ！　お、お腹に熱いの注がれてますぅ！　隊長さんの精子\nが、子宮に流れ込んできてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204136" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、おっ、んぉっ！　精子受け止めながらイクの、気持ちよすぎますっ！\n　身体がビクビクって震えちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204137" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「背中からもっと汗が浮き出てっ……！　んんっ、あっ！　た、隊長さんっ！\n　そんなにくっつかないでくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「イッてるときに、ぎゅって抱きしめられたら……！　嬉しくて、もっとオマ\nンコ感じてっ……！　あっ、あんっ！　んっ、あはぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「幸せな気持ちが、汗と一緒に溢れてきちゃいますぅ！　あぁっ、好きっ！　\nこの運動、大好きぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204140" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はっ……ふっ、はぁぁ……イッてる時、身体がすごくフワフワして……バラ\nンスを保つの、大変でした」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「確かにこれは、いい体幹トレーニングですね……ただ、恥ずかしすぎて、人\n前じゃできないですけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204202" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ふぅ……隊長さんと一緒にトレーニングできて、楽しかったし、嬉しかった\nです。またこうして一緒に……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「えっ？　今度は私も腰を振って、オチンポを出し入れして欲しいんですか？\n　動きを合わせた方が、一緒に運動している感じが出ると？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204204" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「なるほど……かなり難しそうですが、やってみます。それでは、失礼します\nね……んっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ぐっ、あぅっ！　はぁ、あっ！　うっ、あんんっ！　隊長さんの上下運動に\n合わせるの、かなりキツいですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「動きが激しいし、不規則だし……オマンコの奥をオチンポが圧迫すると、下\n半身の力が抜けちゃいます……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「でもこれ、さっきよりも感じるっ……体幹だけじゃなくて、オマンコのお肉\nも鍛えられてる感じがしますぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、おぉぉっ！　んぉっ、おほぉっ！　動くたびに汗が飛び散って\n、いやらしい匂いがぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204209" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「やぁぁっ！　た、隊長さんっ！　そんなに激しく呼吸しないでくださいっ！\n　私の汗の匂い、嗅がないでぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204210" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はへっ？　汗だけじゃなくて、エッチな香りもする……？　だ、だって……\nこのトレーニング、気持ちよすぎるからぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204211" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「オマンコだけじゃなくて、全身が発情したみたいになって……！　オチンポ\nでズンズンってされるたびに、隊長さんがかっこよく見えてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「このトレーニングも、隊長さんも、どんどん好きになってきちゃうんですっ\n……！　ずっとこうして、一緒にトレーニングしたいですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ぐっ、んぅぅっ！　あっ、あふぅっ！　あ、赤ちゃんを作れば、ずっと一緒\nに居られる……？　そ、そんな、赤ちゃんだなんてぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204214" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「このままもう一度、膣内に出せば……絶対に妊娠できるんですか？　それは\n嬉しいですけど……ふぁ、あぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204215" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「でも妊娠したら、またチームを離脱しちゃうっ……！　せっかくマスカレー\nドのイエローとして、復帰できたのにぃ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「だけど、隊長さんとずっと一緒にトレーニングできるなら……妊娠するのも\n、いいかも……！　あっ、ひゃ！　んぎっ、ふぎゅうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204217" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あぁぁっ！　腰振りがどんどん速くなって……！　ま、また、イキそうなん\nですねっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204218" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「私も、もうイッちゃいそうでっ……！　あぁっ、もうっ！　気持ちよすぎて\n、わけがわからなくなっちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「おぉっ、ほっ、おぉぉぉっ！　イクッ！　イクぅっ！　オマンコイクッ！　\n隊長さんのオチンポで、イカされちゃうのぉぉぉ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204220" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_07" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「んぅぅぅ～～～っ！　また奥にっ……子宮に精液注がれてますぅ！　ドロド\nロのザーメン、どぴゅんされてるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「こんなに出されたら、本当に妊娠しちゃうっ！　あ、赤ちゃんできてっ……\nあうっ、あっ！　おっ、おほぉ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「妊娠するって思うと、幸せな気持ちが全身から溢れてっ……！　汗と一緒に\n、滲み出ちゃいますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ううっ、あっ、んぅぅっ！　隊長さんのオチンポ、まだ奥のところでビクビ\nク跳ねてっ……まだ射精してるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204304" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「私のこと、本気で妊娠させようとしてるみたいでっ……！　あぁあぁっ！　\nダメっ！　気持ちよくて、ヘンになるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「くっ、はぁぁっ……んっ、ふぅぅっ……子宮の中、隊長さんのザーメンでい\nっぱいですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204306" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「エッチなトレーニング……素敵でした。それに、こうして種付けまでしても\nらえて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「子供が産まれたら、家族みんなでトレーニングしたいんですか……？　そ、\nそんな……それはまだ、気が早いと言うか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204308" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「それに、私にはまだ、仮面戦隊マスカレードとしての役割が……あっ、あん\nんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……自分の子供を守るのも、お母さんの役目？　なるほど……\n確かに、その理屈は正しい気がしますね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204310" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ひゃうっ！　あっ、ああぁぁっ！　勢いよくイッたから、オチンポ抜けてっ\n……！　んっ！　ぐぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「これだと隊長さんとの赤ちゃん、作れないのに……！　あっ、ぐぐっ！　ふ\nっ、んっふっ！　はぁ、あっ、あぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204402" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「身体に熱いの、どぴゅどぴゅかけられてっ……！　こんなの、膣内に出され\nてないのに、妊娠しちゃいそうですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「隊長さんっ……！　私、精液かけらながらイッちゃいますっ……！　汗と精\n液の混じった匂いで、イッちゃいますぅ！", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「おっ、おぉぉぉっ！　イグッ、イグイグッ！　イッ、あっ……！　あぁぁぁ\nっ！　ふっぐぅぅぅ～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204405" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はっ……ふっ、はぁっ……えへへっ……身体中、汗と精液でベトベトになっ\nちゃいました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204406" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「いつもなら、早く着替えたいところですけど……もう少しだけ、隊長さんと\nくっついていたいですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はぁぁぁっ……それにしても、２回目も膣内に出されなくてちょっと安心し\nちゃいました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あ、いえ……別に隊長さんとの赤ちゃんが欲しくないとか、そういうことじ\nゃなくてですね……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0204409" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「せっかく皆のところに戻ったので、もう少しだけ、仮面戦隊マスカレードの\nイエローとして活動したいなって、思っちゃいました」", "NORMAL" ]},

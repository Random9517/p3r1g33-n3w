		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁぁぁ……からだ……震えが止まらない……あぁぁ……まだオチン\n　チン動いて、あひぁ……メロメロになりますう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁんっ、あっ、ラストスパートですかっ？　はひっ、大丈夫ですっ……\n　いっぱいっ、ウチのことっ、して下さいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「この逞しいオチンチンを満足させるのはっ、ウチのオマンコだけですからぁ\n　っ、あっ、あぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁ……あぁっ、また……中でっ、ビクってしてっ、主様も出ますかっ？\n　オチンチンっ……イキそうですかっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「いいですよっ、全部……全部出しきっちゃって下さいっ……ウチのオマンコ\n　……好きなように使ってっ、射精して下さいっ」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00000503_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、全部搾り出して下さいね……ウチの中に余らせずに……ぴゅっ……\n　ですよ？」", "NORMAL" ]},

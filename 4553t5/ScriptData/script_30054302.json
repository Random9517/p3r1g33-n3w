		{"command":[ "PLAYANIM", "0", "ev005_43b_0000", "ev005_43b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「あぁっ……オチンチンがっ、ぐぶってっ……ウチのオマンコっ……かき混ぜ\n　てますっ、く……ぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「きゃうっ、はぅっ、あっ、んぁぁっ！　作り変えられてっ……いきますっ、\n　ウチのオマンコがっ……オチンチンの形にさせられるぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁんっ！　ずりゅって……抜けていくのっ……ビクってなりますっ\n　……くぅぅぅんっ……あっ、はぁっ、あぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ま、また……入って来てっ……くぅぅぅっ！　あぁっ、体重乗せてっ……\n　めり込ませてぇっ……はひっ、これっ、あへぇぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁ……不思議な気分です。少し前までは、このように……抑え込まれるな\n　んて……屈辱でしかなかった筈なのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「今は……あぁっ、こうされることが……んんっ、はぁっ、嬉しくて……あぁ\n　っ、オチンチンっ……当たるっ、あひぁっ、あっ、あぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁっ、これっ、もっ、イクっ……あぁっ、オチンチンでっ、オマンコ\n　イカされちゃいますっ、はひっ、あっ、もうっ、おっ、おぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「イッてっ、いいですかっ！？　はひっ、ありがとうございますっ、あっ、\n　イキますっ、ウチのオマンコっ、もうイクぅぅぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETTEXT", "「んふぁっ……はぁっ……はぁっ……あぁぅ……すごい、れふ……頭が真っ白\n　になりますぅ……はぁぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「獣の姿は……本能の感覚が……研ぎ澄まされて……より、刺激を……敏感に\n　感じるようになるんれふ……だから、すごく……感じてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_43b_0000", "ev005_43b_0023", "true", "ALL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁっ！　あっ、あぁっ、またっ……んっ、はっ、オチンチンっ……動き始\n　めてっ、あっ、ぐちゅって……ひぁっ、あっ、あぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁっ、溢れてくるっ……ウチのエッチなお汁がっ……どんどん、漏れてっ\n　……止まらないですぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「はぁっ、んぁぁっ、はひっ、じゅくじゅくしてるのっ、オチンチンで掻き出\n　して下さいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチのオマンコっ……オチンチンに絶対服従しますっ、全部っ……全部っ、\n　主様のモノですぅっ、んはぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁっ、はっ、もふもふの所っ……撫でられるのいいっ、あっ！　あぁっ！\n　そんなっ、ここで優しくされたらっ、ウチはっ、またっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「はひぁっ、イクッ……イッちゃいますっ！　オマンコっ、し、幸せになりま\n　すぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁぁっ……あぁっ……ま、まだ……イッてるのにっ、オチンチン\n　止まらないっ、は、ひっ、いひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁっ、ビクってしてっ……出るんですねっ？　あはぅっ、はいっ、中にっ\n　……出して下さいっ！　オマンコに中出しっ……お願いしますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304135" ]},
		{"command":[ "WAITINPUT" ]},



		
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんぅぅぅぅぅーーーっ！　あぁっ……どぷって……来て、ますっ、せーえ\n　きっ、はひゅっ、ドロって……バカに、なるぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んはぁぁっ、ぴゅっぴゅって……お潮……出てるぅ……ひゃ、ふっ、出され\n　てるの……止まらにゃい……はへぇぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁ……は、ふぁ……ひゅみまへん……取り乱し……まひたぁ……あぁ……\n　んっ、ふっ……は、へぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「大丈夫……です……んっ、オチンチンが良すぎて……今は……その余韻を\n　味わっているところ……ですからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んふう……素敵でした……主様ぁ……ウチは……ずっと、ついて……いきま\n　すぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はふ……落ち着きました。まだ、少しクラクラしますけど……でも、平気で\n　す」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「貴方のオチンチンが満足しきっていないことは承知の上です。ですから、\n　ウチはお務めを果たさなくてはなりません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「いえ……その言い方は正確ではありませんね。ウチが……ウチのオマンコが、\n　まだしたいと……そう思っているんです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ですから、どうか……もっと遠慮なく、欲望を満たして下さい……あぁっ！\n　はひっ、またっ……奥にっ……来てっ、ますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304204" ]},
		{"command":[ "WAITINPUT" ]},



				
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_43b_0000", "ev005_43b_0023", "true", "ALL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁぁぁ……後ろから貫かれるの……あぁっ……すごい……ウチの本\n　能が悦んでしまってますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ゆっくりオチンチンが抜けていく時に……カリのところが……あっ、引っか\n　かるのが、す、好きぃ……ひゃ、うぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁっ……でもっ、その後のっ……ずぶって……は、入って行くときもいい\n　ですっ、全部……オチンチンっ、何でもいいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁんっ、ウチも……ちゃんとご奉仕します……オチンチンに満足して頂け\n　るように……んんっ、んふぅっ、オマンコ……ヒクヒクさせますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「ふぐっ、んんっ、くぅぅぅんっ……お尻っ、持ち上げてぇ……プルプル……\n　させてぇっ、あっ、あぁっ、んっ、はっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ど、どうですか？　ウチのオマンコ……ちゃんと、オチンチンにご奉仕出来\n　てますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、くぅぅ……よかった……んっ、嬉しいですっ、主様に……喜んで頂け\n　るのが……ウチの喜びでもあるのですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あ、あの……も、もし……よかったら……頭を……ナデナデしてもらっても\n　……いい、ですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふみゅぅぅぅぅっ……これぇ……あぁっ、好きぃ……主様にナデナデされる\n　のぉ……嬉しくてぇ……あっ、はぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「あっ、オチンチンもっ、また跳ねてっ……中をっ、グリグリって、あひぁっ、\n　ダメですっ、こんなのっ、何も考えられなくなるぅっ！」", "NORMAL" ]},

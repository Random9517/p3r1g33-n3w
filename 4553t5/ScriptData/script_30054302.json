		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「くぅぅぅん……あぁぁぁ……ぎゅって抱き締めて下さい……んぁぁ、中出し\n　されながらくっついているの……素敵ぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あふっ、子宮がトロトロにされてます……はぁぁ、これは……赤ちゃん出来\n　てるかも知れません……ウチ……ママになっちゃう……」", "NORMAL" ]},

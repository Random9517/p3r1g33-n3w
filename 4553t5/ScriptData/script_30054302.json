		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_01" ]},
		{"command":[ "SETTEXT", "「あ……ぅ……これで……いい、ですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304101" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「も、もちろん恥ずかしいです……こんなにも無防備に……貴方に恥ずかしい\n　姿を晒しているんですから……身体が燃え上がりそうな位です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304102" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ですが、ウチはもう覚悟を決めていますから……貴方でしたら、ウチはどう\n　されてもいいと……そういう気持ちでいるんです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……は、はい……お尻でも、どこでも……好きなように触って\n　頂いて構いません……今のウチは、貴方のモノですから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、あぁ……さすられてる……ひゃぅぅぅ……ゾクゾクしますっ、んくぅ\n　……はぁぁっ、あっ、ふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「これは……んっ、入れる……準備をなさってるんですよね？　あぁ……指先\n　の感触を……いつもより、はっきり感じます……んぁ……ふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「は、はい……指も……いいです、よ……んんっ！　あぁっ、中……カリカリ\n　……引っ掻いて……あっ、い、いいですぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぅ……はい、濡れてしまってます……今日一日、ずっとこうなるって思っ\n　て……そうすると自然にじゅくって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ……音させて……んくぅ……あ、あんまり……遊ばないで下さ\n　いっ、ウチはっ……ずっと切ないのですっ、あぁっ、んっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「も、もう……意地悪はイヤです……貴方のオチンチンも、カチカチになって\n　……おへそまで反り返ってるじゃないですかぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチも同じです……はぁ……んっ、オマンコ……待ちきれないんですからぁ\n　……早く……中っ、熱くて太いのぉっ……深くにお願いっ、しますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁぁぁぁぁぁぁーーーーっ！　あっ、来たっ……はひぁっ、入って来まし\n　たっ……オチンチンがウチのオマンコっ……広げてっ、ますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ……そんな、ずぶって……い、一気に奥……までぇっ……こ、こん\n　なぁ……は、ひぁぁぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んくぅぅぅ……あぁ……ぜ、全部……入ったんですか？　は、はひぃ……\n　オマンコいっぱいになってるの……感じ、ますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あ、あの、動くのは……後ちょっとだけ待って……下さい……んんっ、オマ\n　ンコ……敏感になり過ぎて……あ、危ないです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふぅぅぅ……はぁぁぁ……はい、これで……大丈夫です。む、無理してま\n　せん！　ちょっと準備時間が欲しかっただけですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はい……もう気にせずに動いて……あっ、んひぃっ！　あぁっ、はっ、あっ、\n　んぁぁぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_0304117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000503_02_05" ]},
		{"command":[ "WAITINPUT" ]},




		{"command":[ "SETNAME", "オボロ" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁぁぁぁぁーっ、またイクッ……はっ、ひぃぃぃっ！　オマンコまたっ、\n　イキますぅぅぅぅぅっ！」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_02" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「やっ、イヤっ……！　皆の前でこんなエッチな恰好させられるだなんてっ…\n…は、恥ずかしすぎるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304101" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「でも、従わないとカツマさんがひどい目に遭っちゃうっ……何とか耐えない\nとっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んんっ！？　な、なにっ？　熱くてカタいモノがオマンコにあたってっ……\nえっ、これ、まさかっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304103" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「きゃあぁぁぁっ！？　カ、カツマさんのオチンポがオマンコにあたってるっ\n！　もしかして、オチンポを挿れようとしてるのっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304104" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「イヤッ！　イヤぁっ！　お願い、カツマさんっ！　操られてないで、正気に\n戻ってっ！　いつもの優しいカツマさんに戻ってぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっ……カツマさんは私を犯したがってる？　早くオマンコにオチンポを挿\nれて、ズポズポしたいと思ってるだなんてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304106" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「そんなのウソだよっ！　これは貴方がカツマさんを操ってるから、そう思わ\nせられてるだけでっ……んひゃあぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304107" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっ……やぁっ……！　オマンコの入口が、オチンポで開かれてるっ……ホ\n、ホントに入っちゃうっ……皆の見てる前で、犯されちゃうぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっ……あぐっ！？　オチンポが一気に奥まできてるっ……！　オマンコ、\nいっぱい拡げられてぇ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304109" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「く、苦しいよぉ……！　内臓が圧迫されてるみたいでっ……ひゃ、あがっ！\n？　お、お腹、押しつぶされちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304110" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……！　ふっ、んっくっ……！　お、お願いっ……オチンポ抜\nいてっ……！　無理やりセックスしないでぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304111" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ！　あぁんっ！　奥のところで、オチンポがもっと大きくなって\nるっ！　私の子宮口に届いちゃってるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「酷いことされてるのに、オマンコ感じちゃうっ……！　私の子宮、悦んじゃ\nってるっ……！　な、なんでぇ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304113" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「な、なにっ？　いっぱい動いて、もっと気持ちよくしてやるですって？　ヤ\n、ヤダっ！　動かないでっ！　動くのダメなのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304114" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あんんっ！　あっあっ、ひっ、あはぁぁっ！？　オチンポがオマンコの膣内\nで擦れてるっ！　ズポズポされてるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「出し入れのたびに、オチンポの出っ張りがオマンコのお肉と絡み合ってっ…\n…はひぃぃんっ！　こ、これ、気持ちよすぎるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304116" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んぁ、あんっ、あはぁぁんっ！　奥のところズンズンされると、エッチなお\n汁が出ちゃうっ！　オマンコヌルヌルになっちゃうよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ふぇっ？　見られながら犯されてヨガるなんて、変態みたい……？　ち、違\nうっ！　私は変態なんかじゃっ……あひぃぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304118" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「気持ちいいところを刺激されて、声が出てるだけなのっ！　犯されるところ\nを皆に見られて、感じてるわけじゃないからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっはぁぁぁっ！　あんっ、あぁんっ！　んっ、んぐぅ！　深いところだけ\nじゃなくて、浅いところも擦られてるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304120" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「クリトリスの裏側のところっ……Ｇスポットのあたりを亀頭で突かれてっ…\n…そ、それダメぇ！　気持ちよすぎるからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「そこ、私の弱点なのっ！　すごく敏感なところで……オマンコが悦んじゃう\nところなのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304122" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「だからもう擦らないでっ！　違うところなら、好きなだけスリスリしていい\nからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んひぃぃっ！？　ま、また奥にオチンポが入ってぇっ！？　あっあっ、ふぁ\n、あっ！　そ、そこもダメっ！　奥も弱いのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304124" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「深いところも浅いところも、どっちも気持ちいいよぉ！　ふぐっ、んっ、ん\nっふっ！　あっ、もうイヤっ！　オチンポイヤぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304125" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「もう気持ちいいのいらないから、オチンポ抜いてっ！　私のこと気持ちよく\nしないでっ！　あ、頭がおかしくなっちゃうからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んひぃぃぃ～～～っ！？　オ、オチンポがもっと奥までっ……わ、私の子宮\n、押しつぶされてるっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！？　なに、これっ……！？　さっきまでとは、全然違うっ……\n！　気持ちよさの中に、幸せな感じが混ざってるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304128" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「子宮の入口が、どんどん開いてる感じがするっ……！　もしかして、私の子\n宮口がどんどん緩んでるのっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ふぇ……？　こ、このまま膣内で射精する……！？　ま、待ってっ！　今、\n私の子宮口、すっごく開いちゃってるのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304130" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「こんな状態で膣内に出されたらっ……せ、精子が子宮に入っちゃうっ！　あ\n、赤ちゃんできちゃうからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「このままカツマさんの子供を妊娠しろって……！？　そ、それは嬉しいけど\n、こんな状況で妊娠なんてしたくないよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「イヤっ！　イヤぁぁぁっ！　お願いだから、膣内に出さないでっ！　妊娠す\nるなら、普通に愛し合ってからにしてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304133" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ひぎぃ！？　がっ、あっ、おぉぉっ！？　オチンポがどんどん膨らんでっ…\n…や、やめてっ！　本当に膣内だけはっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304134" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「イヤっ……イヤイヤっ！　イヤぁぁぁーーーっ！　皆が見てる前で孕むのイ\nヤなのぉ！　抜いてっ！　オチンポ抜いてぇぇぇーーーっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「おほぉぉぉ～っ！？　おっ、おぉぉっ……熱いの、どぴゅどぴゅ出てるっ…\n…！　子宮口にオチンポ押し付けられてるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304136" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_09" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「おヘソの下のところに、液体みたいなのが溜まってるっ……！　ウソっ……\nほ、本当に膣内に出されてっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「赤ちゃんできちゃうっ……！　カツマさんの子供は嬉しいけど、こんなふう\nに孕まされるだなんてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ひっ、あっ！？　あっ、あんんっ！　なんでっ……急に幸せな感じが強くな\nってっ……あっ、イクッ！　オマンコイクッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「無理やり妊娠させられてるのに、嬉しくてイッちゃうっ！　あっ、くるっ！\n　すごいのきちゃうよぉぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「はっ……あっ、ふぁぁぁっ……オマンコの膣内っ……ドロドロになってるっ\n……精子でめちゃくちゃにされてるよぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「早くオマンコ洗わないとっ……このままだと、本当に受精しちゃうっ……カ\nツマさんの赤ちゃん孕んじゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304202" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっ……？　まだ終わりじゃないっ……？　もっと犯してやるから、覚悟し\nろって……ウ、ウソっ。今、射精したのにっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304203" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「妊娠するまで犯されるか、貴方に屈して服従するか選べだなんてっ……！　\nそんなの、どっちも選べるわけないよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「第一、私は絶対に貴方には屈しないわっ！　人の身体を操って酷いことをす\nるような悪者に、私は負けないんだからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304205" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「屈さないなら、このまま犯し続けて確実に孕ませてやる……？　や、やめて\nっ！　もうこれ以上、カツマさんの身体を使って酷いことしないでぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっぐっ！？　うっ、あぅっ！　んんっ、んっふぅ～っ！　ま、またオチン\nポが激しく出し入れされてるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304207" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「今度は深いところと浅いところを、交互に擦ってきてっ……！　あんんっ！\n　私の弱いところばっかり責められてるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304208" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっ、あんっ！　あんんっ！　気持ちよくなるのダメなのに、我慢できない\nっ！　エッチな声、皆に聞かれちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっあっ、ひっ、あひぃっ！　オマンコからずっと、ぐちゅぐちゅっていや\nらしい音がしてるっ！　精液と愛液がオチンポでかき回されてるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304210" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「オマンコだけじゃなくて、耳まで犯されるみたいでっ……ひっ、あっ、おぉ\nぉっ！　し、子宮が降りてきちゃうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「私のオマンコが妊娠したい、孕みたいって言ってるっ！　イヤなのに、身体\nが否定できなくなっちゃってるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304212" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んぁぁっ、あんっ！　あっ、あはぁぁんっ！　悔しいのに感じちゃうっ！　\n気持ちいいので、頭ダメにされちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304213" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「私は皆を守るために産まれた、正義の変身ヒロインなのにっ……このままだ\nと、オチンポ大好きな変態さんにされちゃうよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、あっあっあっ、んひぃぃぃ～っ！？　お、奥を執拗にトント\nンしないでっ！　赤ちゃんの部屋の入口が、もっと開いちゃうからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304215" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……ま、また膣内に出してやるですって……！？　イヤッ！　イ\nヤぁぁぁっ！　もう膣内出ししないでっ！　精液注がないでぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304216" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ふっ、うぅっ！　んっふっ！　うっぐぅっ！　カ、カツマさんっ！　こんな\n悪者に負けないでっ！　意識を強く持ってっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「貴方がここで諦めたら、私、本当に妊娠しちゃうんだよっ！？　皆の見てる\n前で、孕まされちゃうんだよっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「だからお願いっ……正気に、戻ってっ……！　あっあっ！　あんっ、あぁぁ\nっ！　オチンポ、また膨らんでっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ぐっ、あっ！　あぅ、んぐぅぅっ！　お、お願いっ！　私のことを想い出し\nてっ！　いつものカツマさんに戻ってぇぇぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「おぉぉぉぉっ！？　おっ、おぉっ……また、膣内にっ……！？　子宮にザー\nメン注がれてるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「うっ、うぅっ……どうしてっ……カツマさんなら、正気を取り戻してくれる\nと思ったのにっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっ、あひっ！？　おっ、んおぉぉっ……！　まだ出てるっ……精子が勢い\nよく、子宮にどっぴゅん出てぇ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「お腹の中、熱いよぉ……！　うっ、うぁぁっ……私、本当に孕まされてっ…\n…赤ちゃん、妊娠しちゃうぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……あ、えっ……？　射精中のオチンポが、奥じゃなくて浅い\nところにっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304305" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「もしかして、カツマさんが悪者から、身体を取り戻そうとしてるのっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「それなら、私もお手伝いしないとっ……！　頑張って、カツマさんっ！　身\n体を取り戻せたら、私、何でもしてあげるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「いっぱいエッチしてあげるし、オマンコだけじゃなくて、お口やお尻の穴だ\nって使っていいからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「それに貴方が望むなら、このまま妊娠してあげてもいいよっ！　だからお願\nいっ……もとに戻ってっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あんんっ！　オチンポがどんどん抜けていくっ……やったっ！　悪者に打ち\n勝ったんだね、カツマさんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっはぁぁぁんっ！　あ、熱いぃ！　ドロドロしたお汁を、身体中にかけら\nれてるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっ……これ、もしかしてザーメンなのっ！？　ど、どういうことっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304402" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっ……！　オチンポが抜けてるっ！　さっきまで、オマンコの膣内に入っ\nてたのにっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「もしかしてカツマさん……悪者に乗っ取られてた身体を、乗っ取り返したの\nっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あんんっ！　す、すごいっ！　さすがはカツマさんっ……！　あっ、あぁっ\n！　でも、射精止めてっ！　ザーメンかけないでぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304405" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「こんなにどぴゅどぴゅされたら、私っ……精子の感触だけでイッちゃうっ…\n…あっ、あっ！　イクッ！　イクぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ふぅ……ふぅ……んっ、あぅっ……オマンコも身体も、精子でベトベトにな\nっちゃいましたっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304407" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっ？　こんなことになって、本当にごめん？　妊娠した時は、ちゃんと責\n任を取る？　そ、そんなっ！　責任だなんてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「カツマさんが元に戻ってくれただけで、じゅうぶんですっ……頑張って耐え\nた甲斐がありますねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304409" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「でも、本当に責任を取ってくれるっていうなら……今度は誰も見てないとこ\nろで、エッチしてくださいね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0304410" ]},

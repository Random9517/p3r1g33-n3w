{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0200" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00000532_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev005_32b_0000", "ev005_32b_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「さて……尋問の時間になりましたですね。今日も、お務めを果たさなければ\nなりません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204101" ]},
		{"command":[ "SETCHARA", "0", "char_00000532_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「楽しそう？　何をバカなことを。ウチは与えられた看守としての仕事に真剣\nに取り組んでいるだけですよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204102" ]},
		{"command":[ "SETCHARA", "0", "char_00000532_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「シミュレーション……そうですね。もちろん、貴方が本当に罪を犯したわけ\nではありませんが、だからと言って適当にしたのでは意味がありません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204103" ]},
		{"command":[ "SETCHARA", "0", "char_00000532_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「尋問も、厳しく行う……それでこそ、シミュレーションの効果があります。\nと言うわけで、両手を拘束しちゃいますよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204104" ]},
		{"command":[ "SETCHARA", "0", "char_00000532_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「これじゃ看守じゃなくて女王様……？　ふふん、それも悪くないんじゃない\nですか？　囚人にナメられているようでは話になりませんから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「さて……ふふ……なかなかいい格好ですね。こんな無防備な姿で拘束されて\n……気分はいかがですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「恥ずかしい？　ふふん……気が早いですよ。恥ずかしくなるのはこれからか\nも知れませんからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「さて……それじゃあ、吐いて貰いましょうか。一体、何を隠しているんです\nか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「心当たりがない……？　へぇ、何も隠していないということですか？　本当\nに？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ええ、シミュレーションですよ。でも、人には言えない秘密の一つや二つく\nらい、必ず隠しているものですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「おや……言えませんか。ふふ……まあ、そういうとは思っていました。とな\nれば、直接身体に聞くしかありませんねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ほぉら……オチンチンが出ちゃいましたね。こんな無防備にポロンとさせて\n……恥ずかしくないんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふ……意地を張りますね。そんなに聞き分けのない囚人さんには、やはり\nちゃんと指導をしてあげなくては」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ほら、このお尻に当たってるの……分かりますか？　ふふ、貴方の勃起には\n及ばないかも知れませんが……まぁまぁ大きいサイズですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なかなか素直になれませんし、それなら、身体に直接聞いてあげるのが一番\nですよ……ねっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「くぅん……ふふっ、どうですか……？　あまり、こっち側を使う経験……あ\nりませんよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「かなり窮屈で……これは、開発しがいのあるアナルですね……んふふっ、大\n丈夫、最初は優しくしてあげますからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もちろん、貴方の態度如何では、ちょっとキツくなってしまうかも知れませ\nんが……んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「おやおや……これはこれは……さっきより、オチンチンがビンって勃起して\nきてますねぇ……ちゃんとそっちの気もありましたか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふっ、それじゃあ……こっちも一緒にしてあげましょうか。ぎゅっと握っ\nて……かるーくシコシコ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204120" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_32b_0000", "ev005_32b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ダメですよ？　どこへも逃げられませんからね。そんなにお尻を振っても、\n手は離れませんから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ほら……くにゅくにゅ……シコシコ……どんどんオチンチン……大きくなっ\nて、感じやすくなってますね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「どうですか、自分の恥ずかしい思い出とか……話してみる気になりませんか\n？　それとも、今はやめてほしくなかったり……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふ……そうですね、一回休憩しましょうか。と言っても、ちょっとオチン\nチンを休めてあげるだけです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「他にも貴方の弱そうなところいっぱいありますからね……この乳首とか……\nこうして、コリコリ……押しつぶしてあげたり……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「軽くつまんで……クリクリ……転がしてあげたり……あららぁ、乳首もすご\nく感じやすいみたいですねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ほんの少し触ってあげるだけで、こんなにビンビンにさせて……ウチが何を\nしても、全部気持ちよくなっちゃうんですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「せっかくですし、お尻の穴も……いっぱい開発してあげましょうね……ほぉ\nら……もっと深いところまで届いちゃいますよ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んふっ、可愛い声を出すじゃないですか……日頃、女の子たちをヒィヒィ言\nわせてるのに、いざ自分がされると同じになっちゃうんですねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もっと奥がいいですか？　いいですよ……貴方の知らない世界を、看守のウ\nチがたっぷり教えてあげますから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「囚人は看守に絶対服従……逆らえば、どんな怖い目にあうか……分かりませ\nんものねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204131" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はい……またシコシコしましょうね……えっ、そんな余裕はない？　ここで\n扱かれたら、もう出ちゃいそう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふっ……それはダメですよ……オチンチン……簡単にイカせちゃったら、\nご褒美になりますから……これはあくまで尋問なんです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もしイキたかったら、ちゃんと言うんですよ。気持ちいいオチンチン、イカ\nせてくださいって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「じゃないと、ずっと生殺しのままジワジワ攻め続けてあげますからね……さ\nあさあ、どうしますか？　このまま……ひゃっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ……お尻の刺激だけで出しちゃったんですか……？　こんなに節操なく\n、ビュクビュク出して……本当に仕方ない人ですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204136" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふ……身体をビクビク震わせて……こんなにアナルにハマってしまうなん\nて変態さんですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「汚い噴水を見せられるウチの立場にもなってくださいよ……全く、気持ちよ\nさそうな顔をして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふぅ……落ち着きましたか……あぁ、もうベトベトですよ。油断も隙もあり\nませんね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「呆けた顔をして……そんなにオチンチンがよかったんですね。全く……これ\nだから、欲望に忠実なおサルさんは困ります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「でも……ウチの許可なく、勝手にイッたのはいただけませんねぇ……いくら\nお尻が気持ちよかったとしても、許されることじゃありません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「と言うわけで……ふふっ、またお仕置きですよ。このまま続けて、お尻をペ\nニバンで掘ってあげますから……んっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ……！　ほぉら、だいぶ後ろの味もこなれてきたんじゃありませんか\n？　すごくゾクゾクするでしょう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204203" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_32b_0000", "ev005_32b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「乳首も、こんなにピンとさせて……女の子みたい。男娼の素質がありますよ\n……ふふっ、れろっ……首筋に脂汗が出ちゃってます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「恥ずかしい過去を言う気になりましたか？　でも、今はいいです。ふふっ、\nどうしてかって？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「決まってますよ……貴方を責めてあげるのが……んっ、楽しくなってしまい\nましたから……ねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁっ……んっ、お尻の肉が、ピンと強張って……ペニバンにも気持ちいい\n刺激が届いて来ています……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ……ウチのオマンコにも連動して……ふふ、こんな反撃をしてくるなん\nて……生意気な囚人ですね……んっ、くぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こうなったら、また、このオチンチンにもお仕置きをしてあげなくちゃなり\nませんね……ほぉら……ぎゅうっと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あははっ、なんですかこれ。一発出しておきながら、前よりもっと勃起して\nるじゃないですか。もうすっかり、クセになってますねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「いいですよ、まーたシコシコしてあげましょう。でも、すぐに射精したらキ\nツーいお仕置きですよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ほら……ずりずり……ずぶずぶ……ふふっ、ピストンももう少しスピードア\nップしていきますからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「聞こえてますか？　このぐちゃって恥ずかしい音……貴方のアナルが、ペニ\nバンを咥えこんで擦り上げてる音が響いてるんですよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「恥ずかしくて……情けなくて……それでも、感じちゃうんですよね？　ふふ\n……本当に仕方ない人です。変態……変態……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁ……ウチも盛り上がって来ました……もっとじわじわ嬲ってあげたかっ\nたですけど、これは……もう止まりませんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204215" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ……また無様にイクところを見せてもらいましょう……今度はち\nゃんと、射精する時に言うんですよ、分かりましたか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「じゃないと、止めますよ？　いいんですか？　ここまで来て、生殺しのまま\n、ずっとイクにイケない状態でいますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふっ、そうですよね。貴方が、そんなに我慢できるようなたちじゃないこ\nとは、ウチはとっくにお見通しですから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「いいですよ、ちゃんと言えたご褒美に、思い切りイカせてあげますっ。たっ\nぷりアナルを責めながら、オチンチンを扱いてあげますからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「さあイキなさいっ、無様に射精するところをウチに見せるんですっ、ふんっ\n、はぁっ、んくぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ……！　ふふっ、ウチの手にまた新しいのがたっぷり出ていますよ…\n…看守の手を汚させるなんて……ダメな囚人ですねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「２発目だと言うのに、こんなに出して……ウチの手コキがそんなによかった\nんですね……可愛いですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふっ、今更手を動かしたって、ここから逃げられはしませんよ。観念して\n、全部出してしまうんです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そうそう……最後まで見ていてあげますからね……これも看守の務めという\nやつです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「さて……どうやら出し切ったみたいですね。ふぅ……ウチとしたことが、思\nわず職務を忘れて見入ってしまいました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「貴方もよかったんじゃないですか？　普段味わえない非日常を体験できたの\nですから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「それで……なんでしたっけ。ああ、結局恥ずかしい過去を喋るってことでし\nたっけ。何か喋る気になりましたか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なんか、どうでもいい風になってる？　まぁ……実際のところ、そこまで興\n味はないというか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「一応、お仕事的にはこんな感じだろうという雰囲気で、ここまで来てしまっ\nたので……とりあえず、釈放でもいいですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETIMAGE", "0", "sbg_0000" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETTEXT", "結局、看守というものの役割をもう少し学んだ方がいいということで、シミュ\nレーションは中止になったのだった。", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204310" ]},
		{"command":[ "DISPNAME", "FALSE" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あふっ！　ふふっ、そうです……ウチにもっと見せるんです。貴方の情けな\nい射精ショーを晒してしまうんです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「すごいですね……オチンチンがビクビク震えて……へぇ、間近で見ると射精\nのメカニズムがよく分かりますねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふ……恥ずかしいですか？　でも逃げられませんよ。」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そうそう、観念してウチに一部始終を見せてしまいなさい。それが囚人とし\nて、せめてもの罪滅ぼしというやつですからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふむ、いっぱい出しましたね……流石に、これだけ出したらもう打ち止めで\nすか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふ……うっとりした顔をして……まるでメスじゃないですか。もっとも、\nオチンチンはしっかり付いてますけどね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そう言えば、これはシミュレーションでしたか。ちょーっとやり過ぎちゃっ\nたかも知れませんねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「まあ、ウチとしては看守の務めというものを精一杯に果たそうとした結果、\nこうなってしまったということで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「とりあえず釈放でいいですよ。もう飽きたとか、そういうことではありませ\nんから、一応」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3204409" ]},
		{"command":[ "SETIMAGE", "0", "still_00000532_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETIMAGE", "0", "sbg_0000" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETTEXT", "結局、看守というものの役割をもう少し学んだ方がいいということで、シミュ\nレーションは中止になったのだった。", "NORMAL" ]},

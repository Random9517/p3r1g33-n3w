		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「れ、れひたら……ティッシュを用意ひまふかりゃ……！　そ、そちらに、出\nひへっ……ちゅばっ……！　ぐっちゅ……んぷちゅうぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},

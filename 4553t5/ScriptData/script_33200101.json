		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あ、あにょ……！　これ、もう１回射精する気れふかっ……！？　わ、私…\n…お掃除してりゅらけらのにっ……！」", "NORMAL" ]},

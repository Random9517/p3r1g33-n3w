		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ひゃうっ！？　あ、熱くてドロドロしたお汁が、顔にっ……！　ひ、ひどい\nですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ……！　ま、まだ出てるっ……！　精液が髪にも飛び散ってます\n……！」", "NORMAL" ]},

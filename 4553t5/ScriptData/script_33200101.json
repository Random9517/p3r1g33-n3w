		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「とても、いい匂い……ですっ……で、では……ご奉仕をさせていただきます\n……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103103" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「……えっ？　始める前に、今から何をするのか……ちゃんと説明しないとい\nけないんですか……？　はい……分かりました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103104" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「今から……こ、これを口に咥えて、ご奉仕をします……たくさん舌で舐めて\n……気持ちよくします……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「これとか抽象的な物言いじゃなくて……もっと卑猥な言葉遣いで、はっきり\nと名前を言わないとダメなんですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ちゃんと言わないと、もっと酷いことをするだなんて……うぅぅっ……！　\nはい……ちゃんと言います……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103107" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「え、えっと……あ、あなたの熱くて……カタい、オ、オチ〇チンを舐めっ…\n…いえ……フェラチオを、させていただきます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103108" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「口に咥えて、たくさんご奉仕します……あなたが気持ちよくなれるように、\n頑張ります……それでは、失礼しますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「んっ……ちゅ、くっ、ちゅっ……ぺろっ……んっ、ちゅるっ……ぢゅ、るっ\n……ちゅ、くちゅ……ちゅっぷっ……ちゅ、ちゅぱぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103110" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ぐっ……んっぶっ……ふぇ？　オチ〇チンにょ味は、どうかっへ……そんな\nこひょ、言えませんっ……きゃぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103111" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「や、やめへっ……！　ちゃんと言いますかりゃ……お、怒らないれくらはい\nっ……！　くぷっ……れっ、ぢゅ……んちゅるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ぷはっ……はぁ……はぁ……あ、あなたのオチ〇チンは……とても、しょっ\nぱいですっ……舌で触れてると……ピリってしますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103113" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「それと……先っぽのところが、ちょっと苦くて……お、おしっこの匂いもし\nますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「……オチ〇チンの周りだけじゃなくて……先っぽの割れ目に舌を入れて、ホ\nジるように舐めまわせって……そ、そんな……ここ、汚いのに……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103115" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ひぅっ、や、やりますっ……！　ちゃんとオチ〇チンの先っぽ、舐めますっ\n……！　だから、痛いことしないでくださいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103116" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ぐすっ……うっ、あぅぅっ……そ、それでは……先っぽのところも……綺麗\nにしていきますね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103117" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「くちゅ……んっ、ずっりゅ……れっ、ろっ……じゅぐっ……んっ、ちゅくぷ\nっ……ちゅ、んむっ……ちゅぷっ……ちゅるるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ、はむっ……んふっ、ちゅぐぐっ……！　もっひょ激しく……擦るよう\nに、舌を動かすんれふか……？　はひ……分かりまひた……」", "NORMAL" ]},

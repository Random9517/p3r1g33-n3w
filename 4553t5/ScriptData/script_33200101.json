		{"command":[ "SETIMAGE", "0", "still_00032001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「れろっ……ちゅろろっ……！　ぐちゅ、ぷっ……あむむっ……！　ぐちゅ、\nちゅ……！　にっ、ぢゅるっ……くちゅ……！　じゅ、じゅぷぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103120" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ぐっぷっ……ぷっ……！　はうぅっ……！　ネバネバひたお汁が……舌に絡\nまっへきまふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103121" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「そりぇが……私にょ唾液と合わさって……ちゅ、くぢゅぷっ……！　もっひ\nょ、濃い匂いにっ……んっ、むっ……！　はむっ、ぢゅぷぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「くぷっ……ちゅ、んぷぷっ……！　ふぇ……？　舌を動かすらけじゃなくへ\n……唇を押し付へて、オチ〇チンを吸ったりすればいいんれふか……？」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00032001_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「んむぅっ……くむぅぅぅっ……！　オチ〇チンが膨らんれ……お、大きく跳\nねてりゅっ……！　ちゅ、ちゅるっ……んちゅぱっ……！」", "NORMAL" ]},

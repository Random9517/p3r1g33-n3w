		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ぐ、ぐるじいれふっ……！　ちゅ、ちゅるるっ……！　私にょ口……唾液と\nあなたにょお汁まみれで……！　ぐっ、ちゅぐぷっ……！」", "NORMAL" ]},

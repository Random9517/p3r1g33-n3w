		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ぐすっ……うっ、うぐっ……！　ご、ご満足、いただけたでしょうか……？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103201" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「……えっ？　射精をしてもらったことに対して、お礼を言えって……はい…\n…申し訳ありません……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「し、射精していただき……ありがとうございます……私のご奉仕は、いかが\nでしたか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103203" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「技術としてはまだまだですが、射精できるくらいには気持ちよかったんです\nね……悦んでいただけて、何よりです……」", "NORMAL" ]},

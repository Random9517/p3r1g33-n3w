		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「どうして、顔にかけるんですかっ……！　匂いが染みついて……取れなくな\nりますっ……！　んっ、んんっ……！」", "NORMAL" ]},

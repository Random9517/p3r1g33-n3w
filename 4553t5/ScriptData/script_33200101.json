		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「息が……れきなっ……じゅるっ……！　ちゅ、ちゅぞっ……！　んべろっ…\n…れりゅ、くぷっ……！　はむっ、んっむっ……ぐむむぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「んっ……んぅぅっ……！？　オチ〇チンが……ビクビク跳ねまわっへまふっ\n……！　ネバネバひたお汁が、飛び散ってりゅ……！」", "NORMAL" ]},

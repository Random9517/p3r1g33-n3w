		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「んっ……あぅっ……！　あぁっ、あっ……あふっ……！　はぁ……あっ……\n！　精液で、こんなに汚されるなんてっ……！」", "NORMAL" ]},

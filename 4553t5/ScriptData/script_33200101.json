		{"command":[ "SETIMAGE", "0", "still_00032001_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「は、はい……分かりまひた……オチ〇チンを吸わへてきたらきまふっ……ち\nゅ、ちゅるっ……！　んっ、じゅるっ……ちゅるぅ……！」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00032001_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「そろそろ、イキそうって……ちゅぶっ……！　くっ、ぢゅぐっ……！　も、\nもしかひて……射精しゅるんれふかっ……！？」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00032001_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「うぅぅ～っ……！　顔にかけらりぇたいか、口の中に出されひゃいか選べら\nなんてっ……！　そんらの、選べないれふっ……！」", "NORMAL" ]},

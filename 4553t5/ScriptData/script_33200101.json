		{"command":[ "SETIMAGE", "0", "still_00032001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「うぐっ……！？　んむぅ～～～……！？　しょんら、無理やりっ……！　や\nっ、いぁぁっ……！　ちゅ、ちゅぱっ……！　ぐちゅ、んくぅ……！」", "NORMAL" ]},

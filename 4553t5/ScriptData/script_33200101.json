		{"command":[ "SETIMAGE", "0", "still_00032001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「んぷっ……んっ、くっぷっ……！　ぢゅ、ちゅちゅっ……！　ずっ、じゅ、\nぞっ……れりゅ、れろっ……じゅくぷっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0103125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ぷはっ……！　はっ、はっ……ふっ、はぁ……！　や、休まずにずっとオチ\nンチ〇吸い続けろって……ずっとは、苦しいですっ……！」", "NORMAL" ]},

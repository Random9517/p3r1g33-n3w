		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あぷっ……くぷぅ……！　本当に、苦しいれふっ……！　やっ、いやっ……\n！　あっ、んぷっ……んふぅ……！？」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「イ、イキそうなのっ！？　また私に向かって、エッチな子種をどぴゅどぴゅ\nしてくれるのっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604219" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ふぇっ！？　私を孕ませてるって思うと、射精が止まらなくなっただなんて\nっ……！？　そ、そんなこと言われたらぁ……！」", "NORMAL" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「だから、もっと押し込んでっ！　赤ちゃんの部屋にオチンチン入ってもいい\nから、もっともっと、激しく圧迫してぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ひっぎっ！？　あっ、おぉぉっ！　おぐっ、ふんぐっ！　ほっ、おぉぉぉぉ\nっ……！？　んひゃあぁぁぁぁんっ！？」", "NORMAL" ]},

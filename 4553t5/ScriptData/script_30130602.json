		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「また膣内にっ……！　あっ、んぁぁぁっ！　あ、貴方の赤ちゃんの種が、子\n宮の中に直接出てるっ……！」", "NORMAL" ]},

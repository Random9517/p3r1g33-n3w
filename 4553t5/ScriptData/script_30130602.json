		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「突かれるたびに、身体が浮き上がってるっ！　私のオマンコ、ダメにされち\nゃってるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604216" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「苦しいのに、気持ちよくて……！　ああ、もうっ！　わけがわからないっ！\n　オマンコも頭も、気持ちいいことしか考えられないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ふっ、あっ！？　んぁっ、あっ！？　くあぁぁぁっ！？　また、オチンチン\n膨らんでっ……！　しかも、さっきよりも大きくっ……！」", "NORMAL" ]},

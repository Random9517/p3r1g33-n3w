		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「さっきの射精でも充分なのにっ……こんな発情したオマンコに向かって、こ\nれだけ出されたら……わ、私、妊娠しちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あっ！？　あぁぁっ！？　妊娠するって言ったら、さらに勢いよく精液が噴\nき出てるっ！　な、なんでっ……私、オマンコ締めたりしてないのにっ！」", "NORMAL" ]},

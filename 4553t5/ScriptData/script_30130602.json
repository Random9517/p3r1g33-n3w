		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……！　ヴァルキリー化のせいで、オマンコもう我慢の限界だ\nよっ……！　ベッドまで待てない……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604101" ]},	
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「お願い……今すぐオチンチン挿れてっ……！　私のこと、思いっきり犯して\nちょうだいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「貴方の好きに動いていいからっ……！　私のオマンコ、めちゃくちゃにして\nいいから、早くぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あんっ、あんんっ！　貴方の大きくてカタいオチンチンが、ビクビク跳ねて\nるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604104" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「それに先っぽのところが、クリトリスにも擦れてっ……ふぁ、あぁぁっ！　\nき、気持ちいいよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　んっ、あぅぅっ！　で、でも、こんなのただの生殺しだよっ\n……オ、オマンコにっ……膣内にオチンチン挿れてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「早く貴方のオチンチンで、オマンコの奥をトントンして欲しくてっ……！　\nあぁぁっ、ふぁ、あひゃぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604107" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「お、おっぱいっ……乳首を指でトントンされてるよぉ！　ち、違うのっ！　\nトントンして欲しいのは、乳首じゃなくてオマンコの奥なのっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ！　ふっ、うぐぐっ……！　えっ……？　そんなにオチンチン\nが欲しいなら、自分で挿れろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604109" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「わ、分かった……私がオチンチン挿れるから、動かないでねっ……んんっ！\n　ふっ、んっふっ！　ほっ、おぉぉっ……はっぐぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「亀頭が割れ目に当たってる……！　オチンチン、オマンコに入ってるっ……\n！　このまま一気に、奥まで挿れるからねっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604111" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「思いっきり、腰を打ち付けるから、ちゃんと受け止めてねっ……！　ぐっ、\nうぐぐっ！　ふんっぐっ！　ふっ、んはぁぁぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「おっ、おぉぉっ……！　オチンチン、奥まで届いてるよぉっ……！　私の赤\nちゃんの部屋の入口に、太いの当たってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604113" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「気持ちよすぎて、奥のところ……子宮口がクパクパ開閉しちゃってるよぉ…\n…！　オチンチンの先っぽに、ちゅうちゅう吸い付いてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「これ、下のお口でキスしてるみたいっ……！　赤ちゃんを作るための、エッ\nチなキスっ……ひうっ！　んっ、あっあっあっ、んっ、ひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604115" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……！　オマンコの奥だけじゃなくて、おっぱいも可愛がってや\nるって……私の敏感なところ、両方ともトントンする気なの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604116" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「うっ、あうぅっ……！　そんなの、気持ちいいに決まってるっ……！　感じ\nすぎて、頭がおかしくなっちゃうかもっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604117" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「でも……貴方になら、おかしくされてもいいよっ。私のこと、めちゃくちゃ\nに犯してっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604118" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「今だけは、貴方のオチンチンのことしか考えられない身体にしてちょうだい\nっ……！　んっ、あっ、うっ……！　あっ、あひゃぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「す、すごいぃっ！　ものすごくエッチな音をさせながら、オチンチンがオマ\nンコ掻き分けてるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604120" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「奥を突く動きに合わせて、乳首を押し込まれてっ……！　逆に引き抜くとき\nは、おっぱいも引っ張られてるぅっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オマンコもおっぱいも、どっちもジンジンするっ！　身体中から電気が走っ\nたみたいに、ビリビリ痺れる感じがしてるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「で、でも……こんなに激しく犯されてるのに、どこか優しく扱われてる感じ\nがしてっ……！　あんっ、あんんっ！　うっ、んぐぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604123" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「奥をオチンチンでグリグリする時は、乱暴に押し付けたりしてなくて……子\n宮口を優しく撫でまわされててっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604124" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あ、浅いところ……！　Ｇスポットのところは、オチンチンの出っ張りで小\n刻みに擦られてるよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あっ、あふっ！　はっ、あはぁんっ！　めちゃくちゃにしていいって言った\nのにっ……どうしてこんなに優しくしてくれるのっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「どうせなら、長く楽しみたい？　それに、好きな人の身体は、あんまり乱暴\nにしたくないって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ち、ちょっと待ってっ……！　今、好きとか言われたらっ……私、本当にお\nかしくなりそうっ……ひっ、んっぎっ！　ふっぎゅうぅぅ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604128" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あっ、あぅっ、んっ！　あんんっ！　セックスしながら告白されたから、子\n宮口が完全に開いちゃってるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「赤ちゃんを作る部屋が悦んでるの分かるっ！　貴方のザーメンを求めて、う\nごめいてるのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604130" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オマンコがオチンチンを離したくないって訴えて、ヒダやお肉が亀頭に絡ん\nでっ……ふっうっ！　んあっ、あっあっ！　あひっ、はひぃ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「これ、もうイクッ……オマンコイッちゃうっ！　おっぱいと子宮口を叩かれ\nながら、イッちゃうよぉぉぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604132" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あっひゃあぁっ！？　オ、オチンチンもどんどん膨らんでるっ……！　もし\nかして、貴方もイキそうなのっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604133" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「溜まってるザーメン、オマンコの膣内に出したいんだねっ！？　い、いいよ\nっ……思いっきり膣内に出してっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「私の溢れ出す性欲を、ドロドロの濃厚ミルクで静めてっ！　いっぱいどぴゅ\nどぴゅして、オマンコの膣内を精液まみれにしてぇぇぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604135" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ふぁぁぁぁぁんっ！　いっぱい出てるよぉ！　ザーメンミルク、勢いよく奥\nのところにどっぴゅんされてるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604136" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「子宮口とオチンチンがキスをしながら射精されててっ……！　赤ちゃんの部\n屋に、子種が注がれてぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「おヘソの下のところ、すっごく熱いっ！　幸せがオマンコから湧き上がって\n、全身に広がってるよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604138" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あっ、あっんっ！　んっ、ぐっ！　ふっあぁぁぁっ！　気持ちいいっ！　射\n精されながらイクの最高っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604139" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「好きな人に、心も身体も支配されてるみたいっ……！　わ、私、正義のシル\nバスターなのにっ……支配されちゃダメなのにっ！　ぐっ、あはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ふはっ……あっ、あぅぅっ……いっぱい出したね……オマンコがぐちゃぐち\nゃのドロドロになってるよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あ、あのね……これだけ出してもらったあとなんだけど……私、まだまだエ\nッチしたくてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604202" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「今度は優しくする感じじゃなくて……もっと強く……そ、その……私の腕と\nかおっぱいを無理やり掴んで、犯して欲しいなぁ～って……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604203" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「えっ？　そういうのが好みなのかって？　ち、ちち、違うよっ！　好みじゃ\nくて……そ、そう！　イメージプレイ的な感じっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604204" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「お願い……無理やりな感じだと、もっと気持ちよくなれそうで……このオマ\nンコの疼きも、早く収まると思うから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604205" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「い、いいの？　じゃあお願い……今度は乱暴に犯してっ……！　オチンチン\nでオマンコえぐって、私の子宮が壊れるくらい、激しくズポズポしてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んひぃ～～～っ！？　あっ、おっ！　おぉぉっ！　おっほっ！　おぉ～～っ\n！？　お、奥にズンッてくるぅ！　子宮口、潰されてるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604207" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「これが貴方の、本気のピストンなんだねっ……！　すっごく男らしくて素敵\nっ……！　乱暴にされても、オマンコ悦んでるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ほ、ほらっ、分かるっ！？　オマンコのヒダヒダが、さっきよりも強く亀頭\nに絡んでるよっ！　グニグニってうごめいて、オチンチンなぶってるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604209" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「こ、このまま、おっぱいも弄ってっ！　思いっきり揉んだり、引っ張ったり\nして、いっぱい虐めてちょうだいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604210" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「おほぉぉぉっ！？　んおっ、おっ！　おぐっ、んっ、んっぐぅ～～～っ！？\n　ち、乳首、取れちゃうっ……！　おっぱい千切れちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604211" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「子宮口も完全に開いてるよぉ！　ふぁ、あっ！　ぐっ、あぁぁっ！　あ、貴\n方のオチンチンが、大事なところに入ってきちゃいそうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},

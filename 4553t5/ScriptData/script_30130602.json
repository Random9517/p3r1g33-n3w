		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「私、正義のヒーローを続けなきゃいけないのに……！　それに、新しい敵と\nも、まだ戦わなきゃいけないのにぃ……！　あんっ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「それに、お姉ちゃんに何て言えばいいのっ？　貴方の赤ちゃんを孕んじゃっ\nたなんて、とても言えないし……ふっ、あっ、うぅぅっ！　んぅ～～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0604306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、はぁぁぁんっ！　もうどうすればいいのか分からないよぉ！\n　あっ、ふぁぁぁっ！　ひゃ、おっ！　おぉぉぉ～～～っ！？」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はぁ……あぁ……ヤバい……続けてイッて……おかひくなりそ……オマンコ\n蕩けるぅ……んふぁぅ……」", "NORMAL" ]},

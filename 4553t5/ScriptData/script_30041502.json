		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「そうすると……やっぱり、世継ぎ……てのか？　子作りしかないかなって…\n…それで、後はもうお前の好きにするのがいいかなって思ってな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504103" ]},
		{"command":[ "SETCHARA", "0", "char_00000415_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「あぁ……いつでも大丈夫だ……んっ、ちゅっ……うん、このまま、横になれ\nばいいのか？　服も……脱がしてくれていい……からな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504104" ]},
		{"command":[ "SETCHARA", "0", "char_00000415_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んんっ……あっ……この向きでするんだ……その方が、しっかり精液が奥に\n届くから……？　うん、お前に任せてみる」", "NORMAL" ]},

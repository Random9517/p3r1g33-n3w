		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「あぁ……私もキスしたい……ちゅっ……んはぅ……ちゅぷっ、れろぉ……舌\n……らひて……舐めさせてぇ……ぺろ、れろぉ……」", "NORMAL" ]},

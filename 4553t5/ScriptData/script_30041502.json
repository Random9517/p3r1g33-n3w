		{"command":[ "SETIMAGE", "0", "still_00000415_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「チンチンの先が……何度も奥の……気持ちいいとこ……コンコンして……あ\nっ、はぁんっ、そ、そこっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「そうして……突かれるとっ……あっ、おっ……んふぅっ、オマンコも……自\n然にビクビクって……なっちゃうからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んんっ……それを、もっと感じたい……？　ったく、お前も……つくづくス\nケベなんだからな……なら、もっと奥……突いてくれよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はぁぉっ！　そっ、そぉっ……それぇっ……あっ、あぉっ……お、おっぱい\n触られながら……ズボズボされたらぁっ……！」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00000415_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「れろ、んぷっ、ちゅぷぅぅぅ……ぴちゃ……んっ、そろそろ……こっちも欲\nしい……んっ、するよ……ちゃんとおねだりするからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「私の……んっ、ぐしょぐしょの……オマンコにぃ……チンチン……太いチン\nチン……ずぶって入れて……気持ちよくしてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……んっ！　あぁぁ……そうだぁ……そのまま、奥まで……ずりゅっ\nてぇ……はっ、ひっ……！　あぁ、入って来てるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、ぴちゃ……あぁんむ……からだ……火照ってる……くっついて\nるとこ……すごく熱くて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「でも、ぴとってしてると……すごく……嬉しい……んっ、ふっ、いいぞ……\n動いて……もっと、私のオマンコの奥……ずりずりしてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はぁぅっ！　んんっ……ああっ、奥っ……！　オマンコっ……深いとこまで\nぇ……届いてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「チンチンの先が……ツンって……突っついてくるのっ、あっ、ひっ……！　\nはぁんっ、それ、好きだから……な、何度もしてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はんっ、あっ、うぁんっ……こんなっ、チンチンっ……すごかったっけ……\n何だか、めちゃくちゃドキドキしてるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はっ、ふぁっ、あひぁっ……奥に……ズンって来るだけで……はぁぁっ、オ\nマンコ……じゅくじゅくしてっ……汁……出てくるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んふぁぁ……ちゅぱっ、んちゅぷっ、あぁ……い、いいぞ……おっぱいも…\n…好きに触って……あんっ、いいからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「乳首……ツンってなってる……？　だって……お前のチンチンが気持ちいい\nからぁ……敏感になるに、決まってるだろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「そこ……弄られながらぁ……あっ、奥っ……グリってしたら……あっ、ふぁ\nっ、んぁあっ、い……いいっ、効くぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んぁぁ……後ろから抱き締められるって……思ったより、安心する……んっ\n、ふっ、もっと……あふっ、ぎゅってして欲しい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んっ、分かるよ……お前のチンチンも……すごく熱くなってるし……心臓が\nドキドキしてるのも伝わってくる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「このままで、もっと……はっ、あぁんっ……中……かき混ぜて欲しいっ、ん\nくぁっ！　そっ、それぇっ、あっ、ふぁぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「も、もっと足を広げて……深く届くように……？　んっ、こ、これで……い\nいのかっ？　あぁ……私……こんな大股開きにして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はぁ……あっ、ふっ、正面から見たら……オマンコ……全部見せてるよな…\n…あぁ……つながってるトコも全部……見えてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、それで……中の……割れてるところが……広がってっ……ん\nんっ、くぱってしてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「そこに……チンチン……出たり入ったりしてっ……あぁっ、グチュグチュ…\n…すごい音っ、させてるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「うんっ、んふっ、ちゅぷっ……また、そんな時に……こんな、顔を……覗き\n込んでっ……んんっ、ニヤニヤしてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「気持ちよさそうにしてるのは……お前もなんだからなっ……れろ、ふぉら、\nもっと舌をらせっ……れろっ、ぺろっ、んちゅぷぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んっふ……ひゅごいな……キスも……ずっときもひぃぃ……んりゅぷっ、口\nの中……トロトロになっへる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「下の口も……いやらひぃ……？　バ、バカ……あんまり、変なコト言うな…\n…んっ、あぁ……お前のチンチンの方がいやらしいからだろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んっ、そんなに言うんなら……もっと、んきゅって……締め付けてやるっ…\n…んふっ、こうし、てっ……んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504130" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「へへ……チンチンにしっかり吸い付いて……ねっとり、絡ませてやるからな\n……んはぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「あぁ……んっ、あっ、あぁっ……めちゃくちゃ反応してビクビクしてる……\nんふぅ……いい、感じに上がってきてるぅ……」", "NORMAL" ]},

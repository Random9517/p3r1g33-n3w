		{"command":[ "SETIMAGE", "0", "still_00000415_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……あぁ……いっぱい出たな……隙間から、ちょっと垂れて来て\nる……はふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「うん……この体位……良かった……お前に、ぎゅって抱き締められるの……\n本当に安心して、私の居場所なんだなって……そう思ったな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「な……まだ、チンチン……硬いよな？　私……もっと、お前と……エッチし\nたい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んぅ……中出しされて、いっぱいのオマンコ……もっとヌルヌルかき混ぜて\n……私を……よがらせて……あっ、んぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ、ふっ、あふっ……今の……めちゃくちゃ……やる気出た……\n？　にへへ……こんな甘え方……お前にしかしないからな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んぁ、ちゅぷぅ……また舌……ぺろぺろするぅ……んっふ、うんっ……いっ\nぱいキスしたい……あんっ、はっ、んぁっ、あふんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000415_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「オマンコ……ずっといい感じのままで……あぁっ、また……チンチン、ズリ\nズリ動いてぇ……あっ、ぉおっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},

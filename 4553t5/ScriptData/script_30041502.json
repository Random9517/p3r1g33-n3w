		{"command":[ "SETIMAGE", "0", "still_00000415_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はぁぁんっ……チンチンが、ビクビク震えて……んぅぅぅんっ……オマンコ\nぉ……いっぱいにされてるぅ……ふひぃぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},

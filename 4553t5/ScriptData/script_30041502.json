		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「おっ……来てくれたか……いや、全然待ってないぞ、大丈夫だ。ほら……こ\n、こっちに座ってくれ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504101" ]},

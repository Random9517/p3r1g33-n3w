		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んっ、ふぁぁ……うん……ちょっと……イッた……。身体がビクってしたの\n……分かっただろ……？」", "NORMAL" ]},

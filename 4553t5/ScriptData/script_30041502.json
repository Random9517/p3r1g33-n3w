		{"command":[ "SETIMAGE", "0", "still_00000415_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ……これ……続けたら、あっ、あぁっ、もう……私……イ、イ\nクかもぉ……んぁっ、ちゅぷぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「はんっ、あっ、んふっ……お前も……結構、近い……？　じゃあっ、んちゅ\nぷっ……このまま……中っ、出して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「これは……世継ぎ作りなんだからぁっ……あっ、精液っ……全部出すのっ…\n…いいなっ？　はぁんっ、もっ、もぉっ、イ……くっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_004_1504135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「んんんうぅぅぅんっ……！　あぁっ……あっつい……のっ、あぁっ、ふっ…\n…出たっ……せいっ、えきぃっ……中ぁ……」", "NORMAL" ]},

		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「ははっ、何かガラにもなく、ちょっと緊張してるかもな。その、ほら……姫\nとしての役割みたいなのを考えるようになってさ……」", "NORMAL" ]},

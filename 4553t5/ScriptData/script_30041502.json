		{"command":[ "SETIMAGE", "0", "still_00000415_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "セレーナ" ]},
		{"command":[ "SETTEXT", "「ふぁぁっ、ヤバ……イ、くっ……！　ま、また……イクかもっ、すぐっ、イ\nッちゃうかもぉっ、あっ、あぁっ、ひぁぁぁぁんっ！」", "NORMAL" ]},

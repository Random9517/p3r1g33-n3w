		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ぴちゃ……んっちゅ……遠慮しないでどんどん出して……んっちゅ……ほら\n……溢れさせちゃお……びゅくびゅくって……ね？」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「今度は、もう溜めてた分……全部出しちゃうような勢いだね。いいよ……い\nっぱいびゅうって……出しちゃおうね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ……出し切れた……？　オチンポ……もう大丈夫かな？　うん、いっぱ\nい頑張ったね……よしよし」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803305" ]},

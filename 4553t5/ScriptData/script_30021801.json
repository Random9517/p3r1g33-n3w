		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「袋のところから……オチンポの根元まで地続きになってる部分……ぎゅうっ\nて……撫で回して……」", "NORMAL" ]},

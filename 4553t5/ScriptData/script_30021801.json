		{"command":[ "SETIMAGE", "0", "still_00000218_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ぴちゃ……んちゅ……あぁ……ずっと震えてるけど、どんどん大きくなって\nくる……あんなに出したのに……こんなに反り返って……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「私の手コキが良すぎるから……？　んふふ……じゃあ、もっと褒めてもらう\n為に頑張らないと……指で……つぅっと……」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「もうダメ……？　出ちゃう……？　んっ、じゃあ……最後……本気のシコシ\nコするからね……んっ、はっ、んんっ……」", "NORMAL" ]},

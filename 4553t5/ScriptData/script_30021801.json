		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「もう……こんなご奉仕させて、照れるようなこと言わせないで。んふふっ…\n…また、今年もよろしくね？」", "NORMAL" ]},

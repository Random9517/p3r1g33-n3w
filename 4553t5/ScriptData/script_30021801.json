		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「どっちかと言うと、貴方と一緒にいることで……こんなふわふわのいー気持\nちになってるんだから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「それに……一年の始まりはおめでたいものでしょ？　だから好きな人と一緒\nにいるのが一番いいの……」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁ……ヌルヌル……ふふっ、ちゅぷっ、んっ、美味しい……いっぱい出せ\nて……偉かったね……よしよし……」", "NORMAL" ]},

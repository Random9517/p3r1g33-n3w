		{"command":[ "SETIMAGE", "0", "still_00000218_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「身体の力が抜けちゃうんだよね？　腰が震えちゃってるの分かるから……大\n丈夫、いざとなったらちゃんと支えるから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「今……大急ぎで次の準備をしてる場所だから……優しくさすってあげないと\nね……でも、じわじわくるでしょ？」", "NORMAL" ]},

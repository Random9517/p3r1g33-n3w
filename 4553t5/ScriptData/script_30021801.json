		{"command":[ "SETIMAGE", "0", "still_00000218_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふっ、そう……お腹に力を入れて……うん、またレロレロするよ？　んっ\n、ちゅぱっ、ぴちゃっ……れろっ、れろぉっ……」", "NORMAL" ]},

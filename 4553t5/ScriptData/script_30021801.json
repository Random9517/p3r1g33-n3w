		{"command":[ "SETIMAGE", "0", "still_00000218_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「じゃあ、これくらいでどう……？　あぁ……結構、大胆にオチンポ扱いてる\n……このカリの部分……じわって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁっ……んっ、もうちょっとお汁浮いてきた……んふっ、これを滑らせる\nのに使うね……んっ、んふっ、はぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あ……ここも、して欲しそう……ね……舐めちゃっても……いいよね……ん\nっ、れろ、ぴちゃ……んれろ、れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふ……んっ、乳首……ピーンって尖ってる……これ……やっぱり敏感なん\nだよね……？　ちゅぷ……んっちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ダメ……やめたげない……んっ、だって……私のおっぱいも……遠慮なく吸\nうじゃない……私が待ってって言っても聞いてくれないし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「だから……今は、私がしてあげるの……んちゅっ、れろ、れろぉん……ちゅ\nぷっ、んっちゅ……んふふっ……ほら、気持ちいいでしょ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「酔ってる……？　ふふ……さあ、どうかな……でも、いい気分なのは確かか\nも……ちゅぷ……んっちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「だって……乳首……レロレロして……ビクってするオチンポ捕まえて……ん\nっ、根元の所をシコシコして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「こんなの……どんどんその気になっちゃうもの……れろ、んちゅぷっ、んふ\nぁ……はっ、ふぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「どう……気持ちいい……？　でも……節操なしにすぐピュってしたら……ダ\nメだからね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ちゃんと……全体がじわぁってよくなるまで我慢して……思い切りビュビュ\nって出す方が気持ちいいんだから……ね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はい、いい子……んちゅっ、ちゅぷぅぅぅ……あぁ……乳首……こんなにコ\nリコリになって……おんなじなんだね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁ……私のも……触ってないのに……もうピンって……硬くなっち\nゃってるの……んっ、切ない感じ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふ……触りたい……？　もうちょっと待ってね……今は、ご奉仕に集中し\nたいから……後で好きなだけ触らせてあげるから……ちゅぱ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、はぁ……んっ、シコシコのさせ方も……分かってきた……これ\nくらい強めでも……ちゃんと気持ちいいんだね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「先走りが溢れて……気持ちいい～って震えてるの可愛い……まだだよ……も\nう少し……シコシコ……くちゅくちゅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んちゅっ……ちゅぱっ、もっと唾液をまぶして……敏感にさせてくから……\nほぉら……ムズムズして切ないでしょ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あとはここ……オチンポの弱いとこ……んっ、手のひらで輪っかを作って…\n…ぐりって……擦ってぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ……あぁ……んっ、ビクビクしてる……先走りがどんどん溢れ\nて……手が……ヌルヌルになってくぅ……」", "NORMAL" ]},

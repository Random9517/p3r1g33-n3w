		{"command":[ "SETIMAGE", "0", "still_00000218_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふっ……どうする？　もうちょっと……続きしてもいい？　私も、何だか\n楽しくなってきちゃった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「うん、それじゃ……そのままリラックスしててね……乳首も、引き続き可愛\nがってあげるから……ちゅっ、んちゅっ、ちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「さっき出した精液で……もっとヌルヌルになったよね……手で握ると……に\nちゃってしてる……」", "NORMAL" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「もっと早く言ってくれればよかったのに……だって、私も完全にその気にな\nってるんだからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「うぁ……すっごく熱くなってる……ふふっ、手の中がやけどしちゃいそうな\nくらい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「それに、このビクンビクンって震えてるところ……すごく可愛い……じゃあ\n、手で……いっぱい気持ちよくしてあげるからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「じゃあ、シコシコ……くちゅくちゅ……んっ、ふっ……皮を優しく捲りあげ\nて……上下させてくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「一人でしてる時……こんな感じ……？　もっと強くても大丈夫なのかな？　\nんっ、ふっ……大丈夫……うん、分かった……」", "NORMAL" ]},

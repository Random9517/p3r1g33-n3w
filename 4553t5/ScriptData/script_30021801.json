		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「さっき出したばっかりなのに……まだ、こんなに奥に残してたんだ……すご\nいわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふ……晴れ着を汚さないように気を使ってくれたの？　大丈夫だったのに\n……でも、その優しさが嬉しいかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803303" ]},

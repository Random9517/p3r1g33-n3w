		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「酔ってるって……？　もう……細かいことはどうでもいいの。ぽかぽかして\nいい気持ちなのは間違いないけど……」", "NORMAL" ]},

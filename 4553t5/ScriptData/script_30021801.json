		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ほら……どう？　くちゅくちゅいやらしい音をさせて……激しくオチンポの\n皮がめくれ上がっていくの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、ちゅぷっ、声が出ちゃう……？　聞かせて……ふふっ、貴方の気持ち\nよさそうに悶えてる声……いっぱい聞きたいかも……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁ……んっ、すごい……手の中でビクビク震えがおっきくなってる……こ\nれ……また出す時、すごい勢いになりそう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「どうしたい……？　私に掛けたいならそれでもいいよ？　でも、派手に飛ば\nすところも見てみたいな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000218_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ちゅぱ……んっ、ほら……もう選ぶしかないよ……好きな方で……いっぱい\n……出しちゃえっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803220" ]},

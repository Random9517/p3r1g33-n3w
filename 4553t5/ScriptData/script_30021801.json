		{"command":[ "SETIMAGE", "0", "still_00000218_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、ちゅぱっ……乳首と……オチンポ同時にして……んっちゅ……そろそ\nろイキたくなって来たんじゃない……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ、あともう少しだけ我慢しよ……？　そしたら、すぐ……いっぱい\nドピュって……出していいからぁ……ね？」", "NORMAL" ]},

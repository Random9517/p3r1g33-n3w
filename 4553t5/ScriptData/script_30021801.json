		{"command":[ "SETIMAGE", "0", "still_00000218_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「でも、この滑る感じが……気持ちいいのを増幅させてくれるんだよね……こ\nっちの下の方も……触っちゃおうか……えいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、ふふっ……キンタマ……の方、ビクってしたね……もっとむにゅって\nしてあげる……ほら、むにむに……」", "NORMAL" ]},

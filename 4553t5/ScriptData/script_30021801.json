		{"command":[ "SETIMAGE", "0", "still_00000218_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ……いいよ……ほら、私の手の中に……ビューって出しちゃって……\nはい、いち、にーの、びゅーっ……」", "NORMAL" ]},

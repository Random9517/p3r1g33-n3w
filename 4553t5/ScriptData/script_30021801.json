		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふっ、オチンポにいい子いい子ってするのは違うかな？　でも、それだけ\n頑張ってくれたってことだから……よしよし」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1803306" ]},

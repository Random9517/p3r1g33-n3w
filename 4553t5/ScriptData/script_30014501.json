{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0051" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ここなら人の気配もないし、ゆっくりと休憩できるな。早速だがサンオイル\nを塗ってもらおうか。私がやると、背中まで手が届かないからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503101" ]},
		{"command":[ "SETCHARA", "0", "char_00000145_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひゃあんんっ！？　き、貴様、どこを触っているっ！　……何っ？　思った\n以上にオイルがヌルヌルしていて、手が滑っただと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503102" ]},
		{"command":[ "SETCHARA", "0", "char_00000145_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そんな見え透いた嘘に騙されたりしないぞ！　貴様はただ、私のおっぱいや\nオマンコが触りたかっただけだろう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503103" ]},
		{"command":[ "SETCHARA", "0", "char_00000145_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そっちがその気なら、私にも考えがある。こうして、おっぱいにオイルをか\nけて……観念しろ、このドスケベっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503104" ]},
		{"command":[ "SETCHARA", "0", "char_00000145_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ……んっくっ……！　ど、どうだ。こうやっておっぱいで挟めば、迂闊\nなことはできまい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「これじゃあオイルを塗るどころか、ただのパイズリになっているだと？　そ\n、そんなことはないぞ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「これはパイズリではなく……そ、そう！　お前がいやらしいことを考えてい\nたようだから、オシオキをしているだけだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「主人である私の欲情し、オイルを塗るフリをしてオマンコに触ってくるよう\nなスケベな下僕には、立場というものを分からせてやらねばな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「とりあえず、一度射精をすればオチンポも落ち着くだろうし……特別に私が\n、おっぱいと口で気持ちよくしてやる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「い、一応言っておくが……これは決して、いやらしい気分になったとか、そ\nういうことではないからな！　勘違いするんじゃないぞ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ちゅ、ちゅるるっ……じゅ、んちゅくっ。ちゅばっ……じゅ、ぷちゅ……ち\nゅぐっ、じゅるっ……れろっ、んれろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ……あっ、ちゅぶふっっ……！　谷間かりゃオチンポがはみ出てくりゅ\nっ……いつも以上におおひくへ、カタいオチンポらな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「大きしゅぎて、挟みぢゅらいらないか……んっ、ふっ！　くっ、ちゅぶぶっ\n……じゅぞ、ぢゅ、ずぞぞっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふっ、くふっ……んっぷっ！　らけろ、こにょサンオイルのおかげれ、おっ\nぱいは動かひやしゅいな。こりぇなら、もっひょ激しくシゴけそうら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぢゅぼっ、じゅっぷっ！　んっ、んっ……ぢゅ、にちゅぱぁっ……！　くぢ\nゅ、ちゅろろっ……れっ、ろっ……んべろぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んふーっ……ぐっ、ちゅぱぁぁっ……チンポを舐めれば舐めりゅほろ、オチ\nンポがあちゅくなってくりゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そりぇに、先っぽかりゃいやらひい汁も溢れへ……んちゅ！　じゅ、じゅぞ\nっ……んんっ、に、苦いぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「姫れありゅ私に、なんへものを飲ましぇるんら、この下僕はっ……は、恥を\n知れっ……んんっ、ちゅ、ぐっちゅうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「お、お前にこんらこひょをひてやりゅのは、全宇宙にょ中れも、私らけらぞ\nっ！　光栄に思うひょいい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ！？　ひゃ、あっ、あんんっ！　な、なんらっ……！？　オマンコにね\nっとりひょひた感触が広がってくりゅっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「腰がかっへに浮き上がってひまうぅ……！　んぁっ、あっ！　ちゅ、ちゅぐ\nっ！　んんっ、ぢゅ、ぐっ……にぢゅぷぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「き、きひゃまっ……！　いっひゃい、何をひてっ……！　あんっ、あっ！　\nひゃ、あぁぁっ！　んっはぁぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「目の前にヌレヌレにょオマンコがありゅから、つい舐めひゃくなったらと…\n…！？　そ、そんらこひょ、許可ひていないぞっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふぇ……？　い、弄っひゃり、舐めひゃりして欲しそうに、ヒクヒク疼いて\nいたって……ち、違うっ！　こりぇは生理現象らっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「べ、別に下僕に舐めへもらいひゃいとか、思っへいたわけりゃなくへ……ん\nんっ！　くっ、ぢゅるるっ！　ぢゅ、じゅぞっ！　ちゅぞぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「いっぱい舐めりゅから、いっぱいオチンポをシゴいへ、舐めへ欲しいらと…\n…？　し、仕方にょないヤツだっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「下僕の要望に応えりゅのも、主人れありゅ私の役目らからな……あ、ありが\nひゃく思うんらぞっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぐっぽっ！　じゅぼっ、ぢゅぶぶっ！　にちゅ、ぐちゅっ！　れろっ、ぺろ\nろっ！　じゅ、じゅるっ！　ちゅちゅ、ちゅじゅうぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ずずっ、じゅるるるっ！　ぢゅ、ちゅっぱっ！　んぱぁっ！　あっ、んあっ\n！　あっ！　舌がクリトリスに当たっへ……ふあぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「オチンポをシコシコしながりゃ咥えへ……こんらにもオマンコを感じさせり\nゃれたりゃ、イッてぇひまうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「下僕にょオチンポを躾けへ、わかりゃせてやりゃないといけらいのにっ……\n私のオマンコがわからされてひまうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぢゅ、ぐちゅっ！　んっ、んぷぷっ！？　オチンポが口にょ中れ跳ねて、暴\nれへっ……ましゃか、イキそうらのかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「よ、よし。いいぞっ……こにょまま射精ひろっ！　私にょ口に向かっへ、ザ\nーメンをどぴゅどぴゅしゅるんらっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「わ、私も……貴様の舌れイクかりゃっ……！　い、一緒にっ……ずずずっ！\n　じゅ、ちゅるっ！　にぢゅ、ぷっちゅっ！　じゅぷふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぐちゅ、じゅぱっ！　れろっ、ちゅろろっ！　ぢゅぶっ、じゅぶぶっ！　ん\nっ、んんっ！　イッ、イクッ……イグぅぅぅぅーーーっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んむぅぅぅ～～～……！　ぐっ、じゅぶっ！　ぷっ、ちゅ、じゅぐぐっ……\n！　喉にょ奥まれ、精子が飛んれきへっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_05" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「しゅごい勢いにょ射精らっ……こ、こんらに出しゅらんて、聞いてらいぞっ\n……！　ぢゅ、ぽっ！　んちゅ、ちゅるるぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぐぶっ！？　うっ、うっぶっ！　ま、まら出へっ……！？　こりぇ、飲まら\nいと口かりゃこぼりぇへひまうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぐっ……んっ、ごくっ！　こくこくっ……じゅ、ずずっ……！　ごくっ…\n…ごくっ……！　んっぐんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うっ、あっ……うっぷっ！　ザーメンにょ味ひょ匂いれ、オマンコが疼くっ\n……！　ま、まひゃイクッ……イクッ、イクぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふはっ……はぁ……ちゅ、ぷはぁ……私にょパイズリひょフェラれ、感じて\nくれひゃのらな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こんらにいっぱい出しゅなんへ、嬉ひいっ……あっ、いやっ！　ち、違うっ\n……！　よくもこんらに出してくりぇひゃなっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「許可なく主人の口らけれなく、喉まれ汚しゅとは……貴様は私にょ下僕とい\nう認識を持っていりゅのかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「な、なにっ？　このまま射精ひろと言ったのは私らと？　そ、そりぇは……\n！　あ、あの時は、そりぇが最善らと思ったかりゃだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うぐっ……うぐぐっ……！　げ、下僕にょクセに口ごたえをしゅるなっ！　\n主人に逆らうヤツには……こうらっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「じゅぞっ、ぢゅぞぞっ！　ぐっぷっ！　ちゅ、ちゅぶぶっ！　んぢゅぢゅっ\n、じゅっぞっ……じゅぶぢゅぶっ、ぞぞっ、じゅるるっ、ぐちゅるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、んんっ！　どうらっ……射精したばかりにょオチンポをシゴかりぇり\nゅのは、キツイらろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「しかも、それらけじゃないぞ……今から先っぽにょ割れ目を、舌でホジくっ\nてやりゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「くりゅっ……れっ、れろっ！　ぐりゅっ、じゅるっ！　んっ、くちゅ、ちゅ\nちゅ……じゅ、じゅぽっ！　ちゅるるっ！　にちゅっ、くぷぷぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んふふっ。気持ひよさそうに、オチンポが跳ねまくってりゅぞ。こりぇなら\n、またしゅぐにれもイキそうらなっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「無様に射精させへ、足腰立てなくひてやりゅ……んっ、にちゅっ！　ちゅ、\nちゅっ……んっ！？　あっ！？　あはぁぁぁんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「オマンコが激しく舐めりゃれへ……！？　ひかもこりぇ、クリトリスらけじ\nゃなくへ、おしっこにょ穴も舐めりゃれてるっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そ、そこはらめらっ！　きひゃないからっ……あっ、んちゅっ！　感じしゅ\nぎるかりゃ、舐めるんじゃないぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、んんんっ！　ちゅ、ぷっ！　わ、私にょオマンコに、汚いとこりょな\nんへない？　私が望むなりゃ、お尻の穴らって舐められるらと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そ、そんら変態みひゃいなことを言うなっ！　うっ、うぅぅっ……お前に求\nめられひゃら、子宮が悦んでひまうだろうがっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぷっ、ちゅぶっ！　んっ、んぱぁっ！　こ、こにょままらと、先にイカしゃ\nれてひまうっ……何とかひて、先にイカせなけりぇばっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぶふぅっ！　ぢゅぼっ、じゅっぽっ！　ぐぽぐぽっ、じゅ、ぢゅるるるっ\n！　にちゅ、んぢゅぢゅ！　ちゅ、ちゅ、んぷぷぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ！　ぢゅ、じゅぞぉ～！？　オマンコにょ奥まれ、舌れホジられ\nへぇっ！？　らめらっ！　こんらの、我慢できりゅわけないぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「イグッ！　イグイグッ！　下僕にょオチンポをペロペロひながりゃ、まひゃ\nイカしゃれてひまうぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぢゅぢゅぅ～！　ちゅぶぢゅぶっ、じゅぐぽぉ！　れろれろっ、れろっ、\nんれろっ！　ぢゅ、じゅっ、ぞっ！　んっ、んんん～～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あ、あちゅいにょが口にょ中にぃ！？　んっ、んんっ！　ぐっぢゅ、じゅぞ\nっ……ぢゅるるっ、んじゅうぅ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「２回目らのにしゅごい量だっ……！　まひゃ口にょ中がいっぱひになっへし\nまふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「飲まなけりぇば、ローションと精子が混ざりあっへひまうかりゃな……！　\nんっ、んぐっ……じゅ、ごくっ、ごくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……しゅごく濃厚れ、ドロっとひててっ……喉に絡みちゅくっ……ご\nくごくっ……じゅ、じゅるっ……！　んっくんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……はぁ、はぁ……とりあえず、射精は落ち着いたみひゃいらな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ？　何だ、下僕っ……何か言いたいこひょれもありゅのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「精子を飲んでくれて嬉しい？　できりゅこひょなら、上の口らけじゃなくへ\n、下にょ口にもザーメンを注ぎたいらと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そ、それはちゅまり、セックスをひたいと言っていりゅのか！？　バ、バカ\n者っ！　いくらひと気がないかりゃといって、セックスは……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ま、まぁ……貴様を躾けりゅには、オマンコを使うのが一番効率的ひょ言え\nなくもないが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふんっ……いいだろう。ここなりゃ誰も来なひだろうし……セ、セックスひ\nてやってもいいぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503310" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぷぁぁぁっ！？　な、なんだっ！？　急にオチンポが抜けて……きゃあぁ\nぁぁっ！？　か、顔にザーメンが飛び散ってきているっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「や、やめろっ！　勝手に顔にかけるんじゃないっ！　今すぐ射精を止めろっ\n……あんっ！　ひゃ、あっ！　あはぁぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「熱い精液を顔にかけられていると、オマンコが反応してしまうっ！　子宮が\nきゅんってして、イクの止まらなくなってしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「下僕のザーメンを浴びながらイクなんてっ……こ、こんなことぉ……！　あ\nんっ、あっ！　イクッ！　またイクぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ザーメンかけられてイクッ！　熱くて濃い精液浴びながら、イキ続けてしま\nうぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はっ……んっ、はぁぁぁ……き、貴様っ……よくもやってくれたな。覚悟は\nできているんだろうな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「なんだ？　この期に及んで言い訳か？　いいだろう。聞くだけ聞いてやる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……私のおっぱいとオマンコが気持ちよすぎて、我慢できなかった？　それ\nに顔に精子をかけると、自分の女という感じがしてたまらないだと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だ、誰が貴様の女だっ！　海で開放的な気分になっているからと言って、勝\n手なことを言うんじゃないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが、まぁ……お前の女と言われて、悪い気はしないというか……私のこと\nが好きだという気持ちは、はっきりと伝わってきたぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4503410" ]},
		{"command":[ "SETIMAGE", "0", "still_00000145_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
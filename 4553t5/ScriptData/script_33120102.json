{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「今回の騒動のお仕置き、ですか……いえ、隊長にお声がけされたときから、\nこうなることは予想していました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00031201_01", "5", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「すべてを受け入れて、罪を償います……それで、私は何をすればいいのでし\nょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00031201_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「裸になって、お尻を突き出しながら四つん這いになれと言うのですね……分\nかりました。それでは、失礼します……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104103" ]},
		{"command":[ "SETCHARA", "0", "char_00031201_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「んっ……はぁ……あっ……これで、よろしいでしょうか？　くっ……んぅっ\n……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104104" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「隊長のカタく勃起したオチンポが、オマンコにあたってっ……ひゃ、あぁぁ\nっ……！　擦られるだけで、感じてしまいますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「それにこの体勢は……組み伏せられているみたいで……あっ、うぅっ……無\n理やり、犯されているみたいですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「お仕置きだから、無理やりなくらいが丁度いいと……？　確かに、そうかも\n知れませんが……これは、かなり恥ずかしいと言いますかっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「このままオマンコにオチンポを挿れられてしまったら、いつも以上に感じて\nっ……醜い喘ぎ声を出してしまいそうですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104108" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あ、あのっ……！　せめて、普通の四つん這いでっ……そうしていただけた\nら、私から腰を動かして、オチンポにご奉仕をしますのでっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あっ、やっ！　ま、待ってくださいっ！　本当に、この体勢は無理ですっ…\n…！　あっ、あっ！　くるっ……オチンポ、入ってきてっ……んぅぅっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あっ……あっ……！？　どんどん奥に入ってきますっ……！　隊長のぶっと\nいオチンポ、オマンコのお肉を掻き分けてぇっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104111" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「無理やりオマンコを拡げられているみたいで……んひぃっ！？　ダメっ、ダ\nメですっ！　オマンコ気持ちよすぎますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、ふっ、あっ！　んはぁぁんっ！　Ｇスポットを亀頭が擦りながら\n、さらに深いところまでっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「この体勢だと、いつも以上に奥まで入り込む感じがしますっ……！　こ、怖\nいですっ！　私の子宮口に、カリが届いてしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104114" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「んぎっ、ふっ、はぐぅっ！　く、くるっ……カリ高のオチンポが、奥の奥に\n突き刺さってっ……ひっぎっ！？　んひぃぃ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「はーっ……はーっ……んっ、ふはぁぁぁっ……ぜんぶ、入ってしまいました\nっ……隊長の長いオチンポ、根元まで入り込んでおりますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「こんなの初めてですっ……身体をオチンポで貫かれているみたいでっ……ん\nんっ！　ふっ、くっ、あっ……んあぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ひっ、あぁぁぁっ……！　こ、このまま、無理やりオチンポを出し入れして\n、オマンコを道具のように使ってやるだなんてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104118" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「お仕置きなのは分かっているのですが……そんなことを言われてしまっては\n、子宮が悦んでっ……ひぎっ！？　あっひぃ～～～！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104119" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、あぁぁんっ！　オチンポ、出入りしてますっ！　私のオマン\nコを、ズポズポかき回してぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「オマンコのヒダが、亀頭に絡みついているのを感じますっ！　激しい出し入\nれで、オマンコ感じてしまっていますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ひゃひっ、んぐぐっ、ふっくぅ～！　オマンコのお肉をズリズリと削られる\n感じ、たまりませんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104122" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「身体中をものすごい衝撃が、貫いているみたいでっ……あっ！　んぁっ！　\nあっ、はぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「オマンコが勝手に締まって、オチンポをぎゅーってしてますっ！　無理やり\n犯されているのに、身体はイヤがっていなくてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「むしろ、隊長のオチンポを感じられて、嬉しくなってっ……んひっ！　はっ\n、ひゃふっ！　あっあっあっ、んぁっ、ひゃあぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104125" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「思いっきり出し入れされるたびに、オマンコからぐちゅぐちゅといやらしい\n音が響いておりますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104126" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「刺激されると、さらにお汁が溢れて止まりませんっ！　こんなにも無理やり\nなセックスなのに、嬉しくてたまらないのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、隊長のオチンポ、本当に素敵ですっ！　ずっとこうして、お仕置\nきされていたい気分になってしまいますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「んひぃぃ～～～っ！？　おっ、おぉっ……おほぉぉぉ……！？　い、いま、\n子宮口に勢いよく、オチンポが突き刺さってぇっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104129" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あっ、がっ……ふっ、んぐふぅっ！　これ、本当にダメっ……今の、もう一\n度されたら、簡単にイッてしまいますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「た、隊長もそろそろイク……？　さっきみたいに、思いっきりオチンポを突\nき刺しながら、射精されるのですか……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104131" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「やっ、あっ！　ダメダメダメっ！　それだけはご勘弁をっ！　あの刺激を受\nけながら射精されたら、子宮が精子を受け入れてしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「間違いなく排卵して、卵子が受精してっ……！　隊長の赤ちゃんを孕んでし\nまいますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あっ！　あっ！　ひっ、あっあっあっ！？　ダメっ！　ダメっ！　本当にダ\nメですぅ！　やぁぁぁっ！　本当に妊娠しちゃいますからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104134" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ！　だ、出されてしまいますっ！　無理やり犯されながら、受精\nアクメしてしまいますぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「おっ、おぉぉぉ～～～っ！？　ほ、本当に出されてますっ！　子宮に向かっ\nて、精子びゅーびゅーされてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104136" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「子宮口がぽっかり開いて、ザーメンを受け入れてっ……！　ひっぎっ！　ん\nぎひぃ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あぁ～～っ！　受精アクメすごいですっ！　気持ちよすぎて、頭がおかしく\nなってしまいますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104138" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「気持ちいいことしか、考えられなくなっておりますっ！　目の前が真っ白に\nなって、意識が飛びそうですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「おひっ、ひっぎっ！　んぎっ、おっおっ、おほぉぉぉ～～～っ！　アクメ気\n持ちいいっ！　孕まされながらイクの、すごすぎますぅぅぅ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104140" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「はぁぁーっ……はぁぁぁーっ……こんな……道具みたいな扱いで、たくさん\n子種を注がれるだなんてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「無理やり犯されて、膣内出しされて……酷いって思うのに、嬉しくてたまら\nないのですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「お腹の中に、隊長との赤ちゃんが出来ると思うと……幸せな気持ちが満ち溢\nれてきてしまって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104203" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「悦んでたら、お仕置きにならない、ですか……？　ですが、どのような形で\nあれ、隊長とセックスをしていたら、こうなってしまいますので……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104204" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あんっ、そんなっ……！　まだまだお仕置きが足りていないだなんてっ……\n！　やっ、あっ！　またオチンポが動いてっ……んっほぉぉぉっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104205" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ふひっ！　あっ、おっ、おぉ～っ！？　先ほどよりも激しく、オマンコがえ\nぐられておりますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「先ほど出された精液が、子宮に押し込まれてっ……んおっ、おぉっ！　おヘ\nソの下のところが、ものすごく熱いですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「子宮が精子で満ちているのに、さらにズンズンって突かれてっ……！　こん\nな快感、今まで味わったことありませんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104208" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あっ、おっ、んほぉ！？　こうやって、無理やりオチンポを押し込まれるの\n、好きかも知れませんっ！　支配されている感じが、たまらなくてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104209" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「奥のところを刺激されすぎて、気持ちいい感覚が、どんどん溢れてきてっ…\n…あっ、あっ！　ダメっ！　これ、またイッちゃいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104210" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「お、お仕置きなのに、隊長よりも先にイクなんてっ……おっ、ほっ！　おひ\nっ、んほぉぉ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「んひぃぃんっ！？　先にイカせてやるだなんてっ……そんなこと言われたら\n、イキたくなってしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104212" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「おおぉっ、んおっ、おっほぉっ！？　イクッ！　イックッ……！　んっはぁ\nぁぁぁ～～～っ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あっ……れっ……！？　な、何故ですかっ……！？　どうして、急に動きを\n弱めるのです……！？　私いま、イキかけてっ……！　んひぃ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104214" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あっ、おっ！？　おぉぉぉっ！　おぉぉ～っ！？　また激しくオチンポがオ\nマンコをズリズリ擦られてぇ！？　はひっ、あっひぃ～！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104215" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ダメっ！　ダメぇっ！　１回寸止めされたから、さっきよりもすごいのが来\nてしまいますっ！　オマンコが勝手に、ぎゅーって締まりますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ふっほっ！　おっおっおっ！　おぉ～～～っ！　イグッ！　イグッ！　イグ\nぅぅぅ～っ！　今度こそ、本当にイッてしまいますぅぅぅ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104217" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「た、隊長もイッて欲しいですっ！　またお仕置きザーメンくださいっ！　膣\n内でも膣外でも、お好きなところに出して下さいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104218" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ひゃ、おっ、んおぉっ！　ほっ、おっ、おぉぉぉっ！　イクッ！　イキます\nっ！　隊長のオチンポで、オマンコイカされてしまいますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104219" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「オ、オチンポが膨らんでっ……！　隊長も、もうイクのですねっ！？　私が\nイク瞬間に、精子出されてっ……！　おぉぉっ！　おっ、おぉぉぉ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104220" ]},
		{"command":[ "WAITINPUT" ]},
												
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁぁんっ！　びゅーびゅー出ておりますっ！　隊長の子種が、またオ\nマンコの奥に届いておりますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「受精している中で、さらに受精させられてっ……無理やり孕まされるの、気\n持ちいいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ですが、これは相手が隊長だからでっ……！　隊長に犯されて、膣内出しさ\nれているから、幸せなのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　お慕いしている隊長との赤ちゃんっ……楽しみですっ！　無\n理やりなのに、妊娠するのが嬉しくてたまらないのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「おっ、おぉ～！？　赤ちゃんを想像したら、またイッてしまいますっ！　何\n回だって、受精アクメしてしまいますぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ふっ……はぁぁっ……おっ、んおぉぉっ……オマンコから、精子が逆流して\nますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「こんなに出されるなんて、思っていませんでした……オマンコが隊長の精子\nで、満ち溢れてますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、はぁぁっ……あ、あのっ……隊長……本当に妊娠していたら\n、責任を取っていただけるのでしょうか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104308" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「私としては……隊長との赤ちゃんなので、産みたいと思っております……そ\nれにこれは、お仕置きですので……一人でも育てていくつもりでして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104309" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「えっ……心配しなくても、ちゃんと責任を取ってくださるのですか？　ふふ\nっ……そのお言葉、とても嬉しいです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「きゃぁぁっ！？　隊長のザーメン、いっぱいかけられてますっ！　オマンコ\nだけじゃなくて、身体までドロドロにされてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「それにこの匂いっ…んっ、あっ、あぁぁっ！　嗅いでいると、頭がクラクラ\nしてきますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁっ！　くっ、おっ、おぉぉっ！　ザーメンの感覚と匂いだけで、\nイッてしまいますっ！　またアクメしてしまいますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あひっ、んんっ！　おっ……おっ！　おっほぉぉぉ～っ！　イクッ！　イク\nイクッ！　精子浴びせられながら、アクメしますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「くっ……あぁぁぁっ！　んはっ、あっ、あっ！？　おぉっ……おっ、おっ！\n　おぉぉ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「んっ……あっ……あっ、はふぅっ……全身精液まみれにされるだなんて……\nこれが、隊長なりのお仕置きなのですねっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104406" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ふふっ……こんなお仕置きなら、もっと受けたいと思ってしまいますね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「オマンコだけじゃなくて、お尻の穴やお口にも、たくさん精液を注いでいた\nだいて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「あぁっ……想像するだけで、また軽くイッてしまいますっ……くっ、あっ…\n…！　んんっ、んはぁぁぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104409" ]},
		{"command":[ "SETIMAGE", "0", "still_00031201_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アザミ" ]},
		{"command":[ "SETTEXT", "「ふぅっ、ふぅぅっ……この度は、本当にご迷惑をおかけしました……心より\n、お詫び申し上げます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_312_0104410" ]},

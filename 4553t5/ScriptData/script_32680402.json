{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0098" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「へぇー。ここがセックスをするための部屋なのね。中々おしゃれなところじ\nゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404101" ]},
		{"command":[ "SETCHARA", "0", "char_00026804_01", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「え？　セックスが何か知っているのかって？　まったく知らないけど、今か\nら隊長が教えてくれるんでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404102" ]},
		{"command":[ "SETCHARA", "0", "char_00026804_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「不安なんて全然ないわ。だって、私は隊長のことを信じているし……愛して\nいるもの。どんなことだって、受け入れてみせるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404103" ]},
		{"command":[ "SETCHARA", "0", "char_00026804_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「だから、私にセックスを教えてちょうだい。隊長のためなら、痛いことやつ\nらいことも、我慢できるから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404104" ]},
		{"command":[ "SETCHARA", "0", "char_00026804_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ……隊長の手が、おっぱいを揉んできてっ……んっ、はぁぁっ…\n…これ、すごく気持ちいいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404105" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「こうしておっぱいを揉まれていると、おヘソの下のところが疼いてっ……ん\nんっ！　股間のところが、熱くなってくるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404106" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふっ、んっくっ……なんだか、おしっこするところが濡れてきてるっ……な\n、なんで……お漏らしなんて、してないのにっ……ひゃうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……え？　今からこの濡れた穴……オ、オマンコ？　に、隊長の\nオチンポ？　を、挿れるの？　んっ、分かったわ……それがセックスなのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404108" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ……これが隊長の言う、オチンポなのね。そんな大きいモノ、本当に入\nるのかしら……私の穴、すごく小さいと思うのだけれど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「でも、隊長が大丈夫って言うんだから、大丈夫よね。いいわよ……遠慮しな\nいで、思いっきり挿れてちょうだいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ひぎぃぃぃぃっ！？　い、痛いっ！　痛いぃっ！　な、なにこれっ！？　想\n像していたより、ずっと痛くて、苦しくてっ……んぐぅぅぅっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404111" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「隊長のオチンポが大きすぎて、お腹が膨らんでるっ……ぐっ、あぁぁっ！　\n奥まで、くるぅ……ひぐっ！　んぎひぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、ぐっ、あっ……痛いのに、おヘソの下のところが切なくて……痛みと\nは違うズキズキした感覚が、拡がってるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「えっ……具体的に、どこがズキズキするのかって……えっと、オマンコ？　\nの、奥のところ……い、今っ！　隊長のオチンポが当たったところぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「うぐぐっ……がっ、あっ……痛いっ……苦しいっ……でも、嬉しい……隊長\nのオチンポがオマンコに入ってるって思うと、幸せな気持ちになって……んぅ\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「そんなに苦しいなら、やめるかって……や、ヤダ。やめないでっ。このまま\n、オチンポ挿れ続けてっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404116" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「絶対、最後まで我慢するから……だから、私にセックスを教えてっ……あっ\n、あんんっ！　ひゃ、あぁっ！　あはぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404117" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ、あぁぁんっ！　隊長のが、オマンコを出たり、入ったりしてる\nっ……お腹の中、かき回されてるみたいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「まだオマンコは痛いし、苦しいけど……オマンコの奥をトントンされるたび\nに、痛みが和らいでっ……んふぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ひゃっ、んはぁっ！　おっぱい揉まれながら、オマンコをズポズポされるの\n、好きかもっ……頭がフワフワしてくる感じがっ……あっ、んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404120" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ、はぐぅっ！　気持ちいいよぉ……もうこれ以上、入らないけど\n、もっと奥まで挿れて欲しいって思っちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404121" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　んっあっあっ！　そんな、乱暴にズンズンって突くなんてっ\n……あぁぁっ、オマンコが拡がってるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「私のオマンコ、隊長のオチンポの形になってるみたいで……さっきまで、小\nさな穴だって思ってたのにぃ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404123" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふっ、んんっ！　あっ、あんんっ！　も、もっと激しくしてっ……今より速\nく動いて、オマンコ思いっきりズポズポしてぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404124" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「今はもう、痛みより気持ちいい方が勝ってるからっ……オチンポでズンッて\nされると、ものすごい幸せを感じるからぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あぁぁっ！　んっ、あっ！　やっ、あはぁぁんっ！　隊長のオチンポ、勢い\nよくオマンコを突いてくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404126" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「オマンコの膣内、めくれちゃうっ。お腹の中が引き出される感じがっ……く\nぅぅっ！　あふっ、あっ、んぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ひゃ、あぁぁっ！　乳首、カタくなってるっ！　大量がおっぱい揉むから、\nツンッて尖ってるぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404128" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、そこ、そこぉ！　乳首クリクリされながら、奥をトントンされると、\nおヘソの下のところから、何か出て来る感じがしてっ……あっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁっ……なにこれ、怖いっ……私、こんなの知らないっ。ねぇ、隊\n長っ……これもセックスの影響なの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404130" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「イ、イク？　この何か来る感じのことを、イクッていうの？　わ、分かった\nわ……イクとき、ちゃんとイクッて言えばいいのねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404131" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、んひっ！　はぁ、あぁっ！　ぐっ、あぐっ！　ふっ、あっあっ、んひ\nゃ、あっ！　くっ、はふっ！　んんっ、ひゃぐぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404132" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、私、もうイクッ……ヘンなの、きちゃうっ……あっ、んぁっ\n！　イクッ、イクッ……あっ、イクッ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「隊長もイキそうなのっ……？　なら、一緒に……一緒にイキたいっ……！　\nお願い、一緒にイッてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404134" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んんっ、んっ、ぐっ、んくぅっ！　イクッ、イクッ……イッ、クッ……！　\nあっ、あっ！　ふぁぁぁ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404135" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あはぁぁぁぁっ！　あ、熱い液体みたいなのが、オマンコに注がれてるぅ。\nなに、これぇ。奥のところに、びちゃびちゃ当たってっ……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404136" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「せ、精液っていうの？　精子っていう、隊長の子種が詰まった汁で……あ、\n赤ちゃんの素って言われても……くっ、んふぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404137" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「えっ、あっ、んんっ！　どういうことぉ……セックスって、オマンコにオチ\nンポを挿れて、気持ちよくなることじゃないのっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、もう、分からないっ……気持ちいいのがずっと続いて、全然理解\nできないっ……あぁぁっ！　また、イクッ……んはぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404139" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「イクッ！　イクぅぅっ！　隊長の精液を感じながら……イクぅぅぅぅぅっ～\n～～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……んっ、あはぁぁ……すごく気持ちよかったぁ……こんなに\n気持ちいいことが、世の中にはあったのね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404201" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「とっても素敵な時間だったわ……でも、もうこの幸せな時間も、終わりなの\nね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「え？　まだまだセックスできるから、もっと付き合って欲しいの？　ふふっ\n……そう。まだしてもらえるのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「私は全然問題ないわ。身体も痛みに慣れてきたみたいだし、次は最初から激\nしく動いても大丈夫よ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ……じゃあ、きて、隊長っ……またいっぱい、気持ちいいのと、幸せを\n感じさせてちょうだいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404205" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あぁぁんっ！　あっあっ、んぁっ、あはぁぁっ！　最初から全力で、ズポズ\nポされてるっ。オマンコの奥、えぐられてるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404206" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「お腹が突き破られそうなくらい、激しくてっ……ひうぅぅっ！　そこ、すご\nいっ。奥のところ、気持ちいいのっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「いま、隊長がトントンってしてくれてるところが、特に好きでっ……あぁぁ\nっ！　やっ、あっ！　身体が痺れる感じがするっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404208" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふぇっ……奥以外にも、気持ちよくなれるところがあるの？　それって、ど\nこっ……んぁぅっ！　なんで、オチンポを抜いてっ……ひぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、そんな、オマンコの浅いところをっ……ひぃぃっ！？　あっ、あっ！\n？　なに、そこっ。奥とは違った気持ちよさが、背中を伝ってくるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404210" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「お、おしっこする穴の、後ろ側のところで、オチンポがズリズリ動いてっ…\n…んひっ！　ひゃ、あっ、あぐっ！　んっふぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404211" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「これ、Ｇスポットって言うのっ？　あっ、そこ、そこも、好きぃっ。奥もＧ\nスポットも、どっちも感じるっ……んひゃぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁっ……どっちも好きなら、両方刺激してくれるだなんてっ……そ\nんなことされたら、本当に頭がおかしくなるっ……あぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404213" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あひっ！　んっひぃっ！　あっあっ、おっ、あぁぁっ！　すごいっ。奥のと\nころと、浅いところ、交互にズリズリされてぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404214" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ダメっ、感じすぎるっ。幸せすぎて、勝手にオマンコ締まっちゃうっ……ん\nぅぅっ！　ぐっ、あぐっ！　ひっ、くふっ！　はっぐぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「やっ、あっ！　こんなの、またイクッ……隊長のオチンポで、イカされちゃ\nうぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404216" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、んぁっ、はぁぁぁっ！　気持ちいいの出てくるっ……奥のところ\nに、溜まってきてっ……イッ、イクッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ぐっ、あっ！　はふぅっ！　隊長もまたイキそうなのっ？　なら、また一緒\nがいいっ……隊長と一緒にイキたいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、あっあっ！　ふっ、あっぐっ！　んぁっ、はぁ、ふっ、かふっ！　あ\nっあっあっ、んっ、あっ！　はぁ、ひゃあぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404219" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「イクッ！　イクぅぅぅっ！　オマンコイクッ！　イッ、あっ……イッ、クッ\n……ぐっ、んんんん～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はひっ！　あひぃっ！　びゅーびゅー出てるっ。隊長の精子、たくさん出さ\nれてるぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404301" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「赤ちゃんの素が、オマンコの奥に流れ込んでっ……はぁぁっ、幸せっ……子\n種を流し込まれる感覚、たまらないわっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404302" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「どうしてこんなに幸せなのか、まったく分からないけど……私の本能が、悦\nんでるみたいでっ……んっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「もっと注ぎ込んでっ……隊長の精子、一滴残らず奥に出して欲しいのっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404304" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ちゃんと全部受け止めるからっ……だから、オマンコにどっぴゅんしてっ。\n赤ちゃんの種、流し込んでっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404305" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、ふっ……んっ、はふぅっ……いっぱい、出たみたいね……オマンコが\nドロドロしてるわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふふっ……セックスって、とっても素敵な行為ね。最初は、すごく痛かった\nけれど……慣れたら、どうってことなかったし」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404307" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「むしろ、途中から気持ちいいことばかり感じて……隊長が必死に動いている\n姿を見ると、より愛おしさが湧いてきたわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「好きって気持ちが、さらに強くなったの。これも、セックスの効果なのかし\nら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ……隊長。愛してるわ。これからもずっと、隊長のそばに居させてね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「きゃぁっ！？　オチンポが抜けてっ……あんんっ！　ちょ、ちょっとっ……\nどうして身体にかけるのっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404401" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_18" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、あぅっ！　熱いっ……オチンポから、白くてドロドロした汁が飛び散\nってっ……ぐっ、んぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404402" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「それに、すごい匂いっ……とっても臭くて、鼻に付く香りなのに……もっと\n嗅ぎたくなるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あぁっ、んっ……はぁぁぁっ……臭いっ……ドロドロしてて、気持ち悪いっ\n……なのに、もっとかけて欲しいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404404" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、んぁっ、あっ……ダメっ、この匂いと感触だけで、イッちゃうっ……\nイクッ！　イクぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404405" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はふっ……はぁ、あふぅぅっ……この白くてドロドロした粘液……もしかし\nて、これが隊長の精液なの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404406" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「そうなのね……ううん。見た目も匂いも、最悪だけれど……隊長の精液って\n聞いたら、全然イヤな感じはしないわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404407" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ねぇ……これ、舐めたりしても大丈夫なものなの？　ふーん……そう。なら\n、少し味見してみようかしら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ……ちゅくっ……ぐっ、うぐっ！？　な、なにこれ……酷い味っ。苦く\nて、美味しくないわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「でも、何故かもっと舐めたくなってしまうわ……ちゅ、ちゅぱっ……んんっ\n……ふふっ。隊長の身体から出た、液体だからかしら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0404410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0018" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「呼ばれておいてなんだけど、隊長の部屋って、かなり汚いわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403101" ]},
		{"command":[ "SETCHARA", "0", "char_00026804_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「まあ、私は別に気にしないけど……それで？　遊び相手になってくれると言\nっていたけれど、何をして遊ぶの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403102" ]},
		{"command":[ "SETCHARA", "0", "char_00026804_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「遊びは遊びでも、大人の遊び？　よく分からないけど、面白そうね。どんな\nことをするの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403103" ]},
		{"command":[ "SETCHARA", "0", "char_00026804_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふーん……私が隊長の股間に付いているモノを手で握って、動かす遊びなの\nね。単純そうだけど、奥が深そうな感じがするわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403104" ]},
		{"command":[ "SETCHARA", "0", "char_00026804_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「それじゃあ、さっそく遊びましょう。まずは、その股間についているモノを\n、出してちょうだい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「えっ、なにこれ？　私の股間には、付いてないモノが付いてる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403106" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「太くて、カタくて……それに、ものすごく熱いわ。これは何て言う名前なの\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「なるほど。男性器やペニス。オチンチンやオチンポという言い方もするのね\n。じゃあ、短くて分かりやすいし、オチンポって呼ぶことにするわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403108" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「えっと……このオチンポ？　を、どうすればいいのかしら？　手で握って、\n動かすとは聞いたけれど、やり方がまったく分からないのだけれど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403109" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふーん。大事なモノを扱うときみたいに、優しく握りながら、上下にゆっく\nり動かせばいいのね。とりあえず、やってみるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ……やったことのない動きだから、案外難しく感じるわ。でも、やりが\nいはある感じかな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403111" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「油断すると、手に力が入っちゃいそうだし……それに、ヘンな形をしている\nから、指が引っかかって……んぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「この伸びる皮みたいなのが、手の動きを邪魔してきて……くぅぅっ。さすが\n、大人の遊びね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「え？　なに？　こうやって、手を上下させる動きのことを、シコシコ、って\n言うの？　ふーん……変わった呼び方ね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403114" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「この動きをしているときに、オチンポ、とか。シコシコ、とか……あとは、\n私が直感で思ったことを、素直に言ったりするのがルールなのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「分かったわ。じゃあ、思ったことは常に言うようにするわね。それじゃあ、\nこのカタいオチンポ、もっとシコシコしまくってあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403116" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「シコシコ、シコシコ……んっ、はぁ……シコシコ、シコシコ……どう？　こ\nんな感じで、合ってる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふふっ。最高だから、もっと言って欲しいだなんて……隊長にそんなこと言\nわれたら、もっと言ってあげたくなるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403118" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「私の小さな手で、このカタくて、熱いオチンポ……シコシコしまくってあげ\nる。ほらっ……シコシコ、シコシコ……あぁっ……シコシコ、シコシコ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「シコシコ、シコシコ……ひゃうっ……！？　な、なに？　手に、粘液みたい\nなのがついて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403120" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「これは我慢汁と言って、オチンポが気持ちよくなると出て来るものなの？　\nこれがたくさん出せる人は、この遊びが上手いという証拠なのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403121" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「じゃあ、私はかなりこの遊びが上手いってことになるのね。ふふっ。初めて\nする遊びなのに、上級者って感じがして悪くないわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403122" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ところで、このオチンポをシコシコする遊びは、何て言う名前なの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403123" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「手、コキ？　ふーん、聞いたことのない遊びだわ。さすがは、大人の遊びっ\nて感じね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「え？　この調子で、もっと速くオチンポをシコシコして欲しいの？　分かっ\nたわ。それじゃあ、遠慮なくシコシコさせてもらうわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403125" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ……はぁぁっ……シコシコ、シコシコ……んんっ……シコシコ\n、シコシコぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403126" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「シコシコするたびに、我慢汁がオチンポに絡んで、ぬちゃぬちゃ音を立てて\nる……変な音なのに、聞いてると、身体が熱くなってくるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「オチンポを握って、上下にシコシコしてるだけなのに……おヘソの下のあた\nりが、ズキッって痛む感じがっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「何なの、この感覚っ……あっ、うぅっ……さすが、大人の遊びなだけあって\n、未知の経験だわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403129" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……シコシコ、シコシコ……隊長のカタくて大きいオチンポ、シ\nコシコぉ……んっ、あっ……あぐっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403130" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ヌルヌルのグチュグチュで……速くシコシコするたびに、にちゅぐちゅって\n、粘液質な音が強くなって……あぁっ、あっ……シコシコ、シコシコぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「シコシコ……にちゅぬちゅ……シコシコっ……んっ、んんっ！？　な、なに\n？　オチンポがビクビクって、跳ねまくってるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403132" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「この反応が出てきたら、もうすぐ遊びが終わる合図なの？　終わりって……\nいったい、何がどうなって終わるっていうの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403133" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「余計な事は考えずに、最後までシコシコしろだなんて……わ、分かったわ。\nオチンポ、シコシコするわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「シコシコ、シコシコっ……オチンポ、シコシコ……ビクビクオチンポ、いー\nっぱいシコシコぉ……んっ、あっ、あっ……シコシコ、シコシコぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403135" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「きゃあぁっ！？　えっ、な、何か白くて熱いのが、オチンポから噴き出して\nっ……んっ、ひっ、あぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403136" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_05" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「なに、このドロドロの液体っ。それに、ものすごく臭いっ……はぅっ、んん\nっ！　はぁ、はふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ……まだ、出てくるっ……え？　いいから、シコシコを続けろっ\nて……んっ、うんっ……シコシコ、シコシコぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403138" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ひゃ、あっ……熱いの、身体中にかけられて……シコシコ……白いのどぴゅ\nどぴゅ、シコシコぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403139" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「シコシコ……シコシコっ……くぅぅっ！　ヘンな匂いなのに、身体が疼くっ\n……あぁぁっ……シコシコ、オチンポシコシコっ……あくぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403140" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……やっと止まったわね。それにしても、この白い液体はなに\n？　我慢汁とは違うみたいだけれど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403201" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「この白いのは、精液というの？　ふむふむ……オチンポが気持ちよくなると\n、最終的に出て来るものなのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「話をまとめると……この遊びは、いっぱいオチンポをシコシコして、どれだ\nけ精液を搾り出せるかを競うもの、ということかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あら？　正解だけど、違うの？　……なるほど。搾り出すという一方的なも\nのじゃなくて、二人がお互いを信頼して、協力し合う遊びなのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403204" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「確かに、私が無理やりシコシコしまくっても、隊長が気持ちよくならないと\n、精液が出てこない……そう言われると、納得できるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403205" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「とはいえ、信頼という部分は、まったく問題ないと思うわ。だって私は、隊\n長のことを心から信頼しているし、愛しているもの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あら？　オチンポがまた大きく、カタくなって……ふふっ。もしかして、ま\nだ遊び足りないのかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403207" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「隊長がやる気なら、私も付き合うわ。だってこの遊び、思っていた以上に楽\nしいもの。ほら……もう一回、オチンポシコシコしてあげるわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403208" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ……はぁっ……シコシコするたびに、精液が溢れて来る……オチンポの\n奥の方に、残っているのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、んぁっ……手にドロドロが絡まって……あぁっ、すごい……我慢汁が\n絡んでいたときより、シコシコしやすいわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403210" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ、んっ……ふっ、うぅ……シコシコ、シコシコぉ……精液出し終えたば\nかりの、カタいオチンポ、シコシコっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403211" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「シコシコ、シコシコ……オチンポ、シコシコ……くぅぅっ……ヘンな匂いが\n、どんどん濃くなってくる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「嗅いでいるだけで、頭がボーっとして……おヘソの下のズキズキが、さらに\n強くなってきて……んっ、あっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403213" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「こんなの、勝手に手が動いちゃうっ……優しくしないといけないのに、指が\nオチンポに絡みついちゃうぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……シコシコ、にちゅにちゅ……精液の絡まった指で、ぐちゅぐ\nちゅ、ずりゅずりゅ……んっ、あっ……あんんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403215" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あんっ……隊長のオチンポ、また膨らんでっ……さっきみたいに、ビクン、\nビクンって跳ね始めてきた……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「また、出ちゃいそうなのね……さっきみたいに、精液をびゅーって、出しち\nゃいそうなのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403217" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ……はぁっ……いいわよ。好きなときに、いっぱいぴゅっぴゅっして…\n…私の手コキで、気持ちよくなって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ほらっ……シコシコ、シコシコぉ……隊長のガチガチオチンポ、シコシコ、\nぴゅっぴゅっ……にちゅにちゅ、ぐちゅぐちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403219" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ……あっ……くるっ……また精液どっぴゅんされちゃうっ……んっ、あ\nっ……シコシコ、シコシコ……あぁっ、シコシコぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あんんっ！　また身体に精液が飛び散って……はぁ、あっ！　すごいわ。さ\nっきと同じくらい、噴き出してくるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403301" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「あっ、シコシコするのを、忘れちゃダメなのよね……んっ、あっ……シコシ\nコ、シコシコぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふぁぁっ……シコシコすると、精液の勢いが強くなって……もっと身体にか\nかっちゃうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403303" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「服がドロドロになって……この濃厚な匂いが、染みついちゃいそうだわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403304" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「臭くて、嗅いでるとヘンな気分になるのに……隊長が付けてくれた匂いだっ\nて思うと、嬉しくなっちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403305" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……もっと出してっ……私の服に、隊長の匂いを染み込ませて…\n…」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ほらっ……ぴゅっぴゅっ……ぴゅっぴゅっ……オチンポから精液、シコシコ\nどっぴゅんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ……はふぅ……いっぱい出たわね。ふふっ。どうだったかしら？　結構\n思ったことを、素直に言ったつもりだけれど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403308" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「シコシコだけじゃなくて、どっぴゅんやぴゅっぴゅっって掛け声が最高だっ\nた？　そう言ってくれると、嬉しいわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「んっ……隊長、お疲れ様。すごく楽しかったわ。またこうした大人の遊びを\n、いっぱい教えてちょうだいね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「きゃあぁっ！？　精液が顔にかかって……あぁっ！？　手で感じるより、熱\nく感じるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403401" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「それに鼻に近いせいか、匂いが強烈で……すぅぅっ……はぁぁっ……あっ、\nあっ……頭、おかしくなりそうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403402" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「こんなの、シコシコ続けられなくなっちゃうっ……でもこの遊びは、隊長と\n協力しないといけないし……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403403" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「隊長っ……あっ、あぅ……シコシコ、シコシコぉ……精液びゅーびゅー……\nいーっぱい、ぴゅっぴゅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403404" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「もっと私にかけてっ……隊長の熱くて臭い精液、どっぴゅんしまくっていい\nからっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「私の顔に、隊長の匂いをつけてっ……隊長の匂いなら、全然イヤじゃないか\nらっ……はぁ、あぁぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふっ、あっ……シコシコ、シコシコぉ……！　隊長のオチンポ、シコシコ、\nどぴゅどぴゅぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……たくさん顔にかけられちゃったわね。こんなベトベトした\nものが顔についたら、いつもは不快感がすごいけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403408" ]},
		{"command":[ "SETIMAGE", "0", "still_00026804_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「でも、何でだろう……隊長の精液って思うと、むしろ嬉しいというか……も\nっとかけて欲しいって思えてくるの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0403409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・スバル" ]},
		{"command":[ "SETTEXT", "「ふふっ……おかしいよね。でも、事実だから……隊長。よかったら、今度は\n違った大人の遊びを、教えてちょうだい」", "NORMAL" ]},

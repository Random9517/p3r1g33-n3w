		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっ、熱いぃっ！　手のひらにネバネバした汁が、どっぴゅんされてっ……\n！　ぐっ、くぅぅ～！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503401" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「それにこの勢いっ……もしこれがオマンコに出されていたら、確実に子宮に\n届いてしまうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「はぁーっ、はぁぁーっ……ほら、お前も想像してみなっ……！　この手のひ\nらが、私のオマンコだったら……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「この濃厚な孕ませ汁が、オマンコの奥っ……女の大事なところに入り込んで\n、卵子まで届いてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そのまま受精して、お前の子を孕んで……少しずつお腹が大きくなってきて\n……あぁぁっ！　想像しただけで、興奮しちまうよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！？　お前も興奮したようだねっ！　射精の勢いが、さらに増し\nてきているじゃないかっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503406" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「チンポが激しく動き回って、根元のところから精子を搾り出しているのを感\nじるよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「このまま、気が済むまで出していいからねっ……！　射精が終わるまで、乳\n首もこねまくってあげるよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503408" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「くぅぅっ！　あっ、んんっ！　はぁ、あっ……ぐっ、あぅっ……あっ、あん\nっ！　本当に、熱くて長い射精だねぇ……！」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「私がルナルバースとの戦いを控えていることは、既に知っていると思うけど\n……それで？　お前はどっちの味方をするつもりだい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503101" ]},
		{"command":[ "SETCHARA", "0", "char_00002505_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「こっちに味方するっていうなら、今からこの勃起チンポをシコシコして、い\nーっぱい気持ちよくしてあげるよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503102" ]},
		{"command":[ "SETCHARA", "0", "char_00002505_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ふふっ……そう簡単に誘惑されないみたいだねぇ。でも、実際にチンポをシ\nゴかれたら、そんなことも言ってられなくなると思うけどね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503103" ]},
		{"command":[ "SETCHARA", "0", "char_00002505_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ほらっ、どうだい……気持ちよくて、考えも変わってきたんじゃないかい？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503104" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ん？　どうしたんだい？　まだ手を動かしていないのに、そんなに悶えて…\n…もしかして、強く握りすぎたのかねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503105" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_02" ]},		
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「なるほど……チンポと乳首の刺激が気持ちいい上に、おっぱいの感触が加わ\nって、たまらないだなんて…………お前は本当に可愛いヤツだねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そんな顔をされたら、私も興奮しちまうよ……ほら。もっとチンポを勃起さ\nせな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503107" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そう、その調子だよ……このまま乳首をぎゅーっとしながら、手のひらでチ\nンポの先端をスリスリしまくってあげるからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503108" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「もちろん、カリのあたりもたくさん撫でてあげるよ。お前が感じるところは\n、よーく分かっているからさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「それじゃあ、いくよ……意識が飛ばないように、気を引き締めておきな！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503110" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……あっ、はぁぁっ……どうだい。私の手は……温かくて、スベ\nスベで、気持ちいいだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503111" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「はぁぁっ……手のひらでチンポがビクビク動いてるのを感じるよ……軽く擦\nっているだけなのに、いやらしいねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ほら……スリスリっ、スリスリっ……んっ、はぁっ……この可愛らしい乳首\nも一緒に、シコシコっ、シコシコぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503113" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「特にこのおしっこの出るところ……尿道口を開くように撫でまわすと、より\nいっそうチンポが震えてっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっ、くふっ……はぁ、あっ……んっ、んんっ……はぁ、はぁっ……くっ、\nあっはぁぁぁ～っ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503115" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「チンポから先走り汁が出てきたね……手のひらにまとわりついて、グチュグ\nチュといやらしい音が鳴ってるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ふふっ……この汁をチンポに塗りたくれば、もーっとスリスリしやすくなる\nねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503117" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そうすれば、今よりもっと気持ちよくなるのは間違いないよ。しかもその状\n態で、乳首を強く引っ張られたら……想像するだけで、たまらないだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ほら……もっと気持ちよくしてください、って言ってみな。お前がおねだり\nすれば、すぐにでも応えてあげるからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503119" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あんんっ……もっと強くスリスリ、シコシコしてください、だなんて……！\n　あぁ、もうっ！　本当に私を興奮させるのが上手いねぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503120" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ、んっ、あはぁっ！　先っぽを撫でまわしながら、カタくなった\n乳首を引っ張ると……チンポが疼きまくってくるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「いまにも射精しそうなくらい、ビクンビクンって跳ねまわって……すっごく\nいやらしいねぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503122" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「勃起しすぎて、チンポが一回り大きくなっているし、さらにカタくなってき\nてる……こうして握っているだけで、オマンコが濡れちまうよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「はぁ……あっ、ふっ……！　んぁっ、あっ……ぐっ、んっはぁぁっ……！　\nふーっ……んふーっ……！　ふっ、はふぅぅぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503124" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっ、んぁっ……ほら、分かるかい？　私の乳首……お前の乳首と同じくら\nい、ビンビンに勃起しているよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「こうして押し付けると……ふかふかの柔らかなおっぱいの感触と、コリコリ\nした乳首を感触を、同時に味わえるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503126" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んっ、あぁぁっ！　おっぱいを押し付けながら、チンポを撫でまわしてると\n、さらに先走り汁が出てきてっ……ひゃ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503127" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ネバネバした汁で、私の手がローションみたいになってっ……ヌルヌルが拡\nがってくると、すごく気持ちいいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「お前の熱を感じてっ……あぁっ！　こんなの、我慢できないっ……！　もっ\nと乳首を引っ張ったり、チンポをナデナデしたくなるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ぐっ、んんっ！　あっあっあっ、ひゃ、あぁっ！　くふっ、ふーっ！　あん\nっ、あっ……んぁっ、あっ！　ふぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「もっと速く、スリスリ、シコシコしてあげるからねっ……イキたくなったら\n、いつでもイッていいんだよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503131" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「私の手をオマンコだと思って、思いっきり射精しなっ……お前の濃厚ザーメ\nンで、手のひらを孕ませてくれていいよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503132" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっあっ、んっ、あっ！　チンポだけじゃなくて、身体がビクビクしてっ…\n…精液、出ちまうんだねっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503133" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「いいよ、出しなっ！　このまま思いっきりっ……お前の孕ませ汁、どっぴゅ\nんしていいからねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ほらっ！　出せっ、出せっ！　私の手を妊娠させる、いやらしい子種っ……\nどぴゅどぴゅ噴き出しちまいなっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁっ……！　すごい勢いで精子が出てるっ……あぁっ、なんて勢い\nっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503136" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あぁっ、もうっ……お前がチンポをビクビクさせすぎるから、手がズレちま\nったじゃないかっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503137" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「私の手にどっぴゅんしていいと言ったのにっ……んっ、あっ！　まだチンポ\n汁が出てっ……んん～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……いいよ。このまま、好きなだけ出させてあげようじゃないか\n……！　ほらっ、溜まってるもの、ぜんぶ出しなっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503139" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んっ、あっあっ、ふあぁっ……精子の濃い匂いが漂ってきてっ……はぁぁっ\n、嗅いでいるだけで、子宮が疼くぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503140" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ふぅっ……射精が終わったようだね。どうだい？　スッキリしたかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503201" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「じゅうぶん満足した、ねぇ……ふふっ。そんな言葉で、私を騙せるとでも思\nったのかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「こうして乳首をこねくり回すと……ほら、まだガチガチに勃起するじゃない\nか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503203" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「激しくヒクついて、いやらしいねぇ！　もっと搾り取って欲しくて、たまら\nないんだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503204" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「大丈夫だよ。お前がして欲しいことは、ぜーんぶ分かっているからね……ほ\nら、私のおっぱいに身体を預けて、リラックスしな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503205" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んっ、あっあっ……くっ、んぅっ！　チンポをスリスリすると、尿道の奥に\n残っていた汁が溢れて、私の手にまとわりついてくるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503206" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「先走り汁と違って、めちゃくちゃ粘液質で……軽く擦るだけで、すごい音が\nするねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ、はっ……それに、匂いももっと強烈になって……この音と匂い\nで、私の乳首がもっと勃起してきちまうよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んふっ、ぐっ、ふぅぅっ……！　お前のチンポや乳首も、カタくなりまくっ\nてっ……いっぱい弄って欲しいと、言っているようなものじゃないかっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503209" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んんっ！　んん～っ！　乳首を押し付けながら、お前の乳首をクリクリした\nり、シコシコしたりすると……チンポが跳ねまくってくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503210" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そんなに動いていたら、スリスリしにくいだろうっ……！　ほらっ、大人し\nくしなっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503211" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そう、いい子だ……ぜーんぶ私に任せて、お前はただ快楽に身を委ねている\nといい……チンポと乳首に、意識を集中させるんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503212" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「スリスリ、スリスリっ……シコシコ、シコシコぉ……！　先走り汁まみれの\n勃起チンポ、ナデナデぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503213" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっ、くふっ……はぁ、あっ……！　私のコリコリ乳首も、もっと味わって\nみろ……ほら、ぎゅーってしまくってやるからなっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んふーっ……ふーっ！　はっ、くっふっ……！　あっ、あっ……んぁっ、は\nぁぁっ！　チンポ、ガチガチっ……私のオマンコ、もっと濡れてくるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「すごく可愛いぞっ……お前も、お前のチンポもっ……このピンと尖った、小\nさな乳首もっ……ぜんぶが愛おしいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503216" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「私の味方になれば、今以上の快感を与えてやるよっ……だから、私の味方に\nっ……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ、んはぁぁぁっ！　チンポがさっきよりも強く、ビクビクと跳ね\nまくってるっ！　もう一度、射精するみたいだねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503218" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ほら、出していいんだぞっ……お前の好きなところにっ……！　さっきと同\nじようにしてもいいし、私の手の中でもいいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「我慢せずに、チンポ汁をびゅーびゅーしまくりな……！　ほらっ、シコシコ\nっ……スリスリっ……！　シコシコ、スリスリっ……あっ、あんんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503220" ]},
		{"command":[ "WAITINPUT" ]},
												
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ふはぁぁぁっ！？　あっ、あぁっ！　また、手のひらからチンポがズレてっ\n……くっ、んふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503301" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「二回目だというのに、まだこんなにっ……チンポ汁、溜め込みすぎだよっ…\n…！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「な、なに？　もっと出したいから、射精中でもチンポをギュっとして、乳首\nをシコシコしながら、おっぱいを押し付けて欲しいだって？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503303" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ああ、いいよっ……お望み通りにしてあげるようじゃないかっ……だから、\n遠慮せずに出しちまいなっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503304" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、くっ、はふぅっ！　あっあっ……こんなに身体を震わせなが\nら、射精をするだなんてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503305" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「この必死に精子を搾り出す姿が、たまらなく愛おしい……！　ずっと見てい\nたいよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ……お前が悶える姿を、そばで感じるだけでっ……私も軽くイッ\nてしまいそうだっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あっ……ぐっ、あっ！　んんっ！　ひゃ、あっ……！　あぅ、んっ、あっ！\n　ふっ、んぅぅぅ～っ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「はっ……はぁっ……オマンコの奥が、ジンジンするっ……ふふっ……私の身\n体がさらに熱くなっているのが、分かるかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「この私が手コキをしながら、軽イキしてしまうだなんて……ふふっ。お前は\n本当に、魅力的な男だねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0503310" ]},
		{"command":[ "SETIMAGE", "0", "still_00002505_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あぁっ、オチンポ震えてるっ……出るのっ？　出しちゃうのっ？　あぁっ、\nアーちゃんもっ、もうダメっ……イクっ、イクからぁっ！」", "NORMAL" ]},

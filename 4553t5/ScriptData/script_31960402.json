		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「人聞きが悪いって……実際、そうじゃない。現役アイドルに手を出して、オ\nチンポで逆らえなくして……この極悪人ー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404308" ]},

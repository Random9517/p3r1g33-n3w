		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「実はぁ、けっこーヤバめのお話聞いちゃったりしててぇ。ちょーっと、ホン\nトかどうか直接聞いちゃうのがいいかなぁーって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「ほら、これって……マジのやつなのかなーって。あっはっ♪　そう、シルエ\nールと色々しちゃってる感じのやつ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404103" ]},
		{"command":[ "SETCHARA", "0", "char_00019604_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「ありゃあ、その慌てぶりからすると、これって結構ちゃんとマジなやつなん\nだ～。うわー、スキャンダルだねぇ……どーしよっかなぁー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404104" ]},
		{"command":[ "SETCHARA", "0", "char_00019604_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「まあ、アーちゃんもね、鬼って訳じゃないし？　一応、これは見なかったこ\nとにしてあげてもいいんだけどー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「でも、タダってわけにはいかないのは、分かるよねぇ？　うんうん、おにー\nさん……話が早くてえらいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404106" ]},
		{"command":[ "SETCHARA", "0", "char_00019604_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「そっ、アーちゃんともシてくれないかなーって。なーに？　アイドルに手を\n出すのはとか言って……じゃあシルエールはどーなのぉ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404107" ]},
		{"command":[ "SETCHARA", "0", "char_00019604_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「ふふっ、そーだよねぇ。もうおにーさんは、手を出しちゃってるヘンタイさ\nんなんだから……こんな誘惑……逆らえないよねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404108" ]},
		{"command":[ "SETCHARA", "0", "char_00019604_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あんっ！　んふふっ……おにーさんの本気スイッチが入っちゃったぁ……♪\n　あんっ、いきなり足をそんなに上げさせるなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404109" ]},
		{"command":[ "SETIMAGE", "0", "still_00019604_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んふぅっ……あんっ、そう、そこぉ……これっ、オチンポ……このまま来て\nぇ……あっ、入って……来るっ、んふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404110" ]},
		{"command":[ "SETIMAGE", "0", "still_00019604_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「なぁに……おにーさんってば……もう、ガッチガチにしてるじゃない……割\nと最初から期待してたり？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404111" ]},
		{"command":[ "SETIMAGE", "0", "still_00019604_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「ふぅーん、まぁ、そういうことにしておこっか♪　んっ、それで……こっか\nら、どういう感じにするのかなー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あんっ……おっぱい……触るんだ……んふっ、なるほどね……んっ、あっ、\nんくっ……オーソドックスじゃん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404113" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev196_04b_0000", "ev196_04b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んっ、そうそう……乳首……優しく、コリコリって転がす感じにね……んふ\nっ、ベタだけど……大事だもんねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んっ、シルエールにも似たような感じで責めてるのかな？　んっ、あっ……\n！　はんっ、んふっ、急に……ピストン速くしてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404115" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「そんなに聞かれると、困っちゃうこと聞いちゃった？　あっ、あんっ！　ん\nんっ、そこぉっ、アーちゃんの好きなとこぉっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「もう弱点責めてくるなんてぇ……やっぱりおにーさんってば、はっ、ふっ、\nケダモノなんだからぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んんっ、こうやって、アイドル食べ慣れてるなんて……ファンのみんなに知\nられたら、おにーさん、ただじゃ済まないよねぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んひゃぅっ！　あっ、んんっ……だ、だからって口封じ……？　んちゅぷっ\n、れる……んりゅぅ……いきなりキスぅ……ずるぃ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んひゅっ……あっ、首筋……舐めるのも……あんっ、ゾクゾクするしぃ……\nあぁっ、そんな高く足を上げさせるなんて……恥ずかしい……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「うんっ、んふっ……開き直って……本気で来てる……んっ、ちゅぷっ……あ\nっ、おにーさんのオチンポ……あひっ、あっ、ひぃんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「ヤバ……こ、れっ……思ってた以上に……ゾクゾクするっ……ひっ、んふっ\n、おにーさんのっ……エグいしっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あっ、ひっ、そ、そこぉっ……好きなトコぉっ……♪　やはっ、んっ、あっ\n、そぉ……さきっぽでコリコリされるとっ……あっ、んぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「腰……砕けちゃってっ……あっ、何も……できなくなるっ……ひゃっ、ふっ\n……あぁっ、まだ……ゴリゴリっ……押し付けられてるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あんっ、んぁっ、あぁっ……す、好きっ……あぁっ、それ……好きぃっ……\n♪　うぁぁ……弱点全部バレちゃってるの……ヤバすぎぃっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んぁふっ……あっ、な、何で止めたの……？　えっ……まだイクの……早い\nから……？　もっと炙ってから……ひゃふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あっ……んんっ……また、おっぱい……んんっ、それに……あっ、やんっ、\nそこ……脇とかっ、くすぐったいし……ひゃ、ふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ……なんか、ジリジリされたら……敏感になってきちゃってる\nんですケド……んっ、ね、ねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「まだ……オチンポ……止まったままなの……？　また、動き始めても……い\nーかなぁーなんて……思うんですケド……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「お、おねだりぃ……？　こんだけジリジリさせて、そーいうこと言うなんて\n……おにーさん、やっぱ……ヘンタイぃ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「でも……言っちゃうからぁ……だって、オマンコ……欲しがって待ち切れな\nいからぁ……おにーさん、またオチンポ……ズボってしてぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んぁっ、あっ、あぁっ！　またっ……ズリズリ来たっ！　オチンポっ……本\n気ピストンっ、始まったぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「ひゃんっ、あんっ、あぁっ、あぁんっ♪　しょこっ、こんなっ、あっ、中っ\n……ずりずりっ、いっぱいっ……来てるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404133" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、おにーさんのっ、太いのがぁっ、奥っ、擦れてぇっ……良す\nぎっ……良すぎてぇっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あんっ、イクっ、イッちゃうっ！　もうっ、すぐにオマンコイッちゃうのっ\n、んぁぁっ、イクぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「はぁぁぁぅ……中出しっ……あぁっ、中に……出してる……おにーさんのせ\nーえき……アイドルアーちゃんに……直接出てる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404136" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00019604_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んっ、駄目……抜いちゃ駄目……衣装汚しちゃうから……ちゃんと全部中に\n出すの……ねっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「そう……このままぁ……あぁっ……あったかいよぉ……これで、あたしも…\n…おにーさんのオチンポに逆らえなくなっちゃうんだぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404138" ]},
		{"command":[ "SETIMAGE", "0", "still_00019604_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ、んっ、ふはぁ……よかったぁ……こんな気持ちいいコト……\n他にないでしょ……んふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404139" ]},
		{"command":[ "SETIMAGE", "0", "still_00019604_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「オマンコ……おにーさんのオチンポの形にならされちゃった……♪　やっぱ\nり、おにーさん……危ない人だったね……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404140" ]},
		{"command":[ "SETIMAGE", "0", "still_00019604_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んっ……あっ、ところで……おにーさんのオチンポ……まだ、全然よゆーあ\nる感じだったりする？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404201" ]},
		{"command":[ "SETIMAGE", "0", "still_00019604_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「だよね……だって、まだ中でウズウズしてるの分かるもん。これ、一発出し\nたくらいじゃ全然収まんないって感じなんでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「いーよ……アーちゃんは、おにーさんのオチンポ、大歓迎だから……また続\nきしちゃお……ねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「はぁんっ♪　あっ、ふふっ、ほーら、もうスイッチ入り直しちゃってるし…\n…あっ、あぁんっ、おにーさんのオチンポ現金すぎぃ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404204" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev196_04b_0000", "ev196_04b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んっ、くっ……アーちゃんも……一方的にされたままじゃないからね？　ほ\nれほれ、うりうり……んっ、どうだっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「ふふっ、どうしたのかなー？　いつも、イケイケリードしてるおにーさんが\n、全然余裕ない顔しちゃってない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「アーちゃんの、柔らか締めにメロメロになってるのかなぁ？　ふふっ、アイ\nドルモードだからって油断した？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「えっ……？　ここからが……本当のスイッチ？　またまた、なんかテキトー\nなこと言って、そんなのは何も……あひぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んぁっ、くっ、んふっ……あっ、うんっ……ちょっ……あっ、おにーさっ、\nまっ……そこっ、あっ、グリグリしちゃっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「ひっ、んひぁっ、あひぃっ！　今のっ……さ、さっきイッて敏感な……場所\nぉっ、あっ、だ、だから続けてしてるって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「そんなのズルだしっ……あっ、んんっ！　今っ……おっぱいつまむのもっ、\nあっ、反則っ……ズルっ、いぃぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「んふぅっ、あんむっ、ちゅぷっ……き、キスまれぇ……あんっ、はっ、んは\nぁぁんっ、やら……こんら、止まらない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「あっ、んむぅぅっ……あたし……堕とされちゃうっ……おにーさんのオチン\nポで、ダメにされちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「やらっ、オマンコっ……はぁんっ、またっ、イキたくなってるっ、あぁっ、\n太いので分からされちゃうっ、はぁんっ、あっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404214" ]},

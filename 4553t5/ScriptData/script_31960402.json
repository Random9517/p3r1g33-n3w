		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「はんっ、あんっ、あぁんっ、ダメ……アイドルなのにっ、しちゃいけない顔\nしてるっ♪　おにーさんの前で……イキ顔見せちゃうっ♪」", "NORMAL" ]},

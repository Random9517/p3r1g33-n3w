		{"command":[ "SETNAME", "アトロポス" ]},
		{"command":[ "SETTEXT", "「もうどうでもいいって言うか……おにーさんのじゃないと満足できないカラ\nダにさせられちゃったぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_196_0404307" ]},

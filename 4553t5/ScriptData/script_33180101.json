		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「俺が……パ、パイズリのテクニシャンだって？　な、何だよ、誰に聞いたん\nだ、そんな話！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103102" ]},
		{"command":[ "SETCHARA", "0", "char_00031801_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「は……？　俺の下につけてもらった部下たちが、そういう噂をしてた……そ\n、そうなんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103103" ]},
		{"command":[ "SETCHARA", "0", "char_00031801_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「根も葉もない嘘……？　バ、バカ……そりゃあ、俺だって……団長まで任さ\nれてんだ……それなりに、することは、し、してるさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103104" ]},
		{"command":[ "SETCHARA", "0", "char_00031801_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「だからってお前にしてやるかどうかは……は、はぁ？　嘘じゃねぇしっ！　\nそ、そんなに言うなら証拠を見せてやるよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっ、く……こうやって……オッパイで……チ、チンポを挟んでやれば……\nいいんだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103106" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「うっ……こんなに大きかったか……いや、そ、そうだな……まぁまぁ、悪く\nないんじゃないか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「それで、えっと……んっく……確か、こうやって……んっ、身体を上下に動\nかして……やるんだったな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103108" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、ふっ……何だこれ、中で……まだ大きく……んっく、チンポ\n……膨らんでる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……んっ、こ、こんなもんか。そんなに俺のオッパイが気持ち\nいいってことか……どうだ、ちゃんとテクニックがあるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103110" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「まだもっと出来るだろうって……？　あ、当たり前だ。これからしようと思\nってたんだから、余計なことは言うんじゃねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103111" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ちゃ、ちゃんとしてやるから……んっ、くっ、っふっ……はぁっ、ほら……\nこんな、感じだろ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103112" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「身体……揺すって……チンポ……擦ってやるんだ……あ、そ、そうだ……も\nっと滑らせるといいんだったっけな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「確か……こうして……んれろっ……んっ、れろ……ほら……唾液を垂らして\nやればいいんだ……んっ、あぁ……滑るぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103114" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「どうだ……？　お前も、こんなこと……なかなかされないんじゃないか？　\nチンポがビクってしてるぞ……これ、気持ちいいんだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……もっと、動かしてやるからな……んくっ、はぁっ、んっ、あ\nぁっ、ふっ……んっく……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103116" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「はぁ、んっ、あぁ……オッパイの中で、ずっとビクビクしてる……チンポ、\nどんどん熱くなって来てる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103117" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ふ、ふん……わ、分かってるさ。それだけ興奮してるってことだろ……？　\nは？　もっと乳首をくっつけろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103118" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「そ、そんなことしたら……乳首……んっ、あぁ、うるさいなっ……してやれ\nばいいんだろうっ、んっく……あっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んふっ……！　くぅぅ……ビンって……当たる……俺の乳首……くう……コ\nリコリに、なっちまってる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103120" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「き、気持ちいい……？　ま、まぁまぁだよ……別に、そんな、お前だから特\n別なんてことは……ないっ、からなっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103121" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっ……はぁ、もっと……押し付けろ……わ、分かってるっ……いちいち言\nうんじゃねぇっ……こ、こうだろっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「はぁぁ……んっ、ピリピリしてっ、くぅ……こ、こんなの……あっ、んぁっ\n、はぁっ、あっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103123" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ヤベぇ……んっ、何か身体……熱い……んんっ、いや……これくらい……ど\nうってことは……はぁ、あっ、くっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ここからもっと変化を……？　く、口を使う……そう言えば……そんなこと\nも……あぁ、いや、なんでもない……こっちの話だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103125" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっ……分かった……口を使ってして、やるからな……チンポ、大人しくさ\nせておけよ……？　はぷっ、んちゅぅぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103126" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「くぷっ、あぁっ、んちゅぷっ……はぁ、んっ、ふにふにして……変な感じだ\n……硬いのと柔らかいのが一緒になって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103127" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……この味……何かクラクラする……んちゅぷっ、あんむ……りゅ\nぱっ、じゅぽっ、くぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103128" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「気持ちいいのか……？　かなり、いい……のか。ちゅぷっ、そうか……なら\n、今の感じで……もっとしてやるからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103129" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「くぽっ、じゅぽっ、んっ、くぷっ、ちゅぷっ、りゅぽっ、んじゅぷっ……は\nぁ、んぁぷっ、れろ……んちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103130" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「そ、そうか……オッパイも一緒に動かしてやらないとなんだな……んんっ、\nあぁ……同時にってのは、結構……面倒だな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103131" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっ、こっちを動かしたら……舌が……んっ、止まる……れろ、舌……動か\nしたら……オッパイが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103132" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「えーいっ、まだるっこしいっ！　とにかく……ちゅぷっ、一度にしてやれば\nいいんだろっ、はぁっ、あっ、んんっ、ちゅぷっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103133" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「あっ、ふっ……はぁっ、オッパイ……上下にズリズリさせてっ……チンポっ\n、先っぽっ……チュウチュウ吸ってっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103134" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「あんむっ、りゅぷっ……いい感じだ……動きの感じ……掴んできたぞっ、じ\nゅぷっ、んりゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「はぁっ、んんっ、チンポ……震えてるぞ……出したいのかっ？　なら……さ\nっさと出せっ……じゅぷっ、んちゅぷぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103136" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ぷぁっ……！　んんむっ……出てっ……来たっ……むぐっ、はぷっ、んんっ\n、どぷどぷっ……出てるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103137" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっく……んぐっ、はぁんむっ、いきなり……こんなにたっぷり出しやがっ\nて……んんっ、飲むのが大変だろうが……んぐっ、んくんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「はぁっ、はふっ、はぁっ、んっ、どうだ……飲んでやったぞ？　これで、俺\nの実力が分かっただろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103139" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「そ、そうだ。俺は団長なんだからな。多少の色事くらい、こなせて当たり前\nなんだ。分かったな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ん……？　ここからが本番……って……どういう意味だ？　は？　まだ……\nチンポが途中……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「お、おい……今だしたばっかりで……どうなってるんだ……気持ちよかった\nから……もっと味わいたい……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「う……確かに、まだガチガチにチンポ立てやがって……俺のパイズリじゃ物\n足りないってのかよ？　上等だっ……こんなもんじゃねぇからなっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103203" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっ、もっと……身体を寄せてっ……大きく擦ってやるっ……んっ、はっ、\nあっ、くっ、んふぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103204" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「精液が……ヌルヌルして……ふぁっ、よく滑る……これ……はっ、んくっ、\nあぁ……ちょっといい気持ちかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103205" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「乳首……だったよな……んっ！　ヤベ……何だ、今の……これ……かなり、\n来た……も、もう一回……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「っくぅ……ピリピリするっ……んんっ、くぅぅ……ふっ……あっ、んむっ、\nくぅぅっ、はっ、あぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103207" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「フェ、フェラも……だったな……んっ、ちゅぷっ、れろ、ぴちゃ……んふっ\n、れろ……どうら……？　こういう感じが……いいんら……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103208" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「しゃぶってるカッコが……エロい……んっ、バ、バカ野郎っ……あんまっ、\n変なコト言うんじゃねぇっ……んじゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103209" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっ、大人しく……されてるの……待ってりゃいいんだからなっ、んっ、は\nあぁっ、ちゃんとしてやるから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「じゅぷっ、何だこれ……はぁ、ちゅぷっ、お前のチンポ……しゃぶってると\n……身体の奥がムズムズして……はぁ、熱くなってく……」", "NORMAL" ]},

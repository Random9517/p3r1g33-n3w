		{"command":[ "SETTEXT", "「んぷぁっ……！　あっ、く……この……顔に出すならっ……最初にそう言っ\nとけっ……んぷっ、はっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「気持ち良すぎて……我慢できなかった……？　ふん……随分、調子のいいこ\nとばかり言いやがって……んぷっ、はぁ……んふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103402" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「あぁ、もういい……もう後はどれだけ出しても同じだからな。中途半端に残\nさずに、全部出しちまえ……はぷっ……んっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103403" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「だからって……また、そんな勢いよく……精液……掛けやがって……んちゅ\nぷっ、しかも、さっきより多いじゃねぇか……これ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……はぁ……はぁ……んっ、これで出し切った……？　本当だな…\n…？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103405" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「これで、いいんだな。は……？　チンポの先についてる分も、綺麗にして終\nわり……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103406" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「れろ、ちゅぷ……んっ、全く……いちいち注文の多い……れろ、ぴちゃ……\nほら……こんな感じでいいんだろう……りゅぷっ……」", "NORMAL" ]},

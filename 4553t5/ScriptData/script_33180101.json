		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んっちゅ……あぁっ、気持ち……よくなってきてる……んぁっ、俺のオッパ\nイが……敏感になってくぅ……」", "NORMAL" ]},

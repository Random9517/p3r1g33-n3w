		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「んむっ……！　んっ、まらっ……出たっ……ドロドロのが……んぐっ、喉に\n……流れ込んで来るっ……んふぅぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ごくっ……んんっ、ニ回目なのに……また、めちゃくちゃ出しやがって……\nじゅぷっ、けど、もう……味も慣れた……んぐっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103302" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_24" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「こくんっ……一気に飲んじまえば……どうってこと……けほっ、けほけほっ\n！　ぷぁっ、はぁっ、だ、大丈夫だっ……心配しなくていいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103303" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「そのまま任せてろ……チンポミルク……全部飲んでやるからな……んちゅぷ\nっ、こくっ、んくっ、んふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103304" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_24" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ふぅ……はぁ、はぁ……ほら、飲んだぞ……今度こそ、文句ないだろ？　満\n足したな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「何……後始末のお掃除……何でもいいっ、ここについてるのを舐め取ればい\nいんだろ？　ちゅぱ、ぴちゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103306" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「全く……最後まで注文のうるさいやつだ……ちゅるっ、んちゅるっ……れろ\n、ぴちゃ……ちゅぱ……んちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ほら、これで……いいな？　これ以上何かあっても、俺は知らないからなっ\n？　分かったな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103308" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「めちゃくちゃ上手だった……？　ふ、ふふん……当たり前だ。お前なんか、\nちょっと本気を出せばすぐに手玉に取れるんだからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103309" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「また鍛えて欲しい……？　ふん、俺もヒマじゃないけどな……そんなに言う\nなら、また……考えてやらなくもないぜ」", "NORMAL" ]},

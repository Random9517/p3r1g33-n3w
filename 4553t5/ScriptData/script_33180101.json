		{"command":[ "SETTEXT", "「ちゅぷっ……はぁ、んりゅっ……お前のチンポも敏感なのか……へへっ、な\nら……こうして……強く挟んだまま……んちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ぴちゃ……ちゅっ、んちゅっ……舐めてやると……やっぱり、ビクつきが大\nきくなってる……はぁ、んっ、ぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103214" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「これで……もっとだ、強く吸って……んちゅうぅぅぅっ……じゅぱっ、舌…\n…押し付けてぇ……りゅぷっ、んはぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103215" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「うぁぁ……ヤバ……俺も、何だか……妙な気分に……はぁっ、はぁっ、なっ\nて……んっ、あぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103216" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ちゅぷぁっ……んりゅっ……お、おい……れろ、また、そろそろ出したいん\nだろ……？　んっ、俺にも分かるぞ……この匂い……間違いない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103217" ]},
		{"command":[ "SETIMAGE", "0", "still_00031801_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「りゅぱっ、出したがってる時の顔……へへ、余裕なくなってるのか……？　\nお前も、結構可愛い顔するじゃんか……ちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「ふぉら……じゅぷっ、くぷぅっ……我慢するなよっ……濃いのっ……全部…\n…出しちまえっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ファフニール" ]},
		{"command":[ "SETTEXT", "「じゅるっ、んぷっ、んちゅぅぅぅっ、じゅるるるっ、んりゅうぅぅぅぅっ…\n…！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_318_0103220" ]},

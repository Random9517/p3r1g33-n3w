{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「いらっしゃい……うふふ、ここに来た時点で分かってるんでしょう？　ね、\nあなたの目も、期待しているのが分かるわよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304101" ]},
		{"command":[ "SETCHARA", "0", "char_00025903_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「知ってると思うけど、私には夫がいて……あの人は私を愛してくれるわ。夜\nだって、優しく抱いてくれるし」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304102" ]},
		{"command":[ "SETCHARA", "0", "char_00025903_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「夫として、男として不満なんてない……ないんだけど、でも、私ってサキュ\nバスで……その、ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304103" ]},
		{"command":[ "SETCHARA", "0", "char_00025903_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「たまには激しいセックスがしたいの！！　優しいだけじゃない、獣のように\n、貪るように私を求めてくれるセックスがしたいの！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304104" ]},
		{"command":[ "SETCHARA", "0", "char_00025903_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「だから……ね？　あなたにお願いしたいの。今から……私のこと、めちゃく\nちゃにして！！　どろどろに蕩かせて！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304105" ]},
		{"command":[ "SETCHARA", "0", "char_00025903_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふっ……あなたももうやる気じゃない……当たってないのに、おちんちん\nの熱気が伝わってくる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304106" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ねえ、お願い……その逞しいおちんちんを、硬くて熱くて太いおちんちんを\n、私の中に入れて、かき混ぜて、どろどろにしてっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304107" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んんんんっ！！　あっ、はっ、入って、きたぁ、んっ、ふうううっ！！　お\nちんちん、おっきいおちんちんが……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304108" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ごりゅごりゅって、私の中削りながら……ふああっ、あっ、んんっ、ふっ！\n！　奥まで、ずっぽりと……んんっ、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ね、分かるでしょう？　おまんこが悦んできゅんきゅん締めつけてるの、ん\nっ、あっ、ふうっ！！　本当に、大きい、あうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304110" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、ううっ、それっ、奥、ごりごりってするの、もっと、もっとし\nてっ！！　あなたの大きなおちんちんで、私の奥っ、ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304111" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「潰して、かき混ぜて、どろどろに蕩かせてっ！！　おまんこ、私のおまんこ\nをあなたのおちんちんの形にしてっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あっあっあっ！！　ふうっ、んっ……あっ、そうやって動かれると、んっ、\nカリ首が壁をこすって、あっ、んうっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304113" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「お腹の中、びくびくってしちゃう、んっ、ふうっ、ふっ……へ？　え、今ま\nでは準備運動で、これからが本番って……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304114" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ああっ、あっ、あんっ、んんっ、凄っ、凄いっ、んっ、このおちんちん、凄\nいっ！！　ふうっ、あああっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304115" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「こんなの、こんなの味わったら、んふうっ、もう、忘れられなくなっちゃう\n！！　あなたのおちんちん、おまんこが覚えちゃうっ！！　あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304116" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んんっ、ふうっ、ああっ！！　おまんこでおちんちんの形、わかっちゃう！\n！　大きいから、硬いから、おまんこにぴったり密着して、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あなたの形、全部わかっちゃう！！　ふああああっ、ごりごりってこすられ\nたら、んふうっ、あっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304118" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、あなたも、私のおまんこ覚えてっ！！　サキュバス人妻魔女\nのおまんこ、覚えてっ、あんっ、あっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304119" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あうっ、ああああっ、後ろから激しくされたら、んっ、お腹から頭まで全部\n、おちんちんにかきまぜられちゃうっ、ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304120" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふあああっ、あっ、腰、がつがつってぶつけられて、んっ、衝撃で、頭おか\nしくなっちゃう！！　思考、飛んじゃう！！ふあっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「後ろからおちんちんで貫かれて、んんっ、おまんこぐじゅぐじゅになってる\nうっ！！　ふああっ、あっあっあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あああっ、あっ、んんっ、ふうううっ、おちんちんが、おちんちんが私の中\n全部蕩かしてくるっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304123" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あうっ、んっ、ふうっ、あああっ！！　腰、そんながんがんぶつけられたら\n、ふああああっ、あっ、んんっ、おちんちんも奥まで来てっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふあああああっ！！　食べられてるっ！！　私の身体、あなたに食べられて\nるっ！！　私、サキュバスなのに！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304125" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「私が食べるほうなのに、あなたに食べられちゃってるっ！！　んんっ、ふあ\nああっ、逞しいおちんちんにおまんこ食べられちゃってるっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んんっ、腰、掴まれて突かれるの好きっ、ふうっ、うっ、ピストンが全部お\nまんこに来てっ、ああっ、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304127" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「中がおちんちん抱きしめるの、分かるでしょう！！　ふううっ、うっ、気持\nちよくしてくれる、逞しいおちんちんにありがとうって、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「愛してる、好きっておまんこがハグしてるの、おちんちんで感じ取ってるで\nしょう！！　ふああっ、ああっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「また激しく、んっ、あっ、あはあっ、カリ首がごりごりって、んんっ、亀頭\nもごつごつって、ふうっ、うううっ、あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304130" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふううっ、うっ、あっ、凄い、いやらしい音が鳴ってる、んっ、頭の中も、\n一緒にじゅぷじゅぷってかき混ぜられてる、んっ、ふううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304131" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んっ、うっ、あっ、あんっ！！　ね、ね、分かるでしょ、もう、おまんこが\nおねだりしてるの、分かるでしょう？　あんっ、ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「欲しいの！！　あなたの精液！！　欲しいのっ！！　おちんちんからびゅー\nって、私のおまんこに、びゅーって、してほしいのっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304133" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「お願いっ！！　あなたの精液で、私を満たして、あっあっあっ、また激しく\n、腰が、ああっ、んっ、ふああっ、あっ、あっ、イく、イく、イっく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「イっくああああああああああああああああっ！！　おまんこに、精液来たあ\nあああああああ、ふうっ、ああっ、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304135" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「溶けるっ！！　おまんこ精液で溶けるっ！！　ふううううっ、あっ、あんっ\n、んんっ！！　溺れちゃうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304136" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「熱くて、ねばねばの精液でおまんこ溺れちゃうっ！！　ふあああっ、あっ、\nあんっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「腰、動かしながら出すのダメっ！！　ふううっ、頭の中まで、射精されてる\nみたい、んんっ、あああっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304138" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふああああっ！！　んんっ、おまんこに塗りたくられてるの、分かる……お\nちんちんで中に塗られてるの……んふううっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、お腹の中、あなたの精液でいっぱい……ふあっ、あっ、幸せ\n……幸福感で、おまんこきゅんきゅんしてる……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304140" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んうっ、んっ、ふっ、お腹の中、もういっぱいなのにまだ出てるから……ん\nっ、こぼれちゃう……あんっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふっ、うっ、あああっ、出されるだけで、気持ちいい、あんっ、うっ、ん\nんっ、んっ……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304202" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あっ……なに、おちんちんがまた……んっ、ああっ、あんっ、もう一回、し\nたいの？　んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304203" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「いいわよ……出したばかりのぐちゅぐちゅおまんこ、そのおちんちんでかき\n混ぜて……もう一回、精液でたぷたぷにして、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、んっ、ふううっ、あっ、凄いっ！！　さっきよりも激しく、\nんんっ、あああっ、あうっ！！　おちんちんがごつごつって、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304205" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「硬い先端が、お腹の奥を、ふうううっ、んっ、ああっ、そんな、おちんちん\nで叩かれたら、中がぎゅって、抱きしめちゃう、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「激しいピストンで、腰がとけちゃう、んっ、ふああああっ、あんっ、あっ、\nんっんっんっ、あっ、ダメ、ダメっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304207" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「身体中、おちんちんで蕩かされてるっ！！　んんっ、あんっ、あっ！！　あ\nなたのおちんちんで、全部かき混ぜられてるっ！！　ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふうううううっ！！　気持ちいいっ！！　んんっ、あっ！！　頭の中も、お\nちんちんで突かれてるっ、ふあっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「音っ、音がっ！！　ぐちゅぐちゅって、おまんこも、身体も、頭もかきまぜ\nられて、ふあっ、ああっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「こんなの、おちんちんの、おちんちんのことしか考えられなくなるっ！！　\nああああ、ごりゅごりゅって、中をこすって、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304211" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふうっ、どろどろの中を、がちがちのおちんちんがこすって、かきまぜて\n、私が全部、おまんこになっちゃってる、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、こんな、逞しいおちんちんで奥ごりゅってされたら、ふああ\nあっ、あんっ、んんっ、あううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304213" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「我慢できないっ！！　イくの我慢できないっ！！　あうっ、あああっ、また\n、またイっちゃう、あなたのおちんちんでまた……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、我慢、我慢しろって、そんな、こんなおちんちんで責められ\nて我慢なんて……ああっ、あんっ、ああっ、無理、無理ぃっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「一緒にイきたいからって、そんなこと言われたら、んんっ、ふあああっ、あ\nっ、んんっ、我慢、んっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304216" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「我慢したいのに、おちんちんがっ！！　動きっ、激しすぎっ、あっあっあっ\n、腰ぶつけちゃダメっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「我慢できない、イきそう、もう、イきそう！！　ふううっ、あっ、んっ、あ\nんっ、んっ！！　おちんちんで、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304218" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んんんっ、イく、イく、あなたのおちんちんで……イっく、ふああああああ\nあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「イっくううううううううううううっ！！　んんんっ、あなたも、イって、あ\nあっ、ひああああああああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304220" ]},
		{"command":[ "WAITINPUT" ]},
																	
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふあっ、ああああっ！！　さっきのを押しのけて、新しい精液きたああっ！\n！　んんっ、ううっ、あうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「おちんちんと一緒で、精液も凄いっ！！　熱くて、濃いのが、おまんこでわ\nかる、わからされてるっ！！　ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふううううっ！！　濃厚精液がお腹の中でたぷたぷ言ってる、悦んで飲み\n干してるっ！！　ふああっ、あっ、あんっ、イっく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「出されてるだけでまたイっく、んっ、あああっ、あんっ！！　あくうううう\nうっ、んんっ、ふうっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304304" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「もう、おまんこどろどろで……全部あなたので染め上げられちゃってる……\nんうっ、ふううっ、精液、もっともっとっておねだりしてる、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんんっ、また出してる……そんなに私の中をあなたでいっぱいにしたいの\n？　いいわよ、私は全部受け入れるから……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304306" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「サキュバスは精で生きるっていうでしょう？　このままだと、私の全部があ\nなたからの精液でできちゃうわ……それぐらい濃い……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「うふふ。あなたに生かしてもらってるって思うと、身体がぞくぞくしちゃう\n……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ねえ、またこうして激しく抱いてくれる？　次もこんな風に、後ろから私を\nどろどろに蕩かしてくれる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304309" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「本当に？　嬉しい……んっ、私もいっぱいいっぱいおまんこで奉仕するから\n、またいっぱい出してね、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304310" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふあああっ、あっ、おちんちんが抜けて、んうううううっ！！　あっ、精液\n、身体にいっぱい、んっ、ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふううっ、身体と、服があなたの精液で染められてく……んっ、あんっ、\nふっ、あんっ……熱い……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「匂いも凄くて……んっ、中も外もあなたで満たされてる……んふうっ、幸せ\n……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ねえ、魔女って精液でホムンクルスを作るって言うじゃない？　この服と、\n精液であなたと私のホムンクルス、作れそう……うふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304404" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あら、信じてない風ね。分からないわよ？　ここには色んな力を持つ人がい\nるんだから、こういうのから作ってくれる人がいるかも」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「私のこの格好は仮装だけど、本物の魔女がどこかにいるかも……ね？　お願\nいしたら、私とあなたのホムンクルスを作ってくれるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「だからね、もっともっと、いっぱい、中でも外でも私に出して。あなたの気\n持ちいいしるし、いっぱい出して。ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304407" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「私の身体、口でも手でもおっぱいでもおまんこでも、どこでも使っていいか\nら……あんっ、おちんちん、もう反応してるじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「うふふっ、返事は聞くまでもないわね。いつでも私はあなたに応えるから…\n…また今日みたいに激しく抱いてね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304409" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「次にしてくれるときのことを考えて、私も今から身体がどきどきしてる。そ\nれぐらい素敵だったわ。楽しみに待ってるからね、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0304410" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_02_12" ]},

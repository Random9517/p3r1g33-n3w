{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0027" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「くっ……まさか敵がここまでやるなんて、想定外です……！　でも、隊長さ\nんたちが民間人の避難誘導を終えるまでは、持ちこたえないと……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403101" ]},
		{"command":[ "SETCHARA", "0", "char_00021004_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、くぅ……！　あの鞭の様にしなる、触手の腕……くっ……！　あれを\nどうにかしないといけないのに、近づけないっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403102" ]},
		{"command":[ "SETCHARA", "0", "char_00021004_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「それにさっきからなんか……きゃっ……！　胸とかいやらしい所ばっかり狙\nってきてる気が……もうっ、なんなんですかっ、あの怪獣……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403103" ]},
		{"command":[ "SETCHARA", "0", "char_00021004_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「駄目っ、これ以上は攻撃を受け切れないっ……きゃぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403104" ]},
		{"command":[ "SETCHARA", "0", "char_00021004_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「いたたた……尻もちついちゃった……って、ここって、さっきまで隊長さん\nが避難誘導をしてた場所じゃ――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403105" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_03" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「嘘……！？　私、もしかして隊長さんをお尻に敷いちゃいましたっ！？　隊\n長さん、ぺちゃんこになってませんよね！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403106" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「――あれ、隊長さんの声が……どこから……きゃっ！　あ……たまたま、お\n尻の割れ目の間に……よかったぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403107" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「民間人の避難は……終わったんですね、よかった。なら、後はあの怪獣を倒\nすだけですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403108" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「――そ、そうですよね、潰れはしなくても踏みつぶされてたら苦しいですよ\nね！？　すぐにどきますから待ってくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403109" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「きゃぁっ！？　あっ、いたっ、くっ……！　ごめんなさい、怪獣の攻撃が強\nくてっ……体勢を立て直せないっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403110" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「それに……んぅんっ……！　あの怪獣、私を倒す気がないというか、おっぱ\nいとか乳首とか、いやらしい所ばっかり狙ってる気もっ……あくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「隊長さん、もう少しだけ我慢してください……！　あうっ、くっ……！　ど\nうにか隙を見つけて、反撃しますから！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403112" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「――んあぁんっ！　隊長さん、あんまりお尻の間でもぞもぞしないでくださ\nいっ……！　あっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403113" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「そこでバタバタと暴れられちゃうと、隊長さんの身体がオマンコに当たって\n、色々気持ちよくなっちゃいますからっ！　あっ、んぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「苦しいのは分かりますけど、そんなにもぞもぞされたら、戦いに集中できな\nいと言いますかっ、あっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「顔面騎乗ならぬ全身騎乗って、そんなこと言ってる場合じゃ――ひゃんっ…\n…だからそれ、腕バタバタするの、待ってっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「……隊長さん、ちょっと楽しくなってきてません？　あぁんっ！　やっぱり\n、いまわざとオマンコの割れ目触りましたよね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「今は認識阻害のフィールドを張る余裕もないですし……というか、それ以前\nに、怪獣との戦い中ですから、そういうのは後で――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403118" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「くっ……！　また、触手の鞭が、あんっ！　やっぱりあの変態怪獣、私を倒\nすというより、いやらしいところばっかり狙ってる……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、くぅんっ……！　そこまで痛くはない、けどっ……あぁんっ！　敏感\nな場所ばかり狙われると、戦いの途中だっていうのにっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403120" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「確かに、私がこうして引き付けてる限り、逃げた避難者の人たちは安全です\nけど……これだと、いつまで経っても怪獣を倒せませんよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403121" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「ひゃんっ……！　隊長さん、またもぞもぞしましたね！　え？　俺も怪獣の\n気を引くのを手伝ってやろう？　あっ、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403122" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「私が身悶えてる限り、あの怪獣はこっちに釘付けなのは分かりましたけど\n――んぅんっ！　隊長さん、私のおまんこ弄りたいだけですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403123" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、んぅんっ……！　苦しいのは分かりましたけど、そうやって\n大きく息を吸われるとっ、あっ、んんぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……あっ、くぅんっ……！　こんな街中で、認識阻害も出来てな\nいのに、怪獣に打たれて、隊長さんにおまんこ弄られて、私……あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403125" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「変な気分に、なっちゃってます……あっ、んぅんっ……！　それでなくとも\n、激しい戦闘で身体、火照っちゃってたからっ……あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「誰に見られるか分からないのに、すごい事、しちゃってるっ……あっ、んぅ\nんっ……！　また、鞭が激しくっ……くぅっ！　んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ……！　ごめんなさい、いま腰がビクンってしちゃって！　隊長さん、\n潰れてませんよね！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403128" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「って、なんで隊長さんもおちんぽ固くしてるんですか！　いつの間に露出し\nてるし、あっ、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403129" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「私一人にだけ恥ずかしい思いはさせない？　――いい感じに言ってますけど\n、ただ隊長さんも気持ちよくなりたいだけですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403130" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「きゃんっ、あっ、あぁんっ……！　さっきから、身体全部を使っておまんこ\nの割れ目をズリズリしてきてるしっ、あっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403131" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「くぅんっ……！　あの怪獣の目も、触手の動きも、なんだかどんどんいやら\nしくなってきてる気がしますし……あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403132" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んんっ……！　隊長さんの動きも大きくなって、勃起おちん\nぽの引っかかりも気持ちいいからっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「私……こんな街中なのに、認識阻害フィールドもないのにっ……おまんこヒ\nクヒクして、イっちゃいそうに、なっちゃってますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「え？　私のおまんこと溢れる愛液の匂いがエッチすぎて、隊長さんも出す？\n　ま、待ってください、そんなに激しくおちんぽ擦られたらっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403135" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んくぅうんっ……！　イク、イクぅんんっ……！　私、敵に攻撃されながら\n、こんな街中でほんとにイっちゃってるっ！　んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403136" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_13" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「隊長さんのおちんぽミルクが、おまんこにびゅっびゅってかかってっ……あ\nっ、んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403137" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「やっ……！　あっ、きゃうんっ……！　また、触手の鞭が、乳首にっ、ひゃ\nんっ！　あっ、んあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「やっぱりこの怪獣、分かってやってるっ……あっ、くぅうんっ……！　こん\nな変態怪獣がいるなんてっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403139" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「でも……はぁ、はぁ、はぁ……こんな恥ずかしい思いしたの、初めてなのに\n……これ……すごい、ちょっと気持ちいいかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「って、違います！　もう、隊長さんまで一緒になって、なにやってるんです\nか！　早く怪獣を倒さないといけないのに……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403201" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「うっ……確かに私もちょっと乗っちゃいましたけど……マミの知識にありま\nす。こういうの、羞恥プレイって言うんですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403202" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「――いえ、確かに気持ちよかったですけど……その……癖になっちゃいそう\nで、それはそれで、まずいでしょ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「とにかく、あの怪獣を――きゃんっ！　あっ、くぅんっ……！　また、そん\nな際どい所ばかり、鞭の触手が飛んできてっ、あくぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403204" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「だ、大丈夫です！　痛み自体はほとんどないですから！　ただ立とうとする\nと、バランスを崩すみたいにされてっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403205" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「問題は痛みより、んぅんっ……！　乳首とか、敏感な所狙って叩かれるから\n、気持ちよくなっちゃって、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「ああ、ごめんなさい！　またお尻もぞもぞして、隊長さんの事踏みつぶしち\nゃうところでした……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、くぅんっ……！　あぁんっ……！　駄目、攻撃がどんどん激しくなっ\nてて……あっ、んぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403208" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「このままじゃ、また硬くなってる隊長さんのおちんぽが、入っちゃいそうで\nっ……くぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんんっ！　入っちゃったっ……こんな街中で、怪獣と戦ってる途\n中なのに、隊長さんのおちんぽがオマンコに入っちゃった……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403210" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あぁんっ……！　隊長さん、またそんなにもぞもぞされたら\n、おちんぽが暴れてっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「ひゃんっ……！　それ、隊長さんが暴れるたびに、腕がクリトリスにも届い\nてっ、んんぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403212" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「い、一応言っておきますけど、隊長さん、射精したりしないでくださいね！\n　もちろん、嫌とかじゃないんですけど、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403213" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「今、隊長さんのおちんぽミルクを膣内出しされちゃったら、本当に腰が砕け\nちゃって、戦えなくなっちゃいますからっ……あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、ひゃっ、くぅんんっ……！　あの怪獣、私の興奮が分かってるみたい\nに、鞭の攻撃を激しくしてっ、あくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403215" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「そんなに痛くはないのにっ、あっ、んあぁんっ……！　打たれる刺激と、お\nちんぽの気持ちよさが混じってっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403216" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「またイっちゃう、街中で恥ずかしいイき方しちゃうっ……！　あっ、あぁん\nんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403217" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「隊長さんのおちんぽ、大きくなってっ、あっ、んあぁんっ……！　出さない\nでくださいっ！　絶対に我慢してっ、んあぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「おちんぽミルク、膣内出しされちゃったら、ほんとに戦えなくなっちゃいま\nすからぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「駄目、私がイっちゃうのもダメなのにっ、イクっ、こんな街中でまたイク、\nイっちゃうぅ～～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403220" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "射精我慢","LABEL1","そのまま中出し","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「イックゥぅぅんんっ……！　ダメ、隊長さんは我慢してくれてるのにっ、私\n、大きいのが来てイッちゃってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403301" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ！　んんっ、くぅんんっ！　ごめんなさい隊長さん、苦しいで\nすよねっ、でも潮吹くの、止められなくてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「きゃんんっ！　あ、あの怪獣、こんな時までっ、んんっ、くぅんんっ！　打\nたれたところ、ジンジンしてっ、あっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403303" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……せ、折角隊長さんは、おちんぽミルク出したいの我慢\nしてくれたのに……こんなにイっちゃうともう、私、腰が抜けちゃって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403304" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「隊長さんは、大丈夫ですか？　私の出した潮で溺れたりしてないですよね？\n　ああ、よかったぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403305" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「……隊長さん、さっきから距離を取って攻撃してきてた怪獣が、どんどんこ\nっちに向かってきてます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「私の事はいいですから。お尻の下から抜け出して、先に逃げてください」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「……大丈夫です。さっきからの攻撃を見るに、あの怪獣、私を傷つけるとい\nうより、性的にいたぶりたい？　みたいな感じですので」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403308" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「一度引いて、体制を立て直してください。そして、私が本当に危なくなる前\nに、助けにきてくれると嬉しいです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403309" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},

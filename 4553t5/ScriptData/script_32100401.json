		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「よかった……なら、お尻の下から抜け出して、先に逃げてください。私の事\nはいいですから、早く！」", "NORMAL" ]},

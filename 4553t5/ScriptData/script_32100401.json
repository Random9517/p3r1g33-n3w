		{"command":[ "SETIMAGE", "0", "still_00021004_01_28" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んんぅんんっ！　あっ、ひゃっ、くぅんんっ！　頭の中真っ白になっちゃう\nっ！　誰かに見られてるかもしれないのに、街中でイっちゃううぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403402" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_27" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……んんっ……やっぱり、隊長さんのおちんぽミルクで気\n持ちよくなりすぎちゃった、からっ、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0403403" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_01_26" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「腰が抜けちゃいました……怪獣の攻撃は止まってるのに、身体がガクガクし\nて、立てません……」", "NORMAL" ]},

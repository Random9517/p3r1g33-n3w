		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁぉっ……そうだ……これを待ってたぁ……んっ、はぁぁ……特濃ザ\nーメンっ……子宮をもう一回……満たしてぇっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁ……焦らされたせいなのか……？　こんな……気持ちいいなんてぇ……\n顔が……だらしなく緩んじまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「こ、こら……ニヤニヤ見てるんじゃないよっ……くぅぅ……お前で楽しむつ\nもりだったのに、まんまと遊ばれちまってるじゃないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んふっ……あぁ……止まったのかい……んっ、あぁ……大丈\n夫さ……ちょっと腰に力は入らなくなってるけどね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それにしても……途中の焦らしは効いたよ……。あそこですっかりあたしの\nペースも乱されて……後はお前のされるがままになっちまった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふん、引っ叩いてやろうかとも思ったが、実際に気持ちよかったのは確かだ\nからね……今日のところは目を瞑っとくよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふ……しかし、どっちがヘビか分かったもんじゃないね。お前の方がよっ\nぽど獲物を狙って仕留めるヘビだったじゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「おかげで……まだ、中でチ〇ポのうねりを感じるよ……ふふ、もしかして、\nまだやる気があったりするのかい……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そうだね、あたしは構わないよ……？　ただ、もう少しだけ休ませて欲しい\nね……はふ……本当に腰がガクガクになっちまったのさ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁぁぁぁっ！　あっ……チ〇ポ……抜けてっ、身体……はぁっ、ザ\nーメンっ……出てるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ……またイッてるっ……はぁぁ……チ〇ポ気持ちよすぎてっ……全\n身……ガクガク震えて……んふぁぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「焦らされたから……か？　あぁ……気持ちいいのが……全身回って……力…\n…入らなくなってる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「蕩け顔……う、うるさいよ……お前だって、出してる瞬間のイキ顔は似たよ\nうなもんだったからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あふっ……はぁ、はぁ……出し切ったかい……んっ、最後……そこにチ〇ポ\n擦り付けて……精液、塗ってくれ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふぅぅ……あぁ、精液のにおいがいっぱいに広がって……クラクラするよ…\n…これは……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁ……何とか落ち着いた……全く、ここまで責められるとは思わなかった\nよ。全く、油断も隙もありゃしない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「まぁ……色々されて……新鮮な感じで楽しめたのは確かだけどね……あたし\nがリードするつもりで、まんまとリードされたって訳だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「腰が抜けそうな位に気持ち良かったって……？　ははっ、取ってつけたよう\nに言うねぇ。こっちは本当に腰が抜けかけてるってのに」", "NORMAL" ]},

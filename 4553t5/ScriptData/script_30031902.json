{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ああ、よく来たね。ほら、そこに座りなよ。ん……？　どうしたい、神妙な\n顔をして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904101" ]},
		{"command":[ "SETCHARA", "0", "char_00000319_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「夢見が悪かった？　何だい、まるでガキみたいなことを言うねぇ。は？　大\n蛇に巻き付かれた夢だった？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904102" ]},
		{"command":[ "SETCHARA", "0", "char_00000319_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「へぇ……なるほどねぇ。くくっ、そいつが何を暗示してるか……何となく分\nかったよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904103" ]},
		{"command":[ "SETCHARA", "0", "char_00000319_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そいつは欲求不満の現れってやつだね。その夢……いい意味で正夢にしてや\nろうじゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904104" ]},
		{"command":[ "SETCHARA", "0", "char_00000319_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、どういう意味かって？　鈍いねぇ……ほぉら……こういうことさっ\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904105" ]},
		{"command":[ "SETCHARA", "0", "char_00000319_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_01" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「くくっ、目の色が変わったじゃないか……あたしの身体で興奮したのかい？\n　チ〇ポが正直に反り上がって来てるよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904106" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「元々、お前を呼び出したのも、このつもりだったからね……めんどくさいこ\nとは抜きにして、たっぷり楽しもうじゃないか……なぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……そうだよ、そのままその勃起チ〇ポをぐっと押し込むのさ…\n…こ、こら……入り口のところで焦らすんじゃないよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そうだよ……今日はずっとお前とするつもりでいたからね……期待してたん\nだよ……ずっと待ち遠しかった……だから、さ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「今更……そんな、割れ目のところを撫でなくても、あたしの準備はできてる\nんだ……はぁ……マ〇コ……濡れてるの分かってるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だから、んっ、早くぶっすりいって……その、ぶっといチ〇ポを奥までいっ\nぱいにしておくれ……頼むよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、あぁぁおぉぉっ！　それぇっ……おっ、あぁぁぉっ……チ〇ポッ、ず\nっぷり……入って……来るっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「くふぅぅ……そうだよ、こいつを待ってたんだ……くくっ、どうだい……？\n　もう、最初から熱く……ぬめってるだろ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それだけ、お前のことを待ち焦がれてたってことさ……あぁ、まだもう少し\n奥まで届きそうだ……あくぅぅぅぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁ……分かるよ。お前のチ〇ポが……あたしの中で、更にビクついて……\n太くなっていくのが……んふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「さあ、ただ挿れて終わりじゃないだろう？　ここからが本番……お前の欲求\n不満を……思いっきり解消させてみな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぉっ……！　んぅっ、くっ、んふぅっ、そう、そうっ……膣壁を……引っ\n掻くように……引きずり出してぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「また……ずぶっと……押し込むぅっ！　んぅんっ！　チン先がっ、中を……\nズリズリさせてぇ……また引いてぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あふっ、あっ、はぁんっ、いいよっ、最初から……いいピストンで、かき混\nぜて来てるじゃないか……ん、熱くて太い感触……たまらないねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「こうやって、腹に力を込めれば……んんっ！　ふふっ、どうだい……？　ち\nょうど奥に入った時に締め付けられるの……いいだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「気に入ったみたいだね……なら、お前ももっと頑張らなきゃね……あたしの\nマ〇コを……もっと擦り上げてご覧……はぁうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、うんっ、あぁっ……がっついてくるじゃないか……この勢いでのピス\nトンっ……！　あたしを孕ませるつもりかいっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、そんなに……何度も擦られたら……はぁんっ、汁が……どんど\nん溢れてっ、止まらなくなってくるよ……んぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「うんっ、んくっ、はぁぁっ……んっ……もっと足を広げろ……？　こ、これ\nで……どうだい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んぁぉっ！　あぉっ、ふっ……！　なるほど……ねぇ……チ〇ポが、もっと\n深いところに当たって……これが狙いってことかい……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、ぉっ……！　ちょうど……ポルチオの部分に当たるから……それで、\nんひっ！　このっ、グリグリ……押し潰して来るやり方ぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ、こんな、簡単に奥まで届くなんて……やっぱり、チ〇ポの大\nきさだけは一人前だね……は、ぁふっ、んぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んふっ、マン肉の吸い付く感じが……いいって……？　当然さ……はぁんっ\n、あたしばっかり感じてちゃ不公平だからねっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「けど……んっ、あっ、あぉっ！　今日は……特に、弱いところばかりしてく\nるねっ……くぅ、こ、これじゃ……も、もうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「わ、分かってるんだろうっ？　あっ、ふっ、イ、イクッ……！　また激しく\nなってっ！　あひぉっ！　チ〇ポッ……ズリズリしてっ、イ……クっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904130" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんんんんっ……！　んはっ、ぁふっ……はぁぁ……はっ、んっく……かな\nり待たされた分……我慢が効かなかったよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、あんたはまだイッてないのに……けど、もうすぐなんだね…\n…？　なら……ふむっ……んっ、ぐっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぉっ、おんっ……このまま、出すまで……絶頂マ〇コで……締め付けるよ\nっ……！　くぅぅんっ、んぁっ、あっ、ひぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほらっ……この吸着っ……たまらないだろっ？　あたしもっ、そのままっ、\nもう一回イクからっ……中にっ、出しなっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そうっ、あぁっ、激しくかき混ぜてっ！　チ〇ポっ……中出しするんだっ、\nあぉっ、おぉぉぉぉぉんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふぁぁぁっ……！　あぁぁ……来たぁっ……濃いのが……どぷどぷっ、子宮\nに……送り込まれてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「いいよぉ……もっと出すんだ……あぁ……あたしの中ぁ……いっぱいにして\n……ザーメンシャワーで……着床させちまいなぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁっ、あっ……ふっ……！　あぁ……続けてイッたぁ……種付け射\n精で……連続アクメしたぁ……はふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……やっと、腰が落ち着いたかい。ふふっ……やっぱり、相当に\n欲求不満だったみたいだねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「くくっ、そんなつもりじゃなかった？　よく言うねぇ。これだけあたしに中\n出ししておいて……よっぽど中が良かったってことかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「さて……それでも、まだチ〇ポはしっかり硬さをキープしてるねぇ……こん\nなもんで終わりじゃないんだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「目がギラついてるよ。もっと、あたしを犯し抜いて支配したいってね……ほ\nら……やってみたらどうだい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ……！　くぅんっ！　ふはっ……んっ、んむっ……！　いいね……抜\nかずの２戦目……相手になるよ……んぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、結局……これだけ出しといても、チ〇ポは全然萎えてなかっ\nたね……硬いままで……また出し入れが始まってる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、んくっ……さっきより、ザーメンの分で……はっ、んっ、ヒダが……\n擦れてっ……いい感じに、なってるね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁ……はっ、あぉっ！　中で……ぐちゃりと……汁がかき混ぜられてく…\n…あぁぉっ、さっきより……どんどん速くなって……んぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、んぁっ、また……イキそうだ……そう、そのまま……今のところをズ\nリズリ擦り続けて……あっ、そこをっ……あっ、んっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「な、何だい……急に動きを止めて……何かあったのかい？　もうちょっとで\nイキそうだったのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「すぐイクのは勿体ない……それは……そうかも、しれないけど……んぁっ！\n　あっ、チ〇ポ……またっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、あぉっ、今度は……違うところを擦って来てるっ、んくぅっ、そこも\nっ、いいっ、あたしの……マ〇コッ……弱い場所ぉっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そこそこそこっ……！　くぅぅんっ、あと少しっ……また……あっ、イクッ\n……今度こそっ、イッ……んぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ま、また……途中で……っく……ぅぅ……完全に弄ぶつもりだね……？　は\nぁっ、んっ、あぁ……チ〇ポ……ハマってるのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904212" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんぅっ……あぁ、もどかしい……んっ、ふっ、締め付けても……くぅぅ…\n…ダメだ……一番いいところに当たらない……あっ、くぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁ……ダメだ……あぁ……これ以上、焦らされたら……あたしの方がどう\nにかなっちまう……頼む……また、チ〇ポしてくれぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ちゃんと……マ〇コ、いっぱい締め付けるからぁ……もっともっと気持ちよ\nくさせるからぁ……だから……も、もう一回イカセてぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904215" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んぁひぃっ！　あっ、あぁぁぁっ、強いの……また来たっ……！　それっ、\nそこっ、そこぉっ……あっ、あぁぁおっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「こ、今度は……途中でやめないでくれよっ？　そうっ、あぁっ、マ〇コの…\n…奥の奥までっ……太いチ〇ポでズンズンっ……突いてぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁっ、来るっ……！　さ、さっきよりすごいのがっ……すぐそこまで来て\nるっ！　イ、イクッ……もうすぐっ……イクからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000319_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んぁぁっ、イッてっ……！　一緒にっ……はひぅっ！　中出しでもっ、外で\nもっ、何でもいいからぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あひぉぉっ、イグッ……チ〇ポでイグッ！　太いのっ、グリグリ回されてっ\n、あぉぉぉっ、イッ……くぅぅぅぅぅぅぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904220" ]},
		{"command":[ "WAITINPUT" ]},
												
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふぁぁぁぁぁぁぁっ！　な、かっ……！　またっ、熱いの……ドプドプッ…\n…出て……るぅぅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_1904301" ]},

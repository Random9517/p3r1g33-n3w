		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「けど、悪い気はしないね……また、一息ついたらもう少し頑張ってもらうの\nもいいかも知れないね……くくっ」", "NORMAL" ]},

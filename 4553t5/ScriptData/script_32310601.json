{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おーい、こっちこっち～♪　もう、折角のボクがお誘いしてあげたのに、待\nたせすぎだよー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603101" ]},
		{"command":[ "SETCHARA", "0", "char_00023106_01", "3", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「何の用かって？　そんなの決まってるじゃん！　超絶可愛いジェスタちゃん\nの戦闘服を、特別にじっくりねっとり見せてあげようと思って呼んだのさ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603102" ]},
		{"command":[ "SETCHARA", "0", "char_00023106_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「中々人には見せないんだよ？　どうかな？　胸元もこーんなに開いて、中々\nキミ好みの衣装だと思うんだよね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603103" ]},
		{"command":[ "SETCHARA", "0", "char_00023106_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「って、聞くまでもないか♪　ズボンの上からでも分かるぐらい、チンポガッ\nチガチにしちゃってるもんね♪　え～い！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603104" ]},
		{"command":[ "SETCHARA", "0", "char_00023106_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふふ♪　無理やり押し倒されてチンポ丸出しにされちゃったのに、キミ\nってば、どうしてそんなにワクワクした顔をしちゃってるのかなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603105" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「やっぱりキミ、ちょっとＭっぽいところあるよねぇ。ボクにいじめられるの\n想像して、興奮しちゃってるんだぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ、ははは♪　何その情けない顔、ボクの事、誘惑しすぎじゃない？　\n――やっぱりこの服着てると、滾って仕方ないや♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほらほら～、みっともなく勃起した淫乱チンポ、シコシコしてほしいでしょ\n～？　だったら言うこと、あるんじゃない？　おねだり、聞きたいなぁ？」　", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603108" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――いひひっ、かしこまりー♪　やわらかーいボクの手で、いっぱいシコシ\nコしてあげるから、気持ちよくなっちゃおうねー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603109" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほぉーら、シコシコ、シコシコ……♪　相変わらず、キミのチンポは大きく\nてガチガチでとーっても熱くて、いじめ甲斐があるなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603110" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「手加減なんて、してあげないよ？　キミの気持ちいいとこは、もうぜーんぶ\n分かってる。めちゃくちゃになるまで、可愛がってあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「下品すぎるデカチンポ、痛いぐらいの力でぎゅーって握ってぇ……シコシコ\n、シコシコ♪　裏の所を指でぐりぐり♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「皮を巻き込むように乱暴にぎゅ～♪　シコシコ、ぎゅっぎゅっ♪　シコシコ\n、ぎゅっぎゅっ♪　こうすれば――ほら、我慢汁が溢れて来ちゃう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「相変わらず、快感に弱いダメダメチンポだよね～♪　こんな簡単にえっちな\nお汁をダラダラ漏らしちゃって、恥ずかしくないのかなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603114" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――え？　気持ちいいならそれでよし？　どうせなら、もっともっと激しく\nしてほしい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おぉ、清々しいまでに開き直ったね？　んふふっ、気持ち悪ーい♪　でもぉ\n――いいよ、キミが望むなら、好きなだけ気持ちよくしてあげちゃう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603116" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほら、こことかぁ……ぺろっ♪　ちゅ、んちゅ♪　乳首も一緒にぺろぺろし\nちゃったり？　れろぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603117" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こうやって唇で挟んでぇ、んちゅ、じゅ、んじゅるぅぅ♪　――ぷはぁ、は\nい、勃起乳首の出来上がり♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「真っ赤に充血した乳首、ヒクヒクしちゃってるね？　――え～、なんで顔を\n背けるのさ？　もしかして、これは恥ずかしいの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603119" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふっ♪　カワイイなぁ♪　やっぱりキミは最高の玩具……じゃなくて、\n奉仕し甲斐のある最高の相手だね、うん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603120" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んちゅ、れる、れろぉ♪　ほーらぁ、乳首も一緒に、シコシコ、シコシコー\n♪　乳首舐め手コキって奴だよ、気持ちいい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603121" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「って、聞かなくても分かるか。我慢汁もどんどん溢れて来ちゃって、チンポ\n、にゅるんにゅるんになっちゃってるもんねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603122" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクの手の平にぐちょぐちょって塗り込んでぇ……チンポ全体に広げるよう\nに、シコシコ、ぎゅっぎゅっ♪　乳首もまたぁ……れろぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「乳首は、どうやって舐められるのが好き？　さっきみたいに唇で挟んで、吸\nい付かれるのがいい？　んちゅ、じゅるぅぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603124" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ぷはぁ！　それともぉ……ちゅれるぅ♪　こうやって、舌を使ってべろべろ\nされるのがいいのかな？　れる、ちゅ、れるれろぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603125" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あとはぁ……ふーっ♪　ふーっ♪　優しーく息を吹きかけるのも、ゾクゾク\nして、気持ちいいんじゃない？　ふーっ♪　ふーっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603126" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふっ、そろそろ我慢が効かなくなってきたんじゃない？　チンポ、さっ\nきからヒクヒクしっぱなしだよぉ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「だけど、まだ出しちゃだーめ♪　想像してみて？　ギリギリまで我慢してぇ\n、全身がビクビク震えちゃうぐらい耐えて、堪えて――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603128" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「もう駄目だって瞬間に、頭を真っ白にしてザーメンびゅーびゅーって射精す\nるの。それってとっても気持ちいいと思わない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「だからぁ、我慢我慢♪　こうやって激しくぅ……んんっ……にゅるにゅるチ\nンポを乱暴にシコシコされても、我慢だよー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「シコシコ、ぎゅっぎゅっ♪　シコシコ、ぎゅっぎゅっ♪　裏筋も指で弄りな\nがらぁ……んんっ……皮も巻き込んでチンポをシコシコ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「勃起乳首もまた、いっぱい舐め舐めしてあげちゃう♪　んちゅ、ちゅ、れろ\nぉ♪　んちゅ、じゅじゅ、じゅれるぅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603132" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミの乳首、ボクの唾液でテカテカになっちゃってて、とってもえっちだね\n？　んちゅ、れる、れろぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603133" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ♪　そんなに鼻息荒くしちゃって、もうほんとに我慢の限界かな？　\nチンポも何度もヒクついて、ボクの手の中で暴れちゃってるや♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603134" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――いいよ、イっちゃえ♪　イク瞬間の情けなーい顔、しっかり見ててあげ\nるから♪　チンポビクビクさせて、みっともなく射精しちゃえ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ、あはは♪　出てる出てるー♪　どびゅどぴゅってどんどん溢れてき\nて止まらないや♪　相変わらず、すごい量だね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603136" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_05" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「熱くてドロドロの精液、こうして指に絡めてぇ♪　射精中もシコシコ、シコ\nシコ♪　ほーら、我慢した分、ぜーんぶ吐き出しちゃえ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んー、改めて考えると、射精中の人間ってとっても無防備だよねぇ。こうや\nってビュービュー精液吐き出してる時は、何をされても抵抗できない――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603138" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いひひっ♪　ねぇねぇ、今、チンポを握り潰すぐらいの力でぎゅ～ってした\nら、キミはどうなっちゃうのかなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603139" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――なーんて♪　うそうそ♪　そんなに怯えた顔をしなくても、そんな簡単\nに壊したりはしないってば♪　これでもキミの事、気に入ってるんだから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んっ……♪　出し終わった？　でもぉ、分かってるよね？　これで終わりな\nんかじゃない、まだまだここからが本番だよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603201" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「というわけで、このまま続けてチンポをシコシコしちゃいま～す♪　ボクが\n満足するまで、キミには何度だってボクの玩具になってもらうんだから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603202" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほーら、出したばかりのドロドロ精液を使ってぇ……ぐちゅぐちゅ、シコ\nシコ～♪　あはっ、すっごく滑って扱きやすいねー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603203" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「指で輪っかを作って、キミの敏感なくびれの部分をぎゅ～♪　ねじるみたい\nにぐりぐり、ぐりぐり～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんっ……あはっ♪　こうやって掻き回すと、キミのくさ～い精液の匂いが\n部屋中に広がっていっちゃうね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603205" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あ～、臭い臭い♪　それなのにキミの顔は嬉しそうに蕩けちゃってて、気持\nち悪いなーもう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――ねぇ、キミ、さっきからボクがきつい言葉を使うと、その度にチンポび\nくびくってさせてない？　やっぱりきつく当たられるの、好きなのかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「え？　ボク相手だから？　強い言葉でもボクに言われるなら嬉しい？　――\nもう、もうもう♪　嬉しい事言ってくれるじゃーん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603208" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほんとはもっと苛烈にいじめてあげようと思ってたけどぉ……んふふっ♪　\nいいよ、ここからは優しーく可愛がってあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、ちゅれるぅ♪　乳首も口に含んで、飴を舐めるみたいにレロ\nレロしてあげちゃおう♪　んちゅ、ちゅれろぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603210" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほぉーら、チンポの方もまた激しくしていくよー？　そうだ、リズムよくシ\nコシコしてあげるから、キミの方からも腰を動かしてみよっか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603211" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いくよー？　いち、に、いち、に♪　そうそう、いい感じ♪　ぬるぬるチン\nポ、いち、に、いち、に♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603212" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「そうやって腰をヘコヘコ動かすの、とってもみっともなくて素敵♪　キミに\nとってもお似合いの姿で、すっごくカワイイ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふっ♪　分かってるよ、乳首も一緒にいじめて欲しいんだよね♪　はむ\nっ♪　唇で甘噛みされるのも気持ちいいでしょ？　はむはむっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603214" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「かーらーのー……んじゅる、じゅるるるっ♪　ぷはぁ♪　……んちゅ、ちゅ\n、れろぉ♪　はむっ、はむはむっ、んちゅ～～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603215" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ♪　ほんとうに乳首が真っ赤っかだね♪　ここまでビンビンに勃起し\nてたら、男の人でも母乳とかでちゃうんじゃない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんっ……チンポもまた、手の中で大暴れしちゃって。いいよ、今度は我慢\nなんてしなくて。っていうか、我慢なんてさせないよぉー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603217" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、ちゅれるぅ♪　乳首を舐めながら滅茶苦茶にシコシコしてあ\nげるから、このままイッちゃえ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほら、ほらほらぁ！　恥ずかしい声を上げながらイっていいんだよ♪　キミ\nの恥ずかしい所、ぜーんぶボクに見せてよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603219" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、ちゅれるぅ♪　根元からぎゅーって搾り取ってあげるからぁ\n……精液、びゅーびゅーって漏らしちゃえ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603220" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ♪　出た出たぁ♪　精液びゅっびゅっびゅーっ♪　シゴけばシゴくほ\nど勢い良く飛び出してきちゃうねー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603301" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんぅっ♪　二回目なのにすごい勢い♪　乳首舐められながら射精するの、\nそんなに気持ちいいのかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603302" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「びゅるるるー♪　びゅるびゅるびゅるー♪　って、全然止まらないから、ま\nたえっちなくさーい匂いも充満しちゃってるね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こうやって精液を指に絡ませてぐちょぐちょってするの、やっぱり好きだな\nぁ♪　なんかそれっぽい玩具を弄ってるみたいで、気持ちいいんだよねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603304" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ん、そろそろ終わりかな？　いいよ、最後の一滴まで搾り取ってあげる♪　\n根元からぎゅううう～♪　ぜーんぶびゅっびゅってしちゃおうねー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603305" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ♪　最後までチンポビクビクさせちゃって♪　ほんと、キミは弄り甲\n斐のある玩具でカワイイなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603306" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「はーい、お疲れ様ぁ♪　今日もいっぱい出したねぇ♪　見てみなよ、あっち\nの床にまで精液、飛び散っちゃってるよ～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603307" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「後始末はキミがやっといてねー♪　え？　ボクはしないよ？　自分で出した\nものは、自分で綺麗にしないとねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクはほら、自分で出した精液を、床に這いつくばって掃除するキミの情け\nない姿を、じーっくり見て愉しまないといけないからさ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603309" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「そんな嫌そーな顔しても逃がしてあげなーい♪　ボクに好かれるって、そー\nゆーことだからさ♪　これからもいーっぱい、愉しい事しようねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603310" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んあぁん……♪　すごい勢いっ！　手の中じゃ押せ切れなくて、ボクの身体\nにまで精液飛んできちゃってるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603401" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんっ！　なーにぃ、ボクの戦闘服、そんなに気に入っちゃったの？　俺の\n精液でドロドロに汚してやるぞだー！　ってやつかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほんと、二回目なのにすごい勢い！　んぁんっ♪　びゅるるるっ、ってまだ\nまだ飛び出して、熱い精液がどんどん振りかかってくるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いいよ、最後の一滴まで搾り取ってあげるから、ぜーんぶ出し切っちゃえ♪\n　ほぉーら、ぎゅー♪　びゅるびゅるびゅるー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603404" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ん、これでお終いかな？　いやぁ、ほんとにいっぱい出したねぇ？　ボクの\n一張羅、キミの精液塗れですごいことになっちゃったじゃん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603405" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「匂いも……スンスン……あはっ、やっぱりくさーい♪　洗っても落ちなかっ\nたらどう責任取ってくれるのかなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603406" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミが喜んでくれると思って、わざわざ特別に戦闘服を見せてあげたのに、\nこーんな風に汚されちゃうなんて、思ってもみなかったなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「え～、ボクのせいにしちゃう？　しちゃうんだ？　――あはっ、謝るのはや\nーい♪　そうそう、素直にごめんなさいするのが一番なんだから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603408" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いいよ、許してあげる～♪　その代わりぃ……これからも、いーっぱいボク\nに付き合って、えっちなこと、たっくさんしようね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603409" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミとしたいこと、キミでしたいこと、まだまだいーっぱいあるんだから♪\n　絶対に逃がさないよ？　いひひひっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0603410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
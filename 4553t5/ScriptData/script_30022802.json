		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「けど……二人で休憩してた筈なのに、逆に疲れることしちゃってるの……ほ\n　んと、何してるんだか……」", "NORMAL" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_13" ]},
		{"command":[ "SETTEXT", "「終わった……？　うん……落ち着いたのね……えぇと……一応……お疲れ様\n　……」", "NORMAL" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETCHARA", "0", "char_00000228_01", "4", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「海だと開放的な気分になるから……そのせい？　でも……そうね、ちょっと\n　嬉しいかも。ううん、とっても……嬉しいかな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804104" ]},

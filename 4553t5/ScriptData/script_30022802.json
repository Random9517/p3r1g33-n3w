		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……あぁ、いっぱい濡れてるって……だって、こんな……あぁっ、\n　まっすぐにオチンチン突かれたらぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はんっ、あぁっ、オマンコ反応しちゃうっ……もっとオチンチンに悦んでも\n　らわなきゃって……キュンって締まるのぉ……あぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「うんっ、はぁ……オチンチンに絡ませるぅ……私の……エッチなオマンコぉ\n　……ヒクヒクさせるぅ……」", "NORMAL" ]},

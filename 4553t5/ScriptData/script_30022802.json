		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_05" ]},
		{"command":[ "SETTEXT", "「はぁぁ……んんっ！　あふっ……！　あぁ……入って来る……んんっ、オチ\n　ンチン……来たぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_06" ]},
		{"command":[ "SETTEXT", "「んはぁ……すごく熱くなってる……どうしたの、これ……最初からそうだっ\n　たの……？　えっ……私の水着姿に興奮した……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804111" ]},

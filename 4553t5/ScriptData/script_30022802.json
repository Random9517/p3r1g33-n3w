		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETCHARA", "0", "char_00000228_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「……い、イヤじゃないよ。変な雰囲気……その、ドキドキするって……こと\n　よね？　あ……あそこ、そんなに……」", "NORMAL" ]},

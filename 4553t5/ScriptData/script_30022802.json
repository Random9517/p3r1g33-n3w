		{"command":[ "SETTEXT", "「あっ、あぁっ……やっ、感じ過ぎちゃうっ……また……イカされちゃうっ！\n　　はぁんっ……オマンコ……イッちゃうのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ダメ……あぁっ、み、見つかっちゃうっ……こんな大きな声出したら……あ\n　ぁっ、でもっ……止まらなくてっ、あひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んぁっ、はぁぁんっ！　ダメ……本気のピストン……もぉ、らめっ、あっ、\n　あぁっ……気持ちいいっ、そこっ、気持ちいいからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ……貴方も……イクのっ？　来てっ……はぁっ、一緒に……海の中…\n　…蕩けてっ、一つになって……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「あぁっ、はぁんっ、奥まで来てるっ！　オチンチンっ……めり込ませてっ…\n　…あぁっ、もっと速くっ、あぁっ、ぐりぐりしてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「イクっ、あぁっ、イクのっ！　またイッちゃうっ！　こんな海の中でっ……\n　あひぃっ、オマンコまたイクぅぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804220" ]},

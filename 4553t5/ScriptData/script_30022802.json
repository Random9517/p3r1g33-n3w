		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_14" ]},
		{"command":[ "SETTEXT", "「どうせすぐ流されるからって……それは、そうだけど……あんっ……オチン\n　チン……お尻に直接当ててるのは……反則ぅ……」", "NORMAL" ]},

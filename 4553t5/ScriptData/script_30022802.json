		{"command":[ "SETIMAGE", "0", "still_00000228_02_12" ]},
		{"command":[ "SETTEXT", "「んぁぁぁぁっ……あぁぁ……中ぁ……熱いっ……はぁぁぁ……いっぱい溢れ\n　て……ドロってしてる……んぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁ……全部出してね……んっ、私のオマンコで搾り出してあげるから……\n　びゅくびゅくって……ザーメン出し切っちゃって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_11" ]},
		{"command":[ "SETTEXT", "「んっ……はぁぁ……海の中だから大丈夫だよね……？　少し位……オマンコ\n　から漏れちゃっても……んふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_10" ]},
		{"command":[ "SETTEXT", "「えっ……漏らさない……？　しっかりくっついて……漏れないように……あ\n　ぁん……急にそんな独占欲出しちゃって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「でも、嬉しい……はぁぁん……いっぱい出してもらって……すごく……気持\n　ちよかった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……休憩しに来た筈だったのに……結局、余計に疲れちゃったか\n　も……もう、こんなに張り切るなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「水着に見惚れて……嘘ばっかり……すぐにずらして、おっぱい出させたクセ\n　に……貴方が好きなのはおっぱいの方でしょ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_11" ]},
		{"command":[ "SETTEXT", "「あんっ、もう……返事の代わりに揉むなんて……バカなんだから……はふん\n　っ、乳首……コリコリさせちゃ……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_10" ]},
		{"command":[ "SETTEXT", "「もしかして……まだムラムラが残ってるの……？　もうここでは終わりだか\n　ら。終わり！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「えっ……ここじゃなければ……？　それは、まぁ……そういうことがあって\n　も……いい、かもね……」", "NORMAL" ]},

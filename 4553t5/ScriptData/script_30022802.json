		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_04" ]},
		{"command":[ "SETTEXT", "「もう……適当なこと言って……あっ、んふっ……水着なら何でもいいみたい\n　なことなんでしょ……あっ、んふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「全然違う……？　引き締まった身体だから……ラインが綺麗……ふ、ふぅん\n　……そんな風に見てくれたんだ……それなら、違うかな……？」", "NORMAL" ]},

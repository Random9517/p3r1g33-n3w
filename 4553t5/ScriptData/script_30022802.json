		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「んふっ、はぁ……んっ、だ、大丈夫かな……んっ、ぱしゃぱしゃって……二\n　人で泳いでる感じに見える……よね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「お、おっぱいは……水着がずれて、見えちゃってるけど……あぁ……だ、大\n　丈夫だよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「み、見せたいなんて……違う……そんなこと、思ってない……あっ、んっ、\n　はぁっ……オ、オマンコされてるとこ……見せちゃダメだから……」", "NORMAL" ]},

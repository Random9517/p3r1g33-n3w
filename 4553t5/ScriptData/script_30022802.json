		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、出したくなってる？　んっ、うんっ……オマンコの中でヒク\n　ヒクしてるから……もうすぐ……だよねっ？」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、まだ腰振って……もう、夢中になりすぎ……あふっ……私も\n　おかしくなるからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804404" ]},

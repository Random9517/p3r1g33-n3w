		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_05" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……どうせ、私……ちょろい女みたいになってるんでしょ……そ\n　れでもいいからぁ……いっぱい動かして……」", "NORMAL" ]},

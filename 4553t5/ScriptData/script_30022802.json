		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、首筋のとこ……ふぅって息掛けたでしょ……私が弱いとこって分かっ\n　ててしてるんだから……」", "NORMAL" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETCHARA", "0", "char_00000228_01", "5", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「……あはは……何だか、改まって言われると、すごく照れくさくなっちゃっ\n　た。もう、変な雰囲気になっちゃうじゃない」", "NORMAL" ]},

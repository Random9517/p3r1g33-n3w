		{"command":[ "PLAYANIM", "0", "ev002_28b_0000", "ev002_28b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、あぁっ……ねぇ……ちゃんと、締まってる……？　緩くなっ\n　たり……してない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ものすごく……ヒクヒクさせてるって……う、嘘……そこまでは、私……し\n　てないから……あっ……んっ、はぁ、ふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ……し、してるかも……あぁ……オチンチンにその気にさせら\n　れて……オマンコ、無意識に締めてるかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、でも……あんっ、こんな風に……後ろから、んっ、グリグリ…\n　…押し付けられたら……お尻……動いちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁぉっ、んっ、あぁ……おっぱい……揺らして……ぎゅって、揉\n　まれるの……気持ちいい……んふっ、くぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「もっと、奥まで届けて……んんっ、あぁっ、そぉ……オチンチンかき混ぜて\n　っ、んくぅっ、はっ、うんっ、んぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あ、あんまり大きな声出したら……見つかっちゃうかも……でも、んっ、ゆ\n　っくりにするのはやめて欲しい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ちゃんと……ずりずりっ……めり込ませて……はぁんっ、そこっ、あっ、好\n　きなところっ……してっ、あひっ！」", "NORMAL" ]},

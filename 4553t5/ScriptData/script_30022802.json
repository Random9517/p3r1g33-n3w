		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「えっ……？　待てないのは私も同じ……？　オ、オマンコ……動いちゃって\n　る？　も、もう……そんなこと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あふっ、あ、あるかもぉ……んっ、だって、オチンチン……奥の深いところ\n　まで届いて……気持ちいいトコ……突いて来るの……」", "NORMAL" ]},

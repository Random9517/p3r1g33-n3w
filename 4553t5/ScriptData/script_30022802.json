		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「させるからっ、あぁっ、もっと、いっぱいパンパンしてっ、バック責めっ…\n　…か、感じるっ……感じるのっ、あひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ、あぁっ……強いっ、オチンチン……強いのっ、くぅんっ、水\n　の中なのに……こんな、激しくなる……なんてぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「うんっ、あぁっ、揺れちゃう……おっぱいも動いちゃうっ、あぁっ、ぎゅっ\n　て……鷲掴みにされるのもいいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2804131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はんっ、んぁっ、あぁっ……息が掛かってる……んっ、ふぅ、ふぅって……\n　すごく興奮してるの……分かる……」", "NORMAL" ]},

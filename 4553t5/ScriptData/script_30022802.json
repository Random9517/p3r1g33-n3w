		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000228_02_15" ]},
		{"command":[ "SETTEXT", "「んふぁ……精液のヌルヌルが……直接伝わってくる……海の中でも……全部\n　分かるわ……量も……すごい……」", "NORMAL" ]},

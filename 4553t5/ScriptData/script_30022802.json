		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁ……あぁっ、こつんってノックされるの……あっ、好きぃ……♪　海の\n　中がひんやりしてるのに、オマンコの中……すごく熱くて……」", "NORMAL" ]},

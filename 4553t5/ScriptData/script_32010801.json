		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「んぁっ……！　出たっ……はぁぁっ、熱い精液っ……顔にっ……直接浴びせ\nられてるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803401" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あぁ……勢いが全く弱まっていないな……こんなにも濃厚なエキスを出し続\nけるとは……それでこそ我が息子だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ジンジンと痺れたチンポを扱き続けられる気分はどうだ？　ふふ……腰がビ\nクビク痙攣しているではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「その絶頂に悶える表情を見ているだけで、母も興奮が……高まって……ふぅ\nぅう……ゾクゾクするっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「いいぞ……もっと汚してしまえ……母は逃げぬからな……こってりとした精\n液を残さず浴びせてくれ……んふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「うむ……終わりか……いや、まあ十分に出したな。どれ、疲れただろう……\nそのまま楽にしているといい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803406" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「後は私が後始末をしてやるからな……れろ、遠慮するな……これは母の務め\nだからな……ぴちゃ、んちゅっ、ちゅるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803407" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「まだチンポが震えているぞ……ふふ、可愛いやつめ……ちゅぷ……れろ、え\nろ……んむ……これ位で十分だろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「礼には及ばん。これは母の務めだからな。それよりも私は……ホワイト……\nいや、何でもない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803409" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「楽しみは後に取っておくに越したことはない。さて……今からずっと待ち遠\nしくなってしまったな……早くその時が来て欲しいものだ」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0187" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「突然呼びつけて驚かせてしまったか……？　母の気まぐれには慣れている？\n　そうか、確かにそうかも知れんな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803101" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「うむ、まあ特別用事があって呼び出したという訳でもない。何となく息子の\n顔を見たくなっただけだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803102" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「別におかしいことはないだろう？　母が、息子のことを気にかけるのは当然\nのこと……そうだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803103" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ところで……この前のアレは……どうだった？　その、ほら、少し前に母が\nだな……うむ、そうだ、それだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803104" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「まぁ、それでだな……当然食べたとは思うが……ほう、ほう……そうか、美\n味かったか。うむ……そうかそうか。それはよかった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803105" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「なに、無論、私が作ったものだしな。そう間違いがあることはないが、人の\n好みなど分からぬものだからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803106" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「なるほど、で……地球では、そういうことがあったらば……することがある\nのだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803107" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「……ほう、なるほど……ふむ……色々と期待を持たせてくれるではないか…\n…そうか……うむ、そうか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803108" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「もう少し詳しく聞きたいが……そうだな……こういう風にしてみるのはどう\nだ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803109" ]},
		{"command":[ "SETCHARA", "0", "char_00020108_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「何をしているか……？　それは無論、服を脱がせているのだ。着たままでは\n、色々と邪魔になるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803110" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「特にこの下半身……チンポの方は、脱いでおかないとかなり面倒なことにな\nるのではないか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「見ろ……軽く手を添えてやるだけで、あっという間にチンポがそそり立って\n来ているではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「母にチンポを握らせて興奮勃起するなど……我が息子ながら実にスケベで結\n構なことだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803113" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「さて……軽く味見をさせてもらおうか……ふふ、チンポの方も気にはなるが\n……今は、この小さな蕾が気にかかる……んちゅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803114" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「れろ……ちゅぱ……ぴちゃ……男であっても、乳首が感じやすいのは大きく\n変わるものではない……そうなのだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ほら、チンポがビクついたぞ？　ちゅぷっ、んちゅ……今のは乳首への反応\nか？　それとも、私の指が動いたからか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「まだ指の方は全く動かしていないんだがな……？　だが、ずっと脈打って…\n…少しずつ大きくなろうとしているな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803117" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ぴちゃ、んちゅぱ……ちゅぷ……んちゅぷぅぅ……れろ……なかなか逞しい\n胸板ではないか。多少は鍛えているようだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803118" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「戦いに身を置くならば、どうしても体は強靭でなければ務まらん。お前の場\n合は要領がいいから、小手先でごまかすこともできようが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803119" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「それでも、いざという時に逞しさを見せる方が、男としての魅力に繋がる。\n母は、そんな姿を見たいと思っているぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ふふ……無論、見たいのはそれだけではないがな……さて、そろそろこちら\nも我慢が効かなくなってきてるだろう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803121" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ギュッと力を込めて……お前の一番弱いところ……男の弱点をしっかりと握\nり締めてやるからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「どうだ……力加減は。もっと強く押し潰されそうにされるのが、お前の好み\nだったかな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803123" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「別に隠すことはない。マゾ的な愉しみを見出していたとしても、私は息子に\n幻滅などしないからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「むしろ……私の手で身悶える姿を、もっとじっくりと見てみたいと……そう\n思う方が自然だ……そら……指が亀頭を滑っていくぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「こうして……つぅっと先端に指を這わせて……カリカリとくすぐってやる…\n…乳首にしたのと同じやり方だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「だが、こちらは乳首よりもっと敏感になっているようだな……ふふ、その我\n慢しようと鼻を膨らませている表情が母は好きだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803127" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「もっと、その姿を見せていいんだぞ？　カリカリ……シコシコ……言葉を重\nねるとより淫らに感じるだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803128" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ふふっ、腰が浮きかけているな。どれ……ここらで、一旦お預けでもしてみ\nるか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803129" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ほら……さっきの話の続きをするのもいいだろうな。母の気持ちに、息子は\nどのようにして応えてくれるのか……おっと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「別に、私が何をどうこう言うつもりはないのだが……こうして、チンポを責\nめていると、色々と悪戯心が湧いて来てな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803131" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「おっと……そんなことを言っているうちに、もう我慢汁が滲んで来ているで\nはないか。母の手コキがそんなに気持ちよかったのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「れろ……ちゅぷ……ならば、乳首を吸いながら……もっと激しく扱いてやろ\nう……ほら、ちゅぷ……んちゅ、もっと余裕をなくしていけ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803133" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「んちゅ……どうだ……限界か？　チンポがビクビク跳ねて……出したがって\nいるな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「いいぞ、好きなだけ射精するがいい。母に、お前の派手な噴水を見せてくれ\n……ちゅるっ、んっ、ふっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「おぉっ……！　これは……すごい勢いで……ねっとりした汁が真上に飛んだ\nぞっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803136" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_04" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「何だ、意外に溜まっていたか。すぐに限界を迎えると思ったが、なるほど…\n…それだけお預けだったようだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803137" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あぁ……手にべっとりとへばりついている……どれ、味は……んちゅぷ……\nふふ、濃厚なミルクだな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803138" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「アレの時はミルクが入っているのも面白いかも知れん。なるほど、想像する\n愉しみがいよいよ増していくというものだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「どれ、射精が終わったチンポ……優しくさすってやろう……母の癒やしを存\n分に味わうがいい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803140" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「さて……落ち着くかと思ったが、さすがは我が息子。チンポも、いきり立っ\nたままのようだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803201" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「これは、お前の秘密を聞き出すためにも、もう少しチンポを責めてやりたく\nなってきたな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「まずは、この手に残った精液を幹全体にゆっくりとまぶしていこうか……ぬ\nめりを足してやらんとな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ふふ……射精したばかりで、ビクビクしておる。疲れたか？　いや……この\n脈打ちっぷりは、そんな甘えたことは言わぬだろうな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803204" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「もっともっと高ぶりを与えてやろう……れろ、んちゅっ……んふっ……ぴち\nゃ、ちゅぱ……んちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803205" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「この乳首舐めと……同じリズムで……チンポを扱く……このタイミングだ…\n…ほら、ほら……どうだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803206" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「滑った手で、ぐちゅぐちゅと艶めかしい音をさせながら、チンポにマッサー\nジを重ねていく……んふぅ……この音だ……んむっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803207" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「この響きを耳にすると……母の胸も……高鳴ってしまうぞ……はぁ……んっ\n、あぁ……ちゅぷ……んふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「どうだ……もっと気持ちよくなりたいか……？　母におねだりをしてみたら\nどうだ……んっ、ちゅぷっ、りゅぷ……んふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「チンポをもっと感じさせて下さいとな……ちゅぷっ、そうだ……欲望まみれ\nの言葉をもっと母に聞かせるがいいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「んっ、はぁっ……いいぞ……ちゅぷっ、もう乳首がしこりきって、まるでボ\nタンのようではないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「このスイッチをちゅぷっ、好きなように弄りながら……んちゅぷっ……もっ\nと激しくチンポを扱いて……ふふっ、震えが止まらんな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「この張り詰めたキンタマも、追加の精液を出したくてウズウズしているな…\n…こっちも、さすってやるからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803213" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「お前の弱いところなど、母は全てお見通しだ。どうだ、私へのアレがどうな\nっているのか……そろそろ話してみる気はないか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「むぅ……なかなか強情な……こんなにもチンポを震わせているくせに、我が\n息子ながら、そこは一筋縄ではいかぬようだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803215" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ならば、母は改めて射精を見守るとしよう。ちゅぷっ……チンポに強く圧を\n掛けて……皮を繰り返し……めくりあげるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803216" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ふっ、はっ、んっ……どうだ……？　やせ我慢などするなよ？　母は息子の\n射精がもう一度見たいのだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803217" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……んっ、れる……れろ……もっといい声を出せ……母に精液を浴\nびせて構わんからな……そら、そら……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803218" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「手の中でチンポがビクビクしている……あぁ……いよいよだな……母の準備\nは整っているからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803219" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「さあ……とどめだっ、りゅぷっ、んじゅるるっ……お前の欲望の汁を……全\n部ぶちまけろっ、出せっ……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803220" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「んっ……！　出たぞっ……ふふっ、いい量だ……チンポから出される噴水…\n…実にいい眺めだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803301" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「まだまだ扱けば扱くほど出てくるぞ……？　射精しているチンポをシコシコ\nされる気分はどうだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「顔を仰け反らせて……返事どころではないという感じだな。いいぞ、その切\n羽詰まった声が私の愉悦だと分かるだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803303" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「そうか、そうか……気持ちいいか。うむ、私もお前の快感の表情を見るだけ\nで、愉悦が高まってくるというものだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803304" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ほら……出し切ってしまえ……精巣を空にするまで、チンポを震わせて……\n精液を飛ばしていくのだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「と言っていたら終わったか……ふむ、まあこれだけ出せば上出来だ。ちゅぷ\nっ……味も、申し分なし……ちゃんと健康でいるようだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803306" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「無論だ。精液の味で体の具合はよく分かる。そうだな……もう少し肉を多く\n喰ってもいいと思うが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「れろ、ぴちゃ……やれやれ後始末が少し面倒だが……これは母の責任だ。お\n前はじっとしているがいい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「そう言えば、私のチョコレートもしっかり摂取したんだったな。その活力が\n、また次に繋がるというものだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803309" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「結局、ホワイトデー……いや、あまり露骨な話はするまい。だが、その時が\n今から待ち遠しくなってしまったな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0803310" ]},
		{"command":[ "SETIMAGE", "0", "still_00020108_01_09" ]},
		{"command":[ "WAITINPUT" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0209" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「よく来たな。ふふっ、そんなに緊張するな。もっと楽にしてくれていいぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103101" ]},
		{"command":[ "SETCHARA", "0", "char_00031001_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたを呼んだ用件だが……単刀直入に言おう。妾と交尾をして欲しいのだ\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103102" ]},
		{"command":[ "SETCHARA", "0", "char_00031001_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「エルフ族は子孫繁栄のために外部から種を受ける必要がある。そなたは、そ\nの種馬に選ばれたというわけだ。光栄に思うがいい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103103" ]},
		{"command":[ "SETCHARA", "0", "char_00031001_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「……なんだ？　それで妾が孕んだら、ハーフエルフが生まれるのではないか\n、だと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103104" ]},
		{"command":[ "SETCHARA", "0", "char_00031001_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ハーフエルフというのは、エルフ族から生まれ、エルフの形質が現われなか\nった者たちのことだな。……そなたたちの世界では定義が異なるのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103105" ]},
		{"command":[ "SETCHARA", "0", "char_00031001_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「とにかく、そのような心配はしなくてよい。難しいことなど考えずに、そな\nたはただ、妾の子宮にその子種を捧げればよいのだからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103106" ]},
		{"command":[ "SETCHARA", "0", "char_00031001_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「……まだなにか不満が？　ほう、気分を盛り上げるために妾に奉仕をしろと\nいうのか。いいだろう。そのためにももっと近くに来るといい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103107" ]},
		{"command":[ "SETCHARA", "0", "char_00031001_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「さて……まずは、妾の乳房を楽しんでもらうとするか……。形も、大きさも\n……申し分ないだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103108" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「こうしてチンポを挟み……しごいて……。ふふっ、まだ軽くしか動かしてい\nないのに、顔が蕩けきっているぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ほれほれ、もっとか？　もっと動かしてやればいいか？　妾の乳房を、ぎゅ\nうっとチンポにおしつけて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103110" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「はぁ……っ、すごいな……ガチガチの勃起チンポ……熱を、乳房で感じる…\n…っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103111" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「こうして押さえこめば……そのいやらしい形……脈打ちが……はっきりとわ\nかるな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103112" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ああ……この匂い……。久しぶりに嗅ぐオスの臭気……。間近で味わうと、\n子宮がすぐに疼いてきてしまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103113" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「肉体が……交尾……このオスと、子を成すための準備をしているのを、感じ\nてしまう……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたも、そうではないか……？　勃起チンポを、ビクビクと乳房の間であ\nばれさせて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「妾の乳房にしごかれながら、その奥ではたくさんの子種汁をつくっているの\nであろう……？　ふふ、早くいただきたいな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「この……チンポを……ん、ちゅ……。乳房で、しごきながら……口でも、味\nわいたい……んふ、ちゅぷぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103117" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んふっ、ふふっ、どうした……？　チンポを咥えられるのは、はじめてか…\n…？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103118" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「それとも、エルフの女王である妾が、すすんでこのような行為をすることに\n驚いてるのか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んふっ、ちゅぷぅ……っ。これくらいのこと……んっ、じゅぷ、この国のメ\nスエルフなら、誰だってできる……んふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103120" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「オスから、子種をもらうための、行為……んじゅぷ、この国では、義務教育\nの一環だからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103121" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そんなことより、んっ、どうだ……？　妾の、口……んじゅるっ、舌遣い、\nはぁ……んっ、じゅぶぶ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103122" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「亀頭……エラ……裏筋ぃ……ん、じゅぷっ。舌で、刺激して……じゅるるっ\n、じゅぷっ、チンポ……気持ちいいだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ん……っ、ふぅ……っ、腰が震えて、そなたの顔も……じゅるっ、じゅぷっ\n、余裕がなさそうになってきた、な……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103124" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「本当は膣に欲しいところだが……んじゅるっ、まずはそなたの精液の味を、\n確かめさせてもらおうか……んっ、じゅぷぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、じゅるっ、じゅるるぅ……っ！　先走りから、美味……っ、こ\nれは、期待できそうだ、んっ、じゅるるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103126" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「よだれが、溢れてくる……っ、じゅぷっ、じゅずずっ！　妾のよだれで、チ\nンポ……ぬるぬるにぃ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「乳房での、奉仕も……んっ、激しくなってしまう……。じゅぷ、じゅぷ、ん\nふぅ、チンポ、イキそう……だな……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「いいぞ……射精、するがいい……っ！　そなたの役目は、射精することなの\nだから……んじゅるっ、妾に……向けて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103129" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「種馬ザーメン……！　んっ、じゅるるっ！　妾に、んっ、たくさん……だし\nて、んぶっ、んっ、んっ、じゅずずずぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んんぅううぅぅ～～～～っ！　んっ、んふぅ……っ！　きたっ、き……た…\n…っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103131" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んっ、ふふぅ……っ！　んっ、んぐっ、濃い……精液ぃ……っ！　口、んっ\n、溢れるほど……注がれている……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103132" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んく……っ、んっ、ん……ふぅ……っ！　喉に……詰まりそうな……粘りぃ\n……すばらしい……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103133" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……っ！　はぁ……はぁ……。ふふふ……しっかり、飲みほさせても\nらったぞ……そなたの、子種汁……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103134" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「何十年ぶりかの……精飲……。ふふっ、精液というものが、メスエルフを盛\nらせる媚薬のような味だったと思い出させてくれる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103135" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。チンポに、精液がついているな……ん、これも……舐め\nとろう……ん、ちゅぷ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103136" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「れろ……れぇろぉ……。やはり……妾の目に、狂いはなかったようだ……ん\n、ちゅ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103137" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「メスエルフの種馬にふさわしいチンポだぞ……ふふ……そして精液も、質・\n量ともに上等だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「さて、妾も久しぶりだからな。このあとも、つきあってもらうとしよう。そ\nなたの精液を、もっと味わいたいのだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103139" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「まずはもう一杯、そなたの精液を、妾の口に注いでもらうとするかな……ふ\nふ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ん……あむ……。また、乳房で挟みながら……口に、チンポを……咥えてや\nろう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたは、これが気持ちいいようだったからな……んっ、じゅるるっ。どう\nだ……？　また、気持ちよくなってきたか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んふっ、ふふ……っ、口いっぱいに……んぶっ、そなたのチンポ……感じる\n……んっ、じゅぷぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103203" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ヒトのチンポというのも……なかなか……。あんなに射精したのに、まだ萎\nえず……勃起している……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ん……ふふ……。妾が好きなタイプだぞ……じゅぷっ、このチンポは……じ\nゅぷ、じゅるる……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103205" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「妾は、量の方を重視しているからな……。エルフ族は、孕みにくいらしいか\nらな、何度も中出ししてもらわなくては……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「膣だけでなく、腹にも……たくさん、射精してもらうぞ……。ふふっ、その\nほうが妾も、興奮するからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「胃袋に精液を、注がれると……んっ、子宮が……嫉妬するかのように熱く疼\nいて……たまらないのだ……じゅる、じゅぷぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103208" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたのチンポも……ますます大きくなっているようだ……。じゅるるっ、\n口に収まりきらないほど、膨らんでいる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103209" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んんっ、じゅぷっ、じゅるる……っ！　たくましい……オスらしいチンポ…\n…じゅぷっ、じゅぷっ、もっと激しくか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「乳房で、ぬるぬるのサオをしごきながらぁ……口の中では、亀頭を舐めまわ\nして……じゅるっ、んっ、じゅぷぷぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103211" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたも、腰を震わせて、感じているようだな……。んっ、ちゅぶっ、妾の\n奉仕でまた……射精しそうか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ならばまた、射精するがいい。ほら、こうして……そなたの射精を手助けす\nるよう、乳房を動かすからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「じゅぷっ、じゅぷぅっ、じゅるるっ、じゅちゅっ、じゅるるるぅ……っ！　\nチンポ、射精……するのだろう？　んっ、ちゅぶぷぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103214" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「なにを遠慮する必要がある？　もうそなたは、妾の口へと１度射精している\nではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103215" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ならば、２度も３度も同じこと……。そうは思わないか？　それに、そなた\nはメスエルフの種馬に選ばれたのだから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「じゅるっ、じゅぷぅっ！　この快感に、身を委ね……じゅずっ、妾に精液を\n、捧げるのだ……じゅぷっ、じゅぷぷぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103217" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「もっと……吸いだすように……チンポにぃ……っ！　じゅずずずぅ……っ！\n　乳房も、搾るような、動きで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んじゅぷっ、じゅぷっ、じゅぷっ、じゅるっ、じゅずずっ、んっ、んっ、じ\nゅぶじゅぶぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103219" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「だ、だすがいい……そなたの、いいように……好きなところへ……っ！　妾\nに、そなたの子種汁……んっ、じゅぷっ、じゅぷぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んんぅううう～～～～っ！！　んっ、んぐっ、んっふぅうううぅぅぅ～～～\n～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「むぐっ、んっ、ん……っ！　口にまた、たくさん……ザーメンくる……ぅ…\n…んっ、くぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「すごいな……こんなに……。んぐっ、ごく……っ。精液、まだ、だせるのか\n……んじゅるっ、じゅずず……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103303" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「濃厚な、精液の塊……腹に、ずしりときて……はぁ、はぁ……たまらない…\n…っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「まだまだ、こんなものではないぞ……？　精液が、尿道に残っている……吸\nいださなければな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「じゅずっ、じゅずずっ、ずずずず～～～～っ！　んっ、んん……っ！　はぁ\n、はぁ……最後まで、飲みほさねばもったいない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103306" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ふふ……妾の奉仕はどうだったかな……？　久しぶりで腕が落ちたかと思っ\nたが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103307" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたがこんなに射精してくれたということは、妾の心配は杞憂だったとい\nうことか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「はぁ……。それにしてもそなたのチンポは惚れ惚れするくらいに立派だな…\n…」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103309" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「精を２度も放ったのに、なお妾の乳房の間でそそり勃つ……。このあとが楽\nしみだ。ふふっ、期待しているぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103310" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んぶっ！？　んはぁっ、なんだ……妾の口から、チンポを……抜くなんて…\n…っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、はぁああぁぁあぁ～～～～っ！！　なっ、精液が……妾にっ\n、顔にぃ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103402" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「あ……ああ……なんという量……粘り……。そして、このオスの匂い……た\nまらない……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……妾の顔をザーメンまみれにするとは……いったいどういう\nつもりだ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103404" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたの精液を、舌だけでなく肌でも感じたら……。ますますこの精液が、\n子宮に欲しくなってしまうではないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ふふ……こうして、さらに乳房で押さえつければ……。精液の残りが、びゅ\nくんと跳ねて乳房に垂れる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103406" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「なんて活きのいい精液だ……。これなら、すぐに妾も孕んでしまうかもしれ\nないな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「この奉仕だけで、満足したわけではないだろう？　チンポはまだ、こんなに\n勃起している」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「妾の子宮も疼きっぱなしだ……。このまま、膣奥までチンポをハメてもらわ\nなければ、鎮まりそうにない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0103409" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「種馬としての仕事は、ここからが本番だぞ。さあ、そなたのオスらしいとこ\nろを、存分に感じさせてもらうとしよう」", "NORMAL" ]},

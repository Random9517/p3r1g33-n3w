{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あ、あの～……こんにちは。は、はい。大江山夜日楽です。大丈夫ですか？\n　なんだか顔色が悪いような……。気になって声をかけてしまいました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503101" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「頑張ることは素晴らしいことですが、それで体調を崩しては元も子もありま\nせんよ。……え？　身体ではなく心の疲れ？　そ、そうなんですか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503102" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「私は人を励ますのが得意そう？　そ、そんなことはないですけど……一応委\n員長ではありますから、何かお役にたてることがあれば……。え？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503103" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「過去に誰かを励ましたこと……あります、けど。その話聞きたい！？　ふぇ\nっ、い、いいですが……その間、あなたは休憩してくださいね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503104" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……あれは、確か少し前……同じグラウンドでのことでした。私は、疲れき\nっていたあのひとにマッサージをしてあげようと思って声をかけて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503105" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ひゃっ……！　確かに一番疲れているところを教えてほしいとは言いました\nけど！　まさかここを出されるなんて……。うぅ、困ります……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503106" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「人に見られる前に早く励ましてほしい？　もうっ、勝手なことを言わないで\nください。こんなところでエッチなことをするなんて……だめですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「でも……。疲れすぎていて動けないところに、ここがこんなに大きくなって\nしまったら……歩くことも難しいですよね。今回は特別ですよ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ……。ど、どうして外でこんなにオチンチン……硬くできるんですか。\n恥ずかしいとか、そういう気持ち……ないんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503109" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「疲れていると勝手に勃起してしまう？　そうなんですね。すごい……。私に\nはない器官なので、本当にわからなくて……。っ、で、でも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「それでもこんなに、ゴリゴリになるまで大きくするのは普通じゃないですよ\n。……はぁっ、熱すぎますし……。その、臭いも強いですし……。んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「こ、これを柔らかい胸で刺激して、楽にするなんて……なんだかすごくいけ\nないことをしている気分になっちゃいます。こ……これでいいんですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ！　い、今オチンチンがお返事しましたよ！？　あっ……そうですよね\n、疲れているなら手でゴシゴシするのはかわいそうです。だから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503113" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「おっぱいでこうやって挟んで、包みこむように……。やさしく、やさしくコ\nリをほぐしていきますね。……んん……う、動きにくい、ですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「は、はい。おっぱいの大きさに対してオチンチンが大きすぎて……。あっ…\n…。この太さをつかまえておくのも、……あっ、結構大変で……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あ……でも、なんだか喜んでもらえている気がします。ちゃんとオチンチン\n、励ませてますか？　このまま続けたら疲れ……とれそうですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503116" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ふふ……それなら良かったです。……んっ。全然、上手ではないですけど…\n…。んっ、気持ちはこめてます、から……あっ、伝わってほしい……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503117" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「がんばって、ください……。んんっ。がんばってえらいです、ねっ……。っ\nふぅっ……。応援してます……。……んんっ？　ピクピク反応してる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「応援ってこれでいいんでしょうか……。いい？　それなら良かったです。続\nけますね。……が、がんばれ～♪　がんばれっ、あっ、がんばってっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ふぁ……♪　応援すればするほど、わかりやすく反り返って……存在を主張\nしてくる……。これ以上元気になられたら、困っちゃいますよぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503120" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「っはぁっ、はぁ、あぁ……♪　よしよしされると、素直に反応するオチンチ\nン……可愛いです、身体の力を抜いてリラックスしてくださいね……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「いつも応援してますよ。っんっ……！　私に応援されるまでも、なくっ……\nあなたのオチンチンはすごい、ですけど……。尊敬してますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……あ、あれっ？　こすればこするほど、ますますオチンチンがガチガチに\nなってきました。こんなに腫れてたら痛いですよね。よーし……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503123" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ぴちゃっ……。あ、驚かせちゃいましたか？　腫れたところにはできるだけ\n刺激が少ない方がいいと思いまして、……んっ、舌で舐めちゃいました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503124" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「これなら濡れているので、……んっ、痛くなりませんよね？　……ちゅっ、\nふふふっ、いいんです。ご奉仕するのは好き、ですから……ぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あ、あぁ……♪　だめですよ、どんどん膨らんで……ちゅっ。おとなしくし\nててください。れろっ……すぐに楽にしてあげますから……ちゅ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ふぁい……♪　おっぱいでも刺激を続けます、ね……♪　やさーしく、やさ\nしく……れろっ、ぴちゃ、くちゅ……。オチンチンを励まします、ちゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ん……くちゅっ、ちゅく、ぺろ……れろっ、ぴちゃっ、ぴちゃ、ぴちゃ……\n♪　んっ、おっぱいを上下に動かして……んちゅっ、んぁ……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はむ……♪　ちゅるっ……ぴちゃっ、ちゅぷっ♪　はぁっ、あぁ……オチン\nチンのぬくもりが胸につたわって、汗かいちゃいます……ぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁっ……！　頑張ってください……っ。んっ、くちゅっ、頑張っ\nて……♪　ちゅぷっ、んっ、プレッシャーになってませんか？　れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あなたはあなたのまま、ありのままでいいですからね……？　ぴちゃっ、気\n負わず、出せる力を出しきってください……。ん、ん、くちゅっちゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503131" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「私、できることならなんでも、します、からっ……♪　あなたを応援させて\nください……♪　んれろっ、れろ、ぴちゃっ、ちゅぷ、ぷっちゅっくちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ん、ん、ん、んん……っ。あ、もしかして射精したくなってきてますか？　\nいいですよ、今日はうんと甘えちゃってください……ちゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「私、はいつ出してもらっても……、ぁっ、平気ですから。んんっ、あなたの\nタイミングで、一番スッキリできる時にどうぞっ……。れろっ、れろれろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……んっ？　ここですか？　ここを舐めながら胸を揺らすと射精しやすいで\nすか？　わかりました……。くちゅっちゅぷっぴちゃぴちゃぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……んんんんっ！？　んぐっ、んんぅっ……！　ん……！　んっ、ん……！\n　い、いいです、そのまま出してください……んんん……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503136" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ん、ぁぷっ……！　あっ、溢れちゃう……！　ごめんなさい、飲んじゃいま\nすっ……！　グラウンドを汚しちゃうといけませんので……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503137" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_06" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ごくっ……♪　ごくっ、ごくっ……！　んんんぅっ、粘りがすっごいです…\n…！　飲み、こめない……んんぐっ……ごくんっ。んぁあ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ、暴れないでください。こぼれたお汁を舐めとります……れろぉっ、ぴ\nちゃっ、くちゅ……♪　ごくんっ……！　ん、ぁ……苦いです……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503139" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「は、ぁ……んぁあ……！　熱いのがびゅっびゅって……！　あっ、飲みきれ\nないですよ、……あっ、んぷっ、ごくんっ。んぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503140" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「けほっ。ど、どうですか……。少しは癒せましたか……って、あっ？　ど、\nどうしてさっきより元気になっているんですか！　は、励まされたから？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「だからこんなに……？　そう、ですか。それなら私のせいかもしれませんし\n……。もう少し応援させてください。はじめます……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あぁあっ……！？　私の動きに合わせてあなたが腰を動かすと、……んんん\nっ。こすれる場所が多くなって、……あっ、摩擦がどんどん加速して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503203" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……あっ♪　く、口の中にオチンチンをねじこまないでくださいぃ……！　\nぐちゅっ、ん、んちゅっ、あふっ……！？　ちゅく、くちゅっ、ぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503204" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はふっ……ん、んふっ？　んんっ……んぁううっ。さ、さっきの精液が、ま\nだお口に残ってて……苦味とヌメりでもうめちゃくちゃれひゅ……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503205" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ん、ぁっ……ぴちゃっ、ちゅぷ、ぷちゅ、ちゅぷ、ちゅっ……！　あのっ、\n胸の締めつけ、もう少し強くしてもいいですか？　んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「オチンチンに胸を密着させて……んちゅっ、私の唾を少し垂らして……すべ\nりを良くします、……んっ、あっ！　これ、わかりますかっ……変わったの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503207" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ん、ヌルヌルして……ああぁっ♪　私も硬いオチンチンでおっぱい突かれて\n、だいぶドキドキしちゃってます、ムラムラして……はぁっ、ちゅ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503208" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「オチンチンから目が離せない……くちゅっ。ん～っ……！　んんっ！　オチ\nンチンのでっぱりが、おっぱいをぐりぐりえぐって……あっあっんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「いけない気持ちになっちゃいますよぉ……！　あっ♪　すみませんっ、あな\nたを応援するためにしてる、のに……くちゅっ、感じちゃって、んちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「んん、んんっ……！　エッチな声、出すと……誰かに聞かれるかもしれませ\nんから、……れろっ、オチンチンを舐めて集中しまひゅ……ぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503211" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「んふぁっ、ぷぁ……ふぁあっ、くちゅっ、れろ……ぴっちゃっ、んん、んん\n～っ……！　んんぅっ……角度をつけて……んれろっ、ぴちゃっれろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503212" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「んはっ♪　オチンチンさんっ、がんばって……くらひゃい♪　くちゅっ、ぷ\nちゅ、もう少し、だけ、我慢ひて精液溜めてくりゃひゃいね……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503213" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「んちゅ……はぁっ♪　は、ぁ……んんんっ♪　え？　私がオチンチンに必死\nにご奉仕していると……おっぱいが揺れてスゴいって……？　あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503214" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あ、あんまり見ないでください……！　あっ！　真剣にするとつられて動い\nちゃうんですっ……！　んもぅっ、オチンチンにしっかり集中してっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……んちゅっ、ぴちゃっ！　ぴちゃっくちゅっ……！　んぁ……んん、ん、\nんん……！　あっ！？　こ、こらっ、おっぱい触らないでくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「んむっ♪　くちゅ、ちゅぷ、ぷちゅ……ちゅぅっ、んん？　我慢汁の量が増\nえてきましたね……っ、そろそろ、ですか？　んっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503217" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「今度、こそっ……！　あなたの疲れをとってあげられるようにっ、応援しま\nす……！　がんばれっ、がんばれぇ……オチンチンがんばれっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はむっ、くちゅっ♪　ちゅぷっ……ちゅぅっ、ちゅっ、ちゅぅううっ……！\n　先っちょ吸っちゃいますね、精子があがってくるようにっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ちゅるっ、じゅるるるるっ……！　じゅるっ、ちゅっ、ぷちゅっ、じゅるる\nるるっ……！　いいですよっ、出してくだひゃい……！　今れひゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503220" ]},
		{"command":[ "WAITINPUT" ]},
								
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ふむぐっ！？　んんんんん～っ……！？　んむっ！　むぅっ、むぐぅううっ\n……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「むぅっ♪　い、１回目より精液が濃い、れひゅ……！　んんんぅ……！　ご\nくっ……、んぷっ！　私が飲む速さより……んっ！？　んっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「オチンチンから精子が飛び出すスピードの方が速くて……あっ、んむっ！？\n　飲んでも飲んでも止まらないぃ……！　すごすぎですぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はぷっ……！　んぷっ、じゅるっ……ぢゅるるるっ！　ごくっ、ごくっ……\n！　あ、苦しいです……♪　濃くておいひい……ぢゅるっ、ごくんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503304" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「わたひの胸と口でこんなに気持ち良くなってくれて……っ♪　じゅるっ、嬉\nひいです。だから精液を……無駄になんてしません、全部いただきます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「っじゅるっ……じゅるっ、ごく……♪　ふぁああ……♪　熱くてねっとりし\nたお汁……。口の中にいっぱいに溜まって……ごくっ。ごくんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……ちゅるっ。ぷぁっ……！　はぁっ、はぁ……。なんとか全て飲みきれま\nした。少しは……あなたを剥げますことができたでしょうか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503307" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……たくさん応援されて元気が出た？　わぁ……！　私が力になれたのなら\n……良かったです。こんな応援をするのは初めてだったので……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503308" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「なかなか難しかったですけど、なんでも挑戦してみるものですね。はい、私\nはいつでも、あなたのことを応援してますよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「他の人ほど器用でもないですし、上手じゃないですけど……気持ちは負けま\nせん！　味方がいるということ、絶対に忘れないでいてくださいね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「きゃっ……！　あっぁっ、おっぱいにっ……！　胸に精液がびゅびゅって…\n…！　びゅるって！　あっ……！　あっぁっ熱いっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ど、どうどうっ！　そんなに暴れないでくださぁいっ……！　あんっ！？　\nお、抑えようとするとますます激しくビクビクして……止められません！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ♪　あっ、出てます、出てるところ、はっきり見えちゃってますっ……\n！　わぁ、あ……！　こ、こんな目の前で、射精……すごい……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「オチンチンの先っちょからビュルッ！　ビュルッ！　って……あぁっ、力強\nく、どこまでも飛んでいく……そして私の胸に着地してっ。あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「キツい臭いです……。私の汗の匂いなんてかき消してしまうくらい。それに\nこの、いやらしい色……。ドロドロに濁って真っ白ですよ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「んんっ♪　落ち着いて、最後まできっちり出しちゃってくださいね。はい。\n私は逃げたりしませんから……終わるまでずっと見つめてます……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……ふぅううっ……。思っていたより、大変な状態になっちゃいましたね。\nあ、動いちゃだめです！　グラウンドに精液が落ちるのはいけません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503407" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「これだけたくさん飛び散ってしまいましたけど、精液を出すように言ったの\nは私ですから。責任をとって……な、舐め取ります。ぴちゃ、ぴちゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「え？　出した後でオチンチンをいじられるとくすぐったい？　私の舌の刺激\nが強すぎる？　で、でしたら胸でぬぐいとります……。ん、しょ、んしょ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「それはそれでまた興奮しちゃいそう！？　も、もぉ……。困ったひとです。\nちょっとだけ我慢してください！　すぐに綺麗にしますから……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0503410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
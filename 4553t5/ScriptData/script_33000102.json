		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あっ……！？　な、なんてことをするのよぉっ！　見ないでっ……。わたし\nのこんな姿……あなたにだけは絶対に見られたくないのにぃっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104101" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……そ、それは、任務に失敗したことは……反省してるわ！　でも、だから\nって……お仕置きのやり方があんまりじゃないっ。お、下ろしてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104102" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「こんな格好……恥ずかしすぎるわぁっ。ね、ねぇっ……！　他のことならな\nんでもするからぁっ！　だからこれはやめて……、あっ、み、見ないでぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104103" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「え？　任務失敗の責任を、その身でしっかり味わうように……って、あ、あ\nなたっ。こっちに来てから性格が激しくなっているんじゃないっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104104" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「逢生学園にいた時はここまで過激なことはしなかったでしょ……！？　やっ\n！？　あ、悪になりきっているってことなのぉっ？　やっ、だめぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「普通にするなら……その、か、かまわないけどっ。こんなのハードなシチュ\nエーションプレイじゃない！　ねえっ、おち○ぽ取り出してどうする気？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ま、まさかこのまま……動けないわたしをそれで思いっきり犯すつもりぃっ\n？　ど、どこでそんなことを覚えてきたのっ……。あ！？　あっぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「はぁうううっ！？　あうっ？　ううううぅっ！？　う、嘘でしょぉ……！　\nおち○ぽ、お、おち○ぽずぶうって入れられちゃった……！　ふぁ、あぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104108" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あ、あなたがここまで強引にわたしを求めてくるなんて……！　……ち、違\nうっ、よ、喜んでなんていないわぁっ。驚いただけよっ……。でもぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「硬く、て……！　あっ！？　おち○ぽ、すっごく熱くって！　わ、わたしの\n中……！　おま○この中をまっすぐ貫いてる、こ、こんなの初めてぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ねえっ！　こ、こういうポーズ……ま〇ぐりがえし……って呼ぶんでしょう\nっ？　じょ、女性を支配して、恥ずかしがらせる卑猥なポーズ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104111" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「それにこの体勢……！　あんっ！　いつもよりおち○ぽが奥に突き刺さるの\nよぉっ！　あっ！　おち○ぽの挿入角度が、ふ、深いの、感じちゃうぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「っあぁっ……！　あっ！？　あっぁっ、んぁああっ、あぁああ……！　あぅ\nっ！　反省、しろって言われてもぉ……！　あっ、そんな余裕ないわぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あ、あなたがあんまり激しく腰を……あぅっ♪　使ってくる、からぁっ……\n！　あんっ！　つ、突きあげられるたびにっ、掻き回されるたびにっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「頭が真っ白になって……あんっ！　な、何も考えられなくなって……！　あ\nっ！？　い、いやぁっ♪　積極的すぎるわよ、こんなの耐えられないぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「き、気持ち良くなっちゃうぅっ！　あっ！　あっあっあっ！　お、おかしく\nなっちゃう……っ！　おま○こも頭もバカになっちゃうぅっ、あぁああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「わ、わかったわぁっ！　反省っ……、反省しましたからっ！　わ、わたしぃ\nっ！　きっちり反省して……次からは失敗しないようにしますからぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「だ、だからっ……♪　あんっ！？　も、もう少しだけ優しくしてぇ……っ、\nえっ！？　そんなに大きくおち○ぽを前後させたら……！　んぁんんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104118" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あ、脚がガクガク震えちゃうぅうっ……！　やだぁああ……♪　い、いつも\nよりおま○こが濡れてる？　そ、そんなこと……ないわぁ、……あぁんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104119" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「おち○ぽをぎゅうぎゅう粘膜で締めつけてる？　……あっ♪　じ、実況しな\nいでぇ……！　自分でも止められないの、勝手に絡みつかせちゃうだけぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んひぃいっ♪　あひっ♪　あんっ、あぁんっ……！　こ、拘束されながら突\nかれるとぉ……！　ギシッギシッて軋む音がして……す、すごいぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104121" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「脚を大きく開かされて、めちゃくちゃにおち○ぽ入れられてぇ……！　あっ\n♪　は、反省させられて、本当は屈辱なはずなのにぃ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104122" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あんんっ！？　あぁあんんっ！　一度突かれるごとにっ、あっ！　おま○こ\nがビクビクヒクついてっ、おち○ぽを歓迎してるのがわかっちゃうぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104123" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あぁああ……！　あ、あなたねぇっ！　わ、わたしの感じるところ……っ、\nじゃ、弱点を知り尽くしてるみたいな動き、し、しないでよぉ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104124" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あっ！　勝手に腰が揺れてっ……。んんっ、お、おま○こからいっぱい愛液\nが溢れちゃう……っ。わ、わたし……お仕置きされて感じてるのぉっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「こ、こんな姿……学園の皆には絶対知られたくないぃっ！　んぁああっ♪　\nあぁっ……あぁああっ、全身がゾクゾクするぅ、気持ちいいのが増えてくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104126" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……んんんっ！　に、任務ぅう……！　任務に失敗すると、こんな目にあっ\nちゃうのねぇ……！　あっ！　にゅるぅっにゅるぅって出入りしてるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あなたの大きなおち○ぽが！　わたしのヌルヌルのおま○こに出たり入った\nり……あぁああっ♪　すごいわ、太いのがわたしの中で……！　んんぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104128" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あぁああっ♪　身体が跳ねるのがやめられないぃいいっ……！　んぁんんっ\n！？　もっとのけぞりたいのにぃ、う、うまくいかないのぉっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……自由になりたいのなら……？　んぁっ、もっと反省しろ……って、こ、\nこれ以上どうしたら反省したって認めてくれるのぉっ……？　あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104130" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「このままおま○こに中出しするから……？　あっ♪　精液を全部ぅ……っ、\n一滴残らず、子宮で受け止めろ……？　は……は、い……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「はいぃいっ……！　わ、わかりましたぁっ。わかりましたぁあ……！　深く\n反省して、あなたの精液……精一杯おま○こで受け止めますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「だから……！　出して、出してくださいっ……！　わたしの中に……！　漏\nれたりしないように、い、一番奥に、おち○ぽの先をぴったりくっつけて！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んやぁんんっ♪　早く……早くちょうだぁいいっ……！　ねぇっ、もう我慢\nできないぃっ……！　あんっ、わたしのこと教育してぇ……！　っあぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104134" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「出して……出してぇっ！　あっ、ああああっ……！　あなたのおち○ぽから\n、熱い精液を発射して……わたしのおま○こに注入してぇえっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んぅううううっ……！？　ふぅううっ♪　んんん～っ♪　ンンンンッ……！\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104136" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_07" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あ、あり、がとうございます、お仕置きありがとうございますぅううっ……\n！　あっ♪　あっ、奥にっ、深いところに大量に射精されてるぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んゃぁっ、さらに奥に押しこまないでぇっ……！　あっ！？　あっ……すご\nいぃ、わかる……！　たくさん出てるのが……おち○ぽ震えているのがっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104138" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ううううっ♪　ドクッ、ドクッて……精液が注ぎこまれて……あああああ…\n…♪　おま○この中があったかくなってきたわぁ……！　あぁあっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「こ、これがお仕置きぃ……！　んんぅうっ！？　だ、だめぇっ、中出しされ\nてイッちゃうっ……！　あんっ、イクっ……イッちゃうわぁあっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……。い、いくらお仕置きだと言っても……。性的なこと\nじゃなくても良かった、でしょう……？　なのにどうしてこんなこと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……な、なあに？　友理奈のことを愛しているから？　だからこうして、身\n体を使ったお仕置きを選んだ？　な、何を言ってるのぉっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「そんな台詞、台本になかったでしょう！？　ふ、不意打ちすぎるわぁ、……\nあ……、ぁ、わ、わたし……。あ……。だ、だめよぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104203" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「そんなこと、まっすぐに言われたら……恥ずかしくって、まともにあなたの\n顔が見られない……。ね、ねえ。これって、お仕置きプレイよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「たまにはそういう設定でしてみようって、あなたが言うから……。努力して\n演じてみたのに、ちょ、直球で愛してるとか……。信じられないわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んっ……？　ま、待って！　本当に恥ずかしいのぉっ。だから今おち○ぽを\n動かしちゃだめ……っ！　あんっ、さ、さっきの絶頂の余韻も残ってるの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「そんな状態で続けたら……！　っあっ♪　んもぉっ♪　お芝居じゃなくても\n、全然言うことを聞いてくれないんだからぁっ……。やぁっ♪　あぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104207" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あ、あれだけ射精して、おち○ぽカチカチのままなんて、あっ♪　ど、どう\nかしてるわよぉ……！　えっ？　わたしがえっちだから？　っぅううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「わたしのおま○こが、おち○ぽを萎えさせてくれないぃ？　……あっ、射精\nしている間から、すぐに次の精子を求めてうごめいて……絡みついて？」", "NORMAL" ]},

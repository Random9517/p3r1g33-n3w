		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「おち○ぽを貪欲に要求してきてた？　……そ、それは……っ。それはぁっ！\n　い、言い訳はできないけど……。んんっ、か、勝手に反応しただけよぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「だ、だって……！　わたしだって、好きな相手としていて……ヘンにならな\nいわけがないでしょう！？　ばかぁ……っ、……あっ！　また大きくっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あんっ！　あぁんっ♪　おち○ぽ硬すぎるわぁっ♪　あっ♪　またすぐイカ\nされちゃう、こんなの、すぐに気持ち良くさせられちゃうっ！　っあああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104212" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「っうぅうっ♪　わたしが気持ち良くなると……あっ！　あなたのおち○ぽも\n気持ち良くなって……っ。んん、相乗効果でどこまでものぼっちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……やだ、好きだなんて言わないで……！　あっ♪　あなたねぇ！　わたし\nがそういう言葉に弱いって知って、るでしょうっ……。あっ、やぁあっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104214" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「好きとか愛してるとか言われると、言葉だけで絶頂しちゃいそうになるのよ\nぉっ……！　あんっ、囁かないで、あっ、しながら言わないでぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「だめっ、イッちゃうっ……！　あなたのおち○ぽに突かれながら、……あん\nっ！　どんどん感じさせられて……！　あああっ、イクぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「イクっ……！　あああああっ♪　……んんんっ！？　イッたのに、イッてる\n最中にそんなに激しくこすらないで、あっ、突き上げないでぇえっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「イクぅっ……！　イクっ……！　ずぅっとイッちゃううぅうっ！　も、もう\nいやぁっ♪　わたしだけイクなんて不公平よぉっ、あなたもきてぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104218" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「一人でイキ続けるなんていやよぉっ……！　あぁっ、いいからっ！　どこに\n出しても……！　あなたのだったらかまわないからぁっ！　あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ま、またイッちゃう……っ！　あぁっ、合わせるわぁ、あなたのっ、射精に\n合わせるからっ……！　一緒に！　一緒にイッて！　……んんんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104220" ]},
		{"command":[ "WAITINPUT" ]},
								
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あああああああっ♪　イクぅっ……！　今までで一番っ、大きな絶頂が……\nああああああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「嬉しい……！　あなたと一緒に絶頂できて嬉しいわ、ねぇっ……！　このま\nま、ずうっと幸せなまま……！　あっ……あっぁっ、流しこんで……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あなたの精液で、わたしのおま○こが溺れちゃうくらいぃいっ……。出し続\nけて……！　あっ♪　すごいっ、どんどん量が増えていく……！　あぁんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「いいわ、最後までわたしが……おま○こで絞り上げてあげる、から……！　\n全部出してぇっ……！　ふぁあっ、熱い……！　ドロドロしてるぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あんっ♪　あぁんっ……！　気持ちいいっ……！　あなたに中出しされるの\n、すごくすごく気持ちいいのぉっ……！　何度でもイッちゃうぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「っんぅううううぅっ……！　イッくぅううっ……！　イクぅううっ！　好き\nぃっ、好きよぉっ！　あっ！　あっぁっあぁあああんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……ふぅううっ……♪　ま、満足できたかしら……？　わたし？　わたしは\n……。い、言わせないで、これ以上照れたくないのよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「まったく……。悪の幹部ごっこがしたいなんておねだりするから、やってみ\nたけれど……。あなたがこんなに盛り上がるとは思ってなかったわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……わたしも楽しんでた？　……う……。そうね、それは否定できないわ…\n…。いつもとは違う場所で、違うわたしたちになりきって遊ぶ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「こういうのも、悪くないかもねぇ。だからたまに……。そう、ごくごくたま\nーにだったら……いいわよぉ。付き合ってあげるから、さ、誘ってね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「はぁああああああっ……♪　ああっ！　熱いぃっ！　あなたの精子、グツグ\nツに煮えたぎった精液がわたしの身体にぶちまけられてるぅううっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「やぁっ……！　さっき出したばっかりなのに……こんなにたくさん出して…\n…！　あぁんっ♪　ネバネバしたあなたの精液……あっ、身体中に♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「まるで白い雨みたい……っ。あぁああっ……！　トロみを帯びた、いやらし\nい精液……っ。あなたのおち○ぽから次々に降り注いで……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104403" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あっ……あっあっ♪　あなたのニオイを全身に浴びて、頭がとろけてしまう\nくらい……感じるわぁっ。あぁっ、もっと、もっとかけてほしいのぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「っん……♪　よぉく狙って……。あぁあああっ……！　あなたの精液で、ド\nロドロになっていくところ……見ているだけでイッちゃうぅうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んんっ！？　んんんんっ……！　真っ白なあなたの体液が……わたしの肌に\nこびりついてるぅ……♪　ずっとこのままでいられたらいいのに……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ふぅ、ふう、ふぅうう……。あ、あまり見つめないでぇ……。なんだか今日\nは、すごく乱れてしまったから……。自分が恥ずかしくてたまらないのよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……こっちも興奮してたからお互いさま？　ふふふ、そうねぇ。あなたも相\n当楽しんでたわね。だったら……２人の秘密にすればいいのかしらぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104408" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「当たり前のことだけど、み、みんなに今日のことを言ったりしたら許さない\nわよ……！　そう！　絶対に言わないで。でも……悪くはなかったわよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あなたの演技力を信頼して、また、機会があればこういうプレイも……。っ\nて、やっぱりだめ。お願いされたら？　……それなら……いいけどぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0104410" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_02_16" ]},

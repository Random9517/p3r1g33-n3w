		{"command":[ "SETIMAGE", "0", "still_00000162_02_15" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁぁぁっ！　あぷっ、チンポ……抜けてっ……ザーメンっ……掛かってっ、\n　んくぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「どうしても、ぶっかけたくなった……？　そうか……んっ、私のサキュバス\n　としての本能が貴様を狂わせたのだな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000162_02_14" ]},
		{"command":[ "SETTEXT", "「いいだろう……好きなだけ私の全身に浴びせるがいい……顔にもおっぱいに\n　も……腹にも……足にも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「中でなくとも、悪くないものだな……ちゃんと肌から、精力を吸収出来てい\n　る……いいぞ……残さずぶっ掛けるんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……終わりか。ふぅ……新鮮なザーメンは、やはりサキュバスには欠かせな\n　いもののようだな……ちゅぷ……れろっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000162_02_13" ]},
		{"command":[ "SETTEXT", "「うむ、悪くない。これなら、なんとか私もサキュバスとしてやっていくこと\n　が出来そうだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん……？　元に戻る方法？　まぁ、そのうち何とかなろだろう。とりあえず、\n　それまでの精力の目処は立ったわけだからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「というわけで……これからも欲しくなった時は貴様に色々としてもらうから、\n　よろしく頼む」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふ……ただするだけではないぞ？　次は、もっと技を磨いて、貴様の全身\n　を骨抜きにする位に搾り取ってやるからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「おっと……チンポは正直に反応したな。ああ、楽しみにしているがいい。\n　暫く、貴様のチンポは私のものだ……ふふっ……」", "NORMAL" ]},

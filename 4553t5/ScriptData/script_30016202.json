		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00000162_02_12" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んひぃぃぃぃぃんっ！　あぁっ……また熱いっ……！　中に……新しいのが\n　……入って来てる……んくぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁぁ……もっと出せ……溢れて、それでも、まだ……出し続けろ……私が、\n　全部受け止めてやるからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000162_02_11" ]},
		{"command":[ "SETTEXT", "「気持ちいい……あぁ……もう元に戻れなくてもいいかも知れない……サキュ\n　バスのままでも、このザーメンがあれば……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……まだだぞ……簡単には離さないからな……全部出し切るまで\n　……オマンコは咥えたままだからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000162_02_10" ]},
		{"command":[ "SETTEXT", "「あふっ……出し切った？　本当だな？　残っていたら、またすぐに搾り取る\n　からな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「いいだろう……はぁ、ふぅ……あぁ……なかなか悪くなかったぞ……身体\n　全体に染み渡った感じがする……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん？　あぁ、そうだったな、もうチンポを抜いてもいいぞ。いや、待て……\n　まだ、もう少し余韻があってもいいだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ええいっ、あと少しだけだ！　ここまで来たら、数分位待てるだろう！\n　私は、まだこの感触を味わっていたいんだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それにしても、サキュバスになって、この渇きをどうしようかと思っていた\n　が……貴様がいれば、とりあえずなんとかなりそうだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うむ、また欲しくなった時は呼びつけるからな。いつでも出せるように準備\n　をしておけよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6204310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},


		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},

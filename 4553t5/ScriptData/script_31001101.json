{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0187" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「待たせたな……ふふ、緊張しているか？　私も、ガラにもなく少し緊張して\nいるぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103101" ]},
		{"command":[ "SETCHARA", "0", "char_00010011_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「だが、もうお互いに十分に昂っているのは、間違いないだろう？　だから、\n欲望に身を任せてしまえばいい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103102" ]},
		{"command":[ "SETCHARA", "0", "char_00010011_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「最初の準備は大事だからな。何をして欲しい？　他ならぬダンナ様だ。おま\nえのしたいことはどんなことでもしてやるぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103103" ]},
		{"command":[ "SETCHARA", "0", "char_00010011_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ん……？　一緒に気分を高めていきたい？　なるほど……ならば、このドレ\nスのまま少し大胆にしてみるか……つまり、こういうことだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103104" ]},
		{"command":[ "SETCHARA", "0", "char_00010011_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほうら……どうだ。私のウェディングドレスの奥……これをずっと見たかっ\nたんだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103105" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「私もおまえのペニス……いや、この凶悪な代物はチンポというのが相応しい\nな。こいつを見たくてたまらなかったんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103106" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふ……私の豊満な乳房……パイオツは、このチンポの為に大きくなったと\n言っても過言ではない。パイズリをしてやろう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103107" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっふっ、こうして……んっ、おおっ……更に大きくなっていくじゃないか\n。全く、正直なチンポだな……はっ、んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103108" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふ……どうした、見てるだけか？　おまえがどうしたいかは手に取るよう\nに分かっているぞ？　何も遠慮することはない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んんんっ……！　そうだ……舐めてくれ……はぁんっ、もうグチュグチュに\nなってる割れ目を……舌でたっぷり可愛がってくれ……んぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、いいぞ……じゃあ、私もお返しだ……このビンビンに勃起し\nたチンポを……挟んで扱いていくからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……どうだ……柔らかさもあるが、弾力も悪くないだろう？　こ\nのおっぱいの張りは、自信があるところだからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103112" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ぎゅっと竿の脈打つところを押し込んで……縦に……ズリズリと動かしてや\nる……んむっ、ビクビク震えているな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「気持ちいいか？　それならいい……だが、こんなものではないぞ？　れろ…\n…しっかりとチンポを濡らして……扱く……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103114" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ、うんっ……んはっ……んふぅ……チンポのにおいだ……こい\nつが私を興奮させてくれる……んっ、ふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103115" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「鼻先をもっと押し付けて、よーくにおいを嗅ぎながら……縦ズリを……繰り\n返していく……ん、くっ、あっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふ……アソコ……オマンコの中に舌が入ってきた……はぁ、んっ、そうだ\n……あぁ、丁寧に舐めて来てるな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「浅いところを……ゆっくり刺激されると……はぁっ、んっ、じわっと……新\nしい汁が滲み出してくるのが分かる……くぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ、あふっ……そっちがそう来るなら……私も……しなければな……はぁ\nんむ、くぽっ、んぷっ、じゅぱ、んちゅぷぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103119" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふっ……おっぱいだけだと思っていたか？　おまえばかり舐めるなんて不\n公平が通る筈はないだろう？　ちゅぷ、ぴちゃ、んちゅぷ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103120" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「れろ、じゅぱっ……お互いのいやらしい場所を舐め合ってこそ……気持ちも\n、昂るというものだ……くぽ、んちゅぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んぅっ……！　舌先が……んっ、ツンと……肉ビラをつついてくる……はん\nっ……あっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103122" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ちゃんと、私の感じやすいところを把握しているな……んんっ！　あっ、オ\nマンコ……火照って来る……また、汁が漏れるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ならば……私も……ちゅぽっ、んちゅぅぅぅっ……ふぶっ、んっ、りゅぷっ\n……ろうら……？　おまえの好きなところの筈だ……れろ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103124" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んんっ、おっぱいの中で……チンポがビクビク蠢いているな……狙い通りと\nいう訳だ……んふ……いいぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ、あっ、んむ……ちゅぱっ、ぴちゃ……この汁の音が、一層興\n奮を増してくる……感じるのが……分かるだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103126" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「腰が勝手に跳ねて……ほぅら、どうどう……しっかりおっぱいで押さえつけ\nてやらないと、こぼれ出して来そうだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「根元からしっかりと締め付けて……全体をまんべんなく擦ってやらないとな\n……んふぅっ、あぁ……チンポが熱くなっていくぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ぴちゃ……んちゅっ、先走りも滲んできたな……ちゅぷぅ……じゅるっ……\nこの汁が、もう……既に濃い目になってる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103129" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「これは……本番の発射も期待できそうだ……じゅぽっ、ちゅぷっ、んちゅぷ\nっ、くぷっ、りゅぽっ、んふぅ……じゅるるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふっ、チンポを舐めれば舐めるほど……おっぱいの中で……太いのが蠢い\nて……いっぱい擦れてくるぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103131" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ズリズリ……擦りまくって……うんっ！　おまえの舌も……また、入り込ん\nでいる……そこはっ……クリ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ！　私も……同じか……今みたいに身体が勝手に跳ねて……オマ\nンコも……んっ、ヒクヒクさせてしまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103133" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、もうイキそうだ……チンポも……あと少し……！　最後……\n思いっきり扱いてっ……出すっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はっ、んっ、あぁっ、さあ……飲ませてくれっ、ダンナ様の……どっぷり濃\nい汁を……直接飲ませてくれっ、んふぅっ、りゅぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103135" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふぶっ……！　んむぅぅぅんっ……！　んっ、ふっ……来たっ……あぷっ、\nんじゅるっ、じゅるっ、んふぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103136" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_06" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁんむ……じゅぷっ、いつ飲んでも……この濃さはいい……ドロリとした\n喉越し……こいつでなければ味わえない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふ……珍味のように言うな？　仕方ないだろう、実際にそうなのだからな\n……んちゅっ、ちゅぷぅ……んはっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103138" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ずっと、この濃度だと胸焼けもするだろうが、後味は少し薄くなっていると\nころがちょうどいい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ぷはっ……ふぅ……今日も存分に味わえた。やはりおまえのチンポ汁が私に\nはピッタリだな！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103140" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……さて……たっぷり出してくれたが……この膨らみはまだしっか\nり奥に残してる証拠だな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふ……私はどかないぞ。このまま続けてもう一発だ。ちゅぷっ……むしろ\n、ここからが本番だからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103202" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「少し溢れた精液が、ちょうどおっぱいの谷間に落ちて、いい滑り具合になっ\nてくれそうだ……どら、また扱くぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふっ……ぎゅっと押し込んで……くふぅ……熱いな……意外にドレスも…\n…熱を逃さないから……汗が滲んでくる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103204" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はふぅ……だが……その方が、よりオスとメスのにおいが強調されていい…\n…んっ、汗も潤滑油のうちだからな……れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103205" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぅっ……！　んんっ、私のオマンコも……かなり敏感になっている……お\nまえの舌の技は極上だからな……くぅぅん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ただ責めるのが上手いだけじゃなく……焦らし方まで、心得ている……はぁ\nっ、んっ……今も……んっ、んひっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103207" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「溢れる……汁を……舐め取りながら……んっ、ヒダに……舌が食い込んで…\n…おぉぉっ……かなり……効くぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「そっちがその気なら……私も、もう容赦はせんぞ……？　んりゅっ、じゅぽ\nっ……んふぅっ……チンポの先をしゃぶりまくるからなっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103209" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「じゅっぷ……じゅぱっ、はぁ……んっ、口の中に涎が広がるぅ……じゅるる\nっ……舌が止まらない旨さだ……んじゅぷぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103210" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、あぁ……乳首もコリコリになってきている……こいつを押し\n付けたら……んぅっ！　いい具合に……痺れるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ、あっ、あぁっ……パイズリが効くぅ……チンポに奉仕すればするほど\n……私の身体も疼きを増して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「くぅんっ……オマンコを刺激されて……もっと汁を溢れさせてぇ……はっ、\nふっ、あっ、ひぁっ……あぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103213" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こうなったら……ずじゅるっ、なりふり構っていられないっ……んじゅるっ\n、チンポの先走りを吸い上げて……顔を激しく動かしてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「じゅぽっ、とにかく……イカせてやるからなっ……じゃないと……私の方が\n……ん、ぁっ！　先に……イッてしまうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103215" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁぁっ……んんっ！　んじゅるっ、ちゅぷっ……んちゅぅぅっ……どうら\n……おまえのチンポも……ビクビクしてっ、限界だろうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「じゅぱっ……最後にもう一発……派手に飛ばさせる為に……思いっきりおっ\nぱいを……押し付けてやるからなっ……んっ、ふっ、んくぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103217" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぁ……んちゅぷっ、ビクつきが大きくっ……んっ、さあ……出るんだろう\nっ……我慢するなっ……全部出せっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103218" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ドレスにぶっかけてもいいっ、とにかく精液だっ……んじゅるっ……私も…\n…イクからなっ……だから、後は……溜めたのを、出せっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んんんっ、とどめの……おっぱいプレスだっ……おまえの欲望を……全部…\n…漏らせっ、んちゅぷっ、んじゅぅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103220" ]},
		{"command":[ "WAITINPUT" ]},
				
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んぁぷっ……！　んんっ……むぐっ、んふっ、あたらひいのっ……れたっ…\n…んっぐ……こくん……んっ、んぐっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んんっ……まだまだ、こんなに溜め込んでいたか……じゅる、んちゅぷっ…\n…ふふ、大したものだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んはぁ、喉を鳴らして……飲んでいくからな……おまえも……私の、潮吹き\n汁を……飲んでくれ……どんどん溢れてくるからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁぁ……んっ、直接オマンコに口付けされて……飲まれてる……くぅ……\n間近でイってるオマンコ見られていると思うと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103304" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁぁ……また、恥ずかしい汁が溢れて……止まらなくなる……んんっ、あ\nっ、そこだ……もっと吸ってくれ……私も……吸うからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んはぁっ、はぁ、はぁ……どうやら、出し切ったようだな……ちゅぱ……何\nとか全部飲みきったぞ……ふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103306" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「全く……ザーメンで腹一杯にさせられるところだ。っと……一応、後始末も\nしてやらんとな……ちゅぷ、んちゅぅぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103307" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んむっ、あぁ……ここにもまだついているぞ。全く、私にこんな面倒を掛け\nさせるのは、おまえのチンポくらいなものだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103308" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「さて、これでいい。ピカピカのチンポに元通りだ。私の唾液で、少し光って\nいるがな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「だが、思った以上に張り切ってしまったな……２発出させたら休憩が必要か\n……まぁ、そこは頑張って貰うとするか。なぁ、ダンナ様？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103310" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んんんんんっ……！　はぷっ、ぶっ掛けが……お望みだったか……んふっ、\n顔に……おっぱいに精液が……飛んでるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103401" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふぁ……いいぞ、派手に飛ばせ……顔もドレスもザーメンまみれにするん\nだ……下手な遠慮はするんじゃないぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「そうだ……んあふっ……！　私も……イッてる……んふっ、おまえの顔に…\n…あふっ、恥ずかしい潮吹き……出してるぅ……んふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「そうだ……遠慮なく浴びるといい……あっ、オマンコ……舐められて……は\nぁぅ……マン汁……吸い上げられてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふぁぁ……あぁっ、ずっと気持ちいい……ザーメン浴びながら、オマンコ舐\nめられるの……最高だ……んんぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぁ……止まっちまった……これだけ出せば、いい加減終わりか……ちゅぱ\nっ、ふふ……ドレスもベットリだな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「バカ、別に謝らなくていい。私がそうして欲しかったんだからな。もっとダ\nンナとして堂々としてればいいんだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103407" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_09" ]},		
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「どれ……しっかり後始末もしてやらないとだな。ちゅぷ……んちゅ……んち\nゅぅぅ……頑張ったチンポに労いだ……ちゅぷぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103408" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ、こんなもんか……ふふっ、案外いい奥さんになるんじゃないか？　チ\nンポの世話は任せてもらっていいだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1103409" ]},
		{"command":[ "SETIMAGE", "0", "still_00010011_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふ……これからも末永くよろしく頼むぞ、ダンナ様。こう見えて、私は好\nきモノだからな……体力もしっかりつけておけよ？」", "NORMAL" ]},

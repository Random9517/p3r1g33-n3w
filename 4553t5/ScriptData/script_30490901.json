		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んふぅっ！？　あぁッ！？　あっぁっあっ……！　イクぅっ！　潮を吹きな\nがらイッてしまうぅっ！　うぁああっ♪　あっぁっおっ♪　んぉおおっ！」", "NORMAL" ]},

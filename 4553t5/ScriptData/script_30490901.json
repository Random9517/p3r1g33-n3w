		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「はぁっ、んぷぅっ♪　じゅぷっ、じゅるっ……！　ね、ぇ聞こえるぅ？　あ\nーしのオマンコ、めっちゃぐちゅぐちゅ鳴ってるぅ……んっンッんんっ♪」", "NORMAL" ]},

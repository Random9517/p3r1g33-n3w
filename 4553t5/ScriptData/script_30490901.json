{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ふぅ……。まさか君に、私のこんな姿を目撃されてしまうとはな……。い、\nいや、油断していた私が悪い。そんなことは分かった上で問わせてもらう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903101" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「な、なぜ……そんなにも股間を隆起させ、興奮した様子で私を見ているのだ\n。君のような若い男にとっては、失笑モノだろう？　こんな若作りした格好」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903102" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……何？　それがいい？　おかしなことを言う……。無理した若作りを、人\nに見られて恥じらっている私に欲情する？　フン……そっちがその気なら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903103" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「そら……！　こちらも遠慮なくとがめさせてもらうぞ、その不埒なペニス…\n…君のチンポを。まったく、こんなに大きくして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903104" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……んッ！？　ピクピク震えている？　そうかそうか。そんなにもこの服装\nが好きか。そりゃあ今は多少キツいかもしれないが、私だってな……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「昔はこういった服装をしていた頃も当然あった。だ、だからといって……う\nむ。今の言い訳にもならないが……自分でもどうかと思わんでもないが！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……君がこれに興奮するのなら、取引可能ということだろう。つまり……そ\nの、だ。このまま私が、この姿で君のチンポに奉仕する。そのかわり……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903107" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ちゃんと気持ち良く射精できたら、こ、今回のことは……。この制服のこと\nは！　他言無用で見なかったことにすると誓ってくれ！　頼む、後生だ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「キレイさっぱり記憶から抹消してくれるというのなら、私も本気を出す。だ\nから……、ん？　な、なんだ？　もっとギャルっぽく言えだと……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ギャル……？　た、隊長おにいちゃ～ん☆　美鈴がいっぱいオチンチン気持\nちよくしたげる☆　だからセンコーにはゼッタイ内緒にしてっ☆」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903110" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……違う！？　て、ていうか～？　美鈴はギャルだからオチンポいじり超得\n意だし～。マジ天才のフェラで黙らすよね～☆　これも違う！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「も、もういいだろうっ……。とにかく交渉は成立だな！　しっかり君のチン\nポをフェラチオしてやるぞ。……それだけじゃ駄目？　自慰もしろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903112" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「要求が多すぎる……！　が、その方がたくさん射精できるというのであれば\n……やぶさかではない。こ、こうか？　あまり……見るな。いくぞ。んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ん……、ぴちゃっ……んぁ……♪　本当に、君のチンポは若さに溢れている\nな……。私の舌を押し戻してくるほどに硬く、弾力のある亀頭……んちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903114" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「そんなに制服が……んっ、好きだったとは知らなかったな……ぴちゃっ。し\nかもこんなに派手な、露出度の高いモノを……れろっ、ちゅぱっぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「私の学生時代はもっと清楚な感じだったが……んっ。い、今はこうなんだろ\nう？　時代は変わった……。んれろっ、れろ、レロ……ちゅくっ、くちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……んっ？　堅物の私が着るからいいんだ、だと？　無理したイタい感じが\nそそる？　き、君……私に屈辱を与えて楽しいか……。っちゅぷっ、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「私も興奮しているだろう？　馬鹿な、そんなわけが……。あっ！？　オマン\nコがだらだらに濡れている？　あまり見るな……っ、はぁ、はぁ、はぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903118" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「こ、これは……違うんだ、……っちゅっ。若作りをして、フェラチオさせら\nれているから濡れているんじゃない。君があまりにチンポを硬くするから！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903119" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「つられてこちらも反応しただけで……！　っう、うるさい、黙って奉仕され\nていろ！　……ちゅっ。くちゅっ、ちゅっ、ほら、先走りの汁が滲んできた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903120" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「この汁と私の唾でチンポをヌルヌルにされると気持ちいいんだろう？　……\nあっ♪　わ、私、も……！　イタい制服姿見られながらアソコを……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「オマンコをいじっていると、中が疼いてたまらない……！　っぁっ！　ンッ\n、くぅうっ……！　ふぅうっ、うぅっ♪　ぴちゃっ、ぴちゃ、くちゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903122" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「先端だけじゃなく、もっと深く咥えてしゃぶれ……？　生意気なことを言う\n……！　が、これも見逃してもらうためだ。仕方ない……んむっ、ぐちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903123" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「じゅぽっ！　こ、こうか！　もっと下品に？　うぅうっ、注文が多いぞ！　\nぐちゅっ！　レロッ……！　激しくギャルっぽく？　んむぅっ、じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903124" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あ、あーしのおクチで速攻イかせてやるし☆　じゅるっ！　れろっ！　れろ\nぉおおっ……！　ンンッ、強く吸われるのがいいのか？　ぢゅるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ウチのオマンコ見てぇ♪　ぬるぬるでヤバイ☆　んぅうっ……！　好きピの\nチンポデカすぎてマジ感じるんだよね☆　メスの本能が止まんないつうか☆」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903126" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「チンポしゃぶるのガチやめられない☆　……じゅぷっ！　ぐちゅっ……じゅ\nるぅっ♪　あむっ♪　んむッ、おいひぃ☆　ギャルの好物☆　んじゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「チンポっ、ビクビク痙攣してっし☆　口の中で暴れすぎててウケるよね♪　\nこっちで咥えてるだけで大変すぎるんですけど☆　はむっ、じゅるるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んっ♪　ぬぽっ、ぬぽって大きめに口でシゴくとスゴい♪　どんどん硬さ増\nしてく☆　口ん中からはみだしそ☆　太すぎ……ンッ♪　ンッ、んんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903129" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あぁっ……！　オマンコ、マ、マンコどんどん気持ち良くなってきた！　あ\nっ♪　あぁっ、チンポしゃぶってオナるのサイコー☆　んぉっ♪　じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903130" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んはぁっ、ぴちゃっ、くっちゅっ……ンンンッ♪　おいひっ……☆　おいひ\nぃいっ……！　カウパーで舌がニュルニュルしてるぅ♪　んっ、れろぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903131" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「もっと、もっと舐めさせてぇ……！　っちゅぷっ、ぐちゅっ、じゅぷっ！　\nはふっ♪　ふぅっ、んじゅるっ、じゅるるっ……あ、ぁ、あ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「オマンコあっつくなってきた、あっ♪　あっ、指にヒダヒダが絡みついてぇ\n……オチンポ欲しがってる☆　ぐちゅっ、ずちゅっ、このデカオチンポぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903133" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ここ、から出るドロドロネバネバの精子欲しいのぉ☆　じゅるっ……ねーえ\nぇ、あーしに精子飲ませてぇ……！　っじゅるっじゅぷっ、お願いぃ☆」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んぁっ♪　チンポ、破裂しそうなくらい膨らんでるしぃ、あーしももうイキ\nそ……！　ッあっ！　あっ、一緒にぃ、一緒にイこぉっ♪　じゅるるるるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903135" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んっ♪　ぉっ♪　おぶっ！？　んぐぅっ！　んっ……んぅうううううっ……\n！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903136" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んぶっ♪　イッた瞬間に口の中に流しこまれる精液ぃい……♪　た、たまり\nゃない……。じゅるっ、じゅるるっ、もっと、もっと出へぇえ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ごきゅっ♪　ゴクッ！　ごくっ、ごくっ……！　んぁああっ、このガツンと\n来る苦味ぃ……！　いいぞ、君、チンポから絞り出せ……！　んっうぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903138" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んじゅるじゅるじゅるっ♪　ゴクッ！　ごくっ、ごく！　あぁあ……♪　熱\nい、マジありえないぃ♪　粘り気キツすぎぃい♪　……ごくっ、ごくっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「そんなにあーしのおクチ気持ち良かった？　みたいなぁ☆　って、ま、まだ\n出てくるっ！？　あぷっ、射精しつこすぎ☆　でもそれがイイっ……ごくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んーっ……！　ん、ん、んんーっ……！　ごくっ……んれろっ、ま、待って\n、飛び出た精子ぃ……全部舐め取って飲むからぁ……ぴちゃっ、ごくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903201" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んはぁああっ……♪　すごい……、おクチの中全部精液の臭いになっちゃっ\nたぁ……☆　……と、こ、こんなものか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903202" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「どうだった……？　私のギャルの演技は……。何？　本気でなりきって感じ\nていた？　バカを言うな、証拠にアソコがぐちょ濡れになっている？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903203" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……う……うるさい……！　君が出した精子も全て飲み干した。これでいい\nだろう、この件については綺麗さっぱり忘れてくれるな？　……と」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「どうしてまだこんなにも、チンポを隆起させているんだ？　ん？　私のイタ\nくてヤバいギャル演技で、随分盛り上がっているみたいだが？　んん？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……あと少し、コギャル長官を見ていたい、だと？　う……。本当に仕方な\nいやつだな。本当にあと一度だけ、これきりだぞ。誰にも言わないこと！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んん……レロッ……！　あ、まだこんなに苦味が残っているとは……。綺麗\nに掃除できていなかったようだ、な……くちゅっ、レロッ、レロッぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903207" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「はぁっ、じゅるっ！　ぐちゅっ、じゅぽっ！　はぁっ、ふぅうっ♪　ぴちゃ\nっ、レロぉ……♪　んん、それにしても凄まじい勃起、だな……ぐちゅっ」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んぶっ♪　ぐちゅっ♪　じゅるるっ☆　じゅるっ……！　あんっ、んん……\n！　チンポ、好きぃ……♪　んじゅるっ、ぐちゅっ！　ぐっちゅっ！」", "NORMAL" ]},

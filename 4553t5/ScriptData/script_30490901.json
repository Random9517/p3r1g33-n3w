		{"command":[ "SETIMAGE", "0", "still_00004909_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「フフ……そんなに良かったか。それなら、またたまになら……こういう服を\n着てするのもいいな。また、脅されるのはごめんだが……」", "NORMAL" ]},

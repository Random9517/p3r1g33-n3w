		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あッ！　あああああっ……！　あーしも、あーしもイッちゃううぅうっ！　\nイクっ……！　んああああああっ！　潮ッ、潮吹いちゃうぅううっ！」", "NORMAL" ]},

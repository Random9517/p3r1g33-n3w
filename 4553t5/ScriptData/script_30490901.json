		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「そーだよ、じゅるっ♪　ここに……オマンコにチンポ入れて欲しいのぉ。一\n番奥までぇ……！　っぐちゅっ♪　ぐっちゅっじゅるっ♪　れろれろれろっ」", "NORMAL" ]},

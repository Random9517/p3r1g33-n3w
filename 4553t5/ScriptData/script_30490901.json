		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「すまないぃっ！　あッ♪　気持ち良すぎて我慢ができなかった、あっ♪　君\nの目の前で、も、漏らして……んぁああっ！　あっ、君も射精中だったなっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「お詫びにいくらでもかけてくれっ……あっ！　君がザーメンをシャワーのよ\nうに降り注がせて、わ、私は股間から大量に潮を撒き散らしてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「とんでもない大惨事だ、でもっ……！　あぁっ、止められないっ！　お漏ら\nしして、精子浴びるのが気持ち良すぎておかしくなりそうだ！　っはぁあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んっ、ぉっ♪　おっ、おぉっ♪　このザーメンの強烈な臭いぃっ♪　制服が\nシミになるほど飛んでくる精子っ……あぁっ、君の本気汁を感じるぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903405" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あんっ☆　あーしの制服ぅ……！　ヌルヌルになってくよぉ！　真っ白なあ\nっつい精液っ……！　びゅるっびゅるるってかけられて……イッくぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「はぁっ♪　あぁああっ……。はぁ、はぁ、はぁっ……。んん……、い、いつ\nまでも快感の余韻が抜けん……。君も同じだろう……？　はぁっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……ギャルのふりをして、頭をからっぽにしながらプレイするというのは…\n…思ったよりも刺激的だったな。正直クセになりそうな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「本当にストレスが溜まった時には、またこうして君に付き合ってもらうとす\nるかな？　無論、君がイヤでなければの話だぞ？　だって、なあ……」", "NORMAL" ]},

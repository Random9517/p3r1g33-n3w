		{"command":[ "SETIMAGE", "0", "still_00004909_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あっ♪　おいひぃっ……んじゅるっ！　じゅるっ、じゅるぅっ……！　ごく\nっ♪　このネバネバが、おクチに絡みついて……めっちゃイイよぉおっ☆」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んん……んんんっ、ぴちゃっ、れろ……ちゅるっ、ちゅるるっ……。んふふ\nふっ、いっぱい出たねぇ……♪　と、すっかりギャルになりきってしまった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あぁ……。床をびしゃびしゃにしてしまったな。あ、もう少しそのままでい\nてくれ。今、チンポを綺麗にしてやるからな。……ぺろっ、れろ、れろ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0903308" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……ん。こんなところか。はぁ、はぁ……。私も、年甲斐もなく興奮してし\nまったが、君も君だ。２度目の射精でこんな量を出すだなんて……」", "NORMAL" ]},

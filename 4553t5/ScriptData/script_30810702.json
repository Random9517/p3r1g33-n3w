		{"command":[ "SETIMAGE", "0", "still_00008107_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、もっと左右に大きく……は、はいっ、んっ、んふんっ、エッ\nチにお尻を振るのっ、や、やりますっ、あっ、あふぅんっ！」", "NORMAL" ]},

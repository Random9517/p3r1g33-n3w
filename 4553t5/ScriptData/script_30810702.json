		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「自由が効かなくなってるところにっ、はぁぉっ！　ずんってっ……おちんち\nんっ、響くぅっ……！　はっ、ひぃんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「あぁ……生のおちんちんっ……おまんこっ、めり込むっ……ずりずりっ、あ\nっ、中……擦れてるのっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704113" ]},
		{"command":[ "SETIMAGE", "0", "still_00008107_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、はっ、あぁんっ……勢いよくっ、突かれるとっ……あっ、揺れ\nるっ……おっぱい……ゆさゆさしちゃうのっ、はぁんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「んふっ、おっぱい……揺れるのっ、エッチに見える……？　んふぁぁ……そ\nんな、言わないで……恥ずかしいことぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704115" ]},
		{"command":[ "SETIMAGE", "0", "still_00008107_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「だって……止まらないのっ、隊長さんのおちんちんの勢いがすごいからっ…\n…パツンってされる度にっ、身体……跳ねてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704116" ]},
		{"command":[ "SETIMAGE", "0", "still_00008107_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「あっ、んぅっ、くぅんっ……エッチな声出ちゃうのっ、止められなくてっ…\n…おっぱいも……ぷるぷるさせちゃうのっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、こうやって……乱暴にされちゃうのがいいなんて……私……変\n態さんなのかな……はぁ……んっ……でもぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「後ろからだと……すごく気持ちいいとこに、いっぱい当たるからぁ……あん\nっ、おちんちんっ、おまんこの弱いとこグリグリするからぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「はひっ、それっ、そこぉっ、そこ好きっ……！　あんっ、おちんちんが抜け\nて……も、もう一回入ってくる瞬間がっ……すごく……気持ちいいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704120" ]},
		{"command":[ "SETIMAGE", "0", "still_00008107_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「うんっ、ふっ、はぁっ……手の自由が効かないの……あぁっ、ドキドキする\n……ダメ……抵抗できないで……おまんこされちゃうなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_081_0704121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「あぁっ、中……ぐちゃぐちゃにされたら……ひゃっ、ふぁっ……お汁……ど\nんどん溢れて……床にこぼれちゃうっ……んくぁっ！」", "NORMAL" ]},

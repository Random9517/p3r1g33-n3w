		{"command":[ "SETIMAGE", "0", "still_00008107_02_01" ]},
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「あっ、隊長さんっ……あぁっ、後ろ手に……んっ、ああっ、掴んで……あっ\n、でも……そんな感じが……いいかもぉ……あっ、んぅぅぅんっ！」", "NORMAL" ]},

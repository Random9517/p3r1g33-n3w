		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、あんっ、あぁっ……わ、私からもお尻を振るの……？　う、\nうん……こ、こういう風に……したら……いい？」", "NORMAL" ]},

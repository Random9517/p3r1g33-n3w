		{"command":[ "PLAYVOICE", "v2_081_0704109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「うん……動かして、欲しい……あっ、あぁっ、あんっ！　おちんちんっ、突\nいてっ、あひっ、あぁんっ、そこぉっ……！」", "NORMAL" ]},

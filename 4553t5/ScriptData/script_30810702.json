		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「はぁぁ……後ろから犯される感じ……あふぁ……ゾクゾクするの……んっ、\nこうして組み敷かれてぇ……」", "NORMAL" ]},

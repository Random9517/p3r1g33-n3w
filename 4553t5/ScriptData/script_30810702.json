		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "アヌビス" ]},
		{"command":[ "SETTEXT", "「あぁぁ……んっ、大きい……こんな……はっ、立ったままだと……いつもよ\nり……圧迫感があって……ん、くぅぅ……息が苦しくなりそう……」", "NORMAL" ]},

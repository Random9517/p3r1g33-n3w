		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んぁぁぁぁっ……！　あっ、お尻っ……熱い精液っ……ビュルって……掛か\nってっ……はぁんっ、イ、イクぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204401" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ……中出しじゃないのに……オチ〇ポもう抜けてるのに……まだ、オ\nマ〇コに挟まってる感じが……んくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「ふぁっ、あぁっ……ダメ……出るっ……！　はぁぁ……んっ、潮吹きしちゃ\nうっ……はぁぁ……オマ〇コ緩んじゃってる、んふぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204403" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んふぅ……貴方のにおいが……周りに立ち込めて……あぁん……染み込んで\nいく……私の細胞に塗り込められていくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「まだ少しだけ残ってる……？　それなら、お尻に直接……オチ〇ポを擦り付\nけて……全部出しきって欲しい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204405" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ……はぁぁんっ……あぁ、お尻……ヌルヌルする……はぁ、はぁ\n……ザーメン漬け……中も外もいっぱい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204406" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「はふ……全部出した……あぁ……やっぱり、私の疼きを鎮めてくれるのは、\n貴方のオチ〇ポしかなかった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「はい……ブラックヴァルキリーのアリーヤは、たくさんオマ〇コしていただ\nけて……本当に幸せです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「これからも、欲望に忠実なブラックヴァルキリーとして、貴方のオチ〇ポに\n尽くし続けることを誓います……」", "NORMAL" ]},

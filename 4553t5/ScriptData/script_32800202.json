		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「後は……オ、オチ〇ポのおねだり……はぁ、はぁ……ここに、発情した……\n濡れ濡れのオマ〇コにオチ〇ポを下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204107" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「ずっと、貴方のオチ〇ポに埋めてほしくて……オマ〇コが……こんなにぬか\nるんでいるんです……どうか、奥までずぶって貫いて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「はっ、あぁぁっ、あっ、くぅぅぅんっ……！　あぁっ……オチ〇ポっ……入\nって来てるっ、くぅっ、んふぅぅぅぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204109" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ……入った……根元まで全部埋まってる……くぅぅぅん……あぁ……\n熱いのいっぱいで……これ、すごい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204110" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んっ……はぁぁぁ、太い……ゾクゾクするぅ……このオチ〇ポがずっと欲し\nくて……疼かせてたんだぁ……あぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「中が広げられている感じがする……はぁぁ……んっ、硬いオチ〇ポが、私の\n奥を開発してるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「その……中はどうだろうか……？　私のオ、オマ〇コ……緩くなったりして\nいないだろうか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204113" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「そ、そうか……それなら、いいんだ……分かっている……ちゃんと、オ、オ\nマ〇コ……締め付けるから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「もっと、中を掻き回して欲しい……恥ずかしく濡れたオマ〇コを……奥の奥\nまで……いっぱいぐちゃぐちゃにして欲しい……はぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204115" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んっ、うんっ、んくぅっ、はぁぁぁっ……！　あっ、あぁんっ！　激しいの\nっ、来たっ！　中っ、ズリズリっ……擦れてるぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ、そうだ……これを待ってたっ……！　このオチ〇ポにされてる時が\n……一番気持ちいいからっ、あっ、はぁんっ、あっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁっ、四つん這いの……獣のような格好で……あぁっ、中を好き放\n題にされる感じ……堪らないっ……くぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204118" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んんっ、突き込みに合わせて……中……締め付ける……や、やってみる……\nんふっ、んんっ、あっ、はっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「で、出来てるだろうか……？　あぁっ、奥……オマ〇コの奥に届いた時に…\n…力を……はっ、い、入れて……んふっ……！」", "NORMAL" ]},

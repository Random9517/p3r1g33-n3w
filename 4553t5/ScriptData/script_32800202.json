		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んひぃぃぃぃぃっ！　また……中……来てるっ……！　熱いザーメンっ……\nいっぱいにされてるぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204301" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ……イクっ……ずっとイってる！　あぁっ、種付けされてっ…\n…オマ〇コ……イッてるぅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204302" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「あぁ……中……いっぱいにされてる……もう入り切らないのに……まだ、ど\nんどん溢れて来るぅ……漏れて来ちゃう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んぁっ、あぁっ、そんな……出しながら……まだ、オチ〇ポ突いて来てる…\n…イ、イってる途中なのに……はぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ……精液が垂れてしまう……繋がってる隙間から……汁がポタポタ、\n溢れるぅ……んっ、ふぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……あぁ……射精……すごかった……中出しアクメ……続けてさ\nせられて……まだ全身が震えてる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204306" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……気持ちいい……もう、このオチ〇ポから離れられない……こ\nれさえあれば私は……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「はい……たっぷり躾けていただきました……欲求不満のオマ〇コ……たっぷ\nり満足させていただけて……アリーヤは幸せです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「自分の気持ちに素直に……それが黒衣に堕ちることなのだとしたら……決し\nて悪いことではない……そう教えてもらったから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「はい……どうか、これからもブラックヴァルキリーとして……私の身体を隅\n々まで……たっぷりと開発して下さい……」", "NORMAL" ]},

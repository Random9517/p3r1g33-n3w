		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んふぅ……はぁ、はぁ……そうだ、身体が……疼いてしまってる……貴方の\n調教通り……私の身体は、貴方のオチ〇ポなしでは生きていけなくなった……\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204102" ]},
		{"command":[ "SETCHARA", "0", "char_00028002_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「もう、それを隠すつもりはない……欲望まみれと笑われても構わない……貴\n方の太いオチ〇ポで……私のオマ〇コを、か、可愛がって欲しい……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「ほ、本当か……！　ああ……何でも言う通りに……あっ、手を……拘束……\n動けなくさせて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204104" ]},
		{"command":[ "SETCHARA", "0", "char_00028002_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「こ、この格好で……四つん這いになれと……わ、分かった……こうして……\nベッドの上で……頭を下にするんだな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204105" ]},
		{"command":[ "SETCHARA", "0", "char_00028002_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「もっと足を開いて……こ、これでいいだろうか……あぁ……この姿勢は……\nはぁ、全部……見せてしまってる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_280_0204106" ]},
		{"command":[ "SETIMAGE", "0", "still_00028002_02_02" ]},

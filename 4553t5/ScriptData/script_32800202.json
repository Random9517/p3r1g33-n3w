		{"command":[ "SETIMAGE", "0", "still_00028002_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アリーヤ" ]},
		{"command":[ "SETTEXT", "「んぅぅぅ……ぞわぞわする……か、感じるぅ……オチ〇ポの形が全部分かっ\nてしまう位……大きさを感じるぅ……」", "NORMAL" ]},

{
	"scriptCommands" : 	[
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00000328_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev003_28b_0000", "ev003_28b_0023" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3"]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETCHARA", "0", "char_00000328_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "SETTEXT", "「さてと、どうしてこんな状況になっているのか、あんたには心当たりしかな\nいよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804101" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETCHARA", "0", "char_00000328_01", "6", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「あんたのことを拘束してすることといえば、ひとつしかないよ。今回のこと\nについて、納得のいく説明をしてもらわないとね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETCHARA", "0", "char_00000328_01", "7", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「………………。なんだい、あたしと目をあわせようとしないだなんて、よほ\nどやましいことがあるのかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETCHARA", "0", "char_00000328_01", "0", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「それとも黙秘を貫くつもりか。ふん、そういうことなら、こっちにだって考\nえがあるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "SETTEXT", "「よいっしょっと。あんたが口を割るまで帰すつもりはないからね、このオチ\n〇ポを責めさせてもらおうか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「おやおや、なに勃起させてるんだい。自分が置かれている状況をわかってな\nいんじゃないかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「こんなにガッチガチにして……。んっ、なにを期待してるんだか。まあ、あ\nんたのオチ〇ポをかわいがってやるのも、久しぶりだからね……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_05" ]},
		{"command":[ "SETTEXT", "「ん……っ！　ほらどうだい？　こうされたかったんだろう？　あたしのオマ\n〇コに、オチ〇ポが根元まではいったよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_04" ]},
		{"command":[ "SETTEXT", "「ふふっ、情けない声がもうでてるじゃないか。まだ動いてすらいないってい\nうのに、オチ〇ポがビクンビクンしてるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それじゃあオマ〇コでこいつをしごいてやろうか。気持ちよすぎて頭がおか\nしくなっても知らないからねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev003_28b_0000", "ev003_28b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「んっ、んんっ、ほらほら、どうだい。んくっ、オマ〇コをぎゅっと締めて、\n腰を振って……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「なかもうねって、オチ〇ポに絡みついてきてたまらないだろう……？　んん\nっ、オチ〇ポが反応しているのが伝わってくるよ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、なんだい？　最初からトばしすぎだって？　んふっ、当然\nだろう、こっちはあんたを責めているんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「オチ〇ポめちゃくちゃにしごかれて、んっ、あんたの腰もガクガクいってる\nじゃないか。ふふっ、気持ちよくてたまらなそうだね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「ほら、もっと、根元から先端まで丹念に、オマ〇コでしごきあげてやるよ…\n…っ！　ああんっ！　腰を思い切り、打ちつけながらね……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「キツキツのオマ〇コに、オチ〇ポがもってかれちまいそうだろう？　そんな\nうめき声をだしてもやめてあげないよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そもそも、あたしが聞きたいのはそんな声じゃなくて今回の作戦でどうして\nあたしを外したのかって説明だからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「黙ってばかりじゃ、いつまでたっても終わんないよ！　んっ、んくっ、それ\nとももっと激しい責めをお望みかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「オチ〇ポもなかで膨らんで……っ！　ああっ、オマ〇コのなかで、爆発しそ\nうになってるね……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ああっ、ああっ、なんだい……もう、イキそう……？　射精しそうだって…\n…？　はぁっ、はぁっ、それなら……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "SETTEXT", "「……っと、射精なんかさせるわけにいかないね。ここで中出しなんかさせた\nら、ごほうびになっちまうだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、射精しそうになったオチ〇ポ、寸止めで焦らしてやるよ……んんっ\n、ほらまた、こうやってしごいて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ああんっ、オチ〇ポを、ぎゅっとオマ〇コで締めあげて……っ！　んふっ、\nああっ、またビクビクしてきた……精液がこみあげてきてるのかい……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だけど残念。射精はおあずけだよ。イキたくてもイかせない。射精したかっ\nたら白状することだね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、ほら、どうなんだい。今回の作戦のこと、ちゃんとあたしに説明しな\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ、だめだめ、イかせないよ。またオチ〇ポがイキそうになったら、オ\nマ〇コ緩めて、腰も止めるからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「そして、また腰を動かして……っ！　あんっ、寸止めしてるから、オチ〇ポ\nがどんどんおおきくなってく……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「なかで、ビクビクって暴れまくって……っ！　はぁっ、はぁっ、あんたもも\nう、限界なんじゃないかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「観念しな。あんたがあたしに、敵うはずないんだからね！　ほら、ほら、ど\nうだい？　あたしに言うことがあるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「違うよ、『射精させてくれ』だなんておねだりに興味はない。そんなおねだ\nりであたしが言うこと聞くとでも？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "SETTEXT", "「ほら、あたしの言うとおりにしないと、一生射精できない寸止め地獄だから\nね！　んっ、ああっ、それでもいいのかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あははっ、やっと観念したみたいだね。それで……ふ～ん、あたしが暴走し\nそうだから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そうかい、暴走ねぇ……。暴走っていうのは……こういうことかい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「はぁっ！　はぁっ！　まったく、人のことなんだと思っているんだい！　頭\nにきたからこのまま精液を搾りとらせてもらうよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ちょうどあたしは暴食の幹部って役らしいからね！　なら、お仕置ついでに\n精液を搾りつくしたって問題ないね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「あああっ、ほら、またこみあげてきて、イクんだね、んっ、イッちまいな。\nさんざん焦らしたオチ〇ポ……射精して……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW", "WHITE" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_09" ]},
		{"command":[ "SETTEXT", "「あああぁぁぁああぁぁあぁ～～～～っ！！　き、きたっ、いきなりぃいいぃ\nぃ～～～～っ！　んぐっ、すごい量……注がれて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ああっ、ああっ、塊みたいな精液がっ、んんっ、あたしの子宮に注がれてる\n……っ！　はぁっ、はぁっ、たまんないね……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「こんなに、ドロドロ……っ！　んんっ、たっぷり焦らしたせいで、量もすご\nいね。オマ〇コから逆流してきてるじゃないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_07" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。思わずあたしも、イッちまったよ……。ふふ、だけどね\n……こんなもんじゃないだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_07" ]},
		{"command":[ "SETTEXT", "「あたしのこと、作戦から外した理由についてはわかったからね。今度はそれ\nについて贖罪してもらわないと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev003_28b_0000", "ev003_28b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「んっ、んふっ、またこうやって、腰を……あんっ、動かしまくって……。あ\nあっ、オチ〇ポはまだまだ元気じゃないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんなに射精したのに、あたしのオマ〇コのなかでまだまだガチガチのまま\nで……んっ、反省してないみたいだね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「なんだい、もうでないだなんて。弱音を吐けばあたしが許すとでも思ったの\nかい？　そんなわけないだろう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「泣こうがわめこうが、あたしが満足するまで射精してもらうから、覚悟しな\n……っ！　んっ、あああっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、あんたの上でまた腰を振ってやれば……んふっ！　オチ〇ポは嬉しそ\nうにビクビクしてるじゃないか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「本当は、こうやってお仕置されたくて、わざとあたしをのけ者にしたんじゃ\nないだろうね？　んっ、この変態っ、どうなんだいっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、言い訳する余裕もないくらい、情けない声で喘いじゃって\nるじゃないか。その声、そそるね……もっとあたしを愉しませな！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほらほら、もっとオマ〇コを締めて……っ！　どうだい、オマ〇コにしごか\nれて、オチ〇ポが引っこ抜かれそうだろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、オチ〇ポがますます勃起して……膨らんできて……っ！　ああっ、\nまた射精しそうになってるみたいだね……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「やっぱり、でるんだね。こうして、激しくオマ〇コでしごいてやれば、まだ\nまだ精液だせるんだろう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、だすんだよ！　あたしへのお詫びとして、キンタマが空っぽになるま\nで精液をだしまくるんだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「はぁっ、んんぅっ！　オチ〇ポがさっきよりもガッチガチに硬くなってきて\nいるじゃないか……ああぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「バッキバキの勃起オチ〇ポが、あたしのオマ〇コをごりごりって刺激して…\n…っ！　はぁっ、ああっ、気持ちいいよ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたのうめき声も、ああっ、最高にあたしのことを興奮させてくれるね…\n…っ！　それっ、もっと、オチ〇ポしごいて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「さっさと、だしちまうんだよっ！　ああんっ！　このオチ〇ポから、さっき\nみたいな濃厚ザーメン、吐きだすんだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ああっ、あたしもまた、イキそうだよ……っ。んくっ、射精寸前のオチ〇ポ\nがっ、んんっ！　先っぽまでパンパンに膨らんでるからね……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしの子宮までっ、はぁっ、はぁっ、亀頭が届いて……っ！　ああっ、も\nうイキそうだよ……あんたのオチ〇ポと、一緒にね……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「ああっ、ああっ、イク、イク……ッ！　あんたもイクんだよっ、詫びザーメ\nンたっぷり射精しながら……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だせ、だせ、だせだせだせぇっ！　あたしにっ、ザーメンたっぷり味わわせ\nながらイけぇえええぇぇぇっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_12" ]},
		{"command":[ "SETTEXT", "「あはぁあああぁぁぁああぁぁ～～～～っ！！　でっ、でてるっ！　ザーメン\nたくさん……っ！　中出しぃいいぃぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「いいっ、イクッ、オマ〇コがイッて……っ！　ああぁっ！　子宮にまた、精\n液びゅくびゅくだされてイク……ッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ああぁぁっ！　なかも、うねってる……っ！　射精しているあんたのオチ〇\nポを、ぎゅうぎゅう搾ってる……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_11" ]},
		{"command":[ "SETTEXT", "「あんたがだしてるザーメンを、一滴残らず搾りとろうとしてるんだからね…\n…っ！　んぁっ、はぁっ、はぁ……ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「まだでるんだね……。んっ、んんっ、搾ればしぼるだけだせるってことかい\n？　ああっ、ほらほら……こうやってさ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_10" ]},
		{"command":[ "SETTEXT", "「射精したあとのオチ〇ポに、んんっ、やさしく腰を振って、労ってやれば…\n…ほら、なかでまた勃起してきた……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ。まだ射精させるつもりかって？　当然だろう？　あたしはまだまだ\n満足しちゃいないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、一応あたしは暴食の幹部なんだろう？　だったらこうやって、あんた\nのオチ〇ポを貪りまくっても仕方ないよねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、まだまだこれから。あたしの子宮がパンパンになるくらいは射精し\nてもらうから覚悟しな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたの立場って言うものを、この機会にきっちりわからせてやるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804310" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_15" ]},
		{"command":[ "SETTEXT", "「ああっ！　しまった、オチ〇ポが抜けて……っ！　ああっ、ああっ、精液が\n……身体にぃいいぃぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あああぁぁぁああぁぁあぁ～～～～っ！！　二度目なのに、なんて量……っ\n！　あたしに、ぶっかけるなんて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_14" ]},
		{"command":[ "SETTEXT", "「オチ〇ポからすごい勢いで、はぁ、はぁ、精液が吐きだされて……っ！　身\n体中、あんたの精液まみれになっちまうよ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ドロドロのザーメンまみれで……んくっ、匂いもすごいね……ああ、なんて\nいやらしい匂い……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_13" ]},
		{"command":[ "SETTEXT", "「こんなにあたしのことを汚すなんて、お仕置する理由が増えちまったじゃな\nいか。わかってるよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふ、だめだ。逃がさないよ。それにあんたのオチ〇ポは、お仕置されたそ\nうに勃起したままじゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「まだまだキンタマに精液が残っているってことだろう？　ふふっ、言ったは\nずだよ、空になるまでだしてもらうってね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000328_02_10" ]},
		{"command":[ "SETTEXT", "「ほら、またオマ〇コにオチ〇ポがはいっていく……っ！　んんっ、今度はち\nゃんと、中出ししてもらわないとね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「今回の作戦、あたしは途中参加なんだ。正直、暴れたりないんだよ。誰かさ\nんのせいでね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしはあと何回イけば満足するか……ふふっ。暴食の幹部役なんだ。底が\nないかもしれないよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2804410" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "LABEL", "END" ]},

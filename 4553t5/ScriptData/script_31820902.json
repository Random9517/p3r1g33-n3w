{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_01" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んふふっ……おはようございます♪　どうしたんですか？　そんな驚いた顔\nをしちゃって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904101" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ああ、覚えてないんですね？　ほら、お買い物を一緒にしたじゃないですか\n。その後、ご休憩で一緒にホテルに入って……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904102" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ちょっとイイコトをして……ほんのちょっと寝ちゃったんですよ。ああ、本\n当にちょっとですから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「それで……ふふっ、今……ですか？　はい、一休みもできましたし、そろそ\nろ続きをしちゃいましょうか～っていう感じで♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904104" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はい、今のわたし……女王様の気分なんです。だからぁ……ふふ……こうし\nてさすってあげて……ほぉら、あっという間に勃起がすごいことに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「こんなに大きくさせたオチンポ……もちろん放っておくなんてこと……出来\nませんよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904106" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「大丈夫です。わたしがちゃーんとリードしてあげますから……という訳で…\n…失礼しまぁす……あっ、ふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁぁぁぁぁぁぁん……あぁ……オチンポ……んっ、オマンコの中に\n入っちゃいましたぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904108" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、どうですか……？　さっき、あなたにも準備を手伝ってもらいまし\nたから……ヌルヌルで……一番深いところまですぐ届いちゃいました……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904109" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……太い……ふふっ、わたしのオマンコ……ぐぐっと押し広げて\n……すっごくいやらしく絡みついちゃってます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほら……繋がってるところ……見えちゃってますか？　オマンコの割れ目が\nヒクヒクしてるの……分かりますよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904111" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「とってもいやらしい眺め……見てて、興奮しちゃってますよね……？　んふ\nっ……切なそうな顔しちゃってますものね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904112" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ、もっと……激しく腰を回して……あんっ、はぁっ……んっ……しっか\nりオチンポ……食い込ませて行きますから……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふ……どうしました？　もう余裕のないお顔をしちゃって……まだ、始ま\nったばかりですよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904114" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほら……しっかり腰に力を入れて……よーく、オマンコを味わってみて下さ\nい。ふっ、はっ、んふっ、あっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904115" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あらぁ、何だか……ここが……寂しそうにしてますねぇ……ほら、この可愛\nい乳首……えいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、ビクってしましたね？　男の人も、ここはとっても敏感な場所……\nちょっとコリコリして……しこってますねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904117" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ちょっと強めにぎゅうってしたら……んふっ、ごめんなさい、ちょっと痛か\nったですか？　それとも、乳首イジメられるの……好きだったり？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「だって、オチンポは分かりやすくビクってしちゃいますもんね……こんな風\nに上から伸し掛かられて、一方的に責められて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904119" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「こんなされるままにされて、恥ずかしくないんですか？　んふっ……それと\nも、もうオマンコに夢中で、余計なことを考えられなくなってますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「まぁ、わたしとしてはどっちでもいいですよ。遠慮なく、この勃起オチンポ\nを責めさせてもらいますから……うんっ、はっ……あっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904121" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はんっ、んふっ、ほぉら……すりこぎみたいに……腰を回すの……大股開き\nでいやらしい……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「しっかり目に焼き付けて下さい……わたしのオマンコが……たっぷりオチン\nポを頬張って、ズボズボさせてるところぉ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あんっ、はっ、あっ、ふっ……あぁ……まだすぐに出しちゃ駄目ですよ？　\nもし、今射精したら……ちょっとお仕置きを考えないといけませんから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904124" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ、んぁっ、んんっ……！　そう……しっかり踏ん張って……オ\nチンポを硬くさせたままでいるんです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「そしたら、わたしが……たっぷり使ってあげますから……あんっ、あぁっ、\nオマンコ……いい感じです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904126" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ、またご褒美に乳首……してあげますねぇ……んふふっ、わたしの乳首\nもイジメたくなってるんじゃないですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904127" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「でも、まだお預けですよ……？　今日は、わたしが女王様なんですから……\nあなたは、何でも言うことを聞かなきゃ駄目なんです……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「でも、言うことを聞いたら……それだけ、最高にオチンポを気持ちよくして\nあげますから……んっ、あっ、あぁんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「そうっ……ですっ……すごく……いい感じっ……うくんっ、もっと……激し\nくしちゃいます……ねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904130" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はんっ、あっ、あぁっ、ズコズコっ……腰を上下に振ってっ……あぁんっ、\nいっぱいオチンポ食べちゃってますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904131" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「うんっ、んんっ……んふっ……あらあら、喘ぎ声が大きくなってきちゃいま\nしたよ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904132" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「もしかして、もう射精しちゃおうとしてますか？　もうちょっとだけ我慢出\n来ませんか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ……腰の勢いを弱めれば……？　それは駄目です♪　だって……女王\n様はもっと気持ちよくなりたいんですから……あっ、んふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904134" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほら……んっ、ズボズボしちゃいますよっ……このまま、もっと本気で……\n激しくっ、あっ、はっ、あぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904135" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んぁっ！？　あっ……しゃ、射精……っ、始まってっ……んくぅっ、中にっ\n……びゅくびゅくっ……あふっ、出て……ますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904136" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「予告なしで……いきなり中出しなんて……いけない人……んふっ……でも、\nそれだけ我慢できなかったってことですよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904137" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「出しちゃったものは仕方ありません。そのまま、ぴゅっぴゅし続けて……わ\nたしの子宮に……赤ちゃんのもと……届けて下さいね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んはぁ……ふぅ……んっ♪　ふふ……熱いです……オマンコが温泉の中につ\nかってるみたい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904139" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……あぁ、気持ちいい……女王様プレイ……ハマっちゃうかも知れま\nせんね……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「さて……いっぱい出してくれましたけど、まだオチンポ……元気いっぱいみ\nたいですね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904201" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「わたしも……軽くイキましたけど……まだ、正直物足りないと言いますか…\n…もっとオチンポが欲しいです……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「その目……ふふっ、あなたも、まだ女王様の命令を期待しちゃってるって表\n情ですね……じゃあ、そのまま続き……しちゃいましょうか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904203" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、ほら……今度はあなたからも、しっかり腰を突き上げて見て下\nさい。乳首……また、カリカリしてあげますから……あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904204" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んぁっ、ふふっ！　その調子ですよ……もっとオマンコをグリグリして……\n中に入った精液をぐちゅぐちゅにかき混ぜてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んふっ、聞こえますよね？　オチンポとオマンコが精液まみれにな\nって……グポグポすごぉく、下品な音……させちゃってます……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904206" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、ふっ、あぁっ、ほら、隙間からじゅぽっとお汁も漏れて……はぁぁん\n……なんてスケベな光景なんでしょう……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「こうなったら、もう止まらないですっ……うんっ、ふっ、はっ、あなたの腰\n振りに合わせて……クネクネさせますからっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あんっ、はんっ、あぁんっ……いいです……あぁん、オマンコいいっ！　オ\nチンポいっぱい擦れてっ、オマンコ気持ちいいですぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904209" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んふふっ、また乳首……してあげますからね？　もう一段強くぅ……ぎゅう\nっと……ふふっ、少し痛かったですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904210" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「れろ……ぴちゃ……じゃあ、舐めて……中和してあげますから……ぴちゃ、\nんっ、ちゅぷ……ふふっ、本当に敏感な乳首……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904211" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「恥ずかしくないんですか？　こんなにコリコリにさせて……好きなようにつ\nままれて……エッチな声を出しちゃって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「でも、そうされるのが好きな変態さんなんですから……仕方ありませんよね\n？　ほら……またオマンコの中でオチンポが大きくなってます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁっ、んふっ……仕方のない人です……ほら、わたしに合わせて動\nきなさいっ、オマンコ気持ちいいって言うんですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_0904214" ]},
		{"command":[ "SETIMAGE", "0", "still_00018209_02_06" ]},

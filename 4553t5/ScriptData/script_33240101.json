{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00032401_01" ]},
		{"command":[ "SETANIMRANGE", "0", "ev324_01a_0000", "ev324_01a_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「クロノストライダー翼、見参した。どういった用向きだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103101" ]},
		{"command":[ "SETCHARA", "0", "char_00032401_01", "7", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「親交を深めるスキンシップ……？　何か意味があるものなのか、それは？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103102" ]},
		{"command":[ "SETCHARA", "0", "char_00032401_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「任務を円滑にする……それは、私のこれまでの働きが円滑ではなかったとい\nうことか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103103" ]},
		{"command":[ "SETCHARA", "0", "char_00032401_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「そうではない……？　では、何も問題はないということでいいのだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103104" ]},
		{"command":[ "SETCHARA", "0", "char_00032401_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「もっと私を知る必要がある……私にはその必要性を感じないが……話はそれ\nで終わりなら私は戻るが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103105" ]},
		{"command":[ "SETCHARA", "0", "char_00032401_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「……これも任務？　身体を触れ合わせて、快感を引き出す……ふむ、命令と\nいうことか。それならば、そうだと言えばいい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103106" ]},
		{"command":[ "SETCHARA", "0", "char_00032401_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「パイズリフェラをして欲しい……それが命令だな？　承知した。それならば\n、すぐに手筈を整えよう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103107" ]},
		{"command":[ "SETCHARA", "0", "char_00032401_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ふむ……こうして、ペニスを取り出して……私の乳房で挟む……この形でい\nいのだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103108" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「む……色々と違うことがある？　すまないが、私の知識で不備があるところ\nがあるかも知れない。より具体的に指示を出してくれるか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ペニスではなく……チンポ……乳房ではなく、おっぱい……呼称を変えろと\nいうことか。承知した」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「それでは、貴様のチンポを、私のおっぱいでパイズリし……フェラは……フ\nェラチオだったな。つまり、口で刺激してやればいいのだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103111" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「心得た。それでは……む……？　まず舌を伸ばして、チンポの先端を舐める\n所から……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103112" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「色々と指定があるのだな……いや、それが命令ならば従わない理由はない。\nんむっ、ちゅぷ……ちゅ……れろ、んりゅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ふむ、先端を刺激すると、震えるようだな。この刺激を積み重ねると快感が\n蓄積して、射精に至ると……そういう仕組みか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103114" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ならば、もっと……れろ、んちゅ……んりゅっ、れろ、えろ……んれる……\nれりゅぅぅ……れる……れろぉ……れろぉんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「舌を見せつけるように……？　つまり、貴様に舐めている所がよく分かるよ\nうにしろということだな……れろ、こうか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103116" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「れろぉ……れろ……んっ、れろ……そうだな、特に難しいことはない。れろ\n、ひと手間掛かるというくらいのものだ……んちゅぷ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103117" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「たっぷり先端を濡らしたら……今度はおっぱいを押し込んでみる……ふむ、\nこういう感じでどうだ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103118" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ぎゅっと押し込むといい……左右のおっぱいを交互に押し付けるとよりいい\nと……ああ、情報は多いほうがいいからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103119" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「実践すると……こういう……ことだな？　んむ……ふっ、はっ、んんっ……\nんふっ、ふっ、んむ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「どうだ……？　順調に進んでいるか？　もう少し感情を込めて……？　感情\nとは……具体的にどういうことだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103121" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「何となく気分を出す……抽象的だな……とにかく、おっぱいを擦りながら…\n…舌を這わせればいいか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103122" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ぴちゃ……ちゅぱ……んちゅぷ、ちゅぱ……んちゅぷ……ぴちゃ……んちゅ\nぅ……れろ、んれりゅ……れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「そろそろ咥えて欲しい……ふむ、咥えて……それから、チンポの先端を吸い\n上げる……じゅるるっ、んちゅうっ、こうか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103124" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ちゅぅぅぅ……んちゅぅ……ふむ、声が少し上擦ったな……腰も小刻みに震\nえて……かなり、感じているということか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ならば、このやり方を続けていくからな……んっ、りゅぷっ、ちゅぶっ、じ\nゅぽっ、んぷっ、じゅぱっ、じゅるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103126" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev324_01a_0000", "ev324_01a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「音が響くと興奮度が高まる……？　そういうものなのか……だが、音を殺す\nより、ずっとやりやすい……んじゅるっ、じゅぷっ、んちゅうぅぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んふっ……顔を……激しく上下させながら……んりゅぷっ、じゅぽっ……同\n時に、おっぱいも……動かしていく……んふっ、じゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「少しコツがいるな……だが、んっ……慣れれば……んっ、じゅぷっ、ちゅぱ\nっ、口とおっぱいを両方動かすことができる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んっ、じゅるっ……今のところが感じるのか……？　分かった……ならば、\nこうして……んちゅっ、ちゅぷっ、んちゅうぅぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んむっ……汁が少し出てきたな……なるほど、射精の準備段階というやつだ\nな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「後は、もっと勢いをつけて……貴様の高揚感を……維持し続ける……んふっ\n、あんむ、りゅぷっ、じゅるるつ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「飲ませたい……んっ、承知した……貴様の精液を飲む……次の目標がそれだ\nな……じゅるっ、じゅぷっ、んちゅぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103133" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「あと少しか……分かった、私の方はいつでも大丈夫だ……遠慮なく……射精\nするがいい……じゅるっ、んじゅぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んんんんっ……！　ふぶっ……んっ、んぐっ、こくっ、んんっ……出てきた\nな……んむ、こくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103135" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_10" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んっ……味……？　特別な味はしない……少なくとも美味いものではないな\n……んじゅるっ、かなり粘液質なのは……分かる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103136" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んくっ、飲みにくいという程ではない……じゅるっ、んちゅぅぅ……なるほ\nど……快感と共に出しているのだな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「表情が物語っているからな……ちゅるっ……どうやら、やり方は間違ってい\nなかったようだ……じゅるっ、んちゅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んっ、ぴちゃ……れろ……ちゅぱ……最後に、後始末か……ちゅぷ、ちゅる\nっ……こんな感じか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「うむ……私の唾液が残っているのはすまないが……それは、また後で拭わせ\nてもらおう。それで大丈夫だな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103140" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「何、まだ任務は終わっていない……？　ふむ……どうすればいいのだ。続け\nて……連続射精させるのが決まり……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103201" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「なるほど、一発出した程度では満たされないということか。では、続けてパ\nイズリフェラをすればいいのだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103202" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「多少変化が欲しい……？　変化というのは……やり方を変えろということか\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103203" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「パイズリに、もっと変化……乳首を擦り付けてみる……ふむ、こういう感じ\n……か？　んっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んっ……おぉ……これは、独特な……刺激があるな……つまり、私の身体も\n徐々に敏感になっているということか……んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103205" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「そして、チンポに乳首が当たると、貴様も感じやすくなるということだな…\n…んっ、ふぅ……はっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103206" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「単調にならないように、しゃぶる方も……か。分かった……舌も休まずに使\nっていく……じゅるっ、ちゅぶっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103207" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「精液の味……？　そうだな……確かに、少しその臭いが残ってはいるが、そ\nう気になることはない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103208" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「少なくともイヤなモノではないからな……心配には及ばないぞ……もっとペ\nースを上げていく……んじゅるるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103209" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「じゅるっ、じゅぽっ、くちゅっ、んじゅぅぅぅっ……派手な音を鳴らす方が\n……興奮するんだったな……じゅるっ、じゅぷぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103210" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev324_01a_0000", "ev324_01a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「少しだけ……その感覚を理解した……んっ、じゅぱっ、はぁんむ……りゅぷ\nっ……若干だが……私の身体も熱を帯びているようだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「この状態で……また乳首を押し付ける……んむっ……！　あぁ……この感覚\nは心地いいな……悪くない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「もっと、チンポを刺激してやろう……じゅるっ、んちゅぷっ、このフェラと\n……パイズリと……どちらがいいんだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103213" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「組み合わさるから最強……なるほど、違いない……このまま最後まで高めて\n行けばいいのだな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「はむぅ……ちゅぶっ、もごっ、んふっ、ぐぽっ、じゅぽっ、ずりゅっ……！\n　かなり……感覚も掴んで来たぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「チンポを……咥えながら……同時に……パイズリっ……んじゅるっ、じゅぷ\nぅっ……して……んふぅ……はむ、じゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「あぁ……さっきと同じだ……チンポが震えて……射精が近づいているようだ\nな……？　じゅぷっ、んじゅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「出し方にも……ちゅぷっ、注文があるのか……？　構わない……んじゅるっ\n……じゅぷっ……また指示を出せっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「どんな形でも問題なく対応してみせるからな……んじゅるっ、さあ……もう\n限界の筈だ……じゅぷっ、チンポ……らせっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103219" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「じゅぷっ、射精だ……射精しろっ……じゅるるっ、チンポっ……思いっきり\n……出せぇっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んむっ……！　ふっ、ぶっ……また……出てきた……んぐっ、こくっ、んん\nっ……口内射精……２発目……んんっ、んぐっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「さっきよりも……勢いがついて……んんっ、なるほど……確かに……これで\nは１回で終わりとはならない訳だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「こく……んんっ……少しずつ飲まないと……むせてしまいそうだ……んぐっ\n、ゆっくり……んく……んっく……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ふはっ……んむ、これで……終わりのようだな。ようやく勢いが落ち着いて\nきたようだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103304" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「じゅるっ……ずっと震えているな……それに、蕩けた顔をして……射精とい\nうのは、そこまで気持ちいいものなのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「私にしてもらうから、こんなにもよかった……？　なるほど、そういうもの\nか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103306" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「いや、特に照れるとか……そういうことはないな。だが、任務の達成感は相\n応にあると言っていい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「チンポをイかせるコツというものか……それを掴んだ気がするからな。また\n、して欲しい……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ふむ……そういう任務ならば、また命令を出してくれ。より、完璧な任務が\nできるように、努力しよう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ああ、もっとチンポを蕩けさせるようなパイズリフェラをしてみせよう。ん\n……もっと違うもの？　それは、また別に指示を貰わなくてはな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「口を離せ……？　どうした急に……んっ……んむっ……！　顔に掛けるのが\n……任務だと……？", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103401" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_24" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んっ、はぁ……そういうことは、もう少し余裕を持ってから言ってくれ。危\nうく飲むところだっただろう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「何……？　飲むのは別に構わないのか……顔に掛けつつ、飲ませたいと……\n注文の多いことだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103403" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「まあ、それが命令であれば、従わない理由はない。貴様が私の上官であるこ\nとに違いはないのだからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103404" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「んふ……出し切ったか……んっちゅ……この後はどうすればいいのだ？　ま\nた、チンポについた精液を舐めて綺麗にするのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103405" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「心得た……ぴちゃ、ちゅぷ……れろ……んちゅぷ……れる……れろ……れろ\nぉ……もう続きはしないのだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「もう力も半分失っているようだしな……ちゅぷ……後は、少し癒やすような\n動きがいいということか……れる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103407" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「命令以外のことでも、それが最適だと思えばするさ……ちゅぷ……ちゅる…\n…んちゅ……こんなものでどうだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103408" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「ふむ……よかったか。ならばいい。忠実に任務を果たせたかどうかは、私に\nとっては重要なことだからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103409" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "翼" ]},
		{"command":[ "SETTEXT", "「またして欲しい……その時は、改めて指令を出してくれ。相応に対応しよう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_324_0103410" ]},
		{"command":[ "SETIMAGE", "0", "still_00032401_01_23" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
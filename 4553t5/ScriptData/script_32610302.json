{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00026103_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev261_03b_0000", "ev261_03b_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「いらっしゃいませ、ご主人様。ふふっ。ちゃんと２週間、射精を我慢できた\nみたいですね。えらいですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304101" ]},
		{"command":[ "SETCHARA", "0", "char_00026103_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「え？　もう限界だから、早く貞操帯を外して欲しい？　はあ……人に物を頼\nむ時は、言葉もですけど、相応の態度というものがありますよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304102" ]},
		{"command":[ "SETCHARA", "0", "char_00026103_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「そもそも学園祭での話を聞いて、ぜひ自分もご奉仕されたい、とおっしゃっ\nたのはご主人様ですよ。もうお忘れになったのですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304103" ]},
		{"command":[ "SETCHARA", "0", "char_00026103_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「あらあら……土下座しながら必死に頼み込むなんて、無様すぎてあきれ果て\nてしまいますね。はあ……まあいいでしょう。鍵を外して差しあげます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304104" ]},
		{"command":[ "SETCHARA", "0", "char_00026103_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「貞操帯を外した瞬間、こんなに勃起して……相当精液を溜め込んでいるみた\nいですね。軽くおっぱいを動かしているだけでも分かりますよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304105" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「えっ？　なんですか？　もっと早くおちんちんをシゴいて、イカせて欲しい\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「どうして私がそんなことしなければいけないのです？　それにこれは、ただ\nおっぱいを押し付けてあげているだけです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「パイズリしながら射精させてくれるんじゃないのかって……私、鍵を外して\n差しあげるとは言いましたが、射精させてあげるとは言っていませんよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「何でもするから、射精させて欲しい？　はあ……私言いましたよね。人に物\nを頼むときは相応の態度があるって……ご主人様なら、分かりますよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ふふっ！　おっぱいのゆったりとした動きに合わせて、ヘコヘコ腰を振りな\nがら射精のおねだりをするだなんて、ものすごく惨めで無様ですねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ですが、まだ足りません。誰に何をして欲しいのか、ちゃんと言ってくださ\nい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ほら……うらら様の柔らかくて大きなおっぱいで、限界寸前な軟弱おちんち\nんをシコシコして欲しいですって言ってください！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「あははははっ！　本当に言うなんて、情けないご主人様ですね！　哀れすぎ\nて、涙が出てきそうです！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304113" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「はぁ……とても面白かったです。笑わせてくれたご褒美に、パイズリだけで\nなく、フェラチオもして差し上げます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304114" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ですが、勝手にイクのはダメです。私が１０から０まで数を数えますので、\n０になったら射精してください」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「もし守れないようなら、きつ～いオシオキが待っていますので……頑張って\n耐えてくださいね。では、始めます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ちゅるっ……じゅ、ぢゅぶぶっ……じゅ～うっ……んっ、ちゅ、ちゅぐっ…\n…んっ、ちゅるぅぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304117" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev261_03b_0000", "ev261_03b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「きゅ～うっ……んぐんぐっ、じゅ、ちゅぱぁっ！　ずずずっ……れろっ、ち\nゅ、じゅろっ！　くちゅうぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぐっぷっ、じゅっぷっ……ぢゅぶぢゅぶっ、じゅっ……んぷっ？　なんれふ\nか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「数を数えりゅのが遅い気がしゅる？　ふふっ……数えりゅペースは、私が決\nめりゅというルールですからねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んっ、くぷっ！？　おちんちんが膨らんできてます……！　ふふっ……必死\nに射精を我慢ひているの、分かりますよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「れは、カウントを進めていきまふね……じゅるるっ、ちゅ、ちゅぱぁ……ん\nっ、んっ……じゅる、は～ちっ……ちゅちゅ、ちゅぐぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ちゅぱっ、じゅぞぞっ！　じゅるるっ……ちゅ、ぢゅるっ！　な～なっ……\nちゅちゅ、ぞぞぞっ、じゅぞぉ～～～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んっぷっ！　じゅぶじゅぶっ！　れりゅ、れろろっ！　ちゅ、ちゅぱっ！　\nろ～くっ……んっ、我慢ですよっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ここで出ひたりゃ、二度とエッチなことしてあげまへんかりゃね？　それが\n嫌なら、ちゃ～んと我慢してくらさいっ。ちゅ、ぢゅぢゅ、れろぉ！」」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ちゅ、ずずずっ……んぷっ！　くっぶっ！　ご～おっ……んっ、じゅるっ！\n　ふふっ……ここかりゃ、動きを速めますねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んっ！　んっ！　ぢゅ、ぐちゅっ！　じゅぱっ、ちゅぞぞっ！　にちゅ、ぐ\nじゅるっ！　んっんっ、よ～んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304127" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ちゅ、じゅぞぉぉ～～～っ！　れりゅるっ、ちゅちゅ、ずりゅうぅ！　さ～\nんっ……ふふっ。あとすこしれふよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「おちんちん、お口の中れビクビク跳ねへまふっ……エッチなお汁も、びゅー\nびゅー出てまふよっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぢゅぶぶっ、んっぐっ！　じゅぞっ、じゅるるっ！　に～いっ……ちゅぱち\nゅぱっ、ずっ、んっぶっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「れろろっ、れろぉ！　舌でおちんちんの先端をグリグリしながら、おっぱい\nでシコシコされるの……たまりゃないれふよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「くぷっ、ぢゅぶっ！　早く数えて欲ひいんですか？　仕方ないれふねっ……\nぞぞっ、ぢゅ、ぢゅぢゅるっ！　い～ちっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぢゅちゅ、じゅっ、んっぶっ！　おちんちん膨らんれまふっ……もう出そう\nなのを、必死に堪えてりゅの、分かりまふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ほらっ……もう少しれふよっ……じゅるっ！　我慢、我慢っ……ぢゅ、ぜ～\nっ……んっ！　ちゅちゅ！　んぐっ、じゅぷぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ちゅばっ、じゅぱぁっ！　ぜ～っ……んぶぅっ！　ぐちゅ、んんっ！？　お\nちんちんが激ひく暴れへ……！？　じゅ、ぢゅぶっ！　んぶぅ～～～！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304135" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んっ、ぢゅるっ！　じゅるぅ～～～っ！　せーし出てまふっ！　お口にょ中\nに、いっぱいどっぴゅんしゃれてまふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304136" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_06" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「あははっ！　我慢れきなかったみひゃいれふねっ！　私、まだゼロって言っ\nてないれふよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304137" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「それなのに、こんらにも出すらんて……ご主人様はおちんちんの我慢も出来\nない、最低な人らったんれふねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ふふっ！　情けない射精らのに、気持ひいいんれふか？　ああ……哀れなそ\nの姿、しゅごく可愛いれふっ……じゅ、ぢゅるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ほりゃ、よわよわおちんちんから、敗北ザーメンいっぱい出ひていいれふよ\n！　全部、飲んであげまふっ……んぐっ！　ぢゅ、じゅぷふぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「くぷっ……ぢゅ、あっぷっ……お口にょ中が精液れいっぱいれふ……んっ、\nぢゅ……じゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304201" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ふふっ……約束しまひたかりゃ、ちゃんと飲んであげまふ……よ～く音を聞\nいておいてくらはいね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304202" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んっぐっ……んっ、んっ……こくっ……ごくっ……ごっくんっ！　んふぁぁ\nぁ……ご主人様の敗北せーし、ごちそうひゃまれふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304203" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「……あれっ？　よわよわおちんちん、まだ勃起ひたままですね。さすがに２\n週間射精を我慢ひたらけあって、元気れふね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304204" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「えっ？　なんれふか？　次は絶対に我慢しゅるから、もう１回挑戦さへて欲\nひい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「いいですよ。私も、先ほどはカウントが遅かったでしゅし……今度はちゃ～\nんと、いちまで早く数えてあげまふねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「れは、いきまふよ……んっちゅっ！　じゅるるっ！　ちゅ、ぢゅっぷっ！　\nじゅ、ちゅちゅちゅっ！　じゅ～ぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304207" ]},
		{"command":[ "PLAYANIM", "0", "ev261_03b_0000", "ev261_03b_0023", "true", "ALL" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぐっぶっ！　れろろっ、れろっ、んべろぉ……ちゅ、ぞぞっ！　きゅ～うっ\n……ふふっ。出ひたばっかりらから、キツそうれふねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「れも、責めを緩める気はありまふぇんよ……は～ちっ……んっ、じゅぞっ！\n　こうひて、おちんちんの割れ目のとこりょをホジれば……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぐちゅ、じゅぐっ！　ちゅっぷっ、ぢゅぶぶっ！　な～なっ……ぞぞっ！　\nぐちゅ、じゅぐりゅっ！　ぞぞっ、じゅぞぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「敏感なとこりょを刺激ひゃれて、おちんちんが暴れへまふねっ！　ぢゅ、ち\nゅぶっ！　ろ～くっ……ちゅ、ちゅくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぺろぺろっ、れろっ、じゅろぉ！　先っぽらけじゃなくへ、皮にょ隙間も舐\nめまわしゃないと……ぐちゅちゅ、じゅ、じゅるっ！　ご～おっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「よ～んっ……ぢゅ、じゅぶっ！　んっ、んっ！　ぢゅ、んっぷっ！　さ～ん\nっ……ぢゅぢゅ、ぢゅ、ぞぞぞぉ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「に～いっ……ふふっ！　もうぜろはすぐそこれふよっ……ぢゅ、ぞっ！　お\nちんちん、ちゃ～んと我慢ひてくらはいねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ちゅぶっ、じゅぶぶっ、んっぷっ！　ちゅ、じゅるぅ！　くぷくぷっ、ぢゅ\nぶっ、じゅるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「い～ちっ……ぢゅ、ぢゅっ！　れろっ、ぢゅ、ぢゅぞぉ～～～っ！　ぜ～っ\n……んっ、ぢゅるっ！　じゅぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぜ～っ……んちゅろぉっ！　ちゅちゅ、ずっ、じゅぐぐっ！　ふえっ？　な\nんれぜろって言ってくりぇないのかっへ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「あははっ！　そ～んなに最後の数字を言って欲しいんですかぁ？　どうしま\nしょうかぁ～……じゅるるっ！　んっ、んっ！　んっぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぐむっ！？　んむぅっ！　おちんちんが我慢できないって言ってまふっ！　\nまたお口にょ中れ膨らんれっ……ちゅぶぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304219" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ちゃんと最後の数字を言ってあげまふかりゃ……我慢、我慢っ……ぢゅ、じ\nゅぞぞっ！　にちゅ、ぐちゅっ！　ずっ、ぷっ！　んっ……ぜ～っ……ろっ！\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んむ～～～～っ！？　ぐっ、うっぐっ！　まひゃ精液がお口にょ奥にどぴゅ\nどぴゅしゃれへまふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「２週間熟成させたらけあって、２回目らのにしゅごい量れふっ……！　それ\nに勢いもしゅごくへっ……んぐぐっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304302" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ぢゅ、ちゅごっ！　ま、まひゃ全部飲んで欲ひいんれふか？　いいれふよ…\n…ちゃんと我慢れきたご褒美れふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ご主人様の濃厚ザーメン……全部飲んであげまふっ……んっぐっ！　こくこ\nくっ……ぐっ、じゅるるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んっ……んっ……ごくごく、ごっくんっ！　ちゅ……じゅるるっ……ちゅぷ\nぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304305" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んふぅ……喉に絡みつくくらい、粘り気のある精液でした……飲みすぎて、\nお腹が苦しいです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304306" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ふふっ……たくさん射精できてよかったですね、ご主人様っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ですが、１つだけダメなところがあります……何だか分かりますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304308" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「それは私との約束を破ったことです……私、０になったら射精してください\nと言いましたよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「約束も守れないご主人様には、オシオキをさせていただきます。ふふっ……\n簡単ですよ。また２週間ほど、貞操帯をつけるだけですから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「んぷぅっ！？　ち、ちょっとっ！　どうして許可もなくおちんちんを抜いて\n……きゃあぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00026103_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「か、顔にかけないでください！　０になったら射精していいとは言いました\nが、顔にかけていいとは一言も……んっ、あぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ご主人様のザーメンで汚されてます！　こんなよわよわおちんちんのザーメ\nンを浴びせられるだなんてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ふっ！　あっ、はぁぁっ！　こ、こんなことをして許されると思っているの\nですか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「くぅっ……！　私の話も聞かずに、気持ちよく射精をして……！　そんなご\n主人様には、パイズリを続行しますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ほらっ！　ほらっ！　どうですかっ！　射精中におちんちんをシコシコされ\nるの、たまらないですよね！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ！　んっ、ふぁぁっ！　こ、このままありったけのザーメンを吐\nき出させてあげます……！　んっ！　あぅっ！　ぜ、全部出してください！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「……ようやく落ち着きましたか。どうやら我慢させすぎて、頭が性欲に染ま\nったようですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「ふふっ……ですが、ご主人様を更生させるのもメイドの務めです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "うらら" ]},
		{"command":[ "SETTEXT", "「そういうことで、ご主人様にはまた、貞操帯を着けてもらいます。ふふっ…\n…嫌がっても無駄ですよ、ご主人様っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_261_0304410" ]},
		{"command":[ "WAITINPUT" ]},

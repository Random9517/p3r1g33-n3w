{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0092" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……ん……。なぁに？　お兄さん。今、ちょっと忙しいから後にして。……\nえ？　別に機嫌悪くないし。疲れてるっていうか……。んー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304101" ]},
		{"command":[ "SETCHARA", "0", "char_00016603_01", "4", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「せっかく海に来たのに、お兄さんは他のコたちとずいっぶん楽しそうにして\nるみたいだし。日焼けしちゃうし、もう帰っちゃおっかなーって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304102" ]},
		{"command":[ "SETCHARA", "0", "char_00016603_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「お兄さんってオンナ心がわかってないとこあるよね。……いいけど。そうい\nうわけだから、ゴメン。ばいばーい……。って、な、何っ？　きゃっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304103" ]},
		{"command":[ "SETCHARA", "0", "char_00016603_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ひゃんっ！？　ちょ、ちょっと！　ビックリするじゃないぃっ！　ん……？\n　ゴソゴソゴモソモソして、何？　なにやってんのって！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304104" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「も……もしかして、私のこと脱がそうとしてる……？　いつもからかわれて\nばっかりだから、今日は俺の番だ……ってな、なによソレ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「私もう帰るって言ったんだけど……。って、あんっ！？　お、おっぱい触っ\nたぁ？　あっ……、ち、乳首、敏感なの、急にいじんないでぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「な、なによ、なによぉ……。さっきまでぜんっぜんかまってくんなかったく\nせに、いなくなろうとしたらこんなことしてさぁ……。って、んっ？　ンッ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ん、うぁあああああっ！？　あッ……？　あっ？　う、ウソでしょっ……？\n　えっ？　あっ？　わ、私がおっぱいに気を取られてる隙に……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304108" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あっ！？　お、オチンチンオマンコに入れちゃってるじゃないぃいっ……！\n　な、なんで今だけそんなに強引なのぉおおおっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……んぁっ♪　んッ、ふっ……？　ふぅっ？　ふーっ、んぅうううっ……？\n　きょ、許可してないのに、……あっ、こ、腰動かさないでよぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304110" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あっ！？　あっあっ、やぁっ……！？　あっ、ぁっ、あんんっ……！？　ま\n、まだ濡れてないのにぃ、一番奥までずっぷり挿入してくれちゃってるしっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……ひんっ！　んんっ、んぅ～っ……！？　い、いつもはそんなことしない\nじゃない！　……あっ♪　だ、だから私にナメられてたんだって……あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ぼんやりしてて、されるがままなところがお兄さんのカワイイとこなんじゃ\nんんっ……！　あっ、でも、でもっ、確かに他のコにもぼーっとしてっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304113" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「誰にでも声かけられたらついてくとこは、い、イヤ、だったけどっ！　だか\nらって……あっ、せ、せっかくこっち見てくれたのに即エッチとかっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「嫌じゃ、ない、けどぉっ……！　ホントにビックリしてっ……！　あぅうっ\n♪　心臓、バクバクしちゃってる、……あっ♪　本当にお兄さんなのっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「別人のなりすましじゃ、ないよねぇっ……？　大胆すぎっ……あっあっあっ\n♪　んぐぅうっ……。こ、このオチンチンのカタチはお兄さん本人っ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304116" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ふ、太さも、熱さも、長さもぉ……お兄さんの、だ、けど……ひぁあんっ！\n　お、怒ってるから？　すごいビキビキでいつもより怖いぃ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304117" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「イカつくてゴツいオチンチンになってる気がするぅうう……！　あっ♪　…\n…へっ？　私の中、オマンコ、ぐちょぐちょに濡れてきてる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……うぁ……♪　そ、それは……知らないぃいっ！　か、勝手にそうなっち\nゃってるだけっ！　デリカシーなさすぎ！　ばか、ばか、ばかばかぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304119" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「突然、無防備なアルマちゃんオマンコにオチンチン入れといて……んぅうっ\n♪　全力で腰ふっといて、そ、そういうの言わないでよぉ、恥ずかしいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「んんんんっ……！　そ、そうよ、不意打ちで無理やりされて、……はうぅっ\n！　正直感じちゃってる、す、すぐイキそう、イッちゃいそぉ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304121" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「お兄さんのくせにズルいじゃんんっ……！　たまに男らしく攻めてくるなん\nてぇっ！　せ、攻めるのはっ、い、イジメるのは私の役目、なのにっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「逆転なんか許可してないしぃいいっ……♪　んんんんあっ♪　そ、それやめ\nてっ！　どちゅんって強く奥っ、一番奥ぐちゅんってするのだめっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「そ、それっ……それ本当にイッちゃうからっ……！　……んんぁああああッ\n！？　イクっ！？　イク……っ、イクイクイクぅっ……やぁああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304124" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「お、お兄さんなんかに襲われてイカされちゃうぅっ……！　あぁあああんっ\n、く、悔しいぃいっ！　イックぅうううっ！　イきゅぅううっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304125" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ひ～～っ♪　ひぃっ♪　あぁんっ♪　イッ♪　イッてるのにっ、あっ、フル\nスピードっ……！　あぁっ、なにコレめっちゃくちゃ気持ちいいぃっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「っあぁんっ♪　あぁんっ、あんっ！　あんっ！　イクぅううっ！　お兄さん\n、お兄ひゃんんっ！　イクっ……も、もぉ私イッたからぁあっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「イッてるから、オマンコイジメないでぇっ……！　あぁんっ♪　わ、ワルい\nコだったの認めるからぁっ！　あっ！　あっ、オチンチンしないでぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304128" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……そ、そうっ！　他の女のコたちに嫉妬、したのっ……！　あんっ！　ヤ\nキモチッ……やいて！　すねたらこっち見てくれるかなって思ってぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「わざとつまんなそうにして……、あっあっあっあっ♪　気を引きたくて冷た\nくしたのぉっ！　私がお兄さんイヤになるわけないじゃんかぁああっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あっ！？　あぁっ、ふぅっ、ああああっ……♪　あぁッ♪　あぁんっ、あっ\n、あぁっ、イ、イジワルしてごめんな、さいぃ……っ！　あっ、あぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304131" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「私がいけなかったのわかったからっ、謝るから……あっ！　私だけ見てっ、\n私とずっとエッチしてっ……！　あっあっ、お兄さん、お兄さぁん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「お願いぃっ……！　この水着、お、お兄さんのために選んだのっ……！　だ\nから水着のまま、もう１回お兄さんに射精されたい、してほしいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「出してっ♪　ねっ、いい子にするからっ！　私のオマンコに出してっ！　び\nゅーしてっ！　お願いっ、おねがいお願いぃいいっ……あっあっあぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304134" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「だめ、だめぇっ……！　イッちゃうっ、本気でイッちゃううぅうっ！　あっ\n、あぁあああっ！　お兄さん！　お兄さんイッちゃうよぉおおっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304135" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あ～～～～～っ♪　あっぁっあ～～～っ♪　んぁああああ～～～っ♪　お兄\nさんんっ♪　イッた瞬間に精液注ぎこむのは反則でしょぉおおっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304136" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_07" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「はひぃいいっ♪　ひぃいんっ♪　しゅ、しゅごいいぃっ♪　なにコレぇええ\nっ……！　イクのが終わんない、おっきくイクぅっ！　ッんぃいいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「イイッ、いいのっ♪　お兄さんのオチンチンの先っちょから、あっつい精液\nがドクドク出てるぅううっ、私の赤ちゃん作るところにかかってるぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304138" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あっ♪　絶対受精しちゃうっ♪　こんなの絶対妊娠しちゃうっ♪　熱いっ…\n…熱いぃいっ♪　どぴゅっ、どぴゅって何度も出てる、中に出てるぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あぁんんんっ♪　お兄さんにこんな一面があったなんてぇええっ……！　あ\nっ♪　反撃されるのもイイっ……すっごく気持ちいいよぉおおおっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「っんんんんっ……♪　や、やっと、精子が出るのが終わったぁああ……。お\n兄さん、なんだか今日はスゴすぎ……。射精も長かった気がするぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304201" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「そんなに私をぎゃふんと言わせたかったの……？　はぁ、はぁ……。もうイ\nキすぎて息、うまくできないし……オマンコの中もたっぷたぷ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……ナマイキなアルマちゃんを一方的に襲って、スカッとした？　したよね\n？　でも～……ここからはこっちだって反撃させてもらうからっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「んんんんんっ♪　ほらぁ♪　オマンコ、締めたり、ゆるめたり、締めたり、\nゆるめたりぃ……。こうされると、ぬちょぬちょでゾクゾクするでしょお」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304204" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「お兄さんのオチンチン、ずーっと硬いまんまだし、私に復讐したいなら１回\nだけでバイバイするわけないよねぇ～？　んふふ、期待しちゃうなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「もーっとギッタンギッタンに犯してくれなくちゃ、反省しないもん♪　……\nね？　……ねぇ？　ね～え？　もう１回して？　かっこいいとこ見せて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「私のこと、……あんっ♪　そうっ、そうやって、でっかいオチンチンで黙ら\nせてぇ……♪　ッあぁああっ♪　すっご♪　お腹に響くぅっ、あぁんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304207" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「中出しした精液とぉ、私の出したヌルヌルとが混ざって、オマンコの中……\nぬちゃぬちゃでトロトロで、最高にヌメヌメな状態でしょ……っ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あっ♪　そこにオチンチン突き立てて、オナホみたいに私のこと犯したら気\n持ちいいよっ♪　……なんて言わなくても、もうわかっちゃってるかぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304209" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「すっごい夢中で腰動かしてる、もん、ねっ♪　あっ♪　コレこっちも気持ち\nいいっ♪　中出しされてすぐ、オチンチン動かされるの気持ちいいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あんっ♪　あんっ♪　オチンチンぶっといぃっ♪　あはぁっ♪　私が動こう\nとしても、それよりオチンチンの動きの方が激しくて……無理ぃいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あっ♪　お兄さんのオチンチン、ホントはこんなにスゴかったんだねっ……\n♪　あんっ、私、やられっぱなしになってるっ、それがいいのっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304212" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「大事なオマンコ自由に使われて♪　それなのに、キュンキュンしちゃってる\nっ♪　キツキツオマンコでオチンチンに媚びてるっ、甘えちゃってるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「っあああああっ♪　お兄さんっ♪　お兄さんっ♪　超スゴいっ♪　あんっ！\n　身体が全部熱いっ、燃えちゃうっ♪　オマンコも燃えあがってるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304214" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「突いてっ……もっと突いて♪　めちゃくちゃにしちゃっていいからっ……あ\nぁああんっ♪　アルマちゃんのオマンコにお仕置きしてっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ッくぅううううっ……♪　んんんんっ♪　そ、そこぉ……♪　奥好きぃいい\nっ……！　それにっ、オ、オマンコの入口ぃっ……あっ、あんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「入口オチンチンで拡げられながら、ズンッ♪　って一気に突き上げられると\n意識がトんじゃうくらい気持ちいいっ！　あっ、頭が真っ白になっちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304217" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「もっと……もっと、もっともっとしてっ！　突いて、突いてぇっ……！　…\n…あんっ♪　お兄さん、息がハァハァ荒くなってる、それに身体も熱いよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「オチンチンの動きも速くなってきて……、もう腰止まんないよね♪　精液び\nゅるびゅるしたくなってきたぁ？　あっ、出す、のっ？　出しちゃうのっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「もう１回、抵抗できないアルマちゃんに……あんっ♪　私のちっちゃなオマ\nンコに、生で中出ししちゃうのっ？　してっ、してほしいっ、出してっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304220" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あ～～～～っ♪　出てるっ、出てるぅううっ♪　ありがとぉおおっ♪　中出\nしっ、中出し気持ちイイよぉおおっ♪　またイケちゃうぅううっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「イクッ……♪　イクぅううっ♪　お兄さん好きぃいいっ♪　お兄さんのオチ\nンチンはもっともっと好きぃいいっ♪　ドクッ、ドクッて容赦なく出てる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「これっ、これが欲しかったの……！　ビクビク脈打って、私のオマンコをい\n～っぱいに満たしてくれるたっくさんの精液ぃい♪　あっ、キ、キくぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304303" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ふぁあっ♪　あぁっ……！　やだやだ止めちゃやだっ！　いっぱい出してっ\n……出して、あっあっあっ……！　オマンコで絞りとってあげるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ンッ……んんんん～～っ……♪　はぁうううっ♪　あったかぁいいい～……\n♪　あっ♪　お兄さん、子宮の入口にぴったりオチンチンくっつけて♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304305" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「そこにビューってして♪　……あはぁっ♪　上手ぅううっ、そこっ、そこぉ\nおおっ……！　あっあっ、赤ちゃんのお部屋いっぱいになったぁああ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……んもぉー……！　今日は完っ全にお兄さんにしてやられちゃったんだけ\nど……！　悔しいよぉ～……こんなことってあるんだね～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304307" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ちょっとだけ、見る目変わったかも。あんまりからかってると、たまーにこ\nうして反撃されちゃうのか～。なるほど、なるほどぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304308" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……ん？　激しくしてほしい時はからかって、イジメたい時は優しく近づこ\nう、なんて考えてないよ？　ほーんとだよ♪　信じて……はくれないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ただ、新しいお兄さんを見て、これからどうなっちゃうんだろってトキメい\nてるのは本当♪　お兄さんって刺激的で目が離せなくてくやしーよ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ひぃんっ！？　な、なんでぇっ……！　なんでいっちばんイイとこでオチン\nチン抜いちゃうのぉっ……！　あっぁっうぅっ♪　んぅうっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_13" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ね、ぇっ……！　精液ぃっ……！　精子私の身体にかかってるっ……！　熱\nいよぉっ……！　あっ♪　あっ、火傷しちゃうぅっ……あぁあっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「新品の水着にっ……あっ、ああっ♪　お兄さんの精子の臭いついちゃうよぉ\nっ……！　シミになっちゃうぅっ……！　でもかけてぇっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304403" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ど、どうせお兄さんに見せるための水着だもんっ……！　あっ♪　お兄さん\nの色に染めちゃえばいいじゃんっ……！　やんっ、かかってるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ちゃんと狙ってぇ……！　エッチなところにいっぱいかけてぇ♪　私のこと\n、真っ白にしていいのはお兄さんだけなんだからぁあっ、嬉しいでしょっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304405" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「あ、ありがたく思っていっぱいヌルヌルさせてよぉっ！　……んぅううっ♪\n　ドロドロの精液っ……。あぅっ♪　たっぷり注がれて気持ちいぃっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304406" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……ぁ……♪　はぁ、はぁ、はぁ……。ゴ、ゴメン……。結構気持ち良かっ\nた、から……。精液かけられた後、ぽーっとしちゃってた……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304407" ]},
		{"command":[ "SETIMAGE", "0", "still_00016603_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「こんな風にお兄さんにわからされちゃうなんて、想像もしてなかったからな\nんかくやしー……。水着、一番に褒めて欲しかっただけなのにさぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「ねーねー？　これだけいっぱい精子出したんだから、気に入った？　私の水\n着ぃ……。なあに？　聞こえない。ハッキリ言って。……カワイイ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_166_0304409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルマ" ]},
		{"command":[ "SETTEXT", "「……ん。それなら許す。けど、万が一可愛くないなんて言ったらいっしょー\n許さないところだったんだからね！？　それ、忘れないでよね！　もぉっ」", "NORMAL" ]},

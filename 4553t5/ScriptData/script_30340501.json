{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「よ、よぉ……。悪いな。こんな夜中に呼び出しちまって。そろそろ、この服\n脱ごうと思うんだけどさ、その前に一応、感想聞いとこうかなって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503101" ]},
		{"command":[ "SETCHARA", "0", "char_00003405_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ハハハ、俺がこんな服着てたから、驚いただろ？　ガラにもねえってのに、\nどいつもこいつも隊長に見せろ見せろってうるさくってかなわねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503102" ]},
		{"command":[ "SETCHARA", "0", "char_00003405_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ってワケで、見せたからもういいよな。……は？　に、似合ってる？　バ、\nバカ言え。俺に一番似合わねえ服だろうが。……キレイ、だぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503103" ]},
		{"command":[ "SETCHARA", "0", "char_00003405_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「そ、そ、そこまで……褒められると思ってなかったな。んじゃ礼に……なん\nだ。今夜だけ、隊長の花嫁として、何か言うこと聞いてやってもいいぜ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503104" ]},
		{"command":[ "SETCHARA", "0", "char_00003405_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……で、迷わず要求すんのがコレか。ホンット好き者だよなぁ、隊長は……\n。いや、べっつに全然かまわねえよ？　でも……なんつうか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503105" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺の胸なんか、柔らかくもねーし鍛えすぎてっし……。挟まれたところで、\nそんなに気持ちいいもんじゃねーと思ってさ……。硬いだろ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あぁ？　ハリがあって、スベスベしててイイ胸だぁ？　ずっしり重くて、チ\nンポに吸いついてくるみてぇだぁ？　て、て、てめぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503107" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「言うじゃねえか。ま、まあ、ソッチが気に入ってんならいいけどさ……。あ\nんま褒めんじゃねえよ。……はぁ？　新婚ごっこだからぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「はぁー……。はいはいはい。甘々で、俺が一方的にご奉仕するパイズリフェ\nラってのをして欲しいんだもんな。まったく、甘えてるぜ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「懐かれっとむげにできねぇ俺の性格、知り尽くしてるよな……。ほらっ、…\n…ど、どうだ。隊長の大好きなデカパイで押さえつけてんぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503110" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……んっ……。み、見られながらすんのはなんか、恥ずいけどさぁ。お願い\nされちゃしょうがねえ。最初っから全力でいくぜ？　ん、んっんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「おっ！？　うぉっ、チンポ反応しすぎだろ！　うぉっ、あ、暴れんな！　ジ\nッとしてろっつうの……っ、んん……、や、やりづらいだろが……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503112" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「な、なんかもう透明な汁出てきてっしさぁ……。このドスケベが……。んん\nっ、ズリズリする強さが強烈？　ったりめぇよ、誰にも負けるか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「隊長の、チンポは、俺の、もんだからなっ……。はぁっ、はぁっ……♪　ど\nこが感じっか、どうするとイイか覚えてるに決まってんだろっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503114" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あぁ～？　今日だけは、ダンナさまって呼べぇ？　要求が天井知らずだな…\n…？　誰が言うか！　オラッ、黙ってチンポシコシコされてろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「おらっ……おらっ、我慢汁増えてんぞ？　ったく……俺が世話してやんねえ\nとダメな悪いチンポだぜ……。んん、そろそろ頃合いだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ちゅぷ……くちゅっ、ちゅ、んれろ……っ。んぁ？　溢れてくる我慢汁舐め\nとってるだけだ。安心して身ぃ任せてろ。……れろ、れろ、れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503117" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ごく……。なーに驚いてんだよ。ダンナさまの我慢汁飲むのは、ヨメの仕事\nだろが。れろっ……ぴちゃ、ドンとかまえとけ。ちゅぷ、ぷっちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺、は、最近さらに鍛えてっから……れろっ。こうやって、胸と口をずっと\n動かしてても平気だぜ？　れろっ……。どういう意味かわかるか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503119" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺が疲れるのが先か、ダンナさまがイクのが先か勝負ってこった。……ん？\n　今日は勝負じゃなくてイチャイチャさせろ？　う、げほっげほ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503120" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「イ、イチャイチャとか言うな……。ボ、ボケ……。い、いいから集中しろ！\n　んっ……ん、くちゅ……ちゅぷ、んれろっ、れろ、ちゅぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503121" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あっ、ク、クソ……。すんのに集中してっと、敏感になっちまうな。……ん\nんっ。隊長のチンポ熱すぎんだよ。胸にこすれて、感じる……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ん、……くぅっ、くちゅ……ちゅっぷっ、れるっ、れろ……ごくっ。んん…\n…ンッ、んっ……！　ぐちゅっ、くちゅ、ぐっちゅっぐちゅっじゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……ヤバい。チンポがこすれてイキそうだ……。んむっ、ちゃん\nと洗ってんのか？　臭すぎるだろ……はぁ、あぁ、興奮する……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……んっ、ぅ……♪　んんんっ……！　いつもながらにデカいし、太いし…\n…。おい、腰を揺らすなぁ……っ、んむ、口の奥にチンポ入るっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503125" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んんっ、ぐちゅっ！　ぐっちゅっ、んれろっ……！　じゅぷっ、ぷちゅっ、\nれろっと、レロっ、れろ……ぴちゃっ。んんんむっ、ンンッ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503126" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ぷはぁっ、……んんっ！　ぐちゅっ、ぐちゅっぐっちゅっ……んぉおっ♪　\n胸ぇ、谷間突き上げられっと……んんんっ！　ヤバいから、マジでっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503127" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んっぐっ……♪　ぐっちゅっ、じゅるっ、ぢゅるるるっ……！　っはあっ、\n隊長のチンポ……身体に響くっ……。ぐっちゅっ、じゅるっ、ぢゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あ……あ、や、ヤバイ……！　隊長をイかせる前に俺の、方が……んぐっ♪\n　んむぅっ、ぐちゅっ……疼きが止まんねえ……あぁっ、イクっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んっ、んぐぅううううっ……！　ふぐぅううっ……♪　わ、わりぃ、勝手に\n胸でイッちまって……んぅっ、こっちもちゃんとするから、さぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「隊長も……！　ダ、ダンナさまも、イキたくなったらすぐにイッてくれよな\n。じゃないと、俺ばっかイッちまうからっ……。ん、ぐちゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503131" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ぐちゅっ、ぐっちゅっ！　じゅるっ、ぢゅるるっ！　じゅっぽっじゅっぽっ\nじゅぽっ、ぢゅるるっ！　花嫁なのに下品な舐め方で悪いな……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んんっ！　じゅるぅっ！　じゅっぷっじゅぷっ！　……んぉっ♪　チンポが\n口ン中で膨らんれきたぁ……♪　いいぜぇ、限界まで溜めて出せぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503133" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「隊長のぉっ♪　んむっ、ヨメさんが受け止めてやっから……んぐっ♪　んん\n、じゅるっ……じゅるっ！　一気に絞り上げんぞ？　……んんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ぐちゅっ！　ぐっちゅっぐちゅっ！　ぢゅるぢゅるぢゅるぢゅるぢゅるっ！\n　じゅるじゅるじゅるじゅるっ！　んふぅっ、出せっ、出へぇっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},		
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ンンンンンッ……♪　んぐっ……んぅううっ……♪　ンッ、んむ……っ！　\nごくっ……ゴクッ！　ごくっ、ごくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503136" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ダンナの精液、迷わず飲み干すのは……んんっ、ヨメの愛情……！　ごくっ\n……♪　いいぜ、めちゃくちゃ濃いのがたっぷり出てやがる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「全部……、れんぶ俺のだ、絞り出へよ……っ♪　じゅるっ、じゅるるるっ…\n…！　ごくんっ！　ゴクッ……ごくっ、んっ、んんんん……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ごくっ……！　にげぇ……♪　それにドロッドロで、熱くて……腹が疼く…\n…♪　隊長の精液の味、すっげぇ好きだ……。だからもっとくれよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503139" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んんんんっ……！　んぐっ♪　あは……♪　溺れちまいそうなくらい出して\nくれんじゃねえか。景気が良くて最高だぜ……♪　ごくっ、ごくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……ん、んん！　あ、咳払いなんかしちまってムード無かったか？　あんま\nりにも隊長の……。ダ、ダンナさまの精液が濃すぎて、飲みこめなくてよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「まだ喉の奥で絡まってる感じなんだ。あー……、この臭い。一周回ってホッ\nとすんなあ。隊長の味と臭いだ。……で？　なんだこのチンポはぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503202" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「精液カラッカラになるまで口と胸で絞ってやったのに、出しきってもまだ全\n然小さくならねえな？　これは、俺のご奉仕が足りてねえってことか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503203" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「うーん……。それはそれで……消化不良だな。よし。お互いスッキリしねえ\nのはイヤだから、このままもう１回してもいいよな？　んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んちゅっ……くちゅっ♪　今度は最初っから、舌も使って全開でいくぜ……\n。んれろっ、ぴちゃっ、くちゅっ、ぴちゃっ……じゅるるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503205" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「隊長の、どこまでも凄まじい性欲に最後まで付き合えんのは……ぐちゅっ、\n俺くらいかもしれねえからな。ま、こっちも楽しませてもらうから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「心配すんな。んっ……！　あぁあ……♪　コレコレ、精子まみれの隊長のチ\nンポ、くせぇしヌラヌラしてて舐めにくいけど……んっ、コレがいいんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503207" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んんっ！　胸の方にもっ、あっ……！　塗り広げてさ、滑り良くしてくから\n……。あっ♪　堪能してくれよ、な♪　んじゃ舐め直すぞ♪　んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503208" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ぴちゃっ、ぴちゃ……、んんんっ♪　ぢゅるっ、じゅるるっ……！　くちゅ\nっ！　はぁっ、はぁ、たまんねぇ……この形、この大きさぁ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503209" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺のっ、胸にしっくりくんだよなぁっ……♪　あっ♪　胸動かすとっ……じ\nゅるっ、すげぇイイ感じにこすれて……刺激されて……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「むしゃぶりつきたくなっちまうんだよなぁ……♪　れろっ……くちゅっ、ち\nゅっ。ん？　先っちょペロペロされるのがいいのか？　ぴちゃっぴちゃ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「舌先尖らせて……れろっ、れろっ、れろ……。そこから一気にバキュームっ\n……じゅるるるるっ！　じゅるっ！　じゅるっ、じゅっぽっじゅぽっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503212" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁ……♪　酒に酔ったみたいな気分だ……ぐちゅっ、おい♪　硬\nい胸の感触もしっかり味わえよ♪　んっ、硬くない？　柔らかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あはっ……♪　自分じゃわかんねえよ♪　チンポ、ないからなっ……。ぐち\nゅっ♪　でも喜んでもらえんなら良かった、よっ。れろっ、ちゅっぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「くちゅっ……♪　ちゅぷっ、ちゅぷっ、ぷちゅ……♪　んんっ、くちゅっ、\nちゅぷっ、じゅるっ……ちゅっぷっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503215" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んぷぁ……れろっ、ぴちゃっ、れろ……れろぉっ。俺がやらしい顔してるっ\nて……？　んぁ、隊長も相当だらしねぇ顔してるっつうの……くちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「お互い様、だ、お互い様ぁ……♪　ん、んんんっ……！　じゅるっ、我慢汁\nと俺の唾で、チンポがぐちょぐちょに濡れてる……ぐちゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ん！？　んんっ？　なんだぁ？　もうまた出したくなってきちまったか……\n♪　じゅるっ、じゅるっ……いいぜ、出しまくってくれっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503218" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んぐっ♪　パンパンにチンポ膨れ上がってきてんぞぉ……♪　じゅるっ、ぐ\nちゅっ、しゃぶりがいがある良いチンポだぜ……。んっ、じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「このまま吸い上げるから、思いっきり出してくれっ……！　いくぜ、……ぢ\nゅるるるるっ！　じゅるっ、じゅるるるっ！　出してくれっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},		
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んぷぅっ……！　んぅううううう……！　んぉっ……溢れる……！　じゅる\nっ！　じゅるるるるっ……ごくっ、ごきゅっ、じゅるるるるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503301" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_16" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「飲んでも飲んでも、どんどん出てきて……！　っじゅるっ！　んんんんっ…\n…！　す、すっげぇ量……。んぐぅっ？　んんんんんむ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「隊長ぉお……っ、底なしにも程があんだろうがよぉお……！　んむぅうっ！\n　激しくチンポビクつかせやがって……！　っおふっ、んむっ、むぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「わかった！　飲むからっ……飲むから落ち着いて出せ！　……ん～～～～っ\n、……ごくっ……。ごくっ、んんんんぐっ、……ごくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……つうか一発目に出した精子より、二発目の方が濃いとかありえねぇだろ\nぉ……！　苦ぇ……！　んぐっ……♪　ごくっ、粘るぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503305" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んぐっ……ごくっ、ごく、ごく……っ。う、ぁ……♪　このガツンと来る、\n精子の味ぃい……♪　隊長、ありがとな……っ。ごくっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ふぁああああ……♪　当分精子飲まなくても間に合うくらい、大っ量にごち\nそうになっちまったぜ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503307" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ははっ、隊長も満足したって顔してんじゃねえか。そうかそうか、お役に立\nてたなら光栄だぜ。とか言って、またすぐに溜まっちまうんだろうけど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……この服はもう当分着ねえと思うが、新婚ごっこってのは、……二人の時\nにだったらまたやってやってもいいからさ。いつでも声かけてくれよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「その……なんだ。こんな格好見せた相手が、他のヤツに頼むくらいなら、全\n部俺がしてやるかって。マジで気軽に声かけてくれよな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んむぅうっ！？　うぉっ！？　ま、待てってっ……！　口から外れて……お\nっ！？　おっ、おっ、か、顔にかかってる！　おいおいおいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503401" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_18" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あぷっ！？　んぉっ、ちゃ、ちゃんと狙えよ……！　んぷっ……！　も、も\nしかして狙ってやってんのかっ……！　あっ、く、くせぇっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んんっ、んぐ……うううっ♪　そ、そんなに俺の顔に精液ぶっかけたかった\nのかよ……！　ドロドロのネバネバしたやつが何度もかかってくる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「なんで二発目でこんなに出すんだよ！　……あぁ！？　俺が嬉しそうな顔し\nてる！？　み、見んな！　い、いいだろが別にっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あんまり気持ち良さそうに射精してっから、俺の口とか胸が良かったんだな\nって思っただけだ！　……うぁ！　ま、真面目な話してる間にも！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503405" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ビュービュービュービュー精液放ちやがって……。あ、ぁっ、ヌラつくっ…\n…！　溺れそうなくらい浴びせてくれやがって……♪　このやろぉ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「っはぁ～……。ベッタベタにしてくれちゃって……まいったな。これじゃあ\nもう、今日は店には戻れそうもねえなあ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503407" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「どっちにしろ、こんだけドビュドビュ精液かけられちまったら無理か。どう\nする？　先にシャワーでも浴びるか？　……あぁ？　俺の身体？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「身体がどうした。……奉仕するだけで、疼きっぱなしじゃないのかぁ！？　\nだったら何かしてくれんのか？　もし俺が興奮しまくってたら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0503409" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「そこんとこ、よぉーっく聞かせてもらおうじゃねえか。んん？　甲斐性見せ\nてくれよ？　ダ・ン・ナ・さ・ま？　なんつってな」", "NORMAL" ]},

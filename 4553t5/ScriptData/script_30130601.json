{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0149" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……！　やっぱり、ここに居たんだね……！　んっ……あぅ、\nあぐぅっ……！　ダメ、もう我慢できないっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603101" ]},
		{"command":[ "SETCHARA", "0", "char_00001306_01", "5", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「何の用かって……そんなの、エッチなことをしに来たに決まってるじゃない\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603102" ]},
		{"command":[ "SETCHARA", "0", "char_00001306_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「この姿になってから、ずっと欲求不満で……！　ああ、もうっ！　今すぐ貴\n方のオチンチンが欲しくて、たまらないのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603103" ]},
		{"command":[ "SETCHARA", "0", "char_00001306_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んっ、んんんっ！　オチンチン、どんどん大きくなってるっ……！　もしか\nして、私がエッチしたいって言って、すぐに勃起しちゃったの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603104" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「へぇ～……正直、期待しちゃったんだ。なら、その期待に応えてあげないと\nね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603105" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「えっ？　こんなことするのは、抵抗があるんじゃないかって？　いつもの格\n好なら、少しは抵抗があるんだけどね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603106" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「だけど今はヴァルキリー化してて、抵抗感がまったくないっていうか……貴\n方のオチンチンを味わいたいって欲求の方が、勝ってる感じかな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603107" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「だから、あなたのオチンチンいっぱい味わわせてもらうね……まずは、匂い\nからっ……すんっ、すんすんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ふあぁ、あっ……ふぁぁぁぁっ……とっても濃くて、臭いっ……！　鼻の奥\nが痺れそうな感じなのに、今はそれがすっごく気持ちいいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603109" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「こんなの嗅いでたら、オマンコ弄りたくなっちゃうっ……！　あっ、んんっ\n！　ふっ、はぐっ！　すんっ……すんすんっ……あんっ、臭いよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オチンチンの匂いだけで、オマンコぐちょぐちょになってきちゃうっ……！\n　割れ目に沿って指を擦るの、止まらないのっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「それにクリトリスも、貴方のオチンチンみたいにどんどん勃起してきて……\n私のお豆さん、すっごく大きくなってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603112" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「触らなくても、包皮からピンッて飛び出してきてっ……！　ジンジンして痛\nいのに、その刺激をもっと味わいたくてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あぁっ、ダメっ！　オチンチンの匂いを嗅いでオナニーしてるだけじゃ、全\n然物足りないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603114" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「貴方のオチンチン、お口で味わわせてっ！　いっぱいおしゃぶりして、気持\nちよくしてあげるからぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あむっ！　んっ、じゅぐっ！　んっぐっ、じゅぷっ！　ちゅぱっ、じゅぽっ\n、ぐっぽっ！　じゅるるっ、ぢゅ、ぞぞっ、ちゅぞぉぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603116" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んっ、んんぅ～～～っ！　おいひいっ……おいひいよぉ！　オチンチンの濃\n厚にゃ味が、口いっぱいに広がってぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603117" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ぐっ、ぢゅぐっ……！　に、匂いが直接、鼻にょ奥に届いへっ……！　ふっ\n、おっ、おぉっ！　オマンコの奥、疼いてきひゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「こりぇ、指で割れ目や土手を擦りゅらけじゃダメっ……！　膣内に指を入れ\nひゃり、クリトリスをシコシコしたくなるのぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603119" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オチンチンをしゃぶりながりゃ、いっぱい気持ひよくなりひゃくてっ……！\n　んぢゅるっ！　じゅ、ぞっ！　ぢゅぞぞっ、じゅぷるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ぐぷっ、ぢゅぶぶっ！　れりゅ、れっろっ！　ちゅばっ、じゅちゅぱっ！　\nぐちょ、にちゅっ！　ぐっちゅ、ずずずっ、んぢゅぱぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603121" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オチンチンにょ傘のとこりょ……皮の隙間あひゃりが、特に濃厚れっ……舐\nめてりゅと、舌が痺れてきひゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「裏側にあるスジのあひゃりも、舐めるたびに血管が浮き出へっ……んっ、ぢ\nゅぐっ！　か、感じてくりぇてりゅの、分かるよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603123" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「私の口オマンコれ、オチンチン悦んでくりぇてりゅっ……！　あんんっ……\n！　嬉しくへ、指の出し入れが速まっひゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オマンコをズポズポしゅる動きに合わへて、私にょ頭も動いてっ……！　唇\nれ勃起オチンチンをシコシコしゅるの、止まらないよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んぐぐっ、じゅ、じゅるぅ～！　ぐぽぐぽっ、ぢゅ、ぐっぷっ！　ぢゅぞぞ\nっ、じゅ、ぞぞっ！　ぐちゅ、にぢゅるっ！　じゅ、じゅぞぞぉ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603126" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んっぷっ！　ぢゅっぷっ！　んっ、んんっ！？　な、なぁにっ……？　唇で\nオチンチンをシコシコしながりゃ、吸い付いて欲ひいの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「それとオチンチンの先っぽ……尿道のとこりょを、舌でホジったり、ペロペ\nロひて欲しいらなんてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んっ、いいよっ……尿道の中まれ、しっかりと味わわへてもりゃうねっ……\nじゅるるっ、ぐ、ちゅうぅぅぅ～っ……！　ずっ、じゅぢゅぢゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603129" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んっぐっ、じゅっぷっ！　べろっ、んべろぉ！　ぐりゅ、じゅぐるっ！　ん\nれりゅ、れろっれろっ、んれろっ！　じゅぞぞっ、じゅっぞぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「くっ、んぷぷっ！　先っぽにょところをホジってりゅと、オチンチンがビク\nビクひてっ……！　もひかして、もう出ひゃうにょっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603131" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「い、いいよっ……こにょまま出してっ……！　私もザーメン味わいながら、\nオナニーしたいかりゃっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「それじゃあ……気持ちよく射精れきりゅように、思いっきりしゃぶって、シ\nゴいてあげりゅねっ……！　んぢゅぐっ！　じゅ、ぞぢゅるぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603133" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「にちゃ、んぶるっ！　れぢゅ、れろれろっ、じゅ、ぞぞぞっ！　ずずっ、ぢ\nゅ、にぢゅぐっ！　ちゅぱっ、ちゅばばっ！　ぢゅちゅぱぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603134" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んっ、んっむっ！　イッへっ……オチンチンかりゃ、びゅーびゅーせーしら\nしてっ……！　んんんっ、ぢゅ、じゅぐむぅぅ～～～っ！", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「おっぶっ！？　ぢゅ、じゅぽっ、ぢゅぼほぉっ！？　あちゅいの、いっぱい\nでてりゅうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603136" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「お口にょ中……喉に直接、せーし流れこんれきへっ……！　ぢゅぞっ、んっ\n、んっぐっ！　ごくっ、ごくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「濃厚なザーメンがこんらにっ……！　こ、こりぇが欲しかったにょっ！　オ\nチンチンミルク、ずっと飲みたかったからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603138" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ずずるっ！　ぢゅ、じゅっぞぉぉっ……！　んっぐっ！　んぐんぐっ、ごく\nっ！　んっ、んんっ！　ごくんっ！　ごっくんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「じゅ、ぞぞっ……ちゅ、じゅるっ！　ぷっ、くぷぅ……！　精液飲みながり\nゃオマンコ弄りゅの、気持ちよしゅぎるよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んふーっ、ふーっ！　ふっ、はふぅぅっ……！　ザーメン出してくりぇて…\n…ありがとう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「れも、私はまらイッへなくへ……そりぇに貴方のオチンチンミルク、もっと\n味わいたいにょ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603202" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「だかりゃ……ころまま続けてもいいよにぇ？　もう一回、オチンチン舐めし\nゃぶりながりゃ、オマンコ弄っていいよねっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「気持ちよかったりゃ、まだまだ続けらりぇる？　えへへっ……貴方なら、そ\nう言ってくれりゅと思ってたよっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603204" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「じゃあ、続きしゅるね……ついれに、尿道に残ってりゅ精液も、全部吸い出\nしへあげりゅから……ずっ、じゅ、ぞっ！　ちゅっるぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603205" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ちゅちゅっ！　ずっ、ちゅっぐっ！　ずずっ、じゅ、ぞぞっ……じゅ、れぢ\nゅるっ！　んぷぷっ、くっ、んぷっ……！　ぢゅ、んっぐっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んぱっ……！　ひゃっきよりも、オチンチン大きくなってりゅねっ……！　\n刺激を受けしゅぎて、勃起が止まりゃないの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603207" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あははっ……実は私も、オマンコ弄りすぎてて子宮口が開きてきちゃって…\n…ヌルヌルしたお汁が、ずっと溢れ続けてりゅのっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603208" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オチンチン舐めながりゃオナニーしゅるの、すっごく気持ひいいけろ……や\nっぱり、指じゃ物足りない感じっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「れも、今は精液の味と匂いを堪能したい気分れ……！　うぅぅっ……！　こ\nのモヤモヤした感じが、より性欲を高めてくりゅうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603210" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オチンチンもっひょ深くまで咥えこんれ、ズポズポしたいっ！　思いっきり\n吸い上げりゅから、早くザーメン出ひてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「じゅぞぞぞぞっ！　ぢゅ、にぢゅるっ！　ぐちゅちゅ、じゅ、じゅぽぽぉ！\n　ぢゅばっ、んぢゅるっ！　にちゃ、ぐっぽぽっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603212" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ぢゅうぅぅぅっ……じゅ、じゅるるっ！　んぐっ！　んくっ！　ぷはっ！　\nはぁっ、はぁっ！　オチンチン、お口にょ中れ暴れてりゅよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「早く出したい、射精ひたいって、言ってりゅみたいっ……！　我慢なんて、\nしなくへいいかりゃねっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603214" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「出ひたくなったりゃ、いつでも射精ひてっ……！　私に向かって、いっぱい\n精液どぴゅどぴゅひてぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ぢゅぐっ、んっ！　じゅるっ！　ちゅぱぱっ！　じゅぞっ、れろろっ、んっ\n、じゅろぉ～！　ぢゅぢゅるっ、にちゃ、ぐっちゃっ！　じゅぶふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603216" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ！　ふっ、んっぐっ！　あっ……あっ……！　くりゅっ……私\n、そろそろイッひゃいそうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「オマンコとクリトリス弄りしゅぎて、イクにょ我慢れきないぃっ……！　ぢ\nゅぱっ、じゅぞぞっ！　にぢゅぐっ！　んじゅぱぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603218" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「わ、私と一緒にイッへっ……！　オマンコイクのに合わせて、びゅーびゅー\n射精ひてぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「あっ、ぢゅ、んぢゅるっ！　イッ、クッ……！　じゅ、ぞぞっ……！　イク\nッ……イクッ……！　イッグッ……！　じゅぞぢゅうぅぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603220" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_13" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んぢゅっ！　ぢゅ、ぐっぷっ！　せ、せーし、いっぱいお口に出へりゅっ…\n…！　んっ、んんっ！　やっぱり、この精液美味ひいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「この味を堪能しながりゃイクと、頭の中が真っ白になっへきてっ……！　ん\nぐっ！　ぢゅ、じゅるるっ！　ぐっ、ごくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「全部吸い出ひてっ……一滴残らず、精子飲み込んれあげりゅねっ……！　ず\nずりゅ……ずっ、ぞぞっ！　じゅぢゅっ！　ぞぞぞぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603303" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んぐっ……んっ、ぐっ！　こくんっ、ごくっ……！　んっ、けほっ、けほっ\n！　ぢゅ、ぞっ……んぐんぐっ、ぢゅっぐっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「喉に絡みちゅくくらい、ドロドロれ濃厚な味らよぉ……！　ぢゅばっ、じゅ\nるるっ……ぢゅ、じゅ……ちゅ、ぱぁぁぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ぷはっ……ふぅっ……ふぅっ……いっぱい出ひてくりぇて、ありがとう……\nすっごく美味しかっひゃよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603306" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「れもね……私まら、全然満足できないの……イッたけど、もっとイキたくへ\n、たまりゃないのっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603307" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「やっぱり、オチンチンは上のお口らなくへ下にょお口……オマンコに挿りぇ\nないとっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「だかりゃねっ……今度はこっちで、精液びゅーびゅーひてくれりゅ？　私の\n子宮に向かって、射精してくれりゅ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603309" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「んふふっ……ずっと弄ってたかりゃ、熱々のトロトロらよっ……気持ひよし\nゅぎて、挿れたらすぐに射精しひゃうかもっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ぢゅ、ぱぁぁぁっ！？　あっ、あぁぁぁんっ！　オチンチンが離れてくよぉ\n！　ヤダっ、ヤダぁ！　もっとオチンチン味わいたいのにぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「イキながら精液の味を堪能したかったのにっ……！　こんなに顔にかけられ\nたら、匂いと感触しか味わえないよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ふあっ、あはぁぁぁっ！　で、でも、こうやって顔にかけられるのも、いい\nかもぉ！　貴方のザーメン浴びるの、すっごく気持ちいいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603403" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「貴方に汚されてるだけじゃなくて、貴方の色に染められてる感じがして……\n！　こんな、変態みたいな感じ方するなんてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603404" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ！　もっとかけてっ……！　私の顔、貴方のザーメンまみれにし\nてっ！　ドロドロの精液で、マーキングしてぇ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603405" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「はっふっ……んっ、くふっ……んふぁぁぁっ……ザーメンまみれにされるの\n、最高かもぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「いつもだったら、イヤな感じがしそうなのに……今日は精液まみれにされて\nも、嬉しいって感じちゃうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「これも、ヴァルキリー化の影響なのかな……貴方のオチンチンと精液が、魅\n力的に思えて仕方ないのっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「え……？　貴方自身は、魅力的じゃないのかって？　そ、そんなことないよ\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_013_0603409" ]},
		{"command":[ "SETIMAGE", "0", "still_00001306_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "シルバスター" ]},
		{"command":[ "SETTEXT", "「貴方はオチンチン以上に魅力的で……えっと……だ、大好き、だよっ……」", "NORMAL" ]},

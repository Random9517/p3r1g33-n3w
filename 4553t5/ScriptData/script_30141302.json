		{"command":[ "SETIMAGE", "0", "still_00001413_02_15" ]},
		{"command":[ "SETTEXT", "「あぁ……濃いです……んちゅぷっ、つい味わってしまいます……このドロリ\n　とした子種のエキス……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304403" ]},

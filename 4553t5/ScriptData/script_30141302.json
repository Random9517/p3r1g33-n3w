		{"command":[ "PLAYANIM", "0", "ev014_13b_0000", "ev014_13b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「うんっ、あっ、んんっ、はっ、あんっ、はっ、あぁんっ……！　あぁっ、硬\n　いオチンポ様っ……すごくいいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「これから、腰をいっぱい揺すって……中の襞で、しっぽりと包みこんで……\n　いっぱい蕩けていただきます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んふぅ……もう、くちゅくちゅ……スケベな摩擦音が聞こえて来ます……オ\n　マンコのよだれ……止まらないんです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「あぁん……キスもよろしいですか？　はい、何から何まで欲張りで申し訳\n　ありません……んちゅぷっ、りゅぷっ、んひゅぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「あぁ……これで、またピストンが捗りますぅ……うんっ、んくんっ、はぁっ、\n　粘膜を隅々まで味わっていただきますからぁ……あっ、ふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「んふぅ……いかがですか？　これくらいのペースで、んっ、じわじわ気持ち\n　を高めて行くのがよろしいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「もっと浅ましくオチンポを貪って、すぐに射精いただくことも出来ますが…\n　…私としても、じっくりオチンポをしゃぶらせて頂きたいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はい、ではゆっくり、少しずつ……んっ、このドスケベオマンコをご堪能\n　下さい……おっ、ほぉぉおっ、あぁぉっ、太いのっ、効くぅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「メスの声が、漏れて止まりません……♪　おっふっ……下品な唸りが……\n　あぉっ、止まらなくなってしまいますっ、あぉんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ……もっともっと欲張っても大丈夫ですかっ？　欲しがりオマ\n　ンコが、ずっとウズウズしてっ……止まらないんですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ふふっ、はい……お任せ下さい……オチンポに極上の快感をお届けしますか\n　ら……うんっ、はっ、あんっ、あふっ、あっ、んぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「いかがですか……？　私のオマンコが……貴方のオチンポをぱっくり咥えこ\n　んでいるところ……よーく見えますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ほら……こんな、割れ目がくぱって開いてるところ……そこにオチンポが出\n　たり入ったりしてるところ……いやらしすぎますよねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「クリトリスも……コリコリになってて……んっ、ほら……触ってみて下さい\n　……あはぁんっ！　あっ、腰くだけになりますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んんっ、あぁ……もっと欲しがりになって来ました……オマンコピ\n　ストン……スピードアップしますっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「あぉっ、はぁっ、おぉぉっ♪　オマンコ響くっ！　ズンズンっ、太いのっ、\n　襞をめくってっ、かき混ぜるぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁんっ、そこっ、あっ……私の弱いところなんです……だから……オチン\n　ポの先端で……グリグリ……しちゃいますねぇっ、あひぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「あぁっ……熱いです……本物の生チンポの素晴らしさ……オマンコいっぱい\n　に感じて……お尽くしできる悦びに震えますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「たまらないっ……あぁっ、もっと……ゆさゆさっ、身体を揺らしてっ！\n　おっぱいも、ぷるぷるっ、下品に跳ねさせてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んふっ、くぅんっ、はっ、はぁっ、あぁっ……オチンポがビクって……はっ、\n　ふっ……この感じ……そろそろ……んっ、ふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はい、もちろん分かりますよ。私も……あぁっ、オマンコが蕩けて……イキ\n　そうになっていますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んっ、このままスパートしてもよろしいですか？　ええ……当然、このまま\n　全部中に出していただきますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「私の子宮が……もう、すぐ下まで降りて……貴方のザーメンを待ち焦がれて\n　いますからっ、はっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あんっ、最後のズコズコでっ、イッて下さいっ！　私もっ……一緒\n　にオマンコアクメしますっ、はひぃぃぃんっ！」", "NORMAL" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_12" ]},
		{"command":[ "SETTEXT", "「あぁ……お腹の中で、元気な子種がいっぱい泳いでいますね……貴方との\n　赤ちゃん……楽しみです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304306" ]},

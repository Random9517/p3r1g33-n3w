		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_11" ]},
		{"command":[ "SETTEXT", "「あふっ、あぁ……イク……んんっ……私も……おっ、ふっ……！　絶頂の痺\n　れが……ずっと続いています……顔が緩んでしまいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁ……んふっ、あぁ……打ち止めですか……？　はい……たっぷり出して\n　頂きました……本当にお疲れさまでした」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304305" ]},

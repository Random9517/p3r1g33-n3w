		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んふっ、さっきよりも……大きなストロークで……腰を回して参り\n　ます……あっ、ふっ、はぁぁぁんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「中にたっぷりいただいたザーメンと、オマンコ汁の粘りで、襞が一層いやら\n　しくなっておりますから……あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「この、はしたない味を……もっともっとオチンポ全体で感じて下さいませ\n　……あっ、んっ、ふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「あぁ……もちろん、私の身体のどこを触っていただいても構いませんよ？\n　先程も言いましたが、この身は全て貴方のモノ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「おっぱいも……太ももも、髪の毛も、口の中も……ちゅぷっ、れろ……全部\n　好きにしていただいていいんですから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んはぁ……れろ……もっと、オマンコの方も……本気になって行きましょう\n　か……あっ、おっ、んぁふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「ふふ……私にお任せ頂いていますが、自然に腰も浮き上がるみたいですね\n　……メスを征服したい……オチンポの欲望を感じます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「では、私も負けないように……んっ、メスの本能でオチンポを貪っていきま\n　すから……おっ、ふっ、あぉっ、おぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……熱いです……Ｇスポットも……あぉっ、ポルチオもっ……突かれ\n　れば、突かれるほどっ……身体が火照って……！」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……いいっ、オチンポ……もっと貪りたくなって、いやらしく\n　ズコズコしますっ、もっとっ、もっとぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「はぁんっ、あぁっ……またビクビク震えているのを感じますっ……オチンポ\n　……悦んで下さっていますかっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はい、嬉しいです……このオチンポ様にオマンコで絶対の忠誠を誓いますっ\n　……んふっ、くぅんっ、そこっ、擦れるぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ふふっ、また……出したくなってきましたね？　中での震え方で全部分かっ\n　てしまいますから……んはっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ええ……お好きな時にお好きなだけ……私のオナホールオマンコを、存分に\n　活用していただいて……気持ちいい射精なさって下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、あぁっ、私も……もう堪りませんっ！　また、一緒にオマンコ\n　アクメしてっ、最高の瞬間を共有したいですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「あぁっ、ズボズボいいっ！　後ちょっとっ……もうイクっ！　メスイキしま\n　すっ！　オマンコもうっイキますからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んぁぁっ、出してっ！　残ったザーメン全部下さいっ！　ドスケベまりあの、\n　恥ずかしいイキ顔っ、見てっ、見てぇぇぇっ！」", "NORMAL" ]},

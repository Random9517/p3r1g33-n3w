		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_07" ]},
		{"command":[ "SETTEXT", "「オチンポ……楽しんでいただけましたか？　ええ、オマンコでのご奉仕は、\n　私……まりあにお任せ下さい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「さて……一発出して頂きましたが……まさか、これで終わりなんて……貴方\n　も思ってはいませんよね？　ええ、お任せ下さい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_08" ]},
		{"command":[ "SETTEXT", "「めくるめく快感の時間は、ここからが本番……しっとり潤んだオマンコの\n　感触……もっともっと楽しんでくださいませ……」", "NORMAL" ]},

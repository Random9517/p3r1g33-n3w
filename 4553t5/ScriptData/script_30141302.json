		{"command":[ "SETIMAGE", "0", "still_00001413_02_05" ]},
		{"command":[ "SETTEXT", "「ふふっ……んっ、ほら……あっという間にオチンポがオマンコの中に呑み込\n　まれて行きます……んふぅ……熱いの気持ちいい……」", "NORMAL" ]},

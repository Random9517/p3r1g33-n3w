		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_04" ]},
		{"command":[ "SETTEXT", "「どうですか……オマンコの中……最初から、ずっと熱いでしょう？　実は、\n　ご報告の時から、期待して……中をヌルヌルにさせていました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_05" ]},
		{"command":[ "SETTEXT", "「んっ、乳首も……触って頂く前からビンビンではしたなく……はい、ご遠慮\n　なく揉んで下さい。このおっぱいも貴方のモノですから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_06" ]},
		{"command":[ "SETTEXT", "「あぁ……もうこの逞しいオチンポを前に、待ちきれません……早速ですが、\n　オマンコ……失礼いたします……はふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304111" ]},
		{"command":[ "WAITINPUT" ]},






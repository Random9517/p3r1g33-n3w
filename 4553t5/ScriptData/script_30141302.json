		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「これからの励みの為にも……少しだけでもご褒美をいただけないかと……あ\n　ぁん、私ったら……もうはしたない……」", "NORMAL" ]},
		{"command":[ "SETCHARA", "0", "char_00001413_01", "2", "CENTER", "0" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「えっ……？　いいんですか？　あぁ……ありがとうございますっ！　あっ、\n　もちろん貴方のお手を煩わせることは致しません」", "NORMAL" ]},

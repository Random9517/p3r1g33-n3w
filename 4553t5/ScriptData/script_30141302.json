		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_12" ]},
		{"command":[ "SETTEXT", "「んふっ、オチンポ……ずっと脈打って……一生懸命、精子を送り込んでくれ\n　ていますね……後もう少し、頑張ってっ♪」", "NORMAL" ]},

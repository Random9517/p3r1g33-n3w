		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_08" ]},
		{"command":[ "SETTEXT", "「おっ、ほぉぉぉぉぉっ……いいです……新鮮な、子種エキス……オマンコで\n　ごくごく飲んじゃって……くぅん……最高です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_09" ]},
		{"command":[ "SETTEXT", "「あぁ……まだ……もっと下さい……ビュルビュル出してっ……奥まで着床さ\n　せて下さい……んひぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_08" ]},
		{"command":[ "SETTEXT", "「はふぅ……んっ……たっぷり出して下さいましたね……ふふ、子宮もオマン\n　コも悦びに満たされて、私……とっても幸せです」", "NORMAL" ]},

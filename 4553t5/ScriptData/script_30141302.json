		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_10" ]},
		{"command":[ "SETTEXT", "「それにしても、まだ……オチンポがギチギチで……ふふっ、これは抜かずに\n　もっと続きをしたいということでしょうか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「あら……流石にお疲れでしたか。申し訳ありません……私としたことが、つ\n　いつい先走ってしまいまして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ですが、これからも貴方と……貴方のオチンポ様に尽くしていく気持ちに変\n　わりはありません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304309" ]},
		{"command":[ "WAITINPUT" ]},


		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001413_02_14" ]},
		{"command":[ "SETTEXT", "「顔にもおっぱいにも……いっぱい出して下さい……全部……貴方の色に染ま\n　りたいんです……んはぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ふふっ、ちゅぷっ、あぁ……ありがとうございます……たっぷりと出して頂\n　いて……心から貴方のモノになったと実感できました……」", "NORMAL" ]},

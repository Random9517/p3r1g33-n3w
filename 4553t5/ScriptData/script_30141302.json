		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「どうされましたか？　何か懸念があるのなら、遠慮なく仰って下さい。はい、\n　私は貴方のしもべなのですから……」", "NORMAL" ]},
		{"command":[ "SETCHARA", "0", "char_00001413_01", "3", "CENTER", "0" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「何も問題ありませんか。はい、それなら結構です。必ず、ご期待に添えるよ\n　うに致しますから……あの……それで……」", "NORMAL" ]},
		{"command":[ "SETCHARA", "0", "char_00001413_01", "0", "CENTER", "0" ]},
		{"command":[ "PLAYVOICE", "v2_014_1304103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ふふ……まだ、はっきりとした成果が出る前から、こんなことを言うのは図\n　々しいと思われるかも知れませんが……」", "NORMAL" ]},
		{"command":[ "SETCHARA", "0", "char_00001413_01", "1", "CENTER", "0" ]},

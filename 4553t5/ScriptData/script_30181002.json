		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETTEXT", "「はひっ、あっ、あひぃっ！　ヤバ……あぁっ、これ続けたら、またイキそっ\n　……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004216" ]},

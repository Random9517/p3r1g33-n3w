		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_15" ]},
		{"command":[ "SETTEXT", "「んっ、ちゅぷっ……後から後から噴水みたいに出てる……これ……サキュバ\n　スだから、余計に出やすくなってるのかな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004403" ]},

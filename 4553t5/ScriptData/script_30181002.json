		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_11" ]},
		{"command":[ "SETTEXT", "「んぁぁ……はぁ、はぁ……終わった……？　うん……めちゃくちゃ、エナジ\n　ーもらった……これがサキュバスの吸精なんだね……」", "NORMAL" ]},

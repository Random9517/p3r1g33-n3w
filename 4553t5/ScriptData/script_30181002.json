		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_10" ]},
		{"command":[ "SETTEXT", "「こんなに感じると思わなかったから……これ、病みつきになっちゃうやつだ\n　ね……元に戻れなくなっちゃうよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETTEXT", "「それにしても、サキュバスって……毎日、こんな感じで過ごしてるのかな…\n　…？　だとしたら、ある意味尊敬しちゃうけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETTEXT", "「実際はもう少し穏やかなのかな……フフ……今度本物に聞いてみるしかない\n　かな。え……絶対、こんなに貪欲じゃない……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_11" ]},
		{"command":[ "SETTEXT", "「そうかも……慣れてないからかな……また、ウズウズして来ちゃったし……\n　もう一回しちゃう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_10" ]},
		{"command":[ "SETTEXT", "「なんて……冗談だよ、冗談……でも、また身体が疼いたら、君にお願いしち\n　ゃうと思うから……その時はよろしくね……フフ……」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、また中出しするっ？　おチンポ抜いて……ぶっ掛けてもいい\n　からねぇっ、あっ、ひぁっ、はひぃんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETTEXT", "「私も……このままイっちゃうからっ！　サキュバスおマンコっ、最後の最後\n　までたっぷり味わってねっ、はひぁっ、イっ……くうぅぅぅっ！」", "NORMAL" ]},

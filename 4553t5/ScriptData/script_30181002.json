		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_14" ]},
		{"command":[ "SETTEXT", "「あぁぁ……身体がジンジンする……気持ちいいよ……おチンポ抜けたのに\n　……まだおマンコ……気持ちよくて……イってるの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_13" ]},
		{"command":[ "SETTEXT", "「んっ……はぁぁ……射精も終わったみたいだね……はふぅ……余韻がすごい\n　ね……まだ、頭がフワフワしてる感じがするよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_1004405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_14" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……うわぁ……何だか、精液の味まで美味しく感じちゃってる……\n　私、これ……元に戻れるのかな……戻らなくてもいいのかな？」", "NORMAL" ]},

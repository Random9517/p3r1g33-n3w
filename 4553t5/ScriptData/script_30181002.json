		{"command":[ "SETNAME", "グリムロック" ]},
		{"command":[ "SETIMAGE", "0", "still_00001810_02_12" ]},
		{"command":[ "SETTEXT", "「あぁ……まだおチンポビクビクしてぇ……射精続けてる……逞しすぎて……\n　好きになっちゃいそぉ……はへぇ……♪」", "NORMAL" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あんっ……あんまり乱暴にしないで……もう大人しくしているでしょ……？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103101" ]},
		{"command":[ "SETCHARA", "0", "char_00030901_01", "7", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふ……怖い顔……そんなに凄まなくても、ちゃんと聞かれたことには答え\nるつもりよ。ほら……もうそんなに自由も効かないんだし……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103102" ]},
		{"command":[ "SETCHARA", "0", "char_00030901_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んっ……でも、私がすぐに喋っちゃったら、尋問する方も楽しみが足りない\nわよね……？　だから……こうして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103103" ]},
		{"command":[ "SETCHARA", "0", "char_00030901_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あぁ……すごく立派なオチンポ……こんなので迫られたら……私なんてひと\nたまりもなくやられちゃうわぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103104" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……とてもしゃぶりがいがある……ううん、すごく……怖いモノを\nどうするのかしら……んっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103105" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「私の……おっぱいに、押し付けて……はぁ……んっ、パイズリしろと……そ\nういうことなのね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103106" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んっ、ふうっ……あぁ……オチンポが挟まっていく……ギチギチの勃起チン\nポが、私のおっぱいを犯してくるわ……はぁっ、熱い……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103107" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「谷間にしっかりと挟み込ませたまま……上下させろって言うのね……？　ん\nんっ、こ、こうかしら……？　その、慣れてないのよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「すごく滑らかに動かせている……？　ふふっ、たまたまかしら……えっ……\n私の目的……？　それは……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んっ……貴方のオチンポを、快感に満たして……気持ちいい射精をさせるこ\nとかしら……だって、そうしろって命令だものね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103110" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「違う……？　私の正体……？　属している場所……？　んっ、そんなもの…\n…貴方に囚われた女子学生で……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「今は……貴方に絶対服従させられて……淫らなパイズリご奉仕をしている…\n……愛……よ。それ以上のものではないわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ほぉら……オチンポがピクピクしている……んっ、はぁ……腰が浮いて……\nこの辺……気持ちよかったのかしらね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103113" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「いいのよ……腰を振っても……だって、私は囚われの身で、何をされても抵\n抗できないんですもの……直接おっぱいを犯して……あっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103114" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んっ、はぁっ……あぁっ、逞しいオチンポが……谷間の奥までグポグポ犯し\nてっ……！　んぅっ……おっぱいの中で暴れてるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、組織の目的……？　そんなこと言われても……あぁっ、乳首\nが、あっ……感じすぎて……コリコリ摘まれたらっ……はぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103116" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んぁっ、はっ、ひっ、んぁっ……満足に答えることなんて……あっ、できる\nはず……あぁっ、ないわ……あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「それに……もう止まらないでしょ……？　ここまで来て……オチンポ離れる\nなんて……そんな生殺しなことできる訳ないし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103118" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あぁ……そんなに亀頭を突きつけて……直接命令しなくても……察しろって\n……そういうことよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103119" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「はぁっ、んりゅぷっ、ちゅぷっ……あぁっ、ぱっくり……咥えひゃったわ…\n…んふぅ……これじゃ……もう喋れないわれぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103120" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅるるっ……んちゅぷっ、じゅぽっ、くぷっ……フェラチオぉ……んっ、\nそんな、慣れてなんて……見様見真似よ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103121" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「このカリ首が弱いところとか……んっ、裏筋の……感じやすい場所なんて…\n…んっ、そんなに……知ってるわけじゃ……んちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「れろ、ぺろっ、んんっ、えろっ、れろぉんっ……んふっ、じゅぽっ、ちゅぱ\nっ、んむちゅっ、じゅぷっ、んじゅるるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103123" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「吸い付きがいやらしい……？　やだ……恥ずかしいわ……そんな風に言われ\nたら……あぁんむっ、もっとおしとやかにおしゃぶりしないと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103124" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ちゅぽっ、んくぷっ、でも……私はオチンポに迫られてるから仕方ないのよ\nね……んじゅぷっ……ぴちゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「おっぱいも……もっと寄せて、しっかり挟まないと……酷い目に遭わせられ\nるかもしれないもの……一生懸命ご奉仕しないと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103126" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「そんなことしない……？　んふっ……優しいのね……んじゅぷっ、それなら\n……お礼にもっとサービスしてあげないと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103127" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「りゅぽっ、んふっ、そんなこと……言ってない？　でも……オチンポは嬉し\nそうに震えているわ……んりゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「これはもう、そう言ってるのと同じことでしょう……？　柔らかい谷間をぐ\nにぐにされて……気持ちよくピュッピュしたいって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103129" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅるるっ……んちゅぷっ、ほら……先走り汁もそう言ってる……おっぱい\nを犯して、思いっきり中出ししたいって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅぱっ、んちゅぷぅっ……もちろん全部飲ませて……私の口の中を、貴方\nのオチンポで完全支配する……そういうつもりなのよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、んふっ……ビクビクしてるわ……止まらないパイズリに、早\nく出したい……出したいって訴えてきてるの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103132" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んじゅぱっ、ちゅぷんっ、んちゅぅぅっ……先走り……吸い出してぇ……ち\nゅぱっ、後は、もう一回深く咥え直してぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅぽっ、じゅぱっ、頬を窄めてっ……エロ顔っ、ピストンっ、むふぅっ、\nんぶぅっ、さあっ……我慢しないれっ、らひなさいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んじゅるるっ、じゅぷっ、んふぅっ……欲望の精液っ……ぶち撒けひぇっ…\n…んじゅぅぅぅぅぅーっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふぶぅっ……！　んぐっ、んんぅむ……じゅぷっ、あぷっ……んちゅぷっ、\nんふぁっ……はぷっ、んぁ、ふごい量……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103136" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んっ、んんっく……全部飲ませるつもりなのれ……じゃないと……何をされ\nるか……んぐっ、こくっ、んくんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103137" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふはぁっ……はっ、んふぅ……お望み通り……全部飲んだわ……ほら……あ\nぁんっ……しっかり口を開けて……飲んでるでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103138" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「見せなくていい……？　あら……でも、そうしないとこっそり吐き出してる\nかも知れないし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ちゃんと出来たことは分かったの？　それなら良かったわ……これで、許し\nてもらえそうね……ふふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103140" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「えっ……誤魔化されるつもりはない……？　まだ、尋問は終わってない……\nあら……満足してなかったってことかしら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103201" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「それは、確かに私の責任よね……秘密を吐かせるつもりなんだから……オチ\nンポの奥の精液もしっかり吐かせてしまわないと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んっ、ふふ……イッた直後は、すごく感じやすくなっているでしょう？　精\n液も亀頭から漏れて……これがおっぱいもよく滑らせてくれて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103203" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ……私まで気持ちよくさせようとしてるの……このオチンポに流\nされちゃいそう……んっ、はぁぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103204" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「今なら所属も喋ってしまうかもね……あんっ、乳首ぃ……ツンツンしちゃだ\nめぇ……あぁっ、言うわ……秘密組織デリバリーエロスよぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んふっ、相手の組織の中で……エッチなことを楽しむ組織のことよ……んっ\n、ふっ、はぁっ、あんっ……なんて言ったら信じる……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103206" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あぁんっ、怒らないで……ちょっとした冗談じゃない……でも、このオチン\nポに尽くしたい気持ちは本当なの……んっ、はぷっ、ちゅぷぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103207" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「りゅぱっ、くぽっ、んじゅぷっ……んふぁっ……ほら、少し落ち着いたら…\n…また出したくなって勃起が膨らんできてる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103208" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んじゅるるっ……これはさっき残してた分というより……新しいのがまた出\nる準備をしてるってことでしょう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「だったら、これを鎮めてあげないと……ちゅぷっ、ダメよね……んりゅぷっ\n……あふっ、じゅぱっ、んちゅぷぅぅうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103210" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ほら……ここなんて、血管が浮き上がって……すぐにでも出したいって……\nいきり立ってる……あぁ、よしよし……んっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ぎゅっておっぱいで包んであげたら、多少は落ち着くかしら……？　あら…\n…またビクビクして……落ち着かなくさせちゃったわね……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「どうしても、おっぱいの圧力には勝てないのね……ふふっ、そういうところ\nも含めて可愛いオチンポなのよね……んちゅぷぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103213" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「こんなに、大きくて……形もいかついのに……弱い所は分かりやすくて……\n色んな反応を見せてくれるの……れろ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ほら……舌がオチンポの割れ目に食い込んでいくわ……ぴちゃ……んちゅっ\n、じゅるっ……また、近いでしょ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103215" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んっちゅっ、ちゅぷぅぅぅ……じゅるるっ、んじゅっ……んちゅぷっ……は\nっ、んふっ……我慢汁……滲んでるわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「もう……何も出来ない位に口を犯して……ちゅぷっ、はぁっ、ぴちゃっ、ん\nちゅぱっ……出しちゃいましょう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103217" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ズリズリ……おっぱいも擦り上げて……オチンポの気持ち……高めて行って\n……はぁっ、私も……いいわっ、これっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、我慢しなくていいのよ……ちゅぷっ、んちゅぱっ……貴方の\n欲望の滾り……全部ぶちまけて……んじゅぱっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「さあ……出してっ……もう一発……私のパイズリで……射精しちゃいなさい\nっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103220" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_09" ]},
		{"command":[ "WAITINPUT" ]},


		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ひぁうっ……！　あっ……あぁっ……オチンポ抜けてっ……顔にっ、あふん\nっ！　ずっと狙ってたのね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103401" ]},

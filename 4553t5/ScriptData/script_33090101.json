		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んふぅっ……！　むぶっ……んぐっ……はぷっ……れてる……んんっ、じゅ\nるるっ、ごくっ、んっ、んくんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふごいわ……全然……勢いが衰えてない……本当に欲望まみれのオチンポね\n……濃いのが喉に絡むぅ……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んっぐ……ゆっくり飲まないと……むせちゃいそう……んじゅるっ、ちゅぷ\nっ、んじゅぱっ、ちゅぷぁぁぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103303" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んふっ、そうよ……今……喉を鳴らして……貴方の性欲のエキスを飲み干し\nているとこ……こくっ、んくんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103304" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふはっ……はぁぁ……けふっ……すごいわ……一気に飲むのに、こんなに苦\n労するなんて……でも、何とかなったみたいね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103305" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふっ、脱力した顔をしちゃって……待ってて、今……お掃除してしまうわ\n……ちゅぷっ、ぴちゃ、んちゅぱっ……れろ、んれろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103306" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「まだ……とくんって小さく震えてる……いっぱい出して疲れたでしょう？　\n楽にしててね……んちゅっ、ちゅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「はい、おしまい。これでスッキリしたんじゃないかしら。あら……そんなお\n礼なんて。喜んでくれたのなら何よりだわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103308" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「でも……私の秘密より……貴方の秘密の方を多く吐き出しちゃったみたいね\n……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「今度はどんな怖い尋問をされるのかしら……ふふっ、心配で仕方がないわ…\n…」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103310" ]},

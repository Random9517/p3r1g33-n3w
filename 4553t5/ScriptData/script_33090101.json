		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「はぷっ……でも……貴方のなら全部受け止めてもいいわ……んっ、濃いの…\n…そのまま、私に浴びせてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「熱い……んんっ、おっぱいにも……降り注いでるわ……ドロドロの精液……\nもっと出し切ってぇ……んふぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んちゅぷっ……はぁっ……あふっ、直接飲むのと……こうして口元へ運んで\n味わうのは……また、違う趣があるわね……ちゅるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103404" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あら……そんなことを言ってたら終わっちゃったわ……でも、たっぷり出し\nてくれて嬉しいわ……私で興奮してくれたのよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103405" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あぁ、まだ腰は引かないでね。最後のお掃除まできっちりしておかないと示\nしがつかないものね……ちゅぷ、んちゅ、ぴちゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「まだ、奥に少しだけ残ってるわ……んちゅぅぅっ……吸い上げちゃいましょ\nう……全部出しきらないとね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んふっ、いいわ……貴方の欲望……遠慮なく吸い出させてもらったわ……ふ\nふっ、なんだか呆けた顔をしちゃって……しっかりしてね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0103408" ]},
		{"command":[ "SETIMAGE", "0", "still_00030901_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「そうね、何となく尋問はうやむやになってしまったけど……でも、これで失\n敗というわけじゃないもの」", "NORMAL" ]},

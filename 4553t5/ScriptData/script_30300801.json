{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0050" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「大分うなされてたわね～。悪い夢でも見てたのかしら。大丈夫、大丈夫よ～\n。何も心配することはありませんから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803101" ]},
		{"command":[ "SETCHARA", "0", "char_00003008_01", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ほら、ママのおっぱいですよ～。そう、落ち着いたわね。いい子、いい子…\n…怖いのはどこかにいったわ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803102" ]},
		{"command":[ "SETCHARA", "0", "char_00003008_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ……起きたのね……おはよう、ねぼすけさん。どうしたの、き\nょろきょろして、まだ寝ぼけているのかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803103" ]},
		{"command":[ "SETCHARA", "0", "char_00003008_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「別時空？　アナザー？　なにを言ってるの？　まだ目が覚めてないの？　そ\nれとも、変な夢でも見た？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803104" ]},
		{"command":[ "SETCHARA", "0", "char_00003008_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「そういうときは、ママのおっぱいで落ち着きなさい。ほら……ぎゅってして\nあげるから。んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803105" ]},
		{"command":[ "SETCHARA", "0", "char_00003008_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ほら、オチ〇ポもしごいてあげる……ふふっ、起きたばかりだから元気で…\n…んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803106" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あんっ、ほら、暴れないの……どうしたの？　今日はなんだか妙な反応ばか\nりするわね。反抗期かしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803107" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「男の子だものね……でも、オチ〇ポはママにしごかれたがってるわよ？　ほ\nら、こうしたら……ふふっ、びくびくって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803108" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んっ、ふうっ、ほら、ママのおっぱいも好きにしていいのよ？　お口で、ち\nゅうちゅうしても……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803109" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「なあに、その不安そうな顔。いつものことでしょう？　ほら、遠慮せずに…\n…んんっ、ふっ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ね、ママのおっぱいに抱かれてると嫌なことは消えていくでしょう？　それ\nで、オチ〇ポもしこしこしたら……ほら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ふふっ、気持ちよさそうな声が出てるわ。そう……そうよ。リラックスして\n、おっぱいとオチ〇ポのことだけ考えて……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803112" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ほら……おっぱいでぎゅってしてあげる。あんっ、オチ〇ポが震えてるわ…\n…かわいそうに。こっちはなでなでしてあげるわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803113" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ぎゅっぎゅ、しこしこ……ふふっ、落ち着いてきた？　身体は熱くなってき\nたみたいだけど……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「いつもよりオチ〇ポが凄いわね……手のひらがやけどしちゃいそう。それに\nおっぱいも……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803115" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んっ、あなたの吐息が当たって……いいのよ。好きにして。んっ、ふうっ、\nあっ、でも、なんだか……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「いつもより、おっぱいも熱くなってる、んんっ、あなた……なにか変わった\n……？　んっ、いいえ、いいわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803117" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「どんなあなたでも、私の愛しい子供だもの。ごめんなさいね。ほら、ママに\nまた甘えて……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「おっぱいとオチ〇ポ、どっちが好き？　ママのおっぱいでぎゅってされるの\nと、ママの手でしこしこされるの、どっち？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803119" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、両方って……もう、わがままな子ね。でも、そういう子ほど\n可愛い……んんっ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803120" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「じゃあ両方、好きなように味わって……おっぱいと、手と……んっ、ふうっ\n、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803121" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「オチ〇ポ、熱く硬くなって……ふふっ、お汁が出てきたわね。ママの手がど\nろどろになっちゃう……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803122" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、おっぱいも……熱くて……んふっ、あなたの顔で溶けちゃいそ\nう……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803123" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ほら……どう？　ママのおっぱい、柔らかいでしょう？　もっとぎゅってし\nてあげるから……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803124" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んふっ、あなたの吐息が……熱くて……んっ、ふっ……ママもちょっと、気\n持ちよくなってきた……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803125" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ダメダメ。私はママだから、あなたをちゃんと気持ちよくしてあげないと…\n…んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ほら、こうして指でわっかを作ってシコシコしたら……あんっ、あっ、腰、\n動いてるわよ……ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803127" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「うふふ、目もとろんとしてきて……いい子、いい子。オチ〇ポも元気でいい\n子だわ……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803128" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「腰がびくびくして……そろそろイきたいの？　でもまだダメよ。あなたはで\nきる子だから、我慢できるわね？　ほら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803129" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「我慢……我慢……ねっ、我慢したら、一番気持ちいい時に出させてあげます\nから……ほら……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「もうちょっと……もうちょっと……ね？　オチ〇ポ、根元から熱くなって…\n…ふうっ、我慢して……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803131" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ほら、おっぱいも感じて……オチ〇ポも……んっ、いいわ、強くしごいて…\n…シコシコって、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「いいわよ、もういいわ！！　イって、精液出していいわよっ！！　ママのお\nっぱいと手で、いっぱい出してっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、ふああああああああっ！！　凄い、噴水みたいに……んんっ\n、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803134" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_04" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ、手がやけどしそう……ふううっ、んっ、んっ、ふうっ……ん\nんんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803135" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「いっぱい出したわね……えらいえらい。気持ちよかったのね。ふふ……そん\nな顔してくれるのなら、ママも嬉しいわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803136" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「なあに？　私の顔をじっと見て。そんなによかった？　最後の方は腰をびく\nびくさせていたものね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「いつもより一杯出てたし、ふふ、ママも嬉しいわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803138" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「やっぱり一日に一回はこうして親子のスキンシップをしないとね……ママも\n寂しくなっちゃうわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あなたもそうでしょう？　最近ちょっと冷たかったけど、やっぱりこうして\nると息子っていいわって思うもの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「え、別時空？　まだ言ってるのそれ？　よっぽど怖い夢を見たのかしら……\n大丈夫、大丈夫よ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803201" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「怖いことなんてなにもないんだから。なにかあっても、ママが全部やっつけ\nちゃうから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803202" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「だからほら、あなたはママに身を任せて、おっぱいを吸って安心してくれた\nらいいの。ほら、ほら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803203" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んっ……そう、先端を口で吸って……あんっ、あっ、噛んじゃダメよ……マ\nマのおっぱいは優しくね、んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803204" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ふっ、あっ……んっ、ベロで舐めて、んっ、ちゅっちゅって吸って、上手、\n上手よ……んふうっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ママも気持ちよくなってきた……けど、あなたにもしてあげなきゃね。んっ\n……こうしてもう一回手でシコシコしたら……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「だから噛んじゃダメってば。もう、悪い子ね……そんな子には、お仕置きよ\n。ほら、手のひら全体でこうしたら……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「さっき出したお汁と混ざって、ぬるぬるってなってるでしょう？　ほら、そ\nれでこうやって速くしたら……んふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803208" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「凄い音と動き……腰ががくがく動いてるわ。顔も、そんな顔でママを見つめ\nてきたら……あんっ、おっぱいがもっと気持ちよくなっちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んくうっ、んっ、あっ、先端、甘噛みしたら……んっ、お腹の奥、きゅっき\nゅってなっちゃう……ふううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803210" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「手も動かしてって……もう、あなたがおっぱいいじめるから止まっちゃうの\nよ。でも、分かったわ。ママの愛を見せてあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ほら、ほら、こうして手でこすってから、きゅって絞ったら……ふふっ、気\n持ちいいでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あなたの気持ちいいところなんて、ママは全部知ってるんですからね。おっ\nぱいが好きなことも、オチ〇ポの気持ちいいところも、全部」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ほらほら、あんなこと言ってお口が止まってるわよ。オチ〇ポシコシコして\nあげるから、もっとおっぱいも吸って……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803214" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んっ……そう。それでいいの。ママのおっぱい吸ってたら、怖いことも、辛\nいことも、全部忘れられるから……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803215" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ママはあなたのこと、ずっと愛してるからね。顔も、身体も、オチ〇ポも、\nあなたの全てを」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ママだけはあなたの味方だから……だから安心して、いっぱいいっぱいオチ\n〇ポ、気持ちよくなって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、はっ、ママも、おっぱい気持ちよくなってるから……んんっ\n、息子に吸われて、気持ちよくなってるから……あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803218" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、んっ、イく……これ、イっちゃうかも……おっぱい吸われて\n、イっちゃう……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「一緒に、ね、一緒にイきましょう。ママとあなた、おっぱいとオチ〇ポで、\n一緒に、一緒に、ふああああああああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803220" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_08" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あはあああああっ！！　また、一杯出てきた……んんっ、はっ、あっ、んん\nんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803301" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「二回目なのに、さっきより濃くて……さすがママの子供だわ……んっ、ふう\nっ、凄く、立派……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ママもイっちゃった……あなたのお口で、気持ちよくなってイっちゃった…\n…んっ、よかったわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803303" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ふふ……お腹、どろどろになっちゃったわね。それだけ気持ちよかったんで\nしょうけど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803304" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ……まだ出てる……んふうっ、オチ〇ポ、そんなによかったの\nね。おっぱいも、あなたの口でべたべたになってる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803305" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ふふ……いいのよ。子供はママにいっぱいいっぱい甘えるのが仕事なんだか\nら。むしろ嬉しいわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803306" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「おっぱいも、手も、あなたが甘えてくれたしるしなんだから、ね。だから、\nまたするときも遠慮しないで」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ママは、子供の事を全て受け止めるのが仕事なんだから。全力で甘えてきて\n……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「でも……ずいぶん汚れちゃったわね。いいわ、綺麗にしてあげるから寝てな\nさい。今日は、一日中寝てていい日にするから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803309" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「それじゃあ、今はおやすみなさい……今度はいい夢を見なさい……ママが見\n守っててあげるから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ああっ、オチ〇ポが急に跳ねて……あんっ、ああっ、おっぱいに……んんん\nんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803401" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「凄い、熱くてドロドロで……ふうううっ、んっ、あんっ、あっ、こんなにか\nけられたら、おっぱいで妊娠しちゃいそう……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ふううううっ……まるでミルクが出たみたいになっちゃったわ……もう、い\nたずらっ子なんだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803403" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ママのおっぱいにぶっかけるなら、ちゃんとそう言って。そうしたら、最初\nから全部受け止めてあげるから、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「もう、言ったそばから残った奴を出してきて……しょうがない子ね。そんな\nにママのおっぱいにかけたかったの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803405" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「いいわ。それであなたの不安がなくなるなら、好きなだけかけてもらってい\nいわ……これもママの役目ですからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803406" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「おっぱいを吸うのも、ぶっかけるのも、好きにしていいの。子供のわがまま\nを聞くのも、ママの特権よ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「ふふ、どうしたのその顔。元の時空？　それは良く分からないけれど……あ\nなたのママは私だけよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「だからほら、あなたの不安も怖いことも、全部ママに預けなさい。精液だけ\nじゃなくて、それも受け止めてあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803409" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んっ、ようやく笑ったわね……いい顔よ。それじゃあ、綺麗にするためにお\n風呂に行きましょうか。身体、洗ってあげるからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0803410" ]},
		{"command":[ "SETIMAGE", "0", "still_00003008_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
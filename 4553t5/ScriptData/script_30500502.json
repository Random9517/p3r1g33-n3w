{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「隊長、来ましたが……私になにか用ですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504101" ]},
		{"command":[ "SETCHARA", "0", "char_00005005_01", "3", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ん？　この格好ですか？　新年ぐらい私もこういう格好をする……というつ\nもりはなかったのですが、長官に新年ぐらいと言われて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504102" ]},
		{"command":[ "SETCHARA", "0", "char_00005005_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「節目に気を引き締める、思いを新たにする、そういう意味ではもっともだと\n思って着てみたんですが……どうかしましたか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504103" ]},
		{"command":[ "SETCHARA", "0", "char_00005005_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「よく似合ってる……そ、そうですか。この服が見たいから呼んだって……ふ\n、ふふ。そうですか、そうでしたか。いいですよ……存分に見てください」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504104" ]},
		{"command":[ "SETCHARA", "0", "char_00005005_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「晴れ着にしては露出が多いと思っていましたが、隊長がこうやって見てくれ\nるのなら、悪くはないですね……ほら、こことかも凝っているでしょう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504105" ]},
		{"command":[ "SETCHARA", "0", "char_00005005_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「袖とか……裾も見ていいんですよ。こういう細かな部分も……実は私も気に\n入ってるんですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504106" ]},
		{"command":[ "SETCHARA", "0", "char_00005005_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「あん、隊長、どこを見て……ふふ、そこは晴れ着じゃなくて身体ですよ……\nもう、男がどこを見ているかなんて、女には丸わかりですからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504107" ]},
		{"command":[ "SETCHARA", "0", "char_00005005_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「別に構いませんよ……見たいなら、もっと近くに……ほら、服も……私の身\n体も……ベッドの上ならよく見えますよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504108" ]},
		{"command":[ "SETCHARA", "0", "char_00005005_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ふふ……凄い視線ですね……見られてるだけで熱くなってきます……んっ、\nあっ、もう。隊長まで脱がなくていいんですよ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504109" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「隊長のペニス、もうがちがちになってるじゃないですか……私の格好と身体\nでこうなったって……嬉しいですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「私みたいな可愛げのない女を見て、興奮してくれるんですから……私が綺麗\nで可愛いって、おだてすぎですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「でも……ふふ、嬉しいです。いいですよ、隊長。私の身体、どこでも好きに\nして……もちろん、その逞しいペニスを挿入しても……ほら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504112" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「もっと側に……んんっ、あっ、入って、きた……んっ、はあっ、んっ、ふう\nうっ、相変わらず、大きいですね……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504113" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「奥まで入って……ふっ、うっ、私の中、満たしてくれてます……隊長、んっ\n、胸、見てますね……ふふっ、構いませんよ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504114" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、あんっ！！　ペニスを出し入れされたら、胸が揺れて……そ\nんなに視線を注がれたら、溶けてしまいそう、あっ、くうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ふうっ、うううっ、んっ、凄い、出し入れされるたび、熱と気持ちよさで…\n…んんっ、オマンコが熱くなって……ふうっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504116" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「あああああっ、隊長のペニス、気持ちいい、気持ちよすぎる……ふあっ、あ\nあっ、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504117" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「私の中を、ごりごり削って、抉って、叩いて……んんっ、私のオマンコ、全\n部ペニスですりつぶされてる……ふあっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「隊長も、気持ちいいですか？　あんっ、ああっ、あっ、あっあっあっ、ペニ\nスの動きで分かるだろうって、んふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504119" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んっ、うっ、そうですね、オマンコの中で震えて、暴れて……んっ、ぐちゅ\nぐちゅってかき回して、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「きゅって締めつけると、嬉しそうに反応して……ふふっ、気持ちよくなって\nくれてますね……あんっ、ああっ、私と同じ……くうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「嬉しい……んっ、あっ、私で気持ちよくなってくれてるのが嬉しい、あんっ\n、あっ、んんっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504122" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んっ、もっと、もっとください……隊長の気持ちいいの、私を気持ちよくし\nてくれるのを、もっと、あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、凄い、隊長の腰、動きが……ふあっ、あああっ、お腹の奥、\n骨まで蕩かされてるみたいに、ふあっ、ああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504124" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んふううっ、ペニスが出し入れされるたびに、私の中がどろどろになって、\nんっ、はあっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504125" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「カリ首が中を擦って……んんっ、頭の中まで痺れてます……ふうっ、あっ、\n隊長のペニス……好き……好きです……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「私だって、たまには素直に……ペニスだけじゃなく、隊長も好きです、ふう\nっ、あああっ、ああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「だから、この服を見たいって言ってくれたとき、嬉しくて……もうその時か\nらオマンコが準備できてて……んふうっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504128" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「だから、隊長も求めてくれて、本当は嬉しかったんです……ふああっ、嬉し\nくて、ペニスにオマンコちゅっちゅって吸いついてる、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「分かるでしょう、あっ、ううっ、吸いついて、隊長の精液、おねだりしてる\nの、分かるでしょう、ふうううっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504130" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「お願い、お願いです、私の中に……隊長が気持ちよくなった証を……どろっ\nどろの濃い精液を……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「その逞しいペニスから、私の中に出して……んんっ、あっ、はあっ、あんっ\n！！　膨らんできた……先端、膨らんできたっ、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504132" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「イって！！　中でイって、出して！！　隊長の精液、欲しいっ！！　んっ、\nあああっ、あっ、来る、精液来るっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ひああああああああっ！！　あっ、ああっ、あくうっ！！　ん……ふうっ、\nふっ、出されてる、私のオマンコに、隊長の精液注がれてる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504134" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「お腹の中、膨らむぐらいいっぱい……んっ、ふうっ、はあっ……ああっ、ぐ\nちゅぐちゅになってる……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「隊長の気持ちいいのが、全部、私の中に……んふうっ、はっ、あっ……隊長\n……はあっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「気持ちいい……愛してる人に中に出されるの、こんなに気持ちいいんですね\n……隊長、好きです、愛してます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504137" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んっ、はあっ、今の言葉でまた、ペニスから……ふうっ、うっ、最後の一滴\nまで……んんっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「はあっ、あっ……気持ち、よかった……隊長の顔を見ながら繋がるのって、\nいいですね……ふふ、恋人という感じで」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504139" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「身も心も繋がってるって気分になれます……んっ、ふうっ、ふふっ、もう、\n服が乱れちゃいましたね……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「どうせなら、もっと乱してしまいませんか？　隊長も、まだまだおさまりそ\nうにないですし……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「いいんですよ。私の身体も、服も、全部好きなようにして……隊長なら、隊\n長にだけ、私の全てを好きにして……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ああっ！！　あんっ！！　あっ、あっあっあっ、凄い、出したばかりなのに\n、がちがちのペニスが私の中を、ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504203" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んふううううっ、んっ、あっ、オマンコ、ぎゅって、締めつけが強くなって\n……ふうううっ、あっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「隊長の形、全部分かります。私を愛してくれているペニスの形……んはあっ\n、ああっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504205" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「亀頭もカリ首も、竿も、根元まで全部……ふううううっ、あっ、お腹、全部\n満たされてる、ふああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「腰、がんがんぶつかって……ふあああっ、隊長、隊長、もっとそれ、してく\nださい、その動き、好きっ、あんっ、あああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504207" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「私が求められてるって感じがして、ふううっ、ああっ、あっ、もっと激しく\n、ふああああっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、私の身体も、もっと見てください！！　んっ、鍛えた身体、\n裸を見ていいのは隊長だけですから、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「顔も、首も肩も、胸も、お腹も、オマンコも、全部見ていいのは隊長だけで\nすからっ！！　ふああっ、あっ、くうっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504210" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「好きにしていいのも隊長だけですから！！　ひあああっ、あっ、腰、またぶ\nつけられたら、あっあっあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「またお腹の奥、骨まで蕩けちゃう、気持ちいいので蕩けちゃう……今度はも\nう、頭の中まで……んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504212" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ペニスで全部溶かされちゃう！！　隊長の太くて硬くて逞しいペニスで！！\n　全部溶かされちゃう、あううううっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、奥、ほじられたら……ふあああっ、私の腰も動いちゃう、ん\nっ、ふううっ、あっ、あんっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504214" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「あくうっ、んんっ、こんなに、こんなに動かれたら……んっ、隊長のペニス\n、覚えちゃう！！　私のオマンコ、隊長のを覚えちゃう！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ふううううっ、うっ、こんなの、今度から隊長を見ただけで興奮しちゃう…\n…ふっ、あっ、あああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504216" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、イく、隊長のペニスでイく！！　オマンコイっちゃう、んっ\n、ああっ、あっ、んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504217" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「隊長も、イきそうなの、分かりますっ！！　先端が膨らんで、熱くなって、\n隊長の顔も……凄く気持ちよさそうで、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504218" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「一緒に、一緒にイきましょう、隊長、ペニスとオマンコ、一緒にイきましょ\nう、んっ、ああっ、あっ、イく、イく、イっく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「隊長……愛してます、んんうっ！！　イっく、イっくうううううううううう\nうううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504220" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_08" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ひああああっ、あっ、あっ、イってるオマンコに、精液来てるうううううっ\n、んっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504301" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んふうっ、んっ、ああああっ、あくうっ、どろどろに、どろどろのオマンコ\nにされてるっ、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「どくどくって、ペニスから注がれてるの……分かる……んっ、はあっ、ああ\nっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「最後まで……全部、出してください……隊長の気持ちいいの、私の中に全部\n……お願い……んふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504304" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「あっ、ふうっ……んっ……竿の中の精液も、全部出してくれたの……分かり\nます、んうっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「はあっ……気持ちよかった……ふふっ、最初は戸惑いましたが、今ならこの\n格好をして本当によかったと思います。あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504306" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「隊長がこんなに私を求めてくれたんですから……んっ、ふうっ、んんっ……\n新年だけではなく、いつもこの格好をしていいかもしれませんね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「そうしたら、隊長は毎日私を愛してくれるでしょう？　ふふ……なんて、似\n合わない冗談を言ってみました、あっ、やっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「冗談じゃなくしてくれるって……んっ、嬉しいです……じゃあ、またこうし\nて激しく抱いてくれますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ふふ。なら、ずっとこの格好でいますね。次も、こうして隊長と愛しあえる\nように……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504310" ]},
		{"command":[ "WAITINPUT" ]},

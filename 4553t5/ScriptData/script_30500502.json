		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「ああっ、隊長のペニス、抜けて……ひああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504401" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んうっ、顔と、身体に……んうっ、はっ、あああっ、精液がふりかかって、\nふうううっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、隊長のがべっとりと貼りついて……んふうっ、匂いも、熱も…\n…あんっ、火傷しそう……ふううっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504403" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「あっ、くっ、うっ……中じゃないのに、気持ちいい……んっ、ふあっ、あっ\n、あんっ……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「オマンコも、身体も、全部隊長に染められて……こういう、満足のしかたも\nあるんですね……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「んっ……最後の一滴まで出て……んふうっ、隊長も満足してくれましたか？\n　あんっ、なら、いいです……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504406" ]},
		{"command":[ "SETIMAGE", "0", "still_00005005_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「二人とも満足しないと、意味がないですからね……まあ、この量を見たら満\n足したって一目で分かりそうですが……ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「服にもいっぱいかかってしまいましたね……あんっ、別に気まずそうにしな\nくていいですよ。隊長のためにした格好ですし。んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「クリーニングに出せば元通りですし……そうしたらまた、こうして抱いてく\nれるでしょう？　私なら、いつでも呼んでくれれば……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_050_0504409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "氷華" ]},
		{"command":[ "SETTEXT", "「だから中でも外でも、また一緒に気持ちよくなりましょうね……隊長となら\n、どこでも愛しあいたいですから……」", "NORMAL" ]},

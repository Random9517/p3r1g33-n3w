		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「それよりも、んっ、あぁ……おっぱいが切ないの……んっ、そこっ、あっ、\n揉んでぇ……はっ、あぁん……気持ちいい……」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ、あっ、あぁっ……！　続き……するのねっ……あんっ、あぁ\nっ、でも、私……もう話すことなんて何も……はひっ！」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「イッちゃいますぅううっ……！　あっ♪　あっ♪　旦那さまっ……わたくし\nのおまんこを、いっぱいせいしで満たしてくださいぃっ……♪」", "NORMAL" ]},

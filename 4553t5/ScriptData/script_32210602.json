		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁんんっ♪　あぁっ、熱い……！　旦那さまのせいえき、赤ちゃんをつく\nる種……！　……あっ！　お、おまんこにそそいでいただきたかったのに！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしの身体に……、あっ♪　肌にたっぷりと……！　い、いいのですか\nっ……？　あっ♪　……かけたかった？　……はぅっ？　精子をですかっ」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00022106_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……それなら……！　だ、旦那さまのご希望でしたら、かまいません！　わ\nたくしに好きなだけ、赤ちゃんの種をかけてください！　あっ、すごいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604404" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ヌルヌルがこんなにっ……！　ふぁああっ♪　びちゃびちゃってかかるだけ\nで、濃いにおいが広がって……あぁ、えっちです、すごくえっちで……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あぁあああっ……♪　精液をかけられてイキますっ♪　んっ♪　んんんっ…\n…！　おまんこが、おまんこが切ないですっ……んぁあああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604406" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ふぁあああ……♪　旦那さまのにおいに包まれて、頭がぽーっとしてしまい\nます……。ふふふっ、急にいたずらがしたくなったのですか？」", "NORMAL" ]},

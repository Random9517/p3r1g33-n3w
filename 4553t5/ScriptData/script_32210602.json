		{"command":[ "SETIMAGE", "0", "still_00022106_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あっ♪　白い水たまりができてしまいますっ……！　だめっ、わたくしのお\nまんこの中にください！　んんっ、ああっ、ありがとうございますぅうっ」", "NORMAL" ]},

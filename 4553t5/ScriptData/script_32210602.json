		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あっ、うぅううっ♪　あっ……！　勢いがすごすぎてっ……きゃぁあっ♪　\n中から溢れだしてしまいましたぁっ……！　受けとめきれず……っ！」", "NORMAL" ]},

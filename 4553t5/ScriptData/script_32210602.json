{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0188" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまっ、旦那さまっ。ここが結婚式場……というところなのですね。な\nんて美しくて、清らかで、キラキラした場所なのでしょうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604101" ]},
		{"command":[ "SETCHARA", "0", "char_00022106_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あそこも、ここも、見たいところばかりです……！　旦那さまはどこがお気\nに入りですか？　……あっ♪　ど、どうしたのですか？　突然っ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604102" ]},
		{"command":[ "SETCHARA", "0", "char_00022106_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしを後ろからだきしめて……。……え？　なによりも、ウエディング\nドレスのわたくしに目を奪われた、ですか？　そ、それでしたら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604103" ]},
		{"command":[ "SETCHARA", "0", "char_00022106_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「こ、こちらにいらしてください。……はい♪　ここには誰もいませんから、\nそ、その……２人きりで、ゆっくりできるかと……♪　いいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604104" ]},
		{"command":[ "SETCHARA", "0", "char_00022106_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「お式の会場のベンチで、２人きり……。うっとりしてしまいます。旦那さま\n？　おひざにのってほしいのですか？　それなら、失礼いたします♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604105" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……ぁ……♪　そう、だったのですね。もうおちんちんさんが、硬く大きく\nなってしまって……？　それなら、ばれないように……どうぞ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「んっ……！　あっ♪　せ、聖なる誓いの場所で……ああああっ♪　いけない\nお誘いをしてしまった悪いおよめさんのわたくしを……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604107" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あんっ、深く犯して、あいしてくださいぃっ……！　んぁああっ♪　だ、旦\n那さまったら、こんな場所でもすごい度胸です、いつも以上に硬くなさって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604108" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしの中……っ、あ、ぁっ♪　おまんこをしっかりとつらぬいています\n……！　ながくて、ふとくて、強いおちんちん……！　感じますぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あんっ♪　あん、あんっ、んんんっ……！　だ、だめです、か、かんじすぎ\nて……！　旦那さま、どうかわたくしをしっかりささえていてください！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604110" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「でないと……あっ♪　わ、わたくし、お、おちんちんを入れていただいただ\nけで、も、もうイッてしまいそうなのです、が、がまんしているだけで！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「も……もうっ、……あああああっ♪　ご、ごめんなさいぃっ♪　今軽くイッ\nちゃいましたっ、恥ずかしいです、……あっ、またイッちゃいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さま……旦那さまぁっ……♪　きょ、今日のわたくしはおかしいかもし\nれません、お式をする大切な場所だと思うと……身体が熱くなってっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604113" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「お、おまんこが、中がくちゅくちゅに濡れてしまいます……！　わ、かりま\nすよね、ぐちゅぐちゅになっているの、伝わってしまっていますよね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604114" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……んんんんっ♪　き、気持ちがよすぎるんですっ……！　あぁああっ、か\n、勝手に身体がびくびくして、ぶるぶるして、お、おまんこがっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604115" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「うねうねして……おちんちんにからみついて！　ゾクゾクしてとめられない\nんです！　な、なんてはしたない……あっ！　あっあっあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「は、はいぃっ、う、動いていただいていいです、もちろんですっ……。でも\nっ……！　ふぁあああっ♪　またイッちゃいました、あっ、な、なんでっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604117" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしの中っ、ずーっとぴくぴくしてっ……！　あぁううぅうっ……！　\n足がもうがくがくでっ……！　あんっ！　あんっ、ひ、ひびきますっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「おちんちんの形が、熱さが、はっきりわかるんです……！　あんっ♪　わた\nくしの赤ちゃんをつくるばしょ、赤ちゃんのおへやをノックしてます！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ちっちゃなおまんこの穴、太いおちんちんにひろげ、られて……♪　あっ、\n赤ちゃんのおへやに直接キス、されて……興奮がとまりません……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ど、どうして旦那さまは……あっ、旦那さまのおちんちんはこんなにかんぺ\nきに、わたくしを気持ち良くできてしまうのですか？　こわいくらいですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604121" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……あっ♪　あぁっ♪　わ、わたくしが腰を揺らしている……？　そ、そう\nです……、あんっ、もっともっと旦那さまをかんじたくて……あああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604122" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「じょ、じょうずにできません、けれどっ……。必死に腰をふってしまってい\nます、おちんちんにご奉仕したいんです、……あっ、ああああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「何度も何度も絶頂しながらっ、イ、イッてしまいながら、ぴくぴく痙攣して\nいるおまんこでっ、およめさんおまんこで旦那さまのおちんちんを締めてっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604124" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「しめつけて、せいえきをおねだりしているんですっ……。んぁああっ、ゆさ\nゆさして……、あっ、で、でも、じょうずにできなくて……。……え？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……んぁんんんっ！？　だ、旦那さまっ！？　あっ！？　旦那さまが腰を振\nると！　わたくしが振るのより何倍も動いてっ……つ、つよくてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604126" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あんっ！　か、簡単にイかされてしまいますぅううっ！　……あっ！？　す\n、すごいっ、すごいです、おとなの男のひとのおちんちんすごいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしの身体、支えながらっ、そのうえでぐちゅぐちゅかきまわしてくだ\nさいます！　あんっ！？　んんっ、う、うそ、身体が浮いちゃうくらいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「そんなに激しく愛されてしまったらっ……！　わたくし、もう全身とろとろ\nです、めろめろでっ……。おまんこきゅんきゅんうずいてしまってっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604129" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あぁっ！　あぁああっ♪　旦那さまっ！　すてき、すてきです、旦那さまっ\n……♪　もっと、もっと突いてくださいっ、だいじょうぶですからっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしをっ……あんっ♪　旦那さまだけのわたくしに、してくださいっ…\n…！　あっ♪　旦那さませんようのおよめさんに……！　あっあっあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「も、もうっ……♪　旦那さまにならなにをされてもいいですっ！　すきっ…\n…すきですっ！　あっ……♪　ううぅうっ、イッちゃいますっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604132" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あっ、あああああっ……！　……んんっ！？　い、今、おなかのなかで……\nおまんこの奥でおちんちんがびくびくってけいれんして……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あっ♪　腰の動きもどんどんはやく……！　あ、お射精ですかっ？　ぴゅっ\nぴゅの準備ができたのですねっ、わたくしは……とっくに完了しています！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604134" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「どうか、どうか一番奥でっ……！　わたくしの赤ちゃんのお部屋にびゅーし\nてくださいっ！　中にせいえき、精液くださいっ！　ここですぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「っあああああああぁっ♪　んぁあああああぁっ……♪　びゅくっ、びゅるっ\n、びゅぅっ、びゅーっと……！　い、命の種のほとばしりがっ……あぁあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604136" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_07" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「そのまま、ずーっとずーっと出してください！　旦那さまのお射精を直接ね\nんまくで感じながら……わたくしも、わたくしもいちばん大きくイキます！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604137" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「イクっ……！　イクぅううっ！　んぁああああっ♪　だいすきな旦那さまの\n、おっきなおちんちんからびゅーびゅーせいしが注がれてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604138" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしのおなかがいっぱいに……！　あんっ！　すごく満たされていきま\nす……！　あぁっ、ミチミチになるまでつめこまれて……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604139" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゅ、ひゅごいぃいい……♪　もうわたくしのちっちゃなおまんこは♪　旦\n那さまの色に染めあげられてしまいました、こんなにも……っ♪　あぁあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604140" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……ふぅうううっ……♪　ふーっ♪　ふーっ……♪　ふぅううっ……♪　…\n…あ……っ。せ、せっかく出していただいたせいえきが、逆流して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604201" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「少しもれてしまいましたっ……。ぁ……、太ももをつたって、ベンチにこぼ\nれて……。もったいないです、申し訳ありません……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……もれた分はまた入れればいい？　あっ♪　い、いいのですか？　そんな\nぜいたくなこと……♪　もう一度、このまま抱いていただけるのですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604203" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ぜ、ぜひおねがいしますっ……！　そうですね、何度でもおなかにぴゅっぴ\nゅしていただけばいいのですよね！　旦那さまは賢いですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「どうかわたくしに、もっともっとせいえきをぴゅっぴゅしてください、そし\nて赤ちゃんの種で、わたくしをはらませてくださいませ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604205" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「っあっ……♪　まずはやさしく、せいえきでいっぱいになったわたくしの中\nを……んんんっ、ゆっくりかきまわして、いくのですね……っ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604206" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さま……♪　こんなに出してもまだ、おちんちんさんが大きなまま……\n♪　そんなにドレスに興奮してくれているんですね……♪　んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしがっ♪　ウエディングドレスを着るのは旦那さまのためだけですっ\n、ですからっ……！　安心して、赤ちゃん２人でつくりましょう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ん、お式の場所で……、ふぁっ♪　愛を誓う場所でつくった赤ちゃん、きっ\nと世界で一番かわいいですのっ♪　だから、今日にんしんさせてくださいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……あああぁっ♪　今の言葉に、おちんちんが反応してました♪　こういう\n風に言われるのがお好き、なのですねっ……。あっ♪　赤ちゃんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604210" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまの赤ちゃんがほしいですっ♪　いっぱいおまんこでえっちしてくだ\nさいっ、旦那さまのおちんちんでほぐして、せいし注いでくださいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「っんんんんん～っ……！　動き、がっ♪　どんどんはやくなってっ♪　あっ\n♪　さきほどの精液のヌルヌルで、すごいスピードです、あっ！　あぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ぐちゅっ、ぐちゅってえっちな音がしてますっ！　あっ！　聞こえ、ちゃい\nますのっ……！　愛し合っている音が、あっ♪　式場の方々にっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604213" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あんっ♪　いいですかっ？　赤ちゃんつくっているところっ、皆さまに見て\nいただいてもっ♪　わたくしはかまいません、神聖な儀式ですからっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「愛し合う２人で、……あぅっ♪　あかちゃんっ、赤ちゃんつくるところ、み\n、皆さまにも見てほしいですっ！　あんっ！　旦那さま、つよいぃいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604215" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「おちんちん、つよいですっ！　あっ！　あっ！　身体ががくがく揺れてっ…\n…！　あっ♪　本気なのですね、うれしいです、もっとしてくださいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「っあぁあんっ♪　んぁあああっ、おちんちん、ひゅごいですっ！　すごいっ\n……！　気持ちいいですっ……！　あっ♪　気持ちいいっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604217" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまっ……！　わ、わたくし、またイッてしまいそうですっ……！　あ\nのっ、いっしょにっ……！　いっしょにイッていただけませんかっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ふたりでっ……！　２人でイキたいのですっ……！　あっ♪　いっぱいいっ\nぱい締めつけますから……どうか！　あっ、も、もう……もうっ♪」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あっ！？　あっ！？　あっ……。こ、こんな量、は、はじめてですのっ……\n！　あ、ああああああっ……！　イクっ……ずっとイッてますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あぅっ♪　せいえき、おもらししているみたいに……♪　ひゃんんっ♪　ド\nロドロがあふれて、どんどん足をつたいおちて……っ！」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00022106_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あ……あぁああ……。み、見てください……♪　旦那さま、わたくしのおな\nかがぽっこり……。なんだか、さすってあげたくなっちゃいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604307" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「よし、よし、よしよし……なんて、もう、赤ちゃんができたみたいでとって\nもうきうきしてきました……♪　赤ちゃん、パパですよ～……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604308" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……♪　ふふふ、旦那さま。わたくしがつかれていないか\n、心配してくださっているんですか？　たしかにたくさんイキました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604309" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ですが、これはしあわせな疲れ……。これからも妻として、およめさんとし\nて、精進しつづけるためにも、たくさんけいけんを詰んでおきたいのです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604310" ]},

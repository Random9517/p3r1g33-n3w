		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「んっ……。せっかく中に出していただいた精液が、流れ出してしまったこと\nは少し……残念ですが、旦那さまのその嬉しそうなお顔……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0604408" ]},
		{"command":[ "SETIMAGE", "0", "still_00022106_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「いっぱいいたずらをして、楽しかった子どものようでとてもとても愛おしい\nのです。あぁ……♪　赤ちゃんを作る前に、旦那さまに母性を感じるなんて」", "NORMAL" ]},

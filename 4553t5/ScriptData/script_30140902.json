		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ふああああっ、入って、きた……んっ、ふっ、あっ、凄い、最初から、がつ\nがつって、腰が当たって……んっ、んんっ！！」", "NORMAL" ]},

		{"command":[ "PLAYVOICE", "v2_014_0904108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あっ、腕を掴まれて……本当に何もできない……んっ、あっ、オチンポ、当\nたってる……んんっ、どうぞ……私のオマンコ、使ってください」", "NORMAL" ]},

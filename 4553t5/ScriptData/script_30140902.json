		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「それに……私の中にあるオチンポ、まだ硬いままですよ……んふっ、顔を見\nなくても分かります……ね、もう一回、します？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ふふっ、本当は私の同意なんかなくていいんですよ。今の私は、あなたに好\nきにされる女ですから……したかったら、動いて、あんっ！！」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00001409_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、んっ……オチンポ、出したばかりなのに硬くて、熱くて……\nんっ、私のオマンコ、またごつごつ突かれてる……んうっ！！」", "NORMAL" ]},

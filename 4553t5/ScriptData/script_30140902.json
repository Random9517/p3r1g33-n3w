		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「そう、そうですっ、んっ、はあっ、んんんっ！！　好きに動いて、あんっ、\nあっ、あなたの欲望を、私にぶつけて……んんっ！！」", "NORMAL" ]},

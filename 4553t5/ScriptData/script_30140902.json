		{"command":[ "SETIMAGE", "0", "still_00001409_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あんっ、ああっ、あっあっあっ、んっ、あなたも、興奮してるのがわかりま\nす……なんだか、オチンポが大きくなってる……んっ」", "NORMAL" ]},

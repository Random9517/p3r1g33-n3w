		{"command":[ "SETIMAGE", "0", "still_00001409_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、くうっ！！　オマンコの奥、ごつごつ叩かれて……ふあああ\nっ、あっ、逃げられない……んっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},

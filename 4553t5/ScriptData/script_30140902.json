		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んふうううっ、オチンポも、あなたのオチンポもまた、膨らんできて……ふ\nうううっ、出すんですね、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904217" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「私のオマンコに、また出してくれるんですね！！　ほっかほかで、ねばねば\nで、濃いザーメン、また私に……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「いっぱいいっぱい出してくれるんですね……んっ、ふうっ、嬉しい……私に\n出してくれるの、嬉しいっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「イって、イって！！　私も、私もあなたのオチンポでイきますから、あなた\nも、私のオマンコでイって！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904220" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_12" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んんんんんんんんんんんんんんっ！！　あっ、はあっ、はっ、出てる……さ\nっきよりも大量に、オマンコに出てる……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ふううううっ、奥の、赤ちゃんの部屋に、あなたのザーメン、いっぱい出て\nる……んくうっ……ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904302" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「オマンコが、ごくごく飲みこんでるの、分かるでしょう？　あなたのことが\n好きだから、そんな風に動いてるんですよ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904303" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あんっ、今の言葉でまた出てきた……ふふっ、あなたも嬉しく思ってくれた\nんですか……？　あんっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904304" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「答えなくても大丈夫ですよ。オチンポの動きで分かりますから……んっ、は\nっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んっ、そうやってぐりぐりされたら、またオマンコ溶けちゃう……ふうっ、\nうっ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「もう、オマンコの中、あなたのザーメンでいっぱいになっちゃいました……\nこれ、絶対できちゃいますね、赤ちゃん」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ふふ……女の人を拘束して、逃げられないように後ろから入れて、中出しす\nるなんて、ひどい人……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「なんて、私が望んだんですからね。あなたも興奮してくれて、嬉しいです。\n気にしないで」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「だから……今度はもっと激しく、責めて下さいね……？　それで、私にあな\nたの赤ちゃん、産ませて下さい……待ってますよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あんっ、ああっ、オチンポ、抜けて……んふうううううううううううっ、ん\nっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ザーメンが、背中に……んんっ、んっ、あっ、凄い、べったりと貼りついて\nきてる……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904402" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、背中にザーメンパックされてる……んっ、ふっ、お肌、かぴか\nぴになっちゃいそう……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904403" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あんっ、ふっ……全部、出ましたか？　私の身体にザーメンパックして、満\n足しましたか？　ふふ……いいんですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904404" ]},
		{"command":[ "SETIMAGE", "0", "still_00001409_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「私はあなたのものなんですから、あなたの好きなように……背中でも、顔で\nも、髪の毛でも、お尻でも……もちろん中にでも」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「好きな時に、好きなところに出してくれていいんですよ……私が、望んでる\nんですから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あなたに後ろからされて、本当に気持ちよかったんですから……こうしてザ\nーメンシャワーされても、気持ちよかったです……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「本当の気持ちですよ。そうじゃなきゃ、こんな風にならないですから。こん\nな風にあなたに身を任せませんから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「いつでもどこでも……どんな風にでも、あなたにされるなら、気持ちいいし\n幸せです……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0904409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「だから……またこういう風にしてくださいね。私、それを想像するだけでま\nた気持ちよくなっちゃうぐらい、あなたにしてほしいんですから」", "NORMAL" ]},

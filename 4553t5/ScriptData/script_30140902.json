		{"command":[ "SETIMAGE", "0", "still_00001409_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あうっ、そんなに力を入れて掴まれたら……んふうっ、腕も、気持ちよくな\nっちゃう……んっ、あなたに掴まれて、あんっ！！」", "NORMAL" ]},

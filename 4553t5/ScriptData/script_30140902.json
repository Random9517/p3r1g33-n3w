		{"command":[ "SETIMAGE", "0", "still_00001409_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「もっと、もっと……！！　私、今ならあなたにされるがままだから……なん\nでも受け止めるから……もっと好きに突いて……んんっ！！」", "NORMAL" ]},

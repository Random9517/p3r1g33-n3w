		{"command":[ "SETIMAGE", "0", "still_00001409_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ふうううっ、んっ、奥が押し潰されて……んっ、はあっ、あっ、お腹の中、\n全部がオチンポで満たされてる……んっ、ふうっ」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「なんでも……なんでも命令してください。私、従いますから……ご奉仕しま\nすから……ね？」", "NORMAL" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ふっ、んっ……どうしたんですか？　ほら、目の前に逆らえない女がいるん\nですよ……あなたの意のままにできる女がいるんですよ……」", "NORMAL" ]},

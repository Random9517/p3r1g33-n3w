{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0041" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「この卑怯者っ！　カツマさんを人質に取るだけじゃなく、身体を操るだなん\nてっ！　今すぐ解放してくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303101" ]},
		{"command":[ "SETCHARA", "0", "char_00001503_01", "5", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっ……カツマさんを助けて欲しかったら、貴方の言うこと聞けばいいの？\n、分かったわ……貴方の言う通りにするっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303102" ]},
		{"command":[ "SETCHARA", "0", "char_00001503_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「それで、私は今から何をすればっ……えっ！？　こ、この場に跪いて、おっ\nぱいを露出させるのっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303103" ]},
		{"command":[ "SETCHARA", "0", "char_00001503_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「しかもカツマさんのオチンポを谷間に挟み込んで、パイズリしろだなんてっ\n……！　わ、分かってるっ！　ちゃんと命令に従うからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303104" ]},
		{"command":[ "SETCHARA", "0", "char_00001503_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「くぅぅっ……カツマさんのオチンポ、すっごく熱いっ……こんなに大きくて\n、カタいだなんてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303105" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「それにヘンな匂いがするっ……この匂いを嗅いでるだけで、頭がクラクラし\nちゃうよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あんんっ！　や、やめて、カツマさんっ！　そんなにオチンポを口元に押し\n込まないでぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303107" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「み、皆が見てるのにっ……こんな公衆の面前で、パイズリするだなんてっ…\n…ハ、ハレンチすぎるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっ……私がパイズリしなかったら、カツマさんの身体だけじゃなく、意識\nまで乗っ取るって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303109" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「今のカツマさんには、ちゃんと意識があるのっ！？　そんな……やっ！　イ\nヤぁぁぁっ！　み、見ないで、カツマさんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303110" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「私、こんなことしたくてしてるわけじゃないのっ！　こうしないと、貴方の\n命がっ……あっ、あんんっ！　ひゃ、あはぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「お、おっぱいにオチンポが擦れるぅ！　やっ、イヤっ！　勝手にオチンポ動\nかさないでぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「無駄口を叩いてないで、さっさとパイズリをしろ？　うぅぅ……わ、分かっ\nたわ……おっぱいで、オチンポシコシコするねっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303113" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んっ、ふぁ、あっ！　ぐっ……あぅっ！　熱いっ……擦れば擦るほど、オチ\nンポ膨らんでくるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303114" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「血管が浮き出て、谷間の中でヒクヒク跳ねてるっ……それに、先端から透明\nなお汁がっ……確かこれ、先走り汁って言うんだよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303115" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「お、男の人が気持ちよくなると出るっていう……カツマさん、私のおっぱい\nで感じてくれてるんだっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「きゃんんぅ！　な、なにっ？　もっとたくさん、先走り汁が溢れてっ……！\n　えっ？　こんな生ぬるいパイズリだと、射精できないの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303117" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「そんなこと言われてもっ……私、パイズリなんて初めてするからっ……んっ\n、んんっ！　くっ、はふっ、んぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……！　前に呼んだエッチな本だと、オチンポの傘のところを\n擦るといいって、書いてあったような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303119" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっと、こう、かな……んっしょっ！　んっ、んぐっ！　はぁ、あっ、ふぁ\n、あぁぁっ！　あっあっあっ、んはぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303120" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あんっ……先走り汁が谷間にこぼれて、どんどん滑りがよくなってるっ……\nおっぱいを動かすと、くちゅくちゅっていやらしい音がしてるよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ふぇっ？　その調子でパイズリしながら、チンポを口に咥えるのっ？　そ、\nそれって、フェラチオしろってことっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303122" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「皆が見てる前でパイズリするだけでも恥ずかしいのに……フェ、フェラチオ\nもだなんてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303123" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「フェラしないと、カツマさんの命はない？　ま、待ってっ！　やるっ！　私\n、ちゃんとフェラチオするからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303124" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「うぅっ……ごめんね、カツマさんっ……痛かったら言ってくださいねっ……\nんっ、ちゅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303125" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ちゅぶっ、じゅるっ……れろっ、れろぉっ……ちゅばちゅぶ……むっ、ぢゅ\nるっ……ぢっ、るっ……れりゅ……んるっ……れるるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303126" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んっ、ぢゅ……くっぷっ！　うぅっ……オチンポ苦いぃ……先走り汁もねち\nょねちょひてて、ヘンら味がしゅるよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「れも、我慢ひないとっ……命令に逆らっひゃら、カツマひゃんの命がっ……\nずずっ！　じゅるぢゅるっ！　ずずぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ぷぷっ、ぢゅっぷっ！　ふぇ……？　もっひょ唇を窄めへ、擦りゅように出\nし入れしゅればいいのっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303129" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっと……こうかにゃ……ぐぽっ！　ぢゅぶふっ！　ぐぽぐぽっ、ぢゅ、じ\nゅるるっ！　ぐぽぽっ、ぢゅぼっ、んぽぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303130" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「うっぷっ！？　ぐっ、んぷっ！？　先走り汁がっ……ぴゅっぴゅって、口に\nょ中れ飛び散ってりゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「そりぇが唾液や舌と絡みあっへっ……んぐちゅっ！　れりゅ、れろろっ！　\n喉まれドロドロになっちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あぐぶっ！？　ぷっ、んぶふぅ！？　な、なにっ！？　オチンポが大きく震\nえへっ……！？　で、出る？　出るっへましゃか、せーしっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「こにょまま私にょ口に出しゅから、全部受け止めろらなんへっ！？　やっ、\nま、まっへくらはいっ！　心にょ準備がっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んむぅ～～～っ！？　ぐっ、うぶぅぅぅっ！　ぢゅぶっ、じゅぶぶっ！　オ\nチンポ、膨らんれっ……な、何かくりゅうぅぅぅっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303135" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_05" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ごぶっ、ぢゅ、じゅるるっ！？　口にょ中に、ドロドロひた熱い液体がぁっ\n！？　こ、こりぇ、せーしらのぉ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ぐっ、あぶっ！　うっぶっ！？　量が多すぎへ、口れ受け止めきりぇないっ\n……もう、吐き出ふひかっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ぢゅ、じゅぶぷっ！？　こぼしたら承知しないらんへっ……じゃ、じゃあ、\nどうしゅればいいのっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「受け止めきりぇないなら、飲み干せばいいらなんへっ……！　うぅぅっ！　\nせ、せーしを飲むらなんへっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「れもっ……カツマひゃんを救うためらものっ……全部、飲まないひょっ……\nんっ！　んっ！　んっぐっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ぐっ……ごくっ……ごくんっ！　ぷっ……ふっ……まりゃ、口にょ中に精液\n残っへりゅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「こりぇも、飲まないひょ……せーしこぼれひゃうっ……ぢゅるるっ……じゅ\n、ぞっ……ぢゅるるっ、ちゅるぅぅぅ～っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んぐんぐっ……ごっ、くんっ！　ぢゅ、んっぐっ……ぷはっ……はぁ……は\nぁ……これで、じゅうぶんれひょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303203" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「少しこぼれてりゅけど、許してやる？　な、なりゃ、早くカツマひゃんを解\n放してっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっ……カツマさんにょ身体は、まだ満足ひてない？　もっひょオチンポを\nシゴいたり舐めひゃりひて、射精しゃせろだなんへっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「そんらっ……ま、まだパイズリとフェラチオひないといけらいのっ……！？\n　さっきの射精れも、しゅごくキツかっひゃのにっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303206" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「れも、カツマさんを救うためらものっ……ここで屈すりゅなんてれきないっ\n！　や、やってあげりゅんらからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303207" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ずずずっ、じゅ、じゅぞぉ！　ちゅちゅ、ぢゅるっ……れろれろっ、んっ、\nじゅろぉ……くちゅくちゅ、ずっぷっ……ぢゅぶぢゅぶ、じゅぽほぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303208" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「うぅっ……唾液と精液が、谷間に垂れへっ……オチンポにょ隙間かりゃ、し\nゅごい匂いがしゅるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「臭くて、いやらしい匂いらのにっ……どうひてオマンコの奥が疼いひゃうの\nっ……！？　ぢゅるるっ、むちゅ、くっぷっ！　ぐぢゅぶぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んぱっ、ちゅ、くぷはぁっ！　はぁ……はぁ……精液の味が、口いっぱいに\n広がっへっ……苦いにょに、クセになる感じがしゅるぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303211" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「私にょ身体っ……どうひちゃったのっ！？　エッチな本を読んでりゅ時は、\nこんなふうになりゃなかったのにっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「本物にょオチンポを味わっへ……ザーメンを飲んだりゃ、こんなにも身体が\n熱く、火照ってきへぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「お、おっぱいをシゴく手も、勝手に速くなっへりゅよぉ……ぶちゅちゅ、じ\nゅ、じゅぞぉ！　ぢゅるぢゅるっ、じゅ、じゅるじゅっ！　むちゅうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303214" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ぐぽぐぽっ、ぢゅ、じゅぽほっ！　んっ、んぐぅ～！？　手だけりゃなくへ\n、唇も速く動いへっ……ぢゅ、じゅずずっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「しゅごくエッチれ、いやらひくへぇ……！　あ、頭が蕩けひゃうっ……！　\nオチンポにょ感触とせーしの匂いれ、ダメにしゃれひゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　ぢゅ、じゅるぅ！　らめっ……屈しちゃらめっ！　私が負け\nたりゃ皆をっ……カツマひゃんを守れないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303217" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「何があっへも……どれらけ酷いことをしゃれへも、私は諦めないんらからっ\n！　ぢゅぢゅ、じゅるっ！　れろれろろっ、じゅぷろぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んっ、ぐっぶっ！？　ま、まひゃオチンポが口にょ中れ膨らんでりゅっ……\n！　ま、まひゃ、射精ひそうなんでふねっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303219" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ぞぞっ、じゅ、れろろぉ！　いい、れふよっ！　いつれも、出ひてっ……ザ\nーメン、どぴゅどぴゅひてくらはいぃぃぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んぐぷぅ～～～っ！？　ぢゅ、ぞっ！　ぢゅるぞっ！　じゅぢゅ……ぐっ、\nんぐふぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あちゅいの、いっぱいっ……お、お口にょ奥まれ、びゅーびゅー出へぇっ…\n…！？　ぐっ、おっ、おぇぇっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「喉に直接注がれてりゅ感じがっ……ぐ、ぐるじっ……！　息、れきないよぉ\n……！　ぐぽっ、ぐっぽっ！　ぢゅ、ずちゅるるるぅ～～～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「そ、そうだっひゃ……！　精子を飲まにゃいひょ、カツマひゃんの命がっ…\n…んっぐっ！　ごくっ……ごくっ……じゅ、ぢゅぞぞっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303304" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「んぐんぐっ……ごくっ……じゅるじゅるるぅ～～～っ……こくこくっ、ごっ\nくんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「ちゅ、ぱっ……んぱっ……くっ……ふぅ、ふぅ……こ、こりぇれ、いいんれ\nしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303306" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「約束通り……んっ、ちゅぷっ……カ、カツマさんを解放ひてっ……えっ？　\nまだまだこの身体れ楽しませてもらう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「カツマさんの性欲は人一倍で、これくらいの射精れはオチンポの勃起がおさ\nまりゃないの……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「そ、そんらっ……私、もうお腹いっぱいれっ……こりぇ以上、せーし飲めな\nいよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「上の口がダメなりゃ、下にょ口がありゅ？　そ、それっへましゃかっ……セ\n、セックスしゅるってこひょおぉ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「きゃあぁぁぁっ！？　オ、オチンポが口から外れてっ……！？　か、顔に精\n液かかってるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あ、熱いっ！　こんなの浴びてたら火傷しちゃうっ！　それに男の人のザー\nメンって、こんな勢いで出るのぉ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「やっ、あっ！？　谷間にも精子が垂れてっ……濃い匂いが、もっと濃くなっ\nてきてるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「あぁぁぁ……この匂い、本当にダメぇ……頭がおかしくなるっ……オマンコ\n、ジンジンするぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「精液を浴びたら発情するなんてっ……こんなこと、本に書いてなかったよぉ\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……やっと、射精が終わったみたいねっ……オチンポも少し小\nさくなってるかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303406" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「今の内にカツマさんを正気に戻せばっ……きゃあぁっ！？　な、何でまだお\nっぱいにオチンポを擦りつけるのっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303407" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「えっ……この身体の持ち主は、まだまだ私を犯したがってる？　今度はおっ\nぱいや口じゃなくて、オマンコを味わいたいと言ってる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303408" ]},
		{"command":[ "SETIMAGE", "0", "still_00001503_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「カ、カツマさんはそんなこと言わないからっ！　わ、分かったわ！　貴方、\nカツマさんの身体だけじゃなくて、心も操ってるのねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_015_0303409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アルルカン" ]},
		{"command":[ "SETTEXT", "「絶対に許さないんだからっ……！　待っててね、カツマさんっ……すぐに助\nけてあげますからっ……！」", "NORMAL" ]},

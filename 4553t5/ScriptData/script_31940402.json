		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あっ……あぁぁぉっ……！　またっ……中出し……来てるっ……おふぁっ…\n…ドプドプっ……流れ込んでるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404301" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁぁぁ……足を……離さないっ……たっぷりの種付けファックぅ……しっ\nかりと受精するぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んんっ、あぁ……オマンコの奥でチンポが震えている……んっ、ビクビクし\nてるチンポ……気持ち良すぎる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁぁ……子宮に届けてぇ……ワタクシと貴方の赤ちゃん……このセックス\nで孕ませてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404304" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あっ、んちゅぷぅ……とどめのキスぅ……はへぁぁ……ずっとイッたまま…\n…降りられない……気持ち良すぎるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ、ふへぁ……はふっ、あぁっ……出し切ったか……射精……しき\nったな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404306" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あふっ……満足なんてものじゃない……ワタクシの欲望に全て応えてくれて\n……大満足だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んっふ……貴方がこれほどまでに興奮してくれたなら……この姿は天の配剤\nとも言える最高の物かも知れないな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「今も高揚した気分がワタクシの中をうねっている……もう少しの間……しっ\nかり抱きしめていてくれ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んむ……あぁ……しっかりと分からされた……これからもチンポでの躾……\nよろしく頼む……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あぁぉぉぉぉぉっ！　チンポっ……抜けた……？　あっ……ザーメン……身\n体にっ、掛かってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404401" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_13" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んふぁぁ……あったかいのが……お腹ぁ……おっぱいにも……どんどん溢れ\nて来る……んへぁ……もっとぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あぁ、粘っこい……子種がたっぷり詰まった精子……少し勿体ない気もする\nが……マーキングされるのも悪くない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404403" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「そうだな……もう中出しはされているし……外側からも貴方の精液漬けにさ\nれる……それもいいかも知れない……んふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はふぁ……あぁ……止まった……んっ、後は……チンポの先に付いてる精液\nもちゃんとワタクシのお腹に塗りつけてくれ……そうだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んっ、たっぷり出したな……流石にもう打ち止めか。いや、\n予想以上に出してくれた……大満足だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「どうだった……ワタクシの腰の使い方……悪くなかったか？　そうか、最高\nか……ふふ……それならばよい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404407" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「やはり逆バニーは刺激的なのだろうな。元々のワタクシの姿も、露出度は十\n分あるとは思うが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「これは改めてオスの本能を刺激する特別な姿ということかも知れん。ふふ…\n…ワタクシの気分も最高だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あぁ……だが、これでもまだ発情は止まらない……これからも、もっともっ\nと貴方のチンポには頑張って貰わないと……な♪」", "NORMAL" ]},

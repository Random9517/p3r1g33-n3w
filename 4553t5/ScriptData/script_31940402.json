{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「フフフ……待たせてしまったな。よくぞワタクシの呼び出しに応じてくれた\nな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404101" ]},
		{"command":[ "SETCHARA", "0", "char_00019404_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「もう多くを語らずとも察しはついているだろう。今度は逆バニーのワタクシ\n自らが貴方を誘ったのだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404102" ]},
		{"command":[ "SETCHARA", "0", "char_00019404_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「好きだろう……こういうシチュエーションが。分かるとも、そのスケベな顔\nが大好きに決まっていると訴えている」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404103" ]},
		{"command":[ "SETCHARA", "0", "char_00019404_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「ちょうど奇遇なことに、ワタクシもどうにも身体が疼いて発情が収まらなく\nてな……ならば、お互いに得しかないという訳だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404104" ]},
		{"command":[ "SETCHARA", "0", "char_00019404_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「さあ、理解したならば余計な講釈など必要あるまい。オスとメスの生々しい\nまぐわいを始めるぞ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_01" ]},
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「ンフフ……ほら、戸惑っているフリをしても、結局このチンポは分かりやす\nくイキった勃起を見せているではないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404106" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「さあ、取り繕うことはない。逆バニーのワタクシが据え膳となっているのだ\n。遠慮なく、そのぶっといチンポをオマンコに入れるといい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「そうだ……そのまま……んっ、あぁっ、おっ、はぁおっ……くっ、んふぅぅ\nぅぅんっ……は、入るぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404108" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「おっ、ほっ……はぁぁ……んっ、ズッポリ埋まってしまった……んむっ、ま\n、まぁまぁだな。悪くない……勃起具合だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404109" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「どうした……もっと動かしたいんだろう？　腰を使ってみたらどうだ……浅\nましい欲望に身を任せて、チンポを……おふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はっ、ぉっ、ぉんっ、あっ、おぉっ、はぉぉっ……ずりゅずりゅっ、おっ、\n来るぅっ……おぉっ、チンポっ……ぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404111" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁぅっ……んっ、ま、前よりも……太くなっていないか……？　き、気の\nせいか……オマンコが……広がっているような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んんっ、それだけ……締め付けがいい……んふぅ……そ、そうか……ワタク\nシのオマンコの具合がいいということだな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「ならば、もう迷うことはあるまい。んっ……この僅かに隠れた股間も、結合\nして丸見えなのだ……もっとワタクシを分からせてくれ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぉっ、おっ、ほぉぉぉっ……！　あぁぉっ、そ、そうだっ……くぅっ、ん\nんっ、チンポっ……んふぅっ、ピストンされてるぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404115" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んああっ、そうだっ……あぁっ、こういうのが好きなんだっ……発情しきっ\nたオスに覆い被されてっ、オマンコを貫かれるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はふっ、んんっ、そして……ワタクシは……このぶっといチンポを悦ばせる\n為にっ、必死でオマンコを食い締めるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はんっ、あぁっ、いいっ、ぬちゅぬちゅっ……音が鳴って……中をかき回さ\nれてることを実感するっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404118" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「もっと……あっ、そこぉっ、もっと……！　あぁっ、ポルチオぉっ……グリ\nグリ押し付けてぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404119" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「くっ……んんんっ、はぁぁ……んちゅぷっ……キスまで……んんっ、ワタク\nシがして欲しいこと……次から次へとされてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404120" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あふっ、あぁっ、おっぱいも……んっ、モミモミされてぇ……はぁんっ、こ\n、このままでは一方的にされるばかりだ……んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404121" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はっ、んっ……あっ、んぁぁっ……ワタクシも……まだまだ、簡単にはイカ\nないぞ……このエロチンポに反撃するっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んんっ、ふっ、んふぅぅっ……どうだ……？　このチン先を扱き上げる柔肉\nの感触ぅ……ずりゅずりゅ扱いて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404123" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「太いチンポをしゃぶり尽くすような腰振りぃっ……んふっ、ふんっ、んくん\nっ……ふふ……表情が変わって来たな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「当然だ……んっ、ぁぉっ……ワタクシの発情は……もはや、のっぴきならな\nい所まで来てしまっている……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「この感覚を少しでも共有したい……貴方のチンポにも極上の快感がもたらさ\nれるように……ワタクシの全力を尽くすのだっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んっ、ちゅぷっ、りゅぷ……またキスぅ……はぁ……んっ、そのまま、もっ\nと腰を振って……チンポに絡めていくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404127" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あぁっ……オマンコ……熱い……さっきより……もっと汁が溢れてぇ……止\nまらない……はぁぁんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「こんなにも気持ちいいことを……止められる訳がないっ……腰が浅ましくっ\n……ヘコヘコ動いてしまうぅっ……んぁぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁ……今のワタクシは、さぞ……いやらしい顔をしているんだろ\nう……口が開いて……舌を出して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404130" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「まるでケダモノさながらにっ、あぁっ、チンポを貪るっ……それがっ、堪ら\nないっ……！　んぁぁ……チンポっ、いいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ、あぁっ、もっと……もっと速くっ！　あぁっ、そうだっ……\nほぉぉっ、押し込み来てるっ……チンポッ、効くぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404132" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んっ、あぁっ、これは……マズいっ……気持ち良すぎてっ……も、もう……\nイクかも知れないっ、我慢……しきれないっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404133" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はひっ、あぉっ、貴方も……なのかっ？　だ、だったら先にっ……あぁっ、\nい、一緒でもいいっ、ワタクシが先なのはナシだからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404134" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「来てっ、出してっ……！　中にっ、熱いチンポザーメンっ！　ドピュドピュ\n出してぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んひぃぃぃぃぃぃぃんっ！　イッ……イグっ！　おぉぉっ、イグっ……オマ\nンコイグっ、くっ、んんんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404136" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁぁぁ……中に出されてる……あぁ、ドロドロのザーメン……子宮に届け\nられてるぅ……はへぁぁぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404137" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁ……んんっ、あっ、ふっ……！　あぉぉ……イッた……お、同じだった\nか……？　イッたタイミング……どうだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404138" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「そ、そうか……同じならいい……ささやかなワタクシのこだわりだ。先にイ\nカせられるより、ワタクシがリードしたかったのだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「だが……終わってみれば、それは些末なことだったな……この満たされた気\n分の前では、本当にどちらでも構わないことだった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404140" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んっ……あぁ……まだ、チンポがワタクシのオマンコの中で自己主張してい\nる……まだ出し足りないんだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「ワタクシも……もっと欲しい……たっぷりと中出しされているが、もっとも\nっとオマンコして欲しいのだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あぁ……まずは中出しされた精液を、しっかりオマンコに馴染ませてくれ…\n…はぁんっ、そうっ、円を描くように……かき混ぜてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ、ぐちゅぐちゅっ……いやらしい音がするっ……！　オマンコ\nっ、いっぱい突き回されてるぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404204" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁぁんっ、それだっ……あっ、気持ちいいっ！　一突きごとにっ、身体が\nジンジン痺れて来るぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んぁぁ……チンポ……硬いっ、あぁっ、あんなに出したのに……ずっとギン\nギンで……頼もしいオスチンポっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404206" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んふぅっ、あぁっ、そうだ……ワタクシはチンポが大好きだっ！　貴方のチ\nンポにメロメロでっ、発情しきっているのだっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404207" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「こんなことっ、姉妹たちには絶対に言えないっ……！　だがっ、この快感に\nは逆らえないっ……メスの本能が訴えているっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404208" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「逆バニーは……ワタクシの本能を呼び覚ますっ……あぁっ、オマンコ熱いの\nっ！　はぁんっ、ズチュズチュっ……チンポで犯されるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404209" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んはぁんっ、チンポそこっ！　あぉぉっ、そこもぉっ！　ワタクシのオマン\nコっ……弱点ばかりになってるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んぁぁっ……今なら、どんなハレンチなことでもしてしまうっ……ヘコヘコ\n腰を振ってチンポに媚びるっ、あっ、おぉおんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404211" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「りゅぷっ……ちゅぷっ、んじゅぷっ、んっ、はぁぁっ……いつも、一番欲し\nいタイミングでキスをしてくれるぅ……舌絡ませてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「りゅぱっ、あぁっ、おっぱいもぎゅっと押し潰されながらぁ……ま、またオ\nマンコぉ……あ、足がピンって伸びるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「あぁ……ダメだ……そんなに顔を覗き込んだら……ワタクシのだらしないよ\nがり顔を、そんなにマジマジと見ないでくれぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404214" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁぉ……おあぉっ……チンポぉっ！　あっ、また顔が……蕩けるぅ……い\n、今……チンポするのはっ、反則ぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「はぁんっ、あっ、あぁぁぁっ……ピストンがっ、更に激しくっ……！　ワ、\nワタクシを……イかせるピストンっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「らめっ、あぁっ、もっ……イクっ……イグっ！　はぁぁおっ……先にイカさ\nれてしまうっ、せめてっ……オマンコ締め付けるぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404217" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「んんっ！　あっ、あぁっ……チンポ……ビクビクって……貴方もっ、ギリギ\nリなんだなっ？　あぁっ、出してっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404218" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「ワラクヒとっ、一緒にっ、あひっ、イッてっ！　あぁっ、チンポっ……キュ\nンってするからぁっ、あぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "クロートー" ]},
		{"command":[ "SETTEXT", "「もっ、イグっ、おひぃぃぃんっ！　オマンコッ……イグっ……イッグぅぅぅ\nぅぅぅぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_194_0404220" ]},
		{"command":[ "SETIMAGE", "0", "still_00019404_02_07" ]},

		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「いつもと雰囲気が違う……？　そうですか……？　確かに……教壇に立って\nいる時の私とは……かなりイメージが違うかも知れませんね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603102" ]},
		{"command":[ "SETCHARA", "0", "char_00001606_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「ですが、今の私は……このオチンチン……いえ、オチンポ様に従順な……卑\nしい奴隷……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603103" ]},
		{"command":[ "SETCHARA", "0", "char_00001606_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んちゅっ……ちゅぷっ、はぁ……このキスだけで、もうダメです……腰砕け\nになって……オチンポ……おしゃぶりさせて下さいませ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603104" ]},
		{"command":[ "SETCHARA", "0", "char_00001606_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あぁ……もうこんなに……太くなって……んっ、今度は……オチンポへのキ\nスをお許し下さい……あぁ……ちゅぷっ、んっ……ちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603105" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はい……ご主人様のにおいがします……すごく強烈な……オスのにおいです\n……はぁぁ……吸い込むだけでイキそうな位……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603106" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んふぅっ……あぁ……血管がビクビク脈打って……こんなに反り返って……\nんっ、逞しくて……素敵です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603107" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はい……早速ご奉仕させて下さいませ……あぁんむ、ちゅぱ、ぴちゃ、れろ\n、んちゅぷ……んちゅぅぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「まず……口の中にたっぷりと溜まった唾液を……んりゅぷぅ……オチンポ全\n体に絡ませて参ります……んりゅっ、れろ、れるぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603109" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「亀頭が……濡れて、キラキラ光る位に……んちゅぷぅっ、くぷっ、はぷっ、\nんちゅぷぅぅぅ……んりゅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「満遍なく……オチンポを湿らせたら……今度は……その唾液を絡めた音を響\nかせながら……顔を上下させて……参ります……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「くぽっ、んふっ、じゅぱっ、りゅぶっ、んぶっ……じゅぷっ、ちゅぷっ、ん\nふぅっ……んじゅるるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、いやらしい音がしますか……？　はい……私の卑しい口から\n……漏れる、下品なオチンポを吸う音です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603113" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「じゅぱっ、お行儀の悪い……メス犬奴隷は……ちゅぷっ、どうしても……オ\nチンポをしゃぶると……よだれが止まらなくなって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「じゅるるっ、んふっ、んじゅぷっ……下品な音をさせてしまうことを……じ\nゅぱっ、お許しくださいまひぇ……じゅぱっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「ちゅぱぁっ……あふっ……！　んんっ、あぁ……はい、とても……美味しい\nです……ご主人様のオチンポ……れろ、汗と……精液が染み込んで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603116" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あぁ……んじゅるるっ、じゅぱっ……はぁぁ……舌が止まらなくなってしま\nいます……じゅるる……んちゅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「じゅぽっ、ぴちゃ……あぁ、そんなに……顔を覗き込まないで下さい……自\n分でも浅ましい顔をしていると……分かっています……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603118" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んんっ、くぽっ……絶対に教え子には……見せられません……こんな舌を伸\nばして……あぁんむ、オチンポに夢中になっているところなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あぁ……ぴちゃっ、でも……んっ、これが私の……本当の姿……ちゅぷっ、\nオチンポの為に何でもしてしまう……淫乱なメスぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603120" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んちゅぷっ、くぽっ、んぶっ、あふっ、んっふ……！　あぁ……おしゃぶり\nしてるだけで……身体が疼いて……堪らないんれふぅ……じゅぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「は……んんっ、あぁっ、んっ……もう、我慢……できません……んっ、あぁ\n……手が勝手に……はっ、んふっ……オマンコにぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んっ、あっ、はぁ……じゅぷっ、は、はい……ご主人様に断りもなく……オ\n、オナニーを始めてしまいました……あっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603123" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「ヌルヌルになったマン汁まみれのオマンコを……指であっ、んふっ、かき回\nして……んじゅぷっ、ちゅぷっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603124" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「敏感に……育った……ク、クリトリスを……つ、つまみ上げて……転がして\n……あひぃっ！　はっ、ひんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あっ、んじゅぱっ……申し訳ありません……わ、私ばかり感じているようで\nは……ちゃんと、オチンポにもご奉仕致しますから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603126" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「くぽっ、んふっ、りゅぷっ……はい……丁寧に舌を這わせて……れろ、んっ\n、えろぉっ……裏筋も、チロチロ……舐め回して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んっちゅ……ちゅぅぅぅぅっ……溢れた唾液を……吸い上げてぇ……じゅぽ\nぉっ……んじゅぷっ……んくぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁ、んちゅぷっ……ご主人様の……オチンポから……先走りが滲んで参り\nました……れろ、んちゅぷっ、くぷぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「こちらも……お行儀悪く……吸い上げさせて頂きまふぅ……んじゅっ、じゅ\nぷぷぅっ……んじゅるっ、んじゅぅぅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603130" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁっ……んちゅぷっ、あぁ……んっ、ビクビクが強くなってます…\n…んんっ、あっ、私も……オナニーが……感じて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603131" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あっ、ふっ……とにかく……ご主人様に射精頂いて……それからじゃないと\n……んっ、私だけ……イク訳には……んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁっ、んじゅぷっ……お願いしまふっ……早くっ……んりゅぷっ、出して\n下さいっ……！　んじゅるるっ、じゅぷっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603133" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「私の……口の中に……出してっ……ご主人様の……精液……飲ませてっ……\n下さい……ませぇっ……んじゅるるっ、じゅぷっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んんんんっ……！　ふぶっ……あぁぁっ、んじゅぷっ……んぐっ……いっぱ\nい……出して……いただいて……るっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603135" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んぐっ、んっく……こくんっ、んふぁっ……あぁ……これで私も……んんっ\n、イケます……はぁぁ……オナニーで……イクっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603136" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んちゅぷっ、ぷぁっ……はぁっ、はぁっ、あふっ……はい……全部飲ませて\nいただきました……あぁん……ご覧ください……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603137" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「とても新鮮で美味しい精液を飲ませて頂いて……本当にありがとうございま\nす……じゅぱっ……奴隷として……幸せです……ちゅぷ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603138" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はふ……はぁ……はぁ……んっ、ぺろっ……はい、ちゃんと後始末までさせ\nて頂きます……そのまま楽になさっていて下さい。ちゅぱ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603139" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んっちゅ……ちゅぷっ……はい、こちらで……れろ、綺麗になりました……\nんちゅぷっ、お疲れ様でした……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「れろ……ぺろっ……んっ、ふっ……あ……申し訳ありません……ご主人様の\n前で、またお行儀悪く舌なめずりなんかして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「えっ……いやらしい舌の動きに興奮した……？　ちゃんと責任を……は、は\nい……申し訳ありません……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603202" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あぁ……本当です。また……勃起がビクビク大きくなって……確かに、これ\nは私が責任を持ってお鎮めしなくてはなりませんね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603203" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「それでは……んっ、じゅぷっ……もう一度……オチンポへのご奉仕をさせて\n頂きます……りゅぷ、失礼……いたひまふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603204" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁんむ、くぽっ、りゅぷっ、んじゅるるっ……んちゅぷぅ……じゅぷっ、\nんりゅっ、くぽっ、ちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はい……んっ、精液の味が濃く残っていて……はぁ……ちゅぷっ、オチンポ\n全体が、より深みのある味わいで……最高でふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「れろ、くぽっ、んっ……れろれろぉ……んっ、ふふ……今……口の中で、ど\nうやって舌が動いているか……お分かりになりまふか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603207" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はい……尿道口をついばむようにして……舌先を尖らせて……ツンツンと…\n…つついて……それから……ちゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603208" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「続けて……んちゅっ、オチンポにキスを重ねながら……れろっ、んれろぉ…\n…皮の継ぎ目の部分……少しカスが浮いているとこまでぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「れろ……んりゅっ、舌で……丁寧にこそぎ取りながら……んじゅぱっ……オ\nチンポをお扱きしておりまふぅ……じゅぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はふっ、んくぷっ、はい……わらひの……んっ、口は……今……ご主人様の\nオナホールでございまふ……んじゅぷっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603211" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「淫らに躾けられた口マンコぉ……んりゅぷっ、舌も……オチンポを気持ちよ\nくさせるものとしてぇ……フル活用させていたらきまふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「ろうか……んじゅぷっ、わらひの……はしたない……お口ピストンっ……じ\nゅぷっ、じゅぽっ、エロスロートもぉっ……お楽しみくらひゃいっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「じゅぱっ、んじゅぷっ、あふっ……はひぃ……もっと……いやらしい表情に\nなってまふっ……あぁ……こんなところ絶対に見せられません……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603214" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「私は……風紀に厳しい……怖がられている女教師なのにぃ……あぁっ、こん\nら……淫らな姿で……浅ましくオチンポをしゃぶり続けてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「じゅぷっ、んじゅぱっ……ご主人様を……もう一回射精させようと……必死\nに、顔を動かしておりまふぅ……んじゅぱっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んっ、くぷっ、んはっ、あぁっ……また……カウパーが舌に出てまふっ……\n二回目の射精も……もうふぐっ……れふよねっ……？", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603217" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、また……オマンコもジンジンしていまふっ……あぁ……指ぃ\n……止まらない……もうすぐイキまふからぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あんっ、んふっ、んくんっ……ご主人様も……お好きな時に……射精……な\nさって下さいっ……口でも……おっぱいでもお好きなところに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603219" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はいっ、んんっ、出してっ……下さいっ……！　熱くて濃いのっ……もっと\nもっとぉっ、ドピュドピュっ……射精っ……してぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603220" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_05" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んっ、むぐっ、んぐんっ……んっふ……じゅぷっ……はぁ……んぁぷっ……\nこくっ……んっ、んふぅぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁぁ……まだ出てます……んっ、二発目なのに……すごい量……んぐっ、\nけふっ、飲みきれない位……じゅぱっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603303" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「こくっ、んくんっ……んはぁっ……はっ、はっ、はふぁっ、はっ……はぁぁ\n……あぷっ、んんっ……あぁ……止まりましたね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603304" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……申し訳ありません……少し口からこぼれてしまいました……\nいえ、ちゃんと舐め取りますから……ぴちゃ……れろ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603305" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「れろ……んちゅっ……はい……これで、ちゃんと飲みきれたと思います……\nはふっ、失礼いたしました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603306" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「えっ……わ、私の方はどうだったのか……ですか？　は、はい……ちゃんと\n……イ、イクことができました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603307" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「つまり……その、ご主人様のオチンポをおしゃぶりしながら……オナニーで\n、イキました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「奴隷姿が板についてきたなんて……そ、そんなことは……私は……まだまだ\nです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「もっと、ご主人様に気に入っていただけるように……これからも精進して参\nりますから……ちゅぱっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603310" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_02" ]},

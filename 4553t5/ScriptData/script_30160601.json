		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「むぶぅぅぅっ！　あぶっ……！　んぐっ……まひゃっ……出て……ま、ふっ\n……！　精液……まらぁ……！」", "NORMAL" ]},

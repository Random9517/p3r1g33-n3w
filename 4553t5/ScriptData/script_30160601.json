		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んぷぁっ！　あっ……顔っ……はひっ……！　精液……シャワー……ありが\nとう、ございますっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はぁっ、はい……浴びせて下さい……ドロドロの……精液……二発目ぇ……\nんぁっ、ちゅぷっ、はふぁ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あっ、ふっ……！　私も……イクッ……あぁ……オマンコ……イッてます…\n…ご主人様と一緒にぃ……あふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「あぁ……顔も……おっぱいも……ご主人様の精液にまみれています……メス\nとして……征服された気分です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603404" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んっ、射精……落ち着かれましたね……お待ち下さい……ここから、お掃除\nさせていただきますので……オチンポはそのままで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603405" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ、れろ、ぴちゃ……続けて……沢山出していただいて……オチンポ\n……お疲れ様でございました……れろ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603406" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「はい……ご奉仕を堪能していただけたのなら何よりです。まだまだ未熟で至\nらないところも多かったとは思いますが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603407" ]},
		{"command":[ "SETIMAGE", "0", "still_00001606_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「これからも、もっとフェラチオの技を学び、ご主人様に楽しんでいただける\nように務めて参ります……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_016_0603408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "明日楽" ]},
		{"command":[ "SETTEXT", "「んちゅぱっ……これで綺麗になりました。いえ……とんでもありません。こ\nれも雌奴隷としての大切な役目ですから……」", "NORMAL" ]},

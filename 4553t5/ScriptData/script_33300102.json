{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "cbg_0029" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00033001_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev330_01b_0000", "ev330_01b_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「今日使う道具はぁ……じゃーんっ！　これ、ペニスバンドでーす♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「おぉ……改めて思うけど、ついにここまで来たかって感じしない？　なんと\nいうか、一線を越える、みたいな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「これを使って、キミのアナルを滅茶苦茶にせめて可愛がってあげる♪　今日\nの為の準備は……してきたよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104103" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「シャワーでしっかりアナルは洗ってもらったし、ここ数週間かけて、穴はし\nっかり拡張済み」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104104" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「お尻でしっかり感じれる様に、前立腺の開発もばっちり！　後は本番あるの\nみ！　うふふ、覚悟は……いいよね？　私の可愛いマゾ彼君♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほーら、ベッドで四つん這いになってお尻をこっちに向けてー。普通の男子\nじゃたどり着けない気持ちよさ、味合わせてあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104106" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「……改めて見ると、四つん這いって、すっごく恥ずかしい格好だよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「自分からお尻を高く上げて、弱点を全てさらけ出しちゃって……オチンチン\nも、アナルも、キンタマも、ぜーんぶが丸見え」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、言葉にされると、余計に恥ずかしくなっちゃった？　顔が真っ赤にな\nっちゃってるよー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104109" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んー……お望み通り早く入れてあげたいけど、流石にもう少しほぐしてから\nじゃないと、気持ちいいより痛いが勝っちゃいそう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「だから、少しだけ指で慣らしてあげる。ローションを絡ませて……ほら、力\nを抜いて……大きく息を吐いて～……ふぅ～～、って」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んっ……色々準備しただけあって、指ぐらいなら簡単に入っちゃったね。で\nも、やっぱりアナルの締め付け、キツキツだねー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104112" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほーら、指を動かすよー？　力抜いて―、ゆーっくり息を吐いて―、吸って\n―……指をズボズボ～、ぐりぐり～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「このまま前立腺を軽く可愛がってあげてもいいけど……お楽しみは、取って\nおかないとね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、もう待ちきれない？　指を動かすたび、お尻の穴が盛り上がったりへ\nっこんだりして……恥ずかしいことになっちゃってるよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104115" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――よし、これぐらい穴が解れてるならいける。穴が切れない様にゆっくり\nペニバンを挿入するから、さっきみたいに深く息を吐くんだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「力を抜いて～、大きく息を吐いてぇ～……ゆっくり、ゆっくりぃ……すぅ～\nって息を吐くんだよ……すぅ～～……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あともう少し……このままゆっくり、最後まで……うん、よくできました♪\n　ペニバン、しっかり根元まで入ったよ♪」」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「それにしても……これが、バックで挿入した時の眺めかぁ……ふふっ、なん\nだか相手のことを征服してるみたいで、ゾクゾクしちゃうかも♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104119" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「駄目、我慢できないや……♪　大丈夫よね？　もう、息は整ったよね？　キ\nミのアナル、ズボズボ気持ちよくしてあげちゃうね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「最初は浅く、ゆっくり……少しずつ慣らすように、ペニバンをズボズボして\nあげる……ほら、しっかり感じて？　これが抜き差しされる感覚よ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104121" ]},
		{"command":[ "SETANIMSPEED", "0", "SLOW" ]},
		{"command":[ "PLAYANIM", "0", "ev330_01b_0000", "ev330_01b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「また少し、アナルが解れてきたら……グボグボって、空気を含むえっちな音\nが響いてくるの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほぉら、聞こえる？　この下品な音、ぜーんぶキミのアナルから聞こえちゃ\nってるんだよ？　とっても恥ずかしい、えっちな音」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ゆっくり抜いてぇ～、奥までぐ～って差してぇ～……また抜いてぇ～、深く\nまで抉ってぇ～♪　どう？　アナル、気持ちよくなれてる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふっ、分かってるよ……最初からアナルの刺激だけで最後まで行けるなん\nて、思ってないって♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「えいっ……♪　ふふ、このまま一緒に、オチンチンしこしこしてあげる♪　\nアナルを責められながら、こっちでも気持ちよくなっちゃおうね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104126" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほーら、シコシコ、シコシコ～♪　アナルとオチンチンの二点責めだよー♪\n　っと、折角だし、余った手で乳首も一緒に可愛がってあげちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「指で乳首を摘まんでぇ……クリクリ～♪　ふふ、ここもすっかり弱くなっち\nゃったよね……簡単に感じちゃう、マゾ乳首だ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「乳首を爪でカリカリしながら……オチンチン、シコシコ、シコシコ～♪　気\nが緩んだところで、アナルもズボズボ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「三点責め、気に入った？　さっきから恥ずかしい喘ぎ声がどんどん溢れてき\nちゃってるよー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「彼女ちゃんにお尻の穴を掘られながらアンアン喘いじゃうなんて……私の彼\n氏君は、どうしようもないマゾ野郎だねー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「否定……できないよね？　さっきからアナルが凄い勢いで吸い付いてきてる\nの、分かってるよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「もっともっと、ペニバンで気持ちよくなりたいって、お尻の穴をこんもり膨\nらませて……もっと欲しいもっと欲しいって、おねだりしてきてる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほら、言って……『このままアナルでイかせてください』って。『お尻をガ\nン掘りされて、気持ちよくなりたいです』って」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふっ♪　よくできました♪　ならお望み通り、頭真っ白にして、獣みたい\nに呻いて精液びゅーびゅー吐き出しちゃえ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほらイけ、このままイっちゃえ！　オチンポも激しく扱いてあげるから、こ\nのままみっともなく射精しちゃえ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104136" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev330_01a_0000", "ev330_01a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――あはは♪　出てる出てる！　どうしようもないマゾオチンチンから、お\n漏らしみたいに精液、ふき出しちゃってる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_09" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「なーに、その情けない呻き声、『おっおっ』って……ふふっ、オホ声って奴\nだ。喉の奥から漏れてくるの、止められないんだ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「私の彼氏は、本当に変態さんなんだから♪　でも……そんなところが好き、\n大好きよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104139" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「私の望みに付き合って、楽しいセックスをいっぱい一緒にしてくれる貴方が\n大好きだからね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――射精、終わっちゃったね。だけど、オチンチンは固いまま。アナルも…\n…きゅうきゅう締め付けて、ペニバンに吸い付いてる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「おねだりの言葉、どんどん素直に出せるようになってきちゃったね。私の彼\n氏君は、ごっこを通り越して本当のドエムになっちゃったのかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「そんな泣きそうな声をださなくても……ほぉら！　お望み通り、アナルがガ\nバガバになるまで犯して、気持ちよくしてあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104203" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あはっ♪　本当に吸い付きすごいんだから……！　穴がめくり上がるぐらい\nの勢いで腰を引き抜かないと、ペニバンを離してくれないや♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104204" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「アナルを犯されて、またオチンチンもビンビンだねぇ♪　先っぽからだらし\nなく先走り垂らしちゃって、みっともなーい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「乳首もなに、この固さ。勃起し過ぎでしょ。馬鹿みたいにヒクつかせちゃっ\nて、下品にもほどがあるわよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ん……？　もしかして……キミ、身体を合わせるたび感じる、ボンテージ衣\n装の質感でも気持ちよくなってたりする？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104207" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「うわぁ……うわぁ……この衣装気に入ってくれてるのは分かってたけど、そ\nこまでだとは……うふふ、正直、ドン引きしちゃうわ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「でもいいの、そんな変態淫乱男が、私の好きな人だもん♪　ほら、真っ赤に\n膨れ上がった勃起チンポ、もっとシコシコしてあげる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104209" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「またさっきみたいにみっともない喘ぎ声を出して身悶えるの！　ケツ穴で感\nじて、馬鹿みたいな蕩け顔を晒しちゃえ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104210" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev330_01b_0000", "ev330_01b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「オチンチンの根元から先端まで……んんっ……！　一気にシコシコ♪　皮も\n全部巻き込むぐらい、ぎゅ～って押さえつけてシコシコ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――強すぎて少し苦しい？　何言ってるの、変態マゾ野郎のキミは、それが\n好きで気持ちいいんでしょ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「爪を立てて敏感な亀頭をカリカリしてあげる♪　この痛みいいんでしょ？　\nほら、括れの部分も爪を立てて、ぐい～って♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「また、みっともなく腰ガクガク跳ねさせちゃって……キミは自分のオチンチ\nンで女の子を責めるより、こうしてケツ穴を責められる方が好きなのかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「やっぱり変態だね♪　どうしようもない変態マゾ野郎だ♪　じゃあ、このま\nまケツ穴アクメ、派手にキメちゃおうっか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あはっ♪　すごいでしょ、前立腺♪　いままで焦らしに焦らしてきたからね\n！　こうして、んんっ！　一突きするだけで、飛びそうになるでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほーら！　アナルが壊れちゃうほど激しくズボズボしてあげる！　キミも私\nに合わせて腰を振りなさい！　みっともなく腰へこするの！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あははっ、いいよ、その調子！　みっともなくて、可愛い♪　ケツ穴掘られ\nて、無様エロ射精に一直線な変態姿、とっても可愛いよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104218" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev330_01a_0000", "ev330_01a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「オホ声も上げちゃって、もうアヘ顔になっちゃってるわね♪　イきたい、も\nうイきたいよね？　だったらほら！　おねだり！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ええ、許可してあげる。みっともなくチンポ揺らしながら、ケツ穴でイッち\nゃえぇっ！　この淫乱マゾ野郎っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「うわぁっ、出てるっ、出てるよっ……！　すごい勢いで精液っ……だけじゃ\nないよね？　このサラサラの液体は、なぁに？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――そう、お潮まで吹いちゃってる♪　ケツ穴をガン堀されて、お漏らしみ\nたいにびゅーびゅーって潮吹き……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「恥ずかしい恥ずかしい。男としての尊厳が欠片もない、情けない姿。だけど\n……ふふっ、変態マゾ野郎のキミは、とっても気持ちいいんだよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、もう言葉を発する元気もない？　いいよ、キミが動けなくても、私が\n最後の一滴まで搾り取ってあげるから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「射精中のオチンチン、シコシコ、シコシコ～♪　潮も精液も、全部出し切る\nまで、絶対に手は止めてあーげない♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「全身の痙攣、すごいことになっちゃってる。アナルもとんでもない締め付け\nで……ペニバン、食い千切られちゃいそう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104306" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んんっ……流石にそろそろ打ち止めかしら？　これだけ出したものね……オ\nチンチンも柔らかくなってきちゃった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふぅ……ちょっと盛り上がり過ぎちゃったね……どう、気持ちよかった？　\n――って、あれ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104308" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「もしかして、意識が飛んじゃいそう？　あーあー、本当に情けないアヘ顔晒\nしちゃって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104309" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「でも……そんなキミのことが、大好きよ。これからもいっぱい、楽しいえっ\nちをしましょうね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104310" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あぁんっ……！　最後に暴れるから、ペニバンが抜けちゃった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「でも……ふふっ、すごい勢いの射精ね。このまま全部を出し切るまで、オチ\nンチンしこしこしてあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「全部出し切るの、一滴たりとも残しちゃ駄目よ♪　キンタマの中が空っぽに\nなるまで、びゅーびゅーって情けなく射精し続けるの♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104403" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「みっともなくお尻をフリフリしても逃がしてあーげない♪　ほーら、敏感チ\nンポ、シコシコ、シコシコ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「射精中に更にオチンチン扱かれて、みっともなく喘ぐ声をもっと聴かせて？\n　情けなく身悶えるキミの姿が大好きなの♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あぁ……射精、終わっちゃった……んー、少し物足りないけど、まぁ、仕方\nないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104406" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_26" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふっ♪　とっても楽しかったね、ペニバンプレイ♪　アナルをガン堀され\nるの、気に入ってくれたかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_27" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「うん……私も……本当に楽しかったぁ♪　ねぇねぇ、近いうちにもう一回、\nどう？　今日みたいにすっごく気持ちよくしてあげちゃう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――あはっ♪　そうこなくっちゃ♪　次までに私ももっとテクニックを磨い\nておくわ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104409" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_25" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「これからも、よろしくね？　私の大大大好きな、マゾで可愛い、変態彼氏君\n♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0104410" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_02_24" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
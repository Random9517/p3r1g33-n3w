		{"command":[ "SETIMAGE", "0", "still_00022107_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「またすぐ、イッちゃいます……っ！　旦那さまっ、ああっ、イクの、イッち\nゃう、はぁっ、はぁっ、すぐ……我慢できなくて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あはぁあああぁぁぁんっ！！　こんなに簡単に、イッてしまうなんて……ぶ\nるぶるするそれも、ちゅぽちゅぽするそれも、すごいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704306" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「でも……やっぱりいちばんは、旦那さまのおちんちんさんですの♪　乳首も\n、くりとりすも、直接旦那さまに触れられたいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704307" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「プレゼントは気に入らなかったかって？　そ、そんなことありません！　旦\n那さまが用意してくださったプレゼント、とっても嬉しいです！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704308" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「このようなえっちな道具を使うのも、夫婦の営みに彩りを与えてくれる大事\nなものなんだって、思いました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ですから旦那さま、またこのような道具を使って、わたくしと子作りしてく\nださいませ?」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704310" ]},
		{"command":[ "WAITINPUT" ]},

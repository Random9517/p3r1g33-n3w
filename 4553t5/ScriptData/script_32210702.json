		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「今日はありがとうございました、旦那さま。一緒にプレゼントを配ってまわ\nることができて、とても楽しかったです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704101" ]},
		{"command":[ "SETCHARA", "0", "char_00022107_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さま♪　ふふっ、こうやって、そばで寄り添っちゃいます。旦那さま…\n…メリークリスマス、ですの♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704102" ]},
		{"command":[ "SETCHARA", "0", "char_00022107_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「それで、これからは恋人や夫婦の特別な時間だと伺っています。わたくした\nちも、そんな時間を過ごしませんか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704103" ]},
		{"command":[ "SETCHARA", "0", "char_00022107_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまと過ごした楽しいクリスマス……もっと忘れられない夜にしたいん\nです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704104" ]},
		{"command":[ "SETCHARA", "0", "char_00022107_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「え？　それならこのままえっちを？　はい、もちろんかまいませんよ。旦那\nさまからそのように言っていただけて、嬉しいです?」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704105" ]},
		{"command":[ "SETCHARA", "0", "char_00022107_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ああ……おちんちんさんが、とっても硬くなって……。んっ、おまたに熱い\nのが、すりすりってこすりつけられています……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704106" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしも、腰が動いてしまいます……。はぁ……はぁ……おまたから、ぬ\nるぬるのおつゆが、溢れて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまの、おちんちんさんを、ベトベトにしちゃいます……。んっ、旦那\nさまも、ますますおちんちんさんを、硬くしてますね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ふふっ♪　こんな特別な夜に、旦那さまと愛しあうことができるのが、たま\nらなく嬉しいんです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704109" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「それと同時に、お腹の奥がとってもせつなくて……。旦那さま……わたくし\n、旦那さまと繋がりたくて、たまらなくなっているみたいです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「お願いします、旦那さま……。いっぱい濡れているわたくしのおまんこに、\nおちんちんさんを挿れてくださいませ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ああぁぁんっ♪　はいってきました……ぁ……っ！　旦那さまのが、んっ、\nんくっ、おまんこ……いっぱいにぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704112" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、そうです……おまんこの中まで、えっちなおしるでいっぱいに\nなってました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704113" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまのこと、お待ちしておりました……♪　あんっ、旦那さま、動いて\nいいですからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704114" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしも、おまんこをしっかりと動かして、旦那さまのことを気持ちよく\nしますから……んっ、んふっ、んぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまの、おちんちんさん……おっきくて、おまんこが満たされて……気\n持ち、いいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704116" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁ、あんっ♪　旦那さまと一緒に動いて、お尻を、とんとんと旦那さまに\n押しあてて……んっ、はぁ、お腹の奥が、ますます火照ってきました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「……って、旦那さま？　腰の動きを止めて、いったいどうしましたか？　え\nっ、わたくしに、プレゼントを……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704118" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「こうして旦那さまとえっちしているだけでも幸せな気分なのに、プレゼント\nまでいただけるなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704119" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゃううんっ！　そ、それは、袋の中にのこっていた……ぁ、あんっ♪　だ\n、旦那さまが用意されたものだったんですの！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704120" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、それはいったい……んくっ、ひゅっ、乳首にぶるぶるって、\nあてられると……んはぁっ、ああぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「こ、こんなのはじめてです……っ！　だ、旦那さま、これはいったいなんな\nのですか……っ、ひゃぁんっ、乳首がへんですのぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704122" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、えっちをするときに、こういうオモチャを使うことも、あ\nるのですか……んっ、くぅ……知らなかったです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「お、オモチャが乳首に当てられて……んぁっ、ああっ、ビリビリって、刺激\nが強くて……はぁ、はぁ……んぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704124" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さま、これでは、わたくしばっかりが気持ちよくなってしまいます……\nっ！　んっ、旦那さまも、気持ちよくなってほしいのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704125" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「んぁっ、大丈夫、なんですか？　わたくしのおまんこが、ぎゅっと締まるよ\nうになって……気持ちいい、のですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「たしかに、旦那さまのおちんちんさんを、さっきよりも感じて……っ、ああ\nっ、大きくなっているの、わかります……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「おちんちんさんが動いてっ、んぁっ、ああっ、おまんこをたくさんごしごし\nしているの……感じちゃい、ます……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704128" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ああっ、乳首も、おまんこも……気持ちいいです……っ！　はぁっ、ああっ\n、こんなに気持ちよくされたら、わたくし……もう……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704129" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「は……い……っ。旦那さま、わたくし……イッてしまいそうです……っ！　\n旦那さまより先に……イッちゃう……我慢できなくて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゃぁあんっ！　旦那さまっ、動きが激しくなってます……っ！　ち、乳首\nのぶるぶるも、強くなってますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704131" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さま、このまま、わたくしのおまんこに、精液を注いでください……っ\n！　中出し、してください……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704132" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「この特別な夜に、いっぱい中出しして……！　わたくしに、たねつけをして\nください……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁああっ！　ああぁっ！　赤ちゃんのお部屋に、おちんちんさんがぁ……\nっ！　こつこつって、んっ、あっ、届いて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704134" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はい、だしてくださいっ！　射精して、くださいぃっ！　あっ、ああっ、わ\nたくしも……おっきいの、きちゃいそう……で……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゃぁあああぁぁぁ～～～～♪　んくっ、いい、イッてます……お、おまん\nこ……中出しされながら……ぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704136" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_12" ]},		
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「たくさん、旦那さまの子種を感じて……んっ、イク……イッて……っ！　あ\nっ、ああ、イッてるのにぃ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「乳首、ぶるぶるってされっぱなしで……んっ、ああっ、イッてるのに、また\nイッちゃいます……乳首でも、イク……あっ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704138" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「たくさん射精してもらって、それだけでもとっても気持ちいいのに……。ま\n、まだ……気持ちいいのが、終わらなくって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。あ、あの……旦那さま？　まだなにか、袋の中に残って\nいたでしょうか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704140" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「そ、それはなんですか？　たしかに、色も形もかわいらしいですけど……。\nあんっ、わ、わたくしのお豆さんにあてるんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「その道具に、くりとりすさんがすっぽりと覆われて……だ、旦那さま……え\nっと……。やさしく、お願いします……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704202" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゃぅうんっ！　ちゅぽっと吸われてっ、はぁっ、ああっ、ビリビリってき\nましたっ、あっ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704203" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「お、思った以上に、刺激が強くて……ひゃぁんっ！　旦那さま、ち、乳首も\n……ぶるぶるって責めちゃうんですか……ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704204" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゃっ、ひぃっ、ぶるぶるも、ちゅぽちゅぽも、どっちも気持ちよくて……\nっ！　ああっ、身体が、反応してしまうんです……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704205" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「変な感じです、旦那さまっ、ああっ、こんな……自分の身体が、自分のもの\nではないみたいで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704206" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「これも、気持ちいいだろう……ですか？　んっ、よくわかりませんが……で\nも……身体はとっても、熱くなってしまいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「これも……快感……。んあっ、ああっ、旦那さまのために、知っておいたほ\nうがいいこと……なのですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704208" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「そう思えば、この刺激も……はぁ、はぁ、なんだかとても、愛おしいです…\n…」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704209" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「でも、旦那さま……やっぱり、強すぎてちょっと、怖いです……。わたくし\nだけ、遠くに行ってしまいそうで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704210" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さま、お願いします……。わたくしと、しっかり繋がっていてください\n……。わたくしに旦那さまを、感じさせ続けて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁんっ！　あっ、ああっ、おちんちんさんがぁ……っ！　わたくしの、中\n……いっぱい……！」", "NORMAL" ]},

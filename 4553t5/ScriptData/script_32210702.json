		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゃぁあああぁぁぁああぁぁあぁ～～～～んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「んぁっ、ああっ、すっごいぃ……っ。旦那さまの精液が、わたくしの身体に\n、いっぱいかかってます……ぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704403" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……旦那さまも、気持ちよくなってくれたのですね……。ああ\n……わたくしの目の前……真っ白です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704404" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_25" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまの、匂い……。んふ……はぁ……。一呼吸するたびに、全身がとろ\nけてしまいそう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。どうされましたか、旦那さま？　この道具を、強くしす\nぎてしまったこと……謝ってくださるのですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「大丈夫です、わたくしは旦那さまの奥さんですから。それに、旦那さまがわ\nたくしにひどいことするはずないって信じてますからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704407" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「このような道具を使ったえっちは、はじめてで……わたくしも、戸惑ってば\nかりでしたが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「とっても気持ちよくって、わたくし、クセになってしまいそうです……」", "NORMAL" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「またたくさん、激しく、ああ、中も、感じます……っ！　旦那さまのことを\n、いっぱい、いっぱい、感じて……気持ちいいです……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「乳首も、くりとりすも、おまんこもぉ……っ！　旦那さまに、みんな、気持\nちよくしてもらって……あっ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さま……んはぁっ、わたくしのオマンコ、そんなに、キツくなっている\nのですか……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「んっ、ああっ、自分でも、わかります……っ！　旦那さまのおちんちんさん\nを、いつもより、感じてしまっているので……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704216" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「わたくしを愛してくださる、おちんちんさんの形を……いつも以上に、感じ\nて……いるんです……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ああっ、旦那さま……もう……っ！　わたくし、イかされてしまいます……\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704218" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「旦那さまも、一緒に、精液を……子種を、わたくしの子宮へ注いでください\nっ！　ああっ、どんどん……奥を、突いてぇ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704219" ]},
		{"command":[ "SETIMAGE", "0", "still_00022107_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ああっ、ああっ、また、イッてしまいます……イク、イッちゃいます……旦\n那さまっ、旦那さまぁっ、ああっ、あああぁぁぁああぁぁっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704220" ]},

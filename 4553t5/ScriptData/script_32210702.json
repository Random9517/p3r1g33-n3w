		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゃぁああっ、ああっ、あああぁぁぁああぁぁあぁっ！！　旦那さまの精液\nぃっ、中出しされながら、お、お潮まで……あっ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「たくさんでちゃいます……っ！　ああっ、旦那さまの前で、恥ずかしいとこ\nろ……いっぱい、見せちゃって……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_221_0704303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アン＝クァー" ]},
		{"command":[ "SETTEXT", "「ひゃぁあんっ！　だ、旦那さま……また、イッてるわたくしのこと、その道\n具で……んっ、ああっ、く……ひぃ……っ！」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「やっと二人っきりになれた……急に連れ込んでしまってごめんなさい……ど\nうしても貴方に、私の晴れ着姿をじっくり見て欲しくて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803101" ]},
		{"command":[ "SETCHARA", "0", "char_00001408_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「どうですか？　貴方好みの晴れ着を選んだつもりですけど……似合っていま\nすか？　可愛いですか？　ドキドキ、してくれますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803102" ]},
		{"command":[ "SETCHARA", "0", "char_00001408_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ふふっ、ありがとうございます。そんなにまっすぐに褒められると、やっぱ\nり照れちゃいますね……んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803103" ]},
		{"command":[ "SETCHARA", "0", "char_00001408_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ごめんなさい……はしたないとは分かってるけど、ずっと我慢してたから…\n…これ以上はもう、堪えきれなくて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803104" ]},
		{"command":[ "SETCHARA", "0", "char_00001408_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ご奉仕、させてください……いっぱい頑張って気持ちよくします、から……\nいいですよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803105" ]},
		{"command":[ "SETCHARA", "0", "char_00001408_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あ……オチンチン、もうこんなにカチカチになってる……私の晴れ着姿を見\nて、興奮してくれたんですか？　ふふっ、嬉しいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803106" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「すぅー、はぁー……はぁ、んぁ……少し汗臭くて、鼻の奥にジーンってくる\nような、男の人の匂い……すぅー、はぁー……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803107" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「頭、くらくらして……んっ……匂いを嗅いでるだけで、その……オマンコ、\n濡れてきちゃいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「――わ、分かってますから、わざわざ言わないでください……貴方の事を考\nえると、私はどうしようもなくえっちな子になっちゃうんです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803109" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「こうやって……んっ、あっ、んんぅ……少し指で割れ目を擦っただけなのに\n、えっちな音、こんなに響いて……あっ、んぅうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803110" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「――ご、ごめんなさい、私だけ一人で気持ちよくなるなんてダメ、ですよね\n……オチンチン、舐めますね……ちゅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803111" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ……ふふっ、唇が振れるだけでオチンチンびくってした……か\nわいい……ちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803112" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「れる、れる……んちゅ、れるぅ……やっぱり、汗の味がする……少し、しょ\nっぱくて……んちゅ、でもこの味、好き……れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「分かってますよ、この括れの部分、ですよね……れる、ちゅ、れるぅ……舌\nの先でぐりぐりするのが、いいんですよね……ちゅれるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803114" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あとは、オチンチンの先っぽの所も……んれる、ちゅ、れるぅ……えっちな\nお汁、もうこんなに溢れて……んちゅ、れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「だめ、舐めてるだけじゃ飲み切れないや……んっ……はぁ、はぁ……このま\nま、口の中でっ……あーむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んむっ、ちゅ、んれるぅ……じゅ、じゅれる、れろぉ……んちゅ、じゅじゅ\n、じゅれるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803117" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「すごい、口の中いっぱいに貴方の味が広がって……じゅぶ、じゅれるぅ……\nんんっ……わ、私も、我慢、できなくてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803118" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んあっ、あっ、んぅんんっ……！　オチンチン咥えながら、オナニーするの\n、止められないっ……んっ、あぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803119" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「オマンコ、さっきよりもびちょびちょで……あっ、んぅんっ……恥ずかしい\n、のに、えっちな音、いっぱい聞かれちゃうっ……んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803120" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「オチンチンも、もっと深くまでっ……じゅれるぅ、じゅぅ、じゅぶるぅ……\nんぶっ、じゅ、じゅれるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803121" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ぐぼっ、ぐぼっ……んぶっ、じゅれるぅ……！　の、喉の奥にガンガンぶつ\nけるの、苦しいけど、気持ちよくてっ、じゅれるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「貴方が喜んでくれてるの、オチンチンの反応で全部わかっちゃいます……じ\nゅれる、じゅる、れるれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803123" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「おまんこ、ズボズボする指も、止まらないっ……あっ、んぅんっ……！　深\nい所まで、指でいっぱい掻き回してっ、んんぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803124" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「じゅれる、ちゅ、じゅぶるぅ……ぷはぁ……！　オチンチンしゃぶりながら\nのオナニー、すごいっ、気持ちいいっ、あっ、あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803125" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んじゅるっ、れる、れるれろぉ……！　じゅぶるっ……ぐぶ、ぐぶぐぼぉ…\n…！　んぐっ！　じゅ、じゅぶるっ、れるれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803126" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……はぁ、はぁ……だ、だめ、これ、オナニーの手、止めたくない、\nけど……あぁんっ！　止めないと、先にイっちゃいそうでっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「――え？　オナニー、止めちゃダメ……？　もっと激しく、乱暴に、オマン\nコ掻き回せって……うっ、あっ、んぅうんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803128" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「は、はい、貴方がそう望むなら、もっと激しく、もっともっとオマンコ、め\nちゃくちゃになるまで激しくっ……あっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803129" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「クリ、トリスの皮ひっぱってぇ、あっ、あぁんっ！　愛液と一緒にシコシコ\nってっ、あっ、ふあぁんっ！　あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803130" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「奥ぅ、指でじゅぼじゅぼオマンコの奥まで掻き回すの、気持ちいいですっ！\n　んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「で、でも、やっぱり私だけで先にイっちゃうのは嫌、だからっ……あぁんっ\n……オチンチンも、またぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803132" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あーむっ……！　じゅれる、じゅぶる、れるれる、れろぉ！　ぐぶっ、ぐぶ\nぐぼ、じゅぶるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803133" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「このまま、出してくださいっ……！　オマンコぐちゅぐちゅしながら、オチ\nンチンいっぱい舐めるから、このまま最後までっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803134" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んぅうぅんっ……！　じゅぶる、れる、れるれろぉ……！　んふっ！　オチ\nンチン、大きくなって、ヒクヒクしてきたぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「全部飲みますからっ、このまま喉の奥にっ……じゅぶる、じゅ、じゅれる、\nれるれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んっふうううんっ……！　んんっ、じゅ、じゅぶる！　……んくっ、んくっ\n、んくっ……すごい、喉に、絡みついてっ……んぅうんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803137" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「私もイク、イきますっ……んぅんっ！　貴方の精液でイク、オチンチン舐め\nながらイクっ、イックうぅっんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「射精も、まだまだ止まらないっ……じゅれる、じゅ、じゅるぅう……！んふ\nっ、あっ、んうぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803139" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「口の中、だけじゃなくてっ……喉の奥、お腹の中まで貴方の精液、いっぱい\nでっ……あっ、んんっ、んあぁんんっ………！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803140" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……はぁ、はぁ、はぁ……んんっ……あれだけ、口の中に出したのに\n、オチンチン、精液でまだこんなに、べとべとで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「お掃除、しないとですよね……ちゅ、んちゅ……ああ、だめ、床に垂れてい\nっちゃうの、もったいない……れる、れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803202" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、れろぉ……ここ、括れの所にも、精液溜まってる……じゅれ\nる、ちゅ、じゅれるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803203" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んっ、あぁんっ……私も、さっきあんなに大きくイった、の\nにっ……まだ、足りなくてっ……あっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803204" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「だめっ、オナニー、止められないっ……んぁんっ！　イったばかりのほかほ\nかオマンコ、気持ちよくてっ、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803205" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「精液も、もっとっ……ちゅ、れる、れろぉ……んくっ、んくっ……濃厚で、\n喉に絡んでっ……んちゅ、ちゅれるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「これでオチンチン、綺麗になった、けど……また、こんなに大きくて、カチ\nカチで……はぁ、はぁ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「嬉しい、です……オナニーしてるえっちな私を見て、もっと出したい、もっ\nともっと射精したいって、思ってくれてるんですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803208" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、あぁんんっ……！　はしたないって、分かってるけどっ……私\nも我慢なんて、できない、からぁ……あむっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803209" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「じゅれる、じゅぶ、じゅぶるぅ……！　オチンチン、いっぱい味わいながら\n、もっと激しくオナニー、するのぉ！　じゅれる、じゅぶるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803210" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「これ、しゅごいっ……！　指でオマンコの膣内ぁ、ザラザラの所ぐりぐりす\nるの、良すぎてっ、ひっ、あっ、ふあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「さっきから何回もイっちゃう、オチンチン口いっぱいに頬張りながら、何回\nもぉ……！　じゅぶる、れる、れるれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ぐぶぐぶ、ぐぼっ……！　じゅぶ、じゅぶる、れるれろぉ……！　く、クリ\nトリスもまた、ぎゅーってっ、ふくぅうんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803213" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あ、貴方も腰を振ってっ、私の喉奥……ううん、喉マンコ、好きなように使\nっていいですからぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803214" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ぐふっ、んっ、んんっ……！　じゅぶる、じゅ、じゅぶぐぼぉ……！　んあ\nっ、あっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803215" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ま、また大きいの、くるっ、んひゃぁんっ……！　オマンコ、何回も何回も\n、イクの、止まらなくてっ、あっ、ふあぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803216" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「オチンチンの先っぽも、ヒクヒクしてるぅ、じゅ、じゅれるぅ……！　出し\nて、濃厚精液、もう一回いっぱい出してくださいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803217" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「じゅぶれる、れる、れるれるれおぉ……！　私も頭真っ白になるまで、イキ\nまくります、からぁ！　あっ、ふあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803218" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「オチンチンしゃぶりながらアクメする私を見てっ……！　いやらしくてはし\nたない私で、いっぱい射精してくださいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803219" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「じゅぶるぅ、れるれる、れろぉ……！　じゅ、じゅれるっ、じゅぶる、じゅ\nるぅぅぅ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803220" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んっふうぅぅんっ……！　また、喉の奥に直接っ……んぶっ、じゅ、じゅぶ\nるぅ……！　んくっ、んくっ、んくっ――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「濃厚精液、すごい量っ……じゅぶる、じゅぞぞ……んくっ、んくっ……精液\nで、おぼれちゃいそうですっ……んくっ、んくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「ドロドロの精液が、喉に流れていくのも、気持ちよくてっ……イクっ、精液\n飲めば飲むほど、頭、真っ白になってっ……ふあぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803303" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「駄目です、射精止まらないでぇ……もっと欲しい……じゅる、じゅれるぅ…\n…いっぱいのんで、いっぱいイきたいのぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803304" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「じゅぶる、じゅる、れるれる、れろぉ……！　ぷはぁ！　はぁ、はぁ……ん\nちゅ、ちゅ、ちゅれる……ちゅ、れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んっ……もう、出ないですか……？　私の口で、貴方の全部\nを……んんっ……受け止める事、できましたか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803306" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「――はい、私もいっぱい気持ちよくなれました……オチンチンをしゃぶりな\nがらのオナニーが、こんなにすごいなんて知らなかった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803307" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「うっ……れ、冷静になると、私、とんでもない事してしまったような……ま\n、待って、顔を覗き込まないでください……恥ずかしい、からっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あの……最後にもう一度、いいですか？　私の晴れ着姿、どうですか？似合\nっていますか？　可愛いですか？　ドキドキして、くれましたか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803309" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「――ふふっ、ありがとうございます。貴方が望むなら、晴れ着、いつでも着\nてあげますから……またえっちなこと、しましょうね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「んっくうぅぅんっ……！　だ、だめっ、また口の中で精液全部、受け止めた\nかったのにっ……あっ、ふあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_18" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「熱い精気が顔に掛かってっ、あっ、ふあぁんっ……！　精液のシャワー、イ\nクの、止まらないっ、んあぁんっ！　あっ、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「折角の晴れ着が精液塗れになっちゃいます、けどぉ……んぅんっ！　それは\nそれで、貴方色に染められてるみたいで嬉しい、かもぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803403" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、ああぁんんっ……！　だめ、オマンコまたイクっ！　ぐちゅ\nぐちゅに掻き回すの、止められなくてっ、んあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803404" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「いやらしい音を立ててお潮、ふいちゃってますぅ……！　腰もヘコヘコって\n勝手に動いてっ、止められないっ、あっ、ふあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803405" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「こんなみっともなさ過ぎる格好、恥ずかしいはず、なのにぃ……イクの、止\nまらなくてっ、あっ、ふあぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ。はぁ……んっ……すご、かったぁ……気持ちよすぎて、頭、真\nっ白でっ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「あ、貴方は、どう、でしたか……？　私のご奉仕、気持ちよかったですか…\n…？　満足するまで、射精、してくれましたか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803408" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「――ふふっ、確かに、このドロドロになった晴れ着がその答え、ですね。い\nっぱい気持ちよくなってくれたみたいで、嬉しいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "まりあ" ]},
		{"command":[ "SETTEXT", "「その……こんなはしたなくて、えっちな私ですが……これからも末永く、よ\nろしくお願いします……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_0803410" ]},
		{"command":[ "SETIMAGE", "0", "still_00001408_01_17" ]},

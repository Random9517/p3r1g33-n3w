{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0224" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ん～、エルフたちに敵だと誤解されて捕まって……まぁわたしがダークエル\nフなのは間違いないんだけど、世界が違うんだけどなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403101" ]},
		{"command":[ "SETCHARA", "0", "char_00019504_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あなたと一緒の牢屋なのはいいけれど、さすがにそろそろ退屈になってくる\nわねぇ。なにも進展がないものぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403102" ]},
		{"command":[ "SETCHARA", "0", "char_00019504_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あら、どうしたのぉ？　そんな大の字に寝転んで……え？　お前も脱出する\n方法を考えろって？　無理よぉ。この手足じゃぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403103" ]},
		{"command":[ "SETCHARA", "0", "char_00019504_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「こういうのは流れに身を任せて、チャンスを窺うのが一番よぉ。リラックス\nして、その時が来たら全力で逃げましょぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403104" ]},
		{"command":[ "SETCHARA", "0", "char_00019504_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「一刻も早く出るべきって……だからその方法が機会を窺うってことじゃない\n……ああ、そうか、分かったわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403105" ]},
		{"command":[ "SETCHARA", "0", "char_00019504_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「おちんちんに溜まってるからイライラしてるのねぇ。いいわぁ、わたしがあ\nなたのムラムラ、解消してあげる。動かないでねぇ……と」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403106" ]},
		{"command":[ "SETCHARA", "0", "char_00019504_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あぁん！！　うふふ、やっぱりねぇ。おちんちん、ギンギンじゃなぁい。溜\nまってたんでしょう？　わたしに任せなさぁい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403107" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「とはいっても、これだと手が使えないからぁ……そうねぇ、こういうのはど\nう？　うふふふふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ほらぁ、太ももできゅって締めつけるの、気持ちいいでしょう？　こうして\n、んっ、ふうっ、柔らかいので挟んで……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403109" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふふっ、あなたのおちんちんが嬉しそうにびくびくしてるわぁ。ね、ほら、\nおちんちんリラックス、リラックス」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403110" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「硬くなってても、疲れるだけだからねぇ。ああ、でもおちんちんは硬い方が\n好きよぉ。やだ、これっておじさんみたいねぇ。あははははっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403111" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふふっ、喋ってないで、おちんちんを労ってあげないとねぇ。んっ、ふっ、\nんんっ、ほら、こういうの、どう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ、ふぅっ、ふふっ、あなたよりおちんちんが返事してるわねぇ\n。びくびくって、気持ちいいって言ってるわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403113" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「こうして、太ももで挟みながら動いてぇ……んっ、ふうっ、んうっ。うふふ\nふっ、オマンコに入れるのともまた違うでしょう、これ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403114" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「おっぱいで挟むのとも違ってぇ……柔らかさと硬さがあって……んっ、ふう\nっ、ふっ、これ、わたしもおちんちんが密着して、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ほら、わたしの太ももをカリ首が削ってるの、分かるでしょう？　んっ、ふ\nっ、これがオマンコの中だったらって、見てみてぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403116" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「わたしのお肉、こうやって押しのけて、削って、ごりごりって……オマンコ\nの中だとこういう風におちんちんが動いてるのよぉ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あんっ！！　あなたの腰も動いてきてるわねぇ。うふふ、いいわ、いいわぁ\n。せっかく気持ちよくなってるんだもの、二人でやらなきゃねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403118" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ほら、わたしの動きに合わせてぇ……そうそう、腰を動かしたらぁ、んっ、\nあんっ、ほら、大きなおちんちんがにゅるにゅるってぇ……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふふふっ、おちんちんの先っぽからお汁が出てきたわねぇ。気持ちいいん\nでしょう？　わたしもよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「太もも擦られてるだけでぇ、あなたのおちんちんの熱さと硬さが分かってぇ\n、んふうっ、ふっ、あんっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403121" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「わたしもこれをオマンコに入れられたらってぇ、想像するだけでお腹がきゅ\nんきゅんしちゃう。んっ、はあっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403122" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「うふふ、それを考えるとぉ、入れたくなっちゃうけれど、今はこっちで……\nね。んっ、ふっ、ううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ぬるぬるになった太ももで擦られるの、気持ちいいでしょう？　わたしも、\n硬いおちんちんににゅるにゅるされるの、好きぃ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403124" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふっ、んっ、んんっ、あんっ、うっ……ふっ、あなたの腰も激しくなって\nきたわねぇ。いいわぁ、この男っぽい動き、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「腰がお尻に当たって、おちんちんがふとももを擦ってぇ、んんっ、ふっ、あ\nんっ、あああっ、あああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ねぇ、身体が熱くなってるの、分かる？　あなたのおちんちんで、わたしの\n身体が火照ってきてるの、んんっ、あっ、はあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403127" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふうっ！！　あなたのおちんちんも、わたしの太ももで熱くなってきてる\nわぁ。んっ、先っぽが膨らんで、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403128" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「カリ首もさらに大きくなって、段差でごりゅごりゅって太もものお肉を押し\nのけて、んんっ、ふうっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「竿も太くなってぇ、太ももにみっちり密着してる、んっ、ふうっ、あなたの\nおちんちん、んっ、わたしの太ももに挿入されてるっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふふっ、んっ、そろそろイくのねぇ、んっ、おちんちんの反応で分かるわぁ\n。おちんちん、イきたいイきたいって訴えてきてるものぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403131" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あんっ、ああっ、あっ、いいわ、イって。イっていいわぁ。わたしの太もも\nで、精液びゅっびゅって出して、んんっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403132" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「わたしも、イくからぁ！！　あなたのおちんちんで太ももにゅこにゅこされ\nて、イくからあ、だから、出して、精液いっぱい出してぇ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403133" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あんっ、んっ、イく、イく、イくううっ！！　あはああああ\nああああああああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403134" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あああっ、んっ、出てるぅっ！！　おちんちんから精液出てるぅっ！！　ふ\nあああっ、あっ、熱い……んっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403135" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふうっ、凄いわねぇ、わたしの太もも、あなたの精液でどろどろだわぁ。\nんっ、やっぱり溜まってたのねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403136" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふふっ、匂いも凄い……鼻から妊娠しちゃいそう、んっ、ふうっ、この匂い\n、好きだわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「この量も、匂いも、熱さも、わたしで気持ちよくなってくれたしるしじゃな\nい。女として、ぞくぞくしちゃうわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403138" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふふっ、出した後のこのどろどろになってる身体、いいわぁ。おちんちん気\n持ちよくしたって感じがしてぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403139" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あんっ、また残りが出てきたぁ……太ももで締めつけられて、絞り出されち\nゃったぁ？　ふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403140" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「でも、出したばかりだけどぉ、まだ硬いままねぇ。ねぇ、もう一回出してお\nく？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403201" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「だって、溜まってたら冷静に判断できないでしょぉ？　脱出のために、ちゃ\nんとすっきりさせておかなきゃねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「そうよ、脱出のためよぉ。だから遠慮せず、なにも考えずに、ねぇ？　もう\n一回、しましょうよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、あはぁ、そうでなくっちゃ。んっ、ふうっ、ふっ、ほら、わ\nたしの太もも、もう一回締めつけてあげる、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403204" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「さっき出した分で、また違う感触になってるでしょう？　んっ、ほら、ぬる\nぬる、どろどろで、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「精液がローションがわりになってぇ、すっごいエッチなおちんちんになって\nるわぁ。あんっ、ああっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「きっと、中出しした後のオマンコもこんな感じよねぇ。どろどろで、真っ白\nに汚されてぇ、それでもおちんちんが動いて、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふふふっ、想像しちゃったぁ？　おちんちんがびくんって動いてるわぁ。あ\nなたのそういうところ、好きよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403208" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「じゃあ、改めて……んっ、ふうっ、んんっ、あんっ。音も、にちゅにちゅっ\nていやらしい音がしてるしぃ、あうっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「それに太ももとおちんちんでぇ、粘っこい糸も引いてるわぁ。ふふっ、エッ\nチよねぇ。そう思わなぁい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「こうやって、捕まってる牢屋の中で、おちんちんと太もも擦りあわせてぇ、\nんんっ、ふうっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403211" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふふっ、見張りが来たらどう思うかしらねぇ。捕虜の二人がエッチなこと\nしてるってぇ、怒るかしらねぇ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「まぁわたしは怒られてもやめないけどぉ。こんな気持ちいいこと、やめるわ\nけないわよねぇ。んっ、ふうっ、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403213" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あなたもぉ、もう腰が止まらないってなってるわねぇ。んふふっ、いいわっ\n、欲望に素直って感じでぇ、とても素敵ぃ、ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「いつだって刹那的になんて言わないけどぉ、エッチしてるときぐらいは欲望\nに身を任せた方がいいわよねぇ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「だって、その方が気持ちいいんだものぉ！！　んんっ、あんっ、あっ、あは\nはっ、あなたもそう思うのねぇ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403216" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「だって、またおちんちんがぱんぱんになってきてるわぁ！！　イくんでしょ\nう！！　さっきみたいに、わたしの太ももに出すんでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふううっ、出してぇっ！！　気持ちいいの、精液、いっぱい出してぇっ！\n！　わたしをもっとどろどろにしてぇっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「イって、イって！！　おちんちんイって、精液びゅるびゅる出してっ、あん\nっ、あああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「わたしもぉ、わたしもイくからぁっ！！　おちんちんイってえええええええ\nええええっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふああああああああっ！！　また、出てるぅっ！！　んんっ、おちんちんか\nら精液出てるぅっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403301" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、さっき出したのと混ざり合ってぇ、もう、太ももが精液の受\nけ皿になっちゃってるわぁ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「こんなに出されたらぁ、もう肌に染みついて取れないかもぉ。拭いても、絶\n対気づかれちゃうわねぇ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふふふっ、こんな格好してるし、それってわたしがあなたの所有物って、一\n目で分かっちゃうわねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403304" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んっ、またおちんちんから出てる……今の言葉で興奮したのねぇ。そうよ、\nわたしはあなたのモノよぉ。ふうっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あなたの好きに、精液を出していいのよぉ。わたしはそれに従うからぁ、\nんっ、はあっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403306" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「でも所有物はちゃんと手入れしなきゃねぇ？　放っておいたら、壊れちゃう\nんだからぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「だから、定期的にこうしてわたしに精液ちょうだいねぇ。でないと、わたし\nおかしくなっちゃうかもぉ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「ふふ、冗談よぉ。私は従順だからぁ、どんな扱いされてもあなたをずっと待\nち続けるわぁ。いじらしく、ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403309" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「だから……あなた。期待して待ってるわよ、ずっと。また、いっぱいいっぱ\nい精液出してね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んんっ、おちんちんの先が、ずれて、ふあああああああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403401" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あふうっ、太ももじゃなくておっぱいに、んっ、ああっ、あんっ、あっ、こ\nれは、これで悪くないかもぉ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403402" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふううっ、んっ、これ、全身が、あはぁ、あっ、んっ、凄い、こんなにい\nっぱい、んんっ、これだけで蕩けちゃう……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「太ももも、おっぱいもこんなにどろどろにされてぇ……んっ、ふうっ、本当\nに、あなたはわたしの喜ばせるやりかたが分かってるわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403404" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「こんな風に出されたらぁ、もうあなたから離れられないに決まってるじゃな\nい。わたしでぇ、こんなに気持ちよくなってくれてるんだからぁ。あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「だったら、次もいっぱいいっぱい気持ちよくしてあげようって、思っちゃう\nわぁ。あなたのためにぃ、ご奉仕したくなるわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふふふふっ、だから、また次もねぇ、一生懸命気持ちよくしてあげるわね\nぇ。だから、沢山精液出してねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403407" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「あはぁっ、おちんちんはもう返事してるわねぇ。素直なのも素敵だわぁ。こ\nんな格好だけれど、できることは全部してあげるからねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403408" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「んふうっ、今したばかりなのに、次が楽しみだわぁ。また沢山気持ちよくす\nるから、わたしのことも気持ちよくしてねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403409" ]},
		{"command":[ "SETIMAGE", "0", "still_00019504_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラケシス" ]},
		{"command":[ "SETTEXT", "「きっとよぉ？　あなたとするの、楽しみに待ってるからねぇ。だから、おち\nんちんにいっぱい溜めててね、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_195_0403410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]

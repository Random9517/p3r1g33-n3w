{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_01" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「フフ、やっぱりSっぽい体位と言えばこれよね♪　男を組み敷いて無理やり\nチンポを挿入するのって、想像するだけでゾクゾクしちゃうかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404101" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「――なによ、そんなに驚いた顔して。あなたが言ったのよ、女性優位の……\nSっぽいプレイがしたいなら、いくらでも付き合ってくれるって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404102" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「確かに自分でも、少し大胆過ぎるかなとは思うけど……フフ、やるからには\nとことん愉しまないと損じゃない♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404103" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「それに、あなただってノリノリじゃない。んんっ……デカチンをこんなに勃\n起させて、我慢なんて、できないでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「私のマンコも、もうこんなに濡れ濡れなの……あぁんっ……チンポと軽くこ\nすり合わせるだけで、愛液がどんどん溢れてきちゃう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「このまま無理やり、ガチガチチンポを呑み込んであげるから……あぁんっ…\n…あなたはただ、されるがまま、気持ちよくなっちゃいなさいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「ああぁ、ああぁんっ……♪　チンポ、入って来たぁ……！　一番奥まで、一\n気に届いてっ、あっ、んぅうぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404107" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「さ、最初から、激しめに行くわよ！　私が満足するまで、あなたのチンポは\nただの肉バイブになればいいの、分かったわね……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404108" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんっ……！　これ、すごいっ、体勢的にっ、チンポの先\n端が、簡単に子宮まで届いてっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「子宮もおりてきてるからっ、腰を叩きつけるたびに、亀頭が入り口を広げて\nっ、あっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「こうして自分から上に跨って腰を振るなんて、夫相手でもそんなにしない、\nからっ……あっ、んあぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「想像以上にいい、かもっ……男を見下ろしながら好き勝手気持ちよくなるの\n、癖になっちゃうかもしれないわ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「でも、この程度じゃまだ全然足りないわっ……ほら、チンポをもっと固くさ\nせて！　肉バイブの仕事をしっかり果たしなさい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、あぁんんっ……！　腰を前後に振って、ガチガチチンポで、お\nへその裏を撫でてっ、んぅうんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404114" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁんんっ……！　そう、その固さよ！　やればできるじゃない！　\nカリ高チンポでマンコズボズボするの、気持ちいいわっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404115" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「――こらっ、なに勝手に腰を振ろうとしてるの！　言ってるでしょ、あなた\nはただの肉バイブ、私の許可なく動くなんて、許さないわ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「フフ、分かればいいのよ♪　安心しなさい、焦らしたりはしないから。私の\n言うとおりにするなら、しっかり気持ちよくしてあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404117" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「ほら、もっと激しく、腰をパンパンってっ……あっ、んあぁんっ♪　マンコ\nをきつく締めつけて、何度も、何度も叩きつけてっ、んぅうんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404118" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「フフ、フフフ♪　腰を振りたい？　あなたのタイミングで気持ちよくなりた\nいわよね？　でも、ダメ、それだけは許してあげない♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404119" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「こうやってっ……あっ、んっ、んうぅんっ……腰の振り方を小刻みに変える\nのもっ……んぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404120" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「腰を回す様にチンポを振り回すタイミングもっ、あっ、あぁんっ……！　全\n部全部、私が決めるのっ♪　私があなたのチンポを苛めるのよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「でも、そうね……少しぐらいなら、ご褒美もあげちゃうわ♪　ほら、さっき\nからヒクついてるあなたの乳首を弄ってあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404122" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「指の腹で摘まんで、シコシコ、シコシコ♪　あなたはマゾだものね、優しく\nより、痛いぐらいの方が嬉しいのかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「爪を立てて、食いこませてっ……カリカリ、カリカリっ……あぁんっ♪　痛\nみでチンポを跳ねさせるとか、本当にどうしようもないわね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404124" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「フフ、どんどん息が荒くなってきた……でもまだ駄目よ、私はまだまだイキ\nそうにないんだから、まだ出しちゃ駄目♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404125" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「ここからが本番よっ……あっ、あぁんっ、んぅんっ♪　もっともっと激しく\nしていくわっ、私がいいという間で、我慢し続けるのよっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404126" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「や、やっぱりいいわね、このカリ高チンポ……あぁんっ！　抜くときも突く\nときも、気持ちいい所にいっぱいこすれてっ、んんぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「さっきから結合部のところ、すごい事になっちゃってるわ……あっ、んんぅ\nんっ……くっさい匂いと、下品な水音……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「いつもは恥ずかしいと思うことも、私が主導してそれを起こしてると思うと\n、なにかしらこれ……胸の奥がゾクゾクするの、止まらない……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404129" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んあぁんっ……♪　あなたも、もっと見せて？　もっと可愛\nい喘ぎ声を出して、みっともなく身悶える姿を、私に見せるの♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404130" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「フフ、フフフ♪　いいわ、これが自分から男を無理矢理気持ちよくさせるっ\nてことなのね♪　……本当に癖になっちゃったらどうしようかしら♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404131" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「んひゃぁんっ！　こ、これ、チンポが一気に膨らんでっ、あっ、んぅんっ！\n　ま、待ちなさい、私はまだっ……んぅうんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404132" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「なに勝手に出そうとしてるの！　駄目よ、許さないわ！　私より先にアクメ\nするなんて、絶対にっ、あっ、んあぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404133" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「んあっ、あっ、んぅうんっ……！　あと少し、だからっ、我慢するのよっ！\n　もうちょっとで、私もっ、あっ、んあぁんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「あっくうぅぅぅんっ……！　えっ、あっ、くぅぅっ……！　で、出てる、私\nはまだなのに、濃厚ザーメンたくさんっ、あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404135" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_06" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「い、イクっ！　子宮にザーメン直接叩きつけられてイクっ！　私もアクメ、\n来るぅぅ！　んあぁあんんっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んあっ、あっ、んぅうんっ……！　すごかった……気持ちよ\nかった、けどっ……私の言いたいこと、分かるわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404137" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「駄目だって言ったじゃない……あなたは肉バイブなのに、私より先にイクな\nんて、許されると思っているの？　お仕置き、されたいの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「――フフ、なんて、どう、今のそれっぽかったかしら？　何よ、その顔、私\n、別に本気で心の底からサディストになったわけじゃないのよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「これはそういうプレイ、なんだから。確かに少し残念ではあったけど、まぁ\n雰囲気は楽しめたから、許してあげるわ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「な、なに、その目は……え？　本当のSプレイを見せてやる？　逆転分から\nせ？　そ、それってまさか――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404201" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「んあぁんっ！　あっ、んくぅんっ……！　ま、待って、イったばっかり、な\nのにっ、んぅんっ！　こんな、続けてなんてっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404202" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「――い、色々好き勝手言ってくれたことへの倍返し？　で、でもそれは、あ\nなたが付き合ってくれるって言うからっ！　んぅうんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404203" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「それだめっ、角度をつけて下からガン突きするの、だめっ！　あっ、ああっ\n、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404204" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「待って、本当に待ってっ、んぅうんっ！　さっきからアクメ、止まらなくて\nっ、ひっ、あっ、んひゃぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「くっ……！　い、いいわ、そっちがその気なら、私だってもっともっと、あ\nなたのこと、虐めてあげるんだから！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404206" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「好きに腰を動かせるのはこっちも同じよっ……！　んぅんっ……！　マンコ\nもきつく、締めてっ、んあぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「この体勢だもの、さっきみたいに貴方の乳首だって弄り放題よっ……ほら、\nまた爪を立ててあげるから、痛みでみっともなく喘ぎなさい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404208" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んあぁんんっ……！　フフ、あなたこそ、強気な事言った割\nに、また情けない声が漏れてきてるわよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404209" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「乳首を痛いぐらいの力で抓られるのが、そんなにいいの？　演技とかじゃな\nくて、あなた、やっぱり本当にマゾなんじゃない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404210" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「んひゃぁんっ……！　ま、また、そんなに力強く、マンコの奥ッ、子宮まで\n一気に突かれてっ、ひっ、あっ、ふあぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404211" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「いいわ、勝負ね。どっちが先にアクメするか、今度は絶対、負けないんだか\nら♪　あっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404212" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「体勢的に、私の方が自由に腰を振り回せるんだからっ……んんっ、あっ、ん\nぅんっ……！　前後の動きも追加してっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「そ、そこ、Gスポットばかり狙うの、ずるいっ！　あっ、ふあぁんっ！　カ\nリ高チンポでマンコの中、全部掻き出されちゃうっ、あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404214" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「だけどっ、わたしだってあなたが弱い動きは把握してるのよ！　んくっ、あ\nっ、んふぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「こうして、マンコの中をぎゅうぎゅうって、リズミカルに収縮させるの、好\nきなのよねっ！　んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「あひっ、あっ、ふあぁんっ！　チンポ、ビクついてきたっ！　この反応、あ\nとちょっとっ、あっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404217" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「でも、ダメっ、んあぁんっ！　私もイクっ、イっちゃうっ……大きいの、マ\nンコの奥から競り上がってきてっ、あっ、ひっ、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「負けちゃいそう、なのにぃ！　先にアクメしちゃいそうなのに、自分で腰を\n振るのも止められないのっ！　ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「イク、イクイク、イクからぁ！　出して！　あなたもチンポ爆発させて、子\n宮に向かって熱々ザーメンミルクぶちまけてぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「イックうぅぅぅんんっ！　すごいっ、チンポがぴったりくっついてるから、\n子宮の中に直接、ドクドクってっ、あっ、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404301" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「あっ、んあぁんんっ……！　だ、駄目よ、確かに誘ったのは私、だけどぉ…\n…！　こんなに膣内出しされたら、夫以外の子供、妊娠しちゃうかもぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「でも、でもぉ……！　あひっ、あっ、ふあぁんんっ！　気持ちよすぎてっ、\n出されながらもピストン、止められなくてっ、あひゃぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「もっと出して、ザーメンミルク、もっとぉ……！　おっ、んおぉんっ！　ひ\nっ、あっ、ふあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……う、あぁ……すご、かったぁ……自分から男を見下ろ\nして腰を振るのって、こんなに気持ちいい、のね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404305" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「た、確かに、別に初めてって訳ではないけど……言葉で責めながらでいいの\nかしら……煽りながらセックスしたりなんて、しないから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「フフ、これ、本当に癖になっちゃったらどうしよう……夫ともこんな感じに\nすれば、少しはマンネリ解消になる、かしらね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404307" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「でも、今は……んぁんっ……まだ……まだまだ物足りないの……あなたも、\n二回出しただけじゃ、満足なんてしてない、わよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「――フフッ、限界って言っても、逃がしてなんてあげないわ♪　私にとこと\nん付き合ってくれるって言ったものね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「今度はまた、私の方からいっぱい虐めてあげるから……まだまだたくさん、\n気持ちよくなりましょう？　フフフっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「んああぁんんっ！　ダメっ、チンポ抜けちゃってっ、あっ、んんくぅうんっ\n！　ザーメンシャワー、身体に掛かってっ、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404401" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「もう一度膣内に出してほしかった、けどぉ……あっ、ふあぁんっ！　ぶっか\nけられるのも、悪くないわっ……♪　んあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「ザーメンが全身に付着して、熱くて、痺れて……あっ、ああっ、んあぁんん\nっ！　私もイク、イックうぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「フフ、フフフっ♪　こうして組み伏した男を見ながらするアクメ、いいわ…\n…これ、本当に癖になっちゃったらどうしようかしら……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404404" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「それに……すんすん……はぁ、このくっさい匂いも素敵……これだけは、膣\n内に出されちゃうと楽しめないものね……んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404405" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……まったく、途中から大暴れしすぎよ……今日は私に任せてく\nれるはずじゃなかったのかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「――た、確かに気持ちよかったけど、ほら……これからは私もお仕置きされ\nる側じゃなくてする側になっていくかもしれないから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「――え？　あなたにとっては私はいつでも虐める側？　……ふーん、言って\nくれるじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「フフ、分かってる？　今、自分がどんな体勢でいるか……っと、流石にこの\n状況で振り払われるほど、私の力も弱くないわよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404409" ]},
		{"command":[ "SETIMAGE", "0", "still_00018304_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イチカ" ]},
		{"command":[ "SETTEXT", "「さぁ、Sっぽいプレイの続きといきましょうか♪　あなたが泣き叫んだって\n、止めてなんてあげないんだから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_183_0404410" ]},
		{"command":[ "WAITINPUT" ]},

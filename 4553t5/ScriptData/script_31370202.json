		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「失礼します……夜の巡回に参りました。お加減にお変わりはありませんか？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204101" ]},
		{"command":[ "SETCHARA", "0", "char_00013702_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「えっ……身体に異変？　た、大変ですっ……一体どこが悪くなりましたか？\n　今先生を呼んで……えっ、違う？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204102" ]},
		{"command":[ "SETCHARA", "0", "char_00013702_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「異変は……こ、股間……それは、あの……もしかして、また溜まったとか…\n…そういう話をされていますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204103" ]},
		{"command":[ "SETCHARA", "0", "char_00013702_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「う……まぁ、困った時に助けるのは看護師として当たり前のこと……ではあ\nりますが……わ、分かりました……そんな悲しい顔をしないで下さい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204104" ]},
		{"command":[ "SETCHARA", "0", "char_00013702_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「せ、拙者の身体で直接……処理をして差し上げればよろしいですか……で、\nでは……上から、失礼致します……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204105" ]},
		{"command":[ "SETCHARA", "0", "char_00013702_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「うぁっ……こ、この勃起は……なんですか……本当に思いっきり上向きでは\nないですか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204106" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「拙者にしてもらえると思ったら自然に……うぅっ、とにかく……他の患者さ\nんもいらっしゃいますから、手短にしますからね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「い、いえっ！　準備は大丈夫ですっ……そのうちに慣れますから……入れま\nすよっ、あっ、くっ……ぅぅぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204108" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……あっ、くぅぅっ……入って……あっ、大きいのが……っくっ、め\nり込んで……う、っくぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204109" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「これは……んんっ！　ちょっと……前戯が必要だったかも知れません……く\nぅぅ……んっ、お、大きい……ですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっく……いえ、だ、大丈夫です……痛みはそれほど……ただ、広\nげられてる圧迫感が凄くて……っくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「もう少ししたら……馴染むと思いますから……ちょっとだけじっとしててい\nいですか……？　はい、ありがとうございます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んっく……ぅぅ……そ、その間は……おっぱいを見せて欲しい……本当に遠\n慮がないですね……もうはだけてますし……好きにどうぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204113" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「ふぅ……はぁぁっ……呼吸を整えて……ふぅぅ……何とか、中が……落ち着\nいて来ました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んくぅ……それでは……拙者が動きますから……じっとしていて下さいね。\nくれぐれも、怪我した両手は動かさないで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204115" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はい……行きます……んっ、ふっ、あっ、あんっ……はっ、うんっ、あっ、\nはぁっ、あっ、んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204116" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「や、やっぱり……大きいですね……お腹から……ぼこって膨らんで来そうな\nくらい……いっぱいになってます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「くぅぅ……動く速さは……これくらいで大丈夫ですか？　もっと速くても…\n…は、はい、そうしたいのは山々ですが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204118" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「拙者の方が……あまり激しくすると……腰が砕けてしまいそうで……んんっ\n、ふっ……くぅ……程々の速さになるかと……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「か、感じたら声を出してもいいとか……だ、駄目に決まってますっ……ここ\nは入院病棟なんですよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204120" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「いくら個室とは言え……んっ、はぁっ、すぐ隣の部屋にも患者さんが寝てい\nるんです……他の看護師さんだっているんですからね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204121" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「あぁ……そ、そんな状況なのに……こんな、制服をはだけさせて……隊長殿\nに跨って……イ、イチモツを咥えこんで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、腰を振っているなんて……あぁっ、そこっ、アソコが……ん\nぅっ、よ、呼び方……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204123" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「オ、オマ……い、言わないと駄目なのですか？　その卑猥な言葉を拙者に…\n…うぅっ、そんな命令……ぅぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204124" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「く……わ、分かりました……オ、オマンコ……オマンコに……隊長殿の勃起\nしたイチモツが入っております……んくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「本当は……こ、声を出したいのですが……他の皆さんに気づかれる訳にはい\nきませんから……静かに、腰を……振っております……っあ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204126" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「うぅっ……あっ……変です……あっ、ふっ……言葉にすると……それだけで\n、心臓が高鳴って……あっ、快感が……もっと……広がって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、んんっ、あぁっ……そんな、拙者が淫乱だなんて……そんなこ\nとは……これは、命令されたから……仕方なく……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204128" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んんっ、あふっ……けど……オ、オマンコが……濡れて……あぁっ、出し入\nれが、滑らかになって……行きます……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はっ、ひっ、あひっ……！　あぁっ、もう少し……速く……でしたよね……\nんっ、ふっ、あぁっ、こんな感じで……いかがですか……あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204130" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んぅっ……これ、はっ……気持ち……あっ、いいですっ……はぁっ、くぅ…\n…オ、オマンコ……感じますっ、あぁっ、あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はっ……ぅっ……声が漏れるのはっ……駄目です……まずいのですが……ん\nんぅっ、声……出て……しまいっ、ますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ……硬いイチモツがっ……下から……ぐいって突き上げて来て\nっ……腰がビクビクっ、あっ、震えてぇっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204133" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「こ、このままだと拙者の方が……イッてしまいますっ……あっ、隊長殿もっ\n……は、早くぅっ……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「あっ……あぁぁ……んっ……！　出てっ……中っ……精液っ……来まっ……\nしたぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204135" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁ……直接、奥に……あぁ……流し込まれてます……精液……熱いの\nが……こんなにぃ……はぁぁ……ふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んんっ、あぁ……なんて量を……隊長殿……拙者を妊娠させるつもりなので\nすか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204137" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はふっ、あっ、ふっ……止まった……隙間から……こぼれてきそう\nです……はぁ、はぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「気持ち……よかった……ですか。それは……よかったです……患者さんのお\n世話は大切な仕事ですから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204139" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「その、拙者も……気持ち……よかったですし……声……大丈夫でしたか？　\n皆さんにバレて……ませんよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「えっ……あ、まだ……終わりじゃないって……結構いっぱい出されていたよ\nうな……んんっ！　あっ……ま、また中……膨らんで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204201" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「このままでは収まりがつかない……うぅっ、結局……そうなるのですね……\nしがない下っ端は命令には逆らえません……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……は、はい……それでは、このまま……続けて……腰を振らせ\nて……いただきます……はっ、んっ、くぅぅ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「あっ、はぁっ、あぁっ……精液が……ぐちゅぐちゅ……鳴ってます……どう\nして、こんなに出してるのに、まだ勃起してるんですか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204204" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ……んんっ、拙者のオマンコが……良すぎて……うう……褒めて\n頂いてるんでしょうが……複雑です……んっ、あっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「とにかく、もう一回出すまで……ですからね？　あっ、んぁっ、あっ、また\n……奥に……届いてる……んくぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204206" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んんっ、ちょっと……隊長殿は安静ですっ……拙者がやりますから……あっ\n、あんっ！　そんな、下から……腰を突き上げるのはっ、あひぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204207" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はっ、んむっ、あぁ……こ、声が……んむっ……んっ、ふっ……うぅ……隊\n長殿……意地悪です……あ、そこ……上手……っ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204208" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んんっ、あぁ……か、感じやすいなんて……拙者、そんなつもりでは……あ\nっ、あぁ……違う……んんっ、これは、違うんです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「あぁ……もっと、拙者が腰を振って……コントロールしなくては……あっ、\nで、でも……あぁっ、中……あっ、かき回されて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204210" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ、あぁ……き、気持ちいい……あぁ……駄目……声が……あっ\n、漏れてしまいます……お許し下さい……隊長っ……あっ、んぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204211" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「少しくらい出しても……大丈夫っ……それはっ、でもっ……もし、バレたら\n……この後、どんな顔して……患者さんに会ったらいいかっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204212" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「て言うか……バレてなくてもっ……はぁっ、こんな……巡回中にセ、セック\nスしてるなんてっ……いやらしい……ことぉっ……あひぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_137_0204213" ]},
		{"command":[ "SETIMAGE", "0", "still_00013702_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オトハ" ]},
		{"command":[ "SETTEXT", "「んぁっ……！　し、締め付けがよくなったなんて……狙って、ないっ、です\nっ……あんっ、はっ、あっ、あぁんっ！」", "NORMAL" ]},

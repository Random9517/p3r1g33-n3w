{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0180" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「は～あ、キミをからかうのってなんでこんなに面白いんだろ？　いつもイタ\nズラさせてくれてありがとね～。これからもよろしくぅ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504101" ]},
		{"command":[ "SETCHARA", "0", "char_00023105_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「今まで、ボクを満足させてくれる人なんかどこにもいなかったから、キミに\nは感謝してるよ。超貴重だし、ボクなりに大事にしてるつもり……って」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504102" ]},
		{"command":[ "SETCHARA", "0", "char_00023105_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……な、なに？　目が怖いって。からかいすぎ？　遊びすぎ？　だ、だって\nボクはさ刻の道化師なんだから……って、うわあああっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504103" ]},
		{"command":[ "SETCHARA", "0", "char_00023105_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おっ、おぉおっ……！？　や、やってくれるじゃん、完全に油断してたよ…\n…！　まさか道化師のボクがキミに化かされるなんて……驚きだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504104" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んっ……まさかキミに襲われるなんて……。って、こ、このままここでする\n気？　するのはイヤじゃないけど場所が……うぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「今までのイタズラのお返しぃ……？　あららら、ちょっとからかいすぎちゃ\nったか～。ま、まあいいや、まわりにバレない手品を使って～って」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……うううっ！？　て、手が！　手が使えないよっ。これじゃ普通に人に見\nつかる……って、わ、わわっ、本気で脱がしてくるじゃん、やるねぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504107" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクのおっぱいを揉みしだいて……身体中を撫で回して……。わぁお……♪\n　もう興奮してるじゃん、チンポが大変なことになってるよぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504108" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「せっかくのドレス姿で露出プレイとは……とほほほ。って、んん～っ！　き\nょ、今日のキミの触り方めちゃくちゃいやらしいんだけど、エロすぎるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ……あっ、あぁ……♪　おっぱいっ、おっぱいを執拗に揉まれ\nると……んぁっ。さ、さすがのボクも身体が火照ってくるねぇ……。あっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504110" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「このポーズだと、おっぱいの丸さと重さが強調されてエッチだよね……って\n、んぅっ！？　ち、乳首をつまんでるのはどうして？　あっ、やめてよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ん、んんんん～っ！？　ち、乳首伸ばすとかありえないっ！　あっ！？　乳\n首の先っちょ指でクリクリしながら……わ、ぁ、あっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ひ、人の胸に好き勝手してくれるじゃん……！　って、今度はお尻……。な\n、なんの特徴もないフツーのお尻でしょ、なんでそんなに揉むわけぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504113" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……っくぅうっ……。そ、そんなとこあんまり自分でも揉まないから、な、\nなんかおかしな気分……。そ、そーぉ。キミ、ボクのお尻好きなんだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504114" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ふぅーん……。んんっ？　こ、今度はマンコぉ？　ぬ、濡れてるとかそうい\nうのは言わなくていいんだけど。そりゃこっちもさぁ……盛り上がるわけで」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504115" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんっ、ぅっ♪　んぅ……んんんっ……？　ヤ、ヤバイなぁ……？　ボクの\nマンコ、キミの指に吸いついてくちゅくちゅ言ってる。やらしいね……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ん……。そ、そうだね。感度はそんなに悪くないし……相手がキミだしさ？\n　そりゃ期待しちゃうし。っんふっ！？　あ、あんまり奥まで入れないで」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「マンコずっといじくられてたら、……あっ、ほ、欲しくなるよ……。ねえ、\n反省してるから！　イジワルしないでもう入れてよ……。ね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ねーぇ……？　いいよね？　チンポもボクのマンコ欲しがってるよ♪　合体\nしちゃお♪　２人で一緒に気持ち良くなろーよ……。ほら、入れてぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……あっ♪　やったぁあっ……♪　んっ♪　いつもどおりゴリゴリに硬いチ\nンポぉおおっ♪　あっ！　マンコ喜んでる、でも体勢が不安定でっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504120" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「な、なんか今までにないカンジっ……！　あっ♪　エッチな手品みたい、だ\nねっ……！　チンポだけで支えられて、奥の奥まで貫かれてさぁあ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504121" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んぁううううっ♪　こ、こんな安定しないポーズでピストンされたら……ど\nうなっちゃうんだろ！？　ねえ、早く、早くしてよ……。……ッあぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いっ♪　いいねっ♪　すごくイイっ♪　感じる、犯されてる感出てるよっ！\n　キミ、やることが天才かもっ！　あ～っ、マンコに効くぅううっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504123" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こういう天罰だったら、いっくらでも大歓迎なんだけどっ♪　……あっ♪　\nボクのマンコ、ぐちょぐちょに濡れてるよね♪　熱くて気持ちいい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクはキミのチンポがデカくて熱くて最ッ高に気持ちイイ……！！　っああ\nぁあああ……っ♪　んはぁああっ、イイっ、イイよこれぇえっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……ってヤバっ……！　人から見えなくなる手品もしてないからっ……、あ\n、あんまりおっきな声出すと見つかるぅ……！　っで、でも、でもさぁあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504126" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こんっ、なのっ！　昂りすぎて声我慢できないでしょっ……！　んぁあああ\nっ♪　グラグラガクガクしながら、ぶっといチンポに犯されるのイイっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……あっ♪　な、なんで動くのやめるのさ……！？　えぇ？　お仕置きなの\nに楽しみすぎてて腹がたつ？　勃起してるのはチンポだけでよくない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「反省しておねだりしろ……って、ぷぷぷっ♪　キミもホンット～にどーしよ\nーもないスキモノだね～♪　いいよいいよ、それくらいお安い御用♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504129" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクの大好きな、賢くてチンポのデカいキミぃ……♪　反省してるよぉ♪　\nだから悪い子のボクに気持ちいいお仕置きしてぇ……♪　おねがぁ～い♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504130" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクのヌルヌルマンコは、キミのつよ～いチンポで掻き回されないとイけな\nいんだ……♪　なんでもするから、いっぱいイかせてよぉ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……んんんんぁっ♪　やっ、たっ♪　おねだり成功～っ？　あっ♪　激しっ\n……！　イイよ、これだよ、これぇ……！　んああああ、イクぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504132" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「イクっ、イクっ……♪　あはははっ♪　キミのチンポもとっくに限界きてる\nんじゃないのっ？　わかるよぉ……だって繋がっているんだからっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ビクビク震えてるしっ……あんっ、マンコの中で限界だ～限界だ～って訴え\nてきてるよぉ、めちゃくちゃ中で膨らんできてるしさぁっ、あっあっあっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「イッちゃいなよっ、……それでボクが大きな声で喘ぎ声あげちゃってもいい\nじゃん！　出してよっ、ねっ♪　一番奥に出してぇ……！　ああああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんんぉっ！？　おぉっ！？　おッ♪　こ、これはぁあああ……っ♪　あっ\n♪　やるねぇっ、一瞬でボクのマンコが真っ白にぃいいっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504136" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おぉおおほっ♪　なんて勢いで射精してるわけっ……♪　あっ♪　お馬サン\nのチンポみたいにドビュドビュ精子注いでくるじゃん、えげつないねぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「っでもっ♪　ボクはそういう容赦ない射精だ～いすきぃいい……！　あああ\nあっ、子宮に直接精子ぶちまけられてアクメイキするぅううっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504138" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「イくぅううっ♪　アツアツザーメン注入されてアクメっちゃうぅうっ♪　ん\nぉおおっ♪　おぉっほっ♪　最高っ、最高ぅうっ♪　目の前チカチカするっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504139" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んぁあああっ……！　もっとちょうだい、いっぱいっ、いっぱいぃいっ……\n！　あはははっ、マンコで絞りとってあげるねぇっ……！　んあああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504140" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……くぅううう～っ……♪　たまらない射精だったよぉ、キミって毎日こん\nなに出してるわけ？　それとも今日は特別？　ボクがドレスだからかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「良かったよぉ～。もう、マンコから脳みそにまでぶしゃあああってぶちまけ\nられてるみたいだった！　たっぷり中出しされちゃって、うっとりしたぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504202" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こんな射精されたらさぁ……ボクもさすがに本気モード入るよねぇ。ぺろっ\n……♪　舌なめずりしちゃうよ。ねえ……まだまだできるよね～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こっちの身体に火をつけておいて、敵前逃亡なんて許さないんだから♪　え\n～？　敵じゃない？　そっかそっか。じゃあこれは味方のチンポなら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクがおいしくごちそーになっちゃってもアリだよねぇっ！　と、いうこと\nでいっただきまぁ～す♪　あっ♪　なんだガチガチのまんまじゃんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「まわりはもう気にならないのかって？　ならな～い♪　もうどうなってもい\nいよ♪　キミとこんなドレスでエッチできるんだからっ♪　最高っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「むしろ皆に見てほしいかもっ？　こうしてるキミとボクを……そう考えたら\n興奮してくるぅっ、あっあっ、マンコぐちょ濡れだぁ……すごいなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んっ、あっ……♪　って、もしかしてキミの方こそビビってるんじゃないの\n～？　いいの？　ボクが思いっきり腰動かしちゃってぇ……？　いいかぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504208" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「だってもう、お互いにやめられないもんね！　あんっ♪　チンポとマンコを\nこすりあって♪　ぶつけあって、ぐちゅぐちゅすることしか考えられないっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんんん～っ♪　あっぁっあっ♪　ホントキミのチンポの形好きぃいいっ…\n…！　っていうか、ボクのマンコがキミのカタチになってるだけぇっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504210" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んぉおぉっ♪　だってさぁ、ありえないくらいジャストフィットしてるんだ\nもん、……あっ♪　隙間なく密着して、ぬっちょぬっちょこすれてっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こんなの相性良すぎでしょ、気持ち良すぎてバカになっちゃうよぉおおっ♪\n　あんっ、あんっ♪　せっかくお姫様みたいなドレス着てるのにさぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボク、チンポのことしか考えてないアホな女になっちゃってるもんっ♪　ん\nぁああっ♪　それっくらいスゴいんだよこのチンポ、かっこよすぎぃいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あ～っ♪　あっぁっあっ♪　いいよ、いいよもっとほじってぇ♪　濡れ濡れ\nのマンコえぐってぇえっ♪　うんっ、うんっ、もっと奥きていいからっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504214" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ずっちょんずっちょん突いて、突き上げて、突きまくって犯してよぉおっ♪\n　あ～っ♪　んぁあっ、すっごいっ！　すっごいこれクラクラするぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、ギシギシっ、音してるっ……！　もっと揺らしていいよっ……その方\nが、……あっ♪　チンポしっかり味わえるからぁあっ♪　あううっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁ、あぁっ……んぁあああっ♪　ねぇえっ、みんな見てぇ♪　ボ\nクがチンポ入れられてるところ見てぇ、あっ、あぁううっ♪　んんん～っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504217" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……あッ♪　もうダメ、だめ、フツーにイクっ……！　んはぁあああっ♪　\nイクぅっ！　イクッ……！　あっ、ご、ごめん、マンコ締めすぎたぁっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ご、めぇんっ……！　もう気持ち良すぎて、自分でぜんっぜん制御できない\nんだよねぇっ！　ごめんねぇっ♪　遠慮なく精液搾り取らせてもらうねぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504219" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……うんっ♪　もちろんいいよぉ、イッちゃってっ！　出、して……♪　ボ\nクもイクっ……今までで一番おっきくイッちゃうよぉおっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504220" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「くぅうううっ……♪　素直にマンコの一番奥に射精してくれて嬉しいよぉお\nおっ♪　やっぱりボクは生で中出しされるのが好きぃっ♪　すっごい好きっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504301" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、ひぃっ……♪　２回目の射精だから余裕、かと思ったのにぃっ♪　１\n回目よりあっつい精液出してくれちゃってるじゃんっ、すごすぎぃっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「イ、クぅううううっ……！　イクっ……！　んぁあああんっ♪　こんなのイ\nカない方が難しいってぇえっ……♪　あっ、イク……トんじゃうぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504303" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、ひっ、ひぃっ……ごめんんんっ♪　ここまでイカされるなんて、よ、\n予想してなかったから……あっあっ、自分でも驚くくらい痙攣してるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504304" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「マンコ、ぎゅうぎゅうキツくなって……あっ♪　あっ、これって！　精液残\nさず飲み干すモード入っちゃったかもっ……あああああっ、イイよぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミの精液っ、ボクのマンコの中あがってきて……あっ！？　あっ、子宮を\n直撃してる、絶対受精させようとしてくるぅっ！　んああああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ん～～～♪　満足満足ぅ……。って、たはは……♪　結局２人とも、我を忘\nれてまわりのことなんて一切気にせずに盛りまくっちゃったね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504307" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクには失うものは何も無いからね、エッチがバレたくらいじゃ平気だよ。\nでもキミはどうなのかな～？　なんちゃって。ほら、他の女の子たちとかさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ヤキモチ焼く子がいっぱいいるんじゃないの～？　……ふふふふふ。ん？　\nボクがもっと焦ると思った？　まだまだこんなんじゃ追いつめられないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「もーっともっとビビらせてくれないとねー。さぁ、キミは次にどんな手を使\nってボクを追いつめるのかな？　今から楽しみにしてるからね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「うぁっ！？　わっ！　ふ、不意打ちで外出しぃっ！？　や、やってくれるね\nぇっ……！　ボ、ボクの隙をつくなんて……！　あっ、してやられたよぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504401" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あぁっ、１回目は生マンコにぃっ、２回目は身体に盛大にぶっかけぇっ……\n！　そういう欲望優先の射精大好き、かけて、どんどんかけてっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「うぁっ♪　次々にドロッドロの精液が降ってくる……！　あっ♪　そうなん\nだ、こんなに精子出ちゃうくらい感じてくれてたんだ、嬉しいな～っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「そっかそっかぁ……♪　２回目の射精なのにこの粘度……♪　それに見てっ\n、恥ずかしいくらい真っ白だよ♪　どれだけボクを孕ませたかったのさ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504404" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはぁ……っ♪　残念だったねぇ、精液くんたちぃ……マンコに注がれたか\nっただろうに……♪　でも、ぶっかけも男のロマンだからいいのかなっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504405" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ええっ？　ボクは気持ち良かったらどっちでもいいよ～♪　だから、キミが\nかけたかったならかけてくれて正解だから♪　ほら、最後まで出しきって♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ふっふっふっ……♪　ドレスを着れた上に、キミにザーメンシャワーまでし\nてもらえるなんて……今日は本当に特別な日、アニバーサリーだね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「え？　普通そんなに喜ばない？　ん～……ボクって天邪鬼なところあるから\nなぁ。２人で一緒に気持ち良くなれたんだからハッピーだよ。そりゃ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「でも……１つ反省するなら、今度からはこういうことする時は、事前に場所\nを２人で決めといた方がいいってことかな～。これ、絶対バレてたよねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「大騒ぎにしないでくれた人々に感謝♪　おかげで露出プレイが楽しめてお得\nでした～ってことで、ボクには大満足のパーティだったよ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0504410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
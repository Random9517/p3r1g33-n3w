		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「えへへっ……女かんぶって、すっごくすてきだったね。強くて、かっこよく\nて……プリシラも、ああなりたいなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00032701_01", "5", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「えっ？　あの人たちは悪い人だから、プリシラが女かんぶになったら、おし\nおきしなくちゃいけないの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00032701_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「そ、それって……エッチなおしおき、だよね。お兄ちゃんは正義の人で、プ\nリシラは悪い女かんぶってことだよねっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104103" ]},
		{"command":[ "SETCHARA", "0", "char_00032701_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「んっ……いいよ。お兄ちゃんになら、おしおきされても……ううん。おしお\nきされたいから、いっぱいして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104104" ]},
		{"command":[ "SETCHARA", "0", "char_00032701_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「きゃ、あんっ！　お兄ちゃんがお尻を叩いてっ……ひゃうっ！　あっ、んぅ\nぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104105" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「はふっ、んっ……はうぅぅっ……！　悪いことをした罪をみとめて、反省し\nたら……もうお尻ぺんぺんするの、やめてくれるの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「は、反省なんてしないもんっ。プリシラは悪の女かんぶなんだからっ……せ\n、正義のお兄ちゃんにくっしたりなんてっ……ひゃふぅぅっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「あっ、あんんっ！　さっきよりも強く、お尻をぺんぺんされてるよぉっ！　\nお兄ちゃんの手が、何回もお尻にあたってっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104108" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「プリシラのお尻、赤くなっちゃうっ……これ以上ぺんぺんされたら、大変な\nことになっちゃうよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……もう悪いことをしないって誓うなら、これくらいで許して\nくれるの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「うっ……うぅっ……は、反省しないっ！　プリシラは悪の女かんぶなんだか\nら、これからも悪いこといっぱいするよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104111" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「きゃ、あっ！？　お、お兄ちゃんの大人ちんちんが、大事なところにあたっ\nてるっ……ふぁ、あっ、はふぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104112" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「反省しないなら、お尻をぺんぺんするだけじゃなくて……お、おちんちんを\nいれるの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「うんっ……いいよ。お兄ちゃんの大人ちんちん、おまんこに挿れてっ……だ\nってプリシラ、反省しない悪い女かんぶだからっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「はぁ……あっ、すごいっ……お兄ちゃんのが、どんどん奥に入ってくる……\nひっ、ぐっ！　あっ、ふぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104115" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「あ、あそこのおく、うずうずってしてるっ……お兄ちゃんの大人ちんちん挿\nれられて、おヘソの下のところがあつくなってきてるのっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「はぁぁっ……き、気持ちいいよぉっ……おしおきされてるのに、幸せな気持\nちがあふれてきてっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「ふっ、んっ……はぁ、あぅっ……おしおきされてるのによろこぶのは、悪い\n子なの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「えへへっ……じゃあ、プリシラはいま、本当に悪の女かんぶなんだねっ……\nんっ……ぐっ、ふぁぁぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「お兄ちゃんの正義ちんちんに、負けたりしないんだからっ……このおっきい\nのでトントンされても、我慢できるんだからっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「ひゃ、あっ！？　あっ、あっ、うっ、あぐぅっ！　お兄ちゃんのが、でたり\n入ったりしてるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104121" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「プリシラのおまんこのなかで、ずりずり動いてっ……んんっ！　あっ、これ\n、すごいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「でも、これくらいなら耐えてみせるよっ……んっ、うぅっ……い、いくの、\n我慢できるはずだからっ……んひゃあぁんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104123" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「やっ、あっ！　あっあっ、あっ！　だ、だめだよっ！　大人ちんちん出し入\nれしながら、お尻ぺんぺんは反則だよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104124" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「気持ちいいのと、ちょっと痛いのが、おヘソの下のところでまざりあってっ\n……んっ！　あっ、はあっ、んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「ひゃひっ！　はっ、はうぅぅっ！　おにーちゃん、これ、へんになっちゃう\nっ！　プリシラのおまんこ、うずうずがとまらないのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「ちゃんと反省したって言ったら、いつでもやめてくれるの？　うっ、うぅっ\n……は、はんせーしてないもんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104127" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「プリシラは、あのカッコイイ女かんぶみたいになるんだからっ……うぐっ！\n　あっ、うぅっ、んふぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「あっあっ！　あっ、ひゃあぁっ！　お兄ちゃんの動きが、はやくなってるっ\n。おまんこ、いっぱいスリスリされてるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104129" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「それに、お尻をぺんぺんするのも、ちょっと強くなってっ……あっ、やぁぁ\nっ！　ぺんぺんやだぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「やぅっ、やっ、あっ、すごいっ……はぁっ、せっくす、きもちいっ……くっ\n、あっ！　ふはぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104131" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「おにーちゃん、はげしっ……あっ、はぁぁぁんっ！　き、きちゃうっ……気\n持ちいいの、きちゃうよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「ひとりでいくのいやっ！　おにーちゃんも一緒に……せーぎちんちん、一緒\nにいってっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「ちゃんとはんせーするから、お兄ちゃんと一緒がいいのっ！　あっ、あぁぁ\nっ、あぁっ、んはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「いくっ、いくっ！　おまんこいっちゃうっ！　おしおきせっくすで、いっち\nゃうよぉぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104135" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「はひっ、あぁぁぁっ……いくっ、あぁぁっ、びゅるびゅるって、あついので\nてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104136" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_09" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「プリシラのなかに、おにーちゃんのがいっぱいっ……せーぎのおしる、びゅ\n～ってされてるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「んっ、んぁぁっ……あっ、もっとぉ……お、お兄ちゃんの、おくのところに\nだしてっ……あついのそそいでっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104138" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「はぁぁっ……あっ、あっ……なかでおちんちんがはねてるっ……おにーちゃ\nんが、感じてくれてるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「うぅっ……嬉しいよぉっ。プリシラのおまんこで、せーぎちんちんをとりこ\nにしてあげるんだからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「はぁ……ふっ、はふっ……ちゃんと反省したみたいで嬉しいの？　えへへっ\n。プリシラ、はんせーしてないよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「さっき反省するって言ったのは、うそだもん。だってプリシラは悪の女かん\nぶなんだから、うそくらいつくよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104202" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「だまされたね、お兄ちゃんっ。えへへっ……おしおきしっぱいだねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「えっ……？　まだおしおきは終わってないの？　プリシラが反省して、こう\nせーするまでおしおきするの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104204" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「あっ、うぅっ……おちんちんが、なかで動いてっ……ま、まって、お兄ちゃ\nんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「プリシラ、いま、いったばっかりなのっ！　おまんこ、じんじんしててっ…\n…やっ、あっ！　んはぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「あぅっ、あっ、あっ！　プリシラのなかで、またせーぎちんちんがズリズリ\nされてるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「それにお尻もいっぱいぺんぺんされてっ……お、お兄ちゃんがほんきで、プ\nリシラのことはんせーさせようとしてるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、んんっ！　こ、このままだと、お兄ちゃんに負けちゃうっ……\nおちんちんでわからされちゃうよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104209" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「うぅぅっ！　プリシラはカッコイイ悪の女かんぶになるんだからっ！　お兄\nちゃんになんか、ぜったい負けないっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「ううんっ。むしろおにーちゃんを、悪のかんぶにしてあげるんだからっ！　\nぐっ、あふっ！　んっ、んぅ～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104211" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「こ、こうやって、おまんこをぎゅ～ってすれば……お兄ちゃんのせーぎちん\nちんの方が、さきにいくはずっ……ひゃ、はうぅっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104212" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　こ、これっ、もっと気持ちよくなっちゃうっ！　おまんこぎ\nゅ～ってしたら、おちんちんもっと感じちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "プリシラ" ]},
		{"command":[ "SETTEXT", "「だめっ、あっ、だめぇっ！　おまんこゆるめようとしても、かってにぎゅっ\nてなっちゃうっ！　あっあっ、あっ、あはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_327_0104214" ]},
		{"command":[ "SETIMAGE", "0", "still_00032701_02_14" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――来るのが遅いです！　昼間のことと言い、貴方、最近少し弛んでいるの\nではなくて？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203101" ]},
		{"command":[ "SETCHARA", "0", "char_00000142_01", "7", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「呼びだした理由は、わざわざ説明が必要ですか？　――え？　どうかしまし\nた？　デジャブ？　何を言っているのです？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203102" ]},
		{"command":[ "SETCHARA", "0", "char_00000142_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「とにかく、ふがいない貴方には仕置きが必要だと思いまして。たまにはしっ\nかり可愛がって、根性を入れ直してあげます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203103" ]},
		{"command":[ "SETCHARA", "0", "char_00000142_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……い、一応聞いておきますが、身体の方は問題ありませんか？　怪我をし\nているのであれば、先に仰ってくださいな。考慮いたします」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203104" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_03" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「また、その顔ですか……呆けていないで、人の話は真面目に聞いてください\n。――と言いたいところですが、本当にどうしました？　大丈夫ですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「問題ないならいいですが……べ、別に心配をしている訳ではなありません！\n　言ったでしょう、貴方の根性を入れ直すためにお仕置きをいたしますと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……出鼻をくじかれてしまいましたが、とにかくです！　貴方が気合を入れ\n直せるよう、オチンポを苛め抜いてあげます。覚悟はよろしくて♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……ふふ、中々座り心地のいいお顔ですね。心配せずとも、ひどいこ\nとはいたしません。このまま足でオチンポを苛めて差し上げますわ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「なんだかんだ言いつつ、最初からオチンポを勃起させているではないですか\n。お仕置きだと言っているのに、仕方がない下僕さんですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうして、両脚でオチンポを挟んで……んんっ……少し位置が悪いですね、\nもう少し深く座った方がいいかしら……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひゃんんっ……！　こ、こら、あまり大きく息を吸わないでください！　言\nうことをきかないなら、オチンポを足で踏みつぶしてしまいますよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、素直な態度は好きですわ♪　お尻に敷いたまま足コキをしてあげま\nす。罰してその屈辱をしっかりと身に刻んでくださいね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうして……んんっ……両脚の土踏まずで竿の中心の辺りを挟み込んで……\n上下にゆっくり擦っていく……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、いい反応です。言っておきますが、感じるのは自由ですが、勝手に\n射精するのだけは許しませんよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「これは罰です。みっともなく負けそうになった貴方へのお仕置きなのです。\n私が満足するまでチンポを苛めれて身悶えまくってくださいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「相変わらず固くて太くて熱くて……んんっ……なんて扱き甲斐のあるオチン\nポでしょうか……んしょ……皮も巻き込みながら扱いてあげます……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうして足の指で……んんっ……亀頭の付け根の所をくすぐる様に弄るのも\n、お好きでしたよね？　優しく撫でるようにっ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「我慢汁もどんどん溢れてきました……んんっ……これを足の裏に塗り広げて\nぇ……そらっ、ぐちゅぐちゅ、ぐちゅぐちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「圧迫して、離す、圧迫して、離す……ふふっ、オチンポがどんどん充血して\nきました。エラの部分も膨張させて、私の足、そんなに気持ちいいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁんっ……！　た、確かに感想を尋ねたのは私ですが、そのまま喋らない\nでくださいっ！　少し腰を浮かしてあげますからお待ちなさいな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――改めてどうですか？　屈辱的な体勢で足コキをされて、少しは自分のみ\nっともなさを省みることができましたか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――え？　自分にとってはご褒美でしかない？　ありがとうございます？　\n出来ればもっと激しく足コキしてほしい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……そうでした、貴方はそういう人でした。まぁでも、私も少し愉しくなっ\nてきたところです。……こういうプレイもたまには悪くないと言うか――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「な、なんでもありません！　ほら、お望み通り、このままぐちゃぐちゃにし\nて差し上げます！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「またお顔に体重をかけますね……んんっ……ふふ、お尻で踏まれた瞬間、オ\nチンポが跳ね上がりましたね、この変態さんめ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「足コキももっと激しくでしたね……オチンポの括れの部分に指が引っかかる\n様に……んんっ！　我慢汁も搦めて、もっと激しく……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「上下に扱くだけじゃない……んんっ……左右にも捻る様にっ……こうして余\nった皮をズリズリされるのがいいのですか？　気持ちいいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んんっ……こら、息を荒げないでください……股間の下でも\nぞもぞされたら、くすぐったいでしょうが……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「まだまだいきます……こうして根元に足を添えて、先端まで一気に……んん\nっ……！　ずりずり、ずりずりっ……ふふっ、オチンポが大暴れしてますね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ですが、勝手に射精するのだけは許しません。もう一度言いますが、これは\nお仕置きです。私が許可するまで絶対に出してはいけませんよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、なんだかんだ、貴方に好きなようにされることも多いですからね。\nたまには私が一方的に虐めるのも素敵です♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ、んふっ……はぁ、はぁ……んんっ……！　オチンポの先端もヒクつ\nいてきましたね。ふふっ、出したいですか？　私の足で射精したいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁんっ……！　だ、だからお尻の下でもぞもぞしないでくださいっ……！\n　ああもう、分かりました！　許可を出してあげます！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「このまま私の足の裏でオチンポを乱暴に扱かれて、精液をびゅーびゅー吐き\n出してしまいなさいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「カウントダウンしますので、それに合わせて射精してください♪　――さー\nん、にー、いーちぃ……ぜろ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぅんんっ……！　ふふっ、オチンポが大暴れですねっ……ぅんっ……！　\n相変わらず、なんて量でしょう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_07" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「オチンポがドクドクいってます……んんっ……尿道の中を精液が駆け上がっ\nていく感触が、足の裏から伝わってきます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、全然止まりそうにありませんね。私の足が精液塗れになってしまい\nそう……熱くてドロドロで……んぁんっ……仕方がない下僕さんめ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「出し切りましたか？　お尻で敷かれながらの足コキはどうでした？　――あ\nらあら、この体勢のままではやっぱり喋りづらいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――いえ、お尻はどかせません。何度も言わせないでくださいな。これはお\n仕置きなのです。一回射精したぐらいで、終わらせてなんてあげませんよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、精液塗れの足でもう一度オチンポを挟んで、っと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「出したばかりの精液で私の足はドロドロになっていますからね。ふふっ、滑\nりの速さは、今までと比べ物になりませんよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ、んふっ……ふふっ、オチンポもガチガチのままですね……んんっ…\n…やっぱり、一度出したぐらいでは貴方は満足できませんよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうして指の間まで精液を塗り込んで……亀頭全体を包んで撫でるようにぃ\n……すりすり、すりすり……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「やっぱりここは敏感ですよね？　軽くなでるだけでオチンポが大暴れして、\n足の中から逃げられてしまいそうです♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「竿の部分にこんなにも血管を浮かび上がらせて……こうして、足の裏でぎゅ\nーっと圧迫されるのもいいのでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ほら、また上下にも扱いてあげます。根元から先端まで一気にシコシコ……\n精液塗れの足裏でシコシコ、シコシコ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんっ……！　あ、あまり鼻息を荒くしないでください――と、言\nいたいところですが……んんっ……これだけ感じていれば仕方ありませんか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「なら私も、少し楽しませてもらいましょうか……んっ、んぁ……ふふ、こう\nしてお顔のデコボコに股間を擦り合わせるのは、中々悪くないです♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、んぅんっ……もちろんオチンポを扱くのも忘れていませんよ。\n貴方の弱点は全て把握済みですから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「エラの部分に指が引っかかる様にズリズリしてあげますっ……んんっ、んぁ\n……指先で先端を軽く擽って……ふふっ、オチンポが跳ね上がりました♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「また我慢汁も溢れてきましたね……精液が混じる合ってすごい匂い……はぁ\n、はぁ……んんっ……顔を近づかなくても頭がクラクラしてきます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「もっと激しく、もっと早く……んんっ……オチンポが脈打ち始めましたね…\n…ドクドクしてるのが足の裏から伝わってきます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「腰を浮き上がらせて、チンポの先端もヒクヒクさせて……ふふっ、私の足コ\nキでまたイってしまいそうなのですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「足で虐められて簡単にイキそうになる姿は、情けなく思えるのに……ふふ、\n少し可愛いとも思ってしまいます♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――いいですよ、許可してあげます。自分の不甲斐なさを反省しつつ、私の\n足コキでこのまま果ててしまってください！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「足裏でオチンポを強く圧迫してぇ……一気に……んんっ！　皮も巻き込んで\n大きくシコシコ、シコシコ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、みっともなくオチンポを跳ね上げ過ぎです。これはお仕置きだと言\nっているのに、本当にどうしようもないですね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁんっ……ほら、貴方の大好きな私のお尻ですよ。最後はしっかり押し付\nけてあげますから、私の体温をお顔で感じながら射精してしまいなさい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ほら、イきなさい！　女性のお尻に敷かれながら、足でオチンポを乱暴に扱\nかれてイってしまいなさいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203220" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んくぅんんっ～～！　ふふっ、二度目だというのにすごい勢い。私の足が精\n液塗れになってしまうではありませんか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「でも、まだまだ出せるでしょう？　このまま射精中も扱いてあげますから、\n反省の証として精液をもっと吐き出しなさいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうして……んんっ……根元からぎゅーっと絞り上げるようにして差し上げ\nれば……ふふっ、まだまだ出せますよね？　頑張れ頑張れ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああこら、腰を跳ね上げないでください。まだ全てを出し切っていないのに\n、逃がしなどしませんよ！　これはお仕置き、なのですから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……とはいえ、流石にそろそろ打ち止めですか……ふぅ……――どう\nですか、身動き取れない状態で、好き勝手足で虐められたご感想は？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひゃんっ……！　こ、こら、お尻を上げる前に喋り出さないでください！　\n今のわざでしょう！　――まったく、貴方と言う人は」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「この程度のお仕置きだと、反省が足りないみたいですね？　――え？　こん\nなプレイ俺にとってはご褒美でしかない、ですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そ、それは、まぁ……身体を痛めているかもしれない下僕さんに、あまり刺\n激の強い事をする訳にもいきませんし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――って、なんですか、そのいやらしい顔は！　や、やや、やめてください\n！　俺は分かってますよ、みたいな表情で頷かないでください！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「もう！　貴方がそこまで望むならお仕置きは続行です！　まだまだ虐めてあ\nげますから、覚悟しなさいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203310" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ……！　足の間でオチンポが暴れてっ……！　んんっ！　ちょ\n、ちょっと待てください、どれだけ精液を飛ばすつもりですか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんぅんっ！　胸どころか顔にまでかかって……あっ、んふぅんっ！　それ\nに、身体が跳ねてるから、貴方の鼻がオマンコに擦れてっ、あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんっ……！　ここぞとばかりに息を吹きかけてこないでください\n！　それでなくともお顔についた精液の匂いでくらくらするのにっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「に、二度目だというのに、なんて量っ……あっ、んぅんっ……！　私の身体\nをザーメン塗れにするつもりですかっ……んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああ、もういいです……最後までしっかり搾り取ってあげますから……んん\nっ……尿道の中にある精液までしっかり出し切ってしまいなさい……んぅんっ\n……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……んんっ……まったく、お仕置きだと言っているのに、\n好き放題出してくれたものですね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――え？　私の足コキが気持ちよすぎるのが悪い？　そもそもただのご褒美\nでしかない？　ありがとうございます？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うふ、うふふふっ……どうやら、この程度のお仕置きだと、反省が全然足り\nないようですね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000142_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「分かりました、貴方がそのつもりなら、お仕置きは続行です！　ふふっ、た\nった二回射精しただけでは、オチンポもまだまだ物足りないようですしね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふふっ、今更焦っても遅いです♪　まだまだ虐めてあげますから、覚悟し\nなさいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4203410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ひゃぅぅっ！　精子が身体にっ……！　あっ、あぁぁっ！　こんなにいっぱ\nい出されてぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604401" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ふっ、あっ、おぉっ！　熱くて、臭い精液がおっぱいやお腹に……！　あっ\n、あっ！　これ、素敵すぎるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「子宮の中も、外も、どっちも『せいし』と『せいき』に塗れてて……これが\n、サキュバス冥利に尽きるってことなのかしら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「んっ、んんっ！　幸せすぎて、何回もイッちゃうっ！　イクの止まらなくな\nってるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604404" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「また精子でイカせてっ！　身体に隊長の汁を浴びながら、いっぱいイキたい\nのぉ！　おっ、おぉっ！　んほぉ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「はふっ……はっ、あっ……頭の中、真っ白になりそうなくらい、気持ちよか\nったわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604406" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「あっ……！　ご、ごめんなさい……！　私ばっかり、こんなに気持ちよくな\nって……！　ちゃんと『せいき』を搾り出さないといけないのにっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「じゅうぶん搾り出したから問題ない？　そ、そう……それならよかったわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604408" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「それにしても、サキュバスってこんな感じでよかったのかしら……思い描い\nていたのとは、かなり違うような……」", "NORMAL" ]},

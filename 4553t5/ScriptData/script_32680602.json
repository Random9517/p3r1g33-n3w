		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「えっ？　無理しなくても、普段の私のままでいい？　そ、そう言ってもらえ\nると、すごく嬉しいわ……」", "NORMAL" ]},

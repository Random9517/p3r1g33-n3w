{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「今日は急に呼び出してごめんなさい……突然だけど、隊長にお願いがあるの\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604101" ]},
		{"command":[ "SETCHARA", "0", "char_00026806_01", "4", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「わ、私は今、サキュバスっていうエッチな生き物で……！　せ、せいき？　\nっていうのを搾り出さないと、生きていけないの！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604102" ]},
		{"command":[ "SETCHARA", "0", "char_00026806_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「それで、その……せいき？　っていうのは、君とセックスしたら手に入るら\nしくて……！　だ、だから悪いけど、『せいき』をもらうから！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604103" ]},
		{"command":[ "SETCHARA", "0", "char_00026806_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「あんんっ！　隊長のオチンポ、こんなの大きくなってる……もしかして、私\nの姿を見て、興奮してたの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604104" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ものすごくいやらしくて、部屋に誘われた時から期待をしてたの？　えっ、\nあっ……そ、そうなんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「えっと……参考までに聞きたいのだけど、私にどんなことをされると思って\nたの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「へ、へぇ……私がこうやって君に跨って、オチンポをオマンコに当ててスリ\nスリするところを、想像してたのね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「それって、こ、ここ……こういうこと、かしら？　んっ、んんっ！　あっ、\nあっ……ぐっ、あぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604108" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ふぁ、あぁっ！　隊長のオチンポが、オマンコに擦れてるっ……！　割れ目\nにデコボコしたところが当たって、気持ちいい……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「太くてたくましいオチンポが、オマンコにある小さな突起……クリトリス…\n…だっけ？　そこに、当たってるわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604110" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「んぁっ、あっ、あっ！　ぐっ、はぁぁっ……！　オマンコスリスリするの、\nたまらないっ……！　気持ちよくて、エッチな汁が垂れてきちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604111" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「はぁー……はぁー……！　君は、こういうことを想像してたのよね？　私に\n、こうやってエッチなことをされるのを、望んでいたんでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「え？　『せいき』とやらは、搾り出さなくていいのかって？　あっ……そう\nだったわ。せいき？　をもらうためにも、セックスしないと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604113" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「確か読んだ本だと、男の人とセックスする時は、エッチな言葉を言ったりし\nて、誘惑するといいって書いてあったから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「こ、こほんっ。今から私の……ド、ドスケベヌルヌルオマンコで……き、君\nのガチガチ勃起オチンポを、く、咥え込んであげるわ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「たくさん動いて、シコシコしまくってあげるから……！　す、好きな時に、\n精液どぴゅどぴゅしていいわよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「それじゃあ……オ、オオ、オチンポ、挿れていくから……！　えっと……い\nんらん？　なオマンコ、よく見ておいてね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ひゃ、あぁぁっ……！　おっ、あぁっ……！　すごい……！　太いの、どん\nどん入ってくるっ……！　私のヌルヌルオマンコに、オチンポくるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604118" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「お、奥っ……あっ、じゃなくて……！　あ、赤ちゃんの部屋の入口まで、隊\n長のが届いてるわ……！　ほ、ほら……分かるかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604119" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「このちょっとカタい感触がするところ……ここが私の一番大事なところ……\n君のせいき？　を搾り取って、注いでもらうところよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604120" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「んんっ、んっ……！　ちゃんと、奥まで入ったから……う、動く、わね。隊\n長のオチンポ……オ、オマンコで、ズポズポしまくるから……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604121" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「えっと……き、気持ちよかったら、声を出していいわよ。こ、こんなふうに\n……あっ、あぁぁぁんっ！　んっ、はぁぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ぐっ、やっ、あっ！　すごいっ！　オチンポが奥に突き刺さってるみたいっ\n！　なに、これっ……勝手にヘンな声が出ちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604123" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「あっ、ち、ちがっ！　これは、演技なんかじゃなくて……！　本当に、勝手\nに声が出てっ……んんっ！　ひゃ、あぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「だって、隊長とエッチ……セ、セックスしてるって思うと、身体が火照って\n、ヘソの下のところが疼いてぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「それに、こうやって自分から動くだなんて……こんな、いやらしくて、恥ず\nかしいことっ……んひっ、あっあっ、ふぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「やっ、あぁぁっ！　ダメっ……恥ずかしいのに、どんどん激しくなっちゃう\nっ！　腰を動かすの、止められないのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604127" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ふっ、ぐっ！　あぐっ、うぅ～～っ！　オチンポとオマンコのお肉と擦れ合\nうの、たまらないっ！　頭、おかしくなるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「繋がってるところから、私のエッチな汁が滲み出て……！　あぁぁっ、やっ\n、あっ！　ヘンな匂いがするぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「汁をぐちょぐちょってかき回す音もしてて……！　やっ、あっ！　み、見な\nいでっ！　こんないやらしい私、見ないでぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「感じながら恥ずかしがる私が、すごく可愛い……？　そ、そんなこと、急に\n言わないでっ！　今、褒められたら、私……あっ、あっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604131" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ひぐっ、あっ、おっ、おぉっ！　オマンコイッちゃうっ……！　気持ちいい\nのきちゃうぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604132" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ！　んっ、あっ！　た、隊長もイキそうなの！？　なら、膣内に\nっ……膣内に出してっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604133" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「私に『せいき』を注いでっ！　『せいき』と一緒に、『せーし』も注いで欲\nしいのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ひゃふっ！　あっ、あっあっあっ！　おっ、あぁぁっ！　イクッ、イクッ…\n…！　イッ、イギッ……！　ぐっ、んんん～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604135" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「はぁぁぁぁ～～～っ！　いっぱい出てるっ！　隊長のせーし、子宮にどぴゅ\nどぴゅ出てぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604136" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「あぁっ、お腹に幸せな感じが集まってくる……！　これが『せいき』なのか\nしら……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「んっ、うっぐっ！　た、隊長……！　もっと出してっ……！　私のオマンコ\nに、『せーし』と『せいき』を注ぎ込んでっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604138" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「もっとオマンコぎゅーって締めて、搾り出してあげるからっ……！　ぐぐっ\n、ふっ、んぐっ！　おっ、おぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「オマンコ締めると、もっと気持ちよくなるぅ！　あっ、あっ！　またイグッ\n！　イッ、イクぅぅぅ～～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ふはぁぁぁ……『せいき』を搾り出すのが、こんなにも気持ちいいなんてぇ\n……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604201" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……隊長、ありがとう。こんなに射精してくれて、すっごく嬉\nしいわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「えっ……？　『せいき』を搾り出すのは、一回でいいのかって？　た、確か\nに……本だと、何回か搾り出していたような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604203" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「私が望むなら、もっと『せいき』を出してあげてもいいの？　そ、そう……\nそれなら、お願いしようかな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「また私のオマンコでいっぱいシゴいて、気持ちよくしてあげるから……い、\nいい？　それじゃあ、動くわ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「おっ、おぉっ！　ふっ、おほぉ！　オ、オチンポの滑りが、さっきとは全然\n違うっ！　もっと勢いよくズポズポできるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604206" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「気持ちいいの、さっきよりも強くかんじちゃうっ……！　おぐっ、ほっ、お\nぉっ！　んおっ、おぉ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ふぅ、はっ！　ぐっ、あぁぁっ！　な、なに？　エッチなセリフは、言わな\nくていいのかって？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604208" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「そ、そうね……！　２回目のセックスだし、ちゃんとエッチなことを言わな\nいといけないわよね……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　あぁっ！　えっと……オマンコ、すごく気持ちいいわっ！　\nもっと激しくするから、しっかりオチンポ勃起させておいてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ふぐぅぅぅっ！　ぐっ、おぉぉっ！　おっほっ！　んおぉ～～～っ！　お、\nお腹が、オチンポで圧迫されるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604211" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ドスケベオマンコ、めちゃくちゃ悦んでるのぉ！　隊長のオチンポで、私が\nいんらん？　なメスだって、分からされるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ふぎっ、おっ、おっひっ！　オチンポの出っ張りでヒダのところ引っかかれ\nると、オマンコがぎゅーって締まっちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604213" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「私のオマンコ、隊長の形になってるからぁ！　あっ、あっ！　こ、このメス\nあな？　は、君だけのものなのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「好きな時に、好きなだけ精子をどぴゅどぴゅしてっ！　私が君だけのサキュ\nバスだってこと、証明してぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604215" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「また子宮に注いでいいし、何なら身体に精液かけたっていいっ！　隊長の精\n子なら、どこに出されても嬉しいからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「んっぎっ！　あっ、おぉぉっ！　ふほぉ！　イッ、イグッ……またイッちゃ\nうっ……！　オマンコイッちゃうぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604217" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「た、隊長もイッてっ！　さっきみたいに、精子びゅーってしてっ！　『せい\nき』、たくさん出して欲しいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604218" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　ふぉ、ほおぉぉっ！　イッ、イグッ……イグイグッ！　イッ\n、あっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ふぁ、んぁっ！　おっ、ほぉぉぉっ！　おっ、おぉっ！　ほぉ～～～～～っ\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604220" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_11" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ひゃ、あっ！？　熱いぃっ！　またオマンコに『せいき』と『せいし』出さ\nれてるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604301" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「すごい勢いで、子宮にどぴゅーってされてるっ……！　お腹に熱いの溜まっ\nていくの、感じるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「こんなの、妊娠しちゃう……！　あっ、あぁ……！　でも、隊長の赤ちゃん\nなら、すごく嬉しいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「『せいき』だけじゃなくて、赤ちゃんまでもらえるだなんて……おっ、おぉ\nっ！　幸せすぎて、またイクッ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「ひっ、んぎっ！　おっ、おっほっ！　おぉぉっ！　ほっ、おぉっ！　おひょ\nぉぉぉ～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604305" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「んっ、ふぅぅぅっ……何回も、連続でイッちゃったわ……さすがは隊長ね…\n…」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604306" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「こんなにイカされるなんて……私、サキュバス失格かも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「えっ？　立派なサキュバスになりたいなら、もっとセックスすればいいの？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604308" ]},
		{"command":[ "SETIMAGE", "0", "still_00026806_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「それはそうかも知れないけど……やっぱり私には、サキュバスなんて向いて\nないわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "スバル" ]},
		{"command":[ "SETTEXT", "「だって、別に『せいき』なんか貰わなくても……隊長がそばに居てくれるだ\nけで、じゅうぶんだもの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_268_0604310" ]},
		{"command":[ "WAITINPUT" ]},

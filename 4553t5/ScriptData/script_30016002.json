		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_12" ]},
		{"command":[ "SETTEXT", "「おぉぉぉ～～～～～っ！？　子宮に出てぇっ！？　奥の奥までザーメンが入\n　り込んでくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「き、気持ちよすぎて頭がおかしくなってしまう！　こんなの絶対に妊娠する！\n　貴様の赤ちゃん孕んでしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_11" ]},
		{"command":[ "SETTEXT", "「あっ、あんっ！　あっ！　貴様との赤ちゃんを授かれるなんて幸せすぎる！\n　嬉しすぎて子宮までおかしくなりそうだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_12" ]},
		{"command":[ "SETTEXT", "「あひっ！？　あっ、おぁっ！　あっぐぅぅぅっ！？　射精がとまらないっ！\n　ずっと精子が出続けて……はひっ！　くぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こんなの味わったら私もイキ続けてしまうぅぅぅっ！　イクッ！　イクイク\n　ッ！　オマンコイグぅぅぅぅぅ～～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_11" ]},
		{"command":[ "SETTEXT", "「はーーー……はーーー……こんなに出すとは……本当に呆れるほどの性欲だ\n　な……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……なんだ、またニヤニヤして……そんなに私の乱れた姿が面白かったのか\n　？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_10" ]},
		{"command":[ "SETTEXT", "「……そうじゃない？　貴様の子供を妊娠したがってる私の姿が愛おしくて顔\n　がニヤけてしまうだと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だ、だだ、誰が貴様との子供を妊娠したがってるだと！？　勘違いも大概に\n　しろ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「い、いいか！　貴様は何も聞いていないし、私は何も言っていない！　すべ\n　ては花火の音で生まれた雑音だ！　分かったな！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},




		{"command":[ "LABEL", "LABEL2" ]},

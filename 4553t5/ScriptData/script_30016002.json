		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「きゃ、あっ！？　あ、熱いぃ！　ドロドロの赤ちゃんミルクが身体にかかっ\n　ているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふぁ、あぁぁっ！　この濃厚な精液の香り……これを嗅いでいるだけで、オ\n　マンコがきゅ～っとなってしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_14" ]},
		{"command":[ "SETTEXT", "「子宮が精液でいっぱいなのに切なくなって……うぅぅっ！　焦らされている\n　みたいでたまらない！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_15" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ！　んぁっ！　イッ……イクッ……オマンコ切なくて、またイク\n　ッ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ！　あっ！　やっ！　あっ！　イクイクッ……イッ、クぅぅぅぅぅんっ\n　！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_14" ]},
		{"command":[ "SETTEXT", "「ふっ……んっ……はっ、あっ……こ、こんなにもイッてしまうとは……やは\n　り貴様のザーメンはすごい……じゃなくて！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「おい、下僕！　どうして膣内に出さないんだ！？　せっかく赤ちゃんを作る\n　機会……ではなく、浴衣が汚れるだろう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_13" ]},
		{"command":[ "SETTEXT", "「……なに？　膣内も膣外も全部真っ白にして、貴様の女だと証明したかった\n　だと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000160_02_14" ]},
		{"command":[ "SETTEXT", "「き、きき、貴様の女などと……うぅぅぅっ！　貴様というヤツはぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_6004409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「どうしてそんなに不機嫌そうなのかって……そんなの貴様のせいで花火が見\n　れなかったからだ！　それ以上でもそれ以下でもない！」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ふふふ……今日の私は一味違うよ！　何と言っても『女幹部』だからねっ！\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403101" ]},
		{"command":[ "SETCHARA", "0", "char_00021904_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「あれ、いいのかなぁ？　そんな呆れたような顔を向けても？　幹部に昇進し\nた今の私には、キミのことを『お仕置き』する権利があるんだよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403102" ]},
		{"command":[ "SETCHARA", "0", "char_00021904_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「まぁね？　今まで私がお仕置きされてきたのは、私のミスが原因だから当然\n納得はしてるんだけどね？　でも、それはそれ、これはこれ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403103" ]},
		{"command":[ "SETCHARA", "0", "char_00021904_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「色々恥ずかしい思いをさせられた恨みは忘れてなんていないよー？　ってな\nわけで、今日はいつもの仕返しです！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403104" ]},
		{"command":[ "SETCHARA", "0", "char_00021904_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「拒否権なんてありませーん！　ほら、早く服を抜いで、床に寝そべりなさー\nい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「よいしょ、っと……ん？　どんなお仕置きをするのかって？　この格好でな\nんとなくわかると思うんだけど、足で虐めてあげよっかなって♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403106" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「――ふふ、ごめんごめん、そんな不安そうな顔しないでよ。確かに仕返しし\nたい気持ちがちょっと……いや、かなりあるのも事実だけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403107" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「これでもキミのこと、結構気に入ってるんだよ？　お仕置き……だけど、し\nっかり気持ちよくしてあげるから……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「――じゃあ、始めるね？　知ってるよ、キミってば、こうしてタイツを履い\nた足でチンポシコシコされるの、好きなんだよねー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403109" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んっ……ふふ、何だかんだ言いつつ、チンポは最初から期待しちゃってるじ\nゃん。こーんなガチガチに勃起させちゃって♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んっ……こう、かな……？　あ、駄目だ、もっとギュっとしないと、チンポ\n逃げていっちゃう……んっ、これで、どうだろ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403111" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「よし、しっかり足の裏で挟み込めた――うっ……て、手際が悪いのは多めに\n見てよ……お仕置きする、なんて、まだ慣れてないんだからさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403112" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「は、ほら！　余計な口を利くなら、気持ちいいお仕置きじゃなくて痛いお仕\n置きに切り替えちゃうよ！　しっかりチンポに意識を集中させなさい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「最初はゆっくり、皮を巻き込むように、シコシコしていくわね……んんっ…\n…足で無理矢理される恥ずかしさに、身悶えちゃいなさい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403114" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んしょ、んっ……左右の足の裏で擦り合わせるように、ぐりぐり……ん、こ\nれであってるよね……大きく足を動かして……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「わわっ、先走りが一気に溢れてきたっ……こうして改めてチンポを見ると、\n結構グロテスクな見た目してるよね……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「でも……ふふ、私の足で好き放題されてピクピクしちゃってるのは、ちょっ\nと可愛いかも……んっ、んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403117" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「裏筋の所も、もっとごしごしってしてあげる……んんっ……タイツが滑るか\nら、これはやりやすいかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「足の指を使って、括れの部分も……んっ、んぁ……えっちな先走りを、塗り\n込むようにしてぇ……あっ、んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「少し、慣れて来たかも……こうやって踵で根元をぎゅーって押さえれば、足\nの裏でシコシコしやすいや……んっ、もう少し、早く……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403120" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ふふ、どう、かな……？　足でされてるのにこんなにチンポビンビンに反応\nさせちゃって、しっかり恥ずかしがってくれてる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403121" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「お仕置き……ではあるけど、気持ちよくもなってくれてたら嬉しいな、なん\nて……――あっ、ふふっ、そっか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「チンポの先っぽも、こーんなに素直にピクピクしてるし……もっと気持ちよ\nくしてあげちゃおっかな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403123" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んっしょ、っと……さっきまでよりもっと強く、踏みつぶすみたいに、チン\nポを圧迫してっ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「スベスベのタイツで、敏感な亀頭をスリスリ……♪　指を使って、先っぽの\n穴もぐりぐりしちゃったりぃ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403125" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「このぐらいなら痛く、ないよね……？　って、ふふ、その顔見た感じ、聞く\n必要もなかったね。この動き、そんなに気持ちいいの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「まったく、これはお仕置きって言ってるのに、堪え性のないダメダメチンポ\nなんだから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「いいよ、望み通り、もっともっと気持ちよくしてあげちゃう♪　んっ、んん\nぅ……タイツに先走りを塗り広げてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403128" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「激しくシコシコ、足コキでシコシコ♪　ビクビクチンポを足の裏でぎゅっぎ\nゅっ♪　根元から先端まで一気にシコシコ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403129" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「私、別にそういう趣味があるわけじゃないんだけど……こうして私の足で身\n悶えてるキミの顔を見てると、そういうのも悪くないかなって思えてくるね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403130" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「――もちろん、我慢なんてしなくていいよ♪　このまま激しく、ラストスパ\nートかけてあげるからっ……んんっ、んぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403131" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「私の足の裏で精液だしちゃおう♪　お仕置き足コキで、びゅーびゅーって精\n液漏らしちゃえっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403132" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「浮き上がった血管をぎゅーって押さえてぇ……んんっ……ヒクつく先っぽに\nもまた指をかけて、ぐりぐり、ぐりぐり～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「根元の……玉の所も踵を使って、優しく押してぇ……ふふっ、流石にここは\n敏感？　軽く触っただけなのに、チンポが跳ね上がった♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ほら、出してっ！　スベスベスタイツにキミのドロドロ精液、思う存分ぶち\nまけてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403135" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んあぁぁんっ♪　ふふっ、すごい勢いっ、んんっ♪　私の足コキ、そんなに\n気に入ってくれたの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403136" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「まだまだ全然、止まりそうにないや……んっ、あぁんっ♪　タイツ越しでも\n、しっかり熱いのが伝わってきてっ……んぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403137" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ほら、まだ尿道の中にも残ってるよね？　駄目だよ、力を抜いちゃ、全部出\nし切っちゃえっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「シコシコ、ギュっギュっ、シコシコ、ギュっギュっ♪　ふふっ、ビクつきな\nがら精液を吐き出すチンポも、ちょっと可愛いかも♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んっ……そろそろ終わり、かな？　はーい、よくできましたー♪　最後まで\n足の裏でヨシヨシしてあげちゃう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403140" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「――っと、やっぱり一回出しただけじゃ、チンポ固いままだね？　もしかし\nて、まだ物足りなかったりする？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ふふっ、仕方ないなー♪　自分から追加のお仕置きをおねだりするなんて、\nキミってば、結構変態さんだよねー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403202" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「――え？　それは私も？　足コキでオマンコを濡らしてる女に言われたくな\nい？　……あっ！？　こ、こら、あんまりじっと見ないでっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403203" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「うっ……し、しょうがないでしょ……そういうこと、してるんだから……キ\nミから漂ってくる匂いもえっちだし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403204" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「あー、もう！　わざわざ恥ずかしい事を指摘してくるならキミなんて、本当\nに『お仕置』しちゃうんだからね！』", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ほら、出したばかりの敏感チンポ、さっきよりもっと強く踏んでっ、扱いて\nっ……ずりゅずりゅって、掻きまわしてっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「だーめ♪　今更謝ったって遅いんだから♪　んんっ……このまま、もっと乱\n暴に、もっともっと激しくっ……あっ、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403207" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「これ……んっ……さっきの精液が足に絡みついてくるから、ぐにゅぐにゅっ\nて、不思議な感じがする……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「足の裏がぬるぬるになってるから、またチンポが滑っていっちゃいそう……\nもっと強く、括れの部分を踏みつけてっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「キミが喜ぶ動きは、さっきまでで把握済みだからね♪　こうやって親指で先\nっぽの穴をぐりぐり、ぐりぐり～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「――もう、そんなに縋るような目をされちゃうと、おねだり、聞いてあげた\nくなっちゃうじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403211" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「確かにこれは『お仕置き』、だけど……んんっ……いいわ、キミの望む通り\n、このまま一気に、思う存分イかせてあげるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んっ、あっ……んあっ……！　足の裏にドロドロ精液を塗り込んでっ……足\nの裏でシコシコ、根元から先端まで、勢いよくぎゅーっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403213" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「やっぱりこれ、ちょっとゾクゾクするかも……私の足でキミが身悶えてるっ\nて思うと、お腹の奥、きゅんってしてっ……んぅんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「キミってば、また視線がいやらしとこに向いてない？　――え？　だからお\n仕置きが必要？　もっともっと激しく足コキしてくれ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「まったく……ふふっ、じゃあお望み通り、チンポ一気に擦り上げちゃうから\nね！　苦しいって言っても、止めてあげない！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403216" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「私の足の裏で思う存分虐められて、恥ずかしい声で喘いでっ……んんっ……\nさっきみたいにチンポビクビクさせて、精液ぶちまけちゃえ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ほら、また裏筋の所もずりずりってっ……！　んっ、んあっ……指を括れに\n引っ掛けて、痛いぐらいの力で、ぐりぐり、ぐりぐりっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403218" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「我慢なんてさせてあげないわ♪　これは『お仕置き』なんだから♪　される\nがままに受け入れて、恥ずかしい射精を私にみせるの♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ほら、イッちゃえ♪　びゅーびゅーって情けなく射精しちゃえ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んあぁんっ♪　二回目なのにすごい量♪　足の裏また、べとべとになっちゃ\nう、んんっんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403301" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ほーら、最後までぎゅっぎゅって搾り取ってあげるから、玉の中が空っぽに\nなるまで出しちゃえ……んぅんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「真っ赤に膨れ上がってる亀頭をふみふみ、ふみふみ～♪　ふふ、痛い？　け\nど、これが気持ちいいんだよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「やっぱり私、そういう気があるのかな？　足でチンポをいじめられて喜んで\nるキミを見ると、なんかこう……んんっ……不思議な気持ち」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403304" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「少しでも力を強めたら、このままチンポを踏みつぶせちゃうんだよね……キ\nミはどんな声で鳴いてくれるのかな……ふふふっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んっ……流石にもう出ない、かな？　本当にいっぱい出したねー？　精液の\n熱で、私の足の裏火傷しちゃうかと思ったよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403306" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「――うん、どういたしまして♪　って、思ったけど、一応これは『お仕置き\n』だからね？　お礼を言われるのはこう、なんかちがくない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「細かい事は気にするなって……んー、どうも反省してるようには見えないな\nー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ふふっ、そんな生意気なキミには、まだまだ『お仕置き』必要だよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403309" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「これからは『女幹部』として、いーっぱい分からせてあげちゃうから、覚悟\nしてね？　ふふふっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「んあぁんっ♪　す、すごい勢い！　足の裏だけじゃなく、身体にまで届いて\nっ、んんっんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403401" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_18" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「射精しちゃえとは言ったけど、人の身体にぶっかけていいとは言ってないん\nだけどなぁ？　この悪者チンポめっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ふふっ、だーめ、射精中でも足は止めてあげない♪　これは『お仕置き』な\nんだから、んぅんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403403" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「いーっぱい射精して、苦しいほど全部を出し切るまで、絶対に足コキは止め\nてあげないんだから♪　しっかり反省するんだよー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403404" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ほら、出したばかりの精液も使って、シコシコ、シコシコ～♪　逃がしてな\nんてあげない♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「キミがみっともなく喘いでる姿、目に焼き付けさせてもらうからね♪　この\n恥ずかしさ、しっかり覚えておくよーに♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「――んっ、流石にもう出ない、かな？　まったく、私の身体、キミのくさー\nい精液でドロドロになっちゃったじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403407" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「そうだねぇ……『女幹部』様にそんな失礼なことをする子には、まだまだ『\nお仕置き』が必要だったりするかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「ふふっ、必死に頷いちゃって、キミってばそういうところ、可愛かったりす\nるよねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403409" ]},
		{"command":[ "SETIMAGE", "0", "still_00021904_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "乙女" ]},
		{"command":[ "SETTEXT", "「お望み通り、これからは『女幹部』として、いーっぱい分からせてあげちゃ\nうから、覚悟してね？　ふふふっ♪」」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_219_0403410" ]},
		{"command":[ "WAITINPUT" ]},

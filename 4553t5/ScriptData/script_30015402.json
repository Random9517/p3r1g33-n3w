{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00000154_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev001_54b_0000", "ev001_54b_0023" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……やっと来たか。うむ。貴様を呼び出したのは他でもない。聞きたいこと\nがあったからだ。今回、ドレス姿で何人も集まり競い合ったわけだが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603101" ]},
		{"command":[ "SETCHARA", "0", "char_00000136_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「率直に言って、誰が最も王者にふさわしく、美しく、強く輝いていたと思う\n？　……私？　本当にそう思っているのか？　私がズバ抜けて一番だったと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603102" ]},
		{"command":[ "SETCHARA", "0", "char_00000136_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふむ……。それなら……それが本心かどうか、私が直々に調べさせてもらう\n。何、貴様にとっては褒美のようなことしかしないから安心しろ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603103" ]},
		{"command":[ "SETCHARA", "0", "char_00000136_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「っん……！　フフ……。貴様もこの部屋に呼び出された時点で、相当期待し\nていたようだな……？　もう、チンポをこんなに大きくしているじゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603104" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「これほど硬く勃起しているのだから信用してほしい？　……まだ心の底から\n信じるわけにはいかない。絶対に、私が１番だった証拠を掴んでみせる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「どれぐらい、貴様が私のこのドレスに魅了されたのか。口ではなんとでも言\nえるからな。それに比べて、チンポは嘘をつかない。そうだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……どれどれ……。んん……っ、キツい臭いだな。ズボンの中で蒸れたのか\n……？　すん……すん、こもった汗のような香り……。すん、すん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「大きさは……いつもどおりか？　んっ、私に見られてピクピク震えている…\n…。色も変わりなし……、形も今までと同じ。硬さは少し増しているような」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「太さも……問題ない。熱くて、手の中で痙攣している以外はこれといって異\n常はなさそうだが……。……すん、や、やっぱり臭いな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ちゃんと風呂に入ってチンポは丁寧に洗っておけ。でないと、急にこういっ\nた状況になった時に私が驚くだろうが！　わ、わかったな？　ん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……なんだ。私の手で調査されているのが気持ちいいのか。貴様のチンポは\n随分と欲しがりだな。私がぎゅっと握っただけで大喜びじゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうやって……手のひらで包みこんで、ゆっくりシゴいてほしいんだろう？\n　いやらしいチンポめ。そういう悪いチンポはこうだ、お仕置きだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……。ん、ん、んんっ、んん……！　フフフ、私が手を動かすたびに\n、嬉しそうに反応して……。……ほら、私とこのドレスを褒めたたえてみろ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「どんな風に……。んっ、素晴らしくて、どんな風に良かったのか……。ん、\nどこに興奮して、どこを見ていたのか、全て白状しろ……。ん、ん、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「きちんと言わないとぉ……こうだ♪　亀頭をぐりぐりぐりっ……、太い肉竿\nをぐにぐにぐに……♪　どうだ、ひとたまりもないだろうっ……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……何？　一方的にチンポをいじるなんてひどい、だと？　自分も何かした\nい？　……私にクレームを入れるとは……。だが、それもそうかもしれない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私がチンポを調査している間だけなら、その……。貴様の目の前にある私の\n下半身を、好きにしてもらってかまわない。それなら等価交換だろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああ、そうだ。尻を撫でたり……。って、んぁあああっ！？　き、貴様ぁっ\n……！？　何をしているっ、と、突然アソコにキスを！？　あっ！？　あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「し、尻を触るくらいかと思っていたらっ……んんんっ！？　ま、待て、どう\nして初手からオマンコの割れ目に迷いなく口をつけて……んひぃいっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、ク、クンニを……！？　あっぁっあっ？　こ、これは私のミ\nスだ……、完全に油断してしまっていて……。んぁああっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「き、貴様にペースをつかまれてしまうとはぁあっ……！　あぁっ、わ、私は\n王者だぞ、最強の王位継承者ぁあ……それがクンニごときに負けるなんて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ゆ、許されないぃ……！　な、何か反撃しなければっ……。……んぁああっ\n！　むしゃぶりつくな！　吸うな、舐めるな！　こ、こうなったら！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はむっ！　ぐちゅっ……！　こ、これでどうらっ……！？　んんんむっ……\n！　きしゃまが私のオマンコにクンニするならこちらはフェラチオだっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ……じゅるっ、ぐちゅっ！　フフフフ、貴様をこらしめるには最高の技\nらろうっ……？　じゅるっ……んれろっ、れろっ、ぐちゅっぐっちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603124" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev001_54b_0000", "ev001_54b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「な、何……？　気持ちいいだけ？　自分が得しているだけ？　そ、そんなわ\nけあるかっ、このフェラチオは貴様への罰、貴様への躾なのだ……じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「おかしなことを言うなっ！　どんどんこちらから攻めていくぞっ……！　じ\nゅぷっ！　じゅるっ、ぐちゅっ！　ぬちゅっ、ぬっぽぬっぽっ、んぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……よく考えたら、この体勢は６９というやつでは……？　い、いや、違う\n！　私が貴様を屈服させているはずだ！　そ、そうに違いないぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……負けるものかぁ……っ、んれろっ、ど、どうだこの舌使い……！　腰砕\nけになるがいい……、ん、ちゅっ♪　くちゅっちゅぷっぷちゅっ、れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん、ん、ん、んじゅる……！　……ふぁああっ！？　割れ目を舌でこじあけ\nるなぁっ……あぁっ、な、中を舐め回すな……！　ん、じゅるっじゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あ、はっ……♪　んぁああ……っ！　ビクビクと足が震えてしまうぅ……！\n　んぢゅっ、ぐちゅっ、れろ……れろっ、れるっ、じゅるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「やめろっ、イッてしまうっ……！　んぁああああっ！　……い、いやっ、イ\n、イッてなどいないっ……！　だ、黙ってフェラチオされていろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんんん～っ……！　イッ……♪　……て、いないっ、イッていないっ！　\nぴちゃっ……ぴちゃっ、ぐちゅっじゅるっ、じゅるるるっじゅるんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ほ、ら……！　そろそろこのチンポも限界らろうっ……♪　我慢せずにイッ\nていいのだぞ？　んん？　出してしまえぇ……！　じゅるっじゅっぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603133" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ガチガチに勃起した貴様のチンポから、大量に白い精液が飛び出すところを\n……んんっ、この目で見ていてやる！　れろっ、ほらっ、ほらぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んれろっ……。嫌がろうと無駄だ、絞り抜いてやる……じゅるっ！　れろっ\nれろっ……じゅっ♪　じゅるるるっ！　じゅるっ、さあ出してくれ、今っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んッ……！？　んむぅううっ……♪　んくっ……んんんっ……！　す、すご\nい粘り気だ……っ。あぷっ、んぷ……♪　お、溺れるぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_06" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁ、つ、次々に濃い精液が口の中に飛び込んれきて……！　んぁああっ…\n…！　ぁっ、く、口の中がすぐにドロドロにぃ……。ん、んぅ～っ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こ、このままれは息ができない……。……ん……、せ、精液を飲むべきか…\n…。って、んむぅううっ！？　ま、まだ出すのか！　あっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「りょ、量が多すぎるぅうう……。飲むしかない、……ごくっ。ぅ、に、苦い\nぃ……。ごくっ……。しかも濃すぎてなかなか飲み干せな、いぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん、ん、ごく……！　こ、こらぁっ、飲んでいる最中に追加で出すな……！\n　あ、ぁ……ごくっ。ごくんっ。こ、これでいいだろうっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……ふぅうう……。ようやく射精が終わったか……。……なんだ？　これだ\nけ盛大に射精してみせたんだから、私の魅力は証明されたはず……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そう、だな……。確かに貴様はドレス姿の私のフェラチオで、信じられない\nくらい大量に射精した……。しかし……。先にイカされたのは私で……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……うむ。なんだかすっきりしない。なのでこのまま、調査を続けさせても\nらう……。今度こそ、私が一方的に貴様をイかせてみせるから見ていろ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん……れろぉおお♪　ぴちゃっ、ちゅぷ……れるっ、くちゅっちゅく……♪\n　フフフ、本当にチンポは素直だな。まだ硬いままじゃないか……ちゅくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603204" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev001_54b_0000", "ev001_54b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「わたひの舌でネロネロねぶられると、大袈裟なくらい感じてヒクついている\n……♪　ぴちゃっ、んん？　この舐め方がいいのか？　くちゅっぴちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「尿管に残った精液と……ぴちゃっ、肉竿についたままの精液を舐めて……ん\nぅ、に、苦い……！　一体何を食べたらこんな苦く……ぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「優しくチンポの表面を舐め清めたら……咥えるっ。……ぐちゅっ！　ぬっち\nゅっぬっちゅっ、唇を使って先端をまんべんなく刺激してぇ……んむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「大きく頭を使って、……じゅるっ！　んっ、じゅっぷっ！　　じゅっぽっ、\nじゅぽっ……！　口の中を真空にひながら……ぐちゅっ！　じゅぷぷぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んふ……っ。そうか、少し強めにしゃぶるくらいがいいんだな……？　覚え\nた、ぞ……♪　じゅるっじゅっぷっぢゅるっ……！　んっ、んっむっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「どうだっ……じゅぷっ♪　たまらなくなってきたか？　んっ……♪　ぢゅる\nっ、じゅぷっ……！　……んんん！？　や、やめっ、は、反撃するな！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぁ……っ♪　オマンコっ……あっ♪　オマンコをねぶるなぁ、く、口が動か\nせなくなるではないかぁあ……っ♪　ん、ぁっあっあっ、あぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「な、なんというねちっこい舌の動かし方だ……っ、あああっ。夢中で愛撫す\nるなぁっ……！　あっ♪　あっ、照準がズレるぅ……んっ、ぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「れろっ、れろっ、れる……ちゅくっ♪　んんんぅ……♪　ぐちゅっ、ずちゅ\nっ、にゅるっ……くっちゅっ♪　あ、ぁ、舐め上げるなっ……！　あぁあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「にゅぷっ……んっ、あぅっ♪　んんんッ……♪　ぜ、ぜったいに……私がイ\nカせるぅ……！　ちゅぅっ……じゅるっ、じゅるっ！　ぐちゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん、はぁっ♪　はぁ……ぐちゅっ！　あ、あまり舐めまくるなぁ……！　っ\nあっ……♪　ちゅぷっ！　じゅっぷっぐちゅっ……んっんっんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ガチガチのチンポを、私の濡れた舌でねぶり倒して……すぐにイかせてみせ\nる……っ。ん、れろっ……れろっ、くちゅっ、ぴちゅっちゅぅううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603216" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「亀頭を軽く甘噛みしてぇ……はむっ。んむ……んんっ♪　今ビクリとしたな\n……っ？　んむっ、足に力がこもっているぞ……。っんちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……！　イ……けぇっ、イッてくれぇ……！　で、でないと私の方が\n……あっ！？　あっあぁっ……またイカされて……んっあっあぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「に、二度も先にイカされるのは……あうっ！？　王者として、姫としてっ…\n…プ、プライドが許さん、絶対に貴様を先にイカせる……！　っじゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「さあ早くイけぇっ……♪　……んんんっ！？　んはぁっ♪　て、抵抗するな\nぁ……！　イクのだっ……ぐちゅっ！　じゅるっじゅるれろれろれろぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603220" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん、ぷ……！　んんぅうううううっ……んんんんんん……！　やったっ、出\nた……射精させたぞっ！　あっ♪　あっ、んぷっ、んん、んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_08" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「いいぞ……もっとだ、もっと出せ……！　っじゅるっ、じゅるるっ……！　\nごくっ……！　んっ、ごくっ、ごく……！　なんと濃厚な……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ごくっ……♪　あっ、１回目よりもより濃く、苦い気がする……っ！　んぁ\nっ、もっと出せ、そのまま飲みこんでやるから……！　ん～～～っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ごくっ……。ごくっ♪　ん、ぷぁ、びゅるびゅると勢い良く発射される精液\nぃ……♪　舌に絡みつき、喉にまとわりつくこの粘り気ぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「よっぽど私の口の中が気持ち良かったようだな……！　……んっ！？　あっ\n！？　や、やめろ、私が満足したところでオマンコを舐めるなっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ！？　イ、イクっ……！　結局私もイかされてしまうぅうっ！　あひっ\n！？　ひぃっ、ひんっ……イクっ！　イクぅっ、こ、このぉおお……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……っぷぁああっ……♪　た、大量に精液を飲まされた上に……絶頂までさ\nせられるとは……！　不覚だ、私は気を抜きすぎていた……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「き、貴様の舌がアソコを這い回るのが気持ち良くて……。巨大なチンポを咥\nえてしゃぶっていることに興奮して、盛り上がってしまった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……せっかくのアニバーサリーに、いらぬ恥をかいてしまった。いいか？　\n今日のことはすぐに忘れろ。が、フェラチオをしたかいはあったぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「貴様の喜びよう、そしてこの射精のすごさから……私と私のドレスへの評価\nはわかった。うむ、それだけで私はとても満足だ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「むっ！？　んぁっ！？　あっ、な、何をするっ……！　あ、あぁああっ……\n！　わ、私の顔にたっぷりと精液をふりかけるとは……！　うぁあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_10" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぷっ……！？　い、勢いが良すぎてチンポが暴走してしまったのか……！\n？　あ、ど、ドレスにはかけるんじゃない、それなら顔に……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……う、うぁ……く、臭すぎる……っ♪　それになんて量を吐き出している\nんだ……！　あっ、そんなに……精液が暴発するほど興奮したのか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あうっ……！　ううっ、こらっ、も、もうかけるな……もういいっ、充分だ\n……！　んぷぁあっ、く、口に入る、鼻の穴にも……！　っんぐっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あ、ぁ、うあ……あっ。……んんっ！？　オ、オマンコを舐めるなっ……！\n　き、気が緩んでいるところを攻めるとは……卑怯だぞ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うぁああっ♪　あぁっ、あッ、イクっ……！　イクぅ……！　ああああっ、\nさ、さんざんだ、顔にかけられて無理やりイカされてぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……なにか……言い残す言葉はあるか……？　私がムスっとしている？　と\n、当然だろう。ここまで好き勝手やられて機嫌良く終われるか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000154_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが……。ここまで貴様が、立場を忘れて傍若無人に、私に精液をぶちまけ\nたということは……このドレスと私の魅力が確かだったということでもある」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そう思えば、悪い気はしない……。も、もちろんこれだけ精液をかけにかけ\n続けた点は擁護できん！　……でも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「気持ちが良かったのだよな？　それなら……まあ、今回は許してやるとしよ\nう。それにしてもすごい量だ……。溺れてしまうかと思ったぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3603410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]

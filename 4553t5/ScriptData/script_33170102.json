{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「屈辱だわ……！　このわたしが、男相手にいやらしい声を出してしまうだな\nんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00031701_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「でも、これ以上好き勝手にさせるわけにはいかないわ。早くここから逃げ出\nさないとっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00031701_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「きゃっ！？　き、君……何でまたチンポを勃起させているの！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104103" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「そろそろ休憩は終わりにして、尋問の続きをするですって？　えっ……つ、\n続きって、まさか……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「きゃあぁっ！？　あっ、んっ！　はぁ、あっ！　チ、チンポが、わたしのオ\nマンコにあたってるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ほ、本当にセックスをするというの！？　このわたしに、そのカタくて太い\nチンポを、挿れる気なの！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「こんな美人を前にして、セックスをしないわけがないですって？　そんな、\n美人だなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あっ、ひゃ……うっ、んぅっ！　褒められて悪い気はしなけど、わたしは君\nとセックスなんてしたくないわっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104108" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「それに、オマンコだって濡れてないし……ひゃ、あんんっ！？　あぐっ、あ\nっ……ふぁ、あぁぁぁ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「チンポが、オマンコの入口を擦ってくるぅ！　熱くてデコボコしたところで\n、大事なところスリスリされて……ひゃうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「な、何なの、これっ……！　女の子とオマンコを擦り合わせるのとは、全然\n違うっ……！　クリトリスに、強い刺激がくるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「オマンコの奥に溜まってるエッチな汁が、どんどん溢れてきてっ……やっ、\nいやっ！　わたしのオマンコ、気持ちよくしないでちょうだいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「こんなに優しく愛撫されたら、子宮が悦んでっ……奥まで挿れて欲しくなっ\nてきちゃうぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ふあぁ、んっ、はっ！　ぐっ、うぐぐっ！　はふっ、あっあっあっ、んっ、\nはぁっ！　ひゃ、あぁぁっ！　んぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104114" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……！　かなりオマンコが濡れてきたですって……？　こ、こ\nれはただの生理現象よっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「決して、君の愛撫で感じたわけじゃ……！　あっ、やめっ……！　割れ目に\nチンポをあてがわないでっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「そんなことされたら、本当にチンポが入っちゃうっ……！　あっ、くるっ…\n…！　本物のチンポ、オマンコにきてっ……はぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あっ……あひっ……！　オマンコが、チンポでいっぱいになってるっ……！\n　なんなの、この拡張感っ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104118" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「バイブや双頭ディルドとは、比べ物にならないわ……！　密着感もすごいし\n、何よりチンポの熱を感じるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104119" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「こんな快感、知らないわっ……！　ダ、ダメっ……このままじゃ、チンポの\n虜になっちゃうっ……！　ふっ、んっ！　ひうぅっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あっ、あんっ！　ひゃ、あぁぁっ！　チンポがズンズンって、奥まできてぇ\n！？　わたしの子宮口に、カタいのが当たってるわっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104121" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ものすごく乱暴な突き上げなのに、オマンコのお肉がズリズリ擦れて、子宮\nが悦んでるっ……！　んっ、はぅっ！　あっ、あふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104122" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「はっ、ぐふっ！　ふっ、あっ！　んっ、あぁっ！　男とのセックス、気持ち\nよすぎるっ……！　これ、クセになりそうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……！　な、なに？　もっと激しくして、チンポの良さをわたし\nの身体に教え込んで、虜にしてやるですって？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「何がチンポの良さよっ……！　わたしは絶対に、チンポなんかに屈しないっ\n……ひゃ、あんっ！　あっ、あはぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104125" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あんっ、あんっ！　あっ、あはぁっ！　すごい勢いで、オマンコ突かれてる\nっ！　ぶっといチンポが、激しく出入りしてるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「チンポの先端が、浅いところと深いところを刺激してっ……！　んっ、ひふ\nっ！　わたしの気持ちいいところ、的確に狙ってきてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「な、なんでこんなに、セックスが上手なのよぉ！　こんなの、ありえないわ\nっ……！　ひっ、はっひっ！　あっあっあっ、ぐっ、あぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104128" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「もう、やめてっ……！　オマンコ虐めないでちょうだいっ……！　このまま\nじゃわたし、チンポでダメにされちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ふっ、んふっ！　はっ、あぅっ！　こ、このまま膣内出しの快感も覚えさせ\nてやるですって……！？　ま、待って……！　膣内はダメよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104130" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「君、分かっているのっ！？　膣内に出したら、あ、ああ、赤ちゃんが出来ち\nゃうのよっ！？　わたし、妊娠しちゃうのよっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「妊娠しても構わない？　ちゃんと責任は取る？　はっ、あぁっ……！　そん\nな男らしいこと言わないでっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「わたしには、女の子さえいればいいのにっ……！　なのに身体が、君のチン\nポを受け入れててっ……！　ひゃ、んぅぅっ！　ぐっ、んふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104133" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「な、膣内に出すから、一緒にイケだなんてぇっ！　そんな命令されたら、オ\nマンコが反応してっ……！　あっ、イッ、イクッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「やっ、んんぅっ！　オマンコイクッ……！　ぶっといチンポでイカされちゃ\nうぅっ！　ひゃ、あんんっ！　あっあっ、ふっ、あっ！　あっはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104135" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「おっ、ほぉぉぉっ……！？　本当に、膣内に出されてるっ……！　チンポが\nオマンコの中で跳ねながら、熱い汁を噴き出してぇっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104136" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「子宮に精液が流れ込んでるのが分かるわっ……！　こ、これが膣内出しっ…\n…！　精液を奥に注がれる感覚なのねっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「これ、普通にイクよりも、何倍も気持ちいいわっ……！　イクの、止まらな\nくなっちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「膣内で精液を受け止めるたびに、子宮が反応してっ……！　深イキ止まらな\nいっ……！　絶頂が止まらないのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104139" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「おぉっ、んぉっ、おほぉぉっ！　ま、またイグッ！　精液が出続ける限り、\nオマンコイッちゃうのぉぉぉぉ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「くふっ……はっ、ひゅうぅぅっ……チンポで、イカされるだなんて……それ\nに、膣内出しまでっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「本当に屈するところだったけど、何とか耐えきったわ……これだけ激しく射\n精すれば、チンポも萎えてくるはず……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「えっ……ど、どうして？　何でまだ、こんなにもチンポがカタいままなの…\n…！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104203" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「いえ……カタいどころか、射精する前よりも膨らんでいるみたいな感じがっ\n……！　ま、まさか、もう１回セックスするというの！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「もう１回どころか、わたしがチンポに屈するまで、何回もするですって……\n？　そんな……今のでも、じゅうぶん危なかったのに、何回もだなんてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「おっほっ！　んおぉぉぉ～～～っ！？　ほ、本当にまた、チンポがオマンコ\nを擦ってきてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「出し入れの動きが、もっと滑らかになってるわっ！　オマンコから、ぐちょ\nぐちょって精液をかき回すような音もするぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んひっ！　おっ、おぉっ！　オマンコのお肉に、精液塗り込まれてるっ！　\nこんなの、身体が精液の感触を覚えてちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「チンポをズポズポされるたびに、わたしの大事なところ……子宮が降りてき\nて、赤ちゃんの部屋の入口も開いてくるわっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「こんなに気持ちよくされたら、耐えられるわけないじゃないっ！　オマンコ\n屈しちゃうっ！　チンポでダメにされちゃうのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104210" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「おひぃぃぃ～っ！？　はっ、おぉっ！　んぐっ、ふんぐぅ～～～っ！？　チ\nンポがさらに膨らんで、オマンコ拡げてくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104211" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「オマンコのお肉が引っ張られたり、押し込まれたりして……こ、これ、オマ\nンコの形が完全に変わっちゃうわっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「わたしのオマンコ、君のチンポの形になってっ……！　初めてのセックスな\nのに、こんなことになるなんてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104213" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ！　身体が屈しちゃうっ！　君ともっとセックスしたくて、たまら\nなくなってくるのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「オマンコをチンポでホジって、奥をズンズンして欲しくてぇ……！　おっ、\nおほっ！　んおっ、おっ、おっ！　おほぉぉぉ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「おっ、おぉっ！　おひぃ～～～っ！　奥に刺さるぅ！　ぶっといチンポ、子\n宮口を刺激しまくってくるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「気持ちよすぎるわっ！　これ、またイクッ！　君のチンポでイカされちゃう\nぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104217" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「イッたら、オマンコが屈しちゃうっ！　君のチンポの虜になるって、分かっ\nちゃうぅっ！　んぎっ！　おっ、おっおっ！　んおぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あっ、おっ！　ふほっ！　おほぉぉぉ～～～っ！　き、君のチンポも、限界\nなのっ！？　また、イキそうなのぉ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「だ、出すなら、膣外にっ……！　お願いだから、もう膣内はやめてぇっ！　\nおっほっ！　おっ、イクッ！　イグッ！　イッグぅぅぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104220" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んぎぃ～～～っ！　膣内に出てるっ！　また君の濃厚ザーメン、子宮に注が\nれてるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「出さないでって言ったのにっ……！　こんな、ことぉ……！　おっ、おぉぉ\nっ！　ふほっ！　んぎひぃ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104302" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「奥に精液出されると、頭が真っ白になるわっ！　イキすぎて、オマンコおか\nしくなるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ひっ、あっ！　んおっ、おぉっ！　これ、完全にオマンコ屈してるっ！　君\nのチンポの虜になってるわっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「セックスの良さを分からされるだなんて……！　こんな屈辱ぅ……あっ！　\nおぉぉっ！　ふほっ！　おっ、おっほっ！　んっほぉぉぉ～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あっ……はぁぁっ……！　チンポで……膣内出しで、イキまくるだなんてぇ\n……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104306" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ふっ……はふっ……はぁぁぁっ……チンポやセックスの良さが、理解できた\nかですって？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「くぅぅっ……！　く、悔しいけど、確かに気持ちよかったわ……今だって、\nオマンコのヒダがチンポに絡みついて、離れないもの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104308" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「でも、勘違いしないでちょうだい。これはただ、身体が屈しただけ……わた\nしの心は、君に屈していないわっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「それなら心が屈するまで、もっとセックスするですって？　や、やめてっ！\n　もうこれ以上、チンポで気持ちよくしないでぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あぶっ！？　んっ、あぅぅぅ！　せ、精子が顔や身体にどぴゅどぴゅ出てる\nわっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ち、ちょっとっ！　膣内に出さないでとは言ったけど、身体にかけていいと\nは一言も言ってないでしょう！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104402" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「こんな臭いモノを全身にかけられたら、匂いが染みついてっ……んんっ！　\nあっ、んっ！　ふくぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　んっ、あぅっ！　こ、これ……ものすごく濃くて臭いのに、\nもっと嗅ぎたくなってくるわっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104404" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「なんでっ……に、匂いだけで、イッちゃうっ……！　ひっ、あっ！　おっ、\nおほっ！　んおぉぉっ！　おぉ～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104405" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「はっ……あっ、はっ……！　このわたしに、こんなにたくさん精液を浴びせ\nるなんてっ……！　早く拭かないと、肌が精子臭くなっちゃうわ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104406" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ちょっと。いつまで押し倒しているつもり？　出すもの出したんだから、さ\nっさとどきなさいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「なに？　わたしがまだ全然屈していないみたいだから、またオマンコにチン\nポを挿れる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「どうして……君、もう何回も出したじゃない！？　なのに、まだできるとい\nうの！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104409" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「美人相手なら、ずっと出し続けられる自信があるだなんて……！　そ、そん\nな男らしいこと、言わないでちょうだいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0104410" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_02_19" ]},

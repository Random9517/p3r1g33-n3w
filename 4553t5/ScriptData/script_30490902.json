		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……なあ。君はもう、私のこの姿を見てしまったのだよな……。それならも\nう、何を言い訳しても仕方がないわけで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904101" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "4", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「そ、そこで相談がある。このことは私と君、２人だけの秘密にしてもらえな\nいだろうか。代わりになんでもしよう。……な、何ぃ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904102" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「そ、挿入しないとバラすだと！？　卑怯なッ……。はぁ？　そんなことは\n言っていない？　いいや、聞こえたぞ。君のその卑劣な要求が……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904103" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "9", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「今、君は長官の恥ずかしい姿をEDO全員に暴露されたくなければ、おとな\nしく股を開いて生本番させろと言ったな！？　言っていない？　嘘をつくな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904104" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「はぁっ……♪　はぁ、はぁ、はぁ……♪　う、うむ。目撃者である君に脅迫\nされてしまったら、私には抵抗するすべはない……。はぁ、はぁ、はぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904105" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「私が勝手に言っているだけ？　うるさいっ、せ、せっかく私がその気になっ\nたのだ、おとなしく！　ありがたく襲いかかっておけばいいだろうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904106" ]},
		{"command":[ "SETCHARA", "0", "char_00004909_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ほら……。どうした？　私の股間はもう、君のチンポを期待してぐっしょり\nと濡れそぼっているぞ。割れ目も充血して花弁も開ききっている……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904107" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「愛液でヌルヌルになったここに！　その太いオチンポを挿入してみないか…\n…。モノは試しだ。きっととても気持ち良くなれるぞ……。んん？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「見えるだろう？　中の肉ヒダが、うねってオチンポをおねだりしているぞ…\n…。クリトリスもビンビンに勃起している。甘い蜜もたっぷりだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904109" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「オマンコをヒクつかせて、長官である私が子作りに誘っているんだ。ありが\nたく受け取ってはもらえないか？　そ、その、今はこんな格好だが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……この服を着てから、全身が疼いてたまらない。自分でも、とんでもない\n格好をしている、と意識すればするほど興奮しておさまらない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……♪　さあ、我を忘れて、理性をかなぐり捨てて交じり合おう\nじゃないか……。ギャルになった私と、生本番交尾だ！　……んッ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904112" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んふぁああああっ♪　あぁッ♪　あっ、おっ！？　おっ、おぉおおッ♪　来\nたなっ……！　あっ！　い、一気に奥の奥まで貫いて……んぉぁああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904113" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「や、やはり君のオチンポも、辛抱たまらなくなっていると思っていたんだっ\n……！　あはっ♪　すごすぎるだろう、なんだこの硬いオチンポはっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904114" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んはぁっ♪　腹の中に熱した鉄棒を……あッ♪　ゴリゴリの棍棒をねじこま\nれたかのようだっ！　あっ、こ、これは……記録に残る勃起だぞっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904115" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「おぉおっ♪　おほッ！？　おっ！？　おぉッ！？　な、中で膨れて……あぁ\nあああっ！　熱いオチンポが激しく自己主張しているっ、んおっ、おっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「オマンコのヒダが拡げられて……！　あっ、こんな状況で動かれたら……ん\nぉぁあっ♪　私はひとたまりもないぞ、……あっ、ピストン駄目だっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あっ！　あッ♪　あぁっ、うぁああああっ……！　あはっ……♪　あぁっ、\nき、君が腰を動かす、からぁっ！　私もつられて尻を揺らしてぇっ！」", "NORMAL" ]},

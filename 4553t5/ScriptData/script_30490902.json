		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……っふぅうっ……。下腹がずっしりと精液で重たくなっているのがわかる\nな。とてつもない満足感だ、しかし……君の方はといえば……」", "NORMAL" ]},

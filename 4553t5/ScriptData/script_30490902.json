		{"command":[ "SETIMAGE", "0", "still_00004909_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「き、もち良すぎる……！　あっ！　イクっ！　あっ！？　意識が飛ぶぅっ…\n…！　あっ！　あっ、わ、若い娘の服装をしてっ、はしゃいでぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「恥ずかしげもなくオマンコでオチンポ☆　してもらって気持ちイイぃっ♪　\nんぉっ！　おおおおおぉっ！　ぉっ♪　か、簡単に奥に届くぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んほぉっ！　おっほっ！　おほぉおっ！？　んぉっ♪　オチンポが出たり入\nったりっ♪　おっぉっおっ♪　また入ったり、出たり入ったりぃいいっ」", "NORMAL" ]},

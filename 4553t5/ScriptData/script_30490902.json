		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あ、つい……っ♪　熱い、熱い肉汁がっ……！　容赦なく子宮に流れこんで\nくるっ、あっ♪　い、いいぞこのままっ、もっと出すんだ、もっとだっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ッくぅうううう～～～っ♪　私の子宮をパンパンになるまで満たして、逆流\nするまでザーメンを注ぎこむんだっ♪　あっ！　すごい、入ってくるっ」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00004909_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あぅううっ！　知能指数が下がるっ、頭がオマンコでいっぱいにっ……！　\nんほぉおっ！　おぉおおっ！　ヤバイぃいっ！　どんどんアホになるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「バカになって♪　腰振ってオマンコすることしか考えられんっ！　んぉおお\nっ♪　チンポっ♪　オチンポっ、ペニスっ、ペニスぅうっ、男性器ぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「もっと！　もっと出し入れしてくれっ！　もっと速くっ、もっと過激にっ！\n　んぉおおおおっ！　しゅ、しゅごい、ひゅごい、今のもっとぉおっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904131" ]},
		{"command":[ "SETIMAGE", "0", "still_00004909_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あひんっ♪　ひぃいいんっ！　あッ、おっ、おぉっ♪　んぉおおおっ！　奥\nぅうっ……！　一番奥、突いて、突き上げてくれっ、ああああっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……あっ♪　イクっ……イッてしまう！　あ、あ、あっあっ……！　んぅう\nっ！？　ど、どうした、急に腰の動きが速く、なって……っあっあっ！」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00004909_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「こんなに美味しいオチンポを、みすみす逃がす私ではない……♪　んっ、あ\nっ……！　オマンコの入口でがっちり咥えこんだまま、ピストンするっ」", "NORMAL" ]},

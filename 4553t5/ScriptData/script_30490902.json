		{"command":[ "SETIMAGE", "0", "still_00004909_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んっ？　休ませてくれ、だと？　まさか。笑わせるんじゃない。私の本気の\n締めつけで……フンッ♪　どうだ、完全にオチンポを拘束したぞ」", "NORMAL" ]},

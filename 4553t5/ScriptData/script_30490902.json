		{"command":[ "SETIMAGE", "0", "still_00004909_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「フフフフ、射精したばかりとは思えないほどに、私のオマンコの中でオチン\nポがそそり勃ったままだぞ？　随分余力を残しているじゃないか……」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00004909_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ッああああああっ……！　ドク、ドク、とはっきり注ぎこむ音がする、オチ\nンポが脈打って……休む暇もないくらいイッてしまうぅうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「っはぁっ……！　ハァ、はぁ、はぁ、はぁあっ……。遠慮なく中に出しまく\nってくれたじゃないか……っ。すごく良かったぞ、余韻が凄まじい……」", "NORMAL" ]},

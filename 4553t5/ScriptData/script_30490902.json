		{"command":[ "SETIMAGE", "0", "still_00004909_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ふ、振り落とされてしまいそうな、くらいにっ……！　あっ！　そうか、そ\nちらもそろそろ限界か……！　わ、私がキツく締めすぎるから、だと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「人のせいにするなぁっ！　君のオチンポが良すぎるのが悪い！　だからこっ\nちもずっと絶頂しっぱなしで……！　ッんうっ！？　イ、イクのか！？」", "NORMAL" ]},

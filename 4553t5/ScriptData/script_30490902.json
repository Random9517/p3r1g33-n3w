		{"command":[ "SETIMAGE", "0", "still_00004909_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あうっ♪　んぐぅうっ、んぅううッ、あおぉおっ♪　け、ケダモノのように\n、互いを食らい合うはしたないセックスになってしまっているじゃないか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「あっ！　んぉっ！　おぉっ！　フフフフッ、も、もう逃がさんぞ……！　今\nの私は肉食系ギャル……っ、一度掴んだオチンポは離すものかっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「ほらっ！　ほらっ、ほらぁっ……！　強烈に締めつけてっ、根元から亀頭ま\nで何度でもしごきあげてやるっ！　ほ、らっ♪　ほぉらっ、そらぁっ！」", "NORMAL" ]},

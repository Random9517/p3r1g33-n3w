		{"command":[ "SETIMAGE", "0", "still_00004909_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「……んぐっ♪　んんんんんッ♪　い、いいぞっ……！　そちらからも反撃さ\nれると！　オマンコにオチンポがこすれて二倍気持ちいいっ、感じるぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_0904122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "美鈴" ]},
		{"command":[ "SETTEXT", "「んぉおおおっ♪　んほっ！　ほぉおっ♪　おぉおおッ……！　おっぉっおお\nおっ♪　マ、マズいぞ、んぉっ♪　こ、腰が止まらないぃっ……！」", "NORMAL" ]},

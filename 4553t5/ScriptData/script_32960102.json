		{"command":[ "PLAYBGM", "WAR_BGM2" ]},
		{"command":[ "SETNAME", "あなた" ]},
		{"command":[ "SETTEXT", "「それにしても、今日はすごく調子良かったな」", "NORMAL" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETTEXT", "理事長のところに行く途中で、何気なくそんなことを言った。", "NORMAL" ]},
		{"command":[ "DISPNAME", "FALSE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "別に深い意味はなかったんだけど、俺の隣を歩いていた小春が急に肩を縮こま\nらせる。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「だって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_296_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00029601_02", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "あなた" ]},
		{"command":[ "SETTEXT", "「うん？」", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「可愛がってもらったから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_296_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00029601_02", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "あなた" ]},
		{"command":[ "SETTEXT", "「え、それ関係あんの？」", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「あるよ。重要だよ」", "NORMAL" ]},

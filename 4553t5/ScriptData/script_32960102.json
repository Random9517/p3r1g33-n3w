		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「んああぁっ！！　イクッ、もうイクッ……！　う、あっ、　イクッ、イっち\nゃうぅぅっ……う、あっ、ああああぁっ！　イクッ、イクッ、イクッ――――\n」", "NORMAL" ]},

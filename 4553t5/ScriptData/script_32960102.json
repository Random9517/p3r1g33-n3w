		{"command":[ "SETTEXT", "「だよな。びっくりした」", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "小春はもちろん、他のみんなも最近はどんどん強くなってる気がする。", "NORMAL" ]},
		{"command":[ "DISPNAME", "FALSE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "……俺も頑張らないとな。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「理事長室に行く？　報告しないといけないよね？」", "NORMAL" ]},

		{"command":[ "SETCHARA", "0", "char_00029601_02", "0", "CENTER", "0" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "あなた" ]},
		{"command":[ "SETTEXT", "「そうだな。理事長に報告してから帰るか」", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "あなた" ]},
		{"command":[ "SETTEXT", "「あっ、買い物は付き合うからな」", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「いいの？　ありがと♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_296_0104306" ]},
		{"command":[ "SETCHARA", "0", "char_00029601_02", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "嬉しそうに笑いながら、小春が俺の腕に抱きついてくる。", "NORMAL" ]},
		{"command":[ "DISPNAME", "FALSE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "周りに誰もいないから、ちょっと大胆になってるな。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "でも、やっぱり俺も嬉しいから、小春を自分のほうに引き寄せて理事長室へと\n向かうのだった。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "cbg_0001" ]},

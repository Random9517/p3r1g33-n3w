		{"command":[ "SETTEXT", "イチモツの動きをさらに加速させて、ラストスパートに入る。", "NORMAL" ]},
		{"command":[ "DISPNAME", "FALSE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "結合部からは透明な愛液が染み出していて、腰を振るたびにグチュグチュと卑\n猥な音が鳴った。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "でも、それが俺の体をさらに興奮させてくれて、イチモツを石のように硬く勃\n起させる。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETTEXT", "先端はゴツゴツと子宮を突き続けていて、下腹部の奥から熱いものが込み上げ\nてくるのが感じられた。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "あなた" ]},
		{"command":[ "SETTEXT", "「ん、くぅっ……搾り取られそうだ……！」", "NORMAL" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「ん、ああぁっ！　き、きてぇっ、ふあっ、　出してっ！　あ、あ、あっ、い\nっぱい、し、搾り取る、　からぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_296_0104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00029601_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「だから、き、今日もっ、ん、んああぁっ！　おま○この、　中にっ、ふあっ\n、あ、はあぁんっ、全部出してぇっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_296_0104133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "あなた" ]},
		{"command":[ "SETTEXT", "「イクぞ、んんっ、小春っ……出すぞ！」", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「あ、ああぁっ！　おち○ちんが、ん、ひあっ、すごくっ、　お、大きくなっ\nて……！　ふ、あっ、んはあっ、あっ！　ああっ、これ、もう、ん、ううっ、\n感じ、すぎる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_296_0104134" ]},
		{"command":[ "SETIMAGE", "0", "still_00029601_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "小春" ]},
		{"command":[ "SETTEXT", "「おま○こ、と、蕩けそうな、くらいっ、ひ、んんんっ！！　気持ちよくてぇ\nっ、あ、くああっ、私も、もうぅ、んんっ、　もう、イクッ、んあぁっ……！\n」", "NORMAL" ]},

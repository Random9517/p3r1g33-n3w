{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様、お呼びだてしてもうしわけありません。本日は、どうしてもカツ\nマ様に教えていただきたいことがありまして」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00030801_01", "5", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ええ、カツマ様にしかできないことです。そして、私のご奉仕として重要な\nことでもあります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00030801_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「男女の営み……セックスを教えて欲しいのです。ダイヤナ様にも相談しまし\nたが、女性同士ではどうにもならず……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104103" ]},
		{"command":[ "SETCHARA", "0", "char_00030801_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「いえ、ダイヤナ様は実践してあげると仰っておりましたが、やはり男女のも\nのを学びたく……カツマ様にお願いした次第です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104104" ]},
		{"command":[ "SETCHARA", "0", "char_00030801_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「喜んで？　よかった……さすがカツマ様です。メイドロイドの私のために、\nそんな風に仰ってくださるなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104105" ]},
		{"command":[ "SETCHARA", "0", "char_00030801_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「さあ……それでは、準備はできました。どうぞ、カツマ様のお心のままに…\n…お願いします」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104106" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「？　どうかしましたか？　情緒がない……しかし、この格好はセックスをす\nるために一番やりやすい姿勢だと聞きましたが。それに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様のチンポはもう完全に勃起しております。私の格好に興奮してくれ\nたのではないですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「私も、カツマ様の逞しいチンポで興奮しております。早く……私の中に、お\n願いしま――ひあっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104109" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「そんな、いきなり奥まで……んっ、教えて欲しいと言いましたけれど、んっ\n、あっ、ああっ、喋って、るのにっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、あっ、この、奥をこじられるの、気持ちいい、んっ、ふうう\nっ、あっ、そこ、女性器の壁をカリカリこすられるのも、んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「女性器ではなくオマンコと……わかりました、あんっ、オマンコ、オマンコ\nの壁、気持ちいいっ、ふああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、奥、ぐりぐりってされたら、お腹から全身が熱くなって……\nんんっ、オマンコがカツマ様のチンポにしがみついて……んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「これが、セックスで、チンポで感じてるということ……あんっ、んっ、あく\nうっ、声、声が勝手に出てきてしまいます……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ふうううっ、カツマ様のオチンポが出入りするたび、お腹が、身体がきゅう\nきゅう鳴いてるように動いて……あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「私は、常に冷静であるようにプログラムされているのに……んふうっ、あっ\n、チンポがオマンコこするだけで、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「思考が乱れて、身体が痺れて……チンポの、カツマ様のことしか考えられな\nくなってる、んんっ、あっ、これが、セックス……ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「気持ちいいっ！！　気持ちいいですっ！！　カツマ様も、気持ちいいですか\n？　私のオマンコで、気持ちよくなっていますか、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「チンポで分かるって……んっ、あっ、硬くて、太くて、先端が大きくて、ご\nりゅごりゅされてて……ふああっ、あっ、あくうっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「こんなになってるのが証拠、んっ、そうなのですね、嬉しいっ！！　あんっ\n、あっ、ああっ、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「私がカツマ様を気持ちよくできてるって思ったら、オマンコがまたきゅうっ\nて、ふうううっ！！　んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、また、違うところ、オマンコの上側、亀頭がぞりぞりってこ\nすってきて、ふあああっ、あっ、これ、これも気持ちいいっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104122" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「んくうううっ、これが、セックス……知識と全然違う、チンポが中をごりっ\nてして、頭の中が、気持ちいいだけに……あんっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104123" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、連続で突かれたら、んんっ、もう、身体全部がオマンコにな\nったみたい、あんっ、あっ、カツマ様、カツマ様ぁっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104124" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「好き、好きっ！！　カツマ様も、カツマ様のチンポも、どっちも、あんっ！\n！　んっんっんっ、その、奥ごりってするの、一番好きっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様の、チンポ、一番感じられる、んっ、硬い先端が、私の中で気持ち\nよくなってくれるの、分かるから……あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「んううううっ、そんな、何回もやられたら、あっ、ああっ、あくうっ、ふあ\nああっ！！　んんっ、なに、これ、お腹の奥から、じんじんって、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「これ、これが絶頂するってこと、カツマ様のチンポで絶頂、イくっていうん\nですね、んっ、ああっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104128" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「頭の中から、身体の奥まで全部気持ちよくなって、それしか考えられなくな\nって、んんっ、あっ、カツマ様っ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様のチンポのことしか考えられなくなってる、私、メイドロイドなの\nに、チンポのことしか考えられなくなって、ふうっ、うっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様っ、カツマ様も私のオマンコだけ考えて、んっ、一緒に、一緒にイ\nきましょうっ！！　カツマ様と一緒にイきたいっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、またそんなに激しくされたらっ！！　奥ごりごりってされた\nら、もう、もう、本当に、ああっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「イく、イく、カツマ様、私、イきます、だから、カツマ様も一緒に、私と一\n緒に、あっ、ああっ、ダメっ、イっく、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「イっくうううううううううううう！！　んああああっ、あっ、オマンコ、熱\nいっ、んくうううっ、チンポからザーメン出てるっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104134" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あくうっ、んっ、お腹の中、注がれてるの分かるっ！！　カツマ様のザーメ\nンいっぱい注がれてるの分かるっ！！　んうっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「満たされてるっ！！　私がカツマ様で満たされてるっ！！　ふあああっ、あ\nっ、あっ、幸せ……これが幸せ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104136" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ……お腹の中、ザーメンでどろどろになっています……んっ、\nあっ、かき混ぜちゃダメです……んっ、くうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「中に出されるって、こんな感覚なんですね……メイドロイドの私でさえ、子\n供を孕んでしまいそうです……あうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「満たされる、という言葉の本当の意味を理解した気がします……カツマ様の\nチンポとザーメンで、私の全部が満たされてる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「こんなのを知ってしまったら、私はもうカツマ様にますますのめり込んでし\nまいます……凄いですね、セックスって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ところで、カツマ様……プログラムというのは何度も行う事で最適化されて\nいくというのをご存じですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「私はつい先ほど、セックスの快感を知りました。それをもっともっと最適化\nするために……ね？　もう一回、お願いします」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様のチンポも、まだ私の中で大きいままですし、私のオマンコ、また\nかき混ぜてください……んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、いきなりそんな激しく……そんなっ、挑発したわけじゃ、ん\nっ、ああっ、あっ、二回目なのに、さっきより大きいっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104204" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「んくうっ、あっ、凄いっ、奥っ、連続で突かれたら、ああっ、あっ、ああっ\n、あっあっあっ、ダメっ、ダメっ、また、またすぐイっちゃう、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あっ、そんな、ここで止めたら……ふううっ、あっ、お腹、じんじんしてる\nのに、んんんんっ、お願い、カツマ様、動いてっ、ふあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あんっ、ああっ、あっ、また、また来たっ、またイく、カツマ様のチンポで\n、またイくっ、んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104207" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あくうっ！？　また、動きを止めて……ふああっ、あっ、いじわる、カツマ\n様のいじわるっ！！　お願い、します、チンポ動かして、んくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ふうううっ、うっ、あっ、オマンコ、蕩けて……チンポに絡みついて、あっ\n、今度、今度こそ、チンポでイっく、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104209" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「また、また止めたっ！！　カツマ様ぁっ……お願い、お願いします、イかせ\nて……チンポ、チンポでオマンコ突いてイかせてぇっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104210" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「へ、え？　次は動いたらイくまでやめないから、限界まで耐えろって……ん\nっ、ふううっ、じゃなきゃ動かないって、そんな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104211" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「分かりました、分かりましたから、動いてっ！！　カツマ様のチンポでぐち\nょぐちょオマンコ、かき回してっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あくっ、あふうっ、くあああっ！！　来た、チンポ来たっ！！　んっ、んく\nうっ、あっ、んっんっんっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104213" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「まだ、まだ耐えてる、んっ！！　耐えてますっ！！　ひああっ！！　オマン\nコごつごつノックされてるけど、耐えてるうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「んうっ、あっ、あんっ、あっ、ふああっ！！　まだ、まだイってません、ん\nっ、チンポ、チンポでオマンコどろどろになってるけど、イってません！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104215" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、お腹の奥までチンポでこじられてるっ！！　ふああっ、私の\n中、全部カツマ様にかき混ぜられてるっ！！　ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「頭の中まで、チンポでまぜまぜされて、思考プログラム飛んでいっちゃうっ\n！！　んくうっ、イく、もうダメ、耐えられない、イくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様のチンポも膨らんでるっ！！　お願い、一緒に、一緒にイきましょ\nう！！　チンポとオマンコ、一緒に……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104218" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様と私でまた一緒に、あっあっあっ、最後の最後に奥ごつごつって激\nしくされたら、イく、イく、イっく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104219" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様のチンポで、イっくうううううううううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104220" ]},
		{"command":[ "WAITINPUT" ]},
														
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ふあああああっ！！　二回目ザーメンきたああああっ！！　んんっ、くうっ\n、お腹の奥に、新しいザーメン注入されてるうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「お腹の中、ザーメンでオーバーヒートしちゃうっ！！　んふううっ！！　ふ\nうううっ、んくうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、んっ、最後の一滴まで注がれてるの、分かります……あんっ\n、んっ、ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104303" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「チンポとザーメン、私の中、カツマ様でいっぱいになってます……んっ、ふ\nっ、んくうっ、これが幸せ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104304" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「私が子供を産めたのなら、絶対に孕んだと思うぐらい濃厚で、量も多くて…\n…それだけカツマ様も気持ちよくなってくれたのですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ふふ、そう思うと私の心まで満たされています。男の人……カツマ様と繋が\nるというのはこういうことなのですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104306" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「知識ではなく、経験で理解しました。素敵な男の人と身体を重ねるという行\n為の意味を……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様の身体、体温、息づかい……全てを全身で感じ取って、それが幸せ\nになっていく」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104308" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「こんな素晴らしい体験、皆様が夢中になるのも分かります。もちろん、私も\n。カツマ様にもっと夢中になってしまいました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「カツマ様、私はずっとずっと側にお仕えしてます。だから、また沢山愛して\nくださいね……愛しております、私のマスター」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104310" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ああっ、カツマ様が、カツマ様のチンポが外に、んっ、ふうっ、あああああ\nああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「あくうっ！！　ザーメンが全身に、んっ、ふううっ、熱いっ、あんっ、あっ\n、あああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「こんな、全身がどろどろになるぐらい大量に……二回目なのに、んっ、ふう\nうっ、まだ出てくるっ、んんっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「んっ……これが、カツマ様が気持ちよくなった証拠なんですね。私がカツマ\n様を気持ちよくできた証拠……ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104404" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「そう思うと、この熱さと匂い、肌にこびりついたザーメンがなにか愛おしく\n思えてきます……カツマ様のだからですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「ふあっ……んっ、気持ちよかったです、カツマ様。あんな風に激しく愛され\nるって、素敵なことですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「気持ちよくなって、カツマ様を気持ちよくして……ふふっ、二人とも満たさ\nれてますね。これがセックスなんですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「幸せな時間でした……カツマ様も同じなら、私にとってそれ以上に嬉しいこ\nとはありません。出したザーメンで分かるって……そうですね、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「こんなに出しておいて、満足してないとか言われたら拗ねるところでした。\nメイドロイドだって、拗ねるときは拗ねるんですよ。ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104409" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "フェム" ]},
		{"command":[ "SETTEXT", "「だから拗ねないように、これからも定期的に私を愛してくださいね、カツマ\n様。私はいつでも待ってますから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_308_0104410" ]},
		{"command":[ "SETIMAGE", "0", "still_00030801_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
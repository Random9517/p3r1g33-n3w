{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0098" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「……起きたか。ここはどこか、だと？　知らん。その辺にあった休憩用のホ\nテルだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304101" ]},
		{"command":[ "SETCHARA", "0", "char_00010013_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「どうしてこんな所に連れ込んだか……まったくおまえは質問が多いな。セッ\nクスするために決まっているだろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304102" ]},
		{"command":[ "SETCHARA", "0", "char_00010013_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「近頃のおまえと来たら、忙しいのかなんだか知らんが、私のことを放置し続\nけて……今だって私がこんな格好をしているのに見てもいない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304103" ]},
		{"command":[ "SETCHARA", "0", "char_00010013_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「女が新しい装いをしたらちゃんと見て、褒めるものだ。それをおまえは……\nおかげで私の欲求不満が限界になった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304104" ]},
		{"command":[ "SETCHARA", "0", "char_00010013_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「だから脱げ！！　そしてそこに寝ろ！！　セックスするぞ！！　ええい、文\n句を言うな、そら、外道忍法・強制脱衣！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304105" ]},
		{"command":[ "SETCHARA", "0", "char_00010013_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ん？　ふふっ……おまえも期待していたんじゃないか。なんだこのがちがち\nに勃起したペニスは……なあ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304106" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「なに？　忙しすぎて会いにこられなかったけど、ずっと会いたかっただと？\n　その格好も、ちゃんと褒めたかった……なるほど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304107" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「それで溜まっていたと……言いたいことは分かった。健気なのは褒めてやろ\nう。お前の顔を見れば本心だとわかる。だがな――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304108" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「私の側にいるような男なら、それでも時間を作ってみせろ。その上で私に会\nいにこい。それぐらいやってみせろ。おまえならできるはずだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふっ……話がそれたな。ともかく、今日は私のやりたいようにやらせてもら\nう。このペニスを、私の中に……んんんんっ、はっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304110" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「入って、来た……んんっ、このペニス、待ち遠しかった……んっ、ふっ、あ\nんっ、んっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304111" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「このカリ首が、たまらない……んっ、はあっ、ああああっ！！　先端も、ご\nつごつって、奥を叩いて……ふううっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほら、何をしている、おまえも下から動け……んっ、はっ、あっ、そうだ、\n下から私に奉仕しろ……あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304113" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「そう、そうだ……んっ、あっ、ごつごつって、下から奥を……んふうううっ\n、これ、これだ、おまえのペニス、これが……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふううっ、この気持ちよさが欲しかった……あんっ、あっ、あっあっあっ\n、ふううううっ、私のオマンコで、おまえのが暴れて……んくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304115" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、んっ、ふううううっ、腰が、動いて……たまらない……んっ、\nはあっ、ああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304116" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、くうっ、ああっ、んっ、はあああっ！！　腹の奥まで、おまえのペニ\nスが……はっ、あっ、えぐってくる……ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304117" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「何度味わっても、たまらないな、これは……気持ちよすぎる……んっ、ふう\nううっ、おまえの中で一番褒めてもいいぐらいだ……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304118" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「このカリ首の大きさと、先端の硬さ……女殺しにも程がある、あっ、んっ、\nふううっ！！　おまえ、房中術を学んだら、んんふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「どんな女でも従えられるようになるぞ……私以外はな、あんっ、あっ、あっ\nあっあっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304120" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、うっ……んんっ、なにを見て……ふふっ、私の胸か、んっ、腰\nをうごかしたら揺れるものな……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304121" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「女に組み敷かれながら胸を見て興奮するなんて、奇特な奴だ……んっ、はあ\nっ、ああっ、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「いいぞ。存分に見ていいぞ。それでペニスを硬くしろ……はあっ、ああっ、\nんっ、ふうっ、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304123" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ、本当に硬くなって……んんっ、大きさも……ますます私のオマンコ\nをえぐってるな、ふあああっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ご褒美に、締めつけを強くしてやる……んはあっ、あんっ、んっ、ふううっ\n！！　ふふ、忍者はこういうこともできる……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304125" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「気持ちいいだろう？　私も、おまえのペニスの形をしっかりと感じ取れて…\n…ほら、オマンコの襞でカリ首の段差を……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304126" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こうして密着すれば、あんっ、あっ、あっあっあっ！！　ごりごりって中が\n削れて、気持ちいい……ふうううっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほら、おまえも腰を動かして、オマンコをもっと削って……んふうっ、女に\n動かれてばかりで情けなくないのか、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304128" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「そう、そうだ、んふうっ、んっ、私に認められたいなら、セックスも強くな\nれ、ふううっ、んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほら、頑張れ頑張れ、ピストン頑張ってペニスで私を悦ばせろ、んっ、あっ\n、そう、そうだ……もっと、もっと、ふああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、いいぞ、気持ちいい、んっ、ふっ、あああっ、腹の奥がじん\nじんして、ひっ、あっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304131" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「気持ちいいっ！！　おまえのペニス、気持ちいいぞっ！！　んんっ、腰が、\n勝手に動く……あっ、くうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304132" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、もうそろそろ、んっ……イきそうだ……ふううっ、あっ、ん\nっ、ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んくっ、あっ、はああっ、あっ、いいぞ、気持ちいい……おまえのペニスで\n、私のオマンコ、イきそうだ……あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、おまえ、その顔、ダメだ、ダメだ、勝手に、イくなっ！！　あっ、私\nの腰で、我慢できないって、待て、待てと言ってるのに、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んんんんんっ！！　この、バカ……っ！！　先に、勝手に射精する奴がある\nか！！　くうっ……ふっ、んっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304136" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「まったく、少し褒められるところができたと思ったら、自分勝手に射精して\n……女を満足させなければ、従えることなどできないぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304137" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふううううっ、そのくせ射精の量は人一倍で……んっ、ふっ、最後まで私の\n中に注いで……んっ、くうううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふっ、うっ……んっ……中途半端に火をつけられたようなものだ……んふう\nっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304139" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「私はまだまだ満足してないぞ……むしろ余計に欲求不満が高まった。おまえ\nのせいでな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304140" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「だから覚悟しろ、次は私もイかせてもらう。おまえもペニスががちがちで萎\nえていないぞ。まだまだしたいんだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304201" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふ……このまま抜かずの二回目だ。次は私より先にイくんじゃないぞ……\n我慢しろ、女より先にイくような男にはそれが必要だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304202" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほら……んっ、この腰使いで、我慢しろ……んっ、はっ、あっ、あんっ、ん\nんっ、そら、我慢しながら動け……んんっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304203" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、あんっ、ふうううっ、いいぞ、んっ、奥、ごりごりって押し\nつぶすのも、ふうううっ、気持ちいい……あんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304204" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、んっ、あんっ、いい、いいぞ……気持ちいい……その調子で、\n私に奉仕しろ……この我慢できないペニスで、んんうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「私を気持ちよくしろ……そうしたら、一緒にイっていいからな……おまえと\n私で、一緒に……あんっ、はあっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304206" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふうっ、私もこうして、腰を動かしたら……ふふっ、顔が気持ちよさそう\nに蕩けてるぞ、気持ちいいんだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304207" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「そうして円を描くようにすれば……あんっ、はっ、ああっ、私もおまえも気\n持ちいい……んっ、ふうっ、これが、二人で気持ちよくなる、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「喋ってるときに腰を動かすな、あんっ、ああっ！！　動かすなと言ってるの\nに、んっ、これが二人で気持ちよくなるということだ、ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304209" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「この、バカ……っ！！　んんっ、おまえがその気なら、私も本気で……んっ\nんっんっ、ふうううっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「どうだ、この腰の動き、叩きつけながら、締めつけて、奥に来たカリ首をく\nにゅくにゅと刺激したら……ははっ、なんだその顔は、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304211" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「口の端が緩んで、唾液がこぼれてるぞ……あんっ、ああっ、この、対抗意識\nを燃やすな、ふううっ、んっ、あんっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「奥、とんとんと叩かれたら、んんんんっ、はあっ、ふっ、あくうっ！！　あ\nっあっあっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304213" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふううううっ、やっぱり、お前のペニスは……んっ、気持ちいい……んんっ\n、ふうっ、こんなので突かれ続けたら……んふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304214" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、私のオマンコ、ダメになる……んふうっ、男に媚びる、ダメ\nマンコになってしまう、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304215" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふうううっ、ああっ、んっ、きた、またきた……気持ちいいの、また腹の奥\nから……んふうっ、ああっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「おまえも、出そうだな……でも、まだ我慢だ、我慢、私のオマンコの中で、\nペニスは我慢だ……はっ、ああっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304217" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「我慢しきったら、もっと気持ちよくなるからな……んっ、はっ、あああっ、\nんんんっ！！　二人で、腰を動かして、んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、オマンコで締めつけて……ふうううっ、ペニスの形、分かる\nぐらいに締めつけて……んんっ、あっ、イく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304219" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「イく、イく、イっく！！　おまえも、一緒に、ふううううっ、イっく、イく\nうううううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304220" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふあああああっ！！　イってるオマンコの中に、精液きたあっ！！　あああ\nっ、んっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、くっ！！　熱い……最初のと混じって、オマンコがどろどろ\nに蕩かされて……んんっ、あっ、はっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んうっ……出されながら、またイくっ……んっ、ふううううっ！！　はあっ\n、ああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふうううううっ、焦らされた分、気持ちよすぎる……んっ、あっ……おま\nえも、よかっただろう？　ふふっ、答えなくても分かる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304304" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「その顔と、中のペニスの反応でな……んくうっ……ふっ……今回は、私も満\n足したぞ……あっ、はっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こんなに出されれば､女としても満足できる……腹の奥も存分に突かれたし\nな……ふふっ、まだ全身が痺れてるようだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ……気持ちよかったぞ。まったく、最初から一緒にイっていればもっと\nよかったんだが。あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304307" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「最初は私がエロすぎて我慢できなかったと……そんなにおだてても許してや\nらんぞ。んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「私とするときは、私が主導権を握る。これは譲れない……ふふっ、そんな顔\nをするな。それでもな――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304309" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「二人同時にイくのは何度もしなければタイミングが合わない。だからな、こ\nれからも何度も何度も、沢山セックスするぞ。いいな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ああっ、こら、なぜオマンコから抜く……んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふうううううっ！！　おまえ、私の身体に……んふうっ、あっ、んっ、んん\nんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「おまえの精液……熱い……んっ、はっ、あああっ！！　ふっ、うっ、んんっ\n、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ぶっかけられてもイくだろうって、おまえ……んっ、はっ、あああっ、あく\nうっ！！　それも分かるが……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「まったく、私はお前の精液が中に欲しかったんだが……うるさい、なんでも\nない。聞き直すな！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304405" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ま、まあいい。おまえがどうしても私の身体にぶっかけたかったというのな\nら、許してやらんでもない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んふうっ……こんなに濃くて大量の精液でマーキングされるのも、悪くない\nからな。んんっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304407" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「おまえが私のものであるということは、私もおまえのパートナーであるとい\nうことでもあるからな。あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「これぐらいは、許してやろう……それに、おまえの満足げな顔を見たら、怒\nる気も失せた。んっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304409" ]},
		{"command":[ "SETIMAGE", "0", "still_00010013_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aニャンコ先生" ]},
		{"command":[ "SETTEXT", "「だが、今度はちゃんと中に出すんだぞ……女にとって、愛する男に中出しさ\nれる幸せほど確かなものはないのだからな。いいな、絶対だぞ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1304410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ヴァルキリー化の影響が、まだ残ってるのです……オマンコの奥から、エッ\nチなお汁が止まらないのですよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804101" ]},
		{"command":[ "SETCHARA", "0", "char_00000528_01", "7", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「な、なので、今日は特別に、あなたがウチを責めることを許可してやるです\n。その大きなオチンポで、ウチのオマンコを突きまくるといいですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804102" ]},
		{"command":[ "SETCHARA", "0", "char_00000528_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ほ、ほら……もう準備はできてるですよ。ウチのこと、満足させやがれです\nっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804103" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あんんっ……ぶっといオチンポが、オマンコにあたってるですっ……は、早\nく挿れてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804104" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「えっ……？　まずは濡らさないとダメ？　な、何言ってるですかっ！　ウチ\nのオマンコは、もうこんなに濡れてっ……ひゃんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「オマンコじゃなくて、オチンポを濡らすため？　それも、ウチの愛液でヌル\nヌルにするだなんて……そ、そんなことしなくてもっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　あんんっ！　割れ目をオチンポが擦り上げてくるのですぅ…\n…！　ウチの透明な蜜が、オチンポに絡みついていくのですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「くちゅくちゅって、いやらしい音もして……あ、あなた、わざと音を立てて\nないですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「これだけオマンコが濡れてたら、エッチな音が鳴るに決まってるですか……\n？　た、確かに濡れてるですが、いつもと同じくらいですよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「そんなことない？　いつもより濡れてるし、割れ目から濃厚な匂いが漂って\nくるだなんて……！　そ、そそ……そんなはずは……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「いやらしくて可愛い、ですか？　エッチ大好きなドスケベ女の方が、あなた\nの好み……？　ウ、ウチはエッチ大好きなドスケベじゃないのです！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「で、でも……あなたがそういう女性を好むのなら……エ、エッチなこと、も\nっと勉強してあげてもいいけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「うぅっ！　な、何も言ってないのですっ！　いいから、早くオチンポをオマ\nンコに挿れて、ズポズポするですよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ぐっ、くぅぅぅっ！　オチンポ入ってきたのですぅ！　あなたのたくましく\nて、カタいオチンポぉ……！　あぅ、うぅっ！　んぐぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「オマンコのヒダを掻き分けながら、奥に押し込まれてっ……はぅぅっ！　オ\nマンコが広がる挿入感……たまらないですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「早く奥まで……！　ウチの大事なところに、オチンポ当てて欲しいですっ！\n　あなたの勃起オチンポで、子宮口を押して欲しいですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ひゃ、あうぅ～！？　あっ、あっあっ、んっ、あはぁぁっ！　奥までっ……\n赤ちゃんの部屋の入口まで、オチンポ届いてるですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「お腹を圧迫される感覚、たまらないのですっ……！　このままズンズン突き\nまくって、めちゃくちゃに犯すといいですよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「今のウチはヴァルキリーなので……乱暴にされても、大丈夫なのですっ。む\nしろ、乱暴にされることを……ちょっと期待してるのですよっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あっはぁぁぁんっ！　オチンポ動いてるですっ！　ウチのオマンコ、オモチ\nャみたいに扱ってるのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「亀頭が子宮口を押しながら、オマンコのお肉を引っ掻いてっ……！　この無\n理やり感っ、最高なのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「いつもより激しくて、とってもいいのですっ……！　でも、この程度じゃ、\nウチのオマンコは満足しませんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「もっと勢いよく出し入れしたり、押し付けたりするですっ……！　ウ、ウチ\nの子宮に、直接オチンポを挿れるくらい、激しくっ……んはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あっあっ！　ふぁ、あっ！　出し入れ、どんどん強くなるですっ！　いいっ\n、いいですっ！　すっごく気持ちいいのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あなたの性欲をウチにぶつけてくださいっ！　その方が、ウチも性欲を解消\nできて……はぅっ、あっ、おっ！？　ひっぎっ、んぎひぃ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「オマンコめくれるっ！　亀頭の出っ張りが、膣内のお肉に引っ掛かってるの\nですよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ、ふぁ、んっ！　あはぁっ！　このお肉が引っ張り出されたり、\n押し込まれたりする感覚、たまらないのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「もっとオマンコ締めて、ヒダやお肉をオチンポに絡めてやるですっ。そうす\nれば、もっとこの快感を味わえるはずっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あっ、おあっ！　ひゃ、あんんっ！　ぐぐっ、ふっ、うっぐっ！　んんっ、\nおっ、ほぉぉっ！　ほひっ、あっ、おっ！　おほぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「い、今まで出したことがないような声が出ちゃうのですっ！　ウチのオマン\nコ、気持ちよすぎて蕩けそうなのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「奥を突かれまくって、ウチの大事なところ……赤ちゃんの部屋の入口が、開\nいてきてるのが分かるですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「このままだと、本当にオチンポが子宮に入ってきそうなのですっ……！　直\n接、精子を流し込まれそうでっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あぅっ！　おっ、おぉっ！　あぅぅぅ～っ！　あ、あなたの赤ちゃんが出来\nるかもと思ったら、急に絶頂感が襲ってきたのですぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「イ、イクですっ！　オマンコイクですぅ！　オチンポで子宮口を叩かれなが\nら、イッちゃうのですぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あっ、あっあっあっ！　ひゃ、あんんっ！　イクッ……イクイクイクッ！　\nイクぅぅぅ～～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あひっ！？　おっ、おぉぉっ……！　いきなりオチンポが膣内で跳ねてぇ…\n…！？　こ、これ、射精してるですっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ウチが達するのに合わせて、あなたもイクなんて……！　こんなに嬉しいこ\nとはないのですよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「お腹の中がザーメンと幸せで満ちてきてっ……頭がフワフワするですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「子宮口にオチンポを押し付けながら射精されるの、最高ですっ……！　もっ\nともっと、射精して欲しいですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あなたのオチンポミルク、全部受け止めてあげるですよっ……！　だから、\nもっと出してっ……ひゃ、あぐっ！　んんっ、んっふぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「んっ……んんっ……さすがに出しすぎなのですよっ……ウチが本当に妊娠し\nたら、どうするつもりなのですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「えっ……その時は、ちゃんと責任を取る……？　な、なななっ、何を言って\nやがるのですっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「そ、そんな甘い言葉を言っても無駄ですからっ！　ウ、ウチはだまされない\nですよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「本気なことを伝えるために、精液まみれのオマンコをかき回してやるって…\n…それって、もう１回するってことですっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「い、いえっ……イヤなのではなく、むしろ嬉しいというか……！　そ、それ\nより、この状態で膣内を突かれたら、本当に赤ちゃんがっ……あぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ひゃ、あっひっ！　あっあっ、んぁ、あっ！　オチンポで奥のところ、ズン\nズンされてるですっ！　子宮口がどんどん開いてくるのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「オマンコに残ってるあなたの赤ちゃんの種、全部子宮に押し込まれてるので\nすよっ！　こ、これ、絶対に妊娠するですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あ、赤ちゃんできるのですっ！　そ、そんなの、嬉しすぎてっ……オマンコ\nが勝手にぎゅ～って締まるのですよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ！　あぁんっ！　オチンポ締め上げると、出し入れの勢いもさら\nに強くなるのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「無理やり犯されてるみたいで興奮するし……すっごく気持ちいいのですっ！\n　もうこのオチンポから、離れたくないと思ってしまうのですよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あっ、あっ、ふぁ、んにゃあぁぁ……！　オマンコ蕩けちゃうっ……！　ズ\nンズンされるの気持ちよくて、おかしくなるですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「も、もっといやらしい声を出して、喘いでオチンポを求めて欲しいだなんて\nぇ……！　そ、そんな、恥ずかしいこと……くぅっ！　あっ、んはぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「い、言うっ！　ちゃんと言うですっ！　あなたのオチンポ、すっごく気持ち\nいいのですっ！　もっと激しく突きまくってくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ウチのオマンコ、あなたの形にしてっ……あなたのオチンポ専用のオマンコ\nにして欲しいのですっ！　んんっ！　ぐっ、あっ！　はひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「そ、それと……オマンコだけじゃなくて……ウチのことも、あなたのモノに\nっ……！　あんっ、あぁんっ！　はっ、ぐっ！　ふぎゅぅぅぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804215" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「妊娠して……あ、赤ちゃんができたら、ウチと一緒になってっ……！　ウチ\nが寂しがらないように、ずっと一緒にっ……！　あっあっあっ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「うぅぅっ！　これ以上は無理ですぅっ！　は、恥ずかしくて、とても言えな\nいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「気持ちは充分伝わったから、このままイカせてやるだなんてっ……！　あっ\n、うぁっ！　う、うんっ……！　イカせて、くださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ウチに向かって、いっぱい精液どぴゅどぴゅしてっ……！　あなたのザーメ\nンで、ウチのこと染め上げてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ひゃ、あんんっ！　ふっ、あっ、おっ、おぉぉぉっ！　ウチ、イクッ……！\n　幸せいっぱいで、イッちゃうですっ……！　くっ、はぁぁぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804220" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_12" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あっひっ！？　あっ、おぉっ、おぉぉぉっ！？　また、膣内に射精されてる\nですぅっ！」", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_16" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「開ききった子宮口に、オチンポの先端をぴったり押し付けながらの射精っ…\n…！　こ、こんなの、受精しろって言っているようなものですよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ウチ、本当にあなたの子供を孕んでっ……！　あっ、あっ！？　んっひっ！\n　あっ、ぐっ！　うっぐぅぅぅ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「気持ちいいのと嬉しいのが混ざって、何回もイッちゃうですっ！　もう何も\n考えられなくなるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「イッ、イクッ！　イクイクッ！　オマンコイクッ！　種付けされながら、イ\nキまくるですぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「うっあっ、あっ、あぁぁぁぁんっ！　はぁ、はぁっ！　ふっ、はっぐっ！　\nんんっ！　んぅ～～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あっ……あぅぅっ……すごいっ……こんなに、ザーメンがオマンコに注がれ\nてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「お腹の中、すっごく熱いですっ……あなたの濃厚ミルクで、オマンコいっぱ\nいなのですよっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「えっ……？　まだ出せるから、もっとセックスしたい？　一晩中犯して、ウ\nチのこと絶対に孕ませる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「そ、そんなっ……！　イ、イヤじゃないですっ！　ウチ、もっとして欲しい\n……！　一晩と言わず、ずっとエッチして欲しいのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「きゃうぅぅっ！　こ、今度は身体に精子を浴びせるなんてぇっ！？　あんっ\n、あっ……！　すごい匂いっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「臭くて、ドロドロしててっ……！　それにとっても熱いっ……！　これが、\nウチのオマンコに注がれていたのですねっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804402" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「こんなに濃い精液を出されてるなら、妊娠して当然なのですっ……！　あな\nたの赤ちゃん孕んじゃうのです……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ウチに赤ちゃんが出来たら、ずっと一緒に……！　変身が解けても、二人で\n幸せに暮らすのですよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「あんっ、んんんっ！　想像だけで、またイキそうですっ……！　気持ちいい\nの、止まらなくてっ……うぁっ、あっ、んっぐぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「イクッ、イクですっ！　オマンコイクッ！　あっあっ、ふぁ、あっ！　ザー\nメンミルク浴びながら、イクですぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「はふっ……はっ、はっ……ふっ、はぁぁぁ……幸せなイキ方をして、意識が\n飛ぶかと思ったですよっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「こんなの味わったら、もっとイキたくて仕方ないのですっ……あ、あの……\nまだ、付き合ってもらえますよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ウチが満足するまで、何回だって犯してあげるだなんて……言い方は少し気\nになりますが、嬉しいのですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804409" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「なら、またオマンコに……あっ、いや……お尻の穴でもお口でも、あなたが\n好きなところに挿れていいですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2804410" ]},
		{"command":[ "SETIMAGE", "0", "still_00000528_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あっ……イ、イクっ……！　んぅぅぅっ……イクぅっ！　私のオマンコっ…\n…中出しされて……イッてますのぉっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁあ……あっ、熱い……日光より……オマンコの奥が……今、一番感じて\nますわ……あぁ……素敵……」", "NORMAL" ]},

		{"command":[ "SETTEXT", "「も、もう……あの方たち……行きましたわよね？　声……また、出しても大\n丈夫ですわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204214" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁ……は、はい……またオマンコいっぱいして下さい……も、もう少しく\nらい見つかってもいいですからっ……中……かき回してっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204215" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁうんっ……あぁっ、それですっ、はいっ、オチンポ気持ちいいっ！　私\nのオマンコっ……貴方のオチンポに犯されて気持ちいいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204216" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はひっ、あぁっ、貴方もまたイキそうなんですのねっ？　またっ……私で気\n持ちよくなってっ……出して下さいませっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204217" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はいっ、一緒がいいですっ、貴方と一緒にイッてっ、私をっ、飛ばせて下さ\nいっ……あぁっ、もう誰かに見られても構いませんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ドスケベ貴族のっ、アンドレッテが……恥ずかしいイキ顔を見せているとこ\nろをご覧になってっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あぁっ、イキますっ、オマンコまたイキますっ！　オチンポメロメロにされ\nてっ、私っ……イッちゃいますのぉぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204220" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁんっ……！　あぁっ……また中……出てますっ……濃いの……子\n宮まで全部届いてる……くうぅぅぅぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204301" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……あっ、やぁっ……イキ潮が……溢れてっ、や、やぁ……こんな、\n赤ちゃんにおしっこさせるみたいな格好……だ、だめですわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あぁ……精液と一緒にポタポタ垂れて……止まらない……恥ずかしい……あ\nっ、そんなに足を広げさせないで下さいませ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んぁっ……まだ、オチンポ脈打ってますの……しっかり種付けしようと、私\nの中に射精続いてます……んはぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204304" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……はぁ……あぁ……お、終わりましたか？　はい、私も、落ち\n着いたような……まだふわふわしているような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204305" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「外でのまぐわいが、こんなにも激しいものになるなんて……見られてしまっ\nたらというスリルが堪らなくて……何か目覚めてしまいそうでしたわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ずっと、中でオチンポが膨らんだままで……と言うか、今もまだ勃起が大き\nいままなのですが……も、もうこれ以上はしませんからね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「とにかく、私は敗者の務めを全うしたということでよろしいですよね？　私\nの覚悟……伝わりましたわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「予定と違うけど、しっかり伝わった？　何か違っていたのでしょうか……ま\nぁ、伝わっていたのならよかったです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「それで……その、今度こそ下ろして頂けると助かるのですが……いつまでも\n、こんなに広げたままなのは……恥ずかしいですわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁんっ……！　あっ、オチンポ抜けてっ……精液っ……熱いのっ……掛か\nってますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204401" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あふぁっ、あぁっ、おっぱいっ……顔にまで飛んでっ……あひっ、オマンコ\n抜けてっ……私もイキ潮っ……出てまひゅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あぁぁ……あふっ、いや……こんな大股開きで……お汁飛ばさせないで……\nあぁっ、止めたいのに……オマンコに力が入りませんの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204403" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁぁ……見ないで下さい……あぁ、おしっこみたいにしちゃうの恥\nずかしい……はひっ、でも……オマンコ気持ちいぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204404" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んふっ、はぁ、はぁ……はぁっ……だ、出し切りました……貴方の射精も終\nわり……ましたか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204405" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ちょ、ちょっと待って下さい……私も、余韻が強すぎて……まだ、まともな\n思考ができていませんの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204406" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ずっと、こんな恥ずかしい格好のままで……そ、そろそろ下ろしていただい\nても？　私……お役目は果たしましたわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「えっ……本来の予定とは違ったけど、見事に果たした？　その本来の予定と\nいうのは……海の家の手伝い！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204408" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「い、以前にもそんな話があったような……わ、私……早とちりして……な、\n何という破廉恥な……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「改めて海の家のお手伝いを……す、するわけないでしょうっ！　もうっ、知\nりませんわっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204410" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_16" ]},
		{"command":[ "WAITINPUT" ]},

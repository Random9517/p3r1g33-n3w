		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「えっ？　ま、まだ……終わりじゃない？　ここからが……本番……あっ、ひ\nゃうんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204202" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「そんな、んっ……オチンポ……また中で漲って……あっ、オマンコの中で膨\nらんで……来ていますのっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「私のオマンコが良すぎて……もっと味わいたいと……そ、そんなこと言われ\nましても……あっ、あぁんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「やっ……中で、精液が……ぐちゅぐちゅしてますの……あぁっ……お、音が\nさっきより響いて……こんな、私……はしたないっ……」", "NORMAL" ]},

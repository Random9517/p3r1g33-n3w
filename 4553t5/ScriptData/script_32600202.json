		{"command":[ "SETIMAGE", "0", "still_00026002_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んふっ……あぁっ、あんっ、精液……だけじゃない……？　これは、わ、私\nから出てる……オ、オマンコのお汁も……一緒に……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204206" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「そ、そんなこと……わざわざ言わなくても、分かって……あひっ、だって…\n…こんな、太いので……ズンズンされたら……誰だって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204207" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「そうですっ……誰だって、あぉっ……！　お汁……溢れさせてっ……オチン\nポっ、締め付けてしまいますからぁっ……んひぃんっ！」", "NORMAL" ]},

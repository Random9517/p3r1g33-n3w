		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「みなまで言わずとも分かっています。これも敗者の定め……どんな罰でも甘\nんじて受けますわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204102" ]},
		{"command":[ "SETCHARA", "0", "char_00026002_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「さあ、覚悟は決めています。煮るなり焼くなり、どうぞお好きになさって下\nさい。どんな辱めであっても、甘んじて受け入れますわ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204103" ]},
		{"command":[ "SETCHARA", "0", "char_00026002_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あ……あのっ、確かに覚悟は決めましたが……そ、そのっ、何と言いますか\n……この格好は……そのっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204104" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「こんな……大きく足を広げて……な、何もかも見えてしまっていませんか…\n…？　いくらなんでも空の下でこれは恥ずかしいと言いますか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「も、もしかしなくても……これ、オ、オマンコが丸見えになっていますわよ\nね？　おっぱいも……水着からはみ出て……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「このまま……オチンポが入ってしまったら……私……どうなってしまうのか\n……あっ、あひっ、あっ、んくぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204107" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ちょっ……まだ、心の準備ができる前に……そんな、入れるなんてぇ……あ\nぁ……オチンポ……ずぶって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204108" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んくぅぅ……これ……大きいですわ……こんなの、されたら……はぁぁ……\nあっ、おかしくなりますぅ……んっ、くふぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204109" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はんっ、あっ……あぁ……あんっ、あぁ……私……何というはしたない格好\nで……こんな、オ、オマンコを見せびらかすような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204110" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「貴方からは見えていないから大丈夫……？　そ、そういう問題ではありませ\nんわっ！　私が恥ずかしいと言ってますのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204111" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「今は、辛うじて岩陰ですけど……もし、誰かがこっちに来たら……こんなの\n、誤魔化しようがありませんわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はっ、んっ……あぁっ、ちょっ、き、聞いてますのっ？　あっ、普通に……\nピストンが激しいんですけどっ……あっ、あぉっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204113" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「気にしないで……身を任せれば……そ、そんな……ことっ、はぁっ、んっ…\n…言われ……ましてもっ、あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「そもそも、この格好……もう、自然に身を任せるしか……できなくてっ……\nあんっ、オチンポの言いなりにしか……なりませんのっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204115" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ、あぁ……あの……私……重くありませんか？　こんな支えら\nれて……あっ、中をかき回されるなんて思ってなくて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204116" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「軽い……？　ほ、本当ですの？　途中でやっぱり重かったなんて言うのはな\nしですわよっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204117" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「は、はい……んっ、あぁ……貴方を信じていますわ……ちゃんと、最後まで\n……支えていて下さいね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、あぁっ、オチンポが……擦れて……んくぅ……太いのっ、来\nるぅ……あっ、おっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204119" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「もっと、詳しく……？　そ、そんな風に言われましても……あっ……今……\nオ、オマンコが……どうなっているか……ですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204120" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁ……私のオマンコは……今……深いところまで、オチンポがめり\n込んでいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204121" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「自分では何もコントロールできなくて……いつ、ずぶって……来るのかが分\nからなくて……あっ、ドキドキして……はひっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あっ、い、今ぁっ……また、ずぶって入りましたわぁっ……♪　あんっ、オ\nチンポっ♪　ヒダに擦れますぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204123" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はっ、ふぁっ、んはぁっ……ああっ、ゆさゆさっ……されてっ、オマンコ広\nがるっ、あぁんっ、広がっちゃいますっ、あんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204124" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あっ、んぁっ、おっぱいもっ……揺れてっ、はしたないっ……ダメ……これ\nっ、絶対誰にも見せられない状態ですのにっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はんっ、あっ、あぁっ、声が……出てしまいますのっ……見つかったら……\n全部終わってしまいますのにっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「こんな……オマンコ気持ちよくされたらぁっ……あんっ、あぁっ、いやらし\nい声……出て……しまいますわぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ……あっ……！？　ど、どうして急に止まったんですの……？　えっ…\n…ひ、人が近くに……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204128" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「で、でしたら……オチンポ……抜いて……み、水着を元に戻させて……ダメ\n……こんないやらしいところ……見られたら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「オ、オマンコひくひくさせてるなんて……そんな……だって、身体が勝手に\n……あっ……えっ、う、ウソ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204130" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁっ、だ、騙したんですのねっ？　ひどいですわっ……！　私は本\n当に見つかってしまったら、どうなるのかと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204131" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ド、ドキドキはしましたけど……あっ、あぁっ、また……オチンポ激しくっ\n、あひっ、あひぃっ！　あっ、そんなにされたらっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204132" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ……イクっ……？　で、出そうなんですのねっ？　あぁっ、わ\n、私もっ……オ、オマンコ……イキそうかも知れませんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はひっ、あぁっ、このまま……最後までっ、んぁっ、中にっ……だ、出され\nたらっ、ひぃっ、あひぃんっ！」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「この余韻……頭がクラクラして……堪りませんわ……はぁ……あふ……んふ\nぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……あの、出されたんでしたら……そろそろ、下ろして頂ける\nと……嬉しいのですが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204201" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_02_09" ]},

		{"command":[ "SETIMAGE", "0", "still_00026002_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……ど、どうか……お手柔らかに……そんな、見せびらかさない\nで……オマンコ……丸出しにして……恥ずかしい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あっ、ふぁっ、あ、あんっ……！　いやっ、ま、また誰か来たのでは……？\n　声……我慢しろなんて……そんな、ことっ……」", "NORMAL" ]},

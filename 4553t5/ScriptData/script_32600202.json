		{"command":[ "SETIMAGE", "0", "still_00026002_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「か、構いませんっ！　何でも……何でもいいですからっ、下さいっ……あっ\n、はぁんっ……中にっ、射精っ、してぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0204135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁんっ……！　あっ……中に……貴方の精液が……流れ込んで……来\nてますわぁっ……く、ひぃぃぃっ……♪」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……やっと来たか。貴様を呼び出した理由、わざわざ説明しなくとも、わか\nっているな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303101" ]},
		{"command":[ "SETCHARA", "0", "char_00000143_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――え？　ほんとに分かるのか？　そ、そうだ、昼間の戦いで不甲斐ない所\nをみせられたからな。それを叱ってやろうと思って呼びだしたのだが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303102" ]},
		{"command":[ "SETCHARA", "0", "char_00000143_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「は？　そのお仕置きしたくて呼びだしたのは建前で、それ以上に私が気にし\nてるのは貴様の身体の心配、だと……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303103" ]},
		{"command":[ "SETCHARA", "0", "char_00000143_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「た、確かにそういう気持ちがない訳でもないが――って、本当になんでそこ\nまで分かる！？　察しが良すぎて逆に怖いまであるわ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303104" ]},
		{"command":[ "SETCHARA", "0", "char_00000143_01", "9", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「おい、勝手に話を進めるな！　その『分かってる分かってる』みたいな優し\n気な視線はやめろ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303105" ]},
		{"command":[ "SETCHARA", "0", "char_00000143_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……なるほど、理解した。つまり貴様、私をからかっているな？　いいだろ\nう……貴様がそのつもりなら、しっかり分からせてやろうではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303106" ]},
		{"command":[ "SETCHARA", "0", "char_00000143_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、どうだ、苦しいか？　――貴様が反省するまで、こうして尻で顔面\nを圧迫してやろう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――って、おい、なぜただ顔を尻で敷いただけなのに、チンポをこんなにも\n勃起させている？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「普段からそういうことばかり考えているから、集中を欠くんじゃないか？　\nどうせ、今日の戦闘中もそうだったのだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「まったく……これではお仕置きではなくご褒美ではないか。こうなったら堪\nえ性のない貴様に、快楽と言う罰を叩き込んでやる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「貴様はただ私のされるがままになって、みっともなく喘いでいるといい。―\n―あーむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んちゅ、れるぅ……相変わらず、なんて大きさのチンポだ……んちゅ……一\n気に呑み込んでしまいたかったが、全然口に入りきらんな……んちゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んちゅ……ちゅ、れるぅ……亀頭のカリ首もこんなに大きくさせて……じゅ\nれる……私に呼び出された時点でこうなることを期待してたのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、私の下僕は、相変わらず下半身に忠実なエロ猿だな……んちゅ、ち\nゅ、れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――なに？　私も随分と積極的だな、だと？　むしろ喜んでチンポをしゃぶ\nり始めた私の方がエロ姫？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「まぁ間違ってはいないが……貴様にはっきり指摘されるのは、それはそれで\n気にいらんものがあるな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、まぁいい。このイラつきは、チンポにぶつけてやるとしよう。ほら\n、フェラチオを続けるぞ……あーむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、れるぅ……今度こそ、深くまでっ……んれるぅ……唇で竿を\n締め付けてっ……んふぅんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ちゅ、ちゅれるぅ……んちゅ、れろぉ……ふー、ふー……んちゅ、じゅれる\n……ん、んむ、んむぅ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひゃぁんっ！　お、おい、どうして貴様も私のマンコを舐めるっ、これはあ\nくまで私から貴様へのお仕置きだぞっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんっ……！　――くっ、いいだろう、貴様がその気なら、私だっ\nて本気を出してやるっ……んちゅ、んれるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ここ、括れの部分に舌を搦めてぇ……じゅ、れるっ、れるれろぉ……じゅ、\nじゅぶる、んれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「裏筋に舌を当てて、喉を鳴らすみたいに、もっと激しくっ……じゅ、じゅぶ\nる、れるれる、れろぉ……！　じゅるぅぅっ！　ぐぶぐぼぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、貴様の弱い所は全てお見通しだからな！　私にイタズラする暇なん\nて与えてやるものか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「じゅぶる、じゅ、じゅぞぞぉぉお……！　じゅぶるっ、れるれる、れろぉ…\n…！　んぶっ……！　ぐぶぐぼ、じゅぶるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁんっ……！　ザラザラの舌が、クリトリスを優しく舐めてっ……んん\nっ、あっ、うぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「舌がマンコの膣内に入ってくるっ……あっ、あぁんんっ……浅い所舐める動\nき、それっ、んぅうんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そうだったな……んぅんっ……私の弱い所も、貴様には全部バレているのだ\nった……！　だが、私だって負けるつもりはないぞ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあむっ……じゅ、じゅぶる、れるれるれろぉ……！　こうして舌先で亀頭\nの先端をぐりぐりして、直接射精を促してやるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「じゅ、じゅれる、じゅぶるぅ……はぁ、はぁ……あーむ……じゅぶ、じゅい\nぶれろぉ……！　んんっ……じゅぞぞぞ、じゅずぞぞぉぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……！　はぁ、はぁ、はぁ……んぁんっ……！　先走りと唾液が混ざ\nって、匂いもすごくてっ……んちゅ、じゅれるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、チンポが大きくヒクついて、尿道がピクピクし始めたな？　んれる\nぅ……分かるぞ、このまま私の口の中で果てたいのだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「いいぞ、いつでも好きな時に出してしまえ……じゅれるぅ……全部口で受け\n止めてやるっ……んじゅ、じゅぶるぅう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ほら、イけっ！　私のフェラチオでびゅーびゅー射精してしまえ！　じゅ、\nじゅれる、じゅるぅぅんんっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんんんっ～～～！　んふっ、んんっ……んくっ、んくっ……んふっ……じ\nゅれる、れる、じゅるぅぅぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_11" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぶっ……まだ、出てるっ……じゅ、じゅれるっ……んくっ、んくっ。んく\nっ……じゅ、じゅぞぞぉぉ……んくっ、んくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふはぁ……はぁ、はぁ……あ、相変わらず、喉に絡みつくほど濃厚で、匂い\nも強くて……んんっ……なんてエロい精液だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああ、まだ先端から溢れてきてる……ちゅ、んちゅ……ちゅれるぅ……んっ\n……これでよし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、私のフェラチオも、中々上手くなっただろう？　気持ちよかったか\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――まぁ、聞くまでもないのは分かっているがな。途中からマンコを舐める\n事も忘れて身悶えていたものな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――なに？　一回出したくらいじゃ物足りない？　まだまだ私の口で気持ち\nよくしてほしい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、貴様と言うやつは……一応の名目は、戦闘で不甲斐ない姿を見せた貴\n様への罰、だったはずなのだがな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが……ふふっ、そうして素直に私に縋りついてくる姿は悪くない。望み通\nり、このままもう一度、私の口で気持ちよくなってしまえ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「その代わり貴様も……んぅんっ……それでいい。今度は私のこともしっかり\n舐めて、気持ちよくするんだぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あーむっ……じゅん、んれるっ……まずは、尿道に残ってる精液を吸い出さ\nないとな……じゅ、じゅれる、じゅぞぞぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、刺激が強いか？　腰をもぞもぞさせても逃がしてやるものか。貴様\nの方から求めてきたのだからな♪　じゅるぅ、じゅぶるぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……精液は綺麗になったが、また我慢汁が溢れてきて……んちゅ、ち\nゅれる……流石にキリがないな、これは……ちゅ、ちゅれるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁんっ……す、すごい、鼻でマンコの入り口を擦られてっ、あっ、んぅん\nっ……！　またクリトリスを唇で挟まれてるっ……んぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、今度こそ私をイかそうと必死か？　だけど、私だって負けるつもり\nはないぞ……ちゅ、じゅれる、んれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうして、喉の奥まで使ってぇ……おっ……ぐぼ、ぐぶぐぼぉ……！　ぐふ\nっ……んんっ……じゅ、じゅれる、じゅぶるぅう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「頭を振りたくって、私の口全てで貴様のチンポを蕩けさせてやるっ……！　\nんぶっ、じゅぶる、じゅれるぅう……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぶっ、ぐぶ、ぐぼっ……じゅ、じゅれるぅ、じゅぶぅうぅ……んふっ……\nれるっ、れるれろ、じゅれるぅう……！　んんんっ！　じゅぶるぅう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「どうした、また腰が浮き上がり始めたぞ？　ふふっ、私の口が気持ちよすぎ\nて、我慢できそうにないのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、れるれろぉ……チンポもまた、口の中で大きく膨らんでっ…\n…ピクピク痙攣し始めてるのが分かるぞ……んちゅ、んれるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「このまま、敏感な裏の部分も舌でいっぱい舐め続けてやるからぁ……じゅれ\nる、れろぉ……また精液をびゅーびゅーって、漏らしてしまえ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んじゅるっ、れるっ、れるれろぉ……！　今度こそ、根元まで全部、チンポ\nを咥えてぇ……んぶっ、じゅぶる、じゅれるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「我慢など、させるものかっ……！　んぶっ、じゅっ、じゅぶうるぅっ……！\n　このまま最後までっ、んれる、れるれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「チンポの中を熱い精液がこみ上げてきてるのが分かるっ……ちゅ、じゅれる\nぅ……！　ドクドクって、血管が脈打ってっ、んんぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「いいぞ、貴様の好きなタイミングで出してしまえ……！　全部、私が受け止\nめてやるからっ、このままっ……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んれるっ、じゅずるぅぅう……！　ほらぁ、早く射精しろ、全部絞り出して\nやるから、このまま全部っ……じゅる、んじゅるぅぅうっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっふぅうんんっ～～～！　んぐっ、んんんっ、んんぅぅんんっ～～……！\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぶぅ……じゅ、じゅれるぅ……んくっ、んくっ、んくっ……！　に、二回\n目だというのに、さっきよりも量が多くてっ……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが、この程度の量ならっ……じゅ、じゅるぅぅう……！　んくっ、んくっ\n……熱々ザーメン、全部飲み干せるっ…んんっ、じゅるぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んくっ、んくっ……んふっ！　ごふっ、ごふっ……！　も、もっと唾液と絡\nめてぇ……んじゅ、じゅぶるっ……んくっ、んくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……！　はぁ、はぁ、はぁ……こ、これで全部だ……今度こそ、尿道\nの中の精液まで綺麗に飲み干してやったぞ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「気持ちよかったか？　――ふふっ、相変わらず素直で可愛いやつめ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――って、違う！　私がしたかったのは、こういうラブラブしたものじゃな\nく！　いや、これはこれで好きなのだがな……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うぅ……なんだ今日の貴様は、調子が狂うな……まるで私の事を見透かして\nいるようなタイミングで色々言ってくるし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303308" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それに結局……んんっ……私は最後までイケなかったし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「本番はここからだ。夜はまだまだ長い……私が満足するまで付き合ってもら\nうぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303310" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぅうんんっ……！　駄目っ、口からチンポが逃げてっ、んあぁんんっ……\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「二度目の射精も口で受け止めたかったんだがな……んんんっ……！　ふふっ\n、ザーメンのシャワーは、これはこれで悪くない……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「顔どころか髪にまで飛んできてっ……あっ、んんぅんっ……！　二回目だと\nいうのに、なんて精液の量だっ……んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「相変わらず、匂いもすごくて……すぅー、はぁー……んんっ……これを嗅い\nでいるだけで、頭が真っ白になってしまいそうだっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ……流石にもう打ち止めか？　それにしても、好き勝手出してくれたも\nのだな……全身貴様の精液でぐちょぐちょのドロドロではないか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「べ、別に嬉しい訳じゃない。ただ……ほら、貴様の匂いでマーキングされた\nと思えば、それもそれで悪くないというか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4303406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_01_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――って、違う！　私がしたかったのは、こういうラブラブしたものじゃな\nい！　いい感じに押し切ろうとするな！」", "NORMAL" ]},

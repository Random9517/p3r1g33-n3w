		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「……ああ。やっと来てくださったのですね。お待ちしておりました。約束の\n時刻より１２秒前に到着。貴方にしては上々です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203101" ]},
		{"command":[ "SETCHARA", "0", "char_00007202_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「貴方を呼び出した理由は、他でもありません。このハイパースーツの性能を\n共に検証していただきたいのです。……いきますよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203102" ]},
		{"command":[ "SETCHARA", "0", "char_00007202_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「はぁっ！　……フフフフ。驚きましたか？　目にも止まらぬ速さで脱がされ\nて。さらにこのスーツなら、こんなことも可能です。……それっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203103" ]},
		{"command":[ "SETCHARA", "0", "char_00007202_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「フフフッ♪　難なく成功しましたね。普通なら、恥ずかしくてとてもできな\nいような淫らな格好を、私にさせられたご気分はいかがですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203104" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「え？　そんなに恥ずかしくはない？　そ、そうなのですか……？　私が同じ\n格好をさせられたら、顔から火が出てしまうと思いますが……。ううん」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「殿方の感性はよくわかりませんわ。ですが……このスーツの素晴らしさは、\nそんな貴方にもしっかり伝わったのではありませんか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「か弱い女性にひっくり返されて、男の弱点であるチンポを丸出しにされてし\nまった。それどころか、肛門までまじまじと見つめられてしまっている」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「フフ……♪　貴方のこんな姿を見る事が出来たのは、全てクリスタル・コン\nツェルンのおかげですわ。では、さっそく始めますわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203108" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「……んっ……。クリスタルを消費することで、とてつもないパワーを出すこ\nとができるこのスーツ。その特性を逆に利用すると……。ん、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203109" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「こうして繊細な指の動きで、チンポを心地よくシゴくことが可能です。すご\nいでしょう？　こんなに……。んっ、細かく動かせるのですよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「さらに、ブルブルと振動させたり……。あはっ♪　貴方の性感帯を記録して\n、どんどん感じる部位を推理したり。まさに技術の結晶です……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203111" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ほら……、テクニカルなこの指先の動きに、どんどん快感が増しているので\nはありませんか？　チンポがピクピク震えていますよ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203112" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んっ……。なんて太くて硬いチンポですか。不測の事態でもここまで勃起で\nきるなんて、貴方も相当なものですね……。ん、ん、んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「……あぁ♪　握るのが難しいくらいに張りつめて……。んぅっ、私の手を弾\nき返してきますわ。逞しくて、元気で……あっ、ンッ、すごい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203114" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「それにハイパースーツの与える快感をもってしても、射精せずに耐えていら\nれる。やはり、実験対象に貴方を選んだのは正解でしたね……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「まだまだ、私とスーツの攻めは終わりませんよ？　貴方だってもっと気持ち\n良くなりたいはず……。では、こんな攻めはいかがです？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203116" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ん、ちゅ……♪　ちゅ、くちゅ……。ちゅっ……。んれろ……♪　さすがに\n驚きましたか？　ええ、アナル舐めです。耐えられます？　っちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203117" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「あんっ。いやだ……♪　お尻の穴をいじられるのが好きなのですか？　手だ\nけでしている時より反応がよろしいですわよ。っちゅっ、フフフ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「いいですよ。好きなだけしてあげます。ゆるゆると腕を動かしながら……ぴ\nちゃっ、んちゅ、ちゅぷ……。お尻の穴にキスを……。ちゅ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「くすぐったい？　いい兆候です、そのままリラックスして……私の濡れた舌\nに全てをゆだねてください。だんだん良くなってきますよ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203120" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ちゅく……くちゅ、ちゅ、ちゅぷ……。んっ、お尻の穴をすぼめないでくだ\nさい。怖いことなんて何もしませんから。力を抜いて……れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203121" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ん、ん、んっ、くちゅ……♪　ぴちゃっ、ぴちゃ……ちゅぷ♪　だんだん慣\nれてきましたか？　それではもっと大胆に舐めていきますよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んれろっ、れろ……♪　くっちゅっ、ぷちゅっ、ちゅぷ……♪　ンッ……ん\nん♪　ぴちゃっ、ちゅる……くちゅっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んふ……♪　次第にほぐれてきたようですわね。私の舌を少しずつ、受け入\nれているようです……♪　ぴちゃっ、素質があるのではありませんか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203124" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「まあ、私も……くちゅっ、嫌がられるよりは喜ばれる方が、奉仕のしがいが\nありますので。気にせずたっぷりとよがってくださいませね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「れろっ、れろ……れるっ、くちゅっ、ぴちゃっ……ぴちゃっ♪　んぅ、んん\n……♪　くちゅっ、ちゅっ、ちゅぅっ……ぴちゃっ、ぴちゃっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ん……、ここですか？　ここが感じますか？　はぁっ……♪　あら、息を吹\nきかけられるのもお好きなのですね。……ふーっ♪　ちゅ、くちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203127" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_04" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んれろっ……。あら、お尻で感じるとチンポがさらに硬く……♪　はい、手\nでも同時に快感をおくり続けますよ……。ん、んっ、んっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「アナルとチンポの二か所攻め……♪　下半身全部気持ち良くなれるなんてう\nらやましい限りです……♪　ぴちゃっ、ぴちゃ、くちゅ、ちゅぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「くちゅ、ちゅぷ、ぷちゅ……。あ……♪　透明なお汁がチンポの先から溢れ\n出してきました。これを指で広げて……くちゅくちゅくちゅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「水音をたてながら、もっとシゴきますね……♪　ぴちゃ……ぴちゃっ、んん\nんっ♪　ぺろっ、れろっ、レロ……んれろっ、くちゅっ、くっちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203131" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁ……♪　殿方の、蒸れた股間の香り……。こちらまで発情して\nしまいますわね。れろっ、ぴちゃっ、くちゅっ……くちゅっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203132" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「あっ♪　イかせてほしいんですか？　それなら……お認めいただきませんと\n。くちゅ……何を、ではありません。このスーツの凄さをです♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「チンポで直接感じるスペック……たまりませんよね♪　んれろ……れろっ、\nスーツを褒めながら、絶賛しながら射精してください。いいですね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「さあ……、さあ、さあ、さあ♪　え？　聞こえませんわ。満足？　あぁら、\nそうですか。では射精をどうぞ……んじゅるっじゅるっ、じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203135" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ンンッ……！　んっ……ああっ♪　すごい勢い……！　貴方のお腹の上にビ\nュッ、ビュルッて……。あっ、止まらない……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203136" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「へぇ……♪　このスーツで刺激すれば、こんなに真っ白な精液が絞り取れる\nのね……♪　もっと出してください、最後の一滴まで……！　あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203137" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「射精中にシゴくと飛距離が伸びて……。あっ♪　ねっとりしたお汁が撒きち\nらされた貴方の身体……。すごくいやらしいですわ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203138" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「くん、くん……。この濃い臭い……♪　嗅いでいるだけで、私まで疼いてき\nてしまいますわ……。と、いけないいけない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203139" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「思わずコンツェルンの任務を忘れて、個人の欲求に従ってしまうところでし\nたわ。どうです？　気持ちのいい射精ができまして？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203140" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「あ。まだ動かないでくださいね。私の手、チンポから離れていませんよね…\n…？　そう。お察しの通り、ここからが本番です。……んっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203201" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「白濁とした精液でヌルヌルしたチンポを丁寧に、根元からシゴきあげて……\n。はぁっ、はぁ、すぐに硬くなってしまうんですね。敏感……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ご自分でもおわかりでしょう？　精子を吐き出して、半勃起状態になったチ\nンポがどんどん力を取り戻しているのが……。素敵ですわよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「私もできることは全てさせていただきますわ……。まずはしっかりとチンポ\nを完全な状態に仕上げていき……。さあ、お待ちかねのお尻の穴です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203204" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んちゅ……、ちゅぅっ、くちゅ……ちゅ、ちゅぅっ……。ちゅぷ、ぷちゅ、\nちゅぅ、ちゅぅううう……♪　んんん、ここまで精子が垂れて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203205" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「苦味を感じますわ……。れろっ、んっ、んぅうう……♪　……あら♪　お尻\nの穴がヒクヒクとヒクついてきましたわよ？　開いたり閉じたりぃ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んちゅ、私の舌を欲しておねだりしているかのよう……。んんっ？　もっと\n奥まで入れてほしいのですか……？　貪欲ですね。いいですよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203207" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ぷちゅっ、ちゅぷっ、ぷちゅ……ちゅくっ。くちゅっ、ちゅぷ……ちゅっ、\nちゅぅっ……。あは……♪　手での攻めも止めませんよ、っちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203208" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んぁああ……♪　腸内の粘膜が私の舌をつかまえにきますね。そんなにお好\nきだったなら、もっと早くしてさしあげれば良かったですね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「アナルの弱い隊長様……♪　フフフ、もう認めてしまってくださいな。お尻\nを攻められると感じてしまうのですよね……ちゅっ、ちゅ、ちゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「アナルのフチを舌でなぞると、チンポがビクビク反応していますよ。れろぉ\nおおお……♪　あらあらあら、こんなところが性感帯だなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「いやらしい人♪　くちゅっ……♪　ンンッ、んちゅ……♪　えぇ？　もーっ\nと強くチンポをいじめてほしいんですか？　どうしましょうか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203212" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「……なんて、もちろんお応えします。ほらっ……♪　このスーツの完璧な微\n調整を、重ねて、重ねて、徐々にシゴく力を高めます……。れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「そしてここから……、あ、ンッ。スーツの真の力を解放します。……ちゅっ\n、振動モード、オン……！　フフフフ、チンポに直接伝播する震え」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203214" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「目にも止まらぬ超高速の振動と、私の愛情を込めた手の動き……。そして…\n…ちゅ、ちゅ♪　ねっとりとアナル全てを舐めたくるこの舌……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203215" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んふっ……♪　逃がしませんよ。受け入れてください。このスーツの魅力、\nその虜になることを許可します……！　ラストスパートですわよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203216" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「舌も、今までで一番長く伸ばして……しゃぶり尽くします。んれろっ……れ\nろっ、れろぉ……。さらに吸いたてて……じゅる、じゅっ、じゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203217" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んぅっ♪　チンポがパンパンに膨らんで……くちゅっ。また精液が溜まって\nしまったんですね？　出したいですか？　また出してしまうんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「私によぉおおっく見えるように、腰を上げて……。あぁっ♪　なんてみっと\nもない格好ですか、素敵ですよ。イきたいんですね♪　じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ええ、ええ♪　イかせてさしあげます！　最大の威力でシゴき、舐めあげま\nすよ！　……ん、くちゅっ！　ぴちゃっ、ぴちゃ、れろれろれろれろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203220" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んふぅうううっ♪　あぁああっ……♪　言われた通りにお行儀よく、チンポ\nからビュービュー精液発射して♪　偉いですわね、最高ですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203301" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「はい、びゅっびゅっ♪　びゅっびゅっびゅぅっ……♪　まぁ……♪　先ほど\n射精した精液の上に、新しい精液が重なって卑猥ですわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203302" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「んんっ……。２回目の射精だというのに、大量に精子を打ち出せるこのチン\nポ……♪　私が認めただけはありますわ、感心してしまいました！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203303" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「……びゅっびゅっ♪　びゅっびゅっ……♪　っぅ……♪　ムワッと香るこの\nオスの香り……。こんなものをもし、胎内に打ち込まれたら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203304" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「どんな女でも絶対に孕んでしまうでしょうね。力強いチンポから放たれる、\n真っ白で優秀な子種……。はぁ、はぁ、貴方の射精の瞬間を」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「こんな至近距離で見られて私、興奮してしまいますっ……♪　ああっ、トロ\nトロの美味しそうな精液……。たっくさん出していただけましたね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「はぁああ……♪　良かった。ハイパースーツの実力を、たっぷりと調査する\nことができました……♪　隊長様の献身的な協力のおかげですわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203307" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「せっかく、大切なクリスタルを消費して起動するスーツですもの。世のため\n、人のため……隊長様のために役立てなくてはもったいありません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「……想定よりもはるかにお役にたてたようで、こちらまで嬉しくなってしま\nいます♪　今日得たデータはコンツェルンで活用させていただき……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「え？　もちろん、持ち帰りますよ？　いいじゃないですか。隊長様の恥ずか\nしい記録、皆様にも見ていただきましょうね……♪　フフフフ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203310" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「あ、んっ♪　すごいっ……！　すごいですわ、飛んでますっ♪　とんでもな\nい勢いで、隊長様のお顔にまで精液が飛び散ってますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203401" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「あっあっ♪　私の手のひらに、脈打つチンポの感覚が……♪　あぁ……♪　\nこんなにチンポを熱くして、大量に精液を吐き出して……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203402" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「フフフフ、ご自身の精液をご自分で浴びている気分はいかがです？　いやら\nしい隊長様……♪　まるで女の子のように気持ち良さそうな顔をして」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203403" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「ビューッ、ビュルッ、ビュクッと何度も射精してしまうんですね♪　可愛い\nですわ……♪　ええ、どんどん出してくださいませ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「あっ♪　ほとばしる白濁液の美しさ……。クリスタルにも匹敵しますわ♪　\nそうです、限界まで出して……私を喜ばせてくださいっ、あんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「粘り気のあるジェルのような精液に、彩られた隊長様のお顔……♪　はぁ、\nはぁっ、私、一生忘れられそうにありませんわ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「……ようやくチンポが落ち着きましたか？　フフ、いいのですよ。これだけ\n出せば、疲れてしまうのも仕方ありませんもの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203407" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「どうぞ、ごゆっくりお休みください……。強引に、一方的な攻めでスーツの\nデータを取らせていただいて、申し訳ないと思っておりましたが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「……隊長様も、思った以上に楽しんでくださったようですから♪　今回の報\n酬には充分ですよね？　え？　まだ足りない？　あら……フフフ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203409" ]},
		{"command":[ "SETIMAGE", "0", "still_00007202_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミス・パープル" ]},
		{"command":[ "SETTEXT", "「それでは定期的に、データ取得させてもらいましょう。そうですよ？　私が\nこのスーツで、いくらでも射精させてさしあげますわ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_072_0203410" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SPOTCHARA", "0", "1", "2", "3"]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETCHARA", "0", "char_00002508_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "SETTEXT", "「ああ、来たね。今日もご苦労だったね。なにしろ男はお前一人だ、色んな\n　気苦労もあるだろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804101" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETCHARA", "0", "char_00002508_01", "3", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「ん？　なんだいその顔は……珍しく私が優しい、だって？　私だって、いつ\n　もいつも厳しいわけじゃないさ。必要だからそうしているだけで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETCHARA", "0", "char_00002508_01", "6", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「まあ、いいさ。そういう話をしたいわけじゃない。そうじゃなくて、今日は\n　お前をねぎらいたいと思ってね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「何をしてくれるのかって……それは分かってるんだろう？　ここに呼び出さ\n　れた時点で、それがどういう方法かは……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804104" ]},
		{"command":[ "WAITINPUT" ]},

		
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "SETTEXT", "「ほら、今日は私が下になってやろう。お前が自由に入れて、動いていいんだ\n　よ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ふふ、怪訝な顔をしているね。別になにも企んじゃいない。私だって、お前\n　に愛されたいのさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_02" ]},
		{"command":[ "SETTEXT", "「ほら、いつまでも女に恥をかかせるじゃないよ。お前のその立派なチンポを\n　私に入れてくれ……んうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_05" ]},
		{"command":[ "SETTEXT", "「んっ……ふっ、入って、来たね。自由に動いていいんだよ、んっ、うっ、は\n　っ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804108" ]},
		{"command":[ "WAITINPUT" ]},


		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev025_08b_0000", "ev025_08b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「ふうううっ、やはり、気持ちいいねぇ、お前のチンポは。んくっ、ふうっ、\n　私の中を、遠慮なくごりごりとこすっていく……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んふうっ、普段はどこか抜けているのに、こういうときは逞しくて、強くて、\n　硬くて……んっ、あっ、はっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「もっと、もっと突いておくれ……んんっ、ふっ……そう、そうだ……いいよ、\n　気持ちいい……ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「お前のチンポがごつごつと私の中を叩いて、んっ、こすって……ふふ、その\n　顔もいい……気持ちよさそうな顔……ふっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そんな顔で見られると、ぞくぞくしてくる……あうっ、くっ……んっ、本当\n　に気持ちいいねぇ、お前のチンポ……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「身体の中が熱くなってくる……ふうっ、うっ、んっ……それじゃ、されてば\n　かりじゃ不公平だから、私も気持ちよくしてやろう……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ふふ、どうしたんだい、急に顔を歪めて……んっ、ふっ、私はちょっとお腹\n　に力を入れただけだぞ？　こんな風に、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ほら、腰が止まってるよ。動かしておくれ。二人で気持ちよくなろう。ほら\n　？　私もお前を気持ちよくしてやるから。んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「気持ちいいだろう？　お前のチンポに私のオマンコが吸いついて、揉みこむ\n　ように動いてるのが中で分かるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、その顔を見れば気持ちよさが伝わってくる……はっ、あっ、腰\n　も動いているし……ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「もっとだ。もっと気持ちよくなろう。私のオマンコと、お前のチンポで……\n　ほら、もっと、もっとだ。もっと！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、はっ、ああああっ、んっ、そう、そうだ！！　ほら、私も中を\n　こうして……んっ、締めつけたら、ほらっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「また違う良さがあるだろう……んっ、こら、喋ってる途中で奥を、ふううう\n　っ、悪い男だね、お前は、あっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「まったく、悪戯っこにはオマンコでお仕置きだよ。ほら、こうすればうねっ\n　て……ふうっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ははっ、中でチンポが跳ねてるのが分かるよ。それでこうやって締めつけれ\n　ば……んんっ、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「中でチンポが溶けるみたいだろう？　お前の顔も、どろどろに蕩けてるじゃ\n　ないか、ふふふっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「それにこれは、私も気持ちよくてね……お前のチンポの亀頭、カリ首、竿、\n　全部の形がオマンコに伝わってくる……ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「それで腰を動かされたら、あっ、うっ、んんっ、んくっ、はっ、こんな風に、\n　甘い声が出てしまう……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「それにオマンコの中もじゅくじゅくになってるの、分かるだろう？　お前の\n　チンポを抱きしめて、こんな風になっているのが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ふううううううっ、私の顔も肌も赤くなって、んっ、あっ、気持ちいい……\n　お前とのセックスが気持ちいい、んっ、あうっ、はっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「もっとだ。もっと動いて、あっ、うっ、あっあっあっ、んっ！！　身体の奥、\n　お腹の一番奥が、チンポで溶かされてる……んくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ほら、もっと突いておくれ。私の中を、奥を……あうっ、んっ、くっ！！\n　私も、お前のチンポを抱きしめてやるから……はっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「あああっ、ああっ、いい！！　やっぱりいい！！　お前とするのは、最高に\n　いいねぇ！！　んっ、ふうっ、はっ、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「お前にも最高の快感を味わわせてやる、んっ、くっ……オマンコ全体で、こ\n　うやって締め上げれば……ふうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ははっ、ほら、チンポが逃げられなくなるほど密着しながら動いたら、最高\n　だろう。お前の顔、ぐちゃぐちゃに蕩けてるよ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「イくのかい？　私の中で、チンポイって精液を出すのかい？　いいよ、我慢\n　しなくていい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「私の中に、お前の気持ちいいの、全部出せ……出せ……出しちまえ……チン\n　ポイっちまいなっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804135" ]},
		{"command":[ "WAITINPUT" ]},

	
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_09" ]},
		{"command":[ "SETTEXT", "「ふうううううううううっ！！　ふふっ、この熱くて粘ついた感触……たまら\n　ないね……オマンコが火傷しそうだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_08" ]},
		{"command":[ "SETTEXT", "「ふっ、うっ……こうしてオマンコで揉みこんで、最後の一滴まで……私の中\n　に出せ……んっ、はっ……ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_09" ]},
		{"command":[ "SETTEXT", "「んっ……奥までお前の精液を注がれて……んっ、正妻の特権だね、これは…\n　…ふふっ、お腹がどろどろになってる……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_08" ]},
		{"command":[ "SETTEXT", "「中でチンポが何度も震えて……遠慮するんじゃないよ、全部出しな。お前の\n　気持ちいいの、全部出せ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「私にこんなことができるのはお前だけだからね……好きに出せ……ふふふっ、\n　可愛い奴だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_07" ]},
		{"command":[ "SETTEXT", "「んっ……全部出たかい？　顔が落ち着いてきたね……でも、チンポの方はま\n　だまだ元気のようだね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ふふ……もう一回したいかい？　いいだろう。お前が満足するまで、何回だ\n　って付き合ってやるよ。ほら、オマンコも締めつけてやる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804202" ]},
		{"command":[ "WAITINPUT" ]},



		
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev025_08b_0000", "ev025_08b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、そう、そうだ！！　また腰を動かしな……私も、中をこうして\n　……んっ、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「さっき出した精液でぬるついて、また違うだろう？　ふうっ、うっ、私も、\n　お前のチンポの刺激が変わって……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「オマンコがうねってるの、チンポに伝わって、ふうううううっ、あっ、はっ、\n　んっ、ああっ、いい顔だ……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「下から見上げるお前の顔も、悪くない……ふっ、うっ、私を求めてるその顔\n　が……んっ、お腹の奥を熱くさせる……んうっ、はっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「でも、下になってても主導権は私だよ、ほら、こうやってさっきみたいにオ\n　マンコで吸いつけば……ふふっ、顔がまた蕩けてるじゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「いいんだよ、その顔で……私で気持ちよくなって、私を気持ちよくさせてお\n　くれ……んっ、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「気持ちいいだろう？　セックスの時ぐらい、なにも考えずに腰を動かせばい\n　いのさ。それが男と女なんだから、んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「この部屋においては、私とお前、ってことだね。ふふっ、だからいっぱい\n　いっぱい愛しておくれ、夫として……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「私も妻として、お前を愛する……あっ、うっ、んっ、動きが、激しく……\n　ふうっ、今ので興奮したのかい？　ふふっ、んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「だとしたら、嬉しいね。私の夫としての自覚が出てきたのだから、んっ、\n　あっ、あっあっあっ、調子に乗るんじゃないよ、この、んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「お前のチンポなんか、こうしてオマンコで抱きしめながら締めつけたら……\n　ほらっ、んっ、はあっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「びくびくして、また硬く熱くなってるよ……んふうっ、ふっ、私の中も、ど\n　ろどろになって……チンポとオマンコが……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「溶け合ってるみたいだ……ふうううっ、交わるってこういうことを言う\n　んだろうね……お前と私が、身体を重ねて、はあっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「繋がって、溶け合って……んっ、うっ、交わってる……男と女が、重なって\n　いる……ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そう考えたら、私の身体も熱くなって……はっ、ふっ……んんっ、分かるだ\n　ろう？　お前のチンポで、昂ぶってるのが、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「ああっ、あっ、いいっ、気持ちいい……中、ごしごしこすられて、ごりごり\n　突かれて、んっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「お前と繋がれて、気持ちいいっ！！　んっ、あっ、あああっ、あっ、チンポ、\n　震えてるよ、イくんだね、またイくんだね！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「私も、私もお前のチンポで、んっ、イく、イく、オマンコイっく、んあああ\n　あああああああああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_12" ]},
		{"command":[ "SETTEXT", "「ふうううううううっ！！　中に、また精液が追加で……あああっ、んっ、あ\n　んっ、あっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、んっ、お腹がごくごく精液を飲みこんでいる……はあっ、あっ、\n　んっ……熱い……んふうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_11" ]},
		{"command":[ "SETTEXT", "「くふうっ、んっ、どれだけ出すんだいお前は……孕んでもないのに、お腹が\n　膨らんじまいそうだ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「まあ、孕んでも構わないけれどね……いずれは子供をつくるんだから。早い\n　か遅いかだけの違い……ん、なんだいその顔は」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「私だってお前との……夫との子は欲しいに決まっているだろう。当然だよ。\n　お前との間にできた子ならば、可愛いだろうしね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_12" ]},
		{"command":[ "SETTEXT", "「んんっ、まだ出るのかいお前……今の言葉で興奮したと言われても、全く、\n　私は別に家庭を顧みない女じゃないってのに」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_11" ]},
		{"command":[ "SETTEXT", "「私が忙しくしてるのは、誰もがお前を狙っているからだよ。正妻は私で揺る\n　ぎないとしても、他との折衝とか、苦労があるんだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「そんなことも知らずに脳天気な顔をして……まあいい。そういうお前だから\n　こそ、私はお前と共に連れ添いたいと思ったのだからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_10" ]},
		{"command":[ "SETTEXT", "「まあしかし？　そういう風に誤解されていたのならば、これからはもっとも\n　っとこんな時間を作るべきだね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「なにしろお前は私の夫だからね。夫と愛しあうのは当然だ……だから、また\n　こんな風に……ね？　愛してるよ、我が夫よ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_15" ]},
		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「んっ、あっ、なぜチンポを抜く……んんっ、あっ、身体に……ふうううっ、\n　あっ、んっ、くううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「お前、マーキングのように……んっ、二回目なのに、こんなに……ふっ、あ\n　っ、ああっ、んっ、んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_14" ]},
		{"command":[ "SETTEXT", "「ふうううううっ！！　んっ……ふっ……ようやく収まったかい……全く、ず\n　いぶんと好きにぶっかけてくれたねぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「他の女にはこんな姿、見せられないよ……だが、それもまたいいか。お前だ\n　けしか見られない私の姿なんだからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_13" ]},
		{"command":[ "SETTEXT", "「ふふっ、量も濃さも匂いも格別だ……それだけ私で気持ちよくなったしるし\n　ということだね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_14" ]},
		{"command":[ "SETTEXT", "「全く、私の肌がお前の精液でぬるぬるじゃないか……んっ、またチンポを跳\n　ねさせて。これでまた興奮しているのかい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_13" ]},
		{"command":[ "SETTEXT", "「仕方のない奴だね……まあそれだけ私が魅力的だってことかねぇ。なら、許\n　してやるのも妻の度量だね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETTEXT", "「それにまあ、中に出されるのも良いけど、こうして身体にかけられるのも…\n　…悪くはないね。お前の独占欲が見えているみたいだからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_14" ]},
		{"command":[ "SETTEXT", "「お前のチンポで、精液で、私の中も外も染め上げたかったんだろう？　ふふ、\n　そういうのに付き合ってやるのも、私だからだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "クィン・テイル" ]},
		{"command":[ "SETIMAGE", "0", "still_00002508_02_13" ]},
		{"command":[ "SETTEXT", "「さて、風呂で身を清めようかね。当然、一緒に入るだろう？　私が手ずから\n　身体を洗ってやるよ。そういうのも、夫婦ならではだからね。ふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_025_0804410" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "LABEL", "END" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「いち、に、いち、に……ふぅうっ。もっと力いっぱい走らないと……！　い\nっち、に、いっち、に……。……あれっ？　あ、あなたは……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504101" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "5", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「お疲れ様です。ああ、私が１人でずっと走っていたから声をかけてくれたん\nですね。心配しないでください。たまに、こういう時があるんです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504102" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「私は運動が苦手ですが……その。走っている間は煩悩が散っていく気がして\n……。そうなんです、最近、じっとしていると身体が熱くて熱くって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504103" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……今までにもこういうことがあったのか、ですか？　あの時は、別の方法\nで解決しました。どうやってって……それ、聞いちゃいます？　ええっと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504104" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「結構衝撃的な解決方法だったんです。確かに煩悩は消し跳びましたけど、色\n々問題がある方法で。……あの日、私はいきなり後ろから襲われて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504105" ]},
		{"command":[ "SETCHARA", "0", "char_00001705_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「えっ！？　な、何をしてるんですか！？　こんな体勢……く、苦しいです！\n　というか不安定すぎて倒れますよ、あっ、あっ、あああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504106" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あ、足……！　足を両方持ち上げられたらっ、わ、私、自分で動けなくなっ\nちゃうんですけど！　……手押し車？　小さな時にやったことがあるような」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「２人組でする、体育の時間の運動ですよね？　どうしてそれを今？　……頼\nりがいのある委員長になるためには、もっと体力が必要？　そ、そうですが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「だから手押し車で体力を鍛えるべき……？　そう断言されるとそんな気もし\nます。けど、それならなぜ私は脱がされているのでしょうか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「人に見られるかもしれない、極限状態で露出する度胸？　普段しないポーズ\nを保ことで得られる持久力？　そしてパワーと体力が向上する？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「もっともらしいお言葉ですが、私、騙されてますよね？　……あ、ま、待っ\nてください！　あんまり前に進まないでください、このままだと！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ッはっ！？　あっ、ぅっ！？　うぅううううっ……！？　う、嘘ですよねっ\n！？　中に……オマンコにオチンチン入っちゃいましたよぉっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504112" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ……！　わ、私が前に進むと、あなたが腰を突き出して……はうぅうっ\n！？　あっ、くぅっ……！　どんどんオチンチンが奥に突き刺さります！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ……だめ、だめです、一番奥に入っちゃ……。っああああああっ！？　\nひぃいいっ♪　んぁあああっ！　変です、こんな格好でするなんてぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504114" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ！？　あっ、グラウンドで……あっ、地面に手をついて、も、持ち上げ\nられた下半身を犯されるなんて、そ、想像もしたことありませんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……やぁあっ♪　あうぅうっ！　す、進んでこないでくださいぃいっ！　わ\n、私が逃げる前に、……はひぃいっ！　オチンチンがねじこまれてぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504116" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ！　奥に、奥に当たります、かすめます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504117" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「それに、こんなヘンタイ的な行為をしているところを誰かに見られたら！　\n私、もう明日から生きていけません！　あっ、抜いて、抜いてくださぁい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……ふっ！？　くぅうううっ！　あうっ、んぁああっ！　んぅううっ！？　\nだ、め、逃げても逃げても……前に進んでも、追いかけてくる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504119" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「オチンチンっ！　抜こうとしてもすぐにずぶぅって入れられちゃう！　あっ\n！　腰をよじっても、すぐにオチンチンに追いつかれて、えぐられてっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「んぁあああっ！　オマンコおかしくなっちゃいます！　あっ！？　激しく突\nき上げないで、くださ……い！　ビクビク痙攣が止まりません！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504121" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「んっ！？　うっ、うぅっ！？　んぅううっ！？　もっと前に進め……って、\n無理ですよぉっ！　私が運動苦手なの、知ってるじゃないですかっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504122" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「それなのに……、ふぁっ！？　あうぅうっ！　オマンコ突いて、無理やり進\nませるなんて……。っくぁあっ♪　卑怯です、あっ、やっ、だめぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ち、違います！　濡らしてませんっ……あっ！　身体が勝手に反応している\nだけ、です！　あんっ！　私が感じているわけじゃ……あぁああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「やぁあっ！　こんなのっ、初めてです！　あぅっ！　うぅっ！　んぅううっ\n……んぁんんっ！　本当に体力はつきそうですけどぉおおっ、……あうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504125" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「そ、の前に私がどうにかなっちゃいます！　あんっ！　ヘンタイになっちゃ\nいますっ、お外でこんな下品なポーズで、あっあっ、オチンチン咥えこんで」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「っあぁあああああぁあああっ……！　ズッ、ズボズボオチンチンが出たり入\nったりしてるっ……！　あっ！？　前しか見えなく、てっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「いつ、何をされるか全然わからないですぅううっ……！？　あぁああッ！？\n　はげ、しすぎます、激しくて……んぁうううっ！？　あっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504128" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「オチンチン、今抜けそうに……！　って、む、無理やり押しこまないでくだ\nさいぃいっ！　んぁああっ！　ふ、深く入るっ、あぁああっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504129" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「は、ひっ！？　ひぃっ、あっ♪　んっ、おぉっ！？　おっ♪　んぉっ……う\nぁううううっ……！　身体が、揺れ、ます、休憩させてくださいぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504130" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「こんな、のぉっ……！　こんなエッチおかしいですぅっ！　お、おかしいの\nにっ……ふぁああっ！　奥を突かれると気持ちいいっ……やぁああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あ、うぅっ、んっ！？　うっ、うぅっ！？　んぅううっ！？　はひぃっ……\n！　ひぃんっ！　ひんっ、ひぃんっ……！　あっぁっあっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504132" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あ、あぁっ……！　オマンコの中でオチンチンが太くっ、なってきました！\n　あっ！？　それに、あなたの腰の動きもぉっ、は、早く……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504133" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あんっ！　んんっ！　イキそうなんですか……っ？　精液出ちゃいそうなん\nですか？　それならお腹に力をこめて……んん、いっち、に、いっち、にっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504134" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「精一杯オマンコを締めてっ……精液絞り出します！　あっ！　あっ、出して\nください、私の中に……遠慮しないでたくさん出して……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504135" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「うぁああああっ！？　あっ！？　あぅううっ♪　んぁあああっ……！　ほ、\n本当に、こんなポーズでも中に出せるんですねっ、あっ、す、すごいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504136" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_06" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はいっ、はいぃっ！　私は大丈夫、ですっ！　このままの体勢で平気ですか\nらっ……あああっ♪　気にせず射精を続けてくださいぃいいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「っああああっ……♪　はぁああっ、はぁっ、ああああっ♪　熱い精液がドク\nドクオマンコの奥に……し、子宮に注ぎこまれてきますぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「私の足っ……さ、支えていてくださいね……！　あっ！　オチンチンが震え\nるたびに……頭が真っ白になって、力が抜けちゃいますっ……あぁんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ま、前に進めなくなって……あっ！　あっ！　精液が流れこんでくるのをっ\n、う、受けとめるだけでいっぱいいっぱいですよぉおおっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はひぃいいっ……♪　ひぃっ……♪　はぁっ、はぁ、はぁ、はぁあ……！　\nあ、ありがとうございます、身体、持っていてくれて、助かります……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「す、すごい……。オマンコの中に精液がたっぷり詰まって、揺らしたらタプ\nタプいいそうです……。オチンチンが栓をしていてくれて良かった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504202" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「じゃないと、どろぉって逆流して溢れちゃいそうで……。はぁ、はぁ……。\nふふふ、頭に血がのぼって、ふわーっとした気分です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「私、あなたにオマンコの中に射精されるのが好きで……。って、あれっ？　\nあっ、あっ……？　な、なんでしょう、軽くイッちゃったからでしょうかぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504204" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「すっごく全身が熱くなってきて……はぁ、はぁ、快感のスイッチがオンにな\nっちゃった感じがします、……あっ？　な、何？　すごく気持ちいい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あ、あの……っ。もう少しで何かが掴めそうな気がします……！　だから、\nこの特訓を続けてみてもいいですか……？　お、お願いします……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「オマンコにオチンチン入れたまま……もう一度、手押し車させてください！\n　あっ……！　これです、この、ズンッズンッて突かれる感覚ぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504207" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「っああああっ♪　これっ……これ、気持ちいいです！　気持ちいいぃっ……\n！　あんっ、あんんっ！　もっと！　もっとしてくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あなたの精液でいっぱいのオマンコっ、ぐちゅぐちゅ硬いので、おっきいの\nで掻き回してくださいっ……！　あぁっ！　あぁんっ、はぁっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ……！　顔が熱いぃい！　汗かいちゃいます、オマンコ、どんどんキツ\nく締まって……！　あぁっ、イクっ……すぐイキますっ、ごめんなさい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504210" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、イッちゃ……あぁあっ！　ん、んんんっ……！　膝がっ、こ\n、腰もガクガクしてきちゃってます……あっ、げ、限界ですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「えっ！？　ま、まだイケる！？　そうですねっ、イクのはできますけどっ…\n…ま、前に進む体力がもうなくてっ……！　あっ！？　あぁうううっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504212" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「お、オチンチンで前に進ませるの、や、やめてくださいぃいっ！　あぅうっ\n！？　あっ！　じゅぶじゅぶ突くのだめ、です……だめ、だめぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504213" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「っあああああっ……！　イキますぅううっ！　あっ！　私のオマンコ、ぎゅ\nってオチンチンを捕まえちゃいました、あっ、キツくなった穴の奥っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ズンッ！　ずぶぅって突かれると……！　あっぁっ！　頭がクラクラします\n、はひぃっ！　進みます、進みますからぁっ！　あっ！　ううううんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ゆ、ゆるひてくだひゃいぃい……♪　き、気持ちいいんです、オチンチンで\nぐりぐりっ、奥をいじめられるとゾクゾクしちゃうんですぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504216" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あーっ♪　んんぁああっ♪　あっ、あぁっ！　オマンコビクビクしてっ、ヒ\nクついちゃって、はしたないです……！　恥ずかしいですぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504217" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はうぅうっ！　あっ、イクぅっ……！　あひっ♪　ひぃっ♪　ひぃんっ、ひ\nぃっ……♪　わがまま言っていいですかっ、一緒にイキたいですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504218" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「も、もうすぐっ、もうすぐ私、おっきくイッてしまうと思います！　だから\nっ……あぁっ♪　それに合わせて、オチンチンのお汁、精子ください！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ……！　はうぅっ♪　イキますっ……！　準備、してくだひゃ\nいぃっ！　あっ、イクっ……イカせてくださいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504220" ]},
		{"command":[ "WAITINPUT" ]},
								
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あひぃいいっ♪　イクぅううっ……！　ありがとうございます、精子出てま\nすぅうっ……！　あっ！　あっ、一番奥に出してくださいぃっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あひんっ♪　おっ♪　おぉっ♪　ひゅ、ひゅごい……！　オチンチン、痙攣\nしてるぅうっ……！　私にどんどん精液撃ちこんで、あっ！　あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ドロッドロの精子が２回もっ、私の中に……！　あっぁっあっあぁっ……！\n　あったかいです、安心します、もっとくださいぃっ……あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「い、いいですか！？　オチンチンっ、締めつけて精液絞り取ってしまってい\nいですか！？　……あっ♪　ああああっ、いっぱい出てます……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504304" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あうっ……♪　うぅうっ……！　お腹に力をこめて……あぁあっ……！　い\nいですよ、すごくたくさん……！　あっ、オマンコから溢れそう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「私まだ耐えられます、イケますっ……！　あぁっ♪　はい！　最後までっ…\n…お付き合いしますから、出せるだけ出してくださいぃいっ……！　あぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……はぁあっ、はぁっ、はぁ、はぁっ……！　も、も、もうダメです、体力\nが尽きました……！　ヘロヘロです、崩れちゃいます……っ」　", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「ゆ、ゆっくり下ろしてください……。って、……あぅっ！？　ご、ごめんな\nさい！　足、足がつっちゃいました！　下ろすの中止してください！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はーっ、はー、はー……。少し落ち着くまで、このままで……。ううう、せ\nっかく最後まで頑張ったのに……頼れる委員長になれた気がしません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「まだまだ特訓、しないといけませんね……。って、こんなエッチな特訓じゃ\nなくてですよ！　普通の特訓です、ほ、本当ですよ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504310" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……ひゃぁあっ！？　あぁっ！　い、いきなりオチンチン抜かないでくださ\nいっ、び、びっくりしましたぁっ……！　あぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「２回目は私の背中っ……あっ♪　お、お尻にかけるんですかっ……！？　中\nに……オマンコに出して欲しかったですけど、しょうがないですよね……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「はいっ、いいです、どこにかけてもらっても……！　で、でもっ、身体だけ\n支えていてくださいっ……もう力が入らなくて……！　っあうぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504403" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「いっぱいっ……精液がかかってます、どぴゅどぴゅって……っ♪　あぁあっ\n、強いオチンチンから、大量に白濁液が……あふぅううっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「目で見えないのに、わかりますっ……！　この量……っ、オマンコに出され\nていたら妊娠している量でした、……あっ！　ま、まだ出てるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「あぁあっ♪　あっ、あぁっ……！　グラウンドに落とさないようにっ、ぜ、\n全部私の身体にかけてください！　真っ白に染めて……あぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「……ふぅ、ふぅ、ふう……。や、やりましたぁ、私……体力づくり、がんば\nれました……！　これで少しは耐久力がついたと思っていいんですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「この調子で頑張れたら、すぐに素晴らしい委員長に……。って、えっ？　体\n力づくりは嘘？　体操着に興奮しただけ？　そ、そんなぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504408" ]},
		{"command":[ "SETIMAGE", "0", "still_00001705_02_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「騙されちゃいました……。で、でもっ、やらないよりやった方が一歩前進で\nきた気がします！　私は絶対に諦めませんよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "夜日楽" ]},
		{"command":[ "SETTEXT", "「なので……また、良さそうな方法が見つかったら教えてください。そしてい\nつか、頼れる委員長になってみせます……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_017_0504410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
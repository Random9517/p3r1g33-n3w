		{"command":[ "SETIMAGE", "0", "still_00031401_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んぅ……あっ、またびゅくって……♪　最後の一押しで……もう一回、オマ\nンコ……アクメしました……あふんっ、あっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……はふ……お疲れ様でした……んっ、やっと……オチンポも落\nち着いて来ましたね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はふ……あぁ、わたくしも、いつになく張り切ってしまいまして……かなり\n乱れた姿をお見せしたのではないかと……恥ずかしいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「その、これが本性と言われますと……少し困ってしまいますが……そうした\n一面もなくはないということで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「エッチなお姉さんは大好物なので問題ない……ふふっ、そのように言ってい\nただけますと、多少気持ちも楽になりますね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「好きか嫌いかで言えば……わたくしも、その嫌いな方ではありませんので…\n…また、お世話を掛けることもあるかも知れませんが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はい、その時は、またたっぷりとご奉仕させていただきたいと思いますから\n……今後ともよしなにしていただければ……♪」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「貴方の方はどうでしたか？　途中、わたくしもちょっとのめり込んでしまい\nまして……かなり乱れてしまったのがお恥ずかしいですが……」", "NORMAL" ]},

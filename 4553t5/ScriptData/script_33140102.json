{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「本日もお仕事お疲れ様でした。いろいろと動いていただいて、本当に大変だ\nったかと思います」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00031401_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]}, 
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「これくらいは慣れっこですか？　やはり、最前線で働かれている方というの\nは素晴らしいですね……尊敬致します」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00031401_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「それで……そのねぎらいというのは、おこがましいかも知れませんが……わ\nたくしにも、お手伝いできることはないかと思いまして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104103" ]},
		{"command":[ "SETCHARA", "0", "char_00031401_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「もちろん、皆様には一通り感謝のお言葉はお伝えしています。それとは別に\n、貴方にはもっと直接お気持ちを伝えたくて……えいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104104" ]},
		{"command":[ "SETCHARA", "0", "char_00031401_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んふふ……こんなはしたないとお思いにならないで下さいね……と言っても\n、難しいですわよね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104105" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「以前は、偶然転んでしまいましたが……今度は偶然大事な場所が……近くに\n触れ合ってしまいました……どうしましょう……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あら……ふふっ、ちゃんと元気になってくださったみたいで……嬉しいです\nわ。わたくしだけが空回りするのは寂しいですもの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「でも、こんなに立派にオチンチンを膨らませていただいたなら……しっかり\nと準備を整えて……お気持ちを伝えませんと……ね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んっ、ほら……ご覧になりますか……？　わたくしの……スリットの隙間…\n…今日は、最初から……そのつもりで穿いていませんでしたの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104109" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「ですから……期待して、愛液が垂れてしまうのが心配で……はぁん……でも\n、もう隠せません……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「こうして、スリスリ……オチンチンを撫でてあげると……くすぐったさと…\n…ほのかな気持ちよさで……また濡れてしまいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「オチンチンも、いつの間にかすっかり待ち切れないご様子……あまり焦らし\nても申し訳ありませんし……挿入させていただきますね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104112" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あっ、んんんんぅぅぅーっ……はぁぁぁんっ……あぁっ、太いオチンチン…\n…いただき……ますぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んんっ、ふっ、はぁぁぁ……あぁ……改めて中へ入れると……その大きさを\n実感致します……オマンコが内側から広がる感じが致します……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、粘膜が……ずっと……お肉に擦れ続けて……お腹の内側がと\nっても熱いです……んふっ、本当にご立派です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「もしよろしければ、最初はわたくしにお任せいただいてもよろしいですか？\n　はい……騎乗位になりましたから……腰を振らせていただきます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んっ、はっ、んふっ、あんっ、はっ、あんっ、はぁっ……最初は……軽い上\n下運動から……はっ、ふっ、んはっ、あんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あぁ……もう、中でぐちゅりと……まぐわいの音が響きます……オマンコか\nら全身に快感が行き渡って……顔が緩んでしまいますね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「いかがですか……？　強すぎるとか……物足りないとか、何でもおっしゃっ\nて下さいね。なるべく、いいように致しますので……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「今の感じがちょうどよろしいですか……？　ありがとうございます……では\n、引き続きこのまま、オマンコをお楽しみ下さいませ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「ふんっ、んふっ、はっ、あんっ、あぁ……おっぱいが気になりますか？　ふ\nふっ、目線がどうしても向いてしまいますね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「いえいえ、殿方であればごく自然な反応ですし、好ましい方からの視線は、\nむしろわたくしも興奮を増す燃料になりますから……あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「よろしければ、どうぞ触っていただいても……あっ、あひっ……！　あっ、\n乳首も……しこっているのが丸見えですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104123" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、んふんっ……ええ、今は……このおっぱいも、貴方のモノで\nす……後は、ちょっと身を乗り出して……んちゅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んっふ……りゅぷっ、わたくしの唇も……お好きになさって……今のわたく\nしは……身も心も、全て……貴方のために存在しております……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はい……もっと、しますね……んっ、いやらしく腰を回して……オマンコを\n隅々まで味わっていただきますから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104126" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「うんっ、んっ、はぁっ、ゆっくりと腰を持ち上げて……絡んだお汁を……纏\nわりつかせて……また腰を落として……あぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104127" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁんっ……いかがですか……？　オチンチンが大きいので……ちゃんと馴\n染むまで……ペースを上げられませんが……あっ、んっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「それでも……んっ、じわじわ……快感が蓄積されて……オマンコとオチンチ\nンが一つになっていく感じが……します……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「気持ちいいですか……はい……わたくしも、今……とってもオチンチンが気\n持ちよくて……どうにかなってしまいそうです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104130" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「今まで、ずっとこのオチンチンで……多くの女性を惑わせて来たのではあり\nませんか……？　そして、わたくしも……その一人に……あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ……あっ、急に……下から……あっ、あぉっ、突き上げっ……\nあひぉっ！　子宮に……こつんって来て……ますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁぁっ、効くっ……！　そこはっ、わたくしの……勘所っ……！　メスの\n本能が呼び覚まされる、オマンコっ……弱いとこぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あぁっ、亀頭でっ、そんなに……グリグリされたらっ！　あっという間にっ\n……達してっ、しまいますからっ、あひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、あぁっ……出したがりにっ……はいっ、出してっ、大丈夫で\nすっ……オマンコで受け止める準備出来ていますからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104135" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「中に下さいませっ……！　貴方の子種っ……神聖なザーメンっ……直接子宮\nに届けて下さいませぇっ、あひぃぃぃんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「ふぁぁぁぁぁっ……あぁっ、打ち付けられていますっ……！　精液……オマ\nンコっ……出されておりますぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁ……ゾクゾクしますっ……わたくしの絶頂オマンコが……白濁に浸\nされてぇ……気持ち……いいです……んへぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あふぁ……あぁ……中がいっぱいです……少し動くだけで漏れて来ちゃいそ\nうです……はぁ……んっ、逞しい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んっふ……オチンチン……素敵でした……わたくしの方が、悦びを与えてい\nただいた気分です……はふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104140" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……んっ、あぁ……まだオチンチン……中で、ずっと硬いです\n……一回では終わらないという強い意志を感じます……あっ、おっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「今度は……最初から、積極的に腰を……突き上げっ……承知しました……そ\nれでは、わたくしも……そのつもりで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「ふふっ、ここからは……二人の共同作業で……お互いのいやらしい気持ちを\n育んで参りましょう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104203" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あんっ、はぁっ、おんっ……まず……この中出しで……ヌルヌルのオマンコ\nをもっと……馴染ませます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104204" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んふっ、先端の亀頭部分だけでなく……幹全体が……しっかり、わたくしの\n膣道に……当たるように……くいくいと……回してぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はふっ、いかがですか……？　あぁっ……とってもいやらしい眺めぇ……♪\n　濡れたオマンコから……オチンチンが顔を出したり戻ったりぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「隠しておかなければならない股間を……こんなにくぱっと開いて……見せつ\nけるように、腰を振るなんてぇ……あはぁん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あぁっ、おっぱいも……んっ、上下するたびに……揺れます……たぷん、た\nぷんって……ここでもエッチな眺め……見せちゃってます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104208" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んふぅ……修道服を着てはおりますが……わたくし……魔女としての側面も\n持っておりますので……こんな魔力供給もありなのです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「もちろん、ただいただくだけでは申し訳ありませんから……少しでも、お楽\nしみいただけるように……はんっ、オマンコを始めとして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「んっ、ちゅぷっ……唇でも、おっぱいでも……全身くまなく使って……気持\nちよくなっていただく……それが一番大事なことだと考えています……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、あんっ、あひっ！　ふふっ、ご理解いただけて嬉しいです…\n…んっ、ですから、遠慮なく……オマンコを責めて下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104212" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「欲しがりになった淫乱魔女のオマンコは……どんなオチンチン責めも、悦ん\nで味わってしまいますからっ……はぁっ、あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あぁっ、乳首を……指でカリカリ引っ掻かれながらの、突き上げオチンチン\nっ……！　こんなの……あぁっ、冷静でいられませんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁんっ……もっと、下さいっ……オチンチンっ、あぁっ、はいっ、オチン\nポっ、チンポですっ！　もっとオマンコでチンポしてぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104215" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「あぁっ……わたくしの本性が、このぶっといチンポであらわにされていきま\nすっ！　はぁんっ、だって……気持ちいいんですっ、チンポいいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あんっ、あぁっ……あなたもっ……感じて下さいますかっ？　わた\nくしのオマンコのヒダ……隅々まで味わっていただけてますかっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「このつるんとした亀頭が……何度も皮を捲り返してっ、新しいお汁を出した\nがって、ビクビクさせてぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、出ますかっ……！？　わたくしもっ、あぁっ……このままっ\n、絶頂してっ、オチンポ締め付けますからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104219" ]},
		{"command":[ "SETIMAGE", "0", "still_00031401_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "パンドーラ" ]},
		{"command":[ "SETTEXT", "「どうかっ、出して下さいっ……！　熱いザーメンっ、わたくしの奥に……も\nう一回射精なさってぇぇぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_314_0104220" ]},

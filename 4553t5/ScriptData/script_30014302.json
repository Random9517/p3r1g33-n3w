{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_01" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……見えるか？　貴様の中途半端なクンニのせいで、私のマンコはもう我慢\nの限界なんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304101" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私は必死にチンポを苛めて――ではなく、可愛がって貴様を気持ちよくして\nやったというのに……私は最後までイかせてもらえなかった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「寸止めプレイを食らったかの様なこの仕打ち、ひどいと思わんか？　マンコ\nは濡れ濡れの準備万端だというのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だったらやるべきことは、分かるよな？　人の身体をここまで乱した責任は\n取ってもらわないとなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304104" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……不甲斐ない貴様へのお仕置きだとか罰だとか、そういうのは、一旦忘れ\nろ。私の事、滅茶苦茶に愛せ。主人からの命令だぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――まったく、貴様はずるい。いつまで経ってもずるくてずるくて……ふふ\nっ、なんて愛おしい奴だろうな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「いいぞ、いつでも来てくれ。私のマンコは見ての通り準備万端だ。今度こそ\n、一緒に気持ちよくなってくれ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁあああっ……！　固くて、大きい、熱々チンポ入ってくるっ……あっ、\nんんぅんっ……！　そ、そうだ、これが欲しかったんだぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「す、すごい、だろぉ……？　私マンコ、すっかり蕩け切ってるから、こんな\nに簡単にチンポを呑み込んでしまうんだぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それにしてもっ……あっ、んぅんっ……さっきあれだけ出したのに、貴様の\nチンポは固いままなのだなっ……ふふっ、素晴らしいな……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「もうほんとに、我慢できない、からぁ……♪　トロトロマンコの膣内を、チ\nンポを使って掻きまわしてくれ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、あぁんんっ……！　そうだ、これを待っていたんだぁ……ん\nぁんんっ！　チンポでずぷずぽされるのを、ずっとっ、あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それっ、亀頭で子宮の入り口をノックされるのっ、いいっ！　あっ、ふあぁ\nんっ！　身体の芯まで響くように、もっとぉ……んぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「チンポが抜ける時も、エラでマンコの肉をガリガリって削っていってっ……\nんぅうんっ！　あっ、あはぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そこっ、おへその裏側の所、いっぱい撫でられるの、すきぃ……！　ひっ、\nあっ、んあぁんんっ！　全身痺れるぐらい気持ちよくてっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふふっ♪　軽く腰を揺すられただけでこの気持ちよさ……本当の勢いでマ\nンコをガン突きされたら、私、どうなってしまうんだろうな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、そうだ、それを貴様への罰とするのはどうだ？　不甲斐ない姿を忘\nれさせるほど、男らしい突き込みを見せてくれ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――そういうのは一旦忘れるんじゃないかって？　ふふっ、なに、あくまで\nスパイスと言う奴だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それっぽいシチュエーションがあった方が燃えるだろう？　お互いにな♪　\nだからほら……私が満足するまで、尽くして見せてくれ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁんっ！　ふふっ、来たっ、一気にチンポの動きが早くっ、あっ、あぁ\nんんっ！　マンコの膣内で大暴れしてるぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「すごい勢いで出たり入ったりしてっ、ひっ、あっ、ふぁんんっ！　愛液が全\n部かきだされそうでっ、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「えっちな音もどんどん大きくなってっ……んぁんんっ！　先走りと愛液が混\nざって、私のマンコ、白く泡だってっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが、この程度じゃまだまだ足りないぞ……！　もっと激しく愛してくれな\nいと、貴様の男らしさを認める訳にはいかないなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あひっ、あっ、んひゃぁんんっ！　そうだ、それでいいっ！　もっと腰の角\n度を付けて、私の弱い所いっぱい突いてっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「勢いつよ、すぎてぇ……！　んぁんんっ！　私のお腹、貴様のチンポの形で\nポッコリ膨らんでるぅ！　あっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、頑張ってくれているご褒美だ……んぅんっ！　ほら、私もマンコを\nぎゅーってしてやるからなっ！　貴様も一緒に気持ちよくなるんだぞっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、この体勢だと、貴様の顔がよく見えるな……なんてみっともなくて\n、情けない喘ぎ顔だ……だが、悪くない♪　あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんんっ！　わ、分かってる、そろそろ、だな？　私もだ\n、子宮がきゅんきゅんして、どんどん下りてきてるのが分かるんだ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「チンポを奥まで突き込まれる度に、亀頭に必死に吸い付いちゃってっ……あ\nっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「腰もビクビク震えて、跳ね上がってるっ……んぅんっ！　あっ、ひっ、ふあ\nぁんっ！　太腿も痙攣してぇ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私も最後までマンコを締め付ける、からぁ……あぁんんっ！　チンポももっ\nと激しくっ、頭が真っ白にるまで腰を振りたくってくれぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あひっ、あっ、ふあぁんんっ！　来たぁ、子宮の中にまでチンポが入っちゃ\nう勢いでっ、あぁんんっ！　マンコずぼずぼ、来たぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んひゃぁんっ！　チンポが膨れ上がってっ、んぅんんっ！　後ちょっと、も\nうイク、からぁ……！　今度こそ一緒にっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「分かっているなっ、出すのは膣内にだ！　私の子宮に向けて、熱々チンポミ\nルクをびゅーびゅーって射精してくれ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ！　あっ、ふあぁんっ！　イク、オマンコイクっ！　膣内出し\n射精でイクからっ！　イク、イクイク、イックううぅんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふあぁんんんっ～～！！　すごいぃ……！　チンポが震えて、ドクドクって\n精液注ぎ込まれてるのがはっきりわかるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_07" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、くぅぅんんっ……！　イク、またっ、んぅんんっ！　マンコがずっと\n痙攣してた、何度もイってっ、あっ、くぅんんっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うっ、あっ、あぁんんっ……！　射精中もチンポの動き、止まらないからぁ\n……！　ひっ、あっ、んあぁんんんっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……んんっ……まったく……一体どれだけ出したんだ……\nんんっ……精液が逆流して、しばらく止まりそうにないな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが……ふふっ、それだけ本気で愛してくれたのだな……貴様の事、男らし\nいと見直さないといけないかもしれないな……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、これだけだしてもまだチンポは固いままとは……貴様の絶倫ぶりに\nは恐れ入る」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「満足は……まだ出来ていないようだな？　続けたいか？　このまま私のマン\nコで、まだまだ気持ちよくなりたいか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――ふふっ、仕方ないな。貴様には罰として、男らしい所を見せてもらわな\nいといけないからな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だから、ほら……来てくれ、このまま頭が真っ白になるまで、二人で一緒に\n気持ちよくなろうではないか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、ぁんんっ……！　たっぷり膣内出しされたばかりだからな、\nチンポの滑りがさっきとは比べ物にならないなっ……んぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私だって、されるがままではないぞ。こうやって……んぅんっ……！　また\nこうして入り口をぎゅーって締めて、チンポを搾り取ってやる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、あぁんっ、あぁんんっ……！　さ、流石のこの体勢じゃ、私の方から\n激しく腰を動かすことはできないがっ……あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうしてっ、んんっ、あぁんんっ……！　ふふっ、軽く前後に揺するぐらい\nはできるぞっ……あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「チンポを突き込むたびにマンコに当たる場所が変わって……あぁんっ……！\n　貴様も気持ちいいだろうっ……あっ、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あぁんっ！　ふふっ、また情けなく喘ぐ顔を見せてみろ。そ\nれだけでマンコが奥がきゅんきゅんしてくる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「なんだ、照れているのか？　ふふふっ、苛め甲斐のある可愛いやつめ。それ\nでこそ私の下僕だ♪　あっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んひゃんっ！　な、なんだ、仕返しのつもりか？　あぁんっ、また、私の弱\nい所、入り口の近くの浅い部分をチンポで突かれてっ、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304212" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「気持ちいいっ、小刻みにじゅぼじゅぼされるの、気持ちよすぎてっ、ひっ、\nあっ、ふあぁんんんっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「い、イったっ、今イったっ……あひっ、あっ、んあぁんんっ！　んくっ、ん\nぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふ、ふふふっ、チンポを止める気はないんだなっ♪　あっ、ああぁんっ！　\nガチガチチンポでマンコの全てを掻きまわされるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「いいっ、それでこそだっ！　子宮口が嬉しそうにヒクついてるのが自分でも\n分かるっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「いいぞ、このままもっと激しく、滅茶苦茶に腰を振りたくってっ、あぁんん\nっ！　チンポをもっと大きくして、精液いっぱいぶちまけてくれぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あひっ、あっ、ふあぁんんっ！　来るっ、チンポがドクドクって脈打って、\n亀頭もヒクついてっ、くるぅうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふあぁんんっ！　あっあっ、あぁんんっ！　私もイクっ！　大きいのでイク\nからっ！　貴様の逞しいチンポでまたイクからぁ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「熱々ザーメン出してぇ！　男らしく射精してっ！　私の身も心もっ、全部を\n下僕の熱で染め上げてくれぇ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「イッくぅぅんんんっ～～～～っ！！　ま、またこんなにいっぱい、精液流れ\n込んできてぇ……！　あっ、ああっ、ああぁぁあっ～～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「亀頭がぴったり子宮にくっついてるからぁ……直接ドクドクってっ、んぅん\nんっ！　頭まっしろになっちゃうぐらいっ、気持ちいいっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こんな激しいの、久しぶりでっ……んくぅんんっ！　イクの止まらないっ！\n　途中でもあんなにイったのに、まだ波が来てっ！　んっくぅんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あひっ、あっ、あぁぁ……は、入りきらなかった精液が、マンコから逆流し\nちゃうのも、気持ちいいっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私から責めるのもいいが……んんっ……自分の身体を好き勝手に使われると\nいうのも、これはこれで悪くない♪　あっ、んぅんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……あっ……あっ……はぁ、はぁ、はぁ……流石にもう打ち止め、だ\nよな……？　どうだ、満足するまで出し切ったか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――ああ、私も満足だよ。ふふっ、貴様に色々言いたいことがあって呼び出\nしたはずなのに、結局普通に愛してもらうだけになってしまったな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが、貴様の男らしさは、しっかり見せてもらったぞ。……ふふっ、それを\n普段の戦闘でも発揮してくれれば、言うことなしなのだがな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――安心しろ、どれだけふがいない姿を見せようが、貴様には私が付いてい\nる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「みっともなく負けるようなら、今日の様にいつでも気合を入れ直してやる。\nだからこれからもよろしく頼むぞ、私の愛おしい下僕……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「イックうぅうんんっ！　あっ、ああぁっ、んあんんっ！　熱々のザーメンシ\nャワー……気持ちよくてっ、私、私ぃ……！　んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「全身精液塗れでっ……でも、これが気持ちよくてっ……んぅんっ！　また膣\n内にも出してほしかったけど、これはこれでっ、いいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304402" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「顔にまで精液が飛んでるから……すぅー、はぁー……あぁ……匂いだけでも\nイってしまいそうだっ……あっ、んぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「すごい、まだ出てる……チンポびくびく跳ねて……んぅんっ……ドロドロの\n精液が、私の肌をパックしていくみたいに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「精液が付いた場所……火傷しそうなほど熱くて……それだけでびりびりして\n……んぁんっ……気持ちいいっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……流石にもう出ないか……どうだ、満足するまで気も良くなれたか\n？　私の身体、堪能したか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――ふふっ、私も同じ気持ちだ。当初の予定とは色々ズレてしまったが……\nまぁ、これはこれで、悪くはないな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000143_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「貴様の男らしさもしっかり見せてもらったしな？　後はこれをこういう場以\n外でもはっきしてくれたら、言うことはないんだがな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4304408" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0098" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00022902_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev229_02b_0000", "ev229_02b_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「オレがヘンなヤツらに絡まれてるところを助けてくれたことについては、素\n直に嬉しいけどよぉ……あんなヤツら簡単に倒せるんだよなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204101" ]},
		{"command":[ "SETCHARA", "0", "char_00022902_01", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ってか、なんで逃げた先がホテルなんだよ。そもそもてめー……オレのこと\nスケバンサンダーだって気づいてなかっただろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204102" ]},
		{"command":[ "SETCHARA", "0", "char_00022902_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「でもまぁ、助けられたのは事実だしな。せっかくホテルにいることだし、迷\n惑かけた詫びにちょっと相手してやるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204103" ]},
		{"command":[ "SETCHARA", "0", "char_00022902_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「へへっ……相変わらずのデカチンだな。こんなのを受け止められるのは、オ\nレくらいだぜ？　んじゃ、さっそくセックスを……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204104" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「んっ？　挿れる前にいつもとは違う格好をしてる理由が知りたい？　あー…\n…ちょっと今、敵対組織に狙われてるんだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204105" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ほとぼりが冷めるまでこの星に避難してて……陸にあがる時は、いつもこの\n服装なんだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204106" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「まあ、てめーが普段の姿の方がいいっていうなら、そっちにしてやるが……\nなに？　せっかくだし、この格好でエッチしたいのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「もしかして、オレの格好が気に入ってるのか？　へへっ……てめーにそうい\nう趣味があるとはなぁ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「まっ、オレもこの格好は気に入ってるからな。興奮してくれるなら、嬉しい\n限りだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204109" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ほら……いつまでも無駄話してないで、さっさとエッチしようぜ。てめーの\nデカチン見てると、マンコが疼いて仕方ないんだよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204110" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁっ……た、隊長のチンポが入ってくる……！　くっ、あぐっ！　\nオレのマンコ、めちゃくちゃ拡げられてやがる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204111" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ぐぐっ、ふんぐっ！　マジででけぇ……反則すぎるだろ……！　あっ！　あ\nっ、あっ！？　ひゃ、あっ！　あはぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「うぅぅっ……お、奥まで届いてやがる……オレの大事なところに隊長のチン\nポの先っぽが当たってるぜ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204113" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「動いていいかって？　へへっ……これは詫びだからな。好きに動いていいん\nだぜ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204114" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「オレのマンコでチンポを擦って、気持ちよくなってくれ……んっ！　あっ…\n…あっ、あっ……ひあぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あんっ！　あんっ！　あっあっ、ふっ、はうぅっ！　隊長のが、出たり入っ\nたりしてやがる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204116" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev229_02b_0000", "ev229_02b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「マンコの肉を無理やり掻き分けられて……ひぐっ！？　ヒダがチンポに絡み\nついてるのを感じるぜ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「隊長のチンポを気持ちよくしようとグニグニうごめきながら、亀頭を舐めし\nゃぶってて……ひゃぐっ！　あっ、んぁっ！　はぐぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「マン汁が溢れてとまらねぇ……！　突かれるたびに、マンコ全体からにじみ\n出てやがる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ふっ、んぅっ！　あっ、うっ！　うぅぅっ！　やっぱてめーとのセックスは\n最高だ……！　心と身体が満たされていくぜ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「でもよ……今日のエッチは詫びなんだ。オレが気持ちよくなってちゃダメだ\nよな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「しっかり気合入れて、マンコを締めてやらねぇと……んっ！　ふぐぐっ！　\nうっ、あっ……ぐぐっ！　あぐぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「締めれば締めるほど、チンポの形がはっきりと分かる……！　オレのマンコ\n、どんどん隊長の形になってやがるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「こんなのまるで、オレがてめーの女になったみたいで……あんんっ！　あっ\n！？　な、なんで急に突く速度が上がって……！？　んひぃぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204124" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あんっ！　あんっ！　あっ、うぐっ！　ひんぎぃ～！？　バ、バカ野郎！　\nそんなに激しくしたら、オレのマンコが壊れちまうだろうが！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「な、なに？　オレのことが可愛いと思えてきて、腰が止まらなくなった？　\nな、なに言ってやがんだてめーは！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「てめーの女になったみたいって言われた時、ものすごく興奮したって……そ\n、そんなこと言うんじゃねぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「隊長は確かにいい男だし、チンポもデカくてかっこいいとは思うが……付き\n合うっていうのは、まだ早いっていうか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「セックスしてるのに、早いも遅いもない？　てめーの女だって認めるまで、\n犯しまくってやるって……お、犯すってお前……はひぃぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あぐっ！　ぐぐっ！　おっ、おぉぉっ！？　奥のところ、めちゃくちゃ突か\nれてやがる！　チンポでガン突きされてやがるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「こ、これ、ヤバい！　子宮口の周りを刺激されると、頭が真っ白になっちま\nう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「気持ちよすぎて意識が飛びそうになって……ひぎゅぅっ！？　おっ、おぉぉ\nっ！　こんなの、イッちまう！　マンコイクぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「はひっ！？　あっ、んぁっ！？　てめーのチンポ、急に膨らんで……！？　\nもしかして、てめーもイキそうなのか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204133" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「このまま膣内に出して、孕ませてやるって……！？　バカ野郎！　出すなら\n膣外に出せ！　赤ちゃんできちまうだろうが！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あっ！？　あっ、あっ！？　やめっ……膣内は本当に……！　で、できちま\nう……！　隊長との子供を孕んじまうぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「おぉ～～～っ！？　ほ、本当に出てやがる！　熱くてドロドロのザーメンが\n、子宮に注がれてぇ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204136" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_09" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「はひっ！？　ひっ、んぎっ！　膣内出し気持ちよすぎる！　この快感を味わ\nったら、もう戻れなくなっちまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あっ、んぁ、あっ！　イクッ！　イッてるのに、膣内出しの感覚でさらにイ\nクッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「おぉぉっ……おっ、ほぉぉっ！？　隊長もさらにイッてやがる！　こんなに\n出されたら、確実に孕んで……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「隊長との子供なんて、まだ早いのに……！　あぁぁぁっ！　オ、オレ、母親\nになっちまうぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ふぁ……はぁ、はぁ……んっ、ふぅぅぅぅっ……クソっ……こんなに出しや\nがって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204201" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「確かに、詫びをするって言ったのはオレだけどよ……本当に妊娠したらどう\nするつもりなんだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「その時はちゃんと責任を取ってやるだと？　へへっ……嬉しいこと言ってく\nれるじゃねぇか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ってか、こんなに出されたら、もう何回出されても一緒だよな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204204" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「その……隊長さえよければ、もっとしないか？　ザー汁まみれのマンコ、も\nう一回突きまくって……その……お、犯してくれ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「はひぃぃんっ！　あっ、おっ！　おぉっ！　いきなり全力でマンコ突かれて\n……！？　おぉっ、おほぉぉぉっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204206" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev229_02b_0000", "ev229_02b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「奥のところにズンズンくるっ！　隊長のカタくて太いチンポが、オレの大事\nなところに当たってやがるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「亀頭で子宮口をグイグイ押されて……ひゃうぅっ！？　ただ突くだけじゃな\nくて、腰を回しながら犯されてやがるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「子宮口を撫でまわすのは反則だろ！　そ、それ、キツい刺激と蕩ける刺激を\n同時に感じて……ふぁ、あっ、んぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「こんなのマンコがおかしくなる！　オレの赤ちゃんの部屋の入り口、ぽっか\nり開いちまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あんっ！　あんんっ！　開ききった子宮口を勢いよく突かれるの、本当にた\nまらねぇ！　身体中に電気が走ったみたいな感じがしやがる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「スケバンサンダーのオレが、こんな痺れるような刺激に負けるはずないのに\n……んんっ！　おっ、おぉぉっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ！　んぁぁっ！　こ、この電気的な刺激に抗えねぇ……頭ん中、\n真っ白になっちまう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「こんな感覚、本当に初めてだ！　ヤバすぎて、マンコも頭もイッちまいそう\nだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「んっ、あっ！　あっあっあっ！　ふっ、おっ！？　ぐぐっ、ひっぐっ！　お\nっ、おふっ！　んふぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204215" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ふーっ！　んふーっ！　や、やべぇ……また気持ちいいのがマンコから溢れ\nてきそうになってやがる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「もうイッちまう……！　もっとてめーのチンポを味わいたいのに、イカされ\nちまうぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あっ！？　ひっ、あっ！？　隊長のチンポがまた膨らんで……！　膣内でビ\nクビク跳ねまくってやがる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204218" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「てめーもイクんだな！？　またオレに向かって、ザーメン吐き出したいんだ\nな！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「いいぞ！　好きな時に、好きなところに出してくれ！　オレに隊長の精液、\n受け止めさせてくれぇぇぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204220" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「んっひぃぃ～っ！？　また膣内に出されてやがる！　隊長のザーメンが子宮\nに届いてぇ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204301" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あ、熱いっ！　びゅーびゅー出されまくるの、マジで気持ちよすぎる！　身\n体がおかしくなる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「幸せな気持ちが全身に広がって……あんっ！　あっ、んんっ！　イクの止ま\nらな……んぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204303" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あっ！　あっ、あっ！　子宮が悦んでやがる……！　もっと隊長の精液が欲\nしいってねだってるみたいだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204304" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ！　んっ、おぉぉっ！　意識飛んじまう……！　こんな感覚、初\nめてすぎるぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204305" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「はーっ……はーっ……んっ……はぁぁっ……ったく……てめーはホント、ベ\nッドの上だと容赦ねぇな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204306" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「喧嘩は弱いクセに……ベッドの上だとこんなに強ぇだなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ホント、隊長はすげぇヤツだよ……詫びのつもりが、すっかり手籠めにされ\nちまったな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あん？　なら今度はオレが動いて奉仕しろだって？　て、てめー、まだやる\n気なのかよ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204309" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ったく……あきれるくらいの性欲だな。とはいえ、まだ詫びも済んでねぇし\n……このまま付き合ってやるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204310" ]},
		{"command":[ "WAITINPUT" ]},

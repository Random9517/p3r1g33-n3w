		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「そんなの無理に決まってるだろ！　っていうか、てめーこそ組織のトップな\nんてやめて、オレの仲間になれってんだ！」", "NORMAL" ]},

		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「んほぉぉぉっ！？　おっ、おぉっ！？　熱い汁がこんなに……！　くっ！　\nあぐっ！　あぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204401" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_17" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「服や顔にかかって……こんなのマンコだけじゃなくて、全身にてめーの精子\nの匂いが染みついちまう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「こんなにも隊長の精液の匂いをまとわせてたら……誰だって、オレがお前の\n女なんだって思っちまうだろうが……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「で、でもよ……それもいいかなって思えてきて……あんっ！　んっ、あっ！\n　はっ、ぐっ！　うぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204404" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_18" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あっ、イクッ！　連続でアクメしちまう！　隊長の女になってるって思った\nら、何回だってイッちまうぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204405" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_19" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ふっ……はっ、はふっ……んっふぅぅぅっ……ヤバすぎるくらい感じちまっ\nたぜ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204406" ]},
		{"command":[ "SETIMAGE", "0", "still_00022902_02_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「ったく……スケバンサンダーもチンポの前じゃ形無しだな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「あん？　なら海賊なんてやめて、てめーと一緒に暮らすのはどうかって？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "スケバンサンダー" ]},
		{"command":[ "SETTEXT", "「そ、それって、プロポーズってヤツじゃ……！？　いや、その前にオレに海\n賊をやめろってか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_229_0204409" ]},

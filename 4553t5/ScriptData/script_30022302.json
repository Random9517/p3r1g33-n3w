		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETIMAGE", "0", "bg_0149" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふぅ……何を驚いてるの？　忍びにとって、縄抜けなんて初歩的な技よ。も\nちろん、普通に抜け出すのは大変だけどね」", "NORMAL" ]},

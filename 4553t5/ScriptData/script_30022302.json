		{"command":[ "SETCHARA", "0", "char_00000223_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「この恨み……はらさでおくべきか……ふっ……！　あ、あら……？　驚かせ\nすぎちゃった……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304310" ]},

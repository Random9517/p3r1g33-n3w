		{"command":[ "SETCHARA", "0", "char_00000223_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「このハロウィンの格好……幽霊をイメージしてるの……分かる？　あら……\nさっきまで強気だったのに、何でそんな怯えた表情になってるの？」", "NORMAL" ]},

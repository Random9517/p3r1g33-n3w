		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「むふぅぅぅぅぅんっ……！　んんっ……むぅぅっ、むぐっ、んふぅぅぅぅぅ\nぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ、また……中に来てるっ……濃いの……もう、中にいっぱいなのに…\n…続けて出されちゃってる……はひぃぃぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……気持ちいい……頭……真っ白になっちゃう……余計なことなにも\n考えられない位……気持ちいいの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……包帯にも染み込んじゃう……精液と……私の……えっちなお\n汁と汗……衣装にも滲んで……ダメになっちゃう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あ……終わった……の？　オチンチン……やっと動き……止まった……ふぁ\n……すごかったわね……でも、これで終わらせちゃダメよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「月影流忍法……四肢……柳風っ……ふんっ……！」", "NORMAL" ]},

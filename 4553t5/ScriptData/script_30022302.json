		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、でもっ……これは、もうちょっと待ったら……射精してくれて……も\nっと気持ちよくなって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「な、何考えてるの……こんな、強引にされてるのに……射精とか……期待し\nちゃってるなんて……お、おかしいのに……で、でも……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んふぅっ……はぁっ、も、もうここまで来たらっ、いっぱいイキたいっ！　\nまた中出しされてもっ、気持ちいいならいいからっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ、激しくなってるっ……！　スパートしてるのっ、分かるっ……来て\nっ、またオマンコっ、すごいのイカせてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304219" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁぁんっ、イクっ、イッちゃうのっ、ガチガチに縛られてっ、イクのっ…\n…オマンコっ……イクぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304220" ]},
		{"command":[ "WAITINPUT" ]},


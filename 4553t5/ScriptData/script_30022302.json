		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「どうしたの？　私が、ずっと縛られたままで終わらせておくと思った？　一\n応、様子を見ていただけよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304407" ]},

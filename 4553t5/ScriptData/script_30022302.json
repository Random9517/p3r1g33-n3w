		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「一応、気持ちよくしてもらったから……その部分については、不問にしてお\nくけど……好き放題にしてくれたことについては覚悟してるわよね？」", "NORMAL" ]},

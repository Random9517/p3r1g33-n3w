		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「こ、こらっ、んむっ……口の方まで、そんな……塞いで……んんっ……ふぐ\nっ、むふぅぅっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「準備が出来たって……どういうつもり……んっ！　あぁっ……やっ、包帯…\n…おっぱいのところだけ……開いちゃってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ……やだ……指……伸びてきて……んぅっ！　乳首……あっ、摘んで…\n…来てるっ……う、動けないのをいいことにっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「うむっ、ふむぅぅぅっ……むぐっ、んんっ、なっ、りっ……ふぃへっ……ん\nむぅっ、むふぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ダメ……声がうまく出せないっ……口の周りは特に念入りにされちゃってる\n……んむぅっ、むっ、ぐっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ……あぁ……やだ、身動きできないっていうだけで……何だか、いつ\nもより……感じやすくなってるみたい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「うぅっ……あっ、首筋とか……舐められてぇ……やだ……な、なんで……こ\nんな上手いの……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「私自身が……こんな、拘束されたことで……興奮しちゃってるってこと……\n？　あっ、何して……包帯のそこっ……切られて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「や、やだ……オマンコのとこだけ……くり抜かれたみたいになっちゃってる\n……！　こんな……は、恥ずかしい……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あっ……嘘……そんな、オチンチン……み、見せつけられてる……あんなに\n勃起して……あ、アレを入れるつもりなの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「な、馴染ませるって……んんっ……！　あっ、あぁっ、指が……中に、入っ\nて……来てるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……あっ、中っ……ゆっくり出し入れされてっ……やだっ、くちゅく\nちゅっ……音……しちゃってる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ……あぁ、受け入れ準備が出来たなんて……そんな一方的に言われて…\n…やだ、オチンチン……入ってきちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「むふぅっ、むぐっ、んっ、んんんーーっ、んっ、んーーーーーーーーーーー\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ……入って……来てるっ……！　オチンチン……オマンコの中に\n……めり込んで……来てるぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あっ……嘘……熱い……！　こんなに熱いのが……中に入ってきたらっ……\nんはぁっ……くぅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁぁ……動けない……がっちり包帯が……巻かれて……抵抗……出来ない\nっ……くぅっ……く、食い込むぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んぁっ……！　動き始めてる……あっ、あぁっ、オチンチンでっ……オマン\nコの中っ……ぐちゅってかき混ぜられてるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304124" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev002_23b_0000", "ev002_23b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ、あぁっ、さ、最初から……激しいっ……！　奥まで……届い\nてっ……また、入り口に戻されてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「オチンチンの硬いところっ……ぐって押し込まれて……んんっ、あぁっ……\nやだ、これ……気持ち……いい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「身体……動かせないのに……んっ、好き勝手に動かされてるのに……あぁっ\n、ちゃんと、私の……弱いところ……狙って来てる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ああっ……そこぉっ、絶対……知ってる……んっ、ビクって身体が跳ねちゃ\nうところって……バレちゃってる……んくぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「しかも、あっ、だんだん動きが速くなって来てる……あぁっ、オチンチンが\n……すごく滑って……こんなに……はひぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はっ、あぁっ……ダメ……ダメよ……こんなにされっぱなしなんて……ち\nゃんと、は、反撃……しなきゃ……けど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ……動こうとすると……ちょうど気持ちいいのが……ズンッて響いて\n……くぅっ、動けなくなるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁっ、しかも……あっ、どんどん速くなってて……あぁっ、このペース…\n…続けられたらっ、私……普通にイキそっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304132" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、間違いないっ……はっ、これぇ……ラストスパートっ……ああっ\n、出される前の……激しいやつっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「来るっ、来ちゃうっ……！　中にっ……オマンコに熱い精液っ……いっぱい\n出されちゃうのっ……あっ、あぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんんんーーーーっ！　むふぅっ、むぐっ……んんぅっ！　んむっ、んむぅ\nぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_09" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁぁ……出されてるっ……がんじがらめにされたまま……精液……いっぱ\nい中に出されちゃってる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ダメ……こんな……あっ、イってるのに……中出し良すぎて……はぁぁ……\n身体……すごく熱くなってるの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「包帯でぐるぐる巻きにされてるから……熱がこもって……あぁ、汗が滲んで\n来ちゃう……匂い……大丈夫かな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……でも、気持ちよかった……身体の自由が効かないことが、こ\nんな効果を呼ぶなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁ……あぁ……頭がどうにかなりそう……私……こんなに感じやすかった\nのね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ……！？　ちょ、ちょっと……ま、まだ続けるつもりなの？　あっ、や\nだ……また、オチンチン……動いて……あっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「抜かずに、そのまま……も、もう一回っ……？　そんな、今……まだ、イッ\nたばかりで……敏感なのに……ひぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304202" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev002_23b_0000", "ev002_23b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ……本当に、続けてされてるっ……んっ、イッたばかりのオマンコっ\n……ずりずりっ、混ぜられてるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「や、やだ……中で……すごい音しちゃってる……それに……オチンチンが…\n…前よりも膨らんでるような気がする……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ……や、やっぱりそう……んっ、襞が……亀頭と……擦れ合って……\n何度もグリグリ押し付けられてぇっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んくっ……うぅっ……あっ、もう少し右の方……気持ちいいとこっ、あとち\nょっと横っ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あっ、違う……んんっ、い、行き過ぎ……もう少し左っ……うぅっ、これ、\nわざと……ずらされてるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ちゃんと、私が一番気持ちいい場所知ってるくせに……絶妙にそこだけ避け\nてっ……はぁんっ、オチンチン……動かして来てっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ、そっちじゃないっ……こ、こっちだってば……んんっ！　あぁっ、\n自分から……オマンコの位置……ずらそうとしちゃってる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんんっ……！　あぁっ、そ、そうっ、そこっ……！　くひぃっ……あぁっ\n、いっぱいになってるっ……オチンチン深いのっ、届くっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、奥で……ズンズンされたままっ、おっぱいも……揉みくちゃ\nにされて……あくっ、うぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んぁっ！　すごいっ……さっきより、もっとムズムズしてっ……気持ちいい\nの……広がってるっ……おっぱい、すごくいいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ、やだ……いつの間にか……私……窮屈なまま……腰振ってるっ……\nオチンチン欲しくてっ、オマンコズリズリさせちゃってるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「だって……これ……気持ちいいからぁっ、欲しくなっちゃってるからっ……\nあぁ、動けないのが……気持ちいいのぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、あぁっ……太いのがっ、あぁっ、グリグリっ、もっと強くなっ\nてっ……またっ、イキたくなってるっ！」", "NORMAL" ]},

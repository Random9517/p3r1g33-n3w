		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ディティールがしっかりしていれば、驚かせる効果だって何倍にもなるの。\nだから、この形でいいのよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304103" ]},
		{"command":[ "SETCHARA", "0", "char_00000223_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「それにしても、かなり念入りにしてくれたわね……かなり窮屈になってきた\nかも。そろそろ、大丈夫……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304104" ]},
		{"command":[ "SETCHARA", "0", "char_00000223_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あっ、ちょっと……な、なにしてるのっ？　ど、どこ触って……ひゃっ……\n！　んっ、むっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304105" ]},
		{"command":[ "SETCHARA", "0", "char_00000223_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「か、格好がエッチって……、それは、貴方が変な感じにして脱がそうとする\nから……んっ、うむぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_01" ]},

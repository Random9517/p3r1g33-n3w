		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んぐぅぅぅっ！　んむっ、ふぐっ、んんんんんんーっ、んふっ、むぅぅぅぅ\nぅぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「嘘……今度は中じゃなくて……か、身体にっ……ぐるぐる巻きの包帯……着\n物にまで……あぁ、そんな……大事な衣装なのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁっ……でも、気持ちいいのが……まだずっと続いてっ……身体が……ビ\nクビクするの……止まらなくて……ま、またイクっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふぁぁ……やだ……まだ出てる……すごい……私で興奮して……こんなにド\nロドロにされちゃうんだ……あぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「お、終わった……のかしら……オチンチン落ち着いた……すごく、満足そう\nな顔してる……私も気持ちよかった……けど、これで終わりにはしないわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000223_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「月影流忍法……四肢……柳風っ……ふんっ……！」", "NORMAL" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「本格的って……それはそうよ。こういうのは、リアルさにこだわるからこそ\n、意味があるんだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2304102" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「すまないな。せっかくのハロウィンパーティーなのに、こうして息抜きに付\nき合ってもらってしまって……感謝する」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703101" ]},
		{"command":[ "SETCHARA", "0", "char_00000137_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「いや、疲れたとかではないのだが……ほら、衣装が衣装だろ？　色々と際ど\nいし、どうも落ち着かなくなってしまったというか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703102" ]},
		{"command":[ "SETCHARA", "0", "char_00000137_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「お、おい、あまりジロジロ見ないでくれ……お前の熱の籠った視線で見つめ\nられると、恥ずかしいというか、その……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703103" ]},
		{"command":[ "SETCHARA", "0", "char_00000137_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「うっ……わかった、私の負けだ素直になる……この恥ずかしい格好を大勢に\n見られたと思うと……こ、興奮してしまってな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703104" ]},
		{"command":[ "SETCHARA", "0", "char_00000137_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「し、仕方ないだろう……！　下半身なんてほとんど札一枚でオマンコ隠して\nいるようなものだし、変な気持ちにならない方がおかしいんだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「それに、色々言ってるがお前だって……ふふ、私の姿を見て、オチンポ固く\nしてるじゃないか。なぁ……ここだと他の誰もこないだろうし、いいよな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703106" ]},
		{"command":[ "SETCHARA", "0", "char_00000137_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「相変わらず、デカくて凶暴なオチンポだな……私のコスプレ姿、そんなに気\nに入ったのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「――そ、そうか、そんなに喜んでくれるのか。ふふっ、最初は恥ずかしかっ\nたが、勇気を出して着てみた甲斐があったよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「流石にひとけがないとはいえ、ここで本番をすると、誰かにバレてしまうか\nもしれないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「口で……そうだな、口でオチンポを舐めて……お前のことも気持ちよくして\n、お互い興奮を解消しようじゃないか……いいよな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「――ふふっ、では、始めるぞ……最初はよだれを垂らして……んじゅ……舌\nが滑りやすいように、オチンポに塗して……んれぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「唾液を垂らしただけで、早速オチンポが跳ね上がったな……お前も、私と同\nじぐらい興奮しれくれているんだな……んちゅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ちゅ、れろぉ……まずは、じっくりと亀頭にキスをして……ちゅ、んちゅ…\n…敏感な括れの所から舐めてやる……ちゅ、ちゅる、れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「汗が混じった、濃厚なオスの味……ちゅ、んれぇ……あっという間に我慢汁\nも溢れてきたな……ちゅ、んれぇるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「舌で絡めとって、逆にオチンポに塗り込むように……んちゅ、ちゅれ、れろ\nぉ……こら、腰を跳ねさせるな、舐めづらいだろう……んちゅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「分かっている、ここの……んれるぅ……皮の付け根の所を舌先で弄られるの\nが、いんだよな……じゅれっ、ちゅ、じゅれるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、ちゅれぇ……裏筋の部分も、しっかり舐めて……ちゅ、れる\n、れろぉ……浮き上がった血管に、舌を這わせて……れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「どうだ、私の舌の感触は？　お前のこと、気持ちよくできているか？　――\nまぁ、このオチンポの反応を見るに、聞くまでもないようだがな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「私の唾液とお前の先走りですっかりぐちょぐちょで……濃密な匂い……すぅ\nー、はぁー……、嗅ぐだけで……んんっ……興奮してしまう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「私のコスプレはキョンシー……まぁ大枠で言えば死体、ゾンビと同じ様なも\nのだ……それらしく、欲望のまま、人の肉を食らってみようか――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あむっ……んじゅる、れる、れろぉ……あむっ、あむあむっ、んちゅ、じゅ\nれるぅ……ふふっ、やはりお前のオチンポは、美味いな……んれぅう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んれる、じゅぶ、じゅれろぉ……ふふっ、情けない声が漏れてきた……んじ\nゅぶぅ……我慢なんて、するんじゃないぞっ……んじゅるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「頭を激しく動かしてっ……じゅぶ、ぐぼ、ぐぶじゅぼぉ……！　亀頭が蕩け\nるぐらい執拗に舐め回して、しゃぶってっ、じゅれる、れるれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んれる、れる、れるれろぉ……！　じゅぶる、れる、じゅれるぅ……！　じ\nゅるるぅ……！　じゅぶ、じゅぶれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……！　はぁ、はぁ……お前のオチンポを口いっぱいで味わうと、私\nの方も一気に来てっ、んぁんっ！　……ふふっ、少し、イってしまったよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「お前は……男のオチンポをしゃぶって感じてしまうような変態女は嫌いか？\n　――ふふっ、愚問だったか。……嬉しい事を言ってくれる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ああ、お前が望むのであれば、いくらでも。激しく舐めしゃぶってやるから\n、一緒に気持ちよくなろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あむっ――じゅ、じゅれる、れうれろぉ……！　唇を使って締め付けて、オ\nチンポを口で扱いてっ……じゅぶる、ぐぼ、ぐぶじゅぼぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あむっ、あむあむっ……！　ふふっ、唇で甘噛みしてやると、オチンポヒク\nヒクするなっ……あむっ、んじゅ、じゅ、じゅれるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「括れに唇が引っかかる様に、頭を振ってっ……ぐぼっ、じゅぶじゅぼぉ……\n！　また裏筋も下の腹で、ねっとり舐めてやる……んれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「腰も浮き上がってきたぞ……んれるぅ……恥ずかしい喘ぎ声が漏れないよう\nに、我慢しているのか？　可愛い奴め……じゅぶ、じゅれるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「我慢汁もどんどん溢れてっ……んくっ、んくっ……普通に飲むだけじゃ、追\nい付かない……ならっ……じゅぶ、じゅるるぅ、じゅぞぅぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ぷはぁ！　はぁ、はぁ……尿道に直接吸い付いて、飲み干すだけだ……あむ\n、じゅ、じゅぶる、じゅるぅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んんぅっ……先っぽの穴、ヒクついてきたな……じゅれる、れろぉ……！　\nいいぞ、このまま最後まで、イかせてやる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「じゅぶる、れる、れるれるれろぉ……！　ちゅ、ちゅれる、れろぉ……！　\nじゅぶるぅ、んじゅっ、じゅぶるぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ほら、出せ！　私の口の中に濃厚なザーメンミルクをたっぷり吐き出せ！　\n全部飲み干してやるから、遠慮なくぶちまけろ！　じゅるぅぅぅ～～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んっくぅぅぅっ～～～！　んぶ、じゅ、じゅれる……！　んくっ、んくっ、\nんくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},		
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「す、すごい量だ、飲んでも飲んでも、溢れてくるっ……んぶっ、じゅ、じゅ\nれるぅ……！　んくっ、んくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ねっとりしていた、熱くて、濃厚でっ……喉の奥にぶつかる感触が、気持ち\nいいっ……じゅれる、れろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「まだ、腰を引いちゃ駄目だからな……尿道の中に残ってる精液まで、全部飲\nみ干してやるっ……じゅぶる、じゅるるるぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……はぁ、はぁ……んっ……とりあえず、出した分は飲み切ったが…\n…オチンポは変わらず、固いままだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「お前が一回で物足りるとは思っていないさ。……このまま続けて口でしてや\nれるが、どうする？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……なに？　一回で満足できていないのは私の方だと？　精液を飲みながら\nイっていただろうって？　それは……ふふっ、まぁその通りだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ああ、そうだとも、この程度で満足など出来るモノか……もっとお前に奉仕\nをさせてくれ、オチンポを味わわせてくれ……んちゅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ちゅ、れる、れろぉ……全部飲み干したつもりではあったが、細かい所には\nまだザーメンミルクが残っているな……ちゅ、れるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「特にここ、ちゅれるぅ……皮の付け根の所、精液が溜まっていて……れる、\nちゅれろぉ……舌に乗るほど濃厚なザーメンミルク……んくっ、んくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「――よし、これで本当に綺麗になったな……んんっ……ふふ、改めてだが、\nお前の精液が胃に溜まっていると思うと、それだけで……んぁんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「オマンコが疼いて、また軽くいってしまったよ、ふふふっ……安心しろ、焦\nらしたりなんてしない……私にも、そんな余裕はない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「またオチンポ咥えるぞ。最初から激しくいくからな、あっという間に果てて\nしまわないように、気合を入れろよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あむっ……じゅ、じゅれる、れるれる、れろぉ……！　あれだけ出したとい\nうのに、さっきよりも大きいなっ……じゅぶ、じゅれるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「亀頭も蕩けるぐらいに熱くてっ、じゅぶ、じゅ、じゅれろぉ……口の中が、\n火傷してしまいそうだなっ……ぐぼ、ぐぶぐぼっ、じゅぶぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「いいぞ、もっと深くだな、喉の奥に亀頭をガンガンぶつける程、深くっ……\nんぐっ、ぐぼ、じゅ、じゅぶる、じゅぶるぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703212" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ごふっ、ごふっ……！　――だ、大丈夫だ、もっと深くいける……もっと激\nしくっ……！　じゅぶ、ぐぼぐぼっ、じゅぶるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……はぁ、はぁ、はぁ……んっ……あむっ、ちゅ、ちゅれるぅ……ま\nた、亀頭にも吸い付いてっ……じゅる、じゅるるぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「口の中でオチンポ、どんどん震えが大きくなってきたっ……お前の声も、余\n裕がなくなってきたなっ……じゅれる、れろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703215" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「分かってる、もう出したいんだよな？　私のフェラチオで、ザーメンミルク\nぶちまけたいんだよな？　でも、少しだけ我慢だ……じゅれるうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「我慢すればするだけ、出した時、気持ちいいぞっ……じゅれる、じゅぶる、\nれる、れるれろぉ……！　だから、限界まで我慢するんだ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「じゅぶる、れる、れるれろぉ……！　じゅれる、じゅるるぅぅっ……！　あ\nむっ、あむあむっ……じゅれる、じゅぞぞおぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ああっ、美味しい……お前のオチンポで、頭の中真っ白でっ……じゅれるぅ\n！　私も一緒にイクから、出してくれっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「オチンポ震えてっ、大きいの、来るっ……！　一気に吸い上げてやるから、\n全部出してしまえっ！　じゅぞぞっ、じゅるるうぅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703220" ]},
		{"command":[ "WAITINPUT" ]},
															
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んふうぅぅんんっ……！　ま、また、口の中いっぱいにザーメン出てっ……\nんぶっ、じゅ、じゅるるるっ、じゅぶるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んくっ、んくっ……！　んんんっ～～！　二回目だというのに。何て量だっ\n……じゅじゅ、じゅるぅぅ……！　んくっ、んくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁ……ドロドロのザーメンミルクが喉を流れ込んでいく感覚……んぅんっ\n……！　精液を飲むだけで、イってしまうっ、くぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「まだ、残ってるな……じゅぞぞ、じゅるぅぅぅっ……！　今度こそ、全部飲\nみ干してやるからなっ……んくっ、んくっ……んぅんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……はぁ、はぁ、はぁ……流石にもう、出ないよな……？　あぁ……\nでも、まだ少し、垂れてるのが残ってるな……んちゅ、れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……んっ、相変わらず、粘り気も濃さもすごいな……んっ……しっ\nかりと、堪能させてもらった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「それにしても、本当に大量に出したものだな……私の腹、お前のザーメンだ\nけで、タポタポになってしまったぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、なぜ謝る。それだけ私の奉仕に満足してくれたということだろう？\n　だったら、謝罪より礼の言葉を聞きたいものだがな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703308" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「――こちらこそ、お前のお陰で大分落ち着いた。そろそろ皆の所に戻るとす\nるか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、残念そうな顔をするな。お前が望むのであれば、この程度のコスプ\nレ、いつでもしてやるさ。……本番は次の機会に、な？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁぷぁっ……！　こ、今度は顔にっ……！　んっくうぅぅんっ……！　ぶ\nっ掛けされてるぅっ……！　あっ、んくうぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、口に出されるのもいいがっ……んぁんっ……！　こうして、ザーメ\nンを全身で受け止めるのも、気持ちよくっ……イっくぅう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「顔中、ドロドロの精液塗れで……んんっ……！　舌が伸びてしまう……んち\nゅ、ちゅれるぅ……！　はぁぁ……相変わらず濃厚な味だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅるっ……んぁっ……匂いも、すごくて……頭が揺れて、クラク\nラする……はぁ、はぁ……んぁんっ……ふふ、匂いだけでもイってしまうな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……ああ、もう終わりか……二発目も全て飲み干してやりたかったが\n……無遠慮にぶっかけられるのも、これはこれで悪くない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「全ては無理でも、少しはお掃除してやろう……んちゅ、れろっ、んれぇ……\nんくっ、んくっ……ちゅ、じゅれるぅ……んくっ……んくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「これでよし。……私の口は、どうだった？　心行くまで、満足することはで\nきたか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000137_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「私……？　ふふ、大満足に決まっているだろう？　……こんな行為で喜び、\n幸せを感じているなんて、私も変わったものだな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「――いや、いうほど悪い気分じゃないさ。自分を愛してくれる人がいるとい\nうのは、悪くない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……おい、どうしてまたチンポを固くしている？　まったく、お前という奴\nは……ふふ、いいぞ、お前が満足するまで、何度だって付き合ってやろう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3703410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
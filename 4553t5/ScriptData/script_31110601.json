		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「カツマちゃんの気持ちもぶつかってくる！！　私を愛してくれてる気持ちが\nぶつかってきてる！！　ふあああああっ！！」", "NORMAL" ]},

		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「定期チェックのお手伝い、ありがとうね。自己診断プログラムは走らせてる\nけど、どうしても一人だと手抜かりが出るから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603101" ]},
		{"command":[ "SETCHARA", "0", "char_00011106_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ん……そう、その合体の接続部分とか、入念にチェックしてね。目視だけじ\nゃなく、手による触診も……んっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603102" ]},
		{"command":[ "SETCHARA", "0", "char_00011106_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「そうそう、そうやって、軽く叩いて、感触とかも確かめて……あんっ、あっ\n、おっぱいも……そう……んっ、上手よ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「あんっ！！　強すぎるのはダメ。私の身体、女の人と同じで柔らかいんだか\nら……ね？　優しく、優しくよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603104" ]},
		{"command":[ "SETCHARA", "0", "char_00011106_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「そう……そうよ。うん、上手……あんっ、こんどはちょっと、気持ちよく…\n…んんっ、カツマちゃんも、興奮してるのね……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603105" ]},
		{"command":[ "SETCHARA", "0", "char_00011106_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ふふ……私の目は全てが見えるから……その、いいわよ。私の身体で興奮し\nてくれるのは嬉しいし……ほら、ズボンを脱いで」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「でも、二人のサイズが違うから入れるのは難しいけど……好きな場所を使っ\nていいからね。って、んっ、ちょっとくすぐったい、ひゃあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603107" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},		
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「あっ、ごめんなさい、ちょっとくすぐったくて驚いちゃって……大丈夫？　\n身体を動かしちゃったせいで、落ちそうになっちゃったわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603108" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ほら、手の上に乗って……って、これがいいの？　んっ、確かにこれ、おっ\nぱいにカツマちゃんのプラグが押しつけられて……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「気持ちいいけれど……あんっ、んっ、私のおっぱい全体でカツマちゃんを感\nじられて……んっ、あっ、なんだか切なくなってくる。んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603110" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「あんっ。腰、動かしたらカツマちゃんの硬い部分が押しつけられてくる……\nんっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「やあっ、あっ、そんな、ごりごりってしちゃ、あっ……ああっ、カツマちゃ\nんのプラグが私の乳首に……んんっ、あっ、はああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603112" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「あっ、入って、来た……んっ、そんな、乳首に挿入するなんて……ふああっ\n、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ああっ、これ、凄い……おっぱいがじんじんしてくる……んっ、はあっ、あ\nああっ、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「カツマちゃんも……気持ちよさそうな顔してるわ……私の乳首、気持ちいい\nのね……んっ、ふうっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603115" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「んふううっ、んっ、あっ、私の乳首でカツマちゃんのプラグが震えてるのが\n分かる……んっ、ふっ、本当は入れる場所じゃないのに……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「きゅっきゅって締めつけて、カツマちゃんのプラグの形までわかっちゃう…\n…ふううっ、んっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、凄い、腰、動かしたら……あっあっあっ！！　胸が切なくな\nってくる、んっ、ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603118" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「いいっ！！　気持ちいいわっ！！　んっ、はあああっ！！　プラグの先端が\n、こりこりって乳首を押し潰して……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ああっ、ぬるぬるしてきて……カツマちゃんの腰全体で乳首……刺激されて\nる、んっ、はっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603120" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「んんんっ、おっぱい、熱くなってきて……んっ、ふううっ、んっ、あっ、凄\nい……んっ、カツマちゃんの身体が……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「身体がくっついてるところ、全部熱くなってる……あんっ、あっ、こんなの\n、こんなの初めて……ふああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603122" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ああっ、あっ、動かされるたびに、おっぱいの先っぽからじんじんしてきて\n……んっ、カツマちゃんのことが凄く好きになって……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ねえ、もっと、もっとして！！　その腰を動かして、んっ私の乳首、もっと\nカツマちゃんのプラグでごりごりって、ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「あんっ、ああっ、あっ、そう、それ、その動き……あくうっ！！　んっ、気\n持ちいい……ふううっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603125" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「これ……好き、んっ！！　これ、メンテナンスに毎回入れて欲しいぐらい…\n…んっ、あっ、あああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「もちろん、メンテナンス要員はカツマちゃんだけよ……んっ、ああっ！！　\nあっ……んっ、乳首、入れられてるところが、挟んでる……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603127" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「カツマちゃんのプラグ、挟んでる……ふあああっ、あっ、こんなの、こんな\nの気持ちよすぎるっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「頭の中、オーバーヒートしちゃう！！　んんっ、あっ、はっ、あああああっ\n！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603129" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「カツマちゃんの身体も熱くなってるの、分かるわ……んっ、ふうううっ、ふ\nっ、んんっ、私のおっぱい、両手で掴んで……んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「全身で柔らかさを感じて……うううっ、いいのね、気持ちいいのね……んっ\n、ふうああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ああっ、あっ、なんだか、胸の奥が切なくなって……震えて……ああっ、あ\nっ、はっ、これ、これ、イきそう……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603132" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「おっぱいにプラグ入れられて、私、イきそう……んっ、あああっ、あっ、あ\nっ、腰、激しくしたら、ダメっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ダメ、ダメだったら、ああんっ！！　ひどい、ダメなのにっ、あんっ、んっ\n、そんな、そんなに動かされたら、私、本当に……ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603134" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「本当にイかされちゃう！！　おっぱいに入れられて、イかされちゃう、んん\nんっ、ああっ、あっ、イっく、イっく、おっぱいで、イっく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ふあああああああああああああああああっ！！　あああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603136" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「んううううっ！！　プラグからオイル、出てきた……あんっ、んっ、ふうう\nうっ！！　熱い……んっ、ふうううっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「凄い量……んっ、ふっ……おっぱいがぬるぬるになっちゃった……んっ、あ\nっ、まだ出てる……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603138" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ふうっ……んっ、気持ちよかったわ……カツマちゃんもよかったのね。うふ\nふ、この反応を見てれば分かるわ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603139" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「メンテナンスがこんなに気持ちいいなんて……んっ、素敵だったわ、カツマ\nちゃん」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「んっ……とはいえ、このままじゃダメね。身体も汚れちゃったし、一回プラ\nグを抜いて離れましょう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ……ね、ねえ、抜いて……ああああっ、抜いてって、んっ、あ\nんっ、言ってるのに、なんで、腰……動かして、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603202" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「えっ、抜こうとしてるけど、私の乳首が離してくれないなんて、そんな、あ\nっ、んっ、ふううっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「だって、動かされたら、気持ちよくて、先っぽが切なくてじんじんしちゃう\n……んっ、ああああっ、そんな思いっきり腰をひいたら、ひあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「乳首、引っ張られて……んっ、ふううっ、あんっ、あっ、抜けない、プラグ\n乳首から抜けないのっ！！　あんっ、ああっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603205" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「んふうううっ！！　それに、さっきのでおっぱいがぬるぬるして、それも…\n…んっ、あっ、あああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「刺激になって……んっ、カツマちゃんの全身がぴったりくっついてきてる…\n…んっ、ふうっ、ふっ、ふっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ね、ね、これ……もう一回、もう一回イって、出して……そうしたら、多分\n抜けるんじゃないかしら……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603208" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「ね、そうしましょう。そうしたほうが、気持ちよく……じゃないわ、安全に\n離れられそうだし……ね？　んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「そう、そう、腰、一杯動かして……んんっ、私の乳首、カツマちゃんのプラ\nグでこすって、押して、潰して……ふうううっ、んっ、あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「気持ちいい……また先端がじんじんして……ふうううっ、カツマちゃんのプ\nラグ、気持ちいいわっ、あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603211" ]},
		{"command":[ "SETIMAGE", "0", "still_00011106_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「素敵、素敵よカツマちゃん……あんっ、こんなに気持ちいいことしてるれる\nなんて、素敵っ！！　ふうっ、んっ、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ｍ.Ｏ.Ｅ" ]},
		{"command":[ "SETTEXT", "「また、全身が熱くなってきた……あっ、あくうっ、あっあっあっ、んっ、カ\nツマちゃんの身体全部がぶつかってきて……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_111_0603213" ]},

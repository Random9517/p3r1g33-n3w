		{"command":[ "SETIMAGE", "0", "still_00000149_02_15" ]},
		{"command":[ "SETTEXT", "「あんんんっ！！　オチンポが、抜けて……あうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_14" ]},
		{"command":[ "SETTEXT", "「ふうううっ、私の身体にザーメンがぶっかけられてる……んっ、ふっ、ああ\n　あああっ、熱い……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「あふうっ、私の肌が、あなたのザーメンでどろどろに……んっ、ふっ……は\n　あああっ、凄い……これも……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「これもマーキングだな……はっ、あっ、私が、あなたのものだという、はっ\n　きり分かるマーキングだ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_13" ]},
		{"command":[ "SETTEXT", "「ふううううっ、凄いなこれは……もう、一目見ただけで、私があなたの女だ\n　ということが伝わってくる……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「それに、量もたっぷりで……肌全部に塗りこめられてるみたいだ……んっ、\n　はっ……匂いも凄くて、くらくらしてしまうな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ、狩ったつもりが、教えこまれてしまったな……んっ、私が襲\n　ってたのに、チンポでマーキングされて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふ……ぬるぬると塗りこんで、んっ、肌に染みこんでるな……ほら、見て\n　くれ。あなたがつけたしるしだぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが、一回だけでは足りないかもな……これだけだと、すぐに消えてしまう\n　かもしれない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「だから……な。消えてしまわないように、誰でも分かるように、もっともっ\n　と……私にマーキングして欲しい。いいだろう、あなた？」", "NORMAL" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「……来たか。いや、間違いではない。私があなたをここに呼び出したのだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904101" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「電気を着けていないのは……その、ちょっと心の準備が。少しだけ、少しだ\n　け待ってくれ……すう……はあ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "3", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「よ……よし、電気を着けるぞ。その……驚かないでくれよ。いいか、着ける\n　ぞ……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904103" ]},
		{"command":[ "WAITINPUT" ]},

        {"command":[ "FADEIN", "FAST", "WHITE" ]},
        {"command":[ "SPOTCHARA", "0", "1", "2", "3"]},
        {"command":[ "FADEOUT", "NORMAL", "WHITE" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「っ！！　……どうだ？　その……この、格好は？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "1", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「なにって……色々あるだろう。その、似合ってるとか似合ってないとか、私\n　らしくないとか、そういうのが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "8", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「え……よく似合っている？　鍛えられた身体と、艶やかな肌に映えて綺麗だ\n　と……そ、そうか！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "8", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「そうか、そうか……ふふふふ、そうか！！　そう言ってくれるのなら、着た\n　意味があったというものだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "6", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「ふふ、私の心配など杞憂だったな……そういうことなら、存分に見てくれ。\n　あなたのために着てもいるからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "0", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「その、最初はネコ科の狩りをトレーニングに取り入れるために着たのだが…\n　…やってるうちに、あなたがどう思うかも知りたくなってな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "6", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「そこで、呼び出して見てもらったわけだ。気に入ってもらえてなによりだ。\n　ふふふ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "0", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「ん……視線を感じるぞ……女はそういうのに敏感だからな。あなたの視線が\n　どこに向いてるか、すぐに分かる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「それに……ふふ、興奮しているな。私の身体と、水着で。あなたの熱が届い\n　てきてるしそれになにより、股間が……な」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "6", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「隠すことはない。私もそういうつもりで、ここに呼んだのだ。最初はあなた\n　が気に入るかどうか不安だったが、この反応なら問題はない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETCHARA", "0", "char_00000149_01", "7", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「というわけで……ここからは私が主導権を握らせてもらおう。そらっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_04" ]},
		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、驚いた顔をしているな。ネコ科の狩りと言っただろう。今のあなた\n　は私の獲物だ。覚悟してもらうぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_05" ]},
		{"command":[ "SETTEXT", "「んっ、おいしそうな身体だ……興奮してくる。ほら、分かるだろう？　私の\n　身体が熱くなっているのが。あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_06" ]},
		{"command":[ "SETTEXT", "「あなたのオチンポも熱くなってる……ふふふ、では、狩らせてもらうぞ……\n　私の、オマンコで……んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、入って、来た……んっ、ふっ……あんっ、あっ、この体勢、下\n　から……んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev001_49b_0000", "ev001_49b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「下から奥まで突き上げられるっ、あっ、うっ、んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、下から、あなたのオチンポが中をぞりぞりって、こすりあげ\n　て……んんっ、ふっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ダメ……ダメだ、これは狩りだから、私が責めなければ……んっ、ふっ、だ\n　から、ほら、こうして、爪で……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、爪でかりかりしたら、顔が蕩けて来てるぞ。気持ちいいんだろう？\n　んっ、うっ、隠すことはない……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「このっ、んっ、今は私が狩る側だと、言ったろうに……んっ、そんな悪い獲\n　物にはこうだ、あー……んっ、むっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「んうっ、口からも、あなたの熱が伝わってくる、んっ、ふっ、ちゅっ……れ\n　ろっ、んっ、くっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ほら、あなたの肌に私の歯形が……これで、あなたが私の獲物だと一目で分\n　かるだろう……もっとつけてやろう、かぷっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、むっ、んんっ、んっ。ちゅっ……んっ、むっ.ふふふ、あなたの身体\n　が私のしるしだらけになったぞ……ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「中々これは、気持ちのいいものだな……んんっ、あっ、んっ、あんっ！！　\n　急に、なんだっ、あっ、くうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「んううううっ！！　やられっぱなしは嫌だって、んっ、ふううっ、あんっ、\n　あっ、オチンポが、ごりごりって、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふうっ、あっ、んっ！！　私だって、負けてはいない、んっ、こうして、締\n　めつけたら……ふっ、あっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっあっあっ！！　んっ、あんっ、私のオマンコと、あなたのオチンポが、\n　絡みあって……んっ、はっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「こうして、腰を動かすたびに、んっ、下からごりごりってこすられてっ、ん\n　っ、あああっ、はっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「私のオマンコが、ずっぷりと咥えこんでいるの、分かるだろう、ふうっ、う\n　っ、上から、オチンポをずぷずぷしてるの、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「はあっ、あっ、んっ、凄い、あなたを上から襲うって、気持ちいいっ、んあ\n　っ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「んんっ、私の中で、オチンポが膨らんで……んっ、うっ、イきたいんだな、\n　いいぞ、イっていいぞ。あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「私の中でイって、ザーメンびゅるびゅる吐き出してくれ……んっ、はあっ、\n　あっ、んっんっんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ほら、こうして腰を振りたくってる私の中に、中に出してくれっ、あなたの\n　ザーメン、気持ちいいしるし、出してくれっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「私も、んっ、あっ、あなたのオチンポで、あんっ、あっ、イく、イく、イっ\n　く、んふうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_09" ]},
		{"command":[ "SETTEXT", "「あああああああっ、イっくうううううううううううううううううううううう\n　っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_08" ]},
		{"command":[ "SETTEXT", "「ふああああっ、来てる、あなたのザーメン、私のオマンコにどくどく注がれ\n　てる……ふあああっ、あっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「んくううううっ！！　お腹の中、一杯に……はっ、あっ、オマンコが、ザー\n　メンごくごく飲みこんで……はっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_05" ]},
		{"command":[ "SETTEXT", "「んんっ……これは……いいな……あなたのこと、本当に襲って、獲物にして\n　いるみたいで……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev001_49b_0000", "ev001_49b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「ふふ、下から突き上げながら、私の中でびくびくって跳ねている……んっ、\n　私のオマンコが、あなたのオチンポを……くふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「食べたみたいな格好で……んっ、気持ちよかった……ふっ……うっ……んん\n　っ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「まだ……全然萎えていないな。二回戦……するだろう？　んっ、あっ、あん\n　っ、こら、オチンポで返事をするな……んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「この……そっちがそのつもりなら、私だって……ふっ、うっ、んっ、あっ、\n　どうだ、この動き……んふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「腰をこうやって動かせば……んっ、うっ、んんっ！！　ふううっ！！　中で\n　びくびくしているのが分かるぞ……ふふっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「ほら、こうして、んっ、腰を叩きつけて、ふうううっ、んっ、あっ、私も、\n　私のオマンコも気持ちいい……あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああっ、はっ、あっ！！　中が……んっ、かき回されて、あんっ、あっ、ふ\n　っ、ふううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「はあっ、あああっ、んっ、お腹の奥、もっと、もっとオチンポを……んっ、\n　ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふううっ、んっ、あっ、あなたが愛おしくなって、んっ、食べたいぐらい\n　……ふううっ、あむっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「また、身体に私の痕がついて……んううっ、ああっ、あなたは、私のもの\n　だ……私だけの……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「はあっ、あっ、んっ、んんっ！！　だから、あなたも私があなたのものだと、\n　そう分かるように……んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「そのオチンポで……逞しいオチンポで、痕を……んんっ、私の中に痕をつけ\n　てくれ……ザーメンで、マーキングしてくれ……あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、オチンポが膨らんで……んっ、あなたもその気になってくれ\n　てるのだな……ふううっ、うっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「嬉しいぞ……んっ、あっ、あなたも私を狩ろうとしてるのが……オチンポで\n　オマンコを狩ろうとしているのが分かる……んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふうううっ、あっ、なら、出して！！　あなたの気持ちいいのを私に出して\n　……んっ、しるしをつけて……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああっ、あっ、私も、私もイくっ！！　んっ、あなたのオチンポで、オマン\n　コイく、イく、イっく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふあああああっ！！　オチンポ、膨らんできた！！　ザーメン、出そうとし\n　て膨らんできた、あっ、うっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「出してっ！！　私にマーキングしてっ！！　んんんっ！！　私も、オチンポ\n　食べてイくから、あっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああああっ、イくっ、あなたのオチンポで、イく、イっくうううううううう\n　うううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_12" ]},
		{"command":[ "SETTEXT", "「ふあああああっ！！　マーキング来たっ！！　オマンコに、オスチンポのマ\n　ーキング来たあああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_11" ]},
		{"command":[ "SETTEXT", "「んうううっ！！　私の一番奥に、あなたのしるしが……ふううっ、痕がつけ\n　られてる……んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「熱くて……濃くて……んっ、子宮がごくごくって飲みこんでる……ふううっ、\n　あなたのオチンポからのマーキング、全部受け止めてる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふううううっ、んっ、奥、ごりごりってされてる……最後の一滴まで、私の\n　中にこすりつけてる……んふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETIMAGE", "0", "still_00000149_02_10" ]},
		{"command":[ "SETTEXT", "「んっ……ふっ……んんっ、全部……飲みこんだぞ……ふふっ、途中から、ど\n　っちが襲っているか分からなかったが……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「最後はあなたのザーメンを全部飲みこんだ私の勝ちだな……ふふふ、狩猟、\n　狩りとはそういうものだろう？　食べた方が勝ちだ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「んん？　不服か？　なら、もう一回するか？　私はいつでも、何回でも構わ\n　ないぞ。どこででも受けて立とうではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「だからな……ふふっ、あなたがしたくなったら、いつでも挑んでくれ。私は\n　これを着て待っているからな、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「私の中で、また大きくなってきてるぞ。早速やるか？　私は一向に構わない\n　ぞ……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａ・ルナテミス" ]},
		{"command":[ "SETTEXT", "「んくうっ……しばらくはこのままでいたいのか。なら、落ち着いてからもう\n　一回するかどうか、決めようか。楽しみにしてるぞ……ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4904310" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んぁっ……んふっ、だから……オマンコ、こんなにほぐされてるの……？　\nあっ、奥の方まで舌が入ってきてる……んっ、くぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ぴちゃ、ちゅぷっ……今度は、私も……イッちゃいそう……んっ、オマンコ\nの恥ずかしいお汁……溢れてくるの止まらないの……」", "NORMAL" ]},

		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ふぅ……何だかとっても久しぶりな感じがするわね。遠征に次ぐ遠征……人\n使いが荒いんだから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203101" ]},
		{"command":[ "SETCHARA", "0", "char_00027902_01", "3", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「でも、無事に戻ってくることができて……また二人きりになれた……嬉しい\nわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203102" ]},
		{"command":[ "SETCHARA", "0", "char_00027902_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ところで……私がいない間に、随分、他のヴァルキリーと仲良くしていたっ\nて話を聞いたんだけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203103" ]},
		{"command":[ "SETCHARA", "0", "char_00027902_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ううん、別にそれを責めているわけじゃないのよ。貴方は何者にも縛られな\nい人……それは、私だって例外じゃないもの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203104" ]},
		{"command":[ "SETCHARA", "0", "char_00027902_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「でも……それだったら、今……この時は、私だけの時間にしても……いいわ\nよね……？　よい……しょっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203105" ]},
		{"command":[ "SETCHARA", "0", "char_00027902_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「あらあら……しっかり勃起してくれてるのね……私とすること……期待して\nくれていたということかしら……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203106" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ふふ……すごいにおい……牝の本能をくすぐる、逞しすぎるオチンポのにお\nい……あぁ……とっても素敵……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「でも、私がいない間も……このオチンポは、お休みしてなかったのよね……\n？　一体、何人の女を泣かせて来たのかしら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203108" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んちゅぷっ……このいけないオチンポには、お仕置きが必要ね……じゅぷっ\n、んちゅぱっ、りゅぷっ、んふっ、じゅるっ、むふぅぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203109" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んぷっ、ビクビクさせちゃって……こんな風におしゃぶりしてもらうことも\nあったんじゃない？　私のフェラより気持ちよかった？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203110" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「あら……私の方がずっといいの……？　そうやって、他の子の時は私よりず\nっとよかったなんて言っちゃうのよね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「でも、いいのよ……今、この瞬間だけでも、貴方を骨抜きにしてしまうんだ\nから……じゅぱ、あぁ……んむっ、この赤黒い先端を……ちゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203112" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「れろ……私の唾液でヌラヌラにして……もっと、蕩けさせてあげるわ……り\nゅぱ、くぽ、んちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んふっ……ぴくんってさせて……可愛いわね……今の場所……気持ちよかっ\nたの……？　いいわ……ここよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203114" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「れろ、りゅぱっ……んふっ、もちろんちゃんと覚えてるわ……貴方の好きな\nところ……私のオマンコを苛める、いけないところ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203115" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「くぽっ、んぱっ、んちゅぷっ、りゅぷぅぅ……また跳ねてる……ちゅぷっ、\nここの反応だけみたら、本当に可愛いオチンポなのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「いざとなったら、ものすごく牙を剥くんだから……ちゅぱ……ぴちゃ……ん\nふぅ……怖いわね……りゅぱ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「その割に物怖じしていない……？　ふふっ、そうね……優しくしてくれるこ\nとも分かっているから……んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「あぁ……もう私も待ち切れないの……んっ、ほら……ここ……私のオマンコ\nも……可愛がってぇ……はぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203119" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁ……いいわ……貴方の舌が……入り口のところ……なぞ\nってる……んっ……そこぉ……素敵……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203120" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、んんっ……！　感じるわ……あひんっ、ク、クリトリスもぉ…\n…すぐなのっ……？　んっ、んふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203121" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「あん……あぁ……ダメ……もう、すぐに……本気で私をイカせようとしてく\nるんだから……もっとじっくりしてくれないと……ちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203122" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ほら……最初はこれくらいよ……りゅぷ……んちゅぽっ、いきなり強くした\nら、オチンポもびっくりするでしょう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203123" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「もう少し優しく……お互いに……いやらしい気持ちを高めあっていきましょ\nう……んちゅぷっ、くぱっ、はぁ……んりゅっ、れろ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203124" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んふっ、ちょっとお汁出て来たわ……先走りは、ちょっと早いかもね……れ\nる……んれりゅ……りゅぷぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んんっ……！　お互い様……？　はっ、んふっ……あん……私のオマンコも\n、お汁がいっぱい漏れてるって言いたいの……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203126" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「しょうがないじゃない……んんっ、あふっ……貴方の舌が……上手くて……\nちゅぷっ、どうしても……オマンコ感じちゃうんだもの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203127" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んちゅぷっ、同じこと……？　ふふっ、そう……私のフェラチオが……りゅ\nぷっ、そんなにオチンポには効いているって言いたいのね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「じゅぱっ、嬉しいわ……もう絶対に離さないんだから……他の子のことなん\nて忘れさせてあげる……心を込めてオチンポにご奉仕するわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203129" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ぐぽっ、じゅるるっ、んじゅぷっ、んくぷぅぅぅっ……はむっ、んじゅるっ\n、じゅるるるっ、んちゅぱっ、りゅぱっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203130" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「はぁんむ、あぁ……美味しいわ……じゅぷっ、はぁ……んむぅ……口の中が\n……よだれでいっぱいになっちゃうの……オチンポの味ぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「じゅるっ、んじゅぅぅぅっ……んくぷっ、尿道口まで舌先……めり込ませて\nぇ……ねろれろっ、ほじってぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203132" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んりゅぷっ、じゅぷっ、じゅぱっ……あぁ……我慢汁……どんどん溢れてる\n……オチンポ……ビクビクしてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203133" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「じゅぷっ、あぁ……オマンコもいい……んっ、ふっ、そろそろ出そう……？\n　なら……飲ませて欲しいわ……直接出して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203134" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んちゅるっ……そうよ……このまま、むぐっ、じゅぷっ、わらひの……口の\n中に……んふぅっ、じゅぽっ、らひてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んむぅっ……！　むふっ、んぐっ、んっく……こくっ、んっふ……んくっ、\nんくんっ……ふぶぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203136" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「あぁ……いっぱい、れてるっ……んぐっ、こくっ、んじゅるっ、ちゅぷっ、\nはぁ……んむ……んっく、ちゅぷんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203137" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ふはぁっ……はぁ……んっ、あぁ……新鮮なザーメン……いっぱい飲ませて\n貰ったわ……ちゅぷっ、んっ、とっても美味しい……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203138" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「思った以上に溜まってたのね……もっと他の女が、搾り取ってしまってるか\nと思ったけど……ちゃんと取っておいてくれたのね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ふふ……嬉しいわ……れろ、ぴちゃ……だから、このオチンポから離れられ\nないのよね……ちゅぷ……んっちゅ……幸せよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203140" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んちゅ……さて……オチンポの方は……当然、この程度で終わりにはならな\nいわよね……ふふっ、分かっているわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203201" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「貴方が一発出したくらいで、満足なんてするはずないもの……任せて……も\nうちょっとお口でしてあげる……はぁんむ、ぴちゃっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「あぁんむ、じゅるっ……んふぅ……濃いザーメンの味が、まだいっぱい残っ\nてる……ちゅるっ……口の中でオチンポの味と一緒に味わってるわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203203" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んふぅ……奥に残ってる分を吸い上げて……あぁ、また勃起……すごくなっ\nへる……じゅぽっ、くぷぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203204" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ふふっ……やっぱり裏筋をくすぐられるの……弱いみたいね？　もうずっと\nビクビクしてて……可愛い反応を見せてくれるの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ……！　ふふっ、図星だったの？　そんな、急にオマンコを舐\nめ始めて……私の言葉を封じようって魂胆かしら……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203206" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んくっ、あふっ、あっ、はぁぁっ、あんっ……あぁ……内側から……お汁滲\nんできちゃう……あっ、そこは……弱いの……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203207" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「くぅっ……んふっ、あぁっ……ヒダのところ……舐められてるぅ……んっ、\nエッチなオマンコ……いっぱいされてるぅ……んくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「じゅぱっ……んちゅるっ……私も……んっ、もっとオチンポ……ねっとり責\nめてあげないとね……れりゅ……んりゅ、くぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203209" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「先端だけじゃなくて……根本の方も……んふっ、タマタマも、いっぱいマッ\nサージしてあげる……どんどん精子を作ってもらわないと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んじゅっ、ちゅぷぅ……くぽっ……はぁ、口に入り切らない……はむぅ……\nくぷっ、あぁ……れろ、ぴちゃっ……オチンポ太いわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「こんな太いので、奥を突かれたら……そんなの……イッちゃうに決まってる\nわ……あぁんむ、ちゅぷっ……はむぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203212" ]},

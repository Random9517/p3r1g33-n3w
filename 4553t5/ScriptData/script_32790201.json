		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「はっ、んじゅるっ、このまま一緒にっ……んっ、ちゅぷっ、あぷっ、んふっ\n、出してっ……はぁっ、あぁぁぁぁんっ！」", "NORMAL" ]},

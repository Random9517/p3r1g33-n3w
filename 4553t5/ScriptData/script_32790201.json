		{"command":[ "SETIMAGE", "0", "still_00027902_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「はぁ、んっ、あぁ……出るのね……ぐちゅぐちゅしてる……さあ、残さず出\nしてっ……ちゅぷっ、ちゅぱっ……」", "NORMAL" ]},

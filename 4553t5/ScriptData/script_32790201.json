		{"command":[ "SETIMAGE", "0", "still_00027902_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「んりゅぷっ、貴方のオチンポも、新しい我慢汁がまた出てる……もう少し我\n慢してね……ちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203215" ]},
		{"command":[ "SETIMAGE", "0", "still_00027902_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「ギリギリまで溜めて……思いっきりドピュって出したら、すごく気持ちいい\nから……ちゅぷ、んちゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_279_0203216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レイア" ]},
		{"command":[ "SETTEXT", "「私も……一緒にイクわ……あぁ……んふっ、もう、オマンコ……ずっと、ビ\nクビクして……待ち切れないの……」", "NORMAL" ]},

		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、ふっ……止まった……？　精液……全部出し切れた……？　\nんっ、そんなら……よし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504306" ]},

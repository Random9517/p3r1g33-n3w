		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はふぁ……今度は……全部掛けちゃうんだ……あたしの全身……精液でドロ\nドロにさせちゃうんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「いいよ……もっと掛けて……出して……濃い精液で……いっぱいマーキング\nしてぇ……おっぱいも、お尻も……ヌルヌルにしてぇ……」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あぁ、めっちゃ身体が火照ってる……ちょっと張り切りすぎちゃったみたい\nだわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504102" ]},
		{"command":[ "SETCHARA", "0", "char_00002805_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「これはもう、しっかり身体を鎮めないと、熱がこもって熱中症になっちゃう\nよね……だから、とりあえず一回しとこっか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504103" ]},
		{"command":[ "SETCHARA", "0", "char_00002805_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「は？　意味がわからない？　何でよ、身体を動かしてたら熱くなってムラム\nラしたから、エッチしたい……当然の流れでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504104" ]},
		{"command":[ "SETCHARA", "0", "char_00002805_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「ほぉら……見なさいよ……。あたし自ら、こんなに分かりやすい据え膳作っ\nてあげたんですけど……？　これでナニもしない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504105" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「まさか、そんな意気地なしなこと……あるわけないよねぇ？　こんなにぱっ\nくり大事なトコ見せちゃってるんですけどぉ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……ほらぁ……いいでしょ？　オチンチン待ってるんだからぁ…\n…そのまま奥に……もう勃起してるそれぇ……入れてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あぁん……だから、オマンコ……オマンコだってばぁ……もう濡れて欲しが\nっちゃってるオマンコに……オチンチン入れてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁぁぁうんっ……！　んふぁぁっ……あっ、来たっ……熱いオチンチンっ\n……入って……来たぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504109" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んくぅぅぅ……おっきいの……届いたぁ……はぁぁぅん……一気に、一番根\n元までハマってるぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……すご……あんたのオチンチンも……めちゃくちゃ熱くなっち\nゃってるじゃん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504111" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「中……入れられただけで……また、じわって……汗……浮いてきちゃってる\n……ふぁぁ……ん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んっ、ふ……どうしたの？　じっとしてないで、動きなさいよ……あたしの\nオマンコ……もう気持ちいいんでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504113" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んぁっ……！　そう、そう……んっふ……あんっ、勢いつけて……ズリズリ\n……擦り上げてぇ……はっ、んふぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504114" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あっ、あんっ、んくっ、んふぅんっ……しっかり、オチンチン押し込まれて\nる……中のヒダヒダ……押し付けられてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はっ、んはっ……あぁ……バックから突かれるのぉ……やっぱ、すごく……\n気持ちいい……くふぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504116" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「お腹の奥に……ズンって響いてくる感じぃ……くぅん……身体……熱くなっ\nてくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「ふはっ、んっ、あぁっ……もう、さ、あたし……ランニングで疲れてるから\nさ……あんたに動くの任せちゃっていいよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504118" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「自分も走った……？　でも、あんたは男でしょ？　だったら、踏ん張って男\nらしいとこ……見せる場面じゃない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「ほら、早くぅ……ちゃんと、あたしも、キュンってオマンコ締める時はちゃ\nんと締めるからぁ……んっ、ねっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぅっ、んっ、ふっ、くぅんっ……！　あっ、んんっ、そぉっ、その感じで\nぇ……あっ、パンパンしてぇっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504121" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はんっ、あっ、あぁっ……お尻ぃ……しっかり掴んで……ぐいって……腰を\n……めり込ませて……うんっ、そこぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁぁ……いい感じぃ……あっ、オチンチンが中で暴れてるの……んんっ、\n分かるぅ……んふぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はっ、んんっ、んぁっ、タイミング合わせて……ぎゅってするのね……？　\nうんっ、やってみるからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504124" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んんっ……！　今ぁっ……オチンチンが……一番深くめり込んでる時にぃ…\n…ぎゅって……はふぁ……ど、どう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504125" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「いい感じ……？　にへへ……それならぁ……もっと、こうっ……！　んっ…\n…ふぅっ、あっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504126" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「オマンコのお肉……しっかり、オチンチン……捕まえてぇ……キュンキュン\nさせるのっ、はぁっ、んはっ、ふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「ねっ……いい感じでしょっ……ふふっ、今、うぅって……呻いたのバレてる\nからねぇ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あんっ、ナニ……ちょっとからかっただけじゃん……そんなムキになって腰\n使わなくても……ひゃふんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504129" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あっ、ちょ、ちょっと……お尻……何っ、叩いてるのっ……そんなことまで\nしろって言ってないし……んぁっ、ま、またっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「えっ……そうしたら……オマンコ……締まるって……バ、バカ！　だからっ\nて、そんな不意打ちでお尻……ひぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「やっ……ち、違う……甘い声出してなんかっ……あぅんっ！　そこでっ、あ\nっ、激しくするのっ、ずるいっ……！　オチンチン……ダメっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504132" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はっ、んぁぁっ、あんっ、こんなのっ、あっ、だ、出すのっ……？　はぁっ\n、な、中出しするのっ？　んぁうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「い、いいよぉっ、何でもっ、いいからっ、あっ、ひぁぁっ、出してっ……！\n　オチンチンミルクっ……オマンコにっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「そのままビュビュって出してっ、あひぁんっ！　あたしもっ、イ、イクから\nぁっ、あっ、んぁぁぁぁぁぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あっ、ふっ……！　びゅびゅって……出てるぅ……あっ、はぁぁ……んっ、\n中出し……されてるぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504136" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_07" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁぁ……んっ、身体……燃えちゃう……熱いの……いっぱい出されてぇ…\n…汗……止まんない……ふひぁぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あっ、ふっ……んはぁ……はぁ、はぁ……はぁぁぁ……出たぁ……せーえき\n……いっぱい出されたぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504138" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んんっ……あふっ、うん……はぁぁ……よかったぁ……オチンチン……気持\nちよすぎぃ……はぁ、はふぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「すご……頭、ボーッとしてる……なんか、他のこと何も考えられないかも…\n…オチンチンのことばっかり考えてる感じぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504140" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あっ……ふっ……んんっ……何……まだ、やり足りないって感じなの……？\n　奇遇だね……あたしも、おんなじ感じなんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504201" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「もちろん、オチンチン抜かないで……そのまま続けちゃう感じで……いいよ\n、ほら……動かして……あっ、んぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「うんっ、はぁ……中のっ……あぉっ……まだ、擦れてないとこっ……いっぱ\nいしてっ……んんっ……あっ、ぅんっ、その辺とか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504203" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁっ、んんっ……！　後……今の、ズリズリってしたとこぉ……続けてさ\nれると……オマンコ……蕩けるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「ふっ、はっ、調子出てきたじゃん……んっ、あたしのこと……ヒィヒィ言わ\nせたいとか……そんな感じでいるんでしょ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504205" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んっふ……できるもんならやってみなさいよ……んぅっ、くっ、はぁんっ…\n…あっ、ま、また……お尻っ……パチンってぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「バ、バカっ……あんっ、こ、これ……集中できないから……ダ、メッ……な\nんだけどっ、はっ、んぁっ、ペンペンしちゃっ……ぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504207" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「勝手にオマンコ締まるから……って……そんなのしなくたって……ちゃんと\n、締め付けるのに……あっ、ひっ、あひぃっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「ま、またぁ……あっ、やだ……お尻……熱くなってる……んふぅっ、痛いの\nに……何だか、オマンコ……ジンジンして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504209" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はっ、ふぁ……気持ちいいの……広がってる……あぁんっ……あたし……よ\n、喜んじゃってるの……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504210" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……お尻叩かれながら……オチンチンかき回されてぇ……あたし\nのオマンコ……感じてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504211" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「お汁……ポタポタ漏れて……はぁんっ、あっ、もっと乱暴に犯して欲しいっ\nて思ってるぅ……んぁっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「うんっ、はひっ、熱いのっ……もっと腰……パンパンしてっ、オマンコ、ズ\nリズリっ、擦りまくってっ……あぁんっ、太いの……来てるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、あぁんっ！　うんっ、いいのぉっ、はぁぁ、一番奥の……コ\nリコリされてぇっ、ゾクゾクっ……するぅっ……！」", "NORMAL" ]},

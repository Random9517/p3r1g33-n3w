		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「んっふ……！　あぁ……まだオチンチン震えてる……んっふ、いいよ……最\n後まで出し切っちゃって……オマンコいっぱいにしてぇ……」", "NORMAL" ]},

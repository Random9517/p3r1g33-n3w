		{"command":[ "PLAYVOICE", "v2_028_0504217" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「ひゃふっ、んふぅっ……！　あぁぉっ、あぉぉっ……！　ま、まだ速くなっ\nて、くぅっ……んんぅっ！　こんなっ、ダメっ……！」", "NORMAL" ]},

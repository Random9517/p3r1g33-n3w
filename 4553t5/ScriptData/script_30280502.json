		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「もっ、我慢っ、できなっ……またイクッ……あぁんっ、オマンコっ……また\nイッちゃうからぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},

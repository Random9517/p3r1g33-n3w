		{"command":[ "SETIMAGE", "0", "still_00002805_02_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……めちゃくちゃ汗かいたぁ……やっぱり運動した直後にセッ\nクスするって……結構、ハードだったりする？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「今さらって……だって、身体が疼いてたんだからしょうがないじゃない。も\nう、こうなったら止まらないなんて分かりきってたでしょ」", "NORMAL" ]},

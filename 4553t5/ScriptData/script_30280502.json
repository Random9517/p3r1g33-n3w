		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あぁ……あっつぅ……身体の火照りを冷ますつもりだったけど、めちゃくち\nゃ汗かいちゃったし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「それはそう？　セックスしといて、そうならない方がおかしい？　う、うっ\nさいな……ムラムラはとりあえず解決したからいいのっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁ、分かってるわよ……結局、さっぱりシャワー浴びるのが一番なんでし\nょ？　もう浴びに行くから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504309" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「何……ついてくるの？　一緒にシャワー浴びる……まぁ、いいけど……そし\nたら、また続き始まっちゃうかもよ……？」", "NORMAL" ]},

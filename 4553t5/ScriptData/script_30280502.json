		{"command":[ "SETIMAGE", "0", "still_00002805_02_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、熱い……ドロっとしたのが……絡み合ってくぅ……はぁぁぁ\n……んふぅぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_028_0504404" ]},
		{"command":[ "SETIMAGE", "0", "still_00002805_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "桃花" ]},
		{"command":[ "SETTEXT", "「あぁ……もう、オチンチンで直接塗りつけていいから……残さないで、出し\nちゃってぇ……はぁ、んふぁ……はぁ……」", "NORMAL" ]},

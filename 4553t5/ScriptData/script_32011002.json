		{"command":[ "SETIMAGE", "0", "still_00020110_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「これだと、精子の匂いと私の汗の匂いが混ざってしまう！　もっといやらし\nい香りが広がってしまうじゃないか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「それに服が湿って、肌が透けてしまうっ！　息子に見て欲しいのに、これ以\n上見られたくなくて……あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あ、頭がおかしくなりそうだ！　気持ちいいのと、息子に見られたくないと\nいう感情が混ざり合って……はぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あっ！　あぁっ！　まだ出ている！　息子の精液が、母の服を真っ白に染め\nたいと言っているみたいだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004405" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「くっ！　うぅぅっ！　この熱と香りを感じていると、マンコが疼いてっ……\nこんなの、また達してしまうぅぅぅっ！」", "NORMAL" ]},

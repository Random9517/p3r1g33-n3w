		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「しかし、お前がこんな服で興奮するとは思ってもみなかったぞ。そういう趣\n味なのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「こういった服は好きだが、今回は私が恥ずかしがったりして、いつも以上に\n可愛く見えたから？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ふふっ……それはいいことを聞いた。次は恥ずかしがる演技を取り入れてみ\nるとするかな」", "NORMAL" ]},

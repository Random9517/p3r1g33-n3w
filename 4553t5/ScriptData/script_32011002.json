		{"command":[ "SETIMAGE", "0", "still_00020110_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「先ほどあれだけ出したのに、まだこの量を出せるとは……！　いったい、ど\nれだけ興奮しているんだ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あっ、おぉぉっ！　ふほっ、おっ、おぉっ！？　チンポが何度も膣内で跳ね\nまわって……出されすぎて、腹がはちきれそうだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004303" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「だが、こんなにも出して貰えて、母は幸せだ……！　幸せすぎて、簡単にイ\nッてしまう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004304" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「イクッ……！　マンコイクッ……！　息子ザーメンを受け止めながら、妊娠\nアクメを決めてしまうぅぅぅっ！」", "NORMAL" ]},

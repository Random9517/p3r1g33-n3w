		{"command":[ "SETIMAGE", "0", "still_00020110_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ……はぁぁぁ……全身が息子の精液まみれになってしまったな\n……」", "NORMAL" ]},

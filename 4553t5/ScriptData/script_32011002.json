		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「よくぞ母の呼び出しに応じてくれたな、我が愛する息子よ……ふふっ。逃げ\nようとしても無駄だぞ。この倉庫には既に鍵をかけてある」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004101" ]},
		{"command":[ "SETCHARA", "0", "char_00020110_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「どうしてこんなことをするのかだと？　ふっ……この服を着ていると、どう\nも懐かしさを覚えてな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004102" ]},
		{"command":[ "SETCHARA", "0", "char_00020110_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「昔の記憶などないが、私とて若かりし頃はある。さあ、息子よ……お前のチ\nンポで、母に青春を思い出させてくれ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004103" ]},
		{"command":[ "SETCHARA", "0", "char_00020110_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あんんっ……嫌がっている割には、チンポは正直だな。もうこんなに大きく\nなっているぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004104" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「こうして息子と手を繋いでいると、マンコが濡れてきてしまう……んっ、あ\nっ……なんだか、恥ずかしく思えてくるな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ふふっ……これもこの服のせいだろうか。んんっ……早く息子のチンポが欲\nしくてたまらないのに、いつもより緊張してしまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004106" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「な、なに？　私がいつもより可愛く見える？　恥ずかしがる姿が、普通の女\n学生みたいだと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「息子にそう思って貰えるなんて、私はなんて幸せな母なのだろう……ああっ\n。もう我慢できん！　早くそのたくましいチンポを、母に挿れてくれ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「くぁぁぁぁっ！？　あっ、あぁぁ……！　息子の太いチンポが、奥に入って\nくるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004109" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「とうの昔に忘れ去った青春を、謳歌している気分だ……すごく気持ちよくて\n、幸せだぞ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004110" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……こ、このまま動いてくれ……母のマンコをめちゃくちゃに犯\nして、感じさせてくれ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004111" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あんっ！　あっ！　あっあっ、あんんっ！　奥に響くっ！　息子チンポで、\n私の大事なところが叩かれているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004112" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev201_10b_0000", "ev201_10b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「い、いつもより激しい……んぅっ！　ぐっ、んぐぅっ！　そ、そんなに、母\nに欲情しているのかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「汗で蒸れた体操服やブルマに食い込む太ももが、すごくエッチで可愛い？　\nむ、息子にそんな目で見られるだなんて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「やぁぁっ！　あっ、あぁぁっ！　いつもなら嬉しさと幸せを感じるのに……\n今日は、そこに恥ずかしさが加わって……ひゃうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「んふっ！　あっ、うぅっ！　んっぐっ！　うぅ～っ！？　息子チンポの動き\nが、段々と激しく……！　チンポも、膣内でさらに大きくなっているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「やっ！　あはぁぁんっ！　そんなに可愛いを連呼するな！　は、恥ずかしす\nぎて、顔から火が出そうだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、ぐっ、あぁぁぁっ！　息子に褒められながら突かれると、マ\nンコが熱くなってくる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「子宮が悦んで、どんどん降りてきて……！　気持ちよすぎて、さらに汗が出\nてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「な、なに？　もっと汗をかいて、いい匂いを嗅がせて欲しい？　そ、そんな\nことできるわけが……あはぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あっあっ！　お、奥をズンズンされると、汗だけでなく、マンコから汁が噴\nき出るっ！　いやらしい匂いを、撒き散らしてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「息子が母の匂いで欲情してくれるのは、ものすごく嬉しいのに……何故か今\n日は、恥ずかしさの方が勝ってしまう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「こんなにも汗やマンコの匂いが気になるだなんて……これは私が青春を感じ\nているせいなのか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「はぁ、んっ！　ふっ、うぅぅっ！　な、なんだ……？　私の可愛い顔がもっ\nと見たいから、いっぱい気持ちよくしてあげたい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「やんっ、あんんっ！　息子に求められたいのに、今日はいつもより激しくし\nて欲しくないんだ！　頼む、少しだけ手加減を……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「なら、奥と浅いところを交互に擦ってあげる？　ま、待てっ！　それはもっ\nと気持ちよくなるヤツで……あっはぁぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「チンポが激しく出入りしてくるっ！　お、奥をズンズンされたかと思えば、\n浅いところを優しく擦られているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「クリトリスの裏側を強く刺激されたら、マンコが蕩けてしまう！　気持ちよ\nすぎて、エッチな汁が止まらなくなってしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ！？　あっ、はぁぁんっ！　今度は奥にぃ！？　息子が産まれて\nきたところを、勢いよく押されているっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「鋭い刺激と蕩ける刺激を交互に味わわされたら、すぐにイッてしまうっ！　\nもっと息子チンポを味わいたいのに、アクメしてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ひゃ、あぁっ！？　膣内でチンポが膨らんでいる……！　お前も、イキそう\nなのだな！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004131" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「なら、このまま膣内出してくれ！　息子のザーメンで、また息子を孕みたい\n！　いや、孕ませてくれっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「女学生だった頃の母に種付けをして、赤ちゃんを妊娠させて……あっあっあ\nっ！　うぁ、あっ！　んはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「チンポがヒクヒクしながら、何度もマンコの肉を削いでくるっ！　イクッ！\n　イクイクッ！　こんなの、あっさりとイカされるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あっあっ！　おっ、おぉっ！　イグッ！　イグイグッ！　息子チンポで、ア\nオハルマンコイカされてしまうぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あっ！？　あっ、あぁぁぁっ！　し、子宮に息子ザーメンがきている……！\n　こんなにも母に注いでくれるとは……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004136" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_08" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ぐっ、んぐぐっ！　いつもよりも精子の量が多い気がするぞ……！　青春時\n代の母に、欲情しまくっているのだな……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「遠慮なんてしなくていい……！　このまま妊娠させてくれ……！　女学生の\n母に種付けなんて機会は、もうないかも知れないからな……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004138" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「うぅぅっ！　んっ、はぅぅっ！　ま、まだ出ている……子宮どころか、マン\nコもいっぱいになってしまうぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「これは確実に妊娠しているぞ……！　あっ、あぁ……息子に孕まされるとは\n……なんて幸せなのだろう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004140" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……とてもたくましく、男強い射精だったな……嬉して涙が出\nそうだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004201" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「な、なに？　そんな可愛い顔をされたら、またシたくなってくるだと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004202" ]},
		{"command":[ "SETIMAGE", "0", "still_00020110_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ふふっ……そんなことを言われたら、応えてやりたくなるのが親心というも\nの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「いいぞ。続きをしようじゃないか。だがその前に、ちょっと汗を拭かせてく\nれ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「いつもは気にならないのだが……今日はどうしても、体臭が気になって仕方\nないんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「えっ？　このままでいい？　私の匂いを嗅ぎながら、思いっきりセックスし\nたい？　ま、待て！　気持ちは嬉しいが、今日だけは……あはぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「あんっ！　あっあっ！　あんっ、あぁぁぁんっ！　息子に体臭を嗅がれなが\nら、ピストンされているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004207" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev201_10b_0000", "ev201_10b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「精液まみれのマンコを、チンポでぐちゃぐちゃにかき回されて……ひゃ、あ\nぐぅっ！　あっ、おっ！　おぉ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「奥にザーメンが入ってくるっ！　子宮の中が精子でいっぱいになっているの\nに、無理やり押し込まれているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「く、苦しくて、また汗がっ……やぁぁぁっ！　それ以上、汗の匂いが嗅ぐん\nじゃない！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ！　あ、甘くていい匂い？　女の香りがして、すごく興奮する？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「む、息子にこんなにも褒められるだなんて……！　あぁぁっっ！　嬉しすぎ\nて、子宮が切なくなってくるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ザーメンまみれで幸せなはずなのに、お前が産まれてきた部屋がズキズキと\n疼いて……ひぅっ！　あっあっ、おぉ、おぉぉ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「母の大事なところを、何度も激しく突かれているぅ！　さっきあれだけ出し\nたのに、まだこんなにも性欲に満ちているだなんて！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004214" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「息子の成長を感じられて、母は幸せだ……！　あんっ！　あんんっ！　あっ\n、うぁぁっ！　お、奥、えぐられるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「こんなにズンズンされたら、またイッてしまう！　大好きな息子のチンポで\n、情けなくアクメしてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「いつもなら恥ずかしいなんて思わないが、今日はお前にイキ顔を見られたく\nない！　あんっ、あんんっ！　こんなふしだらな母を見ないでくれ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「はぁ、んっ、んんんっ！　そろそろイクから、もっといやらしい顔を晒して\n欲しいだと！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004218" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「そんな……！　精液を出されながらイッたら、絶対に酷いアクメ顔を晒して\nしまう！　は、恥ずかしすぎるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「だが、息子になら見られたいと思う私が居て……！　何だこの感情は！　も\nう分けがわからない！　あっ！　あぁぁっ！　イクッ！　イクぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004220" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「んっ？　どうした？　……もっと母の匂いを嗅ぎたい？　汗だくになって欲\nしい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004409" ]},

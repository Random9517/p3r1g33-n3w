		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「ふふっ……母をこのような姿にするとは、お前は本当にいい息子だな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1004408" ]},

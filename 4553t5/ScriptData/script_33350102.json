		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イヴリン" ]},
		{"command":[ "SETTEXT", "「何だかエッチ？　ふふっ、そうですね……私……本当はそういうのが好きな\nのかも知れません」", "NORMAL" ]},

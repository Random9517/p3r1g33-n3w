		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イヴリン" ]},
		{"command":[ "SETTEXT", "「ですから、これからも……このエッチな関係……末永くよろしくお願いいた\nします……ふふっ……」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イヴリン" ]},
		{"command":[ "SETTEXT", "「ふぁっ、あっ、はぁっ、そこっ……あくっ、すごいっ……ひっ、身体っ……\n飛んでしまいそうでっ、ひっ、あぁぁんっ！」", "NORMAL" ]},

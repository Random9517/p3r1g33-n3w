		{"command":[ "PLAYVOICE", "v2_335_0104218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イヴリン" ]},
		{"command":[ "SETTEXT", "「あんっ、あぁっ、激しく……もっと激しくっ……！　来ますっ……すごいの\nっ、また……来てますっ、も、もうっ！」", "NORMAL" ]},

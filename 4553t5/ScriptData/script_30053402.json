		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「その……地球の伝統行事としての初詣に来たのですが……見様見真似で着付\nけをしたせいか、その帯がほどけてしまいまして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404102" ]},
		{"command":[ "SETCHARA", "0", "char_00000534_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あちらを直せばこちらがずれて……一向に元に戻らずどうしたものかと……\nえっ、直せない？　そんな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404103" ]},
		{"command":[ "SETCHARA", "0", "char_00000534_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「できる人に連絡を……はい、それだけでも助かります。ウチから連絡しても\nよかったのですが、知り合いは気まずさがあり……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404104" ]},
		{"command":[ "SETCHARA", "0", "char_00000534_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「少し時間が掛かるけど、来てくれる……よかった……一安心です。んっ……\n安心したら、寒くなってきました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404105" ]},
		{"command":[ "SETCHARA", "0", "char_00000534_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「えっ……？　な、なんですか……急にそんな裏手の方に……ず、ずれます…\n…着物がずれますからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……震えているから、身体を温めないと……それは、分かりますが……逆に\n脱がせ始めてるのは……なんなんですか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「身体を密着させる為に……要するに、いやらしいことをするんでしょう……\n他に方法だってあるでしょうに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「だ、ダメというわけでは……そこまで言うのなら、ちゃんと温めて下さいね\n？　ウチの身体……芯から燃えるように……あっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ……！　あっ、んんっ……くぅっ、は、入って来ちゃいます……あっ\n、確かに……これは、熱い……ですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「最初からこんなに勃起させていたということは……こうなると分かっていた\nということですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチの格好が色っぽかったから……また、そういうことを、こういうタイミ\nングで……本当に貴方という人は……んっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ですが、貴方を興奮させてしまったのなら……確かにウチが責任を取るべき\nことなのかも知れません……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「お互いに責任を持って、もっと深く繋がり合うです……んんっ、はぁっ、う\nっ、んくっ……奥ぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404114" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_34b_0000", "ev005_34b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁ……もっと身体をくっつけて……じゃないと寒くて凍えてしまいますか\nら……もっと温もりを感じさせて下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あふっ、あっ、んんっ、はい……動かして欲しいです……オチンチン、いっ\nぱいかき回して下さい……あっ、はぁぁぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「くぅっ、あぁっ、内側から……熱いのが広がって……でも、まだ寒いです…\n…もっと激しくして……下さい……あひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はっ、あひっ、あぁっ、んぁんっ！　ゆさゆさっ、あっ、身体……揺らされ\nてぇっ、あぁっ、オマンコっ……ズボズボされてますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404118" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、あぁっ、はぁっ、もっと足を開く……こ、こうですか？　あぁっ、\nこれ……大事なところが全部見えてしまいますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もし、誰かに見られたら……ダメです……そんなの恥ずかしすぎますぅっ、\nあひっ、はっ、はひぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「気にしないで……オチンチンに集中っ……んっ、は、はいっ、分かり……ま\nしたっ……あっ、ふっ……こ、こう……ですかっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ……！　お、大きいです……オマンコの中が広がっていくような感覚\nが……ずっと続いてて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ゆっくり出し入れされると……はぁっ、熱いのが……全身に広がって……ん\nぁっ、寒さを忘れそうです……あっ、んふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はい、もっと強く抱きしめて下さい……んっ、まだ指先は冷たいですから…\n…ぎゅって握って……温めて欲しいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……んっ、安心します……あふっ、あぁ……はだけたおっぱいのとこ\nろも……貴方の手が……ぎゅってして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404125" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もっと……全身……撫で回して下さい……オチンチンも……もっといっぱい\n動かして、オマンコ……痺れさせてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んふっ、あっ、はぁっ、あんっ、はぁんっ……あぁっ、いやらしい\nお汁が溢れてきます……んんっ、止まらないですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はふっ、あぁっ、ぐちゅぐちゅっ、恥ずかしい音……そんなにさせないで下\nさい……ウチ……どうにかなってしまいますからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「その方が寒さを忘れる……そ、そうかもしれませんけど……恥ずかしすぎま\nす……あぁっ、またオチンチン深くっ……あぃっ、あっ、ひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「止まらないっ……逞しいのが出たり入ったりしてっ、ひゃふっ、お、おかし\nくなっちゃいそうですっ、ふぁっ、あぁん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「よ、よく考えたら……神社の境内の側で……こんなことっ、罰当たりなので\nはっ？　あっ、くぅっ、んふぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁっ、許してくれる……ほ、本当ですかっ？　あぁっ、そんなこと\n……考える余裕もなくさせて……はひっ、オチンチン激しいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はんっ、あっ、あぁっ……ダメですっ……そこっ、弱くてっ……ウチっ……\n力が抜けてっ……も、もうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404133" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「イク、イッてしまいますっ……！　はぁっ……あぁっ、貴方も……出そうに\nっ、はっ、はいっ……でしたらっ、中にっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はいっ、中に出してっ、ウチのことを温めて下さいっ！　このまま、激しい\nままでっ、奥にっ……くぅぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ……あぁぁぁぁ……出て……ますっ！　中にっ、ビュービューっ、精液\nっ……出されてますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404136" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふぁぁぁ……あぁ……種付けぇ……♪　子宮が喜んでます……はぁぁ……中\nから温められて……気持ちよすぎますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ、中でオチンチンがビクビクして……ウチのオマンコが一緒に動\nいてしまいます……んくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁ、あふ……まだ、出てます……この満たされていく感覚で……ウチの身\n体はホカホカになっていきますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んふぁ……あぁ……確かに、男女で身体を温め合うのは……一番……効果が\nあるみたいです……よく、理解できました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ですが……まだ、ウチの身体は……完全に温まりきっていないみたいです…\n…」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もっとして欲しいです……貴方のオチンチンで……ウチの全身をポカポカに\nして下さいっ……んぁっ、はぁぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はいっ……あぁっ、イッたばかりのオマンコ……ぐちゅぐちゅ、中の精液を\n混ぜられてっ、いやらしい音がしていますっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404203" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev005_34b_0000", "ev005_34b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「くぅっ、あふっ、はぁっ……んんっ、ちゃんと……一番気持ちいいところに\nっ……オチンチンの先端が、グリグリ押し付けられて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「うんっ、はぁっ、んぁっ……くぅぅ……あっ、また着物がずれて……見えて\nしまいます……んっ、今更……それは、そうです……けど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「やっぱり、こんなに……おっぱいをはだけさせるのは……んぁっ、恥ずかし\nくて……んんっ！　乳首……こりこりっ、らめっ、れふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぅっ、くぅん……指先……冷たいかと思ったら、温かいです……ひゃふっ\n！　は、反対側の指は……ちょっと冷たいかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、もう、身体が……寒いのか、暑いのか……よく分からなくな\nってきました……それより、気持ちいいのが……大きすぎてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「くぅっ、んふっ、はぁうっ……んんっ、後ろから……パンパンって……腰を\n打ち付けられるとっ……もう、堪らなくてぇっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はいっ、も、もっとして……欲しいですっ！　ウチの……いやらしいオマン\nコっ、もっとオチンチンして下さいっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひゃうっ、んふぅっ、くぅんっ！　あぁっ、だ、誰か来るかも知れないのに\nっ、声が……止まらないですっ、はぅっ、んぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404211" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「見せつけてやればなんて……そ、そんなことになったら、ウチはっ……恥ず\nかしすぎてっ、も、もうっ、あっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんんんっ……！　あっ、い、今……イ、イッてしまいました……あぁ……\nウチの身体……全く言うことを聞いてくれないです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふぁっ！　あぁっ、また……深いところにっ、奥っ……あぁっ、奥ぅっ♪　\nウチのっ、感じやすいところっ、全部……的確にしてくるのっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「な、何なんですか……あぁ……全部うまくて……はぁ、あふっ、あぁっ……\nはっ、身体……勝手に動いて……止まらない、ですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はんっ、あぁっ……もっ、もっと……そこっ、くぅんっ、はいっ、それぇっ\n……いいっ、オマンコっ……いいですぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あんっ、あぁっ……もう見せてしまっても、いいですっ……ウチの恥ずかし\nいところっ、神社の神様の前で……晒してしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふぁっ、あぁっ、熱い……身体っ、ぽかぽかしてっ……はひっ、あっ……ま\nた……イキたく……なってますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「貴方もっ……また、出そうですかっ？　んっ、あぁっ、はいっ、いつでも…\n…大丈夫ですっ、ウチも……もう熱くてっ、我慢出来ませんからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「一緒にっ、あぁっ、オチンチンされてぇっ、またイクっ！　はぁぁんっ、一\n緒にっ……あぁっ、イキっ……ますぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404220" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんんんんんーーっ……！　はぁぁぁ……中出しっ……に、二回目ぇ……あ\nぁ、びゅくって……種付けされてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふぁぁ……熱い……空気がひんやりしてるのに……もう、全然寒くなくて…\n…んっ、あぁっ、もっと身体……寄せて下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はい……貴方の熱をいっぱい分けてもらいました……ぎゅっと重なっている\nからですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こうしている間も、ずっと射精が続いてます……本当に絶倫なんですから…\n…あふっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぁ……出し終わりましたね……でも、まだすぐに離れないで下さいね？　\n貴方が寒くならないようにって始めたことなんですから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「終わったらすぐ離れるなんてことがあったら許しませんよ。はい……ぎゅっ\nとしていて下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「えっ……そろそろ着付けの直しが来るかも……？　そ、それは流石に、この\nままだとマズいですよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「す、すぐ離れて……あっ、んっ……でも、オチンチン……まだ大きいんです\nけど……んぁっ、あふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「も、もう一回とか……いえっ、な、何でもないですっ！　それより……ちょ\nっと着物が乱れすぎたと言いますか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「最低限の体裁が整うように、手伝って頂けますと……どにかく、何とか直し\nて下さいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひぁぅぅんっ！　あぁっ……オチンチン抜けて……精液っ……いっぱい掛か\nってっ……ますぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、ベタベタして……熱くはないですけど……寒さから守ってく\nれるような……そんな気がします……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「貴方の……体温を間近で感じられるからでしょうか……んっ、もっと強くウ\nチを抱きしめていて下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「射精……まだ少し出そうなんですね……？　全部掛けて下さい……残さず出\nし切って……ウチを染めて下さい……あぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁ、んっ、はぁ……終わりましたか……はい……お疲れさまでした……い\nっぱいマーキングして下さいました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「お陰様で、寒さは大分凌げた気がしますけど……これですぐ離れてしまった\nら元も子もありませんから……このままで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はい、ぎゅっと……抱きしめて……あっ、でも精液が……んっ、着物に少し\n……へばりついて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もしかして、これって……マズいですかね？　着付け直す時に……その、色\n々と問題があるような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000534_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「す、すぐに綺麗にして下さいっ！　それとっ、着崩れしすぎた分も、ちゃん\nと元に戻さないとっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3404409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なんでもいいから手伝って下さいっ、色々バレたら……アレですからっ！　\n責任……取ってもらいますからねっ！」", "NORMAL" ]},

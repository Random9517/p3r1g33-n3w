		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「いやぁ……お互い、すっかりハマっちゃったよねぇ、SMプレイごっこ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103101" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「最初はホテルのくじで当たったSM道具を試しに使ってただけなのに……\n今じゃ自分たちでも買うようになっちゃったもんね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103102" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「こんなボンテージ衣装まで用意するようになっちゃって……ふふ、どうどう\n？　似合ってる？　かわいい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103103" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――素直な彼氏君には、ご褒美が必要だね♪　今日はキミの大好きな手錠と\nこの羽根を使って、いっぱい可愛がってあげちゃう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103104" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほーら、ベッドに寝転がって。両腕はこっちに……よし、捕まえた♪　さぁ\n、楽しい楽しい、えっちの時間だよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103105" ]},
		{"command":[ "SETCHARA", "0", "char_00033001_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「おー……キミってば、手錠が似合う顔してるよねー。……なーに、その微妙\nな顔。褒めてるんだから喜んで喜んで♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103106" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、冗談だよ。でもやっぱり、こうして手錠をハメると、一気にアブノー\nマル感が出て、ワクワクしてくるよね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「まずはどうしよっかなぁ……分かりやすく、首筋からかな？　こーやって、\nさわさわ～こしょこしょ～……さわさわ～こしょこしょ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「キミの大好きな羽ペンの感触だよー？　さわさわ～こしょこしょ～♪　どー\nお？　くすぐったい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「このまま脇腹も……さわさわ～こしょこしょ～♪　っと、いい反応。もしか\nして、腋が弱点だったりするー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「そういえば、聞いたことがあるんだけど、人間くすぐったいところと、性感\n帯って被る事が多いんだって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103111" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「だったら……ここを……乳首をくすぐってあげたりしちゃったら、どんなこ\nとになっちゃうのかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「だーめ、待ちませーん♪　ほーら、さわさわ～、こしょこしょ～♪　さわさ\nわ～、こしょこしょ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、全身ヒクヒクさせちゃっていい反応してくれるねー♪　なんだか目\nも、とろーんと蕩けてきちゃってない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103114" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「えー？　そうはいっても、身体の方は正直だよー？　自分でも分かるでしょ\n、羽根で撫でてるだけなのに、乳首、勃ってきちゃってるよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103115" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「男子の乳首が勃起するトコって、なんか、めちゃくちゃいやらしく見えるよ\nね……ふふ、必死にヒクつかせちゃって、かわいい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「うん、分かってるよ、こっちも……オチンチンも、そろそろ我慢しきれない\nんでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふっ、雰囲気に流されちゃった？　それとも乳首を羽根でくすぐっただけ\nで気持ちよくなっちゃった？　オチンチン、勃起しちゃったね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103118" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「私のオマンコに、入れたい？　おちんちんズボズボして、気持ちよくなりた\nい？　だったら……しっかり『おねだり』、できるよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103119" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――あはは、よくできました♪　あんまり焦らし過ぎてもかわいそうだもん\nね。いいよ、私のオマンコ、使わせてあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103120" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んんっ……♪　どうどう、待ちに待った彼女ちゃんのオマンコの感想は？　\n気持ちいい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103121" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――素直で大変よろしい♪　でも……んんっ……分かってるよね、キミは勝\n手に腰を動かしたりしちゃ駄目」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103122" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「それはぜーんぶ私の仕事。私がキミに快感を与えてあげるの。キミはそれを\n受け取るだけ、自分の好きなタイミングで気持ちよくなることはできないの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、いい顔してる♪　キミのその必死に堪えてる姿を見るだけで、オマン\nコの奥……子宮がきゅんきゅんしちゃう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103124" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「まぁでも、いじわるはほどほどにしてあげるから、安心して。どんなプレイ\nをするにしても、一緒に気持ちよくなれないと意味ないもんね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほーら……あっ、んんっ……ゆっくりだけど、確実に……んんっ……私のペ\nースで、オマンコパンパンってしてあげる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103126" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev330_01a_0000", "ev330_01a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んんっ……あっ……んぅんっ……ふふ、この動き、もどかしい？　もっと早\nく動いて、オチンチンを気持ちよくしてほしい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「それはまだ、だーめ♪　焦らして焦らして、恥ずかしい思いをして……いっ\nぱい我慢した後に射精するのが、一番気持ちいいんだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「だからぁ……ふふ、またこっちも優しく虐めてあげる♪　キミのだーい好き\nな羽根を使って、さわさわ～、こしょこしょ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あぁんっ……♪　オチンチン、ビクンって跳ねた♪　こうして乳輪をゆーっ\nくりなぞるようにしてぇ……んぅんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「優しく優しく……さわさわ～、さわさわ～♪　一番触ってほしい所には、絶\n対にふれないの……ふふ、もどかしい？　おねだり、しちゃう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あぁんっ♪　あーあ、恥ずかしいこと、言っちゃったね♪　男子なのに、乳\n首を触って気持ちよくしてほしーなんて、えっちで淫乱な彼氏君だ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「いいよ、ほら、乳首をいっぱい可愛がってあげる♪　気持ちよすぎてキミが\nやめてっていっても、止めてあげないんだから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「それと同時にぃ……んんっ、あっ、んぅんっ……！　オマンコでオチンチン\nも可愛がってあげるっ！　んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あはっ、突然激しくなりすぎてびっくりした？　あぁ、その顔、とっても素\n敵♪　強すぎる快感にびっくりして慌てふためいてる顔、好き……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103135" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んあっ、あぁんっ……！　んぅんっ……！　オチンチン、一気に大きくなっ\nてきたね。もしかして、もう我慢できない？　射精しちゃいたい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「って、まぁ実は私も一緒♪　キミがとっても情けない顔でおねだりしてくれ\nるから……あぁんっ♪　このまま一回、イっちゃいたいなって♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「だから、キミもイっちゃえ！　あっ、んぅんっ……！　私の軽イキに合わせ\nて、びゅーびゅーって精液ぶちまけちゃえ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ……！　イクっ、膣内だし射精で、イクッ！　あっ、ああっ、\nんっくぅっんんっ～～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103139" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_09" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「すごいっ！　オマンコの中で、キミのオチンチンがびゅくびゅくしてるっ！\n　あっ、んんっ、んっくぅうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103140" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふふ……とりあえずこれでお互い一回、だね？　分かってると思うけど…\n…この程度じゃ、終わらないからね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103201" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「今日のキミの役割は、エロい言い方をするなら肉バイブってやつだね♪　私\nが満足するまで、何度でもオチンチンを使わせてもらうの♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ほーら、息を整える暇なんてあげないよー♪　あっ、んんっ……♪　出され\nたばっかりの精液を掻き混ぜるようにして、二回戦スタート♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103203" ]},
		{"command":[ "PLAYANIM", "0", "ev330_01a_0000", "ev330_01a_0023", "true", "ALL" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あぁんっ……♪　流石に出したばっかりのオチンチンを無理\n矢理気持ちよくされるのは、ちょっとつらい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「眉毛がぎゅーって歪んで、可愛い顔になっちゃってる♪　――私？　私は全\n然よゆー、まだ軽イキしかしてないからねー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「まぁでも、キミだってすぐに気持ちよくなっちゃって、またアンアン喘ぎだ\nすんでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「だって……あぁんっ♪　口では色々言いながらも、オチンチンは全然硬いま\nまだもんねー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あんんっ……♪　ふふ、また乳首も一緒に可愛がってあげる\n。右の乳首はさっきみたいにこの羽根でさわさわするとして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んちゅ♪　左の乳首は、舐めたりしちゃったり？　んちゅ、ちゅ、れるぅ…\n…♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「右は優しくさわさわ～♪　また乳輪をなぞって、乳首をゆーっくり責め上げ\nるように、さわさわ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「左の乳首は唇で挟んで……あむっ……ちゅ、ちゅれる、ちゅるぅ……！　真\nっ赤になるまで、吸い付いてあげる♪　じゅ、じゅるうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あぁんんっ♪　ほーら、やっぱりすぐに乗り気になった。オチンチンをビク\nンってさせて、腰も浮き上がってきちゃってる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「だけど……駄目だよ？　キミから腰を動かすのは許してないよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、お預けを食らって泣きそうな顔、かわいい……♪　あっ、んぅんっ…\n…！　私はこのままゆっくり腰を振るだけでも気持ちいいからなー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「もっと激しく、私のオマンコで気持ちよくしてほしいんだったらぁ……ほら\n、言うことがあるんじゃない？　お・ね・だ・り、してみよっか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――んー、さっきと同じような言葉は心に響かないかなぁ？　もっと私に縋\nるみたいに、情けない言葉が欲しいなー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「『さゆり様、堪え性の無いボクのマゾオチンチン、いっぱい気持ちよくして\nください』……このぐらい、言えるよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふふっ、私の彼氏君は、ほんとに素直で可愛いんだから♪　いいわ、一気\nに激しくしてあげるからっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「このまま一緒に、イッちゃおうね♪　あっ、ああっ、あぁんんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103219" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「しっかりおねだりしてくれたから、好きな所にだしていいよ♪　キミの好き\nなように、私に向けて精液をぶちまけちゃえ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んあぁぁんんっ……♪　また出てる、ドロドロ精液が子宮の中に直接っ！　\nあっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「私もイクっ、今度はさっきよりも大きくっ、あっ、くぅんんっ……！　膣内\n出し射精で、イッてるっ、んあぁぁんんっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103302" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、キミはまた膣内出しを選んだんだね♪　んんっ……子宮がパンパンに\nなるぐらい出しちゃって、妊娠しちゃったらどうしてくれるのかなー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103303" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「責任取ってくれるって？　――って、乳首をビンビンに勃起させながら言わ\nれても、かっこつかないよー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103304" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふ、冷静になったら、今の自分の姿が恥ずかしくなっちゃった？　顔赤く\nしちゃって、かわいいー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103305" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「そんな可愛い顔をみせられちゃったらさぁ……もっともっと、虐めたくなっ\nちゃうよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「――まだたった二回だよ？　それだけで解放されるなんて……思ってないよ\nね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103307" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「言ったでしょ、今日は私の肉バイブになってもらうって♪　キミが泣いて縋\nりついても、性も根も尽き果てるまでは解放してあげなーい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「キミだって、そのつもりで一緒に色々道具を買い込んできたんでしょ？　夜\nはまだまだこれからなんだからさ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「SMプレイごっこ、まだまだたくさん、愉しもうね♪　私の大好きな彼氏君\n♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103310" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んぅうんんっ……！　そっかっ、キミは私の身体にぶっかけるのを選んだん\nだ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103401" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「熱くてドロドロの精液が顔にまで届いてっ……んんっ！　ああ、えっちな匂\nいが充満していく……すぅー、はぁー……あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んぅんんっ！　本当は膣内出しがよかったけど……精液のシ\nャワー、これはこれで気持ちよくて、私もイっちゃってるぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「んあぁんっ！　ふふ、まったく、どれだけ出せば気がすむの？　堪え性のな\nいオチンチンには、お仕置きが必要だったりするかなー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103404" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「あら？　もしかして、お仕置きって言葉に反応しちゃった？　射精したばっ\nかりなのに、オチンチンビクンって跳ねさせちゃって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103405" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「まったく……私の彼氏君は、どうしようもないマゾのヘンタイさんね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103406" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「じゃあ……お望み通り、お仕置き、続けちゃおっか？　まさか、二回出した\nだけで限界、なんてことは言わないよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103407" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「ふふっ、そうこなくっちゃ！　一緒に選んだSMグッズ、まだまだ使ってみ\nたいのが山ほどあるからねー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103408" ]},
		{"command":[ "SETIMAGE", "0", "still_00033001_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「どれを使って虐めてほしい？　性も根も尽き果てるまで、いーっぱい可愛が\nってあげちゃうんだから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_330_0103409" ]},

		{"command":[ "SETNAME", "御堂さゆり" ]},
		{"command":[ "SETTEXT", "「SMプレイごっこ、まだまだたくさん、愉しもうね♪　私の大好きな彼氏君\n♪」", "NORMAL" ]},

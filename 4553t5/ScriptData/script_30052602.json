		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「はぁあああぁぁぁああぁぁあぁ～～～～っ！！　オマンコにきたぁっ、精液\nぃっ、いっ、んひぃいいいぃぃぃ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「すっごい勢いで……ウチの中、いっぱいにされるぅ……っ！　オマンコが、\n子宮がぁ……。兄貴で満たされるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んあっ、ああっ、そりゃあ締めますよ……。兄貴のオチンポから、精液搾り\nとろうとオマンコも動いちゃいます……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「兄貴の精液、ウチがぜぇんぶもらっちゃうんですから……。はぁ……はぁ…\n…。どうです……かぁ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁっ♪　また、ビクビクとオチンポが跳ねて、射精……っ！　ま、\nまだまだ、でるなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ウチも、気持ちよかったです……。悩みなんかふきとんじゃって、頭の中も\nまっしろになっちゃって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「……って、その間にウチ、なにか恥ずかしいこととか、キャラじゃないこと\nとか、口走ってませんでしたよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「なんですかその顔！　あ、兄貴、なにか知ってますね？　正直に白状を……\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んひゃあぁっ♪　また腰を、おおっ、オマンコ突かないで、そんなことでご\nまかされると思わないでくださ……んひぃいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「バカ！　バカ兄貴！　いい加減に……あっ、ああぁっ！　もう二度と、兄貴\nに悩みを告白したりしませんからねぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604310" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_11" ]},
		{"command":[ "WAITINPUT" ]},

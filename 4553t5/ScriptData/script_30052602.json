		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「こんなところで、服を……っ！　んっ、はぁっ♪　ど、どこ触ってるんです\n……んくっ、胸って、そんなのわかってます……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ウチが聞きたいのは、そういうことじゃなく……あぁんっ♪　兄貴の手つき\n……エロすぎです……。へ、変態兄貴ぃ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「や、野外で……こんな尋問みたいな方法で……。う、ウチからむりやり、悩\nみを言わせようとするだなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「はぁ……んぁ、ん……っ♪　だ、だめです……兄貴のいいなりになっちゃ、\nだめ……なのにぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「胸……気持ちよくなって……。はぁ、はぁ……♪　身体が、ジンジンと火照\nってきてしまいます……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ひゃうっ！？　お、オマンコに、変態兄貴のオチンポが……っ！　う……す\nごい……ガチガチになってるじゃないですか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「う、ウチに……欲情して……。なっ、なんでもないです。嬉しそうになんて\nしてませんからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「そんなことよりまさか……。あ、兄貴、冗談ですよね？　ここ、外……。エ\nッチなら、せめて帰ってから……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あはぁああぁぁあぁんっ♪　ばっ、バカ兄貴ぃっ！　本当に、お、オチンポ\n挿れるなんて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あ……ああ……兄貴のオチンポが、いっぱい……っ！　お、オマンコ……奥\nにまで……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んぅっ、ああっ、ピストンまで……っ！　腰を動かして、ぶっといオチンポ\nがウチのオマンコをずぶずぶかき混ぜてます……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「はぁっ、ああっ♪　アツアツのオチンポが、こすれて……っ！　んふぅっ♪\n　オマンコ……痺れちゃいます……っ！」", "NORMAL" ]},

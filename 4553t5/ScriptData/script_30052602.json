		{"command":[ "SETIMAGE", "0", "still_00000526_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「や、野外で……兄貴と……っ！　エッチ、しちゃってるだなんて……。はぁ\n、はぁ♪　誰かに見られたら、大変なのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「へあっ！？　う、嬉しそうになんかしてないですってば！　う、ウチはただ\n……こんなところで欲情した変態兄貴の性処理をぉ……っ！」", "NORMAL" ]},

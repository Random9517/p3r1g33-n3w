		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んぁあっ！　なっ、オチンポ抜かれ……っ！　ああっ、精液ぃ……っ！　う\n、ウチの、身体にぃいいいぃぃぃ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「まだ、どんだけだすんですか……っ！　身体じゅう、兄貴の精液でドロッド\nロ……ああ、たくさん、だしすぎです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604402" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「い……イク……ッ！　兄貴の精液でベトベトにされながらぁ……っ！　んっ\n、ああっ！　イッちゃい、ます……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ああ……兄貴のにおいで、いっぱいに……。はぁ、はぁ……。こんなに、い\nやらしいにおいで……頭がどうにかなっちゃいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あ……兄貴……。もっと……ウチと、エッチしてください……。兄貴のオチ\nンポを、ウチのオマンコに……ください……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「だってウチは……ウチだって……。クラスメイトに自慢できるくらい、兄貴\nとエッチしたいんです……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「いいですか！？　やった！　……けど、なんです？　え……ウチらのこと、\nクラスメイトが、見ていて……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ぎゃぁあああぁぁぁっ！　ちょ、ちょっとなんでそれをはやく言わないんで\nすか、このバカ兄貴ぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あなたたちも、なっ、してないです！　こんな変態兄貴に向かって、オチン\nポ媚び媚びおねだりなんかしてないですからっ！」", "NORMAL" ]},

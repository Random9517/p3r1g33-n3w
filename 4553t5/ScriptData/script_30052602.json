		{"command":[ "SETIMAGE", "0", "still_00000526_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「はぁあっ♪　乳首っ、ぎゅっとしながらピストンぅ……っ！　んぁっ、ああ\nっ、オマンコの奥にぃ……亀頭ぉ、刺さるぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「おおっ、オマンコから愛液が溢れてくるのは、生理現象です……っ！　あ、\n兄貴のオチンポで悦んでいるからじゃ……あっ、ああぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「にしては濡れすぎって、これが普通、普通なんです！　う、ウチ以外のオマ\nンコを知らないくせに、なにいって……ひゃぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「オチンポ、ずぼずぼ激しすぎです……っ、ああっ、オマンコがけずれるっ、\nバカ兄貴のオチンポで、ずりずりと……ぉお……っ！」", "NORMAL" ]},

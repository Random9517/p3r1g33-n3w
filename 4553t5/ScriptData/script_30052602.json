		{"command":[ "PLAYVOICE", "v2_005_2604131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ああぁっ♪　ちょっと、話が違う！　話したのに、なんでピストンを激しく\nしてるんですかバカ兄貴ぃっ！」", "NORMAL" ]},

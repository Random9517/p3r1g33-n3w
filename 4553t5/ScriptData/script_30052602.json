		{"command":[ "PLAYVOICE", "v2_005_2604125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「はぁああぁぁっ♪　ああっ、ああ……っ♪　あっ、ああ、ちょっと……腰、\nイッたのになんで止めないんですか……ぁ……っ！」", "NORMAL" ]},

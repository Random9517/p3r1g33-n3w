		{"command":[ "SETIMAGE", "0", "still_00000526_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「オマンコ敏感になってるところを、さらに……っ！　あはぁっ♪　い、イク\nッ、またイかされ……っ、んっくぅううぅぅっ！」", "NORMAL" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ひぃっ、いいぃぃっ♪　声が、無理ですっ、おさえられないですぅっ！　ん\nはぁっ、ああっ、変態兄貴のオチンポのせいでぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「奥までとどくオチンポで、し、子宮まで……どちゅんってされたら……っ！\n　ドロドロ愛液、いっぱい垂らしちゃいます……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「そんなに、ウチのオマンコが気持ちいいですか。ウチの、キツキツ妹オマン\nコ……んぁっ、兄貴のこと、気持ちよくできてるんですねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ウチも、最初からずっと感じてます……っ！　兄貴のオチンポ、最初から気\n持ちいいから当然です……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ああぁっ♪　オマンコがまたイク……ッ！　あ、兄貴に、遠慮無くイかされ\nまくる……オマンコ、イク……ッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「兄貴も、イッて……！　ウチにむかって、精液いっぱいだしてくださいっ！　\n兄貴の精液と一緒にイキたいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んはぁっ、オチンポ震えて、くっ、ううっ、イキそうになってますね……う\n、ウチも……一緒にイけるよう、我慢します……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「だして……っ！　兄貴ミルクで、ウチのこと思いっきり……っ！　兄貴の、\nザーメン……欲しいんですぅうううぅぅぅっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604220" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_08" ]},

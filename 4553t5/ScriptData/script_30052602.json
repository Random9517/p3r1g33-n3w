		{"command":[ "WAITMOVE" ]},		
		{"command":[ "SETNAME", "カツマ" ]},
		{"command":[ "SETTEXT", "「どうやら別の時空ににとばされてしまったらしい。よくあることとはい\nえ、勘弁して欲しい現象だ。」", "NORMAL" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
				
		{"command":[ "SETNAME", "カツマ" ]},
		{"command":[ "SETTEXT", "「そしてここにはアナザー・オボロが俺の妹として存在していた！　なぜこ\nんなことになっているかはわからないが、制服姿はかわいかったな……。」", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "カツマ" ]},
		{"command":[ "SETTEXT", "「この時空では、俺はフリーターの一般人。もとの時空へ戻るために、アル\nバイトをしながら調査を進めているわけで……。」", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「……げ。よりによって一番会いたくないときに、一番会いたくない相手に合\nってしまうなんて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604101" ]},
		{"command":[ "SETCHARA", "0", "char_00000526_01", "7", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「というか、なんで兄貴はこんな時間にふらふらしてるんですか。え、ウチで\nすか？　ウチは見ての通り、下校中ですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604102" ]},
		{"command":[ "SETCHARA", "0", "char_00000526_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「なんです？　元気がないように見える？　別に、いつもどおりですよ。ウチ\nはいつもこういう感じです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604103" ]},
		{"command":[ "SETCHARA", "0", "char_00000526_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「別に兄貴には関係のないことですから、気にしなくたっていいですよ。本当\nに、なんでもないですから……って」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604104" ]},
		{"command":[ "SETCHARA", "0", "char_00000526_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ちょ、ちょっと。ウチをどこにつれていくつもりですか！　兄として妹の人\n生相談にのってやるって、意味わかんないですって！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604105" ]},
		{"command":[ "SETCHARA", "0", "char_00000526_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「このバカ兄貴、なに考えてるんですか！　これのどこが人生相談だっていう\nんですか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2604106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000526_02_01" ]},

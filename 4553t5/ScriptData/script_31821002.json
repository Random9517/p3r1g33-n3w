		{"command":[ "SETTEXT", "「はんっ、あぁっ、そうです……お仕置きで反省しなきゃいけないのにっ、私\nはっ、オチンポでいじめられて悦ぶマゾですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁんっ、あぁっ、オマンコっ、もっと深く抉ってっ……か、感じすぎてっ\n、あひぃっ、あっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004217" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ダメ……またイキそうですっ、あぁっ、先生はっ……先生はっ、まだですか\nっ？　あと……ちょっと……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ、はいっ、我慢しますっ、先生が出すまでっ、イクの我慢しますからっ\n、もっと、激しくズボズボしてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はやくっ、あぁっ、お願いしますっ、イクのっ、イキますっ、んひぁぁぁん\nっ！　オマンコまたイキますっ、イクぅぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004220" ]},

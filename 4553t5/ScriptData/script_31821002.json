		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「しょ、正面の鏡……？　あっ、あぁ……そんな……私……なんて表情を……\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004136" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あぁ……ぴゅっぴゅしてるぅ……私……こんな、蕩け顔で……直接精液……\nいただいちゃってるんですね……あふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、もぞもぞ動いたら……縄が余計に食い込んで……あぁ……痛\nい筈なのに……身体が熱くなって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あふっ……あぁ……射精……落ち着きました。でも、まだ……身体が……全\n身がドキドキしています……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004139" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「縛られるのって……思った以上にハマっちゃうかも……はぁ……また、私\n……新たな世界を見つけちゃったんでしょうか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ……あっ、また縄が深く食い込んじゃって……あんっ、これ……解くの\n大変かも知れませんね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あ……えっ、も、もう少し……補習をする必要……ですか……は、はい♪　\nこのまま続き……お願いします……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んんっ……！　あぁっ、まためり込むっ……オチンポ……オマンコの中に埋\nまってますぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004203" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev182_10b_0000", "ev182_10b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……はい……んっ、さっき出していただいた精液が……中に残ってま\nすから……いっぱい塗りつけて下さい……あんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、あぁっ、ぐりぐりっ、ずぼずぼっ、いやらしい音っ……いっぱ\nいしてますっ、あっ、あぁんっ、恥ずかしい音っ、あっ、こんなにっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あんっ、はい、あぁっ、私のオ、オマンコが鳴らしてる……音ですっ……先\n生の精液だけじゃなくてっ……私のオマンコ汁も原因ですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「わ、私が……オチンポ大好きな……いやらしい学生だからっ……こんなにさ\nせてしまって……はぁんっ、今……おっぱいは……あぁん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ……んっ、コリコリの先っぽ、つまんで……はひぃっ、あぁっ、そこも\n……敏感なんですっ、んぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁ……また鏡に映ってる私を……見せつけて……こんな、いやら\nしい顔……あぁっ、恥ずかしい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ……は、はい、身動きは取れなくても……オマンコは締め付けることが\nできますから……んくっ、こう……ですかっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ……オチンポがビクって……はいっ、今の感じで……もっとで\nすね……はっ、んんっ！」", "NORMAL" ]},

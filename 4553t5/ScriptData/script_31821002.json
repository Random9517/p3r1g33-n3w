		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あぁ……やだ、隙間から漏れちゃう……私、はしたない……んんっ、よいし\nょっ……あふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004306" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「すみません、ちょっと……結び目が絡まっちゃったみたいで……ゆっくりほ\nどいていただけると助かります……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004307" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ごめんなさい、最後まで色々とお手数をお掛けして……でも、今回のことは\nとても大きなヒントになりました！」", "NORMAL" ]},

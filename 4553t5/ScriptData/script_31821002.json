		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふぁぁぁぁっ！　あぁっ、また……中出しっ……ザーメンっ……どぷどぷっ\n、流れて……来てますぅっ！」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「どうですかっ？　オチンポ……んっ、しっかり、ヒダヒダに食い込んでます\nか……？　んはぁっ……はいっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「縄の食い込みと……同じくらいにっ……んっ、しっかり……オチンポ食い込\nませて……あぁっ、はい、私も……気持ちいいですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「身体動かせなくなるだけで……こんなに、ドキドキして……全身感じやすく\nなるなんて……思わなくて……」", "NORMAL" ]},

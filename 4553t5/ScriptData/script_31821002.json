		{"command":[ "SETCHARA", "0", "char_00018210_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「えっ……どうして縛られてるのかですか？　はい、これにはとても深い事情\nがありまして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004102" ]},
		{"command":[ "SETCHARA", "0", "char_00018210_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「実は今日のご相談にも関わることで、あの人との夜のことなんですけど……\n最近、またちょっとご無沙汰になってしまって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004103" ]},
		{"command":[ "SETCHARA", "0", "char_00018210_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「もちろん、あの人は、今とても忙しくて……なかなかその気になれないとい\nうのは仕方ないと分かってるんですよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004104" ]},
		{"command":[ "SETCHARA", "0", "char_00018210_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「でも、私自身ももっと頑張って、喜んでもらいたいなと思って……昔の制服\nを準備したんですけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004105" ]},
		{"command":[ "SETCHARA", "0", "char_00018210_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ただ、それだけだと、もう少し弱いかなと思いまして……それで、思い切っ\nて自分のことを縛ってみました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004106" ]},
		{"command":[ "SETCHARA", "0", "char_00018210_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「という訳で……今日は、この状態で……私のことを存分に責めていただける\nと嬉しいです……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004107" ]},
		{"command":[ "SETCHARA", "0", "char_00018210_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あぁっ……こ、これが私の今の……姿……鏡に全部映されちゃってます……\n制服姿で縛られているところ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004108" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……あぁ……お、思っていたより、ずっと……ドキドキしちゃい\nますね……これ……すごく、いやらしい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004109" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「だって……あぁ……こんな、身動きが取れないのに……とても無防備な姿を\n晒して……はぁぁ……あっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004110" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「後ろからオチンポが当たってます……んっ、私のことを責めたくて……イラ\nイラさせてしまってるんですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はい……も、もう待ちきれません……♪　どうか、貴方の太くて逞しいオチ\nンポ……オマンコに下さい……もう濡れてますからぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「発情した、いやらしいドスケベオマンコに……オチンポぉ……早くっ、早く\nぅっ……あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……んっ！　あぁっ、太いのが……ずぶって入って来ますっ……んく\nぅぅっ、あぁぁっ……中……広がるぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004114" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「一気に根元まで届いちゃいました……んっ、熱いのドクンって脈打ってるの\n……感じ……ますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004115" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「マ、マゾ……？　ち、違いますよぉ……これは、私が……夫のために、頑張\nろうって……その予行演習みたいなもので……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004116" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、こんな……縛られて……興奮してるなんて……そんな、ことぉ……あ\nっ、はぁぁんっ、た、確かに……濡れてますけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「それは……んっ、あぁ……貴方のオチンポが……とても逞しいからで……私\nが欲しがりだというわけでは……あっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「嘘っ……あっ、嘘ですっ……ホントは……ずっとオチンポが欲しくてっ、ウ\nズウズさせてましたっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004119" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「いっぱい、オマンコに欲しくて濡れてしまってるのっ、誤魔化してごめんな\nさいっ、だから、オチンポ抜かないで……もっと下さいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はひっ、あぁっ、あぁんっ、ありがとうっ……ございますっ！　はんっ、あ\nぁっ、あぁぁ……オチンポ奥まで届いてますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004121" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev182_10b_0000", "ev182_10b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んくぅっ、はぁぁ……身体を自由に動かせないのが……こんなに、ドキドキ\nするなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、そこっ……あっ、あぁっ、おっぱいも……あぁっ、ぐちゃぐちゃに揉\nみしだかれっ……んふぅっ、乳首……ツンってしこって来てますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んんっ、あぁ……縄が食い込むぅ……ぎゅって締めつけられるの……あぁ…\n…キツくて、少し痛いのに……ドキドキして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「もっと、激しく動かして下さい……先生……いけない生徒のオマンコを……\nたっぷり教育して下さい……はひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、あぁぁぁっ、激しいですっ！　中でっ、オチンポズボズボっ\n……！　めり込んで来ますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004126" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はいっ、あぁっ……私は、授業中も先生に縛られることを考えて……ずっと\nオマンコを発情させていた、いけない生徒ですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「先生からのっ、躾を心待ちにしてぇ……ああっ、オチンポの躾っ……素敵で\nすぅっ、あぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はっ、んふぅっ、あぁぁ……そんなマゾの素質なんて……そんな、そんなこ\nとぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はふぁ……でも……そ、そうかも知れません……ですから、もっと教育を…\n…いけない私にお仕置きして下さい……あぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、あっ、あぁっ、ワイルドに……されてるっ♪　あの人もこん\nな風に……燃えてくれるのかしらっ、あっ、あぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004131" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ご、ごめんなさいっ……今は……先生のことだけ考えますっ、あぁっ、もっ\nとオチンポ抉って下さいっ、いっぱいオマンコしてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁっ、反省の……エキスっ、欲しいですっ……中にっ、欲しがり\nのオマンコにっ、直接っ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あぁうっ、ズボズボっ、突き回されてっ……あっ、いくっ♪　オマンコもう\nイキますっ！　欲しがりマンコっ……イクっ、イクぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んふぁぁぁぁ……なかぁ……射精っ、来てますっ……あぁっ、中出し……さ\nれてぇっ……はぁぁぁぁぁん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004135" ]},
		{"command":[ "STOPANIM", "0" ]},

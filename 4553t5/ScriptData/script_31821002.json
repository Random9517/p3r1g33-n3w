		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あぁ……さっき、あんなに出したのに……まだ、こんな勢いで出すなんて…\n…あぁっ、イってる……私……ずっとイッてますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁ、ふぁ……はへぁ……あぁ……はい、先生の教育で、ちゃんとオマンコ\n反省しましたぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004303" ]},
		{"command":[ "SETIMAGE", "0", "still_00018210_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「全部……中で受け入れましたから……許して下さい……これ以上はオマンコ\n……もう……入りません……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はふっ……終わりましたか……？　射精……何とか落ち着きましたね……ん\nっ、ふぅ……すごかったです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004305" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「熱い……はぁぁ……制服が汚されて……あぁ、私……先生に染められてます\n……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1004402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はい……全部受け入れます……私が悪かったんですから……あぁ、オチンポ\n教育ありがとうございます……んふぅ……」", "NORMAL" ]},

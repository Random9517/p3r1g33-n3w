{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「わざわざこんなところに呼びだして……。まあ、おまえさんの考えはお見通\nしだがね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403101" ]},
		{"command":[ "SETCHARA", "0", "char_00001004_01", "3", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「わしは鼻が利くんだ。ここから発情したニオイをぷんぷんさせているのを、\n隠せていると思ったかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403102" ]},
		{"command":[ "SETCHARA", "0", "char_00001004_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ま、わしの姿に魅了されたということだろう？　悪い気分じゃないね、こう\nいう本能丸出しの反応をされるのも」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403103" ]},
		{"command":[ "SETCHARA", "0", "char_00001004_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「気分がいいからね、いろいろとサービスしてやるよ。おまえさんにも世話に\nなってるしね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403104" ]},
		{"command":[ "SETCHARA", "0", "char_00001004_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「まずはちんぽとご対面といこうかね。あんっ、すごいじゃないか……もうこ\nんなに勃起しているぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403105" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「どうやら、わしの姿にだいぶ欲情を煽られていたようだねぇ。ほらほら、ど\nうだい？　おまえさんがず～っと見ていた、わしのおっぱいだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「眺めているより、こうやってちんぽを挟まれるほうがいいんだろう？　んっ\n、ちんぽも嬉しそうに、胸の間で跳ねているよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「もっとしっかり、胸を押しあてて……っと、このまま上下に、動かしてやろ\nうか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403108" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、ふふっ、どんどんちんぽが熱くなってくね……ああっ、ビクビクと震\nえるのも感じるよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403109" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「熱いちんぽが、乳にこすれる……。んっ、わしの身体も、昂ぶってきてしま\nうね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「男がわしの乳に夢中になっているようすを見るのはたまんないよ……んっ、\nますますその顔を、蕩けさせたくなっちまうね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403111" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「こうして……れぇ……っと、よだれを垂らしてね……んっ、どうだい？　ま\nすます胸が、密着するようになるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403112" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「唾液ローションでたっぷり谷間を濡らしてやれば……乳を動かす度に、くち\nゅくちゅいやらしい音もしてくる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、んふっ、上下に……交互に……。ちんぽをこね回すパイズリ……気持\nちよさそうじゃな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403114" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ちんぽが大きくなっていって……わしの谷間から真っ赤になった亀頭を覗か\nせて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「鈴口からはトロトロと先走り汁まで垂らしている……。もう、イキそうにな\nっているのかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「だめだねぇ、もっと我慢してもらわないと。根性見せな。これしきのことで\n射精するようなタマじゃないだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403117" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「この格好のわしが魅力的だからって……。パイズリだけでヒィヒィ言ってい\nたら、この先の刺激に耐えられぬぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んふぅ……ちゅぅ……。腰をビクつかせずじっとしていろ。フェラチオ、で\nきんじゃろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403119" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んちゅぶ、れろ、れぇろぉ……っ。いろいろサービスしてやると、言ったで\nはないか……ちゅぶっ、ちゅちゅぅ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「おまえさんの、亀頭……ちゅぶっ、パイズリしながら、舐めまわさせてもら\nうからね……ちゅ、ちゅ、ん、れろぉ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403121" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「どんどんよだれが、れろん、溢れてきて……んっ、べろぉ、ちんぽがますま\nす、ぬるぬるに、濡れてしまうね……れろ、れろぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「竿への刺激も、気持ちいいだろう？　んっ、少々、濡らしすぎたかねぇ。で\nも、ぬるんと滑って、ちんぽを逃がすようなことはしないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403123" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、んんっ、ちゅぶっ、ちゅ、ちゅぅ……っ。腰が抜けるほどの快感、味\nわわせてあげるからね……んっ、れろろぉ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「胸も……んっ、んふっ、ちんぽから精液を搾るみたいに……ぎゅっとね……\nはぁ、んっ、んん……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ますますちんぽが、びくびくと大きく震えるようになって……んっ、射精が\n近そうだね……れろ、れろぉ……どうなんだい……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403126" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ほれほれほれっ、自分から呼びだしておいて、我慢なんかしようとしている\nんじゃないよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「れぇろっ、んっ、ちゅぷっ、先走りの味も濃くなって……んっ、射精寸前と\nいったところかねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403128" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「最後は思いっきり、ちんぽに吸いついてやるから、んっ、じゅるるるぅっ！\n　ほれっ、だしてしまいなっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403129" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んふっ、んっ、んっ、んん……っ！　じゅずずぅっ、んっ、んじゅぶっ、じ\nゅぶぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403130" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、んんぅうううぅぅぅっ！！　んふっ、ん……っ、口の中……にぃ……\nだしたなぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、んくっ、おまえさんの、くっさい精液が……じゅずずっ、わしの口を\nいっぱいにしていく……んっ、んふふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403132" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「せっかくじゃからなぁ。じゅるるっ、だされたものは、しっかり吸いだして\n……じゅずっ、飲みこんでやろう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、んん……じゅるるっ、ごく、ん、んくぅ……っ！　ねばっこい精液じ\nゃなぁ……んっ、喉が詰まりそうじゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403134" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んはぁ……っ。ほら……飲みほしてやったぞ……？　ふふっ、ん、ちゅ、ち\nんぽについている精液の残りも……舐めとってやるか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403135" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ん……れろれろ、お掃除フェラというやつじゃな……。ちゅっ、こんなこと\nされるのも、おまえさんにとってははじめてじゃなかろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403136" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「元気すぎるちんぽじゃなぁ……。れろ、れろぉ……。まだまだ、こんなにガ\nッチガチにさせて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403137" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「それとも……ちゅぶっ、わしのおそうじフェラのせいで、また興奮させてし\nまったか？　ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403138" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「これならまだまだ……今度はわしが楽しめそうじゃ……。次はおまえさんが\n、わしにサービスしてもらおうかね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「おまえさんの精液、もう一杯いただくとするよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁ……もっ。ん、じゅるるぅ……っ！　さっそく、ちんぽを咥えさせて、\nもらおうかね……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んふっ、じゅるっ、じゅぷっ、じゅぷぷぅっ！　またちんぽが、口の中で膨\nらんでくね……んっ、じゅぱっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「咥えた口の中で……んっ、舌も動かして……じゅぷっ、亀頭を舐めまわされ\nるのが、そんなに気持ちいいかい……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「情けない顔になってるじゃないか……んっ、じゅるるっ、口での快感に夢中\nになってると……こうだよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403204" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ほらほら、んっ、じゅぷっ、おまえさんのちんぽは、わしのおっぱいに挟ま\nれているんだからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「しっかりとおっぱいで押さえつけながら、じゅるるっ、ちんぽには、たっぷ\nりフェラチオしてあげるよ……んっ、じゅぶっ、じゅぶぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403206" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、ふふっ、わしだってねぇ、おまえさんのケダモノじみた視線で、むら\nむらとしてたところだったんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「お互い、発情（サカ）っちまった同士、んっ、じゅるるっ、丁度いいじゃな\nいか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403208" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「さっき精液を飲んだおかげで、ますます気分が高揚しているところさ……ん\nっ、じゅるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「わしのテクで、んっ、じゅぷぷっ、またすぐに射精させてやるからね……じ\nゅるっ、じゅるっ、じゅぷっ、じゅぷぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403210" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ガッチガチになっている竿も、んじゅるっ、しっかりとしごいてやろうじゃ\nないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「唾液と精液のおかげで、乳の柔肌が吸いついてくるような心地がたまらんの\nじゃろう？　んっ、またちんぽが、ビクついて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「また、イキそうか……？　んっ、じゅぱっ、いいぞ……おまえさんの好きに\nイッてしまえばいいさ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403213" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「わしも、しっかりと堪能させてもらうからな。おまえさんが、またたっぷり\n射精してしまうところを……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んふっ、じゅる、じゅる、じゅぷぷっ！　ほれ、ほれ、ラストスパートじゃ\n！　んっ、じゅるるっ、精液を、だしてしまえっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403215" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「腰がまた、震えておるぞ。また我慢しておるのか？　変に意地を張らずにだ\nしてしまえばいいものを」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403216" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「じゃがまあ、そのほうが張りあいもあるか。んっ、じゅるるっ、じゅぶっ、\nじゅぶっ、じゅぶじゅぶじゅぶぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ちんぽが、破裂しそうじゃな……んっ、じゅぷっ、ほれ、だしてしまえ……\nんっ、おまえさんのいいように……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403218" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「じゅぶっ、じゅぶっ、じゅずずっ、んっ、じゅぷぅっ！　んっ、じゅる、じ\nゅる、じゅぶぶっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「精液っ、だ、だしてしまえ……んじゅるぅっ、ちんぽから、んふっ、好きな\nだけ……じゅるるっ、じゅぷぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403220" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_09" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んふぅうううぅぅぅっ！　んっ、んぶぅうううぅぅぅううぅぅ～～～～っ！\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ん……ふふぅ……。じゅる、じゅる……じゅるるぅ……っ。また、すごい量\nじゃないか……えぇ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403302" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「２度目だっていうのに……濃い精液を、たっぷりとわしの口に……。ふふっ\n、若い男のちんぽは、本当に元気じゃなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んふっ、まだ、口の中で脈打って、精液をだしておるぞ……。じゅるるっ、\nしっかり全部、飲みほしてやるとするか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、じゅずず……っ！　尿道に残っている精液も、吸いだして……んっ、\nごくっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403305" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……。どうじゃ……？　おまえさんの精液、飲んでやったわ。ふふっ\n、他でもないおまえさんの精液じゃ。これくらいしてやるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403306" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「どうした……？　まだまだヤりたりなさそうじゃな……。そんなことない？\n　遠慮しなくていいんじゃぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403307" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「まだこんなにちんぽを硬くさせておいて、もう射精できないなんてことはな\nいじゃろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「おまえさんはまだまだ若いんだから、もっと射精した方が身体にもいいと思\nうぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ふふっ、年寄りのいうことは聞いておくもんじゃ。さ、まだまだた～っぷり\n、精液を搾ってやろうかね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403310" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ！？　ちんぽが口から抜けた……っ、ああっ、精液っ、んっ、んくぅう\nううぅぅぅっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_18" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、精液が……っ！　んっ、わしの顔……身体にぃ……っ！　あ\nあっ、たくさんかかる……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、２回目なのに、ゼリーみたいな濃い精液が……っ！　んっ\n、勢いよく、飛び散って……あっ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「この匂い……っ、キツい、オスの匂い……っ！　た、たまらないね……はぁ\n、はぁ、頭がどうにかなりそうだよ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。まったく、なにを考えているんだか……。せっかくのド\nレスをこんなにして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「わしのパイズリフェラが気持ちよすぎたせいだって？　ふん、いまさらそう\n言って、機嫌を取ろうとしたっておそいよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403406" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「でもまあ……そう言うんだったら、わしにも考えがあるかね……。ん……ち\nゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ちゅ、ちゅるる……っ。ほら、おまえさんが褒めたパイズリフェラ……もっ\nと、味わわせてやるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403408" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「おまえさんの、元気すぎるちんぽを、ちゅぶっ。れろろっ。ちょっと躾けて\nやらないとね……ちゅっ、べろぉんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0403409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「このあとは、わしが満足するまでつきあってもらうから。ちゅぶっ、覚悟し\nておくんだよ？」", "NORMAL" ]},

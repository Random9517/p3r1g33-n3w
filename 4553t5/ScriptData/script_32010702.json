		{"command":[ "SETIMAGE", "0", "still_00020107_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「快感が、背筋を駆け抜けて……っ、んっ、くうっ、腰が抜けてしまいそうだ\n……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「こんなに興奮してしまうのは、ここがお前の部屋だからかもしれないな……\n」", "NORMAL" ]},

		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「こうしているうちに、だんだんと眠たく……ん？　どうやら、それどころで\nはなくなってしまったようだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704104" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「母の身体にあたっているこれは……。寝る前だというのに、勃起させてしま\nったか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「ふふっ、恥ずかしがる必要は無いぞ。元気なのはいいことだからな。だがこ\nのままでは眠れないだろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704106" ]},
		{"command":[ "SETIMAGE", "0", "still_00020107_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「こういうときは、軽く運動でもすればいいと聞く。母に任せておけ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「ああ……こんなにガチガチに勃起させてしまったか……。これはやはり、射\n精してスッキリしなければ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704108" ]},
		{"command":[ "SETIMAGE", "0", "still_00020107_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「母の寝かしつけ方が悪かったのだろうか……。だとしたら、責任をとらない\nといけないな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「母が、お前のことを欲情させてしまったのだろう……。ああ……勃起チンポ\nを、母の、オマンコへ……」", "NORMAL" ]},

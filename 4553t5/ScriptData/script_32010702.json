		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「んっ、くっ、腰を弾ませるたびに……ああっ、チンポがオマンコを、ごりご\nりとこすっていく……っ！　んっ、あっ、ああっ！」", "NORMAL" ]},

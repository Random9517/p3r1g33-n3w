		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「いまの私は、どこにでもいる息子専用オナホ母なのだから……。んぁあっ、\nお前の……好きなように……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},

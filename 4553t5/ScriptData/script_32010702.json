		{"command":[ "SETIMAGE", "0", "still_00020107_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「お前と、普通の母として、こうしてベッドの上で交わっているからかもしれ\nない……」", "NORMAL" ]},

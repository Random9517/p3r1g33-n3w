		{"command":[ "SETIMAGE", "0", "still_00020107_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「本気汁で、んっ、チンポをベトベトにしてしまってる……っ！　んっ、ああ\nっ、繋がっているところに、視線……感じるぅ……っ！」", "NORMAL" ]},

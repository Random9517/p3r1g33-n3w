		{"command":[ "SETIMAGE", "0", "still_00020107_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「ん……く……っ！　は、入ってくる……お前の、チンポが……ああ、大きい\n、息子チンポ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704111" ]},
		{"command":[ "SETIMAGE", "0", "still_00020107_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。どうだ……？　母のオマンコ……しっかりとお前のチン\nポを咥えこんで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704112" ]},
		{"command":[ "SETIMAGE", "0", "still_00020107_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「いやらしく、ひろがっているところも、よく見えるだろう……。お前と、母\nが……繋がってるところも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「んぁっ！　チンポが跳ねて……っ！　ふふっ、興奮させてしまったようだな\n……だが、そのほうがすぐに、射精できるだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「んっ、ふぅ……。このまま、腰を動かして、チンポを気持ちよくしていくぞ\n……。んっ、んくっ、あっ、ああ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704115" ]},
		{"command":[ "SETIMAGE", "0", "still_00020107_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「感じて、くれているだろうか……。んっ、くっ、母のオマンコが、チンポを\nしっかりと締めつけている……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_0704116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "トキノ" ]},
		{"command":[ "SETTEXT", "「母の、オマンコの温かさ……蠢き……。いっぱい、感じてくれ……んっ、あ\nあっ、母も……チンポを感じる……っ！」", "NORMAL" ]},

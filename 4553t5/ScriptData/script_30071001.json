		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ん……じゅる、じゅちゅちゅぅ……っ。オチンポを、搾りながら……ちゅぅ\nっ、吸いついて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んっ、んじゅずずっ、尿道に残っているザーメンまで……残さず飲み尽くし\nてやるからな……ずずっ、ずずずぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ん……ぷは……っ。ほれ、余の口を見よ。お主のだしたオチンポ汁じゃ……\nいまから……のみこむぞ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んはぁ……はぁ……。ご……っ、くんっ♪　ぶはぁっ、たまらんのう、この\n青臭さ……。若い男のザーメンは格別の味じゃ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「そのうえ、お主のような男が、我慢の限界だと喘ぎながらだすものはとくに\nいいものじゃな。くふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「なんじゃぁ……？　口では詫びながらもオチンポはまだまだ勃起して、ヤり\nたがっておるなぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「余もまだまだ満足しておらぬからなぁ。お主にはまだまだ余の戯れにつきあ\nってもらおうかのう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んぶっ！？　オチンポが口から……んはぁっ、ああっ、精液……でてしまっ\nているではないかぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_18" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ひゃぁっ、ああっ、顔に……っ！　余の顔に、んっ、精液がかかるっ、んく\nっ、飛ばしすぎじゃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、顔だけでなく胸まで精液でドロッドロではないか……。お主、\n余の美貌をザーメンまみれにするとは、いい度胸じゃのう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_17" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。鼻にまで精液がかかったせいで、呼吸の度にくっさい精\n液のにおいに脳が痺れてしまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んんっ、まだビクついて、精液が……。オチンポから、垂れておるではない\nか……んちゅ、じゅるるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「先ほどに負けないくらいの濃さ・量の射精……。それを余に、散々ぶっかけ\nおって。さて、これはオシオキが必要かのう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ん～？　余の美貌を前に、我慢ができなかったとぬかすのか？　ほぉう……\n。ま、そういうことなら許してやらんでもない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_18" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「この姿でサービスしたのだからな。お主にも、それなりの反応をしてもらわ\nんと、こっちとしても面白くないわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「この姿での奉仕……お主のオチンポはすっかり気に入ってくれたようじゃな\n。あんなに射精したのに勃起しっぱなしではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ああ、気にせずともよい。余ももっとお主の反応を楽しみたいところじゃか\nらな。くふふ、もっとイイ反応をみせてくれよ？」", "NORMAL" ]},

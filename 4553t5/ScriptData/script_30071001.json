{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「よく来たのう。なんじゃ、そんなに警戒することもなかろう。余とお主のナ\nカではないか、なぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003101" ]},
		{"command":[ "SETCHARA", "0", "char_00000710_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「くふふっ、なにをするかって、決まっておるではないか。久しぶりにこの姿\nになったのじゃからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003102" ]},
		{"command":[ "SETCHARA", "0", "char_00000710_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「この姿で、お主のオチンポへ奉仕のひとつでもしてやろうかと思ってなぁ。\nどうじゃ？　お主も……ヤりたくなってきたじゃろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003103" ]},
		{"command":[ "SETCHARA", "0", "char_00000710_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「オチンポの方は……正直じゃな。なに、遠慮する必要はないぞ。余がしてや\nると言っているのだからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003104" ]},
		{"command":[ "SETCHARA", "0", "char_00000710_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「日頃がんばっているお主への褒美じゃ。このバッキバキに硬くなったオチン\nポを労ってやろう。……たっぷりとな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003105" ]},
		{"command":[ "SETCHARA", "0", "char_00000710_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「さてと……しっかりオチンポは勃起しておるなぁ。余の身体にずいぶんと興\n奮していると見える」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ふふ……しっかりとオチンポを挟めているじゃろう？　小さい姿ではこうい\nうプレイは難しいからなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んっ、ほれ……さっそくしごいていくからな……。ガチガチの、勃起オチン\nポ……どうじゃ……余のおっぱいは……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「大きさについては……まあまあだろうが、形とやわらかさには自信があるか\nらな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「こうやって、しっかりオチンポを捕らえて上下させれば……くふふっ、腰が\n震えているではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「余がパイズリをする姿に興奮しているのか？　よいぞ、どんどん興奮して、\nオチンポをもっともっと硬く滾らせるのじゃ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「余計なことは考えず、余のパイズリを楽しむがいい。余も、このオチンポの\n反応を楽しませてもらうからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「普段の、ダメダメな様子からは想像つかない勃起オチンポ……。ビクビクと\n脈打って、先っぽもパンパンじゃな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「隠しきれないオスの……ケダモノ臭も……。はぁ……余を昂ぶらせる……。\nもっと刺激してやろうかのう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ビンビンのオチンポ……パイズリだけではなくフェラチオもな……。ん、ち\nゅ……むちゅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「やらしい味だのう……んちゅ、ちゅぴ、じゃが……これがなかなかクセにな\nる味で……んっ、ちゅぅ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ほれほれ……んっ、おっぱいでオチンポをしごきながら……んじゅるっ、舌\nでもサービスじゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ん……れろれろ、ちゅ、んちゅ……じゅちゅちゅぅ……っ！　どこがイイの\nか言ってみるがよい。エラか？　裏筋か？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「尿道口を、んじゅるっ、舌先でほじってやろうかのう？　んれろろろっ、れ\nろろっ、んっ、れろろろぉっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んんっ！　そんなに腰をあばれさせるでない。落ち着いてパイズリフェラが\nできぬではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「それとも、余のテクニックがすごすぎるあまり、あっという間にイキそうに\nなったか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「オチンポはますます膨れあがって、亀頭もはち切れそうじゃ……。ぬふふっ\n、いま、ラクにさせてやるからのう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んれろ、れろぉ……っ。オチンポ、もっとよだれをまぶして……んじゅるっ\n、じゅるるぅ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「パイズリ……しやすくなったのう。ほれ、ほれほれ。ずりずり、にゅるにゅ\nると、オチンポをしごいてやるからのう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んっ、じゅるるっ、余のおっぱいと口で……んはっ、腰が蕩けるほどの快楽\nを、味わわせてやるからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んむっ、んむっ、じゅるるるる……っ！　んっ、んじゅぷっ、じゅぷっ、じ\nゅちゅちゅ～～……っ！　んっ、んふっ、んふふぅ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「先走りが、溢れてくるのう……。んっ、じゅるっ、口いっぱいに、お主のい\nやらしい汁の味が広がるのじゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ほれ……このオチンポからでるのは、先走りだけではなかろう？　んっ、じ\nゅるるっ、射精……してもいいのじゃぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「オチンポの奥で、んっ、じゅるっ、煮えたぎっておる……濃厚オチンポ汁ぅ\n……んっ、じゅるるぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「余が、んじゅるっ、パイズリとフェラチオで、搾りだしてやるから……んっ\n、はぁっ、はぁっ、だすのじゃ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んふぅううっ！　んぅっ、んっ、んん～～～～っ！　んはぁっ、あっ、ああ\n……っ、んっくぅううぅぅ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んはぁっ、でておる……っ。口の中に、ンッ、精液……っ。んじゅるっ、大\n量じゃな……んっ、んじゅる……じゅる……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「口の中に、くる……精液……っ。しっかり、飲んでやるからな……んじゅる\nるっ、じゅずっ、ずずず……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んふっ、情けない声をだしおって……。尿道のなかの精液を啜られるのが、\nそんなに気持ちいいか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「お主みたいな男の精液は、しっかり飲み干してやらないとな。そっちのが、\n面白い反応をするじゃろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「それにしても、節操なく射精したのう。口に収まりきらなかった精液が、お\nっぱいにこぼれてしまって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ほれ、どうじゃ？　ザーメンローションで、いやらしく濡れた余のおっぱい\nは……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「オチンポが全然萎える気配がないのう。お主もまだまだヤりたりないという\nところか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「よいぞ。せっかくじゃし、お主のオチンポともっと遊んでやろうかのう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「途中で萎えたりなんかしたら、承知せんからな？　しっかりオチンポをおっ\n勃て続けるんじゃぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ほれ、ほれ、このまま……女王のパイズリフェラで、もうひと抜きしてやる\nからのう、んっ、ちゅ、ちゅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「まだまだビンビンの、スケベオチンポめ……んちゅちゅっ、あれほど射精し\nたのに、まだ足りぬということじゃな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ならばもっと……くふふっ、これだけぬめっておれば、多少激しくしても問\n題なかろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ほれ、こうして、先ほどよりもぎゅうっとおっぱいをオチンポに密着させ…\n…っ！　竿ごと、こねるようにしごいてやるのじゃ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「それだけじゃないぞ……んっ、ちゅぅ……っと、先端はよだれたっぷりの舌\nで、舐りまわして……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ん……はむぅ……。んじゅるっ、じゅちゅちゅ……ちゅる、ちゅる……んっ\n、ちゅちゅ……じゅぷぅ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「本当に、お主と、オチンポ……いい反応をするのう……。んっ、じゅるるっ\n、ほれ、こういうのはどうじゃ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んっ、んむっ、じゅるる……っ！　パイズリフェラ、しながら……んっ、じ\nゅるっ、しっかりお主のこと……見つめて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「じゅぷ、ンッ、目をそらすでないぞ……じゅるるっ、お主のイキ顔まで、し\nっかり……じゅるるっ、見ておるからなぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んむっ、余の顔をみて、じゅぷっ、オチンポがますます硬くなった……んっ\n、じゅるるっ、興奮しておるな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「その視線……じゅるるっ、余の身体まで、熱くなってしまうではないか……\nんっ、じゅる、じゅぷ、じゅぷぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「お主のオチンポ相手に……本気で発情……夢中になって……。んっ、じゅる\nるっ、パイコキ……フェラ抜き……してしまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んふっ、んっ、んじゅる……んむっ、じゅちゅぅ……っ！　んっ、んっ、よ\nだれが……じゅるっ、ん……じゅちゅちゅぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、さらにオチンポが……じゅるるっ、んっ、ビクついて、精液が\n急ピッチでつくられているのが伝わってくるようじゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「また、それを余に向けはなってよいのだぞ……？　んっ、じゅぷっ、こんな\n機会、もう二度と来ないかもしれないからなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ほれほれ、こっちはもっとペースをあげていくぞ。お主をまたイかせるため\nにな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「しっかり、お主の顔をみておるぞ。んっ、じゅぷっ、またイクところを……\n射精するところをみせるのじゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んふっ、じゅぷっ、じゅぷっ、じゅぷぅっ！　オチンポ……もうたまらんと\nいうふうに……暴れて……限界そうじゃのう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000710_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「よいぞ……んっ、じゅぷっ、余のテクの前で、我慢しようというほうが無駄\nなのだから、な……んっ、ちゅちゅぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「ほれ、とどめじゃ。イッてしまえ。余の前でまた……んっ、じゅぶじゅぶじ\nゅぶぅっ、射精ぇ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003220" ]},

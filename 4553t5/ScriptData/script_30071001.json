		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んむぅ～～～～～～っ！　んぅ、んっ、んぐ……っ！　んふぅうううぅぅぅ\nううぅぅうぅ～～～～っ！！」", "NORMAL" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「んっ、むぐっ、またすごい量を……んじゅる、じゅるるぅ……んっ、く……\nんぐ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_007_1003302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ルナルバース" ]},
		{"command":[ "SETTEXT", "「余の奉仕が、よっぽど気持ちよかったようじゃのう。しっかりと最後まで、\n面倒をみてやるとするか……」", "NORMAL" ]},

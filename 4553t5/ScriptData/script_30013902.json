		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁぁぁぉ……熱いの……中にいっぱい……出てっ……んひぃ……こんな、\n気持ちいいの……お、おかしくなるぅぅ……んんんぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁぁ……はへぁ……あぁっ、また、ドプッて……！　続けて……出てるの\n……止まらない……あひぃ……子宮……届いてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んふぅぅ……はっ、ふぁぁ……あぁぁ……終わった……すごかったぁ……オ\nマンコ……幸せぇ……はへ……はひぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……あぁ……精液……垂れてしまいそうだ……もう少し、このま\nま……栓をしていてくれ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……この感触……受精しただろうか……いや、例え妊娠していな\nくても……こんな風に愛されたことが嬉しい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それにしても、好きにしろと言ったが、ここまでされたら私としても言いた\nいことはあるぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904409" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そうだ……これからも、私の側にいることを命じる。ちゃんと責任を取って\nもらうからな……？」", "NORMAL" ]},

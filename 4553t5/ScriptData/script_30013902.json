{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0251" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00000139_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev01_39b_0000", "ev01_39b_0023" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふぅ……華やかな祝いの席というのは、悪くないが……少し疲れたな……お\nい、下僕。私を部屋まで連れて行け」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904101" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「どの部屋……私の部屋に決まっているだろう。疲れたと言ったのが聞こえな\nかったのか？　つべこべ言わず連れて行け！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904102" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「バ、バカ者！　別におんぶまでしろとは言ってない！　とにかく、普通に手\nを引けばいいのだっ。少しは考えろ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904103" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETIMAGE", "0", "bg_0211" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ……やれやれ、静かになった。客との挨拶も一通り終わったし、義務は\n果たしただろう。とにかく休憩だ、休憩」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904104" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "1", "CENTER", "0" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「おい、何を出ていこうとしている。別に邪魔じゃない……いいから、まだそ\nこにいろ。分かったな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904105" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「全く……せっかく二人になったんだ……もう少し察しがよくてもいいだろう\nに……ああ、何でもないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904106" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「まぁ、その……なんだ。色々と無茶を言ったが……よく応えてくれているな\n。その……礼を言うぞ。あ、ありがとう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904107" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「別に酒に酔ってなどおらん！　何だ？　私が日頃の感謝を伝えるのがそんな\nにおかしいか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904108" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「その……いつも思っていることではあるのだ……私の側近が、生半可なこと\nでは務まらぬことは自分でも理解している……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904109" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だから、しぶとくついてくる貴様のような存在は貴重だと……そ、それでだ\nな……今まで掛けた苦労に私も報いねばならん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904110" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だから、そのだな……私の身体を……す、好きにしていいぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904111" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それは……その、つまり……そのままの意味だ。どうなんだ……？　私のこ\nとを……抱きたいと、思っているんじゃないのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904112" ]},
		{"command":[ "SETCHARA", "0", "char_00000139_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それを……許すと……言っているんだ。ほら……こ、こっちに来い……その\nまま、私を……押し倒せっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ……！　うぅ……あ、あんまりジロジロと見るんじゃない。私にも、恥\nじらいというものはあるんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},		
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ドレスが似合ってる……？　う、む……まぁ、な……貴様に半分脱がされて\nしまっているが……あ、ありがとう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「キス……あぁ……してくれ……んっ、ちゅっ……んちゅぷ……あ……んっ、\nむっ……あぁ……そうだな、緊張しているかも知れん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「別に……初めてという訳でもないのに……どうして、こんなに落ち着かない\nんだろうな……これは、あくまで褒美というだけなのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……今日は……じっくりするのか……んんっ、あぁ……許可を取\nる前に、もう触っているだろう……お、おっぱいとか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……あぁ……乳首……あ、あんまり遊ぶな……いつの間にか、硬\nくしこって……は、恥ずかしいんだからな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ……はっ、あっ……ふっ……あぁ、そうだ……濡れている……もう、準\n備は整っているから……貴様はどうなのだ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うぁ……聞くまでもない……か。それなら……入れてくれ……はっ？　もっ\nと、甘えたおねだり……？　バ、バカ者っ……そんなことっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「い、いや、絶対に駄目ということでは……これは褒美なのだ、確かに要望を\n聞いてやる位はしなくてはならん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「一度だけだからな？　あ、貴方の……太くて……逞しいオ、オチンポを……\n私の、オ、オマンコに……入れて下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「このいやらしいオマンコは……貴方のオチンポが欲しくて……ずっと濡れて\nいます……うぁ……ダメだ……恥ずかしい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「も、もういいだろうっ？　早く……オチンポを入れてくれっ……こ、ここだ\nっ……この、オマンコにっ……オチンポ……早くぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んんんんんんんんっ……！　はっ、あぁぁぁぅんっ……！　あっ、あ\nぁぁ……入って……来てる……んんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁぁ……んっ、深い……あぁ、オチンポが……ゆっくり、少しずつ……オ\nマンコにめり込んで……来てる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁ……熱い……体温が一気に上がって……はぁ……はぁ……風邪を引いた\n時みたいに……ボーっとしてる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「オ、オマンコの中心から……熱が広がって……全身に巡って……あぁ……す\nごい……こんな、ドキドキ……するぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……くぅぅ……んっ、ふっ……い、いっぱいまで入ったのか？　あぁ\n……分かる……貴方のオチンポが……奥に届いてるのが分かる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904130" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「よ、呼び方……？　それは……おねだりの時に……貴方にしろって……そう\n言ったから……何か、おかしかったのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「もしかして……照れくさいのか？　ふふっ、私に恥ずかしいことをさせたん\nだから、そこはちゃんと受け止めてもらわなくてはな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ……あぁ……そんなことを言ってるうちに……完全に埋め込まれてしま\nったな……中で……ビクビクしてるのが……何となく分かる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁ……私も、ずっとこのままでは……もどかしくて堪らない……そろそろ\n動いてみてくれ……あっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、くぅぅぅっ……はっ、ふぁっ……あっ、あぁっ……ゆっくり\n……抜けて……ま、また入って……んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904135" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev01_39b_0000", "ev01_39b_0023", "true", "ALL" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ペースは、これで……いい……んっ、ゆっくりでも……すごく、気持ちいい\n……オチンポ……はっきり感じるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うんっ、あぁ……そうだ……中のヒダを、丁寧に……擦り上げる感じが……\nいい……今みたいなのだ……横の部分を広げるみたいに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ……んんっ、あぁ……流石に……分かってるな……私の感じやすい場所\n……しっかり把握されている……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ここも、最初から……感じやすかった訳じゃないぞ……？　まだ、ぎこちな\nい動きだった頃……単調な動きで……何度も同じ所に当たって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ちょっと痛い位だったのが……少しずつ慣らされていって……んんっ！　だ\nんだん……好きにさせられていって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「今では……んんっ、期待して……オマンコが……準備するようになっている\n……はぁ、濡れやすくなって……奥で、キュンと窄まって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ、ふっ……！　その、奥に近いところの……Ｇスポットぉ……そこも\n……貴方が仕込んでくれた場所ぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「浅めの場所を何度も擦られてから……焦らすだけ焦らされて……あひっ！　\n時々っ……ぐいって押し込まれるとぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁっ、我慢したくても……声が……出るっ……！　はしたない喘ぎが……\n漏れて、しまうっ……はっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「もっと……聞きたい……？　んっ、ふっ……可愛いだなどと……そんな言葉\nで私が喜ぶとでも……あぁ、あんっ、はっ、あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「バ、バカ……あぁっ、甘い言葉と一緒に……あっ、オチンポを動かすのは…\n…は、反則っ……！　んくぅっ、はぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁ……だって、そんな……あっ、同時に……されたら……はぁっ、いつも\n以上に気持ちよくなって……しまうからぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「喜んでるのがバレてしまう……はぁっ、んんぅっ……そうだ……あぁっ、貴\n方に……可愛いと思われて……私は……喜んでしまってるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、ちゅぷっ、んふぁ……あぁ……キスぅ……んふぅ……さっきより……\nれろ、んっちゅ……ぬるんて……あふ……するぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ……そのまま……あっ、オチンポ……だんだん速くなって……\nあひっ！　あぁっ、んっ、きもひっ……いいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904210" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、あぁ……どうしたんだ……今日は、やはり……特別なドレスだ\nから、いつもより激しく……なっているのか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「分からない……んっ、私も……何だか……分からないけど……あぁっ、オチ\nンポ……すごくっ……感じてるっ、あひっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ……お、おっぱいも……あんっ、弄るなんて……聞いてないっ、はぁっ\n、奥にオチンポ届いてる時にっ……新しい場所ぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁっ、オマンコ……また、ズボズボっ……突きまくられてぇっ……！　は\nぁっ、私を……どんどん乱れさせてぇっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、あぁっ……あ、あんまり……見ないでくれ……か、感じてる\n顔……恥ずかしいから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……見たいって……そんな、あぁ……今日は強引だ……そんな風\nに言われたら……断れないだろう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んちゅっ、はぷ……んんっ……あふぅ……おっぱいも揉まれて……んっ、首\n筋を舐められて……あぁ……オマンコ全体の感度も上げられて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……あぁ……んんっ、ダメだ……私もされるばかりじゃ……ない\nからな……んっ、ふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「奥に……ずぶって来るタイミングを合わせて……ぎゅっと……オチンポ、締\nめ付けるっ……んんっ、どうだ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふ……気持ちいいんだな？　分かるぞ……私だけじゃないんだな……貴方\nの感じる顔が見られるのは……ふふっ、何だか嬉しいぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「もっとだ……もっとオチンポに喜んで欲しい……んっ、あぁっ……足を絡ま\nせて……離れられないように……くっつけて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ、んっふ……またキスぅ……はぁ、んっ……あぁ……全身……隅々\nまで愛されて……あぁ……どうにかなってしまいそうだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「うんっ、んくんっ……あぁっ、またオチンポがっ……オマンコの中で大きく\nなってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904303" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「オマンコ……ぐりって広がって……あぁっ、もっと深くまでめり込んでっ…\n…し、子宮口に届いて来るっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁぁっ、入り口……オチンポの先端がっ……コンコンノックしてぇっ……\nあぁっ、このままされたらっ……私……も、もうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……そうだ……イキそうなんだ……んっ、貴方は……？　あっ、\n貴方のオチンポも……もうすぐなんだなっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それなら……あぁっ、ちゃんと……中がいいっ……妊娠しても構わないから\nっ、一番奥で……出して欲しいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、んんっ……そうっ、そこぉっ、子宮口っ……グリグリ擦ってっ\n……！　あひぃっ、オマンコっ、奥っ……気持ちいいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁっ、もっと激しくしてっ！　オマンコ突いてっ！　オチンポズボズボし\nてっ、あぁっ、このままっ、もっとぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁっ、激しいっ……！　あぁっ、好きっ、それ好きぃっ……！　あぁっ、\nダメだっ、こんなのっ、もう我慢できないっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904310" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「イクッ……！　もうイッちゃうからっ……あっ、オマンコッ、我慢できずに\nイッちゃうからぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「貴方もっ、出してっ……！　はぁぁんっ、熱いのっ、ビュルって出してっ…\n…！　貴方の濃いのでっ、いっぱいっ、いっぱい種付けしてぇぇぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぉひぃぃぃぃんっ！　あぁぁぁぁっ……イクッ……イクぅぅぅんっ！　あ\nひっ、しゅごっ……おぉっ、おぉぉんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3904403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000139_02_10" ]},

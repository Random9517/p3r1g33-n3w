		{"command":[ "SETIMAGE", "0", "still_00000544_02_15" ]},
		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「ひぁぅっ！　んぁっ……ザーメン……飛んでっ、はあぁっ、シャワー……\n　出て……ますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「んふぁぁ……ぶっかけでもイクっ！　顔にもおっぱいにも出されてっ……\n　イキまくるぅぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「もっと出しなさい……んぅう……ウチの身体をドロドロのザーメン漬けに\n　して……精気を染み渡らせるんです……はふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000544_02_15" ]},
		{"command":[ "SETTEXT", "「あぁ……漲るぅ……やはりサキュバスの力の源は精液が一番なのですね……\n　ちゅぱっ、んんっ、美味です……ぴちゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000544_02_14" ]},
		{"command":[ "SETTEXT", "「あ……終わってしまいました……まだ、もう少し出せるのではありませんか？\n　オチンポは十分硬さを保っています、残りを……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「むぅ……無理に一度に搾り取るのは後々のことを考えると、損かも知れませ\n　んね……またしっかり欲望を溜め直した後がいいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETTEXT", "「分かりました。今日のところは、これでよしとしましょう。オマンコの中に\n　も身体にもしっかり精液はいただきましたからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000544_02_13" ]},
		{"command":[ "SETTEXT", "「いかがでしたか？　ウチの身体……それなりに満足出来たのではありません\n　か？　決して一方的な搾取で終わった訳ではないと思いますが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000544_02_14" ]},
		{"command":[ "SETTEXT", "「今後も、あなたには極上の快楽をお約束しましょう。ですから、ウチが必要\n　な時にはまた相手をしてもらいますよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_4404409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザーオボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000544_02_13" ]},
		{"command":[ "SETTEXT", "「当然です……あなたには責任を取ってもらわなければなりませんから。ふふ\n　……女というのは怖いものなのですよ？」", "NORMAL" ]},

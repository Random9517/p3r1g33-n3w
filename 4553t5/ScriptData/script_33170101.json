{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「こんなところに連れ込んで、尋問でもするつもりかしら？　だとしたら、時\n間の無駄よ。わたしは何も喋らないわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103101" ]},
		{"command":[ "SETCHARA", "0", "char_00031701_01", "7", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「喋らないなら、無理やりにでも喋らせる？　ふふっ。そんなことできるはず\nないじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103102" ]},
		{"command":[ "SETCHARA", "0", "char_00031701_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「って、君っ！　何で服を脱いでるのっ！？　ま、まさか、わたしを犯す気っ\n！？　や、やめてっ！　やめなさいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103103" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「くぅぅっ！　このわたしが、男のチンポをおっぱいで挟むだなんて……！　\nんっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「チンポが谷間の中で、さらに大きくなってる……！？　何よこれっ……チン\nポって、こんなに大きくなるものなの……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103105" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「えっ……チンポを見たことないのかって？　そ、そんなの、あるわけないじ\nゃない！　わたしはいつも、女の子しか相手にしないのよっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103106" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「経験がないなら、尋問ついでに奉仕の仕方を教えてやるだなんて……君、こ\nんなことをして、ただで済むと思っているの！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103107" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「いいからおっぱいを上下に動かして、チンポをシゴけ？　くっ……！　わ、\n分かったわ……やればいいんでしょう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んっ、あっ、、あぅっ！　これ、ものすごく熱いっ……おっぱいで擦ると押\nし付けるのとは違った感じがするわっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「はぁ、んっ、はぁぁっ……こんな感じで、スリスリすればいいのよね？　こ\nれなら、簡単だわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103110" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「初めてのくせに、なかなか上手いですって？　こんなの、わたしにかかれば\n楽勝よっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103111" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「君のこと、すぐにイカせてあげるわ……んっ！　あっ、ぐっ！　ふっ、あっ\n、はふっ！　あっ、うぅっ……くっ、あぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「パイズリだけじゃなくて、フェラもしろ？　フ、フェラって、フェラチオの\nことよね……！？　チンポを口に咥えるっていう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103113" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「し、仕方ないわね……わたしは捕らわれの身だから、今だけは君の命令に従\nってあげるわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103114" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んっ、ぢゅぶっ……ちゅ、くちゅっ……んっ、ちゅるるっ……ぴっ、ちゃっ\n……れろっ……んっ、じゅろっ……ぢゅ、ずちゅぐっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぢゅ、ちゅちゅっ……ぷっ、くぷっ！　はぁ……はぁ……こんら感じれ、い\nいのかひらっ……んっ、れっろっ……ちゅるるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103116" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「初めへしゅるから、勝手がわかりゃないわ……いちゅも、女の子のオマンコ\nひか舐めにゃいひっ……んっ、じゅろっ、ずりょっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103117" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「そ、そうらわ……クリトリスを吸っひゃり、舐めはりしゅるみはいにしゅれ\nば……ぐっ、じゅ、ぞぞっ！　れろっ、れろぉ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぴちゃ、くっ、くっぷっ！　ぢゅぞっ……ちゅるるっ！　んっ、んっむっ！\n？　ぐむぅぅ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103119" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「な、にゃに……！？　チンポにょ先端かりゃ、ヘンな汁がっ……ネバネバひ\nてて、ヘンな味がしゅるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「も、もひかして、もう射精したにょかしら？　ふっ、ふふっ……わたひにょ\nテクニックに、ひれ伏したみはいねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103121" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「そりぇは精子らなくへ、ただの先走り汁？　もっと激しく舌で舐めたり、吸\nったりひないと、全然気持ひよくないらなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぐぅぅっ……！　い、いいわ。わたしのプライドにかけへ、絶対にイカしぇ\nてあげりゅんらからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103123" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ずずずっ！　じゅぞっ、ちゅるるっ！　じゅ、ぱっ！　んぱっ、ちゅ、くち\nゅぷっ！　れろっ、んべろっ！　れじゅぢゅぅ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103124" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぐっ、ぶっ！　んんんっ！　たりゃ舐めるらけじゃダメらわ……！　もっと\n緩急をつけへ、ペロペロひないと……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「しょれに、おっぱいもしっかりと動かひて……絶えずチンポに刺激を与えに\nゃいと……ちゅ、ぐっ、じゅずっ！　ぺろっ、んぢゅろぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぐぽっ、じゅっぽっ！　ちゅ、ちゅるっ……ちゅちゅ、ちゅっ！　んっ、ぞ\nぞっ、じゅ、ぞっ……！　ぐぷっ、ぢゅぶぶっ！　んぷぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んっ、んぐむっ！　口にょ中が、唾液ひょ先走り汁れいっぱいにっ……ぐっ\n、おっ、おぇっ……うべぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103128" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ふぇ……？　精子の飲む練習として、チンポを刺激しながりゃ、口にょ中に\n溜まってりゅ汁を飲み干せですって？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103129" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「うぅっ……こんな汁、飲みひゃくないけろ……や、やらなきゃ……！　んっ\n、ぐっ！　こくっ！　ぢゅ、じゅぞぞっ！　んっくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「おぇっ、おぇぇっ……なんらの、こにょ味っ……！　愛液とは全然違うっ…\n…！　苦いにょに、クセになりそうらわ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103131" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぢゅぶぶっ！　んっ、ごくっ！　ぢゅばっ、じゅ、ぢゅぼぼっ！　じゅぞっ\n、ぞっ！　ごくっ、ごくんっ！　ぢゅずっ、じゅ、じゅるるぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「おっ、ぶっ！？　うぐぅ～っ！？　チンポが、急にビクビク跳ねだひてりゅ\nっ！？　な、なにっ？　何が起こりゅのっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「今から口にょ中に射精しゅるから、全部受け止めろ……？　ま、待っへっ！\n　そんら急に言われても、心の準備がっ……んちゅぶぅぅっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103134" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「じゅ、ぢゅばっ！　ぐっ、じゅぞぞっ！　や、やめっ……！　ま、まらイカ\nにゃいれっ！　もう少しらけ我慢を……んんん～～～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103135" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぐっ、おっ！？　ぢゅ、ぢゅぼぉっ！？　じゅ、ぢゅぐぐっ！　おぇっ、ぶ\nっ！？　ぢゅばっ、じゅっぼほぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103136" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「こ、これが精子っ……！？　あちゅくへ、ドロドロひてて、しゅっごく苦い\nっ……！　口の中に勢いよく噴き出ひてりゅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103137" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ずっ、ぢゅぶっ！　射精中もパイズリとフェラを続けろらなんへっ……！　\n初めてにょ相手に、そんら器用なことしゃせるなんへっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103138" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぢゅぐっ、じゅぞぞっ！　この、変態ドスケベ男っ……！　んちゅぐっ！　\nじゅぞっ、れろっ！　ぢゅろっ、れろれろっ、んれろぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103139" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「にぢゅぐっ、じゅ、じゅるるっ！　ぢゅ、ずずっ……！　おっ、えっ……う\nぶっ、ぐっ！　ぢゅばっ、じゅ、ちゅぴっ！　ぢゅっぱぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103140" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ふーーーっ……ふーーーっ……んふぅぅぅーーーっ……ど、どうやりゃ、射\n精は終わっひゃようね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「口にょ中が、精液まみれらわ……ヘンな匂いも漂ってきへっ……んっ、ぢゅ\nっ……！　こにょ匂い、オマンコにくるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103202" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「えっ……まだこの程度で尋問は終わらにゃい？　このまま、パイズリとフェ\nラを続けろらなんへ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103203" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「確か男は、連続で射精しゅることはれきないはずじゃ……い、いや。今はそ\nんなことを言ってりゅ場合じゃないわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103204" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ここれ引いたら、わたしにょプライドが傷ついひゃう……もう一度イカしぇ\nて、チンポを萎えさせてやりゅわ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103205" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ずっ、ちゅぐっ……！　ぢゅぢゅるっ！　じゅぱっ、んべろっ！　れりゅ、\nずりゅりゅっ！　にちゅ、ぐちゅっ！　ぢゅぽっ、ぐぽぽぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んっ、ぢゅるるっ！　ふふっ……さすがに２回目となりゅと、ある程度やり\n方が分かってきひゃわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103207" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「しょれに、君にょ弱いとこりょも、何となく察しがつくひ……んっ、れろっ\n！　ぢゅ、ぢゅるっ……くちゅ、ぢゅ……んれろぉぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103208" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んぐっ、んっぐっ……じゅるるっ……！　こにょチンポのくびれてりゅとこ\nろ……ここを刺激しゃれるのが、いいみひゃいね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「特に皮にょ隙間や、デコボコひたとりょろの裏側を舐めりゅと、チンポがヒ\nクヒクひてくりゅわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ふふっ……ここをペロペロひにゃがら、先端を吸いまくれば……んっ、ぢゅ\nっ！　じゅぞぞっ！　ぢゅ、ぞっ！　ぐちゅ、れぢゅるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103211" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ちゅばばっ、じゅ、んぱぁっ！　ちゅぼっ、じゅ、んぼっ！　ぐぽっ、ぐっ\nぽっ！　にちゅ、ちゅぶぶっ！　じゅ、ずぷぷぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103212" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「おっ、ぶっ！？　じゅ、ぐぶっ！？　先走り汁が、まひゃ滲んできへ……お\nぇぇっ……口かりゃ、こぼれちゃう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103213" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ひゃ、あぁぁっ！？　おっぱいに色んな汁が垂れて……んちゅ、ぢゅぶっ！\n　おっぱいよ滑りがよくなっへりゅわ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103214" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぢゅぞっ、じゅぞぞっ！　んっ、んっうっ！　ヌルヌルひた感触が気持ひい\nいっ……！　おっぱいで感じひゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「子宮が疼くけろ、イクわけにはいかにゃいわ……！　フェラチオしながりゃ\nイクなんへ、ありえないんだかりゃ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103216" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「じゅるるぅ～～～っ！　じゅぞっ、ぢゅ、ぞぞっ！　んぐっ、ぢゅっぐっ！\n　にぢゅ、ぐっじゅっ！　じゅぽっ、ぢゅぼぼっ！　んちゅぷぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「あっ、んぁっ！　まひゃ、さっきみひゃいにチンポが跳ねてっ……！　イッ\n、イキそうらのねっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103218" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ほ、ほりゃ……イキたいなりゃ、イキなひゃいっ……！　わたしのおっぱい\nと口れ、情けなくイッひゃいなさいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103219" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぢゅるっ、んぢゅぅ～！　じゅぞっ、ぐっ、じゅぶっ！　ちゅぼっ、じゅぽ\nっ！　ぢゅぐっ、にちゅぷっ！　ちゅばっ、んぱっ！　じゅぞぉぉぉ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103220" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぢゅぞっ！？　んっ、んっぶっ！　ぢゅばっ、じゅ、じゅるるっ！？　まひ\nゃ、口にょ中に精子がぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「れ、れもっ……こにょ射精を耐えれば……！　ちゅるっ、ぢゅばっ！　じゅ\n、ぞぞっ！　にぢゅ、ぐじゅるぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103302" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んぐっ、んっ、じゅ、ぞぞっ！　ごっくっ……んっ、おっ、ぶっ！？　なに\nよ、この喉越しっ……粘液が喉に絡みついへっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ぐっ、おっ、おぇぇっ！　こんらの、飲めひゃもにょじゃないわ……！　ぢ\nゅ、ぐっ……ずずずっ！　じゅぶっ、じゅぷふぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103304" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「くっぷっ……んふっ……はっ、ふっ……ど、どうやりゃ、射精が終わったみ\nはいね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「うぅっ……しょれにひても、精液がこんら味と喉越しらなんて……想像ひて\nたのひょ、全然違うじゃない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103306" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「えっ……な、なんですって？　口に出された精子を、全部飲み込めらなんへ\n……こ、こにょ、変態がっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103307" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「早くしないと、チンポを喉奥まで突っ込んれ、無理やり飲ませりゅ？　ぐぅ\nぅっ……の、飲めばいいれしょ、飲めば……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「んっ、ごっ、くっ！　ごっくんっ！　うっぷっ！？　うっ、うぇぇっ……じ\nゅ、じゅぞっ……ごくっ、ごくっ……んっ、んぐっ！　ごくんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103309" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……こ、これで、いいんれしょう……？　まったく……初めて\nにょ女に精液飲ませるらなんて、鬼畜もいいとこりょねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103310" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ちゅ、んぶふぅっ！？　ち、ちょっとっ！　なんで急にチンポを抜いてっ…\n…！？　きゃあぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「ま、待ってっ！　どうして顔に精子をかけるのっ！？　さっきみたいに、口\nの中に出せばいいじゃないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「やっ、あっ！　イヤぁぁぁっ！　熱くてドロッとした汁が、顔やおっぱいに\n飛び散ってるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「それに何なの、このむせ返るような匂いっ……！　臭いはずなのに、オマン\nコが疼いてきてっ……あっ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103404" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「女の子の潮吹きを浴びても、こんなにオマンコがズキズキしたことなかった\nのにっ……！　あぐっ、ふっ、あっ！　あっはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、ふぅぅっ……こんなにわたしを汚して……いったいどういう\nつもりなのかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103406" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「えっ……いい女は精液をかけてマーキングして、自分のモノだって示す必要\nがある？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「な、何を言っているのっ！？　わたしは別に、君の女になんてなったつもり\nは……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103408" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「それにこれは、ただの尋問でしょう！？　どうしてそういう話になるのよっ\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リズ・ハートレイ" ]},
		{"command":[ "SETTEXT", "「まったく、これだから男ってヤツは……！　で、でも……君の女と言われて\n、悪い気はしなかったけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_317_0103410" ]},
		{"command":[ "SETIMAGE", "0", "still_00031701_01_20" ]},
		{"command":[ "WAITINPUT" ]},

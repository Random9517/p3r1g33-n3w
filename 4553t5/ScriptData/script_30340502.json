{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……あのさ。見られちまったからには、仕方ねえから聞いておきたいんだが\n。俺がこういう格好すんのってどう思う？　イヤか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504101" ]},
		{"command":[ "SETCHARA", "0", "char_00003405_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……意外と似合ってる？　へ、へえ……。スタイルがいいからキマってる？\n　そうかよ。ま、まあ、一生に一回くらいなら悪くねえってことなんだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504102" ]},
		{"command":[ "SETCHARA", "0", "char_00003405_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ま、俺の場合ヨメになんのかツマになんのか知らねえが。どっちにせよ、こ\nんなカッコ見せるのは隊長にだけだしな。好きに呼んでくれよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504103" ]},
		{"command":[ "SETCHARA", "0", "char_00003405_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ただし。まだまだ主導権は渡さねえからな。何のって、戦闘でも、生活でも\n、……それから夜もだよ。つうことで、今夜は俺が隊長を抱いてやるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504104" ]},
		{"command":[ "SETCHARA", "0", "char_00003405_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「よいっしょぉっと！　……クククッ♪　今完ッ全に油断してたろ。そんなん\nだから、簡単に女の俺に押し倒されちまうんだぜ？　弱い弱い♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504105" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「花嫁サンになって、俺がおしとやかにおとなしくしてるだなんて思ってなか\nったろ？　俺は獰猛なケモノのままだぜ。その証拠に……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「隊長と二人になった時から、すぐにここを濡らして待ち構えてたんだ。いつ\n、襲ってやろうかって……。ほら、チンポに感触が伝わるだろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺のマンコ……。すげえぐちょぐちょだろ♪　おっと。でもまだダメだぜ。\nおあずけってやつだ。焦らしに焦らしてからいただくためにも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「こう、やって……♪　素股で俺の愛液を、隊長のデカチンに塗り広げていっ\nてやる……。っぁ……、いつもながらにデケぇチンポだな……♪　あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「これ、入れるとめちゃくちゃ美味いんだよ。腹の奥までズンズン突かれて、\nワケわかんなくなるまでブッ飛べる。最高のチンポ……ん、んん、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あぁ……♪　早く欲しいぜ。でも、ここでグッと我慢して……んっ、限界ま\nで待って、待って、期待を高めてから……。っふぅっ、いただくんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……んん……、どう、だ？　チンポが切なくなってきたか？　はぁっ……入\nれたいか？　俺ん中に……♪　俺もすげえ入れたいよ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「はははっ♪　すっげえやらしい音してる……。くちゅくちゅ、ちゅぷちゅぷ\nってさ……。これ、隊長の我慢汁だよな？　っヌルヌルしてる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「いいぜ。こうやって、しっかり俺の匂い、マーキングした後で……ずっぷり\n奥まで挿入させてやる。……いくぜ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んっおっ！？　おッおっ……♪　おっおっおっおぉおおおっ……♪　ヤ、ベ\nぇええっ……！　チンポデカすぎんだろっ、ふ、太い、拡がっちまうぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504115" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んぉっ♪　めちゃくちゃ待たせた甲斐あったなっ……♪　ガチガチの限界チ\nンポ♪　ありえないくらい硬くなってやがる♪　最高だぜ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504116" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「そぉらっ、そらっ♪　待たせた分、最速で腰振って、精液絞り取ってやるか\nら覚悟しろよ……！　ッあっ♪　あっあっ、イイっ、これすげえイイっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504117" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「一回腰動かしたらもう止まんねぇっ♪　き、もち良すぎだろっ……！　んぉ\nおっ♪　チンポっ……チンポ突き刺さって……あっあっあっあっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……んっ？　おい。何そっちも動こうとしてんだよ。言ったろ？　今日は俺\nが隊長を襲うんだって。ダメだダメだ、少しも攻めさせねぇよ♪　んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504119" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺に亭主関白しようなんて、……あっ♪　百万年早いからな？　んぉっ♪　\nおっ♪　んふふっ、悔しいかぁ？　俺にしてやられっぱなしでぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「でも、これが尻に敷かれるってやつだろ？　んっ、ううっ♪　俺にもいい思\nいさせてもらわないとなぁ……♪　ふぅっ、はぁっ、はぁっ、はぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あ、あああ……っ♪　一方的にガンガン攻めるってのは最高に気持ちイイぜ\n……！　っんっ……！　感じてる隊長の顔もよーく見えるしな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504122" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「どうだぁ？　俺ん中、最高に仕上がってんだろ？　ヌメりまくって、チンポ\nを締めつけて……とんでもねえ膣圧でシゴきまくって……っ、あぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……俺はっ♪　他のやつらみたいにっ♪　おっ♪　可愛くおねだりなんてし\nねえからなぁ♪　このまま勝手にヤらせてもらうぜ……っておい！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んぐぅうううっ！？　きゅ、急に何腰動かしてやがるっ！？　ビ、ビビらせ\nんなっ！　……んぉおっ！？　や、やめろ、止めろバカっ、あっおぉっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504125" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「い、言ったろ！？　今日は俺が攻めるって……。ッんんんぉおおおッ！？　\nこ、こらァ！　下から遠慮なくドチュドチュ突き上げやがってぇえっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ふ、不意打ちなんて卑怯だろがぁっ！？　……おぉおっ♪　んぉおおっ♪　\nあっあっあっあっ♪　……はァ！？　濡れすぎ！？　う、うるせえなっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「動かれると感じまくってんのがバレちまうから、照れ隠しで腰振ってたんだ\nろって！？　……そ……そうだったら何か悪いか！？　く、くそぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……花嫁らしく、可愛くおねだりしろ？　ちょ、調子乗んなっ……あっ♪　\nこ、これだから隊長に主導権奪われんのイヤなんだよっ……んぉっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504129" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……そ、そうだよ！　俺ぁ隊長のことが好きだからっ！　チンポ入れられた\nだけでトんじまう、ホントはずっとイッてたっ……！　だ、だから！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504130" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「この逞しいチンポでっ、デカすぎる太いチンポで俺をイかせてくれぇっ！　\nんぉおおっ♪　んぐぅうっ♪　うぅっ、言うこと聞くからイかせろぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……あああああああっ♪　あぁっ、ああ、あぁあッ！　イグぅううっ♪　イ\nグッ……♪　おぉおおっ♪　う、上手すぎんだろピストンがぁあっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504132" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ああああ、ヤベぇっ♪　マンコのうねり止めらんねぇっ……！　あっ♪　勝\n手にマンコがっ、隊長のチンポにまとわりついて……絞っちまうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504133" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あっ♪　あっ、もうすぐっ……すぐまたイクからっ！　隊長もっ、隊長もチ\nンポ一番奥にブッ刺して、一緒に、一緒にイッてくれよぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んぉおおっ♪　おぉっ、おっ、おぉおおっ……♪　あぁああ、イクっ……イ\nグぅううっ！　俺のメスマンコ、限界までブッ飛んでイクぅううっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504135" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_06" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「はぉおおっ♪　おいっ……おいぃっ！　容赦ねえ射精してくれやがってぇえ\nええっ♪　あ～～～～っ♪　あっあっああぁあああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あっ♪　悪ぃ、締めつけすぎてっ……あっ♪　出しづらいかもなっ♪　……\nんぐぅううっ♪　なんて量注いでくれてんだよ……。あっ、孕むぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504137" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んぉっ♪　おぉっ、イイっ……イイっ……！　隊長、隊長に中出しされっと\nぉっ……全身ガクガクくるくらいイイぜ……！　まだイクっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あはははっ♪　ビュルッ、ビュルッてシャレになんない回数脈打って……、\nあぁっ♪　俺の子宮ん中真っ白に染め上げてきやがる……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504139" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「やるじゃねえかっ……！　あっ♪　男らしい種付けは歓迎するぜ♪　ッ……\nおぉおおっ♪　熱い……マンコの中が精子でいっぱいだぁ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504140" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ハァアアアア……♪　ありえねぇくらい濃い精液、こんなに注入されちまっ\nたら……完全に火ィついた。こいつはお返ししないとだろぉっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ったく……。俺をここまでアツくさせられんのは隊長だけだ。それに……へ\nへへっ。そっちもすぐにヤる気が復活してきたじゃねえか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「これは面白い勝負になりそうだな……。よぉっしゃあ！　俺もギアを上げて\nいくぜ……。精子でマンコの滑りも良くなってるしな……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「そっちも！　今度はしょっぱなから全力で来ていいぜ！　……あっ♪　お互\nいのフルパワー、マンコとチンポでぶつけあおうじゃねえか！　んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504204" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「んんんっ……♪　ンッ、んぉっ♪　おっ、い、いいぜ……今のはキいた、…\n…おっ♪　奥をガン突きして、子宮を刺激してくるなんてな……。っう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「こっちもっ、腰のスピード最速で刻むぞ！　……っあっ♪　あっぁっあっぁ\nっうぅっ♪　はぁっ、あぁ、どんどん身体が熱く燃えあがってくるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504206" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……あっ♪　まさか女のパワーに負けるなんて言わねえ、よなっ♪　……ん\nほぉっ！？　おっ♪　い、今のすげぇっ、一気にもってかれた！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「マンコん中、ぶっといチンポが出たり入ったりして……あっ♪　うぁっ、ゾ\nクゾクするぜ……♪　っううううっ♪　こりゃ手ぇ抜いてらんねえ、なっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504208" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「本気でピストンし続けねぇと……あっあっ、即イカされるっ……♪　あはっ\n♪　はははっ、気持ちいいし死ぬほど楽しいぜ、隊長との子作りっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504209" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺がどんだけ攻めてもっ、すぐ攻め返してくるっ……。あっ♪　２人だと最\n強になれるっ……！　あっぁっ、もっと、もっと激しく突いてくれぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「摩擦でマンコがぐちょぐちょになって……、んひっ♪　そ、それもいいな、\n掻き回すヤツっ……！　センスある、ぜ、奥が感じたぁ……っ、んんっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504211" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……俺とすんの、楽しいって？　マジか……。あ、や、やめろよ、なんかっ\n、ヤッてる時にいきなり褒めんのとか反則だろっ……。あっ、うぐっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ヨメにして良かった……？　っくぅうううっ……♪　ヤ、ヤバイ……。マン\nコが敏感にされちまう、な、なんでだよ、隊長に認められると……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺……。あっ♪　うっあぁっ♪　マンコが締まってキツくなるっ……、うぁ\nあああっ♪　うるせえよ、うるせえうるせぇ……！　んああああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504214" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「身体がっ！　子作りモードになっちまったじゃねえかっ、あっ！　せ、責任\n取れよっ！　責任取ってきちんと孕ませやがれっ……あっあっうっうぐっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504215" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「気ん持ちイイぃいいいいっ……！　あああああっ、隊長のチンポ、響く、キ\nくぅううっ♪　マンコに直接っ、生でこすれて……うぁっ♪　あっあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504216" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「くそっ、くそぉ……♪　気持ち、いい……気持ちいいっ♪　隊長……隊長っ\n……！　俺ん中、めちゃくちゃ喜んでんのわかるかっ……！？　あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……くくくっ。そっちも攻めすぎて射精寸前になっちまってるじゃねえか。\nいいぜ？　今だけは、俺は隊長のヨメだからな……。んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504218" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ほらっ、腰の動き合わせて……はぁっ、同時にイクぞ！　あぁっ、あっ、あ\nっ、あっあぁっ……！　チンポ、ビキビキですげぇっ……あぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504219" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「隊長ぉおおっ♪　隊長のチンポは俺のモンだっ……！　あっ♪　愛してるか\nらイかせてくれっ、出せっ……出せぇっ、精液一番奥に注げぇえっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ふはぁあああああっ……♪　ああああぁっ、あっ！？　あっ、あっ、あぁあ\nああっ……！　マグマみてぇなドロついた精子、上がってきやがるぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504301" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「おぉおおおっ♪　マンコの奥ぅっ……、おっ♪　子宮が浮き上がるくらいっ\n、ビュルビュル精液が上がってくるっ……入ってくるっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「このままっ……俺の中に精子溜めてくれっ……！　あっ♪　こっちからも吸\nい上げるから……！　……んんんっ、あっついの来てる……ッ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あぁっ、まだ足りねえよ、まだ、まだ……！　あああああっ♪　隊長のキン\nタマ空になるまで絞り取ってやるっ……！　どうだ、イけるかっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……くぅううううっ♪　二発目だっつうのにこの勢い♪　あっ、あっ、おっ\n♪　脳天グラグラするくらい気持ちいいぜ、隊長の汁で満たされてく！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504305" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「俺のマンコはもう隊長の汁で真っ白だぁあ……♪　あっ♪　強すぎるチンポ\nに種付けされて……おおっ♪　身体がビクビク痙攣しちまうぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ふぅーっ……♪　最ッ高に気持ち良かったぜ……。今の俺に出せる全力を出\nしきって、精魂尽き果てたってカンジだな……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……オイ。何離れようとしてんだよ。疲れきったっつったろ。動けねえの。\nだから……あと少しだけここにいろよ。すぐに回復するからさ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504308" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「今回は……。認めたくねえが、隊長の勝ち……だったかもしれねえな。ん？\n　イチャイチャに勝ち負けはない？　甘い甘い。真剣勝負だろうが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……次は絶対に勝つ。こうして俺の負けん気をビンッビンに刺激してくると\nこが隊長のいいとこだぜ。あーあ、もう次が楽しみで仕方ねえよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「種付けっ、種付けぇ……！　って、まさか隊長！　俺の許可なくチンポをマ\nンコから引き抜いて……っ、んぉおおっ♪　やっぱりかよぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504401" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_15" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「な、んで身体にぶっかけてくんだぁあああっ……♪　あっあっあっ♪　確か\nに１発目は中に出したけどよっ、２発目もそのままで良かっただろぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……んぐっ♪　ネ、ネバネバした臭い汁ぶちまけやがって……！　お、俺が\n喜んでる？　バカ言えっ……ぶっかけられて感じるわけ……。っひぃっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504403" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「隊長の子種汁……！　あったけぇええ……♪　それにこの量……！　これが\nいつもマンコに放たれてると思うと……。っゴクッ、身震いするぜっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「あぁっ、わかったよ、ぶっかけてぇならぶっかけろっ……！　ッひっ♪　ビ\nチャビチャとんでもねえ量ひっかけやがって……、イカ臭ぇ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504405" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「もっと、もっと隊長の色に……精液の色に俺を染めてくれよ！　あっ♪　上\n手いもんだぜ、精子の照準つけんの、特技かよぉっ……ああああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「ふぁあああ……♪　出しに出してくれたじゃねえか、隊長……。こんだけ盛\n大に発射しまくったら、数日分にはなったんじゃねえか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504407" ]},
		{"command":[ "SETIMAGE", "0", "still_00003405_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「自分でもわかるだろ？　このキッツい臭い……。ザーメン臭さが凄まじいよ\nな。……あ？　べ、別にイヤとか思ってねえけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「こんな臭いプンプンさせてたら、俺たちがイチャイチャしまくってたのが…\n…バレるよなって思ってさ。隊長はイヤじゃないか？　そういうの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_034_0504409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ほむら" ]},
		{"command":[ "SETTEXT", "「……平気か。そんなら、もう少しだけ……このままでいてやるよ。……った\nく、いやらしいダンナさまだぜ。身体がいくつあっても足りねえよ」", "NORMAL" ]},

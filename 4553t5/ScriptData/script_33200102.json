		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あくっ……あっ、んんっ……熱くてカタいのが、私のアソコに当たってるっ\n……んっ、あっ……あんっ……はっ、あうっ、ふぅぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104101" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「こ、これから……この大きなモノを、私の膣内に挿れるんですね……はい…\n…分かりました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「……えっ？　さっきから、アソコとかモノとか言ってるが、それは何だって\n……え、えっと……それは……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104103" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「言わないなら、無理やり挿れるだなんて……！　は、はい……ちゃんと言い\nますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「わ、私のアソコ……オマ〇コにあたっているのは、ペニス……あ、あなたの\n、オチ〇チンですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104105" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「このオチ〇チンを使って、今から何をされるのか分かるか、ですか……？　\nはい……もちろん、分かります……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「今から……私の、オ、オマ〇コを使って……あなたのオチ〇チンにご奉仕さ\nせていただきます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「上手く言えたご褒美をくれるんですか……？　ご褒美って、いったい何を…\n…ひゃっ、あぁぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104108" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ、あはっ……んぁっ、はっ、ひっ……はぅぅっ……！　やっ、あんっ…\n…！　オチ〇チンが、オマ〇コを擦ってますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「先っぽの出っ張りが……入り口のヒダや、クリトリスに当たってっ……はっ\n、あはぁっ……！　あぁっ、あっ……んくっ、ふぁぁぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ、あっ……！　オマ〇コが、濡れてきてるだなんて……いやぁぁぁっ…\n…！　そんなこと、ありませんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「これだけ濡れればじゅうぶん……？　くっ、うぁっ……はぁ、あぁぁっ……\n！　い、今から、オチ〇チンを挿れるんですねっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104112" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「身体の力を抜いておけば、いいんですね……は、はい……ちゃんと入るよう\nに、オマ〇コを緩めます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ふぁ、ひぅっ、あんんっ……！　オチ〇チンの先っぽが、オマ〇コを拡げて\nっ……あっ、あっ……は、入って、くるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104114" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あなたの……オ、オチ〇チンが……私の膣内にっ……んんっ……！　うっ、\nくぅんっ……！　ひっ……あっ、あぁっ……はひぃぃぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「い、痛いっ……！　オマ〇コが、裂けてる感じがしますっ……うっ、あぅぅ\nっ……！　こんなの、壊れちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……！　痛みを感じるのは……私の身体が小さいから……？　\nオマ〇コが狭くて、キツく感じるせいなんですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「そんな……私のせいみたいに、言われても……うぁっ、あぁぁぁぁっ！　ひ\nゃ、あっ……！　ひっ、んきゅっ……はひぃっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104118" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「お、奥まで……来てるっ……！　オマ〇コ、痛いのに……身体の奥がビリビ\nリしますっ……うぅっ、あっ、んんっ！　ひっ、あはぁぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「挿れられただけで感じるのは、私が淫乱なメスだから……？　ち、違います\nっ……私、感じてなんて……はぁんっ！　あっ、あんっ！　はぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「一番深いところまで、オチ〇チン届いてるっ……大事なところに、先っぽが\n当たって……ひっ、うぅっ！　ひぁっ、あっくっ……んふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104121" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「んきゅっ、あぅ……！　だ、大事なところはどこかって……そ、そんな恥ず\nかしいこと、言えませんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっあっ！　奥、ズンズンされてっ……！　い、言いますっ……！　ちゃん\nと言いますから、乱暴にしないでくださいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104123" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「うっ、うぅぅっ……！　私の、オマ〇コの奥……あ、赤ちゃんの部屋の入口\nに……あなたのオチ〇チンが当たってて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104124" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「今みたいに、奥のところを突かれると……あっ、あんんっ！　ヘンな感覚が\n、おヘソの下のところに集まってきますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「……ちゃんと言えたご褒美に、オチ〇チンを動かしまくって、思いっきり犯\nしてやる……？　や、いやっ……！　やめてっ……！　あひぃぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104126" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　あんっ、あぁぁんっ！　お、大きなオチ〇チンが……オマ〇\nコを出たり、入ったりしてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104127" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「私のオマ〇コ……擦られて、おかしくなっちゃいますっ……！　や、やだっ\n……もう気持ちいいの、いりませんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ひゃ、あぅっ！　うっ、うぐっ……！　んっ、はぅぅっ！　はぁ、あっ……\nあぁんっ！　もう、許してください……オチ〇チン抜いてください……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「うっ、あっ！　あぁぁ……！　ちゃんと膣内に出したら抜いてやるって……\n！　膣内に出されたら……あ、赤ちゃんが……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104130" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「膣内に出されたくないなら、あなたの言う通りに射精のおねだりすればいい\nんですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104131" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「上手く言えたら、膣内に出すのは許してくれるんですね……い、言います…\n…！　あ、あなたの言う通りに、射精のおねだりをしますからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「わ、私の……赤ちゃんのお部屋に……あ、あなたのザーメン……たくさん、\nぴゅっぴゅっしてください……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104133" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あなたの精子をいっぱいいただいて……わ、私……妊娠、しますっ……！　\nあ、赤ちゃん、たくさん産みますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ、あぅっ！　あっ、あぁぁぁっ！　ちゃんと、言えました……！　だか\nら、膣内は……！　あっ、あっ……！　んっ、あぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104135" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「えっ……？　な、なんでっ……？　オチ〇チンから、熱いの出てるっ……！\n？　これ、射精……せ、精液、出されてるんですか……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104136" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_08" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「どうして……！　わ、私……ちゃんと言えたのにっ……！　あなたの命令で\n……恥ずかしいおねだり、したのにっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ふぁ、ひゃ、あっ！　んひぁっ！　い、いや……いやぁぁぁぁっ！　もう射\n精しないでっ……！　膣内に……オマ〇コに出さないでくださいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「射精は途中で止まらないって……！　あっ、あっ……！　奥、熱いですっ…\n…！　おヘソの下のところに、精液が溜まってきてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104139" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「これ、絶対に赤ちゃんできちゃいますっ……！　あ、あなたの赤ちゃん……\n妊娠してっ……うっ、うぁぁぁっ……！　うわぁぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ひっくっ……うっ、うぅっ……！　どうして、こんな酷いことっ……おねだ\nりすれば、膣内に出さないでくれるはずじゃなかったんですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「上手く言えなかったから、膣内に出しただけ……？　それに、あんなおねだ\nりされたら、誰だって膣内に出すって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「そ、それは……あなたにこう言えって言われたからで……い、いえ……すみ\nません……私のおねだりの仕方が、悪かったんですよね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はい……申し訳、ありませんでした……次は、ちゃんとおねだりできるよう\nにします……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「……次は、ということは……もう一度犯してもいいという意味かって……？\n　違います……！　私、そんなつもりで言ったわけじゃ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104205" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ！　あんっ！　オチ〇チンが、オマ〇コの奥で大きくなってきてるっ…\n…！　これ以上されたら、本当にオマ〇コ壊れちゃいますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あんっ！　やっ、あぁんっ！　やぁぁっ、あっあっ、はんっ！　あはぁんっ\n！　奥のところ、まだズンズン押されてっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「こ、これ……膣内に出された精液を、子宮に押し込んでるみたいな動きで…\n…！　やぁぁっ！　もう精子入らないですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104208" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「私の赤ちゃんの部屋、いっぱいになってます……！　だから、もうオチ〇チ\nン動かさないでっ……ひゃ、あぁっ！　はっ、うっ！　あはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はぁ……うっ、あぁぁっ……！　い、今からから本気で動いて、オチ〇チン\nを膣内でシゴくんですか……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104210" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「こんなにキツくて、苦しいのに……まだ本気じゃなかったなんて……！　そ\nんなの、耐えられませんっ……！　ひっ、あっ！？　あひぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104211" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はぁぁっっ！　そんなに激しく、動かないでっ……！　奥のところ、熱くて\nっ……おかしくなりますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「このままだと、イク時にまた膣内に出すんですか……！？　そ、それは……\n！　あっ、いあっ！　はぁ、あっ、んふぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104213" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「い、言います……！　またあなたの言う通りに、射精のおねだりしますから\n……！　だから、もう膣内は……！　くっ、うぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104214" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はぁ……あっ、うっぐっ……！　あ、あなたのザーメンで……絶対に、妊娠\nしますっ……！　あ、赤ちゃん、産みたいですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「このまま、膣内に出して……し、子宮の奥に、熱い精液……たくさん注いで\nくださいっ……！　あっ、あっ！　ひゃ、あっ、んひゃあぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「い、一緒に、イッて……じ、受精、しますっ……！　だから……あ、あなた\nの精液、赤ちゃんのお部屋に……どぴゅどぴゅしてください……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ！　うぅぅっ！　うぁ、あひぃっ！　ち、ちゃんと、言いました\nっ……！　射精のおねだり、しましたっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104218" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「だ、だから、膣内出しは許して……！　あっあっ！　んっ、あっ！　オチ〇\nチン、膨らんでるっ……！　射精しそうになってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あなたに言われた通り……ちゃんと、イキますから……！　だから、膣外に\n……！　オチ〇チン抜いてぇ……！　あっ、ダメ……もう、限界っ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ、熱いぃっ！　オ、オマ〇コの奥に熱いの出てるっ……！　なんでっ…\n…！？　ま、また、膣内に出されて……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「な、何でっ……！　私、ちゃんとおねだりして……あなたの射精に合わせて\n、イッたのにっ……ひゃ、うあぁっ！　ひぅんっ、んぁぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ、いぁぁぁっ！？　射精しながら……オチ〇チン奥に押し付けないでぇ\n……！　せ、精液、どんどん奥に入ってきちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はぁ、ふっ！　あっ、んはぁぁっ！　イヤのに……奥に出されると、あたま\nのおくっ、パチパチって……！　すっごく、気持ちいいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「頭の中が……真っ白になっちゃうっ……！　膣内に出されながら……また、\n気持ちいいのがきてっ……はきゅぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「イッ、イクッ……！　また、イッちゃうっ……！　あっ、あっ……！　んん\nっ！　やぁっ、あっ！　はんっ、はぁぁっ……あはぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104306" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はっ……はぅ……んっ……あぅぅっ……お腹、熱いっ……あなたの精液が、\n奥に溜まってますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「うぅぅっ……ひどいっ……膣内に出さないって……言ってくれたのに……う\nっ、うぅぅっ……ぐすっ……ぐっすっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104308" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あなたにご奉仕をすることが、私の仕事……？　はい……そうです……あな\nたの言う通りです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104309" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ご奉仕する立場なのに……膣内出しを嫌がって、申し訳ありませんでした…\n…どうか、お許しください……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104310" ]},
		{"command":[ "WAITINPUT" ]},

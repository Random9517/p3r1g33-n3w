		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あぁっ、はぁぁぁぁっ！　オチ〇チン、一気に抜けてるっ……！　ちゃんと\n、外に出してくれたんですねっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あっ、うっ！　んぶっ、くぷっ……！？　か、顔にまで精液が飛んできてる\nっ……！　あぶっ、んんっ！　はんっ、あぁぁっ、はぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104402" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ……！　うっ、あぅっ……！　こんな勢いで……さっき、オマ〇\nコの奥に精液を注がれていたなんてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「私の望み通り、膣内出ししなかったから……もっと感謝をしろだなんて……\n！　んんっ、んっ！　あぁあっ、はひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「あ、ありがとう……ございますっ……！　膣内に出さないでくれて……う、\n嬉しいですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「きゃあぁっ！？　ま、まだ精液が飛び散ってくるっ……！　身体だけじゃな\nくて……顔も、髪も……ドロドロになっちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104406" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……！　膣内出ししない代わりに、全身を精液で染めて……匂\nいが取れなくなるようにするんですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「そ、そんなの……ひどすぎますっ……！　精液、もう出さないでっ……！　\nあぅっ、あっ……んっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「かけられるのがイヤなら、また膣内に出す……？　やっ、やぁぁっ……！　\nどちらか選べだなんて……そんなの、選べませんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_320_0104409" ]},
		{"command":[ "SETIMAGE", "0", "still_00032001_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "城宮椛" ]},
		{"command":[ "SETTEXT", "「ひっくっ……あっ、うぅぅっ……！　どっちもイヤなのに……おヘソの下の\nところが疼いてくるっ……あっ、ふぁぁ……ど、どうしてなの……？」", "NORMAL" ]},

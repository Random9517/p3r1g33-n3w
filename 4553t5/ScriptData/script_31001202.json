{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「今回はかなり難事件だった……隊長どのも動き回って、疲れただろう？　一\n緒に身体を休めようじゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204101" ]},
		{"command":[ "SETCHARA", "0", "char_00010012_01", "4", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「……ん？　何やら、カタいモノがお尻に当たって……ふふっ。これは女を泣\nかせる、卑猥な凶器が隠されていそうだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204102" ]},
		{"command":[ "SETCHARA", "0", "char_00010012_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「どうやら正解のようだが、このままでは隊長どのが誰かを襲ってしまいかね\nない。そうした事件を未然に防ぐのも探偵の仕事……なんてな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204103" ]},
		{"command":[ "SETCHARA", "0", "char_00010012_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んんっ……本当に大きなペニス……じゃなくて、凶器だな……こんな凶悪な\nモノを隠し持っているとは、思っても見なかったぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204104" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「それで？　その凶器を私のアソコに突き付けて、いったい何をする気っ……\nあんっ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、あっ……カタくて熱いので、割れ目をズリズリ擦られてっ……そんな\nに刺激されたら、感じてしまうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204106" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「隊長どののたくましい凶器で、アソコが脅されているっ……！　はぁぁっ、\nんぁっ、あっ……ふはぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「子宮がズキズキと疼いてきて……！　くっ、うくぅっ……！　アソコが汁ま\nみれになってしまったじゃないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こんな状態で太い凶器を突き立てられたら、奥まで入ってしまうぞ……？　\nそんなことをすれば、本当に事件になってしまうからな……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「……合意の上なら、事件じゃないと？　ふふっ……私は別に、合意したつも\nりはないぞ？　これはあくまでも、探偵の務めであって……あはぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204110" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「隊長どののガチガチペニスっ……あっ、違っ……！　ガチガチの凶器が、ア\nソコに入ってきているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204111" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ヒダを掻き分けながら、私の大事なところに向かって、どんどん押し込まれ\nてっ……ひゃ、あっ、あっ！　んっはぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こ、これっ、アソコの形が変わってしまうっ……！　アソコのお肉が、凶器\nの形になってしまうぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204113" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ……！　気持ち、いいっ……！　この無理やり犯される感じっ…\n…あっあっ、んっ、あっ！　い、いつもより、感じてしまうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こんな状態でアソコをズポズポされたら……エッチな蜜と凶器が混ざり合っ\nて、いやらしい声が漏れてっ……んっ、んくぅぅ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　ふっ、はぁぁぁっ！　隊長どのの腰使い、すごいぃっ！　私\nの子宮にズンズン響いてくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204116" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「女を泣かせる凶悪なモノが、アソコを出入りしてっ……あっ、あぁぁっ！　\nくっ、ふっ！　あっ、おっ、あぐふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こ、これ、無理やり犯されてるみたいで……いつもより、気持ちが昂ってく\nるっ……！　勝手にアソコが締まるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204118" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んあっ！　ひゃ、あっぐぅ～！？　カリのところが、アソコのお肉を削って\nきているっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204119" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ゾリゾリする感じが気持ちよくて、いやらしい蜜が止まらないっ……！　こ\nれでは、滑りがよくなってしまうじゃないかっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204120" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こんなの、隊長どのの犯行を手助けしているみたいでっ……あっ、あぁっ！\n　私は探偵なのに……幇助の罪に問われてしまうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ひゃあぁぁぁ～っ！？　さらに奥までペニスっ……！　き、凶器が突き刺さ\nってくるぅ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204122" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「子宮口を開かせようとするみたいに、奥のところをズンズン叩かれてっ……\n！　あっ、んひっ！　ぐっ、うぐぐっ！　んぎひぃ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「それに奥だけじゃなくて、浅いところもズリズリされているっ！　こんな、\n一度に二つの犯行を重ねてっ……！　こ、これは重罪だぞっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁっ……！　せめて、どっちか片方だけにっ……！　じゃないと、\n感じすぎて頭がおかしくなってしまうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204125" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ぐっ、んっ……はふっ、んっふっ……！　あっ、あっ……！　ペニスがアソ\nコから、引き抜かれてっ……分かってくれたんだな！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ひっ！？　んぎひぃぃぃっ！？　おっ、おぉぉっ……！？　また急に、奥ま\nでぶっとい凶器が突き刺さってぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204127" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「それに、腰を振る速度も上がっているっ！　奥のところと浅いところを、交\n互に擦られまくっているぅ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっあっあっ！　おっ、ほっ！　おぉぉ～っ！？　こんなの無理だっ！　と\nてもじゃないが、耐えられないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204129" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「徹夜の張り込みや、長時間の尾行は耐えきれたのにっ……！　ペニスにだけ\nは勝てないぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んひっ、おっ、おぉっ！？　く、くるっ！　アソコの奥から、すごく気持ち\nいいのが来てしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204131" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふひっ、んひぃ！？　た、隊長どのの凶器も、ブルブル震えてっ……まさか\n、このまま果てる気なのかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁっ！　はぁっ！　私を無理やり犯し、敏感なところをいくつも擦り上げ\nただけでなく、膣内出しまでしようとするだなんてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204133" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「た、隊長どのは凶悪犯だっ！　あぁぁっ、んっ！　あっ、ふはぁぁっ！？　\nこのままでは凶悪犯に、孕まされてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　イクッ！　イクッ！　凶悪なペニスでイカされながら、孕ま\nされるぅ！　ひっ、ぎっ……あひぃぃぃ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204135" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁぁっ！　びゅるびゅる出ているっ！　アソコの奥に、熱いのを流\nし込まれているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204136" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「数々の性的暴行を重ねた上に、さらに強制妊娠という罪まで重ねるだなんて\nっ……あっ、あぅっ！　んっ、はぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こんな極悪人の精子を受け止めているというのにっ……子宮が悦んで仕方な\nいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204138" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「精子を注ぎ込まれるたびに、イッてっ……あっ、おぉっ！　ふっ、んっぐっ\n！　くふぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっあっあっ！　また、イクッ……！　隊長どのの赤ちゃん孕まされながら\n、何回もイッてしまうぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204140" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁー……はぁー……んっ、はぁぁっ……ふふっ……たくさん出したようだ\nな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204201" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「子宮が精子で満ちているのを感じるぞ……まったく。こんなに出して、本当\nに孕んだらどうするつもりだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「まさか、責任を取らないだなんて言わないだろうな……ふふっ。もしそんな\nことを言ったら、もはや極刑どころの騒ぎじゃないぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204203" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「……なに？　もうここまで来たら、どれだけ罪を重ねても同じことだと……\n？　ま、まさか……もう一回するというのか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ！　隊長どのの凶器が、膣内で膨らんでっ……！？　はぁぁっ\n……アソコがいっぱいになるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204205" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぁぁっ！　んっ、あっ、くはぁぁぁっ！　ズポズポ激しいっ！　さっきよ\nりも、強く出し入れされているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「快感を感じるたびに、精子で満ちている子宮が悦んでっ……！　私の身体が\n、隊長どのの犯した罪を許してしまっているっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204207" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「これでは完全に合意の上でのエッチになってっ……ひっ、んぎっ！　おっ、\nあっ！　ふはっ、あっあっあっ！　あぁぁ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204208" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「わ、分かった！　合意でいいっ！　今までのことは一切に罪に問わないから\n、もう許してくれぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「私の身体、好きにしていいからっ……！　だから、もう少し手加減をだなっ\n……！　ひぅっ！　ぐっ、あっ、あふぅ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっあっ、おっ、んほぉっ！？　気持ちよすぎて、手加減できないだなんて\nっ……あぁっ！　嬉しくなるようなことを言うなぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「隊長どのに求められると、力を入れていないのに、アソコがキュッと締まっ\nてしまうっ……！　あっ、あっ！　また、きゅ～って締まっているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204212" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「極太で凶悪なペニスを、アソコのお肉でギチギチに締め上げてっ……奥のと\nころが、先端部分に吸い付いているのが分かるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「もっと精子が欲しいと訴えるみたいに、ちゅうちゅう吸い付いて、離れよう\nとしないっ……くっ、あぐっ！　んっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁっ！　はぁっ！　た、隊長どのっ……このままでは、またイッてしまう\nっ……！　気持ちいいのを、感じてしまうぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204215" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「もう孕まされてもいいっ……！　隊長どのが、これからどんな罪を犯しても\n許すっ……だから、イカせてくれっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「隊長どのの、ぶっとい凶器っ……いや、ペニスでイキたいんだっ！　だから\nっ……！　あっ、ひぃぃっ！　おっ、おっ、おぉぉ～！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「すごい勢いで、アソコをズポズポされているぅ！　あっ、これっ、気持ちよ\nすぎるっ！　こんなの、すぐに果ててしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「隊長どのも、イッてくれっ！　私と一緒にイッて……共犯者になってくれぇ\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204219" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んおっ、おっ、おぉっ！　ひっ、んぎぎっ！　うっ、ぐぐっ……！　あっ、\nあっ！　イクッ……イックッ……！　イクぅぅぅ～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204220" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_08" ]},
		{"command":[ "WAITINPUT" ]},
												
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふぐっ、ふっ、おぉぉっ！？　また、せーしがどぴゅどぴゅ子宮に出ている\nぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204301" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「さっきよりも量がすごくてっ……！　それに、勢いもっ……ひっ、あっ！　\nあがっ、あっ……！　おっほぉぉぉ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こんなに出されたら、本当に受精してしまうっ！　私の卵子と、隊長どのの\n精子がくっついてっ……はっ、あふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぁっ……隊長どのの赤ちゃんっ……！　想像しただけで、幸せな気持ちが\n満ち溢れてくるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204304" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、おっ、おぁっ！　イクッ！　幸せすぎてイッてしまうっ！　あっひっ\nあっ、んぁっ、おっ、おぉっ……ほひぃぃぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204305" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁ……ふっ、はっふぅぅっ……すごいイキ方をしてしまった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204306" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「おヘソの下のところに、熱がこもっている……隊長どのの精液で、子宮がた\nぷたぷしているぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ……これだけ証拠があれば、間違いなく言い逃れはできないな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204308" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「この事件の犯人……いや、この子の父親は、間違いなく隊長どのだ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ、これにて事件解決。さあ、男らしく、責任を取ると誓ってもらおう\nか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204310" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、ふはぁぁっっ！？　アソコからペニスが抜けて、身体にかけられてい\nるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204401" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「子宮だけでなく、身体まで精液まみれにするとは……！　あっ、あふっ！　\nすごい量だっ……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ！　いったい、どれだけ出せば気が済むのだっ……ひゃう、あぅ\nっ！　ま、まだ出ているっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「どれほど凶器……いや、精液を溜め込んでっ……！　くぅぅ！　あっ、あっ\n！　匂いもすごいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「このむせ返るような香りっ……何日も着替えず、張り込みを続けていたとき\nの服よりも強烈だっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あの匂いはすごく不快だったが、精液の香りはぜんぜん不快じゃなくてっ…\n…んんっ！　あっ、はっ！　んっはぁぁぁ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふぅっ、んふぅぅっ……胸やお腹が真っ白だ……これでは、マーキングされ\nているみたいだな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204407" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ……これだけ濃厚な香りなんだ。例え拭き取っても、匂いが染みつい\nてしまうだろうな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「それはつまり、隊長どのが私を犯したという証拠……！　なーんて、そんな\nくだらないことを言うつもりはないぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204409" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ニャンコ先生" ]},
		{"command":[ "SETTEXT", "「隊長どのが犯した罪を、すべて許すと言ったのは私だからな。ふふっ……名\n探偵も、快楽には勝てなかったということだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1204410" ]},
		{"command":[ "SETIMAGE", "0", "still_00010012_02_13" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んくうううっ！！　お腹の中全部、満たして……ふううっ！！　んっ、んん\nっ！！　あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んんんっ……気持ちいい……ふっ、うっ……素敵……これが、愛されるって\nことなのね……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104303" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あなたの気持ち……私の中に全部注がれてきてる……好き……私も好きよ、\nあなたのこと……大好き、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふううううっ、んっ……ふふっ、あなたも気持ちよさそうに震えてる……よ\nかった……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「こんなに濃いのをたっぷりと出されたら、子供ができてしまうかもですね…\n…もちろん、そうなったら産みますよ。当然です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「そうしたら、あのお方もまたお言葉をくれるでしょうか……ふふ、息子と孫\nを導く言葉を……案外、孫バカになったりして」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「それを私があなたたちに伝えて……んっ、そんな想像までしてしまいますね\n……ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「でも、それも案外悪くない生活かもしれません……私は好きなあなたといら\nれれば、幸せだって分かりましたから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「だから、これからもよろしくお願いしますね。そして、子供ができるまで、\nまたいっぱいいっぱいしましょうね、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104310" ]},

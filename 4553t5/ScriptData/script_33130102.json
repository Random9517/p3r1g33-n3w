		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んふううううっ！！　また、また来たあっ！！　熱々の精液、私の中に来た\nあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104301" ]},

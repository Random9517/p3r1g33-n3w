{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ああ、来てくれたんですね。こちらにどうぞ。今日は、少し話がありまして\n……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ああ、別に難しい話じゃありません。深刻なものでもありません。ただ、あ\nなたのことが聞きたくて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あの方の言葉を受け取り、あなたを導くものとして……私はあなたのことを\n知っておかなければならないですからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104103" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「好きなこと、好きな食べ物、好きなもの、嫌いなこと、嫌いな食べ物、嫌い\nなこと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「その他、なんでもいいです。あなたのことなら、なんでも……私に聞かせて\n下さい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104105" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふふ、ほら、こっちに来て下さい……隣に座った方が喋りやすいでしょう？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「それで……教えてくれますか、あなたのこと。なにが好きなのか……なんで\nもいいですよ。思いついたものからでも」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104107" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「？　どうしたんですか、そんな落ち着かない動きをして。私に何か……あっ\n……んんっ、そういうこと、ですか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104108" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「まったく、あなたがそういうものが好きだろうなとは薄々気づいていました\nが……私にまで……そうですか。ふふふ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104109" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]}, 

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「もう、そんなガン見されたら、嫌でも気づきますよ。それに、股間も大きく\nなってるの……わかりますから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「こんな、私の身体で……私みたいな身体も好きなんですね、あなたは。ふふ\nっ、いいですよ……私の身体、好きにして」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104111" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「これも親睦を深めるため、あなたが私の身体を好きだというのなら、いいで\nすよ、あなたがしたいようにして――きゃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104112" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あっ、んっ！！　んんっ、好きにしていいとは言いましたが、こんな格好で\n……んうっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んふうっ！！　チンポ押しつけたら……んっ、ていうか、それ、大きくない\nですか……んっ、はっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私の身体でこんなになった、責任を取ってって……それは、んっ、嬉しいで\nすけど……あんっ、やっぱり、大きいっ……ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「もう我慢できないって、ちょっ、ちょっと待って、んっ、はっ……ああああ\nあっ、入って、来た……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「まだ先端だけって……それでも、大きい……んんっ、ふうっ、んっ！！　ん\nくうっ！！　お腹が……ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私も……興奮してるって、それは……だって、あなたと一緒にいたら、こう\nなるに決まってるじゃないですか、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104118" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あああああっ、一気に奥に入れるの、ダメっ、ふうううっ、あっ、あんっ、\nんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104119" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふううううっ、あなたのチンポ、私の中にみっちり入って……んっ、ふうっ\n、ふっ……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あっ、凄い……んっ、入れられてるだけなのに、オマンコ蕩けてるの、分か\nる……んっ、ふっ、チンポ、凄い……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んっ、あっ、ああっ、やんっ、ああっ！！　いきなり、動かしたら……んっ\n、ダメっ、ふあああっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104122" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、お腹、ごりごり擦るの……ふあああっ、あんっ、気持ちいい\nっ、んっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、とんとんってするのも、いいっ！！　あなたのチンポ、私の\n中をかき混ぜて……ひああっ、気持ちいいっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104124" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふううっ、んっ、あっ、くうううっ！！　んんっ、あんっ、あっ、あふうっ\n、んっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「腰が……んっ、ぶつかって……あんっ、ああっ、その衝撃も、んっ、伝わっ\nてくる……ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んうっ……んっ、あっ、お腹、お腹の中、んんんっ、じんじん痺れて……あ\nっ、くうっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふあああああっ！？　こんなタイミングで、好きとか言っちゃ、ダメ！！　\nああっ、んっ、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104128" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「そんなこと、そんなこと言われたら、んんんっ！！　オマンコ、チンポにし\nがみついちゃう、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104129" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あくうっ！！　カリ首が、お腹の中ごりごりって……んんんっ、あっ、頭の\n中まで、チンポの音が、響く……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふううううっ、好きって言いながら、腰、動かしちゃダメ……あんっ、ああ\nっ、あふうっ、ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私も言ってって……んっ、ふううっ、んっ、あんっ！！　好き、好きよ！！\n　私もあなたのこと、好きっ！！　あはあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふあああああっ！！　中で、チンポが膨らんで……好きって、言ったから、\nあんっ、ああっ、あっあっあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104133" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「好き！！　大好き！！　愛してる、んっ、はあああっ、あっ、ああっ、イく\n、イく、あなたのチンポで、イくっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あなたも、一緒に、一緒に、私のオマンコで、イって、ふああっ、あっ、ん\nんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104135" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「イっくううううううう！！　んんんんんんんんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104136" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あああっ、んっ、出てる、私の中で精液出てるっ！！　んはあっ、あっ、あ\nんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「熱い……んっ……どろどろになってる……ふううっ、うっ、あなたのチンポ\nで、お腹の中どろどろになってる……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104138" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んっ、気持ちいい……はあっ、あっ、んっ……ぐりぐりって、押しつけたら\n……あんっ、溶けちゃう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んふうっ……素敵だったわ……頭の中まで……あなたで気持ちよくしてもら\nって……んうっ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104140" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふううっ……あんっ！！　あなたのチンポ、まだ硬いまま……んっ、ふうっ\n、んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「いいわよ……もう一回……んっ。さっきも言ったけど、あなたがしたいよう\nにして、いいわよ。あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104202" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「それに……私も凄く気持ちいいし……ね？　もう一回、私を気持ちよくして\n、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、はっ、また、激しく……ふあああっ！！　チンポが出入りす\nるたびに、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104204" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「頭の中まで熱くなる、ふううううっ！！　あんっ、あっ、あっあっあっ、ん\nふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「また、好きだって……私も、私も好きよ、あなたっ！！　だから、もっとチ\nンポで気持ちよくして、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んっんっんっ！！　ふううううううっ！！　凄い、お腹の奥まで、チンポで\n擦られて……はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104207" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「どろどろに溶けて、私の身体じゃないみたい……んっ、ふっ、お腹、痺れて\n……ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あああっ、んっ、オマンコがあなたを締めつけて、ふっ、うっ、ああっ、ダ\nメっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104209" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「オマンコも、あなたのこと大好きだって告白しちゃってる、んっ！！　ふう\nううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104210" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ああっ、あっ、また、大きくなって……んんっ、凄いっ、ふうっ、んっ！！\n　二回目なのに……ひあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104211" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私のことが好きだからこうなるって、あんっ、ああっ、そんな、そんなの、\n今言われたら……ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104212" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んんんっ、ダメっ、んっ、オマンコがますますチンポ抱きしめちゃうっ！！\n　あうっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104213" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ひあああっ、腰、ぶつけて、ふあああっ、あんっ、あっ、あっあっあっ、私\n、私、もう……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「また、またイく……んっ！！　あなたのチンポで、オマンコごりごりほじら\nれて、またイくっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んふうううっ！！　でも、今度も、あなたと一緒に、んっ、ふっ、ああああ\nっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「好きだから……あなたのことが好きだから、一緒に、一緒にオマンコとチン\nポ、一緒にイきたいっ、あくううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ひうっ、んっ！！　またチンポが大きく、んっ、ああああっ！！　お腹の中\n全部、ぞりぞりって削られてる……ううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104218" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あっ、イく、イく、イっく、またイっく！！　あなたのチンポで、オマンコ\nイっく、んんっ、ふああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「イくうううううううううううううううううううっ！！　ひああああああああ\nああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104220" ]},

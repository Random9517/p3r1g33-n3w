		{"command":[ "SETTEXT", "「あはあっ、チンポが抜けて……んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、背中にかかって……熱いっ、んっ、ふうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んんっ、あんっ、ふっ……もう、中に出して欲しかったのに……いじわるで\nす、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104403" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「最後の一滴まで背中に……んっ、うっ、んふうっ……スーツ越しなのに、熱\nい……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「はっ、あっ……中に出してくれなかったけれど、これはこれで……んっ、さ\nっき中に出したのと、今背中に出されたので……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「なんだか精液でサンドイッチされてるみたい……中と外と……あなたに包ま\nれてるって思えば、悪くないのかも……ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「でも、どうせそうするなら背中だけじゃなく、身体全部にあなたの精液をふ\nりかけられたいですね……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「そうすれば、私の全部があなたのものだってマーキングされますから。ふふ\nふっ、いいアイディアでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「だから……ね、今度は背中だけじゃなく、前も、私の顔も、胸も、お腹も…\n…全部全部、あなたで染め上げて下さい」", "NORMAL" ]},

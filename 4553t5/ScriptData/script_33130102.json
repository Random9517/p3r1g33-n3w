		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私はあなたのこと、なんでも受け止めますから……好きにして……あなたに\nなら、そうされてもいいから。ふふ、約束ですよ」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0187" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……急に呼び出してしまってすまない。しかし……来てくれて嬉しいぞ。い\nや、大した用ではないんだ。ただ、せっかくこんな格好をしたから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503101" ]},
		{"command":[ "SETCHARA", "0", "char_00000135_01", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あなたにだけは、じっくりと見てもらいたくて。その目に、記憶に、焼きつ\nけてほしくて……。私がこんなことを言うのはおかしいか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503102" ]},
		{"command":[ "SETCHARA", "0", "char_00000135_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「フフ……。この衣装には、女をロマンチストにしてしまう妙な効果があるよ\nうだ。それで、だ。この服を見てもらうかわりに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503103" ]},
		{"command":[ "SETCHARA", "0", "char_00000135_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ど……どうだ？　こうして、あなたが喜ぶような……催し物を考えてみたん\nだ。こちらの世界では、これを女体盛りケーキというそうだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503104" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「男がとても喜ぶと聞いて……試してみた。多少浮かれているのかもしれない\n。二度もこんな風に、あなたと子作りができるとは思っていなかったから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……む……。面食らっているようだが、せっかく用意したウェディングケー\nキだ。あなたに食べてほしい。生クリームとイチゴのデコレーション……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「和服であれば刺身を乗せたりもするそうだが、今回は洋風だ。次が……三度\n目があれば、また改めて考える。だから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「今回は、私の気持ちということで……。これをあなたに舐めてほしい。……\nあっ……♪　そ、そうだ。た、ためらいもせずにパクッといったな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「フ、フフフっ……。く、くすぐったいが……あなたの濡れた舌と、その口の\nあたたかさ……イヤな感触ではない。続けてくれ……。はぁ、はぁ、はぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ……！　あっ、ぅ……♪　そ、そうか……まずは目立つイチゴを食べて\n……。んぅっ！？　ンンッ……次にクリームを舌で舐め取る……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あ、ああ。そのまま舐めていてくれてかまわないが……。フフフ、こうして\nいるとあなたがまるで私の赤ん坊になったかのように感じる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「懸命に舌を動かして、私の胸のクリームを味わって……。んっ、乳首を探し\nて、吸いついて……。こらこら、母乳はまだ出ない。……んんっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「そんなに美味しいか？　それならもっと舐めてくれ……。クリームはいくら\nでも追加できるからな。……よし、よし……。ああ、愛おしい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……あ……♪　あ、ぁ……♪　ん、も、もう充分だ……かなり胸の感度があ\nがってきた。舌で感じるだろう？　胸の先がピンと勃起して……あ、ぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「わ、私が奉仕するつもりできたのにあなたに奉仕させてしまってすまなかっ\nた。ここからは私にも奉仕させてくれ。いつもの感謝と……あ、愛をこめて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「つまり、こういうことだ……♪　んっ、こら暴れるな……。はぁあ……♪　\n胸で挟んで、距離が近くなっただけでわかる……この独特の臭い……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「思えば、もう何度もあなたとは身体を、肌を重ねてきた。だからこそ……。\nんッ、どうだ？　あなたのいいところ、感じるところを心得ているだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁっ♪　こうして……凝り固まったオチンポを、根元から先端までしごき\nあげて……っ、んっ、胸を押しつけ、絡ませながらまたずり下ろす……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……んんっ？　なんだか、いつもより反応が大きいような……。あ、もしか\nしてこのクリームか？　これが胸にトロみを加えてくれているようだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ん……んん……っ。オチンポがベタベタしてしまうかもしれないが、……は\nぁっ、どうせ精液で汚れるだろう？　後で綺麗に洗ってやる……だから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「いっそのことっ……♪　はぁっ♪　今までで一番汚すつもりで、……あっ♪\n　ドロドロしていこうじゃないか……あっ、んっ、大きいな……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あなたのオチンポの熱で、クリームが柔らかくなっている……。あっ。こ、\nこれ、は……私の胸も気持ち、いいな……とても良くヌメるぞ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁあああ……っ。あ、甘い声がもれてしまう……！　は、ぁっ、あぁあ…\n…っ。こう、だろう……？　あっ、胸全体を押しつけるようにして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ、上半身全てを揺らし、て……大きくオチンポを刺激していく……っ\n。んくっ、ぶるんと胸が弾むのも、好き……だっただろう？　ほら、ほらっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「たまに細かく胸を揺らし、て、そのままなめらかに左右バラバラに……あぁ\nあっ、オチンポの表面を撫でて、揉んで……潰して……もてあそぶ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んんんぅっ！？　お、驚かせるな……。あなたの腰が動いたから不意を突か\nれて感じてしまった……。私の胸も、ぁっ、相当敏感になっている、なっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あ、あぁ……♪　あなたのオチンポの熱と、私の胸のぬくもりと……♪　２\nつが混じり合って、とても心地いい……あたたかくて、あっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「まるで初めから１つだったみたいに……。ンッ……。……あぁ……どうして\nこんなにも、オチンポは魅力的な形をしているんだ……、ん、ぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「女にはない特別な部位……。いくら触っても飽きたりん……っ。はぁっ、ゴ\nツゴツしていて、……あっ、硬いのに弾力があって、……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「私がうまく刺激するとビクビク震えて教えてくれる……。ぁっ、こ、ここか\n？　ここがいいんだな……ああ、いくらでもこすってやるぞ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……だんだん、クリーム以外にもヌルヌルしたものが……。あっ？　これは\nあなたの先走りの汁……カウパーというものか？　あっ……すごいな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「次々に滲み出して……あっ、ぁっ、ますますすべりが良くなってきた。あっ\n……！　き、気持ちいい……！　胸を動かすのをやめられん……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んっ……ん、ん……っ。どうだ……？　精液が睾丸にしっかり溜まってきた\nか……？　今、すぐに楽にしてやるからな……安心していてくれ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あ、ああ……もちろんだ、好きな時に出してほしい……！　私の胸の全てで\n受けとめるっ……！　はぁっ、私の胸はとっくにあなただけのものだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「だからあなたの精液を、あっ♪　いくら流しこまれても……ひっかけられて\nもかまわないっ……！　くぅっ♪　出してくれ、精液が欲しい……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ、ふぅうううっ……♪　いいぞ、ビュルビュルと溢れ、飛び出してき\nたっ……！　あっ♪　あっぁっ、もっと、もっとだ、もっとぉっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_04" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「いいぞっ、私の胸の中にあなたの精液がほとばしっている……！　この純白\nの雫……♪　熱く、粘り気のある体液……はぁ、あぁ、広がっていく……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「そうか、こんなに濃い精液を噴出させるほど感じてくれていたんだな……！\n　感動だ、フフフ、クリームと精液で私の胸が真っ白だ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ん？　どうした、うまく全てを出しきれないのか？　慌てるな……私が胸で\n絞り出してやる……。ンッ……んん、ほらっ、ビュッと出たぞ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ……♪　どうしてこんなに精液というものはいやらしい臭いを撒き散ら\nすんだ……。こ、こちらの欲望にも火がついてしまうではないか……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「っん……。まずはこれくらいの量でいいだろう。いや、想像よりもずっと多\nいが……。一旦はオチンポもスッキリしたんじゃないか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「飛び散った精液を見ていると……嬉しくなってしまうのはなぜだろうな。私\nが絞り出したものだからか？　……と、な、何をしている？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ！？　し、下から突き上げているのか？　出したばかりなのに大丈夫な\nのか？　……くぅっ！？　ど、どんどんオチンポが硬くなってくる！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あッ！？　ま、まだあなたは満足しきっていなかったのか！？　……違う？\n　満足だったからもっとしたくなった？　そんなことがありえるのか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……んっ、うっ、くぅっ、うぅううっ……？　わ、私の献身的な奉仕に対し\nて、自分もお返しがしたくなった、だと？　なんと殊勝な……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「と、人が真面目に話しているのに、あなたはオチンポを容赦なくこすりつけ\nてくるのだな！　ま、まあ……こちらもしたくないわけではないが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「もっとムードというものが……。と、今はそれよりも再び勃起してしまった\nオチンポのことを考えるべきか。いいだろう、何度でも奉仕しよう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「だからあなたも、私の胸の動きに合わせて……。ッあぁっ♪　そ、そうだ、\n上手いぞ……！　そうやって、あなたがオチンポで下から突いて、ぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「私が胸で上からずり下ろすっ……！　ぅっ♪　あっ、あぁっ、あ、あぁっ…\n…！　こ、れは……！　２人が力を合わせたことで快感が倍以上に……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ！　そんなにズリズリと激しく胸を刺激されたらっ……わ、私の方まで\n感じてしまって……！　は、ぁ、くぅうっ……んんんぅっ……！？　あうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「そ、そんなにめちゃくちゃに腰を動かす、な……！　あっ、わ、私が全部し\nてやると言っているのに……っ。あっ、いけない、乳首にこすれて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「か、感じてしまう……、あっ♪　なんというパワーだ……！　しかし私も負\nけてはいられん、胸を弾き返されたままでいられるか……くぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「どう、だ……っ？　あぁっ、あっ……！　こちらも動きを派手に、大きくっ\n……！　あっ、乳房を上下左右に揺らしていく、ぞ……！　あっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ん、く……っ！　２人とも動いていると、快感が凄まじい……！　ッあっ…\n…！　うぅっ！　はぁっ……はぁ、ん、ぅ、う……♪　くぅううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁっ、あなたの精液のヌメりで動きが止まらない……！　あぁっ、すごい\nぞ、私の体温がどんどん上がって……む、胸が柔らかくとろけて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503215" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁっ♪　あなたのオチンポを丸ごと包みこんで、胸の谷間に収納\nしてやる……！　あっ、そして上下に激しくしごいて……あっぁっあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「硬いオチンポがっ、胸をズブズブ貫いて……あっ！　ものすごい勢いで突き\n刺してくるっ！　あっ……あなたの股間には限界がないのか、あっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「す……まない、私が奉仕しているのに、……くぅうぅっ！　胸でイキそう、\nだ……！　あっ、イッてもいいかっ？　イク……イ、ク……っ！　ううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ふぁああッ……♪　だ、だめだ……イクと胸がゆるんでしまう、ここでもう\n一度締めつけて……あっ♪　そうだ、あなたも一緒にイッてほしい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁっ、そのままっ……そのまま来てくれ！　私の胸に、あなたのザーメン\nをぶちまけてほしい！　あっ♪　あっ、出してくれっ、早く、早くぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503220" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「ンンッ！？　あぁああああああぁっ……！　あぁ……！　イイぞっ……！　\nもう逃がさんっ……！　射精し尽くすまでオチンポを搾り抜くっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「それっ……！　んぁっ！　ビュルッ……ビュルビュルと！　あっ♪　音がし\nそうなくらい精液が……ザーメンが打ち上がってくる、すごく熱い！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「く、ぅ……♪　ふっ、くぅうううっ♪　わ、私の鍛え抜いた胸筋で全て受け\nとめてみせる……！　胸を寄せて、力をこめて……オチンポを圧迫して！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「精液の出口を塞ぎながら……。んんんっ！？　な、なんだと！？　私の乳房\nですら抑えきれない！　あっ！　ザーメンに突破されるっ、んぐぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503304" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁっあぁあっ……！　も、もう私には止められないぃ……！　あっ、こん\nなに大量にザーメンが、……あぁっ♪　溢れてこぼれてしまうぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「オチンポがドクドク胸の中で脈打って！　む、無限にザーメンが出てくる…\n…！　は、ぁっ、あぁ、あなたの臭い、この臭いが嗅ぎたかった……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……はぁ、はぁ、はぁ……。ん……？　どうした。私が急にかいがいしくな\nったかから不安になったのか？　さ、最初に言っただろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「こういう服を着ている時は……私でも、さすがに誰かに尽くしたくなる。そ\nしてその相手はあなたしか考えられない。それだけの話だ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「別に、あなたが嫌だったならもうしない。……嫌ではなかった？　そ、そう\nか。それならおとなしくこれからも、私に尽くされているんだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……誰かに尽くしたいと思ったことも、こんな服を着て、だ、誰かの妻にな\nりたいと思ったのもあなたが初めてだ。多少ぎこちないのは許してほしい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ……！？　ま、待ってくれ、そっちは顔で……！　んぷぅっ！？　お、\nおいっ……！　む、胸ではなくて顔に出ているぞ、うぁっ、あああっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あ、あなたももう制御できないのか！？　それほどまでに興奮して……！　\nんむっ、けほっ！　く、口に入った……ヌルヌルして……んっ、んっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「まさにザーメンの雨……！　本気のザーメンシャワーだなっ……、あっ……\n！　熱いドロドロが顔をつたって……、あっ、も、もったいない！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「こ、こうなってしまったらできるだけ顔の上の方に出してくれっ……。あ、\nあぁ、後で舐めとれる分は舐めとる……！　だから額に……ああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あなたのザーメンで、私の顔も、胸もネバネバだ……。こんなこと、他の誰\nかにされたら絶対に許せない……。でも、あなたのザーメンだと思うと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「なぜかもっともっと浴びたくなる……っ。それどころか、発情してオマンコ\nが切なくなって……疼く、恥ずかしい身体になってしまった……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「……あっ……。どうやら射精し終わったようだな……？　フフ……。射精の\n後の、あなたのその満足そうな顔が私はとても好きだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000135_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「まるで、熾烈な戦いを終えたばかりの戦士のような……それでいて、無垢な\n少年のような、私に気を許してくれているような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「この表情を、他の誰にも見せたくないと思ってしまうのは、嫉妬かもしれな\nいな。私にはあなただけなのだ、だからあなたも……叶うのならば」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "Ａルナテミス" ]},
		{"command":[ "SETTEXT", "「あなたの花嫁であるこの私だけに、そうした表情を見せてくれるとありがた\nい。もちろん、これは私だけの希望だがな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3503410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
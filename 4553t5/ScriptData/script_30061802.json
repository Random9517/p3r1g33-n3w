		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あれっ？　ダーリン、どこに行くのぉ？　……パーティ会場に戻る？　あっ\n……ま、待ってちょうだぁい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804103" ]},
		{"command":[ "SETCHARA", "0", "char_00000618_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっ……ちゅっ、くちゅっ……んっふっふっ♪　ダイヤナちゃんを介抱して\nくれたお礼は、キスだけじゃ終わらないわよ……こっちに来てちょうだぁい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804104" ]},
		{"command":[ "SETCHARA", "0", "char_00000618_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっ……んっ、はうぅっ……ダーリンの大きなオチンポが、オマンコにあた\nってるわぁ♪　あっ、あんっ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},

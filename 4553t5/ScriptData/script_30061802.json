		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ひゃ、あひっ！　はひぃぃぃんっ！　ダーリンのザーメン、身体にどぴゅん\nされちゃってるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「オマンコだけじゃなくて、全身もダーリンの精液で染め上げられてぇ！　あ\nはぁぁっ！　こ、これっ、幸せすぎるわぁ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804402" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんがダーリンの女だって証を、子種で刻み付けられてるみたい\nでぇ……！　あっ、あぁんっ！　嬉しいのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こんな幸せを味わったら、もう宝石もお金もいらないっ！　ダーリンがそば\nに居てくれたら、それでじゅうぶんだからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ！　もっとかけてっ！　ダーリンの精液を身体中ぶかけて、ダイヤ\nナちゃんにマーキングしてぇぇぇ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっ……あぅ……全身ベトベトになっちゃったわぁ……さすがはダーリンの\n射精量ねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こんなに出してくれるなんて、やっぱりダーリンは素敵だわっ……ホント、\n惚れ直しちゃうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それに、まだオチンポが勃起したままでっ……まだ出したい、ダイヤナちゃ\nんのこと犯したいって言ってるみたい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ねぇ、ダーリン……今日は一晩中可愛がってくれるんでしょっ？　なら、も\nっとオマンコしてっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804409" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「お口でも、おっぱいでも、お尻の穴でも……ダーリンが犯したいところは、\n全部使ってくれていいからねっ♪」", "NORMAL" ]},

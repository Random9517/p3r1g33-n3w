		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっひぃぃぃ～っ！？　熱くてドロッとしたザーメン、子宮にどぴゅどぴゅ\nされてるぅ～！」", "NORMAL" ]},

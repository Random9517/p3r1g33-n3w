		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっ……ダーリンの子種で満たされてるって思うと……イッたばかりなのに\n、オマンコ疼いてきちゃうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804203" ]},

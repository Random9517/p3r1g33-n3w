		{"command":[ "SETTEXT", "「そんなに勢いよく赤ちゃんの部屋の入口を押されたら、子宮口がもっと開い\nちゃうっ！　オチンポが子宮に入っちゃいそうになるからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっ、ひゃ、あっ！　あひぃっ！　背筋がゾクッてして、気持ちいいの止ま\nらないのぉ～！　オマンコ気持ちよすぎるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのザーメンで、またイキたくなっちゃうっ！　膣内でも膣外でもい\nいから、精液浴びせて欲しくなっちゃうわぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「おっ、おぉっ！　おぉ～～～っ！？　オチンポがさっきよりも膨らんでるぅ\n！　ぶっといオチンポが、さらにぶっとくなってぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804216" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「オマンコがもっと拡げられて、めちゃくちゃになってるのぉ！　ダイヤナち\nゃんのオマンコ、ガバガバになっちゃうかもぉ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こんなの、もう完全にダーリン専用よぉ！　オマンコも子宮も、ダーリンだ\nけのものなのっ！　好き好きっ！　ダーリン、愛してるぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのことが大好きなダイヤナちゃんを、極太オチンポでイカせてっ！\n　ダーリンの女だって、証明してぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「イクッ！　イクッ！　オマンコまたイッちゃうわぁ！　ダーリンのオチンポ\nでイッちゃうっ……イッ、イクッ！　イクッ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ぐっ！　うっあっ！？　ま、また膣内にっ！　子宮に精液どぴゅーってされ\nてるわぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「これ、子宮の奥の奥にまで入ってきてるっ！　こんなに出されたら、ダイヤ\nナちゃん妊娠しちゃうぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でもダーリンの赤ちゃんなら孕んであげたいし、産んであげたいのぉ！　大\n好きなダーリンの子供なら、何人だって孕んであげるからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あはぁぁぁっ！　射精しながら、奥のところにオチンポ押し付けられてるっ\n！　絶対に孕ませるって言われてるみたいよぉ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こんな種付けされたら、受精しちゃうぅっ！　ダーリンの赤ちゃん孕みなが\nら、イッちゃうわぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はっ……あっ、あぁ……オマンコに入りきらなくて、ザーメンが溢れてきち\nゃってるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「お腹いっぱいで苦しいのにっ……幸せすぎて、全然つらくないわぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はふっ……んっ、ふっ……ふぅぅぅっ……んっ？　なぁに？　もう１回セッ\nクスしたいのぉ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804308" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっふっふっ♪　いいわよぉ～。もう１回と言わずに、ダーリンが満足する\nまで犯してくれていいからねっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「だってダイヤナちゃんはダーリンの女なんだものっ……エッチしたいなら、\nいつでもどこでも、オマンコさせてあげるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804310" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「調子に乗って飲みすぎてたから、もう少しセーブした方がいいのぉ？　それ\nは分かってるけどぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804102" ]},

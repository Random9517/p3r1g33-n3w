		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのことが好きすぎて、オチンポにご奉仕したくなっちゃってるわぁ\n！　あっあっ、あんっ！　はぁぁんっ！」", "NORMAL" ]},

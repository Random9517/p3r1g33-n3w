		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほらっ……これはお礼なんだからぁ、遠慮しないでオチンポ挿れていいのよ\nぉ。ダーリンのぶっといオチンポ、ダイヤナちゃんのオマンコに挿れて？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「いっぱいオマンコぎゅ～ってして、気持ちよくしてあげるからぁ……あっ、\nあっ！　んぁ、あっ！　割れ目の入口で、オチンポが擦れてぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「そんなことしなくてもいいのよぉ……ダイヤナちゃんのオマンコは、もう準\n備できてるからぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンがこの部屋に連れて来てくれた時から、子宮がズキズキって疼いて\nてっ……ダイヤナちゃん、発情しちゃってたのっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「だって出会ってからもう何年も経つのに、ダーリンは相変わらず優しくて、\nかっこよくてぇ……惚れ直しちゃったのぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「せっかく二人っきりになれたのに、パーティー会場に戻るって言われて……\nダイヤナちゃん、寂しいって思っちゃったんだからねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「この寂しさをダーリンのたくましいオチンポで埋めて欲しいのっ……いっぱ\nいズポズポして、オマンコ感じさせてほしいのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんんっ！　い、いきなりオチンポが入ってきてぇ！　ダイヤナちゃんのオ\nマンコ、いっぱいになってるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「な、なんで急にやる気を出してっ……なぁに？　ダイヤナちゃんが可愛くて\n、急に性欲のスイッチが入っちゃったの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっふっふっ♪　それでこそダーリンって感じよぉ。ダーリンの性欲を受け\n止められるのは、ダイヤナちゃんだけなんだからっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「遠慮しないで、ダイヤナちゃんのオマンコを使ってねっ。好きなだけ出し入\nれして、オチンポ気持ちよくなってぇっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あはぁぁぁんっ！　あんっ、あんっ！　あっ、あぁぁんっ！　すごいわっ！\n　ダーリンのオチンポが、オマンコを激しく擦ってくるぅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804117" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_30b_0000", "ev005_30b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「やっぱり太くて、カタくて、大きいのぉ！　ダイヤナちゃん、ダーリンのオ\nチンポにメロメロなのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンも、ダーリンのチンポも大好きっ！　もう絶対に離れたくないし、\n離さないんだからぁ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ひゃ、あっ！　くふっ、うぅっ！　んっ、くぅ～っ！？　出し入れの動きが\nどんどん速くなってるわっ！　あっ、あっひぃぃぃんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804120" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「股間のお肉がぶつかり合うたびに、パンパンっていやらしい音が鳴ってるわ\nぁ！　ダーリンとセックスしてるって、実感しちゃうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「もっと奥のところをえぐってちょうだいっ！　ダーリン専用のドスケベオマ\nンコ、い～っぱい締め付けるからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふひっ！　んっ、おっ！　おぉぉっ！　奥のところで亀頭が円を描いてるっ\n！　オチンポで子宮口をグリグリされてるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「これ、気持ちよすぎるのぉ！　大事なところをめちゃくちゃにされるの好き\nっ！　ダーリンのオチンポで犯されるの大好きぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンが気持ちよくなってくれてると、ダイヤナちゃんも嬉しくてぇ……\n！　もっとオマンコ締めたくなっちゃうわぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あぐっ、くっ……！　うぅぅぅっ！　おヘソの下のところに力を入れると、\nオチンポの形がはっきり分かるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんのオマンコ、ダーリンの形を覚えちゃってっ……本当に心も\n身体も、ダーリンのモノになっちゃってるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっ、あんっ！　はぁ、あはぁんっ！　ダーリンの精子が欲しいって、子宮\nが訴えてくるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんの子宮口が開いてっ……それに子宮もどんどん降りてきて、\nオチンポとキスしてるぅ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「オマンコもダーリンのオチンポ好き好きって言ってるみたいでっ……ひゃ、\nあっ！　あぐぅぅっ！　こんなの、我慢できないわぁ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダ、ダーリンっ！　ダイヤナちゃん、そろそろイキそうっ……！　オ、オマ\nンコイッちゃうからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「お願いっ……一緒にイッて欲しいのぉ！　ダーリンのザーメンを子宮に注が\nれながら、イキたいのぉ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっ、ほっ！　おっ、ふんぎゅうぅっ！？　ダーリンのオチンポが膨らんで\nっ……それに、勢いよく跳ねまくってるわぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804133" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンがイキそうなの分かっちゃうっ！　ずっとエッチしてきたから、ダ\nーリンの射精の合図覚えちゃってるのぉ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「イクッ！　イクイクッ！　ダーリンのオチンポでイカされちゃうっ！　オマ\nンコイグッ！　イッグぅぅぅ～～～っ！」", "NORMAL" ]},

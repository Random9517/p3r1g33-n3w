		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっあっあっ！　ふぁぁっ、あっ！　ザーメン受け止めながらイクッ！　イ\nクぅぅぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁ……今日もたくさん射精してくれて、すっごく嬉しいわぁ～……さ\nすがはダーリンねぇ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000618_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「子宮の中が真っ白になってる感じがするわぁ……おヘソの下のところ、すっ\nごく熱いもの♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1804202" ]},

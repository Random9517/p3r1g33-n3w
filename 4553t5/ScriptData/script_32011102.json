		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「お前とこうして『姫はじめ』というものをするためだ♥　どうした？　母が\n下着をつけていないことがそんなにおかしいか？」", "NORMAL" ]},

		{"command":[ "SETNAME", "刻の女王" ]},
		{"command":[ "SETTEXT", "「そのようすだと、まだのようだな。安心したぞ。なぜこんなことを聞くのか\n、だと？　そんなの、決まっているではないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_201_1104104" ]},

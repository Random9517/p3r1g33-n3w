		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「にゃにゃーんっ！　はーい、隊長君、ちゃんと時間通りに来れてえらいねぇ\nー♪」", "NORMAL" ]},

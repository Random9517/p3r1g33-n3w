		{"command":[ "SETIMAGE", "0", "still_00026602_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ほらっ、あぁっ、もうイクでしょっ？　おねーさんに遠慮しないでっ、もう\n一回っ、イッちゃいなさいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はっ、あぁんっ、そしたらっ、私もっ……イクからっ、はっ、んんっ、だか\nらっ、早くっ……イッて！　おちんちんっ、出してぇっ！」", "NORMAL" ]},

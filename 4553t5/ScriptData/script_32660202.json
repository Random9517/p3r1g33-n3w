		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んんっ、最後まで……出しちゃおうね……♪　おまんこの中……とぷとぷに\nさせてぇ……はぁぁんっ、そぉ……中ぐちゃぐちゃでぇ……」", "NORMAL" ]},

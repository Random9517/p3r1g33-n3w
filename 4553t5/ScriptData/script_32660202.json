		{"command":[ "SETIMAGE", "0", "still_00026602_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「でもっ、バステトおねーさんは……負けないよっ、んにゃっ……おまんこっ\n、本気の締め付けぇっ、はぁぁぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んっ、続けて……円運動ぉっ♪　ぐりぐり、回してぇっ……続けて縦にっ、\n何度もっ、上下ぇっ♪」", "NORMAL" ]},

		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「という訳で、これからするのは抜き打ちテストでーす♪　ちゃんと、成長し\nてるかなーっていう実力テスト♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204102" ]},
		{"command":[ "SETCHARA", "0", "char_00026602_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はい、隊長君はじっとしててね。とりあえず、邪魔なモノだけとっちゃおっ\nか♪　大丈夫、ぜーんぶやってあげるからね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204103" ]},
		{"command":[ "SETCHARA", "0", "char_00026602_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_01" ]},
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ほぉら……んふふっ、どう……？　バステトおねーさんのボディ……魅力あ\nるかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204104" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「おぉー♪　ちゃーんと、おちんちんがムクムクしてる♪　んふふっ、よかっ\nたぁ。ちゃんと私に魅力があるってことでいいのかな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ま、今回の主導権は私だから♪　隊長君は、おちんちんにだけ集中して、じ\nっとしてていいからね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ふふ……入口のところをすりすり～♪　あはぁー、ほら……おねーさんのお\nまんこ……どうなってる？　濡れてるよねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204107" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ふふん……そうだねぇ……当然、こんなのずぶって入れちゃうしかないよね\nぇ？　はーい、入りまーす♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んんっ、あっふ……！　はぁぁぁんっ、おちんちんっ……んっ、ずぶって…\n…入っちゃう……ぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204109" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ほぉぉぉぉっ……♪　んぅ……くぅ……これは、なかなかの大きさだねぇ…\n…♪　おねーさんのおまんこが、くぱって広がってる感じするよ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204110" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「このまま、もうちょっと腰を落としてぇ……はぁぁんっ、ふっ、はーい、ぺ\nたんってお尻ついちゃったぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、どう？　おねーさんのおまんこ……あったかくて気持ちいい\n？　んふふっ、そうだろうねぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204112" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「これでも、締まりにはちょっと自信があるからねぇ……♪　だから、すぐに\n出しちゃわないように、隊長君……頑張ってね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「じゃあ、ゆっくり動かしてくよ？　ほぉら……太いのっ……ずりずりっ、し\nちゃう、ぞっと……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、はんっ、あっ、んふんっ……！　あはっ、これ……思った以上\nにカチカチで……強いおちんちんになってるじゃない……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204115" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「おねーさんの、ヒダヒダの感じるとこぉ……ズリって擦るとっ……あんっ！\n　かなり、気持ちいいかもぉっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はふん、あっ、んっ、ふっ……ねっ、どう？　おまんこの濡れてざらざらし\nてるトコ……いっぱい当たってるよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204117" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「こうしてっ、うんっ、ふっ、はんっ♪　トランポリンの上に乗ってるみたい\nに、上っ、下っ、ゆさゆさっ、させてるのっ、すごっ、いい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「おっぱい……たぷたぷさせちゃってるの……じっと見てるねっ♪　いいよぉ\n、おねーさんの豊満おっぱい、目で楽しんでぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204119" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「その代わりぃ……私もっ……しっかり、このおちんちん楽しませて貰っちゃ\nうからっ♪　はんっ、あふんっ、はっ、ひぁっ、あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んんっ、いいねぇ……この長さと太さ……おまんこいっぱいに、おちんちん\nを感じられるよぉ……あふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204121" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「しっかり、内側から包みこんでぇ……キュンって締め付けるっ……おねーさ\nんの得意技ぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ほら、んっ、おちんちん……喜んじゃってるでしょ♪　やっぱり、先端のと\nこが……一番、敏感だよねぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「だからぁ……んっ、こうやって……腰を回すとぉっ……んふっ、あぁんっ…\n…！　感じるところっ、色々擦れてっ……声……出ちゃうぅん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204124" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はふっ、あんっ、はぁんっ……すぐ、ギブして出しちゃうかと思ったけど…\n…なかなか……やるねっ、んんっ……はんっ、あふっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「もっとおねーさんのおまんこを味わいたいってことかな？　んんっ……いい\nよぉ、ほら……ずぼずぼっ、いい音させちゃおぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204126" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んふっ、あんっ、おっぱいも触りたい？　んっ、いいけど……腰振る邪魔に\nならない感じでねっ……はんっ、あはんっ、あっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んふっ、おっぱいも……ちゃんと興奮してるって分かるでしょ？　んんっ、\nくぅっ……乳首とか……もうピーンだし♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204128" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ちょっと見えてるかもだけど……クリトリスもぉ……ずっとムズムズしちゃ\nってるんだからぁ……はっ、あぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「でもぉ……んふふっ、余裕のなさで言ったら……隊長君の方が、もっと危な\nいかなぁ……？　このおちんちんの震え方……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「それに、漏れてる色っぽい吐息ぃ……♪　あはっ、聞いてるとゾクゾクしち\nゃうねぇっ♪　ほれほれ……もっとおまんこ速くなっちゃうぞぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「うんっ、はっ、ずぷっ、ぬぷって……やらしー音響いてるっ……もう負けち\nゃうのかなー？　おちんちん、我慢できない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204132" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「おっ……んふふっ、とりあえず踏ん張ったねぇ。でも、やっぱり時間の問題\nって感じかなぁ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204133" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はっ、んうぅんっ……こうやって、腰をぐりぐり回してっ、おまんこのヒダ\nヒダっ……擦り上げたらぁっ、また声が出ちゃってるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「さあ……負けちゃえっ♪　中でいいからねぇっ、バステトおねーさんのおま\nんこの中にっ、濃くて熱いのっ……いっぱい出しちゃえっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んぁぁぁぁぁぅんっ！　はぁぁぁんっ、出たぁっ……♪　隊長君の負けーっ\nて……言いたいとこだけどっ、は、ひゃっ……ふっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204136" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「私もっ……あんっ、あぁっ、ほとんど同じで……イ、イッちゃったっ……あ\nっ、おまんこっ、ぴくぴくっ、するぅぅぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204137" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はっ、はぁぁっ、あっ……すごい勢いで……おまんことぷとぷにされちゃっ\nた……んふっ、めちゃくちゃ溜め込んでたんじゃない……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んっく……隙間からちょっと漏れちゃってる……♪　このトロッとしてるの\n……エロエロだよねぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んふふっ……そうだねぇ、点数としては７０点くらいかな？　もうちょっと\n、しっかり踏ん張ってくれたら、後１０点プラスしたかも♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204140" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「さてさて♪　その辺は次回の宿題……と言いたいとこだけど、このおちんち\nん……まだ、おまんこの中で動けそうだねぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「それなら、もう少し加点する為に……補習の２回戦……いってみよっか♪　\nはい、もう、そういう風に決まっちゃいましたぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はふっ、んっ、ふっ……んんっ、おねーさんもぉ……ぶっといおちんちんで\nグリグリされてぇ、スイッチ入っちゃったみたいなんだよねぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204203" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んぁっ、うんっ、あぁっ……この、奥の……おねーさんの弱点に……ちょう\nどグリって当たるのが……んんっ、良すぎてぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はぁんっ……中出しされたおまんこっ……ぐちゅぐちゅ……かき混ぜたくな\nっちゃうよねぇっ……んふぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ほら……しっかり、踏ん張ってねぇ♪　おねーさんもぉ……しっかり、おち\nんちん……締め付けてあげるからぁ……はっ、んぅっ、んく……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204206" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「そうそう……男の子なんだから、ぐっとお腹に力を入れてぇ……はぁんっ、\nいいよぉ……ずぷずぷ音っ……やーらしいよねぇっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「ほら……見て見てぇ……♪　おちんちんとおまんこが、ずぼずぼってまぐわ\nってるとこぉ……思いっきり広がってるぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204208" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「この繋がってる場所……エッチだよねぇ……♪　はぁぁんっ、じっと見られ\nてるって思うと、またおまんこジュンってしちゃうからぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、はぁんっ……ほらほら、隊長君もされっ放しでいいのかな？\n　もっとおねーさんのおまんこ、ゴリゴリ突き上げていいんだよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「んぁひぃっ！　そっ、そおっ、それぇっ……♪　はぁぁっ、あふんっ、あぁ\nっ、いい感じに、おちんちんっ……サカッてるぅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204211" ]},
		{"command":[ "SETIMAGE", "0", "still_00026602_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「あんっ、あぉんっ、ほぉぉんっ♪　あぉっ、おぉっ……なんか……勝手に、\n野太い声が、おぉぉぉっ、出ちゃってるしっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、あぁっ、あひっ……！　おちんちん、本気出して来たぁっ……\nんぁっ♪　あっ、それぇっ、すごくっ、いいのっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204213" ]},

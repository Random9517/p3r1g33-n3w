		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、ヤバ……負けちゃうっ♪　おまんこ負けちゃう♪　ダメっ…\n…これは、隊長君の特訓なんだからぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「おねーさんが……先にイカないでっ……んんっ、ちゃんと……おちんちんっ\n、鍛えてあげるんだからっ、はぅっ、んくぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_266_0204215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "バステト" ]},
		{"command":[ "SETTEXT", "「はっ、んぁっ……んふふっ♪　下からのスパートが……本気出してるっ♪　\nどっちが先にイクか……競争みたいになってるかもっ♪」", "NORMAL" ]},

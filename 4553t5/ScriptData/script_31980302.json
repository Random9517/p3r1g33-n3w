		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あんさんのことは嫌いやないけど、邪魔するんやったらここで始末を……っ\nて、あれ？　なんや、えらい身体が疼いてまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304102" ]},
		{"command":[ "SETCHARA", "0", "char_00019803_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「もしかしてうち、自分の香りに酔うとるんか！？　ア、アカン……隊長さぁ\nん……後生やから、助けておくれやす……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304103" ]},
		{"command":[ "SETCHARA", "0", "char_00019803_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ふふっ……あんさんはホンマ、優しいお人どすなぁ～。うちのせいでこない\n悲惨な状況になっとるのに、助けてくれるやなんて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304104" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「もしかして、うちの性欲を解消するためやのうて、あんさんがただエッチし\nたいからとか、そないな理由なん？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「まあ、うちはどんな理由でもええけどね。結果的にあんさんのおちんぽに跨\nがれとるんやし♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304106" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あんさんもうちの芳香でやる気満々やね。おちんぽ、めっちゃかとぅなって\nはるなぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304107" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「はよううちのおまんこに挿れたい……ズポズポして欲しい……そないなこと\n言うてるみたいや♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304108" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ん～？　焦らさんと、はようセックスしたいん？　ふふっ……うち、素直な\n人は大好きどすえ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304109" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「んっ……あっ、はぁぁっ……でも、まだアカンよ。うちのおまんこ、もっと\n濡らさな……あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304110" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「んっ！　んっ！　あんさんのおちんぽで、割れ目とクリトリスが擦れとるわ\nぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304111" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「これ、めっちゃ気持ちええ……あんんっ！　こんなん、すぐにおまんこ濡れ\nてきはります……んくっ！　はぐぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304112" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「これ、気ぃぬいたらすぐに入ってまうわ……はぁ、あっ！　あぁぁっ！　入\nり口のところに亀さんが当たっとるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「な、なんや？　このまま挿れるから覚悟しろやなんて……ふふっ。アホなこ\nと言いなさんな。あんさんに主導権なんかあらへんよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304114" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「このままうちが満足するまで焦らしてから、おちんぽを挿れて……ひゃ！？\n　あっ、あっ！？　隊長さんの腰が浮いてきて……んん～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304115" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「はひぃぃぃっ！？　あぅ、あっ！？　う、うちのおまんこに隊長さぁんのデ\nカおちんぽ入っとるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304116" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あっ……これ、アカン……！　挿れただけで、軽イキしてもうとる……！　\nうちの子宮、悦んで震えてはるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304117" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「せ、せやけど……うちは今、本気モードなんや……！　このくらいであっさ\nりと負けるような、ちょろおまんこやないよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304118" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ふふっ……うちの本気の動きと芳香……射精し尽くすまで楽しんでおくれや\nす♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あんっ！　んっ、あんっ！　あっあっ、あっ！　隊長さぁんの長くて太いお\nちんぽが、おまんこを出入りしてはる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304120" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev198_03b_0000", "ev198_03b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「んぁっ、あっ、あんんっ！　あんさんの極太おちんぽ、ホンマ最高やなぁ！\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「うちのおまんこにフィットしとる！　おまんこのヒダが勝手に動いて、亀頭\nを舐めしゃぶっとるんがよう分かるわぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あっ！　あっ、んっ、あっ！　んぁっ！　どないですか、隊長さぁん……ヒ\nダヒダで亀頭をなぶれるの、たまらんやろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「早々にイカんよう、せいぜいおきばりやす♪　あんっ！　あんっ、あっ！　\nあんっ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ひゃうっ！　あっ、あんっ、あっあっあっ！？　うちの動きに合わせて、隊\n長さぁんの腰が動いてはるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304125" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「うちの大事なところをトントンって叩いて……あっ、あっ！？　これ、気持\nちよすぎるわぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「奥のところをズポズポされるたびに、身体の力が抜けてまう……おまんこが\nあんさんのおちんぽの虜になってまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「うち、本気モードやのに……あんさんなんて、あっさり倒せるはずやのにぃ\n……ひゃうっ！　うっ、あっ！　はぐぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「奥のところをグリグリするのはもっとアカンよ！　そこ、うちの弱点やから\n……んぅっ！　あっ、んぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「赤ちゃんの部屋の入り口は感じやすうて……ひぐぅぅっ！？　あっ、あぁぁ\nっ！　おちんぽが深くまで刺さっとるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「うちの子宮、完全に降りてきてもうてはる！　あんさんのおちんぽをもっと\n咥えたいって、おまんこがいうてはるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あひっ！？　あっ、おっ、おぉっ！？　おまんこの奥から、めっちゃすごい\nのきてはる！　気持ちいいの、すぐそこまできてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ！？　た、隊長さぁんのおちんぽも膣内でデカなってて……！　\nイ、イキそうなんが伝わってくるわぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304133" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「んっ、んっ！　あっ、あっ！　あんんっ！　イクッ！　イクッ！　おちんぽ\nズポズポしながら、おまんこイッてまうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あんさんと同じタイミングでイケるやなんて……こんなの、恋人とセックス\nしているみたいどす……んんっ！　んぅ～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ！？　ぐぐっ、んぐぅっ！？　どぴゅどぴゅいうとる……！　奥\nのところで、熱々のザーメンめっちゃ出とりはるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304136" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_09" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「膣内出しされるん、ホンマ気持ちええどすなぁ……はぁぁぁっ……これが女\nの幸せやと勘違いしてまうわ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304137" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あっ！？　ひっ、んひっ！？　な、なんや！？　まだザーメン出るんどすか\n！？　あんさん、どれだけ出すんや……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304138" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「くぅぅっ……こない出されたら、うちもまたイッてまう……！　膣内出しの\n快感で、アクメしてまうぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「おぉぉっ！？　おっ、ほぉぉぉっ！？　おっ、おぉっ！　あっ、あっ！？　\nおっ、おほぉ～～～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304140" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……こ、こない膣内に出して……隊長さぁん。うちのこと孕ま\nせる気なん？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304201" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ふふっ……孕んだら、ちゃ～んと責任取ってもらわなあきまへんなぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304202" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「お互いの生活費はもちろん、子供の養育費も稼いでもらわんと……いやぁ～\n、えらい大変なことになりはりますなぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「えっ？　本気で妊娠させてやるから、後悔するなって……な、なにを言うて\nますのん？　まさかあんさん、本気でうちのこと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ち、ちょっと待っておくれやす！　今のはちょ～っと言い過ぎてもうたわ！\n　まずは気とおちんぽを落ち着かせて……はひぃぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304205" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あんっ！　あっあ、あっ！？　また奥に刺さっとる！　あんさんのぶっとい\nおちんぽ、子宮口をトントンしてぇ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304206" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev198_03b_0000", "ev198_03b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「おまんこに残っとる精液が子宮に流れ込んできはる！　あっ！　あっ！　こ\nれ、アカン！　ホンマに妊娠してまう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ひゃうぅっ！？　あっ、あんっ！　う、うちの身体、あんさんの突き上げに\n合わせて勝手に動いて……ふぁぁんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あぐっ、うぐぐっ！　うっ、あっ！　あっ！？　ま、まさかうち、また知ら\nん間にエッチな芳香をバラまいとるんか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「いや、そうやないとこの状況に説明がつかへん……！　普段は大人しい隊長\nさぁんが、こない乱れて乱暴になるやなんて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「それに、うちもこない発情して……あ、あんさんの子供を孕みたいと思うや\nなんて……！　あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「奥のところを突かれるたびに、子宮が反応してはる！　妊娠したい、赤ちゃ\nん孕みたいって、ズキズキ疼いてきはるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「やっ、ひゃ！？　あっ、あぅぅっ！　妊娠なんて絶対にアカンのに……う、\nうち、隊長さぁんの子供が欲しゅうなって……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ひぎっ！？　あっ、ぐっ！　おっ、おぉっ！？　隊長さんの動きがもっと激\nしくぅ！？　うち、その動きについていけへんからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304214" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あんっ！　あんっ！　あっ、あんっ！　ズポズポされると、頭真っ白になっ\nてまう！　もう気持ちええことしか考えられへん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「このまままたイキたくなって……ひゃぅぅっ！　あっ！？　あっ！　またア\nクメがちこうなってきてはるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「た、隊長さぁん！　後生やから、イク時はおちんぽ抜いておくれやす！　や\nないと、うち、ホンマに妊娠して……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あっ！？　あっ！？　ひぁぁぁっ！？　た、隊長さぁんのおちんぽ、めっち\nゃ膨らんではる！　おまんこ拡げてはるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ま、またイクんやね！？　なら、今度は膣内やのうて膣外に……！　う、う\nちの身体にぶっかけてええからぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「んっ、あっ！　んぁ、あっあっあっ！　うぐっ！　ふぐぅ～！　イクッ！　\nイクイクッ！　またアクメしてまぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304220" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ほぉぉぉぉっ！？　おっ、おぉぉぉっ！？　な、膣内に出とる……！　うち\n、膣外に出してって言うたのに……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「奥の奥までザーメン注がれとる……！　子宮にあんさんの精液、びゅーびゅ\nー出てはる……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「これ、気持ちよすぎるわぁ……！　ア、アカン……排卵してしまいそうにな\nるわぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304303" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「うぅぅっ……！　あっ、んぅぅっ！　おまんこの疼きが止まらへん……！　\n何回でもイッてまう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304304" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あっ！　おっ、おぉっ！　イクッ！　膣内出し受精させられながら、またア\nクメするぅ～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304305" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……あっ……はぁぁぁ……あ、あんさん……これはもう、慰謝\n料どころの話やないよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304306" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「うちにこない膣内出しして……これはもう、結婚してもらうしかあらへんね\nぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304307" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「えっ？　これは本位じゃない？　全部うちの芳香のせい？　気づいたら、本\n能的に膣内出ししてたやなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304308" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「確かにこないな状況になっとるんはうちのせいやけど……せやけど、膣内に\n出したんはあんさんの意思やろ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「じゃあこのまま付き合うかって……まあ、うちも隊長さぁんのこと嫌いやな\nいし、まずはお友達からってことにしましょか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304310" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_14" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ひゃぐっ！？　あっ、うぅっ！　あっ、んぁぁぁっ！　熱いザーメンがめっ\nちゃ出とるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「うちの身体だけやのうて、顔にもかかって……あんんっ！　すごい勢いどす\nなぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304402" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「はぁぁ……この強烈な香り……うちの芳香にも負けず劣らずで、頭がクラク\nラしてまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ずっと嗅いでいたくなるような、クセのある香りで……あんんっ！　この匂\nいを嗅いでるだけで、またイッて……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ひゃ、うっ！　あぅっ！　イクッ……イクッ……！　イッてるのに、おまん\nこイッてまうぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304405" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あっ！　あんんっ！　んっ、あっ！　ふぁ、あっ！　おぉぉっ！　おほぉ～\n～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「ふぅー……ふぅー……う、うちの芳香が精液の匂いでかき消されていっとる\n……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304407" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「って、なんや……おまんこの疼きが収まったら、めっちゃ恥ずかしくなって\nきたんやけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304408" ]},
		{"command":[ "SETIMAGE", "0", "still_00019803_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「う、うち……自分の香りにあらがえずに、あんなに発情してもうたんか……\n！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「あわわっ……思い返したら、めっちゃ恥ずかしゅうなってきた！　た、隊長\nさぁん！　うちのこと、そないに見んといてぇぇぇっ！」", "NORMAL" ]},

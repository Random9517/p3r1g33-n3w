		{"command":[ "SETNAME", "ラストノート" ]},
		{"command":[ "SETTEXT", "「うちの香りにこないあっさりと誘われるやなんて、あんさんもマヌケやなぁ\n～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_198_0304101" ]},
		{"command":[ "SETCHARA", "0", "char_00019803_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},

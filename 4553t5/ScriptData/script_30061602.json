{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリン、こっちよこっち。ふふっ、ちゃんと来てくれたのね。嬉しいわ～\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604101" ]},
		{"command":[ "SETCHARA", "0", "char_00000616_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「今日一日ずっと、この格好で過ごして、色んな人に見られて……んんっ、ふ\nっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604102" ]},
		{"command":[ "SETCHARA", "0", "char_00000616_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃん、ちょっと興奮してきちゃったみたい～。ね、ダーリン、あ\nたしのこの気持ち、受け止めてくれる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604103" ]},
		{"command":[ "SETCHARA", "0", "char_00000616_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「オッケーって、本当に？　うふふふふふ！！　じゃあ、そこのベッドに横に\nなって。そう、それでいいわ～。じゃあ……おちんちん、見せてね～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604104" ]},
		{"command":[ "SETCHARA", "0", "char_00000616_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あはっ、ダーリンのおちんちんもギンギンになってるじゃない～！！　もし\nかして、期待してた～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「え、当たり前って……んふふ、素直でいいわね～。そんなダーリンには、ご\nほうびをあげちゃうんだから～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふっ、あたしの重さ、しっかり感じて受け止めてね～？　女の全てを受け\n止めるのは、男の度量よ～。あん、動いちゃダメだってば」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「動くのはダイヤナちゃんだけ。ね、ダーリンはじっとしてて。あたしに身を\n任せなさい。そうしたら、気持ちよくしてあげるから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほらほら～、ダーリン、見えるでしょう～？　あたしのオマンコ……もう濡\nれてるわ～。ダーリンのおちんちんと一緒で、準備ができてるのよ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それにしても、ダーリンのおちんちん大きいわね……今から、これがお腹の\nここまで届くのね……ふふっ、ぞくぞくしてきたわ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それじゃあ、早速……んふあああああああああっ！！　入って、きたっ！！\n　んんっ、ふうっ、ふっ……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あはあっ！！　これ、思ったよりも……んっ、大きくて、奥に……あんっ、\nあっ、気持ちいい……こんな、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「入れてるだけで気持ちいいなんて、素敵よダーリン……でもね、今日はダイ\nヤナちゃんが上なんだから、もっともっと気持ちよくしてもらうわね！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あんっ、あくうっ！！　ふふっ、腰を動かしたら奥がごつん\nごつんって、いいっ、いいわ～！！　ダーリンのおちんちん、いいっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほら、見て……ダーリンのおちんちん、お腹のここまで届いてるの、見える\nでしょう？　ダーリンが、あたしのここまで入ってるの、見えるでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「そのまま、腰を動かすと……んっ、ふうっ、ほら、お腹の膨らみで出入りが\n分かるでしょう？　んっ、あっ、やんっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふふっ、見えることで興奮したの？　いいわね、そういうの好きよ。でも\nね、今日はあたしが主導なんだから、ダーリンは動いちゃダメ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「だからじっとしててね？　その分、ダイヤナちゃんが気持ちよくしてあげる\n。んっ、ふうっ、んんっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのおっきなおちんちんがあたしの中、ごりごりって、ずりゅずりゅ\nってして、ふああっ、あんっ、んっ、気持ちいいっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んんっ、あんっ、あっ、あふうっ！！　あっ……？　んふふふっ、ダーリー\nン？　どこ見てるのかしら～？　ねえ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「今、あたしのおっぱい見てたでしょう？　ねえ？　腰を動かすたびに、ぶる\nんぶるんって揺れてるの、見てたでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「男って本当におっぱい好きねえ。ダーリンは特にあからさまに見てるの、分\nかるんだからね～。まあ、あたしはダーリンだったら構わないけど？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でも、今はこっちに集中してね～！！　ほら、オマンコがきゅっきゅって締\nめつけながら動いているの、分かるでしょう～？　んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんが動いてあげているんだから、ふふっ、こっちに集中して、\nね？　ダーリン。んっ、ふっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほら、ほら、この動き、どうかしら～？　おちんちんに密着しながらくいく\nいって動かしたら、ダイヤナちゃんの中が吸いつくでしょう～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふぅ、あたし自身も、ダーリンのおちんちんでごりごりされて、んっ、気\n持ちいいっ、ふうっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、お腹の中、膨らんで、おちんちんでいっぱいになって……ん\nっ、ふうっ、ほら、こうやって動けばもっと、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ、んっ、どう、ダーリン？　ダイヤナちゃんのサキュバスオマ\nンコ、気持ちいい？　んんっ、ふっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「気持ちよすぎる？　うふふ、当然よね～！！　あたしのオマンコが気持ちよ\nくないはずなんてないもの、あんっ、ああっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「腰を上下に動かして、んっ、ぐりぐりして、ああっ、あんっ、んっ、おちん\nちんがじゅぷじゅぷしてる、んんっ、もっと、ね、ダーリン、もっと！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「もっとあたしの中、ごりごりっておちんちんで気持ちよくしてっ！！　んん\nっ、ふうっ、あんっそう、もっと、奥も、中も、全部っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふああっ、あっ、あんっ、んふうっ！！　そう、そうやってあたしの動きに\n合わせて、あんっ、あっ、あっあっあっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ああっ、いいっ！！　いいわっ！！　ダーリンのおちんちん、最高っ！！　\nふううっ、あっ、これ、全部ダイヤナちゃんのもの！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんだけのおちんちん！！　あんっ、あっ、あくうっ！！　これ\n、誰にも渡さないんだからっ、あんっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっ、おちんちん膨らんできたっ！！　ふうううっ、出したいのね、いいわ\n、ダイヤナちゃんの中に、たっぷりと出してっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、ほら、おちんちんが奥にごりゅって、固定されてるから、ん\nふうっ、ダーリン、出していいわよっ！！　あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604136" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、ああああああっ、ダーリンの、精液きたああああっ！！　ん\nっ、ふううっ、あんっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あたしの中に、どくどくって、ダーリンのがいっぱい注がれてる……んふう\nっ、んっ、ああっ、んくうっ……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「凄い、これ、お腹の中、溺れちゃうぐらい出されてるのが分かる……んっ、\nはあっ、あんっ、んっ、満たされる……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリン、素敵よ……んんっ。ふうっ、あっ、ダイヤナちゃんの中、ダーリ\nンのでいっぱいになったわ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふっ……ダーリンのおちんちん、まだ硬いままね～。もう一回したい？　\nダイヤナちゃんともう一回したい～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっはははは、そんな必死に頷かなくても、いいわよ～。あたしも一回じゃ\n物足りなかったし～？　ダーリンともう一回……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふうっ、あんっ、あっ、あんっ、んっ、あっあっあっ！！　ふふ、こうし\nて中できゅっきゅってしてあげたら、んんうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あくうっ、んっ、またおちんちん復活して、お腹の中ごりごりって……あっ\n、んんっ、んっ、これ、いいっ、いいわっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのおちんちん、あたしの中と相性ぴったりで、いいっ！！　んんっ\n、はっ、あっ、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「硬くて大きい先端があたしの中をごりゅごりゅって……んんっ、お腹の奥が\nじんじんして……はっ、あっ、んっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、腰、勝手に動いちゃう……んっ、あたしが主導なのに、んっ\n、ダーリンが、ダーリンのおちんちんがダメなのよっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「サキュバスダイヤナちゃんのオマンコに反抗して、こんながちがちにして、\nいけないおちんちんは、こうして……んっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んくうっ、オマンコの中で暴れて、んっ、あっ、もう、本当にいけないおち\nんちんね……おとなしくしなさい、んっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほら、今回はあたしのおっぱい見ていいから、腰の動きに集中して、んっ、\nあんっ、ああっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ、おっぱいみてまたおちんちん大きくして、んっ、本当はなん\nでもいいんじゃないの、ダーリンは、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「え、ダイヤナちゃんのだからこうなるって……もう、そんなこと言われたら\n……ますますやる気になっちゃうじゃないっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほらダーリン、この動きはどう？　ふふっ、オマンコ締めつけながら早く動\nいたらおちんちんがきゅっきゅってなるでしょう？　あんっ、やんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んんんっ、えっちな事だとすぐにおちんちんで反応するんだから、あんっ、\nんっ、でもあたしも負けてないんだから、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こうして、腰を押しつけながらぐりぐりってしたら、あはぁっ、んっ、あく\nうっ、おちんちんが中をかき混ぜて、あんっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「気持ちいいっ、ダーリンのおちんちん気持ちいいっ！！　あんっ、あっ、あ\nうっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、ダーリンのおちんちん膨らんできた、出すのね、また出すのね\n！！　いいわ、ダイヤナちゃんの中に、いっぱい出してっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンの気持ちいいの、あたしの中にいっぱい出して、二人の気持ちいい\nのを合わせましょう、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふうううっ、あっ、ああっ、イく、イく、ダーリンのおちんちんで、あたし\nも、もうイっくっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ああああっ、イって、ダーリンもイって！！　一緒に、あっ、んっ、イっく\nうううううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604220" ]},
		{"command":[ "WAITINPUT" ]},
																					
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふうううううっ！！　二回目の、中出し来てるうううううっ！！　んんん\nっ、あっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ああっ、ふっ、うっ！！　熱い……中が、どろどろになってる……あたしの\nオマンコ、ダーリンの精液で蕩かされてる……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんが主導で搾り取るつもりだったのに……おちんちんで身体の\n中、かき混ぜられて……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「搾り取るっていうより、満たされちゃった……んっ、ダーリンのおちんちん\nが凄すぎて……あんっ、まだ出てる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「一回、根元から先端までオマンコで締めつけたら……あんっ、残ってるのも\n全部あたしの中に出た……んんっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ……もう、あたしが主導とかどうでもよくなっちゃったわ……ふふ、\nダーリンとこうしているだけで幸せって感じちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ね、ね、ダーリン、これでもし子供ができたらどうする～？　あたしはねえ\n、最低でも二人は欲しいわね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんに似た可愛い女の子と、ダーリンに似た格好いい男の子と四\n人で過ごせたらとっても素敵よね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ってサキュバスなのに家庭の話しちゃったわ～。あんまり合ってないお話だ\nったわね～。ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でもね、言ったことは本当よ～。いつかきっと、そういう家庭になりましょ\nうね、ダーリン？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ、おちんちんが抜けて……ふあああっ、あっ、身体に、んんっ、ふう\nっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あたしの身体とおっぱいに、ダーリンの精液が……んんっ、凄い、熱くて、\n量も……んっ、あっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「まだ出てる……んっ、そんなに気持ちよかったのね……ふうっ、ふっ……ん\nっ、中に出してほしかったけど、これはこれで……ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんのサキュバスらしさがでたかしら～？　ダーリン、とっても\n気持ちよさそうな顔してるもの～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「さっきも思ったけど、凄い量よね～。中に出されたら、確実に子供ができち\nゃうわね、これ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふふ、そのお楽しみはまた今度にすることにして、こういうのも悪くないわ\nね～。あたしがダーリンを気持ちよくさせたしるしだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「男が精液をかけるのって、自己満足なのかと思ったけど、本当に愛する人の\nなら女も幸せになるのね……ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほら、見て。ダーリンの精液があたしの身体をこんなに染めあげたのよ～。\nぬるぬるで、どろどろになったあたしの身体、見て」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あははっ、ダーリンの顔、すっごい真剣。いいわよ～、いくらでも見ていい\nわよ～。ふふ、あなたのものになったダイヤナちゃんの身体をね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でもね、このしるしって時間が経てば消えちゃうわ。だからね、そうなった\nらまたいっぱいいっぱいダーリンでダイヤナちゃんを染めあげて、ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1604410" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_02_12" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETCHARA", "0", "char_00001412_01", "8", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「あ……よかったです……ふふっ、少し大胆かも知れませんけど、貴方に見て\n　欲しくて、頑張っちゃいました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204104" ]},

		{"command":[ "SETIMAGE", "0", "still_00001412_02_07" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……射精終わりましたか？　はい……お疲れ様でした……ふふっ、\n　気持ちよさそうな顔……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204139" ]},

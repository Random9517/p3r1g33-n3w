		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「そうでないと……んっ、す、すぐにまた……イッてしまいそうで……あっ、\n　ふっ……オチンポ……逞しすぎて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「オマンコ……我慢できなくなっちゃいますから……んひぁっ！？　な、何回\n　でもイケばいいっ……？　そっ、それはっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ひぅんっ！　あっ、あぁっ……でもっ、こんなに強いのはっ、はぁっ、\n　ズボズボされたらぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ひっ、イグっ……あひぁっ、オマンコ続けてイキますっ、あぁっ、オチンポ\n　激しすぎてっ、イグっ！　あひぉっ、イグぅぅぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ……んっ、あぁぁ……イ、イッた……イキましたぁ……！　\n　あっ、な、なのにっ、ま、まだ……オチンポとまりゃにゃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ひっ、はひぃんっ！　らめっ、今……ジンジンするのっ、らめれすっ！\n　オマンコ……イキッぱなしなのに……おっぱいもなんてっ！」", "NORMAL" ]},

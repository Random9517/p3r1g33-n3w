		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「あぁぉっ！　そこっ、きゃふっ！　子宮の入り口に……ぐりってされたらぁ\n　っ、あひっ、こ、声が出ちゃいますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んぁぁっ、あぁっ、もっと掻き回してっ、はひぃっ、あっ、いいっ、いいで\n　すぅっ！　んぁっ、あぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁっ、カリが当たってますっ……オマンコ……引きずられてっ、\n　くひぃんっ、抉られるのっ……堪らないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、おっぱいも……んっ、はい……お好きになさって下さい……\n　このおっぱいも、もちろん貴方のモノですからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「あぁっ、乳首……ぎゅって引っ張られてぇ……あんっ、先っぽ、コリコリ\n　転がされたらぁっ……か、感じ過ぎちゃいますからぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ふっ、はっ、んくっ……あぁ……聞こえますか？　グチョグチョ……はした\n　ない音がオマンコからぁ……なんていやらしい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はい……私から鳴ってるドスケベな……オマンコの音ぉ……貴方のオチンポ\n　でアヒアヒさせられてますぅっ……んぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「くぅぅぅんっ……！　一番気持ちいいところに届いてる……あぁぁ……私の\n　弱い場所……的確に突き回されてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁっ……んぁぁっ！　熱くなってます……からだぁ……あぁっ、\n　オマンコ熱いの……はひいっ、あひっ！」", "NORMAL" ]},

		{"command":[ "PLAYVOICE", "v2_014_1204217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁっ……またイキますっ！　貴方にメロメロにされたチョロ過ぎ\n　オマンコっ！　オチンポに完全屈服しちゃいますぅっ！」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「そこぉっ、あぁっ、もっと……オチンポ突いて下さいっ！　あひぉっ！\n　オチンポそこぉっ！　あぉっ、おぉっ！」", "NORMAL" ]},

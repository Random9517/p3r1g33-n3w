		{"command":[ "SETCHARA", "0", "char_00001401_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「よろしいですか？　ちょっと恥ずかしいんですけど……失礼しますね。\n　んっ……しょっと……んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204102" ]},

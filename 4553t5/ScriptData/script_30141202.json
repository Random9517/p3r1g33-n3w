		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETCHARA", "0", "char_00001412_01", "6", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「どうされました？　ドキドキしちゃってますか？　このビキニから目が離せ\n　なくなっていますよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETCHARA", "0", "char_00001412_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「そうですよ……この魅力的な身体の前に、逆らうことなんか出来ないんです\n　から……貴方の欲望……曝け出しちゃいましょう？」", "NORMAL" ]},

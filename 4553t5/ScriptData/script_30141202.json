		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「私のオマンコ……堪能して頂けましたか？　はい……何よりです。貴方に\n　尽くすことが出来て……私もとっても嬉しいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「それにしても……予想以上の効果だったわ。魔性のビキニと言われるだけの\n　効果がある……こんなに夢中になってくれるなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETIMAGE", "0", "still_00001412_02_08" ]},
		{"command":[ "SETTEXT", "「えっ？　まだ、全然足りない……？　はい、それはもう……続きを……\n　きゃっ！？　んぁっ、あぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204202" ]},
		{"command":[ "WAITINPUT" ]},



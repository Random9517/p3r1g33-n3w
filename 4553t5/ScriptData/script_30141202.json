		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「いっぱい、いっぱい感じてますっ！　貴方のオチンポに分からされてっ、\n　腰がガクガクしてっ、身体……ビクビク跳ねてますからぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},

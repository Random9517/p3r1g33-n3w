		{"command":[ "SETCHARA", "0", "char_00001412_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「……いかがですか？　はい……ビキニです。それも金色の……どうでしょうか\n　……に、似合ってますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204103" ]},

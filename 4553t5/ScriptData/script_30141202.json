		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ふふっ……んっ、私も……一方的にされるばかりじゃありませんよ……？\n　ちゃんと反撃もしちゃいますから……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「ほら……ほらっ……んっ、お肉がキュンって絡みつく感じ……分かりますよ\n　ね？　他では味わえない……オマンコの締め付け……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「もっともっと、たーっぷり堪能して下さい……んっ、ふぅぅんっ……あはっ、\n　色っぽい吐息……漏れちゃってますね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んっ、首筋に……鼻息が掛かって……ゾクゾクしちゃいます……んっ、\n　んふぅっ……オチンポもだんだん余裕がなくなって来てませんか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「もし出したくなったら……いつでも我慢しないでいっぱいピュッピュして\n　いいですからね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「あんっ！　あふっ……あぁっ、またオチンポのピストン……速くなって……\n　本気でサカって来てますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、あぁっ……いいっ、オマンコいいですっ！　このままされ\n　たら、私も……もうすぐイッちゃいますからっ、んぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「はひっ、出してっ……出して下さいっ……中っ……子宮に直接流し込んで\n　欲しいですっ……貴方の濃いザーメンっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「どっぷり……濃いのっ、種付けしてっ……あぁっ、ビキニの私を孕ませてっ\n　……あぁっ、気持ちいいっ……も、もうっ！」", "NORMAL" ]},

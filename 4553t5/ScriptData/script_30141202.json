		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んくぁ……あぁ……大きいです……こんな太いのが……私のオマンコ……\n　出たり入ったりしちゃってます……はひぃ……すごいのぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「こんなぶっといオチンポで……オマンコの中……グリグリされたらぁ……\n　はふぅっ、頭の中……真っ白になっちゃいますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「うんっ、んんっ、んはっ、あぁっ……ピストンがすごいっ……くふぅっ、\n　あぁっ、お汁が……どんどん溢れちゃいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_014_1204114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "十五夜まりあ" ]},
		{"command":[ "SETTEXT", "「んっ、ヌルヌルの感じ……分かりますか？　んふっ、そこぉっ、オチンポの\n　先端で……もっとしっかり味わって下さい……はぁんっ、それぇ……」", "NORMAL" ]},

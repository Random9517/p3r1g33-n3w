{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0078" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んん～っ♪　こうして２人でゆっくり海を眺めるなんて、いつぶりかしらぁ\n？　ロマンチックでドキドキしちゃう……♪　あ、そうだっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504101" ]},
		{"command":[ "SETCHARA", "0", "char_00000615_01", "5", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あたし、す～っごくいいモノを持ってきたの。じゃっじゃぁ～ん♪　ただの\nサンオイルに見える？　じ・つ・はこれ、超強力な媚薬入りローションなの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504102" ]},
		{"command":[ "SETCHARA", "0", "char_00000615_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「確かぁ、投与されたネズミちゃんが三日三晩エッチし続けちゃったとか♪　\nもちろん人が使うと効果は落ちるみたいだけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それでもすっごいんですってぇ♪　一緒に実験してみなぁい？　いーい？　\nじっとしててね？　ぬーりぬりぬり♪　ぬーりぬりぬり……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504104" ]},
		{"command":[ "SETCHARA", "0", "char_00000615_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あはぁ……♪　あたしの身体、それからダーリンのオチンチンにもいーっぱ\nいローションヌリヌリしちゃったぁ♪　はぁ、はぁ、エッチな眺めぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「……ダイヤナちゃんのオマンコには塗ってないじゃないか～って？　もちろ\nん理由はあるわよぉ。ダーリンのオチンチンに塗ったローション♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「これをね？　ダイヤナちゃんの中に入れるとぉ……。オマンコにも媚薬が注\n入されてエロエロなダイヤナちゃんになっちゃうってコトぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「興味あるでしょお？　っあぁん♪　想像するだけで濡れてきちゃうぅ♪　あ\nたしはもう準備万端……ダーリンに男を見せて欲しいなぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「……きゃぁん♪　強引に腰を掴んで……。っあっ♪　オチンチンをオマンコ\nにぴったりくっつけて……♪　あ、入れちゃうの？　入れちゃうの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「なんちゃってぇ～、まだダメぇ～♪　ふふふっ♪　ローションですべってう\nまく入らないでしょぉ……♪　あっ、すこーし焦らしてあげるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ、んん……♪　やだやだ♪　いつもそんなにガッツいてこないのにぃ\n、すっごい勢いで入れようとしてくるぅ……。これが媚薬の力なのぉ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「入れたいぃ？　あっ♪　入れたい～？　もう限界ぃ？　だったらぁ、おねだ\nりしてほしーなぁ。……やん、言うまではおあずけよぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんのセクシーでキュートな水着にオチンチン破裂しそーなくら\nい興奮してるから入れさせて～って言って？　ねえ、早くぅん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっ、ダイヤナちゃんは最高最強美女だって！　……はぁっ、はぁ、は、早\nく言ってくれないと……オマンコもヒクヒクしちゃって待てないんだけど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ねぇ……♪　ん、んん～……。お股にオチンチンこすりつけて、ニュルニュ\nルされるともどかしいのぉ……褒めてぇ？　……って、ひゃんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁあああああぁっ……♪　ズルぅいぃっ♪　いきなり入れるなんて\nッ♪　やぁあっ、ル、ルール違反なんだからぁあああんんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふ、不意打ちでオチンチンねじこまれてぇっ♪　あぁっ、激しく突き上げる\nなんて……あぁんっ♪　イ、イッちゃうぅっ♪　イッちゃうわぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あ～～～っ♪　あぁあぁっ♪　あぁんっ、あ～んっ……♪　あっ♪　あっ、\nローションが染みこむ前にもうイカされちゃったぁああ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、ダ、ダーリンったらすごすぎぃ……！　で、でも感じ過ぎ\nちゃったから少し休ませて……って、あんっ！　も、もう動くのぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「い、いいけどっ……そういうの好きだけどぉっ♪　ひぁんっ♪　積極的に腰\n使われてぇ、本気のピストンされたら、ダ、ダイヤナちゃんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ずーっとイッちゃうぅっ♪　イクぅっ♪　イキっぱなしになっちゃうぅんっ\n♪　やんっ、いやぁんっ♪　イクぅっ……んひぃっ、またイウぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっ♪　あっ、ダーリンっ……ダーリン、気持ちいいっ♪　ぶっといオチン\nチンであたしの中掻き回して！　……あぁっ、身体中揺さぶられてくぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「いいっ、いいのぉっ♪　あ～っ♪　だ、だんだんローションが……。っひぃ\nっ♪　媚薬がオマンコに広がって……あひんっ、感度上昇しちゃってるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あぁんっ♪　む、無限にイケちゃいそぉっ……！　いいわ、こうなったらイ\nケるところまで２人で……。って、ど、どうしてゆっくり動くのぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「も、もうそんな駆け引きいらないわ、全力で来てぇ！　じゃないと、あたし\n、あたし……！　……あっ？　も、もしかしてさっきの仕返しぃ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「おねだりしないとイカせてあげないって……。んもぉっ、イジワルぅっ！　\nあ……あ、ぁ、オマンコ疼いておかしくなっちゃうっ、も、もうだめっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ちょ、調子に乗ったダイヤナちゃんが悪かったからっ！　イカせてぇっ！　\nダーリンの逞しくっておっきなオチンチンでイカせてぇっ、お願いよぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「反省してるわぁっ、だから……だからぁ！　ダーリンのオチンチンでオマン\nコ突いて、突きまくって……！　っあっ♪　あっぁっあっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あぁんっ！？　すごいっ、すごいすごぉいぃっ♪　やぁんっ、イッちゃうぅ\nうっ！　あっ、イクわぁっ♪　んんっ♪　オマンコキツくなっちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はぁんっ、んんんんん～っ♪　は、激しいぃっ……♪　あんっ、がっくんが\nっくん揺らされて……あっ、オマンコぐちゅぐちゅ貫かれてぇっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「気持ちいいっ……気持ちいいのぉっ♪　……あっ♪　締めつけすぎ……って\n、そ、そんなの自分じゃコントロールできないぃ♪　あっ、だめぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「オチンチン好きすぎて、ぎゅーって締めつけちゃうぅっ♪　あんっ♪　イキ\nすぎてごめんねぇっ……♪　だってすごすぎるんだもぉんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あ～っ♪　あぁっ、あぁああんっ♪　んん～っ♪　どんどんおバカになっち\nゃうぅっ♪　オマンコおバカになっちゃうのぉおっ……♪　きゃぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのオチンチンも太くなりすぎぃっ♪　あっ、媚薬にたっぷり漬けら\nれた、極太アツアツのオチンチン……あっあっ、精子の量もすごそうよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ねぇえっ♪　一気にビューッてしてぇ♪　出して、中出ししてぇ♪　あっあ\nっ、ダイアナちゃんのエッチなヌルヌルオマンコに早くちょうだぁいい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「きゃぁあああっ♪　あっ♪　出てるぅううっ……出てるっ♪　……えっ！？\n　ほ、ホントにすごい量……オマンコすぐにいっぱいになっちゃうぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「……ふぁっ！？　しゃ、射精しながらさらにオチンチンを奥にぃっ……お、\n押しこんでるのっ！？　あんっ、だめ、赤ちゃんのお部屋が開いちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンの精子欲しくてうねっちゃうぅっ♪　はぁんっ、あぁんっ、ンンン\nン～っ……♪　子宮の中に直接精液流しこまれてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ずっしり重たくなってるぅ♪　たっぷたぷよぉん……♪　はぁ、はぁ、すぐ\nにも受精が始まっちゃいそぉ……♪　素敵ぃい……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのオチンチンってばあたしのオマンコ好きすぎ……って、やぁだぁ\nあっ♪　まだ出て……！　あっ♪　しつこい射精好きぃいいいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あぁ……んぁあああ……♪　お、思ってたよりずーっとキケンなおクスリだ\nったみたい、このローション……♪　はぁ、はぁ、はぁ、蕩けちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「これだけたくさんイッたのにぃ、まだ全然足りないのぉ……。でも、ダーリ\nンも同じよね？　オチンチン、ぜーんぜん萎えてない。それどころかぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「……むしろさらにすっごくなってる♪　これ、もう一度食べちゃってい～い\n？　ごちそうになっちゃってい～い？　２人でもっと乱れましょぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「っんんんっ♪　お返事はしなくて、いいわっ♪　あっ♪　先にあたしが腰を\n動かしちゃうからぁ……♪　あんっ、あン、あん、あぁん、硬いぃい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「このローション……あっ♪　触れたところからカァーって熱く火照ってくる\nの、少しむずがゆくて……あんっ、粘膜同士でこすり合いたくなっちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「……んんんっ♪　ひゃぁんっ♪　ダーリンも、もう我慢できないってカンジ\nねぇっ♪　来てっ、来てぇ♪　めちゃくちゃにオチンチン動かしてっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ローションのヌルヌルと、オチンチンのカチカチで信じられないくらい気持\nちいいっ♪　んぁああっ♪　ヌルヌル止められないぃい……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「もう、頭の中がトロットロぉお……♪　……えっ？　これだけグチョグチョ\n音をたててたら、誰かに見つかっちゃう？　知らなぁいい……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「いいのっ、もう誰に見られちゃってもイイのっ♪　はぁあんっ♪　ヌルヌル\nオチンチンをぉ♪　ネトネトオマンコで摩擦することしか考えられないぃ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ、あぁんっ、あぁああんっ♪　もっと静かにぃ、とか言われたってぇ\nっ♪　もう止められないの、やめたくないの、ずーっとしたいのぉおっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっ！　あっ♪　バレたくないならオチンチン、いっぱい動かしてダイヤナ\nちゃんをぉっ♪　ギャフンって言うまでイカせるしかないのぉっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あっ♪　あっ♪　それか……またビューッ、ビューッてザーメンほとばしら\nせてぇっ、あたしのオマンコをたっぷたぷに満たしちゃうとかぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504212" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「……ねっ♪　ねぇっ♪　とにかくっ♪　たっくさんグチュグチュしないと終\nわらないからっ♪　あぁんっ、協力して一緒にピストンしてっ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あああああっ♪　そこっ、そこよぉっ♪　オマンコの一番奥ぅううっ♪　そ\nこをぐりぐりされるのちゅきぃいいっ♪　あひっ、ひぃっ、ひぃいんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こっちからもお返しよぉっ……♪　絞り上げちゃうぅうっ♪　あっ♪　狭く\nなったオマンコを、無理やりほじくられるの気持ちいいぃっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504215" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「は、ぁあっ♪　んぁああっ、あぁんっ♪　あんっあん、あぁんんっ♪　パン\nパンぐちゅぐちゅ音がして、るぅ♪　あっ、オマンコ燃えちゃうぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あ～～～っ♪　もうどこもかしこもニュルニュルでぇっ、エッチのことしか\n考えられなくなっちゃうっ♪　あっあっ、媚薬エッチハマっちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「……んぅうっ！？　あッ♪　ダーリンのエッチぃっ……！　まぁたオチンチ\nン膨らませてっ、ぴゅっぴゅしたくなってきちゃったのぉっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「え～？　どうしよっかなぁ～？　なぁんてイジワルしたら……あっ、またや\nり返されちゃうからいいわよんっ、あんっ、許しちゃうぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「出してぇっ……！　あなたの本気を見せてぇっ！　あっ……イッちゃうっ、\nダイヤナちゃんがイク時に出してぇっ！　ほらっ、今ぁっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504220" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あうぅうううんっ♪　ザーメンんっ♪　ザーメン発射されてるぅっ♪　ダイ\nヤナちゃんの大事なオマンコに全部注がれちゃってるぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「やぁっ、絶対抜いちゃだめぇっ♪　オチンチン奥に押しこんだままぁっ♪　\n出して出して出してぇっ……全部飲み干してあげるからぁっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あ、ああああああ……あぁああああ……っ♪　オチンチンのビクビクぅっ、\nいつもより多く脈打ってるぅっ♪　すっごく伝わってくるのおっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ドクッ♪　ドクッ、どぴゅっ、どびゅっ……♪　ふぁあああっ♪　敏感にな\nったヒダヒダでぇ……丁寧に最後の一滴まで吸い上げちゃうぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あぁんっ、そうよ逃がしてあげなぁい♪　……あッ♪　熱いっ……はぁんん\nっ♪　びゅっびゅっびゅぅっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんの身体の中ぁああ……ダーリンのザーメンまみれにされちゃ\nったぁあ……♪　真っ白でネバネバでドロッドロぉお……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でもぉ、思いっきり夏……楽しめたかも♪　あはっ、もっと普通の楽しみ方\nはなかったのか……ですって？　１人で泳いだってつまんないし」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「みんなでスイカ割り～って気分でもないんだもん。やっぱり海には特別なイ\nベントがなくちゃ冴えないじゃない。だから～、ダーリンは絶対必要！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんと、夏も、秋も、冬も、春も、ずーっと一緒にいてくれなき\nゃイヤよ？　ダメって言ってもつきまとっちゃうんだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「これからも、熱い思い出をいっぱい作りましょ。まだまだ着てない服だって\nたくさんあるし。何度も楽しめてお得だわぁ、次は何にしよーかなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「えっ、ええっ！？　あっ……！　お外に出しちゃうのねぇっ……！？　あっ\n♪　でもでもっ♪　これはこれですっごく熱くて気持ちいいっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はぁんんっ♪　真っ白なザーメンがダイヤナちゃんの新しい水着にかかって\n……、あっ♪　お日様に焼けた肌にもどんどん着地してくるぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んんんんっ……♪　精液がかかったところだけ、まだらに日焼けしちゃいそ\nうよぉ……♪　あぁんっ、それって斬新でイイかもぉおっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのザーメンだったらいくらでも浴びてあげるぅっ♪　かけてぇっ、\nもっともっとっ……！　あぁあっ、身体中真っ白にしちゃってぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「っあぁああああん……っ♪　すっごいニオイぃっ……！　ダーリンのオスの\nニオイに包まれて……ああっ、あぁ、ヌルヌルでイッちゃうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁんんっ♪　ビュービューしてる時のダーリンとってもエッチ…\n…♪　オチンチンもビクビクしちゃってカワイイぃっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ん～……♪　ダーリンのおかげで、今年の夏も最高の思い出が作れちゃった\nかも～♪　あ・り・が・と♪　ちゅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「やっぱりビューティーなダイヤナちゃんには、真夏のロマンスがなくっちゃ\nねぇ。バカンスを楽しみつくすには、ダーリンにもいてほしかったし♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「……そうよ？　あたしはとってもワガママで貪欲なの。だからぁ、これから\nもどんどん新しいプレイ、思いついたら持ってきちゃうんだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「怖い？　楽しみ？　ダイヤナちゃんのお気に入りになっちゃった時点で、退\n屈な人生にはもう戻れないんだから。楽しみにしててねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1504410" ]},
		{"command":[ "SETIMAGE", "0", "still_00000615_02_13" ]},
		{"command":[ "WAITINPUT" ]},

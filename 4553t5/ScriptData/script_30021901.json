{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0050" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETTEXT", "アナザー世界のファミリー時空。カツマとカグヤの家にて。", "NORMAL" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ああ、やっぱりこんな時間まで寝ていた。起きなさい！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903102" ]},
		{"command":[ "SETCHARA", "0", "char_00000219_01", "3", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「なにをぼうっとしているの。いつもいつも心配ばかりかけて……しゃきっと\nしなさい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903103" ]},
		{"command":[ "SETCHARA", "0", "char_00000219_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ここはどこだって……あなたの部屋でしょう。なにを言ってるの。今日こそ\nはバイトぐらい見つけてきなさい。いいわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「千里の道も一歩から。正社員の道もアルバイトから。こつこつやることが重\n要なんだからね。分かってる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903105" ]},
		{"command":[ "SETCHARA", "0", "char_00000219_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「なんで怒られてるかって？　あなたが無職なのに毎日毎日だらだら過ごして\nるからでしょうが！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903106" ]},
		{"command":[ "SETCHARA", "0", "char_00000219_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「？　私の格好が変？　なにを言ってるのよ……本当に大丈夫なの？　熱でも\nあるんじゃないかしら……ちょっと調べてあげ――きゃあっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903107" ]},
		{"command":[ "SETCHARA", "0", "char_00000219_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「いたたた……もう、少しは部屋を片付けて……って、ひあああっ！！　なん\nで、オチンチンが出てるのよ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「気づいたら出てたって、そんなことあるわけないでしょう！！　私、あなた\nの姉なのに……それなのに、こんなガチガチにして……ああ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ダメ……ダメよ……私が流されたら……んんっ、でも苦しそう……それに、\n弟が姉を求めたら……助けてあげなきゃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「そう、こんなにしてたら外にも行けないし……だから、そう、仕方ないのよ\n、これは。助けるため……だから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あー……んっ、むっ、んんっ、ふっ……凄い……硬い……んんっ、んっ、む\nっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「亀頭も大きくて、んむっ。カリ首も広がってて……んっ、ふっ、竿も太くて\n……ふううっ、れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「舐めてるだけで、お腹がじんじんしてくる……ちゅっ、れるっ、ふうっ、ん\nんむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「味も……匂いも凄い……れろっ、れるっ、んっ……ふうっ、じゅるるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「もう、だらしない生活をしてるのに、いつもいつもオチンチンは立派なんだ\nから……んむっ、れるっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふうううっ、んっ……頭の中、オチンチンでいっぱいになっちゃう……んく\nうっ、私もこれから仕事なのに……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あなたのオチンチンしか考えられなくなっちゃう……ちゅっ、んっ、んんっ\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はああ……オチンチン膨らんできた、んっ。気持ちいいのね……ふふっ、こ\nういうときだけ素直なんだから。れるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「全く、いつもこうならいいのに……んっ、ふっ、んんっ、んむっ……嬉しそ\nうな顔して……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふうっ……先端からお汁が出てきたわ……んっ、くっ、んうっ、んんっ……\nふっ、おいし……れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「じゅるっ、んっ、ふっ……私の唾液と混じって……んっ、ふっ……オチンチ\nン、ぬるぬるになってる……ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んむうっ、うっ……んっ、口の中、あなたのオチンチンでいっぱいになって\nる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「こんなことばかり、やる気を出して、んっ、いけない子なんだから……れろ\nっ、んむっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「じゅる、んくっ……ふうっ、んっ、びくびくしてきた……イきたくなってき\nたの？　ふふっ、まだダメよ……もうちょっと我慢して」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「れろっ、れるっ……んっ……ほら、我慢、我慢して……あなたはいい子だか\nら、できるでしょう？　ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふっ、こうして舌を巻き付かせながら動いたら……んむっ、んっ、じゅる\nるるるっ、んくうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんんっ、ふうっ、ふふっ……限界みたいね。顔もそんなに切なそうにして\n……んっ、ふっ……んくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ちゅっ、むっ……いいわよ。お姉ちゃんの口で、いっぱい出して、いいわよ\n。ほら、出して……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ、ふっ、んっ……あっ、んっ、ふううううううううっ、んぶうううう\nうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903130" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んうううっ、口の中で跳ねて……んっ、ふっ、んんっ、はっ、あっ……まだ\n……んくっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふうううっ、んっ、んぐっ、ちゅっ……んんっ、くっ……はあっ。いっぱい\n、出たね……ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「濃厚で、匂いも凄くて……んっ、あなたが元気なのだけは伝わってきたわ。\nんっ、おいし……んくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふっ、気持ちよかった？　いいのよ、姉は弟の面倒をみるものなんだから\n……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、竿に残ったのも……ちゅっ、んっ、れろっ、んく……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「オチンチンも綺麗にしないとね……じゅるっ、れるっ、んうっ……んむうっ\n、ふうっ、うっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「先端から根元まで……丁寧に綺麗にしてあげるから動かないで、あんっ、オ\nチンチン動かしちゃダメだったら、もう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「出したらまたワガママになるんだから……んっ、そう。じっとしてて、ね。\nお姉ちゃんに任せて……れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふう、おしまい。気持ちよかった？　いいのよ、姉は弟の面倒をみるものな\nんだから……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「これぐらいであなたのやる気が出るなら、いつでもしてあげるわ……私はあ\nなたの姉なんですからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ、どうしたの？　急に静かになって。え？　会社はいいのかって？　\n有給が溜まってるから、消化するわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「それよりも、私がしてあげてあなたがやる気になる方がお姉ちゃんとしては\n嬉しいもの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「なあに、その変な顔。姉時空？　また妙なアニメでも見たの？　まったく、\n就職活動もしないで……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んふっ、まだ大きいままだね……もう一回、する？　お姉ちゃんの口で、も\nう一回イきたい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「いいよ。今日は一日、弟に付き合ってあげる。なんでもワガママ言っていい\nよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「じゃあ、ひとまずまたお口で……んむっ、ちゅっ、れろっ……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふっ、また膨らんで……お姉ちゃんの口、そんなに気持ちいい？　じゅる\nっ、んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ、腰をいきなり……んっ、ふっ、んんっ、いいわよ、あなたの\n好きに動いて、んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「私はお姉ちゃんだからね、弟のことは全部受け止めてあげる……んっ、むっ\n、ふうううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「じゅるっ、んぐっ、ふっ、んっんっんっ……れるっ、ちゅっ……一回出した\nのに、凄く硬い……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「それだけお姉ちゃんの口で気持ちよくなってくれてるんだね。嬉しい……ん\nうっ、じゅぷ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ、また先端が膨らんで、ふうううっ、じゃあ、こうしてベロで\n刺激したら……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「オチンチン、びくびくってしてる。ふふ、可愛い……いいよ、もっと感じて\n、お姉ちゃんのお口で気持ちよくなって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んむっ、んっ……ほら、こうして吸いついたら……じゅるるるるるっ、んう\nっ、んぐっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「それで、こうやって奥まで飲みこんだら……んぐっ、んんっ、んんんっ、ふ\nうっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、苦しくないかって？　大丈夫、んぐっ、ふっ、私はお姉ちゃんだから\n……んっ、うっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「弟のことなら全部受けいれられるの……んんっ、ふっ、だから、あなたは気\nにせず気持ちよくなって……お姉ちゃんの口で、んっ、むっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんんっ、むっ、ふうっ、また熱くなってきた……いいわよ、イって、今度\nは我慢せず、好きな時にイって、じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「お姉ちゃんのお口に、いっぱい弟のエッチなお汁、出して……飲ませて……\nんんっ、むっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふううっ、ふっ、あっ、くる、オチンチンから精液くるっ、んっ、ふうっ、\nちゅううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903220" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んぶうううううううっ！！　んっ、ぐっ、ふうっ、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ、んぐっ、んくっ、んっ、はっ、あっ……あんっ、二回目なのに、や\nっぱり凄い……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「もう、口の中があなたのでいっぱいになって……んぐっ、喉の中まで……あ\nなたに染められてる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んくっ、んっ、んぐっ……ふうっ、ふっ……よっぽど気持ちよかったのね、\n粘っこくて、濃くて……んぐっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「私のお口でいっぱい出してくれたらエッチなお汁……んっ、おいし……れろ\nっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんんっ、ふうっ、はっ……ごちそうさまでした。ふふっ、おいしかったわ\n、あなたの精液、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「飲めば飲むほど、あなたの愛情が感じられて……あなたも、オチンチンでお\n姉ちゃんの愛情を感じたでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふふっ、なにも言わなくても、その顔で分かるわ。だって、私はあなたのお\n姉ちゃんだからね……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「まだまだ元気ね……もう一回、する？　私は何回でも構わないわよ。夜まで\nしたって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「だって、私はあなたのお姉ちゃんだもの。お姉ちゃんは、弟のいうことはな\nんでも叶えてあげるんだから。ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、あっ、オチンチン、抜けて……ふあああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「顔に……んっ、精液が顔に、ふううっ、んっ、あっ、あくっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んふうううううっ、もう、お姉ちゃんの顔をこんなにどろどろにして……悪\nい弟ね、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「怒られてるのにオチンチン震わせて精液かけたらダメでしょ……んっ、こら\n、また……んっ、ふううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「もう……満足した？　ってその顔を見たら分かるわ。お姉ちゃんにぶっかけ\nてそんな満ち足りた顔になるなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「私の弟ながら、心配になっちゃうわ。んっ、でも、気持ちよかったのならよ\nかった。ふふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「それにしても、溜まってたのね……二回目なのに、こんなに濃くて、ねばね\nばで……昔はあんなに可愛かったオチンチンなのに」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「今はもう、こんなに男らしくなって……あんっ、褒められたからって震わせ\nないの、もう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んふうっ、でも、まだしたいなら……いいわよ。今日はあなたが満足するま\nで、付き合ってあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_1903409" ]},
		{"command":[ "SETIMAGE", "0", "still_00000219_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「私も、あなたとするの、好きだし……ね、次はお口に出す？　それともまた\n顔？　好きな方でいいわよ、何回でも……ね」", "NORMAL" ]},

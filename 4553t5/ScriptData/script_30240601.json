{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「なあに、急に呼び出して。私、今日は汗をかいちゃったから……もう戻って\n着替えたいんだけど。シャワーを浴びてサッパリしたいのよ」", "NORMAL" ]},
		{"command":[ "SETCHARA", "0", "char_00002406_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603101" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「えっ？　そ、その前に体操着姿でしたことのあるエッチの話が聞きたい……\n？　な、なんで私がそんな話……。体操着なんかでしたことないわよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603102" ]},
		{"command":[ "SETCHARA", "0", "char_00002406_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「と、ごまかしたいところだけど。そうね。あなたになら、話してもいいわ。\nそのかわり、私がグラウンドで使った用具の片付けをお願いね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603103" ]},
		{"command":[ "SETCHARA", "0", "char_00002406_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「あ、あれは……確か、暑い夏の日だったわ。男の人って、なぜだか知らない\nけどこういう服が好き、というかすごく興奮するんでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603104" ]},
		{"command":[ "SETCHARA", "0", "char_00002406_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「あの時も、私はたっぷり運動した後だったから。あの人と２人きりになるの\nは嫌だったのよ。でも、強引にグラウンドの隅に連れていかれて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603105" ]},
		{"command":[ "SETCHARA", "0", "char_00002406_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「もう……。あなたって、変なところで強引よね。いやらしいことがしたいな\nら、シャワーの後でスッキリしてからすればいいじゃない！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603106" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_03" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「なにもこんなグラウンドで！　外でしなきゃいけないこと？　ひんやり涼し\nいベッドでだったら、いつもみたいにしてあげるのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……青春ドラマみたいにフェラをしてほしい？　どういうこと？　弾ける若\nさ、まぶしい汗、甘酸っぱい初恋をイメージしたフェラチオを……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603108" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「なによそれ！　あなたね、もしかして少年漫画の爽やか主人公のつもり！？\n　そういう人はね、こんなにオチンポをバッキバキになんかしないのよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603109" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「私も相当汗臭いけど、あなたのコレだって……オチンポだってムレムレでク\nサすぎよ！　私の顔のところまでムワッと臭いがあがってくるわ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603110" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……ねえ。これ、ちゃんと昨日洗ったの？　洗ったとしても、この暑さでし\nょ。すんっ……！　うぅっ、や、やっぱりクサいっ！　鼻にくるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「よくもまあ、私にこんな汚いオチンポ……略して汚チンポを舐めさせようだ\nなんて思うわね。舐めるわよ。舐めるけど……ちょっとためらうわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603112" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ん……ぴちゃっ。な、なんかしょっぱいんだけど……！　嘘でしょ、いつも\nより味が濃い……！　これは気合がいるわ、でも……ぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603113" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「しょ、しょうがないわよね。私にしか頼めないんなら……ちゅぷっ。ん？　\nもっと激しくがっつきフェラ希望？　ばかっ、まずは先っちょよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603114" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ん……ぴちゃっ、くちゅ、ちゅく……。あぁもう、すでにカウパーでオチン\nポの先端はヌルヌルってわけね。どれだけ楽しみにしてきたんだか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603115" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「くちゅ、くちゅ、ちゅくっ。こう？　舌先を尖らせて、尿道口をほりほりほ\nり……。くちゅ、くちゅ、くちゅ、それから亀頭をぴちゃぴちゃぴちゃ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603116" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「本当に、信じられないくらい臭い……けど、なんだかこの臭い、クセになる\nわね。すん……すん、カリ首や竿の方もしっかり舐めてあげる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603117" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「れろ……れろっ、くちゅっ。ちゅぷ……ぷっちゅっ、れろっ。チュッ……ん\nぁっ、なんかキスみたいな音出ちゃった。恥ずかしいわねっ……ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んん……ッ、んふっ、ちゅくっ……。あん、舐めれば舐めるほどオチンポが\n濡れて……ネトネトしてきてる。気持ちいい？　私の唾……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「っあっ……。なんかこっちまでヘンな気分になってくるわね……？　くちゅ\nっ、ぴちゃ……。オチンポっておかしな魔力があると思わない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603120" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「舐めていると身体がジンジンしてくるっていうか……。っちゅっ、チュ、く\nちゅっ……ソワソワするっていうか。体温がぐんぐん上がってきて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「落ち着いていられないのよ。ぴちゃっ……くちゅっ。ん……ねえ？　め、め\nんどくさいからもっと深く咥えてもいいわよね？　んっ、くちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「その方があなただって気持ちいいでしょ……ん、ん、これだけオチンポが濡\nれてたら、たぶん一気にしゃぶれるはずよ。……いくわね、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603123" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「じゅぷっ……んんんっ♪　口の中が熱いぃ……♪　んむっ、むぷっ、んふぅ\nっ……ぐちゅっ！　はぁ、あっ、あぁ……くっさい……♪　ぐちゅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603124" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「何か言いたそうな顔してるわね。言ってみなさいよ……って、体操着に合わ\nせて体育会系のがっつりフェラをしろ？　た、体育会系のフェラって何よ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603125" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「１、２、１、２って……んっ、も、もしかしてその声かけに合わせて頭と口\nを動かせっていうわけ！？　信じらんない……って待ってよ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んぅっ！？　んんっ、ぐちゅっ、じゅるっ！　な、なによこのバカみたいな\nフェラぁあっ……！　１、２、１、２……んじゅっ、ぐっちゅっぬちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「はぷっ！　ぐちゅっ、ぐっちゅっ、ぐちゅっ！　……はぁあっ！？　ピッ、\nピッて笛吹いてんじゃないわよ、まさかそれにも合わせろって！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603128" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ば、ばか、ばかばかばか！　……ぐちゅっ、ずっちゅっ、ぐちゅっ！　１、\n２、１、２……ぐっちゅっ！　ぬっちゅっ！　んむっ、んんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ば、か……笑っちゃうからその笛やめてよっ……！　あはっ……ぐっちゅっ\n！　じゅるっ、じゅぷぷっ！　ぬちゅっ、ヌプッ、ずっちゅっずちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んぁっ……♪　ふぁあっ！　んむぅっ、じゅるっ！　ぐっちゅっぐっちゅっ\nずちゅっ、ぢゅるるるるっ！　あはっ、いい反応……敏感ねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603131" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「そんなにオチンポビクビクさせてくれちゃうと……こっちもやりがいがある\nわ、っじゅぷっ！　ぬぷっ、ぐちゅっ、ずちゅっ……ん～じゅるるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ほ、ら……♪　そろそろ我慢できなくなってきてるでしょ♪　ぐちゅっ……\n！　オチンポぶっとくなりすぎよ、もんのっすごく反ってるし♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603133" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んぷぁっ……、んふふふっ♪　舌でつついたら破裂しちゃいそ……♪　ぐち\nゅっ♪　ねえ、イキたいでしょ？　イキたいわよね？　っじゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「もうちょっとだけ待って……。ん、じゅるっ！　ぐちゅっ、じゅるっ！　…\n…はい、出していいわよ！　１、２、１、２……はいイッてっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んんんッ♪　んんんんぅっ……やだぁ、もぉ苦すぎっ……♪　んぷっ、んん\nんっ……！　焦らないでゆっくり出せばいいじゃないっ……んむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603136" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「あっ♪　自分じゃ出す勢いなんて決められない……ですって？　それなら私\nが、体育会系の吸いつきで……じゅるるるるっ、絞り取ってあげるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「じゅるっ、じゅるるるっ！　もっとよ、もっと出ひなひゃい……！　じゅる\nっ、じゅるっ……！　いいわ、その調子、もっと！　じゅるっ！　じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603138" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ん～～～～っ♪　も、もういいわ、出しすぎ……んぅうううっ！？　ま、ま\nずいわ、グラウンドにこぼれちゃうっ……。飲むから待ちなさい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……ごっくんっ！　ごくっ……ごくっ……。の、喉に絡みつくわぁ……。ん\n、は、早く飲まないと次のが来て……ん～～～～～～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603140" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ごくっ、ゴク、ごくっ！　ぷぁああ……！　んん～っ、この精液のしつっこ\nい味ぃ……。いつまでも、口の中に残るのよね、これぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603201" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……どうして精液を飲み干したのか、ですって？　あなたねぇ。神聖なグラ\nウンドに精液を吐き出すわけにはいかないでしょ。それよりも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「どうしてあれだけ大量に精液を出しまくっておいて、まぁだまったく満足し\nてないみたいだけど？　このままじゃ帰れないんじゃない……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「だから、これはサービスよ。……ぐちゅっ、んんっ！　すっごい精液の味が\nするわ……。なんだかオチンポがヌトヌトしてるし……。んっ、じゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603204" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「まずはオチンポについた精子を綺麗に舐め取って……んちゅ、それから２度\n目のフェラチオね。……ぴちゃっ、ぴちゃ、くちゅ……。んちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603205" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ちゅ、ちゅぅっ……ちゅくっ、ふんんっ♪　ンッ……んっ♪　どう……？　\n痛くない？　気持ちいい？　……れろっ♪　ぴちゃ……ん？　どうしたの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603206" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……んむぅっ！？　ふむぅうっ！　なんであなたが腰を動かして、るのよっ\n……！　んぐっ！？　っぐちゅっ！　ぐっちゅっ、じゅっぷっ、じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603207" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ふむぅううっ！？　ど、どうして何も言わずにいきなりするのよぉおおっ…\n…！？　驚いちゃったじゃないのぉおっ……！　ん、ん、んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「で……でも、動くのを我慢できないくらい興奮してるってことでしょ？　だ\nったら……このまま突き進むしかないわよねっ、続けるわよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603209" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「あなたもっ……んんんっ！　わ、私に迷惑をかけない程度になら腰を揺らし\nていいわよ……！　協力プレイね、……んっ、本気出すわ、っじゅぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「私の舌と、あなたのオチンポのガチンコのぶつかり合いよっ……！　んれろ\nっ、じゅぷっ！　ぐちゅっぷっちゅっずっちゅっじゅるっ！　じゅっぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603211" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「はぁっ……♪　はぁ、んぁああ……♪　おいひぃ……って、ち、違うわよ、\n美味しくなんか……。んん！？　んじゅっ♪　やっ……おいひいぃ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「はふぅっ♪　ふぅっ、ぐっちゅっ……！　ぐっちゅっ、あぅううっ♪　なに\nぃ、これぇ……身体が疼くぅう♪　はぁっ、じゅぷっぐっちゅっじゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603213" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「はぁあっ♪　んぷっ……れろれろれろっ♪　ぐっちゅっ、ぐちゅっ、……ん\nんん－っ！　腰、速い……！　あぷっ！　んっ、んぐぅううっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んぁああっ……♪　ピッ、ピッて笛ぇ……！　鳴らしながら喉の奥、突かな\nいれぇえっ！　んぅうっ！　ずっちゅっ！　ぐちゅぅうっ、ぐちゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603215" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「いち、にぃっ……！　いっち、にぃ……！　じゅっぷっ！　じゅっぷっ、ん\nれろっ、れろっ……ぐっちゅっ！　んんんぅっ……いっち、にぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603216" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ふはぁっ♪　いっち、にぃっ、いっち、にぃっ……！　んんんんっ！？　ぐ\nっちゅっ！　ぐちゅっ！　あぷぅっ！　んぷっ、んんんん～っ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んぅっ！！　口の中でオチンポっ、膨張ひてる……！　あっ、んっ、んぐぅ\n！　腰の動き、も、どんどん加速ひて……！　あっ、んじゅぷっ！　んぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603218" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「あっぅっ……！　もう一度射精ひゅるならっ、あっ、教えてっ……！　んっ\n！？　出そうっ？　出そうなのねっ……わ、わかったわ、んじゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「精液を吸い出ひてあげりゅ……！　ぢゅるっ、じゅるじゅるじゅるっ！　ん\nじゅるっ！　ぢゅるっ、今よ、出ひて……！　出ひてぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603220" ]},
		{"command":[ "WAITINPUT" ]},
				
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んむぅうううううっ♪　むぅっ♪　ごくっ……！　ゴクッ、ごくっ……！　\nんんんっ！　もっと出せるれひょ、本気見せてみなさいよ……！　ごくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603301" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_13" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ん、ん、ん、んん……！　精液濃すぎ……っ♪　ドパドパ出てくるぅううっ\n……！　あっ♪　喉の奥に……直接熱いのが注ぎこまれて……ごくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んくぅうっ♪　ネバネバが口の中に広がって……んむっ！　や、やるじゃな\nい……！　ひゅごい、息が止まりそうっ……！　ごくっ、ごくんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……ぁ、やだっ、口から溢れて……！　ダメよ、あなたが出す精子は全部っ\n、私が見事に飲み干してみせるんだから……！　じゅるっ、ぢゅるるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603304" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「い、一度目の射精より苦味が増ひてるのはなんでなのっ……♪　ホント美味\nひい……じゃない、ほ、本当にいやらしいんだからっ……。んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「あなたのエッチなお汁、ここまで大事に飲めるのは私だけでしょうからっ…\n…。いいわよ、最後の最後まで、遠慮なく出してみなさい！　ごくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603306" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ぷぁ……。ぜ、全部出せたみたいね……。ええ、私は大丈夫よ。でも、お腹\nの中がずっしり重い感じがするわ。だって、とんでもない量だったのよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603307" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「あなたも自分で驚いたんじゃない？　えっ、出しすぎた！　って……。……\nんん、なんだか頭がクラクラする……変な笛と掛け声のせいよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603308" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「体育会系のがっつりフェラって大変すぎるわ。途中からあなたも、やりたい\n放題してくれちゃったし。はぁ、ますます汗かいちゃった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603309" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……なに？　いい匂い？　……ヘンタイっ。べ、別に怒ってるわけじゃない\nわよ。そんなこと言われたら、さすがに私も恥ずかしいってこと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603310" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「ッきゃぁあっ！？　も、もう、どこを狙って出してるのよぉっ……！　あっ\n！？　熱いっ……あんっ！？　体操着にもかかってるしっ……あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603401" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_16" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「んっ、んんっ！　せっかく私が口を貸してあげていたのに、そこからオチン\nポを引き抜くなんて……どういうことなのっ。あっ、顔にかけたくて？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「もぉっ……信じられない！　あなたの精液は普通じゃないのっ、ドロドロの\n粘り気が強すぎて……肌にかかると、へばりついてとれなくなるし！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603403" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_17" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……ひゃんっ！？　あぁっ！　目、目にはかけないでよ……。他にはどこに\nかけてもいいから……。っんっ……んん、とんでもない量だわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603404" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「溺れそうなくらい……。んっ、そんなにオチンポをビクビクさせて……。射\n精って、本当に気持ち良さそうよね。私も１回くらい経験してみたいわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……あぷっ。んんっ、あなた、私の顔を真っ白にしていくの……面白がって\nるでしょ！　まったく、どうしようもない人なんだからぁっ、あぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603406" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……はぁっ、はぁ……。こんなに精液でべったべたにされるなら……先にシ\nャワーを浴びておかなかったのは正しかったみたいね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「汗くさくなったとか、もうどうでもよくなるくらい……好き放題にぶっかけ\nまくってくれたわね。そんなに気持ち良かったの？　それとも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603408" ]},
		{"command":[ "SETIMAGE", "0", "still_00002406_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「やっぱり体操着っていうのが、良かったのかしら。……両方？　そ、そう…\n…。両方なら……いいわ。でも、こんな大サービスは今回だけだから！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "マーガレット" ]},
		{"command":[ "SETTEXT", "「……たくさん頼めばしてくれるだろうって？　あのねえ……。甘え方が上手\nになっちゃって困るわ。ほらっ、早くシャワーを浴びにいきましょ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_024_0603410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
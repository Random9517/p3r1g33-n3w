        {"command":[ "PLAYVOICE", "v2_297_0204113" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "狭い入口を亀頭にこすりつけながら、\n本庄さんが腰を落して来た。", "NORMAL" ]},

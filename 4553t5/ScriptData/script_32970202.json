        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「委員長、私……、もうガマンできないです……\n　委員長のこれ、入れちゃいますよ？」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204112" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "そう言いながら、濡れた入口を亀頭にこすりつけて来る。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「くっ、うう……、俺も、もうガマンできないって……。\n　早く本庄さんの中に……」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "俺も、本庄さんの中心に向かって腰を突き上げる。\nくちゅっと音がして、先端が、濡れた割れ目にめり込んだ。", "NORMAL" ]},

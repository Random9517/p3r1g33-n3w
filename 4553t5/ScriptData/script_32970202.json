        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETIMAGE", "0", "still_00029702_02_04" ]},
        {"command":[ "STOPANIM", "0" ]},
        {"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
        {"command":[ "SETTEXT", "「ああああああああああああああああああああっ♪」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204134" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "本庄さんがイクのと同時に、俺も本庄さんの奥で射精した。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「くっ、本庄さん……、ああっ！」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「ひゃんっ、ああぁ、出てますっ……熱い精液が、\n　私の中に出てますぅ……あああ……♪」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204135" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「まだ、出る……ううっ！」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "体を搾り上げるようにして、さらに思いきり射精する。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「んっ、ああっ！　まだ出てますっ……、\n　委員長の白濁液、子宮にいっぱい、当たってます……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204136" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「あふっ、あああっ……委員長の陰茎、中でビクビクって\n　してるの、わかります……んっ、あっ、あああああっ♪」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204137" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "体の奧に勢いよく射精され、\n本庄さんは全身を痙攣しながら絶頂している。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "熱いぬかるみのようになった蜜壺に搾り上げられながら、\n俺は最後の一滴まで本庄さんの中にすべて吐き出した。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETIMAGE", "0", "still_00029702_02_05" ]},
        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「あふ、んっ……あっあぁ、んあぁぁ……♪」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204138" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "俺の射精が終わっても、\n本庄さんはまだ断続的に浅い絶頂を繰り返している。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「あうっ、本庄さんの中、まだ締まってる……、ううっ！」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「は、い……ああ、委員長の、も……まだ中で\n　ヒクヒクしてます……、ひんっ、んっ、あああ……♪」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204139" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "本庄さんの体の奧が強く震えた。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "その膣圧に押し出されるようにして、今放ったばかりの\n精液がいやらしい音を立てながら溢れ出して来た。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「やん、あぁ……、委員長の精子が、溢れて……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204140" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「うう……、本庄さんがまだ締め付けて来るから」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「委員長がいっぱい、出しすぎるからです……はぁ」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204141" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "本庄さんが、ようやく少し落ち着いたように息を吐いた。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「ん、あぁ……、アソコ、まだジンジンしてます……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204142" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「俺だって……」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "あまり激しくしすぎたのか、逸物がジンジン痺れている。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「本庄さんがあんまり激しくするから」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「委員長だって、獣みたいでしたよ……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204143" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "どうやらお互い様らしい。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「でも、いいですよね……。今日はお祭、ですし」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204144" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「お祭だといいんだ？」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「お祭は、ハレとケで言う、ハレですから……\n　１年のケガレを払う日……です……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204145" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「逆に、よけい穢れたような気がしなくもないけど」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "ケガレをたっぷり吐き出したことで、\n払ったことになるのかな？", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "ふと静かになると、\n遠くから祭の喧噪が小さく聞こえて来た。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「あ、太鼓が……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204146" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "微かに聞こえる太鼓の音に、本庄さんが反応する。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「うっ……、本庄さんの中, またヒクヒクしてきた？」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「太鼓の音に、条件反射で反応しちゃってるみたいです」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204147" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「まさか、また興奮して来たとか？」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「はい……委員長は、違うんですか？」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204148" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "萎えかけた逸物をキュッと締め付けながら訊いて来る。\nまだ本庄さんの中のモノは、たちまち力を取り戻し始める。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「いや、違わないかも」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "そう答えると、本庄さんがいやらしい笑みを浮かべた。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「じゃあ、もう１回……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204149" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "そう囁きながら体を押しつけてくる本庄さんを、\n俺もまた強く抱きしめた。お祭は、まだ当分終わらないみたいだ……。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},
        {"command":[ "EXIT" ]}
    ]
}
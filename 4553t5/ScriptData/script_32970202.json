        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「はい……もう、恥ずかしいぐらい、\n　すごくなっちゃってます……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204109" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "本庄さんの秘密の入口は、もうぐっしょり濡れていた。\nそこから溢れ出したものが、俺の股間まで濡らしている。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「太鼓叩きながら、こんなにしてたのか？」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},


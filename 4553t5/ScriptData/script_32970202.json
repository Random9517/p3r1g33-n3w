        {"command":[ "PLAYVOICE", "v2_297_0204120" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "本庄さんが俺の腰の上で大きく尻を弾ませる。\nそのたびに奧の壁がズンズンと先端に当たっていた。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「すごい、委員長の陰茎が、子宮にズンズン響いてます……\n　あんっ、ああっ、あっ♪　お腹の奥で、太鼓が鳴ってるみたいに……\n　ビンビン響いて……んんっ、ひゃうう……♪」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204121" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "逸物を縦に叩きつけられるような刺激は、\nズンズンと腰にまで響いてきた。", "NORMAL" ]},

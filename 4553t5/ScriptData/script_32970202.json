        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「んっ、ああっ、委員長……、ひうっ、ふぁあ、ああっ、\n　すごい、お腹の奧がビンビン響いてます……あああっ♪」", "NORMAL" ]},

        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "ふいに襲ってくる鋭い刺激に、腰が激しく弾む。\nその拍子に、先端が本庄さんの奥を強く突いた。", "NORMAL" ]},

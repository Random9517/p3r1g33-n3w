        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "本庄さんの体が、太鼓の響きを思い出したように震えた。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},

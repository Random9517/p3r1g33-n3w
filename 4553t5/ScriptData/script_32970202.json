        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "俺も、急激に射精の予感が高まってくるのを感じた。\nもう長くは持たなそうだ。", "NORMAL" ]},

        {"command":[ "SETIMAGE", "0", "still_00029702_02_01" ]},
        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「あぁ……、委員長の、もうこんなに固くなって……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204108" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "本庄さんは、腰をくねらせながら、勃起した逸物に股間を\nこすりつけてくる。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},


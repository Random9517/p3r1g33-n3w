        {"command":[ "SETTEXT", "「うっ……ああっ……！」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "パンパンに張りつめた亀頭を、\n熱く熟れた膣壁が強く刺激してくる。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「んっ、あっ、あああ……、すごい……委員長の固い肉棒が、\n　いっぱい入って……くっ、あっ、んんんっ！」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204114" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "本庄さんの全身が大きく震えた。その振動が中の逸物にまで\n伝わってきて、俺の全身も総毛立つような快感に包まれた。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「はぅ、んっ……すご、い……奧まで届いてます、はぅ……」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204115" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "そのせいで、亀頭がひしゃげるんじゃないかと思うほどの\n力がかかっている。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「本庄さん……くうっ……！」", "NORMAL" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「たしかにすごかったけど」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「んっ、ああ……まだあの振動が、\n　体の中に残ってるみたいです……んんっ」", "NORMAL" ]},

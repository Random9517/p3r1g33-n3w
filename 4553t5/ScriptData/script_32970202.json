        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "いやらしい声を上げながら、\n本庄さんはますます強く腰を押しつけて来た。", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「ひゃんっ、んふっ、んんっ、ああああっ♪委員長の陰茎が、\n　お腹の奧にズンズン響いて……んあぁ、こんなに奥まで来てます……\n　はううっ！」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204118" ]},
        {"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
        {"command":[ "PLAYANIM", "0", "ev297_02b_0000", "ev297_02b_0023", "true", "ALL" ]},

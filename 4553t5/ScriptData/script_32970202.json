        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "あなた" ]},
        {"command":[ "SETTEXT", "「ううっ！　それ、先っぽがこすれて……ヤバイ……」", "NORMAL" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "翡翠" ]},
        {"command":[ "SETTEXT", "「んううっ、私も、たまらないです……、んあっ、あああっ、\n　これ、気持ちよすぎ、て……あああっ♪」", "NORMAL" ]},
        {"command":[ "PLAYVOICE", "v2_297_0204116" ]},
        {"command":[ "WAITINPUT" ]},

        {"command":[ "SETNAME", "" ]},
        {"command":[ "SETTEXT", "奥が気持ちいいらしく、本庄さんは思いきり腰を押しつけて\n来る。本庄さんの体重が、ほとんど股間に乗っかっていた。", "NORMAL" ]},

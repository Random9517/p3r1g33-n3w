		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イヴリン" ]},
		{"command":[ "SETTEXT", "「ですが、とても嬉しいです！　ご主人様が気持ちよくなってくださっている\n　のを、おまんこでしっかりと感じられます！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_335_0204211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イヴリン" ]},
		{"command":[ "SETTEXT", "「はふっ、んっ！　くぅぅっ！　おまんこのお肉やヒダが、またおちんぽに絡\n　んでおります！」", "NORMAL" ]},

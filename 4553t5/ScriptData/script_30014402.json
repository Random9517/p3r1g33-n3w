{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_02" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ♪　チンポはすっかり準備万端だな。そんなにガッチガチに勃起させ\nて、今にも爆発しそうではないか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404101" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「まぁ、とはいえ……私の方も、見ての通りなんだがな。マンコはすっかり蕩\nけ切って……んんっ……何もせずとも愛液が溢れてきてしまう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、貴様のクンニが気持ちよすぎたせいだ。責任は……きちっと、取っ\nてもらわないといけないな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404103" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「前戯は……お互い必要ないな。……待ちに待った私のマンコの味、思う存分\n愉しんでくれ♪」」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んっくぅんんっ！　あっ、ああぁん……！　入ってきてぁ……！　ガチガチ\nチンポ、トロトロの私のマンコに、んぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こ、これ、駄目だ……愉しみにしてたのは私も、だからぁ……あっ、んぅん\nっ……！　チンポを入れただけで、軽くイっちゃったぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だけど……んぁんっ……！　遠慮なんて、必要ないからな……これは頑張っ\nた下僕へのご褒美、なんだから……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「最初から激しく腰を叩きつけて、好きなように気持ちよくなっていいぞ！　\n私のマンコ、貴様のバキバキチンポで滅茶苦茶にしてくれっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、ふぁっ、あぁんんっ……！　すごいっ！　チンポで膣内の肉がめりめ\nりって、こじ開けられてっ、んあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「お腹のなか、でぇ……チンポの形がはっきりわかるっ、あぁんんっ！　私の\nマンコ、ぴったり吸い付いちゃうからっ、んぅうんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「おっ、おおおっ、んおおぉんんっ……！　立派なカリ首でっ、マンコの膣内\n、全部ひっくり返されるぐらい気持ちよくてっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ズンズンって来るっ、子宮まで響く勢いでチンポ感じちゃうっ！　あっ、あ\nぁんんっ！　んっっくぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――い、いいぞ、それを貴様が望むならっ……んはぁんっ！　わ、私からも\n頑張って腰をヘコヘコしてやるぅ……あっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひっ、あっ、あぁんっ！　んぅうんっ！　パンパンパンって、尻がぶつかる\nのも、気持ちいいっ！　衝撃が身体に響いてっ、あひゃぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そ、それぇ……んんぅんっ！　マンコだけじゃなくて、胸も揉まれて……あ\nっ、んふぅんっ！　乳首までこねこねってっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、嫌な訳、ないだろう♪　好きだぞ、貴様から与えられる全てが好き\nだっ……もっともっと、身体全てで感じさせてくれ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私ももっとっ……んぅんっ……！　マンコを締め付けて、貴様の事を気持ち\nよくしてやるからぁ……もっと深く、もっと激しくぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ！　そ、それっ、角度を付けてチンポずぼずぼするの、やばい\nっ……！　弱い所ばっかりっ、ふあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そこぉ！　Gスポットもっといっぱい突いてくれ……！　亀頭の括れで削っ\nて引っ掻いてっ、乱暴に掻きまわしてぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んくぅんっ！　ひっ、あっ、ふあぁんんっ！　おっ、おっほぉんっ！　あっ\n、ああっ、あぁんんんっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「す、すごい、愛液が次から次に溢れてきて、ぐちょぐちょって、えっちな音\nもこんなにっ……んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁ……やっぱりこの匂い……頭のなかふわーってしてっ……幸せ過ぎて、\nまた子宮もきゅんきゅんするんだ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――貴様はどうだ？　しっかりご褒美、受け取ってくれてるか？　私のトロ\nトロマンコで、気持ちよくなってくれてるかぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふ、ふふふふっ♪　そうだな、こんなものじゃ全然足りないよな♪　全身\nドロドロに蕩けるまで、二人で一緒に気持ちよくなるぞっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んあぁんっ……♪　チンポをズボズボするだけじゃなくてっ\n、んぅんっ！　腰を前後にぐりぐりっ、あんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んうぅんっ！　ふふっ、またチンポがビクンって跳ねて、大きくなったな…\n…♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「イきたいのか？　私のマンコでびゅーびゅー射精したいのか？　でも、もう\n少しだけ我慢だぞ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ……！　い、意地悪ではないぞ！　イクなら私も一緒にイきた\nいんだっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んあぁんっ……！　あと少し頑張って耐えてくれっ……！　私も、も\nうちょっとでイキそう、だからぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひっ、あっ、んひゃぁんんっ……！　それぇ、エラでごりごりって、マンコ\nの膣内引っ張り出すのっ、いいっ……！　」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「すごい、子宮がすっかり下りてきて……んぅんっ！　チンポが突き込まれる\nたび、逃がさないって吸い付いていくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「このまま最後までっ……あっ、んあぁんっ！　もちろん、膣内に出すんだぞ\nっ！　私の子宮に直接精液をぶちまけてくれっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「く、来るっ、マンコの奥からじわーって上ってっ、あっ、あああっ、ああぁ\nああっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「イク、イクイクイク、イックぅぅう～～！　いっぱい出してぇ！　チンポを\n子宮にぴったりくっつけて、膣内出し射精してぇっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁぁ～～～～っ！！　あっ、ふぁんんっ！　これを待っていたんだ！　\nドロドロの精液、子宮のなかにびゅーびゅーってきてるぅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_09" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひっ、あっ、ふああんんっ！　お、おお、おっほぉんんっ……！　と、とま\nちゃない、イクのとまりゃないぃ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「でもぉ……！　んぅんっ！　これはご褒美、だからっ！　射精中ももっとマ\nンコを締めつけてやるっ！　チンポの全部を搾り取ってやるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だからもっと出してっ！　いっぱい我慢した分、もっともっと精液を注ぎ込\nんで！　私のマンコで気持ちよくなってぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「またイク、何回もイクっ、イックゥぅっ……！　マンコの深い所でザーメン\nを受けとめて絶頂するの、気持ちよすぎるぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……すご、かったぁ……んっ……んぁ……だ、だめ、全然\n息が、整わないっ……はぁ、はぁ……くぅぅっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ、どうだ、満足したか――と、聞こうと思ったが、まだチンポはこん\nなに固いままだもんな？　一回膣内に出しただけじゃ物足りないよな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私も……んんっ……こんなにもたくさん精液を注ぎ込んでもらったというの\nに、子宮の疼きが全然止まりそうにないんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――なに他人事みたいにニヤニヤしている。私をこんな身体にしたのは貴様\nだぞ。その責任は、しっかりとってもらわないとな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが……ふふっ、二人してもう腰がガクガクだな。最後はご褒美とか忘れて\n……ゆっくりじっくり愛し合いたい……いいか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――流石は私の下僕、そうこなくちゃな♪　顔をこっちに……んちゅ……ふ\nふっ、これはサービスだ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んぅんっ……！　今度はじっくり、ゆったりっ……ジワジワ\nと気持ちよくなるみたいに……んぅんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それっ、ゆっくり腰を回すみたいにされるのっ、気持ちいいぞっ……んふっ\n、あっ、んぅうんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「さっきみたいに激しく求め合うのもいいが……こうして互いの熱を感じなが\nらするセックスも悪くない……んぅんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが……ふふっ、貴様にとっては少し物足りないみたいだな？　仕方ない奴\nめ。激しく腰は触れないが、その分、こうして……んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「マンコをぎゅーって締め付けて気持ちよくしてやろうじゃないか♪　あっ、\nんぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んぅんっ……と、とはいえ、さっきの余韻がまだ残っている\n、からっ……あっ、んあぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000144_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「亀頭で子宮をぐりぐり押し上げるように刺激されると、あぁんっ♪　気持ち\nよすぎて、頭の中、簡単に蕩けちゃいそうだ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4404212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁんっ！　ふふっ、なんだ、またおっぱいも揉みたいのか？　乳首をねち\nっこく弄り回したいのか？」", "NORMAL" ]},

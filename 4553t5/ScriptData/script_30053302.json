		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふあああああああっ！！　主様の精液、来たあああああっ！！　んふううう\nうっ、どくどく、注がれてるっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「二回目なのに、こんなに大量に注がれて、ウチのオマンコ溺れちゃう！！　\n主様の気持ちいいので溺れちゃうです、んふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふううううううっ、んっ、あっ……はっ……最後の一滴まで、奥に注がれて\nる……んっ、ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「お腹の中、もう主様のでいっぱいです……ふうううっ、ウチがプレゼントす\nるつもりだったのに、主様のをプレゼントされて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「これじゃあべこべです……いえ、こんなにたっぷり出されたのですから、こ\nれはもう……そう、子種をプレゼントされて……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「つまりは子供ができる……主様とウチの、可愛らしい子供が……そう、そう\nに違いないです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「つまり、それこそが本物のプレゼント……ふふ、うふふふ、ウチが主様に贈\nることのできる、プレゼント、です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「主様、驚くでしょうね……まさか、これでウチが孕んだとか思うはずもない\nですし、サプライズ、というものです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「仮に子供ができていなくても、また主様に抱いてもらえればいつかはできる\nはずですから……ふふふふ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「だから、まだまだいっぱい子種をプレゼントしてくださいね、主様……主様\nの気持ちいいの、全部ウチに注いでください」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304310" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_11" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0149" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00000533_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev005_33b_0000", "ev005_33b_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETTEXT", "――目を開けると、壁から尻が生えていた。", "NORMAL" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETTEXT", "小さめだが形はよく、一見しただけで肌の張りもあると分かる。白く、丸い尻\nだ。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETTEXT", "触ると、ぴくりと反応する。突くと柔らかく、手のひらには暖かさも伝わって\nくる。まるで本物の尻だ。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETTEXT", "とはいえ、本物の尻が壁から生えているはずもない。しかしこの柔らかさと暖\nかさは生きているようだ。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETTEXT", "そうか、これは夢だ。夢なのだ。日々の疲れが自分にまだ夢を見させているの\nだ。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETTEXT", "夢ならば、存分に楽しむのもいいだろう。だって、夢なのだから。尻の柔らか\nさと、女の気持ちよさを楽しもう。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETIMAGE", "0", "sbg_0000" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETTEXT", "――一方その頃。アナザー・オボロの部屋にて。", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETIMAGE", "0", "still_00000533_02_01" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「うう……失敗しました。寝ている主様にプレゼントを渡そうと思ったのに、\nあのタイミングで起きるなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304108" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「しかもワームホールの設定を間違えて、上半身だけ抜けたところで閉じそう\nになるなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「時間が来ればまた広がるし、主様にはプレゼントを渡しに来たのはばれてな\nいみたいですけれど……ひうっ！？　あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「え、これ、主様の手……んっ、あっ、そんな、触ったら、ダメ……んっ、あ\nっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んっ、揉むの、ダメ、あっ、んんっ、あんっ！！　んっ、見えない分、敏感\nになって、ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふうっ、うっ、止まった……？　んっ、ふっ……あっ、これ、オマンコに触\nれてるの、これって、主様の……んうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「入って、きた……あっ、んっ、んんっ、こんな、激しく、んっ、ああっ、あ\nんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んうっ、あっ、あああっ、これ、奥まで擦れて……主様のオチンポ、ふうう\nっ、うっ、気持ち、いいっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304115" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_33b_0000", "ev005_33b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、あんっ！！　見えないから、主様の動きが……んっ、凄い、\nオマンコの中が敏感になって……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ああああっ、奥、ごりごりって潰すの、ダメっ、ダメです主様……んっ、ふ\nううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んっんっんっ！！　ふうっ、うっ……ううううっ！！　もしかして、ウチだ\nと分かってない……んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「だったら、これ以上声を上げたら……ふううっ、ばれちゃう、んっ、から、\nそれは防がないと……んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あうっ、でも主様のオチンポ、太くて、硬くて……ダメ、我慢……我慢しな\nきゃ……んっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んうううううっ、ゆっくり、動かされたら……主様のオチンポ、形が……オ\nマンコで分かって、あっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふうっ、うっ、中が、オマンコがオチンポに吸いついているのが、分かって\n……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あっ、うっ、カリ首で擦られたら……声、出ちゃう、主様、主様……んくう\nっ、んんんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふっ、ふうっ、ふううううっ。んんんっ、その、ずちゅずちゅかき混ぜられ\nたら、うううううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「大声、出ちゃう、主様にばれちゃう……サンタは、ばれたらだめなのに……\nんんっ、あああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、あっ、んっ、ふうううっ、見えないから、中、敏感になって\n……んうううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ、んっ……あああっ、奥が、ごつごつって、叩かれてる、ウチ\nの、一番奥、主様のオチンポが触って……んくうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304127" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、んっ、ダメ……ダメ……ぞりぞりって擦られたら、ますますオ\nマンコ締めつけちゃって……うううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふっ、んんんっ、お腹の中……主様のオチンポで、じんじんしてる……んっ\n、んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「これ、もう……んっ、主様に入れられて……んんっ、オマンコ、我慢できな\nい……んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「声、出ちゃう！！　オマンコの奥、オチンポで突かれて、声が我慢できない\n……あううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ、でも、ばれたら、サンタが台無し、だからっ、んっ、はあっ\n、ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「それ、ごりごりするの、ダメ、本当にダメ、です……んんんっ、あっ、ああ\nっ、あっあっあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304133" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「もう、ダメ、我慢できない。声も、オマンコも……ふうううううっ、イっち\nゃう、イっちゃう、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「主様のオチンポ入れられて、下半身だけで、イっちゃう、ううううっ、イく\n、イっくうううううううう！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ひああああああっ！！　ウチの中に、主様のが、子種が……いっぱい、入っ\nて……ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304136" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、溶けちゃう、ウチのオマンコ、精液で溶けちゃう……ふうっ、うっ\n、んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「はっ、あっ……んっ……凄い……お腹の中、火傷しちゃいそうです……主様\nの、熱すぎる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んんっ……中でどろどろしてるのが、分かる……濃いのがいっぱい、いまウ\nチの中に注がれてるのが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふうっ、うっ……それだけ気持ちよかったのなら、良かったですけど……で\nきたら顔を見たかったです……ふっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「でも、一回出して落ち着いたはず……今のウチに、ワームホールの設定を書\nき換え――ひあっ、あっ、なんで、また……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、連続で、二回目なんて……主様、興奮しすぎ……んっ、ふっ\n、ううううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304202" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev005_33b_0000", "ev005_33b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「さっき出したので、ヌルヌルして……また違う感触が、あっ、んっ、主様の\nオチンポがぬるって……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「出たり入ったりして……ふうううっ、イったばかりで、敏感になってるのに\n、そんなふうに擦られたら、ああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あうっ、あっ、ウチの中、さらに熱くなって……ふっ、うっ、あああっ、身\n体、火照りきってる、です……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、熱々のオマンコでオチンポに抱きついてるから、火傷しそう……ふ\nうううっ、主様のオチンポも、熱い……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あくうっ、それで奥をこねられたら、はっ、あっ、頭の中まで、かき回され\nてるみたいで……んううううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「こんな、こんなの、耐えられない……また……ふううううっ、あっ、またイ\nきそうに……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ああっ、ここで弱めるの、ずるい……聞こえてないはずなのに、意地悪……\nです……主様……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304209" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あっ？　ああっ、んっ、あっ、これ、違う……主様のオチンポ、探ってる、\nあんっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ウチが一番感じる所、オチンポで探ってる、ふあああっ、あっ、あんっ、あ\nああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ダメ、その、カリ首で壁擦るの、ダメっ、はっ、あっ、んんっ！！　あうう\nうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「早く動いてお尻にぶつかるのもダメっ！！　ひううううっ、お尻もオマンコ\nも感じちゃうっ、ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304213" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、奥、奥をノックするのも、ダメ、です……そんな、そんなこ\nとされたら、オマンコが迎え入れちゃう……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ウチのオマンコ全部、感じさせられちゃってる！！　主様のオチンポで、全\n部感じさせられてる……ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ウチの顔、見えてないはずなのに、声も、聞こえてないはずなのに、あくう\nっ、んっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「なのに、こんなに正確に、ウチの弱いところ……んっ、オチンポで突いてき\nて……あんっ、あっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あああっ、主様のオチンポも膨らんで……ふううっ、主様も、気持ちよくな\nってる、です。んっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304218" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ウチも、ウチもまたイく！！　んっ、オマンコ締めつけるから、主様、一緒\nに、見えてなくても一緒に、イって、ふううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「あっ、来る、イく、オマンコイく！！　オチンポも、イって！！　ウチのオ\nマンコで、オチンポから気持ちいいの出してくださいっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},

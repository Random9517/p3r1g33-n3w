		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「んううううっ！！　主様のオチンポ、抜けて……あっ、あああっ、お尻に、\nウチのお尻に精液が……ふああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「熱い……んっ、びゅるびゅる振りかけられて、お尻が火傷しそうです……ん\nんっ、しかも、こんな大量に……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「お尻全体に精液が塗りたくられて……ふううううっ、こんなの、マーキング\nみたい……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ウチが主様のものだっていう、マーキング……ふあああっ、それだけで、ま\nた軽く、んっ、イく……ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「はっ、あっ……終わった……二回目なのに、凄い量です……んっ、ふっ、お\n尻から妊娠しちゃいそう……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000533_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「中も外も、主様で染め上げられて……ふふっ、中に出されなくても、こんな\n風に満足できたりするんですね……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「顔が見えないままなのは残念ですけど……いや、むしろそうだからこそ、主\n様がこんなに激しくしてくれたのかも、です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「こんな風に遠慮なく、中も外も、ウチにぶっかけて、オチンポで頭の中まで\nかき回してくれて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「そう考えれば、こういうのも悪くないです……ね。また、主様が寝てる時に\n……してみましょう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3304409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Aオボロ" ]},
		{"command":[ "SETTEXT", "「ふふ……こんなはしたないウチを、許してくださいです。でも……愛してる\nから、こんなことをするんですからね、主様」", "NORMAL" ]},

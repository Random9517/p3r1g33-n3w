		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んあひぃぃぃぃっ……！　また……あっ、中出し……来てるっ！　子宮まで\nっ……新鮮ザーメン流れこんでくるぅっ……！」", "NORMAL" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んくぅぅぅ……んんっ……！　はぁぁぁ……い、一番奥まで密着して……チ\n〇ポがビクビク震えてるの……すごすぎぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はふぁっ……んんっ……あひっ、あぁ……全部出してぇ……溢れてもいいか\nらぁ……しっかり種付け完了させてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……あたしも……締め付けるぅ……チ〇ポに気持ちよくだしても\nらう為に……オマ〇コ肉……絞るからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「おっ、ふっ……！　んふぅ……これでどうだ……？　あっ……最後の一発…\n…んっ、奥に……届けてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……んっ、ふっ……終わり……もう一滴も出ない……？　本当\nだね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んふっ……何か、最初はお願いを聞いてやるってだけだったのに……途中か\nらシチュエーションに凝りだして、すっかり乗せられちまったね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「まぁ、こういうフォーマルなカッコによろめく気持ちも分かるからね……ち\nゃんとご褒美になったんならよかったよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたも、上司に色々溜まってたから、こーいうプレイがしたかったってこ\nとは……普段もそういう不満があったってことかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「くくっ、そんなに必死で否定しなくても。あくまでプレイだってことだね。\nまぁ、それなら、そういうことにしておくよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ひゃひぃっ……！　あぁっ……んっ、出てるっ……！　チ〇ポ……抜けてっ\n……あぁっ、ブラウスに掛かってっ……はぁっ、ストッキングも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁ……い、イヤじゃないです……んっ、どうか……あたしのカラダと……\n服にも……遠慮なくザーメンをぶち撒けて下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104402" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしのオマ〇コも……イ、イッて……んふっ、恥ずかしい……汁……飛ば\nしてますからぁ……あへぁぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あったかい……んっ、この粘液が……さっきまで全部あたしの中に入ってて\n……今度はお腹にも……太腿にもへばりついてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「オスのマーキングでメスにされる感覚……あぁ……気持ちいい……チ〇ポの\n躾……完了しちゃってるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あふっ……あぁ……止まった……これで打ち止め……終わり……全部、出し\nたんだね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……いつの間にか、流されて妙なプレイをさせられちまったね……い\nや、言うことを聞くって言ったのはあたしだからいいんだけどさ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あくまで部下の立場から上司を犯したいなんて……最初にビクビクしてた時\nから、よくもまあ本性を出したもんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「いや、別に怒ってないさ。何なら、もっとしたっていいくらいだよ。このま\nまエスカレートしたら、完全にあたしは支配されちまうんだろうね？」", "NORMAL" ]},

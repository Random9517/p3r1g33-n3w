		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「来てくれたね。何だい、そんなビビった顔をしなくてもいいだろう？　説教\nで呼んだんじゃない、むしろ逆だよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104101" ]},
		{"command":[ "SETCHARA", "0", "char_00000321_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁ、確かに日頃ギャアギャア煩く言ってるからね。警戒するのも分からな\nくはないよ。本当に何も企んじゃいないさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104102" ]},
		{"command":[ "SETCHARA", "0", "char_00000321_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そんなに疑うんなら、そうだね……何でも一ついうことを聞いてやるっての\nはどうだい？　もちろんあたしが出来る範囲でのことだけどね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104103" ]},
		{"command":[ "SETCHARA", "0", "char_00000321_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「は……？　立ちバックで……中に……入れたい……？　いや、そういうつも\nりで何でもって言ったワケじゃないんだが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104104" ]},
		{"command":[ "SETCHARA", "0", "char_00000321_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「……いや、けど……そうか。ねぎらいの言葉で終わるより、もっと直接的な\nヤツがある方がいいね……ふん、悪くないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104105" ]},
		{"command":[ "SETCHARA", "0", "char_00000321_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「いいよ。あんたの仕事ぶりに免じて、あたしのカラダ……今から好きにして\nいい……ひゃっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104106" ]},
		{"command":[ "SETCHARA", "0", "char_00000321_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ……！　あっ、一瞬でスカートを下ろして……そんな鼻息を荒くさせ\nて……さっきまで呼び出しにビクビクしてたクセに……現金だねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ……尻を触りたいのかい……あぁ、いいよ……好きなようにする\nといい……はっ、んんんぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「この服のあたしに、そこまでムラムラしてたとはね……うぁ……もうチ〇ポ\n……反り返らせて……入り口に当たってる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ……あっ、指……いきなり出し入れ……一応、準備……？　んふっ、\n程々でいいよ……どうせ、すぐ……溢れてくるからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「焦れったいね……んっ、要するに……もう入れていいって言ってるんだよ…\n…それぇ……チ〇ポ……早く、オマ〇コにハメてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁっ……！　あっ、ふっ……！　おっ……中っ……チ〇ポッ……ず\nぶって……来たぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んぅぅ……あぁ……期待していたなんて……んっ、そ、そうさ……今日、あ\nんたを呼び出した時から、もう……こうされるのを待ってたんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だから……あんたが、直接立ちバックなんて言った時は……びっくりしたけ\nど、嬉しくて……オマ〇コもその気になっちまってた……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ、あぁ……一番深いところまでグッと挿し込んでぇ……チ〇ポの肉が\nみっちり詰まってるの……感じるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「も、もう……いいよ……ハメただけの生殺しは……ほら、あんたの好きなよ\nうに動かして……そう、チ、チ〇ポぉぉんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、あぉっ！　おっ、はぁぁおっ……！　あっ、ひっ、いきなりっ……速\nいのっ、んくぅっ、ズリズリ……来るぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んふっ……！　あっ、あぁっ……！　あぁっ、こんな……足を上げ\nたら……一番奥に……当たるっ、くふぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぅっ、んひっ、くぅぅんっ！　んっ、あぁっ……硬いトコが……コツコツ\nノックしてくる感じぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふっ、はっ、あぁっ……！　しかも、後ろから……自由が効かないのに……\nかき混ぜられてぇっ……はふぅっ、ふぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「くぅぅ……お腹の奥まで痺れてくる……くふぅ……あっ、それっ、またすご\nいっ……あっ、はぁんっ、あっ、あぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ヤバい……声が勝手に漏れちまう……んんっ！　なんで、こんなに気持ちい\nいとこ……ピンポイントで突いてくるんだ……はふっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、あぁ……オマ〇コ……ヒクヒクしてるところが分かりやすい……バ、\nバカ……そんなこと言われたって……くぅぅん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたの……チ〇ポが擦れたら……何したって、あっ、反応するんだから…\n…んっ、あっ、あぁっ……また、弱い……場所ぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、あぁっ……ヤバい……立ってられないっ……あっ、ふっ……\n腰……支えて……あぁ……あ、ありがとう……あひぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んぁっ、あっ……支えたら、もっと激しくても大丈夫って……それは……で\nもっ、あぁっ、抉れるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んふぅ……はぁぁっ、あっ、くぅぅ……す、少しだけ……緩めて……あぁ…\n…一気にイカされそうになってたから……はぁ、んぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「か、代わりにキス……？　んんっ、する……あぁ、キスでも何でもするぅ…\n…ちゅぷ、んっ、れろ、くちゅ、んちゅぱ……んふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁ……ヤバい……オマ〇コの中で、チ〇ポの存在感が……どんどん大きく\nなってきてる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ゆっくりでも……もう、擦れる度に……中が熱くさせられて……あっ、あぁ\n……じゅぷって音がヤバい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁっ、わ、わざとさせてるだろう……あたしのオマ〇コから汁を\n掻き出すように動かして……あっ、んふぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そうだ……チ〇ポが気持ちいいから……こんなに汁が溢れるんだ……わ、わ\nざわざ言わせるなんて……お前ってヤツは……はひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、そんなっ、ご褒美ピストンなんてっ……そんな、あっ、今っ\n……また激しくされたらっ、はっ、あひっ、イ、イクからぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁっ……イ、イってる所にっ……中出ししたいっ……？　そんな…\n…直球で言われたら……断れる訳ぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あんっ、いいっ……それでいいっ！　中に欲しいっ……あぁっ、チ\n〇ポ、もっと動かしてっ、そしたらイクからっ……んぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「出してっ……！　中にっ、あぁっ、熱いのっ……ザーメンッ……！　いっぱ\nい中出ししてぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁぁぁぁうんっ……！　はひっ……イクぅぅぅぅっ……あぁっ、イ、\nイってる……あぁっ……オマ〇コ……出されてる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はふぁ……中……あっ、溢れてる……そんなに溜まってたのか……隙間から\n、汁……垂れて来るぅ……はひぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁ、はぁ……はぁ……出されたぁ……あぁ……ヤバい……立ちバッ\nクの中出し……頭……真っ白になるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あふっ……まだ、中でチ〇ポ、うねってる……これ、すごい……あぁ……こ\nこまでなんて思わなかった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はふ……あぁ……抜けた……ザーメンが、ドロっと……垂れてきてる……全\nく、こんなに出したんだね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それだけムラムラしてたと……いいね……たまには、こんな受け身で……あ\nんたに服従させられるシチュエーションも悪くない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……なら、もっと……分からせる……？　あっ、おぉぉっ……！　もう\nっ、次の……チ〇ポッ……ズンって……来るぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、あっ、あぁ……あたしが反省……ど、どういうことだ……あ\nっ、んっ、じょ、上司なのに……いやらしいタイトスカートで誘惑した……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そ、そんな……あたしはそんなつもりじゃ……あぉうっ！　あっ、あぁっ、\nは、はいっ、口答えして申し訳ありませんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そ、そうです……あたしは、上司として部下を監督する立場でありながら…\n…ぴっちりとしたスカートで、いやらしくお尻を振って……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「部下の……チ〇ポを苛つかせて……誘ってしまいました……どうか、反省の\n証として……あたしのオマ〇コを……きつく躾けて下さいませっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぉっ、あっ、あぁぉっ……！　こ、こんなこと言わせるなんて…\n…あぁっ、で、でも……あっ、躾けチ〇ポが……気持ち……いいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、あぁっ……違う……あたしにマゾっ気なんか……んぁっ、あん\nっ！　お尻っ……叩くなんてっ、は、ひっ……あひっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ごめんなさいっ……口答えはしませんっ……反省して、ちゃんと……チ〇ポ\nを受け入れますっ……はぁぉっ！　またチ〇ポっ、そこぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁ……こ、こんな……謝罪なんて……でも……あぁっ、いつも以上に……\nドキドキして……内側から汁が湧いてくる感じが……はぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んぁっ、はっ、あぁっ……！　はいっ……チ〇ポっ……締め付けますっ！　\n教育のためのチ〇ポを、しっかりオマ〇コで受け止めますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、も、もっと……足を高く上げてっ！　あぁっ、ハメられた場所\nを見せつけるようにしてっ……あひっ、ズボズボまたっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぉっ……おぉんっ！　熱いっ……続けて、太くて硬いのっ……出入りして\nっ！　チ〇ポ……抜けていく感触が……たまらなくてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁぁんっ、あんっ、中が熱い……ヒダヒダが疼いて……腰にじぃんって…\n…蕩ける感じが……広がっていくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あぁっ、そ、そこぉっ、あっ……弱いとこっ、ばかりぃっ……また、次の…\n…ジワジワ来てるっ……はひっ、このままされたら……また……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はっ、ふぁっ……あぁっ……合わせるっ？　イク時に……また、射精っ……\nあ、後もう少し……あ、あぁっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「もう準備……あたしの方は……ほとんど出来てるからっ……最後っ、スパー\nトしてっ、はひっ、あっ、それっ、んひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000321_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はぁっ、ずっと気持ちいいとこっ、擦れてるっ……！　もうっ、オマ〇コッ\n、我慢できなくなってるからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「出してっ……！　また熱いのっ……躾けチ〇ポからっ、濃いのっ、いっぱい\nっ、ビュクってしてぇぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2104220" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},


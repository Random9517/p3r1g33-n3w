		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ふぅ～～～……今日もいいトレーニングが出来ました。お付き合いしてくだ\nさって、ありがとうございます！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203101" ]},
		{"command":[ "SETCHARA", "0", "char_00031602_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「それにしても、たくさん汗をかいちゃいましたね。早く着替えないと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203102" ]},
		{"command":[ "SETCHARA", "0", "char_00031602_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「え？　この状態でエッチをすれば、今よりもっとパワーアップできるんです\nか？　ほ、本当かなぁ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203103" ]},
		{"command":[ "SETCHARA", "0", "char_00031602_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「んっ、あんんっ……汗まみれで、気持ち悪い……身体中がベトベトするっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203104" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、はい……もっと汗だくおっぱいを押し付けながら、オチンポを握れば\nいいですね……んっ、しょっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203105" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はふっ、はぅ……うぅ……隊長さんの身体も汗ばんでる……これ、思ってた\nよりも恥ずかしいんですけど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203106" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「筋トレをした後の有酸素運動と同じで、汗まみれの状態で手コキをする方が\n効率がいいですか？　な、なるほど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「それじゃあ、隊長さんのオチンポ、シコシコしていきますね……ヘンなとこ\nろを擦ったら、ごめんなさい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ふっ、んんっ……はぁ、あっ……私の体温と同じくらい、オチンポ熱いっ…\n…それにカタくて、大きくてっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203109" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ……！　濃い匂いが、どんどん漂ってきますっ。この匂いを嗅い\nでると、頭がクラクラしちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「私の汗の匂いも、濃くてオチンポにくるって……！　ち、ちょっと！　何を\n言っているんですかっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203111" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「や、やめてくださいっ！　鼻をスンスンさせないでっ！　私の体臭、嗅いじ\nゃダメですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「わ、私も隊長さんの臭いを嗅いでいいと言われても……そんなの、恥ずかし\nいですよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「えっ……お互いの体臭や体温を感じながら激しくシゴくのも、パワーアップ\nの秘訣？　そ、そういうことなら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「すんっ……すんすんっ……んっ、はぁぁぁっ……隊長さんの体臭が、鼻から\n全身に広がっていくみたい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「私、この匂い嫌いじゃないかも……ううん。むしろ、好きな匂いですっ……\nすんっ、すんすんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「匂いを嗅ぐのもいいけど、ちゃんと手も動かして欲しい？　あっ、すいませ\nん！　ちゃんとシコシコしますねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203117" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「んっ、あっ……はぁ、あっ！　ぐっ、うぐっ……！　ふっ、はふっ……はぁ\n、あっ、あっあっ……！　ふぁぁぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203118" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「隊長さんのオチンポから、透明なお汁が滲み出てくるっ……匂いも、もっと\n濃くなってっ……んふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、あぅ……！　興奮が止まらなくて、私の乳首も大きくなってきちゃう\nっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はっ、はっ……んっ、はぁ……！　な、なんですか？　もっと乳首を身体に\n押し付けて欲しい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203121" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「手だけじゃなくて、汗まみれの身体もスリスリさせて……全身で奉仕をする\n感じにすると、より効率よく鍛えられるんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「は、はい……分かりました。隊長さんの言葉に、ウソはないと信じてますか\nら……んっ、ぐっ！　あっ、はぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203123" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「オチンポをギュっと握って、上下にシコシコしながら……おっぱいと大きく\nなった乳首を、押し付けてぇっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「このまま、身体もスリスリしてっ……ひゃ、あぁぁぁっ！　んっ、あっ、あ\nっはぁぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203125" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「こ、これ、すごいですっ！　乳首からビリビリって、電気みたいなのが走っ\nてぇっ！　ひゃ、はぅっ！　あっ、あぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「私が使う電撃よりも、強烈かもっ……！　んっ、あっ！　すっごく痺れるけ\nど、全然痛くないんですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「やっ、あぅっ！　ぐぐっ、ぐっ！　こ、この痺れを痛いと感じないのが、パ\nワーアップの成果なんですねっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203128" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「やっぱり、隊長さんのトレーニングはすごいですっ……！　このビリビリす\nる感じ、もっと味わいたいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ひゃ、あぁぁぁっ！　手と身体の動きを激しくすると、もっと強い痺れがぁ\n！　あぁぁっ、あんっ、はぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203130" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ビリビリがオマンコに集まってきますっ！　な、なんでっ……オマンコ、弄\nったりしてないのにぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「隊長さん……！　隊長さんっ……！　私、このビリビリでイッちゃいそうで\nすっ……！　イッても、いいですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203132" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、んぁっ！　隊長さんもイキそうなんですねっ……！　なら、一緒に…\n…一緒にイキたいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「もっとシコシコして、身体もスリスリしますからっ……！　ひっぐっ！　ぐ\nっ、あぅっ！　んっ、くふぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ひっ、あっ！　あぁぁぁっ！　イッ、イクッ！　イクッ！　痺れと匂いで、\nイッちゃいますぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203135" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「くはぁぁぁぁ～～～～っ！　あっ、はっ！　あっ、はぁぁぁ～っ！　痺れが\nもっと強くなってるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203136" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_05" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「隊長さんの精液の匂いと感触を感じると、おヘソの下のところがズキズキし\nてっ……！　あっ、あぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「私、いまイッてるのに……もっとおっぱい押し付けながらスリスリして、深\nイキしたくなってきてぇっ……！　んんっ、んぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　ふっ、あっ、あっあっ！　もっと精子の匂い、嗅がせてっ…\n…！　すんっ、すんすんっ……！　んぐっ、ふっ、はぁぁ～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203139" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「た、隊長さんっ……！　好きっ……！　この匂い、大好きぃ……！　あっ、\nあっ！　ひゃ、あっはぁぁぁぁ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ふぅぅぅっ……すごいイキ方しちゃいました……今までとは比べ物にならな\nいくらい、気持ちよくてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あぅっ……隊長さんのオチンポも、私の手も、精液でベトベトですねっ……\n身体と一緒で、汁まみれですねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203202" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「さて、と。そろそろ着替えを……え？　ここからさらにパワーアップする方\n法があるんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ふむふむ……オチンポのヌルヌル感が強くなったから、ここからもう一度手\nコキをすると、さらに効率がアップするんですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203204" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「でしたら、断る理由はありません。もう一回、手でオチンポをシコシコさせ\nてもらいますねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ……ぐっ、んんっ！　すごい……さっきよりもオチンポをシゴき\nやすいです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「擦るたびに、くちゅくちゅっていやらしい音がして……それに臭いも、より\n濃くなってますっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ、んんっ……すんっ、すんっ……！　んっ、くぅぅぅっ！　これ\n、ダメっ……！　頭の中、真っ白になるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203208" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「身体がどんどん火照って、もっと汗が出て……手だけじゃなくて、身体も濡\nれまくちゃいますっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203209" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「こんなの、我慢できませんっ！　もっとおっぱいと乳首を押し付けながら、\nオチンポシゴきたくなってくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ！　あっ、あんんっ！　ひゃ、はっ！　うぅっ、んっ！　うっく\nぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203211" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「また身体中がビリビリしますっ！　射精する前よりも痺れが強くてっ……あ\nっ、あぁぁっ！　背中もゾクゾクしちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「全身がビクビクッて震えて、乳首から鋭い刺激がっ……！　ふぁ、あっ、お\nっ！　ふっぎゅぅぅぅ～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ふーっ、ふーっ！　んっ、くふぅ～～～っ！　もっと……もっとこの刺激を\nくださいっ！　隊長さんの身体で、感じさせてくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203214" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ひっ、あぎっ！　んんっ！　あっ、あっ、おっ、おぉっ！　ふっぎっ、ぐっ\n！　うぐぐっ！　あっ、おっ、おぉ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203215" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「私の身体と同じように、オチンポビクビクしてるっ！　手の中で、熱いのが\n跳ねまわってますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203216" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、あっ！　もしかして、また射精しそうなんですか？　精液、びゅーっ\nてしそうなんですかっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203217" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「うっ、うぅっ！　んっ、ぐぅぅっ！　わ、私も、またイキそうなんですっ…\n…気持ちいいの、オマンコから溢れそうなんですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203218" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「また一緒にっ……！　一緒にイキたいですっ！　隊長さんの臭いを感じなが\nら、イカせてくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「んんっ、んっ、あっ！　あっおっあっ、あぁぁぁっ！　くるっ！　くるぅ！\n　隊長さんの臭いでイクッ……イクぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203220" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_09" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっはぁぁぁっ！　ま、また手にどぴゅどぴゅ精子出されてぇっ！　あ、熱\nいっ！　こんなの、火傷しちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「それに二回目なのに、すごい量っ……！　さっきあれだけ出したのに、まだ\nこんなに出るんですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、あっ……！　さすがは、隊長さんですっ……！　こんなに出して貰え\nて、幸せっ……あぅ、んぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203303" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ！　あっ……精子の匂い、もっと感じたい……ううん。匂い\nだけじゃなくて、味も感じたいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203304" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ちゅ、じゅるるるっ……じゅ、ぞっ！　んっ、んぐっ……ちゅ、ぱっ！　ち\nゅ、じゅぞっ……ぐっ、ごくっ……！　ごっくんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「はぁぁぁっ……苦いけど、どこか甘い味がしますっ……隊長の精液、すっご\nく美味しいですっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「こんなに美味しかったら、もっと飲みたくなっちゃいます……ぢゅ、じゅぞ\nっ……！　ぢゅるっ、ちゅるるっ……んっ、んっぐっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「ぢゅぞっ、ぞぞっ……ちゅばっ、じゅ……ちゅっぷっ！　はーっ……はーっ\n……これ、病みつきになりそう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「えっ？　精子の経口摂取は、パワーアップに最適？　あはっ。そうなんです\nねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203309" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「他にも、下の口から飲むのも効率的って……な、なるほど。そっちの方も、\n興味があります……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「きゃあぁっ！？　な、なにっ！？　オチンポが急に勢いよく跳ねてっ……あ\nっ、んぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「手だけじゃなくて、おっぱいにもどぴゅどぴゅ精子出てるっ……！　こ、こ\nれ、服がさらにヌルヌルになってぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203402" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「こんなに滑るなら、もっと身体を動かしたくなってきちゃいますっ……！　\nんんっ！　ひっ、ひっぎっ！　んっひぃぃぃ～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「あっ、あぁぁぁ～～～っ！　し、刺激が強すぎるぅ！　精子の匂いとヌルヌ\nルをもっと感じて、頭おかしくなっちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203404" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「イッ、イクの止まりませんっ！　隊長さんのオチンポと精液で、さらにイカ\nされてっ……！　ひゃ、あっ！　ふぁぁぁぁぁ～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「くふぅぅぅ～っ……ふっ、はふぅぅっ……何回も、イッちゃいましたぁ……\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203406" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「イクたびに甘くて強い痺れが、オマンコを襲ってきて……すっごく気持ちよ\nかったです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203407" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「パワーアップできたって実感があります……本当に、ありがとうございまし\nた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「でも、この痺れを覚えたら、電撃を使うたびに、この快感を思い出してしま\nいそうで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_316_0203409" ]},
		{"command":[ "SETIMAGE", "0", "still_00031602_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "黄崎ひなの" ]},
		{"command":[ "SETTEXT", "「もしそうなったら、技を使うとイッちゃう変態さんに……あぅぅっ！　ど、\nどうしましょうっ！？」", "NORMAL" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「期待しているぞ……。妾も、孕みたいのだ。そなたの精液で、孕みたい……\n孕ませてくれ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、だして……たくさんだして……っ！　妾の卵子が確実に孕\nむほどの大量の精液を……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104218" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ああっ、ああっ、妾もイク……ッ！　種付けアクメくる……っ、あっ、ああ\n……イク、イク……イク……ッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「子種汁っ、だして……子宮を満たして……っ！　ああっ、ああっ、妾のこと\nをそなたでいっぱいにしてぇええぇぇ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104220" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「あああぁぁぁああぁぁ～～～～っ！！　あっ、ああっ、イク、イッくぅうう\nうぅぅぅううぅぅ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「くるっ、くるっ、ザーメンくる……っ！　あっ、ああっ、熱いザーメンが妾\nの子宮に直撃ぃっ！　くっ、ううぅぅ～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ああっ、ああっ、膣……イキまくっている……っ。そなたのチンポに、貪欲\nに絡みついているぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたのチンポ……よすぎる……。種馬チンポに、思わず本気になってしま\nうではないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ただの種付け交尾で、こんなに乱れてイッてしまうだなんて……。ヒトのチ\nンポも侮れないな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ふふっ、妾のことをイかせた褒美として、このチンポのことをねぎらってや\nろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104306" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「挿入したまま、軽く腰をゆすって……な……。んっ、ああ、膣内でビクつく\nそなたのチンポを……感じるぞ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「それにしても……すごいな……。まだ、そなたのチンポはガチガチだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104308" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「妾との交尾を、もっとしたいということか……？　ふふ、それならばいいぞ\n。妾は何度でも相手をしてやろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104309" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「そなたになら、何度でも孕まされたい……。ああ、こんな感情が芽生えたの\nは、何百年ぶりだろうな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ああっ、チンポを抜くだなんて……っ！　まて、そんなことをしたら……っ\n！　んっ、ああぁぁあぁ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104401" ]},

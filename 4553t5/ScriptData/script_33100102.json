		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「射精っ、している……っ！　ああっ、そなたの精液が、妾に……かかって…\n…んっ、ああっ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「イク……イッてしまう……っ！　精液を、浴びて……イッくぅうううぅぅぅ\nううぅぅ～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ああっ、膣内だけでなく、肌の感度まであがっていて……っ！　全身が、膣\nと同じくらい……昂ぶっていて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104404" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「イク、イク……ッ！　イッてしまう……っ！　そなたに、全身ドロドロにさ\nれながら……アクメ……しまくる……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104405" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。そなたは……なんてことを……。種馬でありながら、ぶ\nっかけるとは……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104406" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「これは前戯ではないのだから、しっかり膣内にだしてもらわねば困る。さあ\n、仕切り直しだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「んっ、ああ……っ！　なんだ……チンポがさっきよりも大きくなっているの\nではないか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104408" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「精液まみれになった妾に興奮したのか？　ほう……ヒトはやはりかわってい\nるな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104409" ]},
		{"command":[ "SETIMAGE", "0", "still_00031001_02_12" ]},

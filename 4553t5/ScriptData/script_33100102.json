		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「はぁあああぁぁぁああぁぁ～～～～っ！！　ああっ、き……たぁ……っ！　\nんっ、くぅううぅぅ～～～～っ！」", "NORMAL" ]},

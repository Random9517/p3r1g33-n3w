		{"command":[ "SETIMAGE", "0", "still_00031001_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「ああっ、欲しい……っ！　そなたの放つ、孕ませ汁……っ！　メスの子宮を\n蹂躙するような精液が、欲しい……っ！」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00031001_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「妾の膣も、愛液を白濁させてねだっている……。だしてくれ……。だすのだ\nろう……？　もうすぐ、射精してしまうのだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_310_0104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エルノール" ]},
		{"command":[ "SETTEXT", "「遠慮なんかせず射精しろ。妾が中出しを、種付けを許可しているのだからな\n」", "NORMAL" ]},

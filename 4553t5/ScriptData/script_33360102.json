{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0149" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00033601_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev336_01b_0000", "ev336_01b_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「隊長くん、どうしたのこんな時間に呼び出しだなんて。何か緊急事態でもあ\nった？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00033601_01", "3", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ただわたしと話したかっただけ？　人となりを知るために交流したかった？\n　――うふふ、もちろん、大歓迎だよー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00033601_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「わたしも隊長くんのこと、もっと知りたいなって、もっと仲良くなりたいな\nって思ってたところだからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104103" ]},
		{"command":[ "SETCHARA", "0", "char_00033601_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「だから聞かせて、あなたのお話を。あなたがどういう人なのかをいっぱいお\n姉さんに教えてほしいな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104104" ]},
		{"command":[ "SETCHARA", "0", "char_00033601_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふふ、別に逆じゃないよー。わたしはどっちかというと人の話を聞く方が\n好きだから。愚痴とかも大歓迎、いっぱい甘えてくれていいんだよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104105" ]},
		{"command":[ "SETCHARA", "0", "char_00033601_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「――うんうん、つらかったね。って、ほんとつらいね？　隊長くん、心の底\nから大丈夫だった？　よく今日まで生きてきたね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104106" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「わー、これは相当溜まってたみたいだなぁ……うふふ、仕方ない、心が弱っ\nてる隊長くんの為に、今日はお姉さんが人肌脱いであげちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「よしよし、えらいえらい、隊長くんはよく頑張ってるよ。――ん？　これは\n何かって？　ほら、人肌って不安を和らげる効果があるからさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「色々溜まってる子には、こうして抱きしめて頭をなでなでしてあげることに\nしてるの。……あ、もちろんいつもは女の子だけだよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「だから隊長くんは特別。これでもあなたのこと、気に入ってるんだよ？　こ\nうやって裸まで見せてるんだから、察してほしいんだけどなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「って、うふふ。おちんちんの方は、とっても素直みたいだね？　――謝らな\nくていいよ、こっちの面倒もしっかりみてあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104111" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「お姉さんもそこまで経験豊富って訳じゃないけど……よしよし……いっぱい\n癒してあげるから、何も考えず気持ちよくなっちゃおう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んぅんんっ……こ、これは、思ったより大きいなぁ……あっ、んんっ……す\nごい、こんな簡単に奥まで届いちゃうんだ……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「どう、かな……？　わたしのおまんこの中、温かいかな？　身体ももっと強\nくぎゅーって抱きしめ合おっか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ぎゅ～♪　うふふ、やっぱりいいね、相手の体温を感じるのって。ただ肌を\n合わせてるだけなのに、すっごく安心してくるよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふふ、隊長くんってば、すごいリラックスした顔してるねー。視線でわか\nってたけど、さてはおっぱい大好き魔人だなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「――男なら当然？　わたしの爆乳で興奮しないはずがない？　おお……元気\nになってくれたのはいいけど、すごい勢いだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふふ、だから謝らなくていいよ……んんっ……君がわたしのおっぱいで癒\nされてくれるなら、お姉さんはそれが一番嬉しいんだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「もちろん、おちんちんの方も……んんっ、あっ、んぁんっ……ゆっくり腰を\nぐりぐりーって動かして、気持ちよくしてあげるね」", "NORMAL" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev336_01b_0000", "ev336_01b_0023", "true", "ALL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んぅんっ……このぐらいの動きで大丈夫？　おちんちん、痛\nかったり苦しかったりしない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「――ん、わかった、もう少し早くても大丈夫なんだね。じゃあどんどん行く\nから、好きなように気持ちよくなって癒されてね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んぅんんっ……こうやって、おまんこを使って、おちんちん\nシコシコ、シコシコ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「やっぱりこういうことを口にするのは恥ずかしいけど……うふふ、隊長くん\nが喜んでくれるなら、恥ずかしいけど続けてあげちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「わたしも……んぅんんっ……もっとおまんこぎゅ～ってするからね、いっぱ\nい抱きしめ合って、一緒に気持ちよくなろう……あっ、んんっん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、くっ、んんぅんっ……隊長くんの吐息が荒くなって、胸の中でふーふ\nーされるの、くすぐったいけど、ちょっと気持ちいいかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104125" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んぅんっ……あっ、あぁんっ……うふふ、ほら、また頭もなでなで、なでな\nで～。いい子いい子、隊長くんはいつも頑張っててえらいねー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「だからいいの、隊長くんはわたしに甘えて気持ちよくなっていいの……あっ\n、んぅんっ……いっぱい気持ちよくなれば、また頑張れるから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんんっ……今はストレスとかぜーんぶ忘れて、お姉さん\nの胸の中で甘えちゃおうねー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んぅんんっ……！　す、すごい、おちんちんまだこんなに大きくできるんだ\n……あっ、んぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「大きすぎて、抜き差しすると括れのところが色んな所をひっかいてっ……あ\nっ、あぁんっ……！　うふふ、お姉さんもすごく気持ちよくなっちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ああ、かわいいなぁ、ほんとかわいいなぁ……胸の中で気持ちよすぎてヒク\nヒクしてる隊長くん、ドロドロになるまで甘やかしてあげたいなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんんっ……でも、そろそろ出しちゃいそうなんだよね？\n　おちんちん、ずっとビクビクしちゃってるもんね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104132" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「いいよ、このままわたしのおまんこに出しちゃおう。普段の疲れと一緒に、\nびゅーびゅーってわたしの膣内に全部吐き出しちゃえ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんんっ……！　うん、わたしもイクよ、一緒にイクから\nねっ！　あっ、んあぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104134" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んんぅんんっ……！　うふ、うふふふ……！　隊長くんのせーえき出てるっ\n、わたしのおまんこにドクドクってっ……あっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104135" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あぁんっ……！　どうしたの、いきなりおっぱいに吸い付いたりして。もし\nかして隊長くんは赤ちゃんなのかなー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふふ、うそうそ。いいよ、そうやって甘えて癒されるなら、わたしのおっ\nぱい、好きにしちゃえ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あぁんっ……よしよし、いい子いい子……あぁ……隊長くん\nは本当に可愛いなぁ……これ、癖になっちゃうかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「でも、そろそろ射精も終わりかな？　最後におまんこ、ぎゅーってしてあげ\nるから、全部出し切っちゃおうねー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んんっ……はい、よくできましたー。うふふ、わたしのおまんこ、精液です\nごい事になっちゃってる……いっぱい出して偉い偉い、だね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104140" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ああでも……んんっ……おちんちんはまだ固いままなんだね……それに私も\n……あぁんっ……ちょっと物足りない、かも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「全部隊長くんのせいなんだから……必死にわたしのおっぱいに顔を埋めて、\n甘える姿なんて見せられちゃったら、わたし、わたし…………っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ああ、やっぱり我慢なんて無理だよ！　お姉さんがもっと甘えさせてあげる\n！　頭の中がドロドロにとけるまで、もっともっと癒してあげるからね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんんっ！　ほら、おちんちんはやる気満々だもんね！　\nこうやって連続でしたって、ついてきてくれるよね……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104204" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev336_01b_0000", "ev336_01b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んぁんっ！　あっ、あぁんんっ……！　うふふ、かわいい、かわいいよぉ隊\n長くん！　もっと私に甘えて？　お姉さんが受け止めてあげるから！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「どうしたの、さっきから顔が真っ赤だよ？　――抱きしめが強すぎて流石に\n息苦しい？　私の爆乳の中で窒息しそう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「でもでもぉ……それが嬉しいんだよね？　だってさっきから……あぁんっ…\n…！　おちんちん、信じられないぐらいに固く逞しくなってるもん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「生存本能ってやつだね……！　苦しいけど気持ちいでしょ！　わたしも赤ち\nゃんの部屋までガンガン突かれるの、ちょっと苦しいけどっ、あぁんっ！", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「すごく気持ちいいもん……！　だからまた一緒に気持ちよくなろ、いっぱい\n癒されよ！　あっ、んんっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「これぇ、ほんとにすごいっ……！　おちんちん固すぎて、おまんこのどこに\n当たっても気持ちいいっ、あっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「こうやって腰をぐいぐいって押し付けるっ……んあぁんっ！　赤ちゃんの部\n屋、潰されるぐらい押し上げられるのいいっ！　気持ちいいよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふふ、隊長くん、さっきからわたしの胸の中で必死にもがいてるね？　息\nが出来なくて苦しい？　でも我慢、もうちょっとだけ我慢だよー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「いっぱいいっぱい我慢して……我慢して我慢して……最後にぱーって吐き出\nすのが、いっちばん気持ちいいからねー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふふ、そうよね、隊長くんはやればできる子だよね。我慢できて偉い、い\nい子いい子～、よしよし～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんんっ！　だけどわたしも、そろそろやばい、かもぉ…\n…！　あっ、くぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104215" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「最後はまた一緒にイこうね！　わたしが合図を出すから、一緒にぜーんぶ爆\n発させて、頭がまっしろになるまで気持ちよくなろうね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んあぁんっ……！　すごい、隊長くんからもそんな力強くぎゅーってくるな\nんてっ……あっ、んやぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「おちんちんの勢いすご過ぎてっ、わたしのおまんこ、隊長くんの専用の形に\n変わっちゃうかもぉ……！　あっ、ひっ、ひゃうんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「来る、大きいのが来るっ……！　お姉さんもう限界、だからっ……！　出し\nてっ、さっきみたいにせーえきびゅーびゅーって出して……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104219" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「イク、イクイク、イッくぅぅんんっ……！　胸の中に隊長くんを抱きしめた\nままイっちゃううぅんんっ～～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふっ、うふふふっ……また出てる、隊長くんの熱々せーえきが、私の赤ち\nゃんの部屋に流れ込んできてるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんんっ……！　すごいっ、気持ちよすぎてわたしも溶けちゃいそ\nう……隊長くんの身体、あったかいぃ……んぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「あぁ、隊長くん、ほんとにかわいいなぁ……お姉さんにもっと甘えて？　隊\n長くんの全部を包み込んであげるからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104303" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んんぅんっ……あっ、あぁんっ……まだ出てるっ……わたしの赤ちゃんの部\n屋、せーえきでもうパンパンなにの、それでも出てるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んぅんっ……今度こそ、最後の一滴まで搾り取ってあげるか\nらね……うふふ、玉の中が空っぽになるまで出し切っちゃえ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ああ……おまんこからいっぱい、流れ出して行っちゃう……折角隊長くんが\n頑張って出してくれたのに、もったいないなぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んんっ……流石にそろそろお終い、かな……？　わたしのおまんこ、どうだ\nったかな？　いっぱい癒されて、気持ちよくなってくれた？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「……あら、隊長くん？　なんか顔が赤いというか、赤黒いというか……！　\nって、酸欠！？　わわっ、強く抱きしめ過ぎた！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ごめんね！　もっと優しく癒してあげればよかったね！？　というか、わた\nしの言葉とどいてる？　これ、本気でダメかも……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104309" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「私のおっぱいの中で死なないで隊長くーん！　しかもちょっと嬉しそうな顔\nで意識を飛ばすのはやめてー！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ……！　ああダメ、最後におちんちん抜けちゃったぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あぁんんっ……！　でも、これはこれでいいかもっ……隊長\nくんのせーえき、勢い良すぎて、顔まで届いてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふふ、全身せーえきでドロドロにされちゃうね。まるでマーキング……わ\nたしの全部を隊長くんのモノにされちゃったみたい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104403" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ああ、まだ出てるっ……あっ、んぅんっ……！　すごい匂い……頭くらくら\nして……この匂いだけでも、わたしまた、イっちゃうかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104404" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「んぅんんっ……！　今度こそ、全部出し切ってね……わたしの身体で好きな\nだけ気持ちよくなって、癒されてね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……んんっ……流石にもう出ないかな？　うふふ、ほんと\nにいっぱい出したねー？　いい子いい子」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「ん？　褒められるようなことじゃないって？　そんなことないよ、これは全\n部、隊長くんが頑張った証。だからいい子いい子、だよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00033601_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「うふふ、わたしと一緒に居たらだめになっちゃいそう？　大丈夫、そうなっ\nたらわたしがお尻を叩いて、かっこいい隊長くんに戻してあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「だから……これからも、何かつらいことがあったら、わたしのこと、頼って\nくれていいんだからね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_336_0104409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "イナミ" ]},
		{"command":[ "SETTEXT", "「お姉さんに、まっかせなさい。あなたの全部を守ってあげる、癒してあげる\n。だから……末永く、よろしくね、わたしだけの隊長くん♪」", "NORMAL" ]},

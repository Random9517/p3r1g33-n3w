{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なんです、仕事上がりに呼び出したりなんかして。ウチ、早く着替えたいん\nですが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704101" ]},
		{"command":[ "SETCHARA", "0", "char_00000527_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もう、イースターエッグを配ってるときから男たちの視線が煩わしくて……\nこんな格好してるだけで、じろじろと見てきて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704102" ]},
		{"command":[ "SETCHARA", "0", "char_00000527_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「まったく、近年はその意味が薄れてきているのかもしれませんが、本来復活\n祭はもっと厳かなものなのに」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704103" ]},
		{"command":[ "SETCHARA", "0", "char_00000527_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「それもこれもあなたがこんな服を用意したからですよ。聞いているのですか\n？　って、その手は何です――きゃあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704104" ]},
		{"command":[ "SETCHARA", "0", "char_00000527_01", "9", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ちょっと、なにをするんですか、んっ、ああっ、こんな、こんな格好で……\nううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},		
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こうすると、本当のウサギみたいって……うううう、うるさいです。さっさ\nと離れ……ひあっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オチンチン、押しつけたら、ダメ……です……んんっ、ふっ……あの、まさ\nか、まさかですけど、このまま挿入するつもり……ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んくううううっ、入って、来た……んっ、はっ、ああっ、あんっ、んっ、ん\nんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウサギのウチを抱いてるみたいで可愛いって、今言うような言葉じゃないで\nす、んっ、ふうっ、奥、ごりごりしたら、ダメ……です、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、ああっ、あんっ、んっ、後ろから、入れられたら……ふううっ、なん\nだか、動物の交尾みたいです、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あなたから見た今のウチはウサギって……んっ、ふうっ、格好だけで、そん\nな風に思うなんて……んんっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、ふっ、オチンチンが、中を……んっ、ふっ、ううっ、ウチが小さい\nから締めつけるって、そんなこと言わなくていいです、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「本当に、あなたはデリカシーがない……せめてもっと、ウチを喜ばせてくれ\nたら……ウチだってもっと素直に……あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「じゃあ喜ばせてやるって、なにを……ひあっ、あっ、そこは、お尻……んん\nんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「イースターエッグのプレゼントって……これのどこが、本当にデリカシーが\nない……んくうっ、んっ、あっ、入れないで……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふうううううっ、んっ、ううっ……バカ、バカバカバカ！！　ウチになんて\nことをするんです……んんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「スイッチを入れたら、ひああああっ、お尻の中、うううううっ、刺激され…\n…ひっ、あっ、あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なにか、なにか、変……ふううっ、あっ、あんっ、うっ、オチンチン、動か\nさないで……ふうううっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「中が喜んでるって、嘘、嘘です、こんな、ウチがお尻でなんて……んんっ、\nふあっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オチンチンがぎゅうぎゅうに締めつけられてるって、んくううっ、だって、\nお尻にモノが入れられたら……ひあああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ローター、強くしないで、んくうっ、んっ……はっ、あっ、オマンコとお尻\n、両方かき混ぜられたら……あうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「頭の中、ぐちゃぐちゃになっちゃう、です……んっ、ふっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あうううううっ、オチンチンが、ごりごりって、中をこすって……ひうっ、\nあっ、ローターがお尻の中で震えて……うくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「どっち、どっちが気持ちいいって、そんな……はっ、あっ、そんなの、知ら\nない、知らないです……んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はっきり言わないとダメって、なんで……ふうううっ、そんなの……んんっ\n、分からない、です、こんなの初めて……あうっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「じゃあ、分かるまで続けるって……んっ、ふっ、あんっ、あっ、あっあっあ\nっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オチンチンとローターが、お腹越しに刺激して……ふううううっ、あっ、ん\nっ、これ、ダメ……ダメです……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なにか、おかしくなっちゃう……ふううううっ、頭の中まで、かき回されて\nる……ふうああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチ……ウチ……そんな女じゃないのに、オチンチンと、ローターのことし\nか考えられなくなってくる、んっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オマンコの奥、ごりゅごりゅするの、ダメ……んっ、ふっ……あああああっ\n、ローター、強くされたら……ふうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「どっちも、どっちも気持ちいいです！！　オチンチンとローター、どっちも\n気持ちいい！！　ふあああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704131" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、両方で、そんなに激しくされたら……ああっ、あっ、あっ、\nイく、イっちゃう、ウチ、イっちゃう、です……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んふううっ、お腹、かき回されてイっちゃう……はあっ、あっ、あっ、オチ\nンチン、オマンコの中で膨らんで……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ローターもお尻の中で暴れて……ああっ、あっ、もう、ダメ……本当に、ダ\nメっ、イく、イく、イっく、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「イっくううううううううううううううううううっ！！　ふああああああああ\nあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ああああああっ、オマンコに、精液出てる……んっ、はっ、あああっ、んっ\n！！　お腹越しに、ローターで混ぜられてる……ふあっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あふううううううっ、オマンコの中、溶かされてる……あなたの精液で、ど\nろどろに溶かされてる……んっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はっ……あっ……凄い、んっ、まだ出てる……こんなの、ウチ……こんなの\n出されたら……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「気持ちよすぎて……なにも考えられなくなっちゃう……オチンチンとロータ\nーで……バカになっちゃったです……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「最後の一滴まで、ウチの中に注いで……ふあっ、あっ……気持ちいい……出\nされるのだけで、気持ちいいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ……出したのに、まだ硬い……んあっ、はっ、あんっ、ローター、ま\nた強くして……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もう一回、したいんです？　いいですよ……ふふ……ウチも、あなたにもっ\nと気持ちよくしてもらいたいです……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、はっ、あっ……お腹の奥、ごりごりってされるの……好き。あんっ\n、ああっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ローター、また強くしたら……んくうううううっ、オチンチンと一緒に、お\n腹が……んっ、ああっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オチンチンの動きと、ローターの振動が合わさって……ふうううっ、お腹の\n中、かき混ぜられてる……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んふうっ、あなたは、気持ちいい、ですか？　ふふっ、顔が見えないから…\n…んっ、あっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オチンチンの動きで答えないでください……バカ……でも気持ちいいのは伝\nわってきました……あんっ、あっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふうううっ、んっ、ウサギのウチを後ろからするのがそんなにいいのです？\n　んっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチちいさいから、全部抱きしめられる感じがするって……んっ、なんだか\n、あなたに食べられてるみたいです……んんっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んくうっ、んっ、ふっ……オチンチンが、中でびくんって、あんっ、ロータ\nーに合わせて、動かないで……んんっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こうしたら中がきゅっきゅって締まるって、もう、エッチな人です……んっ\n、ふうっ、こう？　こうです？　んんっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふっ、顔は見えないけど、オチンチンが震えて気持ちよくなってるのは分\nかります……んっ、はあっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704212" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、でも、オマンコの中、締めつけたらあなたの形がしっかり分かって…\n…そこをローターで刺激されたら……んんっ、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「また……またイきそうになってきました。あなたのオチンチンとローターで\n、お腹がどろどろになって……んくうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、あっあっあっ、凄い、熱くなって……ふううっ、あっ、あん\nっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチの奥、あなたのオチンチンの先端に……んっ、吸いついてるの、わかる\nです？　あなたを離したくないって……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、ほら、奥が、またあなたの精液欲しいって、オチンチンとロ\nーターで蕩かされたウチの中が……んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あなたの精液、また欲しいって絡みついて……んっ、あっ、あんっ、イく、\nイく、またあなたのオチンチンで、イっく、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はああっ、あなたも、イきそうなの、分かるです、ふあっ、ああっ、いいで\nすよ、一緒に、また一緒に、イきましょう、あああっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、イっく、イっく、あなたのオチンチンと、ローターで、また、イっく\nううううううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704220" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あくううううううっ！！　んんっ、中に、精液が……また、一杯……ウチの\n中を満たしてる……です……んくうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、はっ、あっ……出されてるのが、ローターで震えて……んっ、かき混\nぜられて……んんっ、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「お腹の中、ぐじゅぐじゅになってます……んっ、ふうっ、んんっ、入り口か\nら奥まで、あなたに溶かされてる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んくっ、あっ、んっ……最後の一滴まで、ウチの中に……んっ、ふっ……嬉\nしい……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチの中もきゅっきゅって締めつけてるの、分かるです？　あんっ、もうオ\nチンチンで返事しないで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふううううっ……んっ、あっ、オチンチン、まだ中で熱い……んっ、ふうう\nうっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ローターをイースターエッグとかいうの、本当にバカですけど……でも、気\n持ちよかったです。ふふ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「知ってますか、イースターのバニーは多産、繁栄を示してるらしいですよ。\n卵と多産……です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ねえ……ウチ、イースターバニーになぞらえて、いっぱいいっぱいあなたの\n子を産みたいです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「だから……ふふ、またこんな風に、たくさん中に出してくださいね。ウチに\n子供を産ませてくださいね、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、オチンチン、抜けて……ふあああっ、あっ、ウチの身体に…\n…んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「お尻と、背中……熱い……んっ、ふっ、あっ、びゅるびゅるって、精液がか\nかってる……ふううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704402" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、こんなにかけられたら、服の匂いが取れない……んっ、服ど\nころか、肌も……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もう、あなたは……なんでそういうところで独占欲を出すのですか……どう\nせ自分の匂いをウチにすり込むとか、そういうことでしょう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そんなことしなくても、ウチはもう……いえ、なんでもないです。たしかに\n、こんなにかけられたら匂いだけでウチがあなたの恋人だってわかります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んふうっ……背中、火傷しそうです……んっ、可愛らしいウサギにひどいこ\nとをしますね、あなたは。ふふ、冗談です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ……全部出して満足しましたか？　ウチも気持ちよかったですよ……ん\nうっ、んんっ。あなたも気持ちよかったの、分かります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「これだけ出されたら、分かるに決まってます……ウチの身体全部にぶっかけ\nるような勢いです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000527_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「でも日が経ったらまた匂いも消えちゃうですよ。どうします？　ねえ、そう\nなったらどうしますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2704409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふっ、そうですね、またオチンチンでウチにしっかりとしるしをつけても\nらわないと……だから、また呼んでくれるの、待ってますよ」", "NORMAL" ]},

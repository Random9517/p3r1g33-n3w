		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ぬとぬとのピストンっ、あんっ、また……気持ちよくなっちゃうからぁ……\nはっ、んふぁっ、あっ、あぁんっ……♪」", "NORMAL" ]},

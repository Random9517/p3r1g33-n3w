		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「もっと下品におまんこ突き出して……おちんちん、悦んでもらえるように腰\n……回しちゃうわねぇっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんっ、はんっ、あっ、うんっ……いいわぁっ、お日様の下でっ、いっぱい\nおまんこしちゃうのっ、あんっ、んぁんっ♪」", "NORMAL" ]},

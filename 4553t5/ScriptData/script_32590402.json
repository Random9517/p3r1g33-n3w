		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふぅぅ……ようやく、一息ついたわね。ピーク時の海の家が、こんなに忙し\nいなんて思わなかったわぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404101" ]},
		{"command":[ "SETCHARA", "0", "char_00025904_01", "4", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふふっ、どういたしまして。お役に立てたのなら何よりだわ。これでも主婦\n淫魔なんですもの。お料理も、接客も任せておきなさい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404102" ]},
		{"command":[ "SETCHARA", "0", "char_00025904_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「でもぉ、いくら勝負の対価としてもぉ……やっぱりタダ働きっていうのは、\nちょっと違うわよねえ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404103" ]},
		{"command":[ "SETCHARA", "0", "char_00025904_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ああ、もちろん後からそんな時給いくらなんてケチなことは言わないわぁ。\nふふっ、私はすこーしご褒美が欲しいだけなんだからぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404104" ]},
		{"command":[ "SETCHARA", "0", "char_00025904_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「もちろん、身体で支払ってもらうってこと……さっ、人気のないとこ……行\nきましょっか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふふぅ……ほぉら、ここなら……よっぽど覗き見したい人じゃない限り、\n大丈夫な岩陰だわ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404106" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あぁん……私、もう待ち切れない……だって、あなたのおちんちん……もう\n、すっかりおっきくなってるんだもの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404107" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「私がおまんこに欲しいって言ったから期待しちゃった？　慌てないでちゃん\nとサンオイルも塗ったから……ヌルヌルしてるでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ね、この水着……どう？　とってもセクシー？　ふふっ、ありがと♪　やっ\nぱり、これくらい大胆だと、視線も釘付けにできちゃうのよねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404109" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「でも、そうやって見られてるとぉ……サキュバスとしても、ムラムラしちゃ\nって仕方ないの……だからぁ、もう準備もここまで……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「入れちゃうわねぇ……はぁぁぁ……んっ、あっ、んふっ、くぅっ、んんんん\nんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404111" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あぁ……ほぉら、見える……？　あなたのおちんちんが……私のおまんこの\n中……ずっぽりハマっちゃいましたぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404112" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「こうやって、くぱって咥えこんでぇ……割れ目が広がってるおまんこ……よ\nく見える……？　お汁……トロトロでしょぉ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ずっと働いてて……その間もいっぱいナンパされちゃって……思わずお誘い\nに乗りそうになったことが何回もあったんだからねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「もちろん、私には愛する夫がいるんだからぁ……ちゃんとお断りしたわよぉ\n？　でも……このおちんちんは、また特別なのぉ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404115" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んっふ……！　はぁ……んっ、ずりずり……動かしちゃうわねぇ……♪　お\nまんこのヒダヒダ……いっぱいおちんちんと擦り合わせましょ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404116" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あっ、はぁんっ……そう……コレよぉ……ずっとコレが欲し\nかったのぉ……ぶっといおちんちんっ……ごちそうよぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404117" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「中で、ぷじゅってお汁が絡み合って……スケベな音ぉ、させちゃうんだから\nぁ……あひっ、はっ、あんっ、あひぃんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ほら……一番奥のとこまでぇ……おまんこの弱いとこ……しっかりおちんち\nんで突き上げてぇ……あぁん、そう、そこをこつってぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404119" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「はぁんっ、あっ、あぁんっ、カチカチのおちんちんっ、ずりゅずりゅっ、ず\nこずこっ、ぱこぱこしちゃうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「はんっ、あぁっ、腰が……勝手に動いちゃうわっ♪　私の……やらしい、腰\n振りダンスっ……いっぱい見てねぇっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あひっ、あんっ、あひんっ、あぁっ、こんなお外でっ、開放的な気分になっ\nちゃって……声がっ、声が出ちゃうぅんっ、あっ、あぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404122" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「はひっ……んふっ、おっぱいも……ぷるんぷるんさせちゃってるっ……オイ\nルでキラキラ光ってるボディ……もっと押し付けてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ずりゅって……おまんこ、扱きながらぁっ……太いおちんちん味わってる♪\n　ぶっといおちんちんっ、好きっ、大好きぃっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404124" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あぁんっ、そこぉっ、少し……ぐりって傾けたらっ、違うとこっ、また……\n当たってぇっ、あっ、あぁんっ、それ、上手ぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「やっぱりあなたのおちんちんじゃないとダメぇ……旦那さんのでも、これは\n無理なの……あなたのじゃないと味わえないのぉ……はぁん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あっ、はぁ……んんっ、あぁ……すごくっ、あなたの視線を感じるっ……♪\n　私がっ、エッチに乱れてるとこ……そんなに見たいのっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404127" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふっ、だって……止まらないんだもの……へこへこって腰振って……ずぽ\nっておまんこ音させるのぉ……病みつきになっちゃうのぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404128" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「はんっ、あぁっ、あぁ……もっとおちんちん食べさせてぇっ……ぬるぬるお\nまんこ、涎垂らしちゃってるからぁ……もっと、あぁんっ、そこぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404129" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ、あぁっ、気持ちいいっ、おまんこ気持ちいいわっ♪　このま\nま続けたらっ、もうすぐにイッちゃいそうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんっ、あぁっ、うんっ、イクっ……イクわっ、おまんこイキたいっ、あな\nたのおちんちんで……イカされちゃうのっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あなたもっ、そろそろ限界っ？　んっ、おちんちん出したくなってるっ？　\n精液……いっぱいびゅくびゅくしちゃいそ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404132" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふふっ……それなら、もちろん中出しよねぇ……♪　このぬるぬるおまんこ\nは……ずっと、あなたの精液待ってるからぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404133" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あぁっ……ほらっ、ここっ、ここよぉっ♪　奥に出してっ、淫魔を孕ませち\nゃう位に濃いのっ、いっぱいドピュって出してぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404134" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んぁぁぁぁぁぁーっ！　出てるわっ♪　ドロドロザーメンっ……濃いのがっ\n、子宮まで……届いてるぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404135" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_08" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「はぁぁん……熱いの……素敵よ♪　ビーチの開放感に……どぷって入ってく\nる背徳の味……たまらないわぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404136" ]},
		{"command":[ "SETIMAGE", "0", "still_00025904_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あふっ、おちんちん……ずっと震えてる……ドクドクって、おまんこの中で\n脈打ちながら射精してくれてるの……すごい……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あふっ、んっ……そろそろ、出し切りかしら……？　待ってね……もう一回\n、ぎゅって締め付けてぇ……搾っちゃうから♪」", "NORMAL" ]},

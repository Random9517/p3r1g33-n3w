		{"command":[ "SETIMAGE", "0", "still_00025904_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んっ……！　出てきた……はぁぁ……確かにお手伝いのお代……ちょうだい\nいたしましたぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふふ……お腹の中で、あなたの精子が泳いでるみたい……赤ちゃんできちゃ\nったら、どうしましょう……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんっ……あららぁ……♪　今ので、またおちんちん……おまんこの中でぴ\nくってしちゃった？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふふ……わたしを孕ませるってことに興奮しちゃったのかしら……まぁ、ホ\nントに妊娠するのは、ちょーっと難しいけどぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「でも、このやる気いっぱいのおちんちん……たーっぷり、おもてなしの続き\nしてあげちゃいまぁす♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0404203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あふっ、んっ、あっ、おっ、あぉっ、あんっ、あぉんっ♪　中……ドロドロ\nになって……いっぱい滑るようになったからぁ……♪」", "NORMAL" ]},

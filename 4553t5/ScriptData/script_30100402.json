		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「おまえさん、なんでわしに呼びだされたのかわかるよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404101" ]},
		{"command":[ "SETCHARA", "0", "char_00001004_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「そう、ずーっとわしの後ろ姿をみていたからだよ。どこを見てたんだい？　\nお尻？　それとも脚かねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404102" ]},
		{"command":[ "SETCHARA", "0", "char_00001004_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んー……？　おまえさんの視線は、お尻のほうに向いているようじゃな。こ\nのスカートの中が気になるのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ふふっ、その正直すぎる視線に応えてやろう。ほれ、よく見るのじゃぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404104" ]},
		{"command":[ "SETCHARA", "0", "char_00001004_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ほれっ。どうじゃ？　腰から尻、そして太ももにかけての、魅惑のラインの\n秘訣はこれじゃよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404105" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「このような服を着るときは、下着はつけぬものと相場がきまっておるからな\nぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「どうした？　驚いて声もでないか？　……声はでないようだが、ちんぽはず\nいぶんおしゃべりのようじゃな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「わしの姿に興奮して、ギンギンにそそり勃っているじゃないか……。このま\nま、わしにハメたそうじゃな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404108" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ここまでしている女が、おまえさんのちんぽを拒むと思うか？　ほれほれ、\nそのちんぽをハメてみろ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁあっ、んぅ……っ！　一気に、ちんぽが突き入れられて……っ！　まん\nこが……いっぱい、だ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404110" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「いつにもまして、ちんぽがぶっといね……。このまま、獣みたいに腰を打ち\nつけてくるつもりかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404111" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「あぁっ！　さっそく、きた……な……っ！　んっ、ああっ、ちんぽがまんこ\nを、んくっ、いきなり激しく……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404112" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、そんなにがっつかなくてもいいのに、んっ、わしのまんこが気\n持ちよくて、腰がとまらなくなったか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ふふんっ、男が自分の身体に夢中になってる様を見るのは、悪い気分じゃな\nいよ。あんっ、もっと、腰を動かしなよ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ちんぽ、くるっ、んんっ！　奥まで、届いているよ……っ！　ああっ、この\n体位は、いいね……んっ、本能が、刺激されるようでさ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404115" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「おまえさんは、どうだい？　わしのまんこに、ハメてみてさ。んっ、気持ち\nよくなってるかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404116" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、そうだね……っ、しっかりちんぽで、返事をしておくれよ、\nあんっ、そうやって、いっぱい突いて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、いいよ、んんっ！　若いちんぽが、まんこをかき回して……\nはぁ、はぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404118" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「おおきく膨らんでるカリが、中を……っ！　んんっ、ひっかいて抜けていく\n感じ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ああっ、ヒダをおしのけて、入ってくる感触もたまんないね……っ！　はぁ\nっ、はぁっ、気持ちいいよ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「気分も高揚して、まんこもたっぷり濡れているじゃろう？　んくっ、愛液が\nどんどん溢れてきている……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404121" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「熱く、うねって……おまえさんのちんぽにしっかり食らいつくまんこ……。\nはぁ、はぁ、たっぷり感じておくれよ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「あぁっ、んっ、はぁっ！！　大きな音が響くくらいに、腰をうちつけて……\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404123" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「そんなにしたら、ちんぽが子宮にまでとどくじゃないか……っ！　はぁっ、\nはぁっ、ずいぶんと発情しているようだね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ババアの子宮口に、これでもかってくらいにちんぽをうちつけて、んっ、こ\nのまま射精して、孕ませるつもりかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「そう思わせちまうくらいに、興奮させたのなら、んっ、わしとしても、嬉し\nいね……んっ、ふふっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404126" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「いいっ、いいよっ、そのまま腰を……ちんぽで、突きまくって……っ！　は\nぁっ、ああっ、わしも……気持ちいいからね……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404127" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「わしも、イキそうだよ……っ！　おまえさんに、んっ、ちんぽにイかされ…\n…る……っ！　はぁっ、はぁっ、ああ……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ペースをあげて、おまえさんも、イクんだね。ああ、いいよ、だしなよ、わ\nしの中に、おまえさんの精液……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404129" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ちんぽでずこずこ突きまくって、んはぁっ、ああっ、イク、わしも、イク…\n…んぁあっ、はぁっ、はぁっ、ああ……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ああぁっ！！　ああぁぁあぁ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404131" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「い、いいっ、でてる……っ！！　おまえさんの精液が、まんこに、注がれて\n……いる……ぅ……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、中でビクビクとちんぽが暴れて……っ！　熱い、精液……\nっ！　たくさんきてるの、感じるよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404133" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。イッたよ……わしも、おまえさんに中出しされて……イ\nッたぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「やっぱりいいねぇ……。精液を、子宮で受けとめる快感……。おまえさんも\n、びゅーっと精液を吐きだすのは気持ちいいだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ふふっ、正直だねぇ。気に入ったよ、もっとしようじゃないか。まだまだ、\nイけるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「少しからかってやるつもりだったが、もうちょっとおまえさんと交わってい\nたくなったんじゃよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「どうじゃ？　まだまだわしに付きあってくれるか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404138" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ふふっ、そのちんぽのようすだと、答えは『イエス』のようじゃな？　なに\n、遠慮する必要はない。わしとおまえさんの仲じゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404139" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ほれほれ、抜かずに２回戦といくぞ。さっきみたいに、しっかり腰をつかう\nんじゃぞ～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「……あぁあ！！　さっそく、きたな……っ！　んっ、んくっ、しっかり腰を\n、ああっ、ちんぽが深くまで刺さるように……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「い、いいっ！　１度イッたあとのまんこに、また……っ！　硬いままのちん\nぽで、ピストン……効くぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「ああ、気持ちいいぞ……わしも昂ぶった身体が抑えられん……っ！　はぁっ\n、はぁっ、おまえさんとともに、腰が動いてしまう……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404203" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「んっ、んふっ、わかるじゃろう？　ああっ、ちんぽを奥まで誘うように、お\nまえさんに腰を、押しつけてしまって……ああっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「まんこも、おまえさんのちんぽをしっかり締めつけている……っ、んっ、は\nぁ、はぁ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「おかげで、ちんぽの形をより感じて……んくっ、中をえぐるその形に、たく\nましさに……蕩けてしまいそうじゃ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、おまえさんも、腰がとまらぬか？　んっ、とめる必要など\nないじゃろ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404207" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「わしのまんこに、もっと夢中になって。んぁっ、ああっ、好きにそのちんぽ\nで、ずぼずぼ突きまくるがいい……っ、んっ、ああぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404208" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「そ、そうじゃ、はぁっ、はぁっ、ちんぽきて……んっぐぅっ！　ピストン、\n激しく……んぁっ、ああっ、ああ……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404209" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「いいっ、いいぞっ、まんこにくるっ、ああっ、ああっ、熱くて硬いちんぽ、\nまんこ全部に感じるぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、気持ちいい……っ！　気持ちよすぎて、腰が抜けそうじゃよ…\n…んぁっ、ああっ、んっぐぅううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404211" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「さらにちんぽが膨らんで、ああっ、ああっ、亀頭が……っ！！　わしの、子\n宮を……こじあけよう、と……ぉお……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「はぁっ、ああっ、イッくぅううぅぅっ！！　あっ、ああっ、おまえさんより\n、先に、イかされ……んぅうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404213" ]},
		{"command":[ "SETIMAGE", "0", "still_00001004_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ヘカテリーナ" ]},
		{"command":[ "SETTEXT", "「イッてるというのに、責めが、ちんぽが、とまらないぃっ！！　んひっ、ひ\nぃっ、イク、また、イキまくって……んはあぁっ、ああぁっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_010_0404214" ]},

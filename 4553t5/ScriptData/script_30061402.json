		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「でも……あっ、この……気持ちよさは……んっ、はぁっ、あぉっ、他の何に\nも代えがたい……快感ですっ、はひっ、あっ、ぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「は、はいっ、あぁっ、オチンチン好きです……んっ、わたしのオマンコは…\n…あなたのオチンチンをいっぱいに頬張って……悦んでいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「オチンチン好きっ、オチンチン大好きっ、オチンチン気持ちいいですっ、あ\nぁっ、オチンチン連呼っ、恥ずかしいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「でもっ、もう腰が止まりません……んっ、ふっ、もっと、あぁっ、もっと激\nしくぅっ、あっ、ぐりぐり……回しますぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、ぐちゅぐちゅっ、中のお汁が……かき回されてっ、はいっ、\nもっといやらしく腰を振りますわっ、あっ、あひぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「今の……ああっ、そこっ、あっ、よ、弱い所っ……！　あっ、乳首……ピン\nってっ……ここで……締め付けをっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「わ、分かりました……んっ、くぅぅぅんっ！　あっ、おぉっ！　今……オチ\nンチン締め付けたらっ、あひっ、オ、オマンコ……効くぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あんっ、はっ、はぁっ、あぁっ、これはっ……すごいですっ、あぁっ、中っ\n……あぁっ、オチンチン凄くてっ、オマンコっ、痺れてぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はっ、あぁっ、腰が止まらないですっ、はひっ、はいっ、気持ちいいっ！　\nオチンチン感じますっ、あぁっ、お、おっぱいもぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、はぁっ、オチンチンが……中で……ビクビクってっ、あっ、\nんふっ、あなたも……そろそろですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はいっ、私も……あっ、も、もうっ、かなり……ギリギリで……このまま、\nオマンコ……すぐにでもイキそうですっ、あひっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あぁっ、はいっ、分かりましたっ！　あと、もう少しだけ頑張って……ラス\nトスパートのオマンコピストン致しますっ……んくっ！」", "NORMAL" ]},

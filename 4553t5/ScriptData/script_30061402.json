		{"command":[ "SETIMAGE", "0", "still_00000614_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「んっ、ふっ、わたしの動きを……乳首でコントロールしようとするなんて…\n…あっ、いやらしいことばかり考えて……あ、ひっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「は、はい……こうして、ぎゅって乳首を摘まれたら……腰を振る合図っ、あ\nっ、ぉっ、あんっ、はぁんっ！」", "NORMAL" ]},

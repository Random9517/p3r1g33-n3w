		{"command":[ "SETIMAGE", "0", "still_00000614_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「この満足感……決して他で得られるものではありません……。ずっと味わっ\nていたい心地よさです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はぁ……堪能しました……と言いたいところですが、やっぱりこのオチンチ\nン……まだまだ、しっかりと硬いままです……すごいわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「んふっ、これは……もうちょっと頑張ってもらえるということでいいですね\n？　抜かずにセックスの続き……しちゃいましょう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はふっ、んんっ、もう動き始めちゃいましたから、すぐには止まりませんよ\n……あっ、んくぅっ、オマンコがジンジンします……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「イッたばかりのオマンコを……こんな風にかき混ぜると……あふっ、ずっと\n気持ちいい感覚が続いていて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「んっく、腰を振る度に……眼の前に火花がチリチリして……これまで経験し\nたことのない感覚です……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あっ、はい……おっぱいも……すごく敏感なままで……そうやって、乳首を\n押し潰されると……きゃふんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「もう……悪戯ばかりして……んっ、少しも飽きませんね……？　ずっと手を\n離さずに……おっぱいを揉みしだきっぱなしで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「わたしがオチンチンを抜かずにいるのと同じ……？　んふっ……そう言われ\nると、わたしも悪戯心が湧いてしまいますね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「こうして……んっ、ふっ、オチンチンを、ずっとオマンコで弄り続ける……\nんんっ、今のわたしだけができる贅沢な時間です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「もっといやらしく腰を回しますよ……んっ、んふぅんっ……あふっ、お尻の\n方から……繋がってるところ……見えますか？」", "NORMAL" ]},

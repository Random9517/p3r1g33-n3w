		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「んっ、ふはぁ……すごく濃いのがいっぱい出ましたね……ふふっ、こんなに\n注がれたら妊娠しても不思議はないですね……」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00000614_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「ピンって弾くのは……あっ、オマンコを締め付けるっ……んんっ、うぅんっ\n、こ、こうですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あっ、はぁっ、んんっ……あぁ……求められるままに……あっ、オマンコす\nるの……はんっ、恥ずかしい……」", "NORMAL" ]},

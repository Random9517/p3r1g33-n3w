		{"command":[ "SETIMAGE", "0", "still_00000614_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「こんなにぱっくりとオマンコを広げて……あぁっ、結合部から……ずっと涎\nを垂らし続けて……なんてはしたない真似を……」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00000614_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁっ、あひぁっ、あぁっ！　来るっ、来ちゃうっ、オマンコ……も\nうっ……オチンチンもっ、ギリギリでっ……！」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「でも、もう止まるわけがありません……こんな気持ちいいこと……最後まで\nやりきるまで、ずっと動きっぱなしです……あんっ！」", "NORMAL" ]},

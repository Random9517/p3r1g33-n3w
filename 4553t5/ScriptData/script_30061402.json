		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はふっ、んんっ、オチンチン……中で大きく……あぁっ、はい……動かしま\nすね……うんっ、ふっ、はっ、ぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はっ、あぁ……硬いのが……私の中でビクビク震えて……オマンコの襞を…\n…擦ってきます……んくぅん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「小刻みに腰を振ると……んっ、勝手に……オマンコがキュンと締まって……\nあひっ、オチンチン……気持ちいいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あっ……！　んんっ、乳首……コリコリって……んふっ、すぐ悪戯するんで\nすから……あんっ、引っ張られてるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「そんなおいたには、んっ、オマンコで……お返しをしないといけませんね…\n…あふっ、んっ、くぅっ、ぉっ、あっ、ぉんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「んぁっ！　くうんっ、ふふっ、どうですか……？　こうやって、ぐりぐり腰\nを回すと……オチンチンの色々なところに当たるでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「まだまだ、私のオマンコは本気を出していませんよ？　もっと、蕩けさせて\nあげますからねぇ……んふっ、はぁっ、うんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はっ、ふんっ、あっ、あんっ、身体……上下に揺すると……んんっ、おっぱ\nいがプルプル震えて……いやらしいですわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あんまり、揺れすぎないように……しっかり、抑えて貰わないと……はい、\nぎゅっと握りしめて……あんっ、また乳首ぃ……！」", "NORMAL" ]},

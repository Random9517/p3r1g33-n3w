		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁんっ……あぁっ、んっ、くぅぅんっ……太いの……あっ、入ってく\nる……んぅぅぅんっ……あ、ぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「はぁぁお……ふっ、これぇ……太い……あぁ……いきなりオマンコ……ずっ\nぷり広げられてます……は、ふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、はい……もちろん、おっぱいもお好きになさって……あなた\nの心ゆくまで……存分に揉みしだいて下さい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1404108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000614_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「んんっ、あんっ、ぎゅって……潰れちゃいます……んんっ、いえ……痛くな\nいです……もっと荒々しく揉んで、大丈夫ですから……」", "NORMAL" ]},

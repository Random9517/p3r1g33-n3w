		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "レディ・ホープ" ]},
		{"command":[ "SETTEXT", "「んぁぁぁぁぁぁぁっ！　出てっ……ますっ、あひっ、射精っ……始まって…\n…あひぁっ、オマンコ……熱いですっ！」", "NORMAL" ]},

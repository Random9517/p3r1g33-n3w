{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0209" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「先ほどは大変失礼しました……悪いことをするというアドバイスのもとでは\nありますが、先生にあのようなことを……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104101" ]},
		{"command":[ "SETCHARA", "0", "char_00032901_01", "5", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「悪いことをしたという自覚があるのは、とても良いことなのですか？　確か\nにそうですね。とても勉強になりました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104102" ]},
		{"command":[ "SETCHARA", "0", "char_00032901_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「もっと悪について知るには、罰を受ける必要があるのですか？　その……罰\nというのは、いったいどのような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104103" ]},
		{"command":[ "SETCHARA", "0", "char_00032901_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「きゃあぁぁっ！？　せ、先生っ！　いきなり腕を掴むだなんて……いったい\n何を……あっ、やぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104104" ]},
		{"command":[ "SETCHARA", "0", "char_00032901_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あっ……あっ……先生のおちんぽが、おまんこに当たってっ……んんっ！　\nどうしてこのようなことを……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104105" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「これが悪いことをした罰なのですか？　ですが、これは……せ、性行為では\nっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「い、いえっ。先生とするのがイヤというわけではありませんっ。ただ……こ\nれが罰になるのかと言われると、そうではない気がしておりまして」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「普通にするのは罰ではありませんが、こうして拘束をして無理やりするのは\n、罰に近いこと……なるほど。そう言われると、納得もできます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「世の中には勧善懲悪という言葉もあるくらいです……悪いことをしたら、そ\nの報いを受けるのは当然のこと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「先生……どうか悪事を働いた私に罰をお与えください……お、おちんぽで罰\nを……ひゃ、あぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ！　先生のが、お股で擦れてっ……はぅぅっ！　い、挿れるの\nではないのですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、はぁぁっ……悪い人は先ほどのように、卑猥なおねだりをす\nるものなのですね……くっ、あっ、はぐぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「で、ですが……私には卑猥な言葉というものがよく分かっておりません……\nどうか、ご指導いただけますでしょうか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「えっと……先生の言葉を復唱すればよいのですね？　で、では……復唱させ\nていただきます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104114" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「わ、私のいやらしい……お、おまんこに……先生の、た、たた……たくまし\nいおちんぽを挿れて、オ、オシオキをしてくださいませっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104115" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「力の限り締め付けて……おちんぽを気持ちよくして……罪を償わせさせてい\nただきますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ですから、どうか……悪事を働いた私にお咎めを……お、おちんぽでオシオ\nキいただきますよう、お願い申し上げますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はぅぅぅっ！　あっ、うっくっ！　先生のおちんぽが……お、奥まで入って\nきておりますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104118" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「私の膣内が広がってっ……ひゃ、はぅぅっ！　あっ、あっあっ！　んっ、あ\nっ！　だ、大事なところに先端が当たって……あっ、んぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「このような恰好なのに感じてしまいますっ……ふぁ、あっ……んっ、んぁっ\n！　ぐっ、うぅっ……あふっ、はふぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……！　挿れられている時も、ずっと卑猥なことを言わないい\nけないのですか……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「うぅっ……恥ずかしいですが、これも悪というものを知るため……そして、\n私が犯した罪を償うため……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「先生……どうか未熟な私にご指導を……お、おちんぽ……いえ、この太くて\nたくましいおちんぽで、おまんこをご指導くださいませっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104123" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あっ、あんんっ！　あっ、あっぐっ！　うっ、あぅっ！　…あんっ、あぁん\nっ！　あはぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104124" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「お、奥のところに……私の赤ちゃんの部屋の入口から、強い刺激が届いてお\nりますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「先生のカタいおちんぽが、大事なところを何度も突いてきてっ……ひゃ、や\nぁぁぁっ！　そんなの突かれたら、気持ちよくなってしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「これは罰なのに……私は悪いことをして、罪を償わなければならないのに…\n…先生のおちんぽで感じてっ……ひぐっ！　あっ、ひぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あんっ！　あぁっ！　んっ、んんっ、はぅっ！　んっ、くうぅっ！　んっ、\nふっ……うぅっ、あっ、はぁっ！　あっあっ、んひゃあぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104128" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「拘束されながら、無理やりおちんぽを挿れられておりますが……こ、これは\nもう子作りですっ！　罰ではありませんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「罰なのに感じて、悪い子……？　ひゃ、あっ！？　ダメです、先生っ……今\n、耳元でそのようなことを言われたらっ……んぐぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104130" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「お、奥のところの刺激と先生の甘いささやきが合わさり、おまんこが感じて\nっ……あっ！　あっ！　はぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104131" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「幸せな気持ちがおヘソの下のところに集まってきておりますっ……も、申し\n訳ありませんっ……私、達してしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はぅぅぅっ！？　こ、このまま膣内に出すのですかっ！？　そ、それでは本\n当に、赤ちゃんがっ……！　あっ、んぁっ！　ふはぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104133" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「罪を償うためにも、妊娠して欲しいだなんてっ……！　せ、先生との子供で\nしたら、罰になりませんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104134" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ！　いけませんっ、先生っ！　これは罰なのに、膣内出しはっ……\n！　んんっ！　ふっ、うぅっ！　んぅ～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104135" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はぁぁぁぁんっ！　先生の子種が、奥のところに出ておりますっ！　し、子\n宮の中にたくさん注がれてっ……あぐっ！　ふぐぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104136" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_07" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あ、赤ちゃんを孕ませながら、イッてしまいますっ！　あっあっ！　イクッ\n！　イキますっ！　おまんこイッてしまいますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ひっ、あぁぁっ！　んっ、んんっ！　うっ、うぐっ！　あっ、ふぁぁぁっ！\n　あっ、あっ、あっ！　んはぁぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はぁぁ……気持ち、いいですっ……私の身体、悦んでおりますっ……先生の\nお世継ぎを孕んでぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104139" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「罰なのに幸せですっ……！　先生……お、お慕いしておりますっ……！　だ\n、大好きですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はふっ……んっ、はぁぁぁっ……ご、ご指導……ありがとうございました…\n…」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ですが、これが罰でよろしいのでしょうか？　その……大変失礼なことなの\nですが、より悪という概念が分からなくなってまいりました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104202" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「世の中には様々な趣味、趣向をお持ちの方がいらっしゃいます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ですので、このようないやらしい罰を求めて、悪いことをするような方も居\nるのではないかと思い至りまして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「い、いえっ！　あくまでも、そういう方もいらっしゃるのではないかと言う\nだけで、もっとして欲しいという意味ではなく……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あっ……やぁぁっ！　せ、先生のおちんぽが、また大きく膨らんでっ……ま\n、またオシオキをされるのですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「んぅぅぅっ！　ぐっ、うぅぅっ！　おまんこの奥に、またおちんぽが届いて\nおりますっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あっ、やぁっ！　私の赤ちゃんの部屋の入口に、先生のたくましいモノが押\nし付けられてっ……ひっ、あっ！　あぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104208" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はぁ……ふっ、はふぅっ！　もう指導しなくても、卑猥な言葉遣いができる\nようになっただなんてっ……そ、そのようなことは……んひゃあぁ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「こ、これは、その……先生のおちんぽで刺激をされたら、勝手に口から出て\nしまって……！　わ、私の意思ではっ……ぐっ、あっくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「やっ、あっ！　んっ、んはぁ！　あっ、あぁ、はぁ、はぁぁっ！　あっ、あ\nっ、あぁ、奥っ、気持ちいいですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104211" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「このままでは、私……本当にダメになってしまいますっ……！　せ、先生の\nおちんぽがなければ、生きていけない身体になってしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104212" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「んひゃぁぁぁっ！？　あっ、あんんっ！　急に動きが速くっ……んっ！　ん\nんっ！　お、奥っ、激しく突かれておりますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104213" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ！　もう、気持ちいいことしか分かりませんっ！　善や悪の概念\nが、快感で塗りつぶされてっ……はぐっ！　んぁうぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ、あっ！　せ、先生っ……私、また限界が近くなってっ……！　\nこ、このままでは、イッてしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104215" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「せっかく先生にご指導いただいているのにっ……もっとおちんぽで、オシオ\nキしていただきたいのにっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ひっ！？　んぁっ、あっ！？　先生のおちんぽが、膣内で膨らんでっ……！\n？　先生も、達しそうなのですねっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104217" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ、ふぁぁぁっ！　ど、どうぞ、お好きなところにお出しください\nっ！　先生の子種でしたら、悦んで受け止めさせていただきますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104218" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「どうか私に精液でオシオキをっ……悪事を働いたこの身に、罰をお与えくだ\nさいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あんっ！　あっあっ！　イクッ……イクッ……！　もう、限界ですっ！　お\n、おまんこ、イッてしまいますぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104220" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あんっ！　んんんっ！　せ、先生の子種が、また奥にっ……私の子宮に注が\nれておりますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「こ、これでは、本当に妊娠してっ……先生の赤ちゃんを孕んでしまいますっ\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あっ、やっ！　あっ！　こ、これは罰なのにっ……先生の子供を孕めるだな\nんて、とても幸せですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104303" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ひゃ、うぅぅっ！　ま、まだ出ておりますっ……もうお腹の中、いっぱいな\nのにっ……んんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「せ、先生っ……もっとオシオキしてくださいませっ！　先生の子種でお世継\nぎを……あ、赤ちゃんを孕ませてくださいませぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「んっ……んぁぁっ……お腹が膨らみそうなくらい、おまんこが精液で満ちて\nおりますっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104306" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ふふっ……このようなオシオキなら、本当に何度でも受けたくなってしまい\nますね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「これでは、とても罰とは呼べませんし……この快感を得るために、私も悪事\nを働いてしまうやもしれません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「それはさすがに冗談ですが、本当にそのような方が居ることも否定はできま\nせん」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「人は何のために悪事を働くのか……これからも先生のもとで勉強をして、様\n々なことを学びたいと思います」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「きゃ、あぁっ！？　先生のおちんぽが抜けて……こ、子種が胸に飛び散って\nおりますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「それに顔にも飛んできてっ……はぅぅっ！　この匂いっ……あ、頭が真っ白\nになってしまいますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104402" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「あっ、あっ……いけませんっ……先生の子種の香りで、また達してっ……あ\nっあっ、あっ、んぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「イクッ……イクッ！　精液をかけられながら、またイッてしまいますぅぅぅ\nっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104404" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「んっ……あぅ……先生っ……２回目のご指導、ありがとうございました……\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104405" ]},
		{"command":[ "SETIMAGE", "0", "still_00032901_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「今回のことで分かったことは……私には悪を演じることは難しいということ\nです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「そして、善や悪はそう簡単に割り切れるものではない……人の心の在り方次\n第だと気づかされました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「ふふっ……それにしても、このように気持ちのいいオシオキは、罰とは呼べ\nませんね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「えっ？　そうとは限らないのですか？　それはどういう意味なのでしょう？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "サクラ" ]},
		{"command":[ "SETTEXT", "「なるほど……このオシオキで幸せな気持ちを覚え、悪事を働かなくなる可能\n性もあると……確かに、そういった考え方もあるかもしれませんね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_329_0104410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「来たわね、ダーリン。ねえ、今のダイヤナちゃんを見てなにか気づくことは\nない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603101" ]},
		{"command":[ "SETCHARA", "0", "char_00000616_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「分からないって……そういうところは相変わらずなのね、もう。サキュバス\nよサキュバス！！　今のダイヤナちゃんはサキュバスなの！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603102" ]},
		{"command":[ "SETCHARA", "0", "char_00000616_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「見れば分かるって……だったら、あたしが次にすることも分かるわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603103" ]},
		{"command":[ "SETCHARA", "0", "char_00000616_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「えいっ！！　ふふふ、凄い格好ね。なにをって……分かってるんでしょう？\n　ダイヤナちゃんがサキュバスなんだから、することは一つじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603104" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「お腹がすいたから、ダーリンの精液を出してもらうのよ～。サキュバスのご\nはんは精液なんだから当然でしょう～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「え、それはコスプレだって？　もう、分かってないわねえ。女は装いで変わ\nるものなのよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「サキュバスの格好をしているダイヤナちゃんは、心もサキュバスになるの。\n大体、ダーリンも悪いんだからね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「いつもいつもダイヤナちゃんの身体をじっと見つめて……そんな目で見られ\nたら、発情しちゃうでしょ。だから、ダーリンも悪いの！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「だから大人しくダイヤナちゃんに精液を捧げなさ～い！！　ふふっ、いい格\n好ね。ダーリンのそんな姿も素敵よ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ、暴れちゃダメ！！　ダメだってば！！　もう、言うこと聞かない子\nはこうしてあげる。んむっ……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふうっ、んっ、んううっ……ふふっ、どう？　ここを舐められるの、気持\nちいいでしょう～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それで同時におちんちんをしごいたら……んっ、むっ、んんっ、れるっ……\nんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ、ダーリンの身体、びくびくしてきてるわ～。顔も蕩けてきてる。ふ\nふっ、それに……ねえ、背中のほう、意識してみて～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ね、ダイヤナちゃんの大きなおっぱい、ダーリンにくっついてるの、わかる\nでしょう？　柔らかくて、大きくて、ふかふかの……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「やんっ、おちんちん、それだけで震えちゃってる。かわいい～。あたしのお\nっぱい、気持ちいい？　好き？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふふっ、その格好で頷いてる～。会うたびにダイヤナちゃんのおっぱい見て\nたもんねえ？　ばれてないと思ったの～？　丸わかりなんだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「じゃあ、おっぱい押しつけながら……んんっ、むっ、れるっ、んっ……ふう\nっ、ほら、舐められるのと、おちんちんしごくのと、どっちがいい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほらダーリン、ちゃんと答えて～？　舐められるのとしごかれるの、どっち\nがいいの？　言わないとやめちゃうわよ～。ほらほら～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「全部？　おっぱいもお尻もおちんちんも全部って……もう、ダーリンってば\n欲張りさんね。でも、そういうところも好きだけど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「うふふ、だったら張り切ってしてあげるわね～。んむっ、れろっ、んっ……\nふうっ、ふっ、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「おちんちん、すっごく熱くなってるわ～。やけどしそう……んっ、んうっ、\nれるっ……ふふっ、先っぽからお汁がでてきてる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふっ、おっぱいが当たってる場所も熱くなってて……全身ほっかほかにな\nってるわね～。顔も緩みっぱなしよ～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こんな格好してるのに、気持ちよさそうに蕩けちゃって～。もっともっとお\n汁を出しなさ～い。ダイヤナちゃんのために、ほらほら～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「お尻も舐めてあげるから～。んうっ、れるっ、ちゅっ、れろっ、れろれろれ\nろっ！！　ふふっ、舌が動くたびにびくびく動いてる～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっんっんっ……れるっ……ちゅっ……ほら、舐めながらしこしこしてたら\n、もうおちんちんがぱんぱんになってるわね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「先端からもお汁がだくだくになって、ほら見て。ダーリンのお腹、先っぽか\nらのお汁で濡れてきてる……うふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「女の子にひっくり返されて、おっぱい押しつけられて、お尻舐められて、し\nこしこされて……それでこんなに気持ちよさそうな顔になって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「うふふ、ぞくぞくしちゃう～！！　ダーリンのこんな顔、あたししか見られ\nないのよね～！！　ほら、ほらほら！！　もっと気持ちよくなって～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっ、むっ、れるっ、れろっ……舌を動かすたびに身体を震わせて、切なそ\nうな顔になって……んむっ、りゅっ、れるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「おちんちんもパンパンに張りつめさせて、ふふ……おちんちんもお腹もお汁\nでどろどろにして……いいわ、いい顔だわ～！！　ダーリン！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603130" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「うふふ、そろそろ出したくなってきてるのね……いいわ、いいわよ～！！　\n私の舌と手で、いっぱい精液出して。それじゃあ……んむっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「れろれろれろっ！！　んむっ、れるっ、ちゅっ……んんんっ！！　ふあああ\nあっ、あっ、出たっ！！　出てきた！！　ダーリンの精液っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「いいっ、いいわよダーリン！！　こんなに沢山、ダイヤナちゃんの舌と手で\n出してくれてっ！！　うふふふふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「自分で自分のお腹どろどろに汚して、切なそうな顔して！！　あははははっ\n！！　そんなに気持ちよかったのね～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んっ……あんっ、あたしもちょっと、濡れてきちゃった……ふふ、ダーリン\nがいけないのよ。そんなに気持ちよさそうにするから……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それにこんなにたっぷり出して……匂いも凄い……あたしで気持ちよくなっ\nてくれたのね……嬉しいわ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603136" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「うふふ……いつものダーリンと違う姿だから、なんだかぞくぞくするわね～\n。こういうダーリンも悪くないかも？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「なぁに、その顔？　反論したいけど、気持ちよすぎてなにも言えないって…\n…あはは、ダーリンってそういうの素直よね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「おっぱいと、手と、舌と。ダイヤナちゃんが全身で気持ちよくしてあげたん\nだから、当然よね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「言っておくけど、ダーリン以外の誰にもこんなことしないんだからね？　そ\nれはちゃんと理解しておいてよね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「一回出したのにまだ大きいままね～。もう一回したい？　出したい？　いい\nわよ～。ダイヤナちゃんからご褒美をあげる～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「うふふ、さっきのでダーリンの弱いところは分かってるから……れろっ、れ\nるっ……んっ、んむっ……舌でこうやったら……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほら、硬くなってきた～。おちんちん、また気持ちいいって、ダイヤナちゃ\nんにいっぱいいっぱいしこしこしてほしいって、硬くなってきてるわ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それじゃあ、またこうしておっぱい押しつけて、しこしこして、それで舌で\n……んむっ、れるっ、れろっ……ふうっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こうして舌でかき回したら……れるっ、りゅっ……ふふふ、ほらね～。ダー\nリンのおちんちん、もうギンギンになって、またお汁が出てきてる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ほら、気持ちいいって、ダーリンの口から言いなさい。言って。でないと続\nきしてあげないわよ～？　ほら、ほら～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あははははっ、そんな即答で言うなんて、よっぽどダイヤナちゃんが気持ち\nいいのね～。いいわ、じゃあ、れるっ、れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ちゅっ、れるっ、れろれろれろっ！！　んふうっ、もうダーリンのお尻、ふ\nやけちゃってるわね～。あたしの唾液でべとべとだし～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふううっ、れるっ、れろっ、んっ……ふふ、おちんちんが熱くなって……\nね、このまま出したらまたお腹が汚れちゃうわよ～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「自分の精液でお腹をどろどろにして、そのままもう一回おちんちんしこしこ\nして、どろどろのまま気持ちよさそうにあたしの顔を見つめて……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「いいっ！！　いいわダーリン！！　素敵！！　ぞくぞくしちゃう～！！　ダ\nーリンはあたしのものって実感が沸いてくるわ～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「うふふふ、ご褒美にもう一回イかせてあげるわね～。おっぱいと、手と、舌\nでダーリンの身体をどろどろにしちゃうんだから～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603212" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「れろっ、ちゅっ、んっ、れるっ、んむっ、んんっ……ふっ、また手のひらが\n熱くなってきたわ～。ねえ、聞こえるでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603213" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んむっ、れるっ、んっ……口から出てるじゅるじゅるって音と、手のひらか\nら聞こえるにちゅにちゅって音……んっ、むっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ね、これがダイヤナちゃんがダーリンを気持ちよくしてあげてる音よ。んむ\nうっ、んっ、れろれろれろっ、んっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あたしがダーリンだけを愛している音……ほら、耳を澄ませて……ね？　れ\nるっ、ちゅっ、んむううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふふふっ、おちんちんぱんぱんになってきたわ～！！　イくのね？　イきた\nいのね～？　いいわ、許可してあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「このダイヤナちゃんが、許可してあげる～。ダーリンがこんな格好で、あた\nしにしこしこされて、お尻を舐められて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「気持ちよくなって、蕩けた顔になって、あたしのこと見つめながら切なそう\nな表情を浮かべて、うふふふふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「いいわ～！！　イっていいわよ～！！　ダーリン、イって！！　イきなさい\nっ！！　ダイヤナちゃんの手で、舌で、んむっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603220" ]},
		{"command":[ "WAITINPUT" ]},
																					
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んんんんんっ！！　んむうううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふふふふっ、またいっぱい出したわねえ～。ダーリンのお腹、真っ白けに\nなっちゃってるわ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「どろどろになった精液がお腹の中で溜まってて……匂いも凄いわ～。このま\nま外に出たら、皆が絶対ダーリンのこと見ちゃうわね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それにしても……これだけの量をお腹に出されたら……絶対子供できちゃう\nわね～。ダーリンとの子供なら、あたしは大歓迎だけれど～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ！！　子供って言葉に反応したの～？　残ってるのがまた出てきたけ\nれど……んふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でも子供ができたら、こんな姿は見せられないわね～。パパがこんな格好し\nてたら、子供が泣いちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「だから、ダーリンがこの姿を見せるのはあたしだけ。サキュバスのダイヤナ\nちゃんにだけ。いいわよね？　分かった？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「うふふ、そんなに何回も頷かないでも見えてるわよ～。でも、そうね～。そ\nんな素直なダーリンには、またいっぱいっぱいしてあげちゃうから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あたしの口と、手と、おっぱいで。ダーリンにだけ、してあげるから。ね？\n　だから、またあたしがしたいと思ったら付き合ってね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あたしも、ダーリンも、二人で気持ちよくなりましょう？　ふふ、大好きよ\n、ダーリン」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ！！　おちんちんが跳ねて……あっ、あんっ、精液が、ダーリンの顔\nに……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_16" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んんっ、ダーリンが自分で自分の顔に……あっ……これ、凄く、エッチかも\n……なんだか、ぞくぞくしちゃう～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふうっ、お腹から首から顔から……あんっ、精液まみれって、凄い興奮し\nちゃう。ダーリン、いい！！　いいわよ～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あはぁっ、男の人がぶっかけたがるのがちょっと分かっちゃったわ～。確か\nに、これはエッチだもの～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んふうっ、今のダーリン、凄くエッチよ～！！　あたし、ちょっとどきどき\nしてるもの～。こんな風になるなんて、思わなかった～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ね、ね、ダーリン、また今度、こういう風にしましょうね～。今のダーリン\nの姿、ちょっとクセになりそう……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふふ、ダイヤナちゃんの口と手でこんなに蕩けたダーリンになるの……お腹\nの奥がぞくぞくしちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あたしがこんなことするの、ダーリンだけだからね。だからね、ダーリンも\nこんな姿を見せるのはあたしだけにしてね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000616_01_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でないと、次はもっともっと恥ずかしい格好で搾っちゃうかも……ふふふ、\nなんてね～。冗談よ、多分ね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でも、冗談が本気にならないように、あたしだけを見ててね、ダーリン。あ\nたしはダーリンだけを見てるからね？　きっとよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_1603410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
		{"command":[ "PLAYVOICE", "v2_030_0704108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あっ、んんんんんっ……はぁっ、ぅぅんっ……！　あぁっ……太いのが……\nオマ〇コ……中に広がっていき……ますぅっ……！」", "NORMAL" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「はい、もっとオチ〇ポを締め付けて……んんっ、私の方がミルクをおねだり\nする番ですから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「うんっ、んんんっ……！　はぁっ、おっ、んぅんっ……！　また、オマ〇コ\nの中でびくんって、震え始めていますから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704216" ]},
		{"command":[ "SETIMAGE", "0", "still_00003007_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「このまま、射精まで……あっ、イッていただいて……はぁんっ、私も……ま\nた、オ、オマ〇コ……イキたくなっていますからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んぁぁぁっ！　あぁっ、また激しくっ……ズコズコっ……突かれてっ！　は\nひっ、あっ、あぁぁんっ！」", "NORMAL" ]},

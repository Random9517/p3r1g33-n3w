		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「残らず出してくださいませ……んっ、しっかりと搾り取らせていただきます\nから……んふっ、んぅんっ……ぁ、おっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んっ、もう……大丈夫です。新婚初夜で……高まっていた気持ちが……少し\nだけ落ち着いたと思います……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704113" ]},

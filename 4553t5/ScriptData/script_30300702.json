		{"command":[ "PLAYVOICE", "v2_030_0704308" ]},
		{"command":[ "SETIMAGE", "0", "still_00003007_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んっ……！　あぁ……おっぱいも、やっと収まりました。もうシーツがぐっ\nしょりですね……私、はしたない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},

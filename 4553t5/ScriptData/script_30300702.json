		{"command":[ "SETIMAGE", "0", "still_00003007_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「も、もう……私もっ、ダメですっ……イキますっ、あひっ、続けてっ……オ\nマ〇コッ……イキますからぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「だんな様もっ……お願いしますっ、お好きなところにっ……たっぷりのザー\nメンミルクっ……びゅくびゅくっ、出して下さいませぇっ！」", "NORMAL" ]},

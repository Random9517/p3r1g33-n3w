		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「はぁぁ……あぁっ、奥……ずりゅって……深くぅ……くっ、んぅぅぅんっ…\n…！　あっ、んふぅぅぅ……んっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「あぁ……は、はい……ハメていただいただけで……軽く……イッて……んん\nっ、母乳も……出てしまいました……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_030_0704111" ]},
		{"command":[ "SETIMAGE", "0", "still_00003007_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「んふぅ……でも、こうして……一緒に手を繋いでいると、安心致します……\nとても、優しい気持ちになれるんです……」", "NORMAL" ]},

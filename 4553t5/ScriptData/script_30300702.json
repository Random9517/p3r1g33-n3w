		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "牛神様" ]},
		{"command":[ "SETTEXT", "「はっ、うんっ、んぁっ、ぉっ、はっ、おぉっ……あっ、ぉんっ……はぁぁっ\n、ぁぉんっ……！」", "NORMAL" ]},

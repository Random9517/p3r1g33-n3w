{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0043" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……お互い、いい感じに酒が回ってきたね。ふふ、喋ってるだけなのに\n、酒が進む。いいことだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004101" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "2", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「なんでって？　そりゃあ、あたしとあんたの相性がいいからだよ。喋って、\n楽しいから酒が進む。つまみもいらない。会話だけ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004102" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「相性が悪かったら黙って飲んで酒が進む、そこそこならなにかつまんで酒が\n進む。相性がいいから話だけでも進む。そうだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004103" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたは変わったよ。あたしがこうして歓待したい、もてなしたいと思うぐ\nらいにはね。自信をもちなよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004104" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それに、相性がいいってのも分かった。あたしがこんなに会話が弾むの、そ\nうはいないんだよ？　その点でも誇りに思えばいいさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ただねえ……こうなると、お喋りだけじゃなくて、本当の意味での相性も確\nかめたいところだよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004106" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「本当の相性って？　そりゃあ、決まってるだろ。男と女なんだ。身体の相性\nさ！！　さあ、そこに寝転びなよ。相性を見ようじゃないか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004107" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んふっ、こんなにチ〇ポをギンギンにして……あたしの服を見て興奮してい\nたのかい？　喋ってるときも、胸とかずっと見てたしねえ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「女ってそういう視線には敏感だからね。あたしだからいいけど、他の女には\nするんじゃないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……ふっ……あたしのオマ〇コも濡れてるって、そりゃ当たり前だろう\n。あんたと一緒にいるのに、期待しないわけがないだろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そうじゃなくても、こんな風に部屋の中で男と女が二人きりだったら、あれ\nこれ考えるものさ。そもそもあんただってそうだろうに」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、じゃあお互い似たもの同士、相性を確かめようじゃないか。んっ…\n…ふっ、あっ、入って、きた……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふっ……うっ……うっ、これは、なかなか……いいね。あんたのチ〇ポ、あ\nたしの中にみっちり密着してる、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふうっ、んっ、じゃあ、動かすよ……んっ、ふっ、あっ、ああっ、これ、こ\nれはダメだ、んっ、んくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「相性がよすぎて、腰が勝手に動く、んっ、あっ、あんっ、あっあっあっ！！\n　ふうううっ、んっ、オマ〇コがチ〇ポに吸いついて、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、んんっ、んふうっ、いいっ、気持ちいいっ！！　んっ、あんた\nのチ〇ポが、あたしの中を抉って、削って、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんんっ、身体の中がチ〇ポでかき混ぜられて……んっ、あんっ、あっ、こ\nれ、凄い……んふうっ、ふあっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ああっ、あっ、分かるだろ……んっ、オマ〇コ、チ〇ポに密着してるの、ん\nっ、腰を動かすたびに、もっともっとって蕩けてるっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、ふうっ、気持ちいい、気持ちいいよっ！！　相性ばっちりじゃ\nないか、ねえ？　んっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、オマ〇コとオチ〇ポもじゅぷじゅぷって鳴って、んっ、気持ちいいっ\nて言ってるじゃないか、ねえ、んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、くっ、んっ、これ、本当に気持ちいい……お腹の奥にチ〇ポが届いて\n、んっ、押し潰されたら、ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「頭の中まで潰されてるみたいに……んんっ、これが相性のよさ……んっ、あ\nんっ、あんたも気持ちいいだろう？　あうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、答えなくてもチ〇ポが返事してるね。んっ、オマ〇コの中で、びく\nびくって気持ちよさそうに震えて、あたしの中を小突いて、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「もっともっと気持ちよくしてくれって、気持ちよくなろうって叫んでる、ん\nっ、ふううっ、んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、後ろから見てなよ。こうして、ゆっくりと腰を上げて……んっ、また\nゆっくりと腰を下ろす……ふうっ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「チ〇ポが、どういう風にあたしのオマ〇コに入っていってるか、分かるだろ\n？　んっ、ふうっ……んっ……ふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「このまま、動きだけを速くして……んっ、あっ、あんっ、あっ、あっあっあ\nっ、んくうっ、ふっ、ふあああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はああっ、あっ、んっ、腰が、溶けそうだ……んっ、んんっ、これは、ヤバ\nいね……あんっ、あんたのチ〇ポ、あたしと相性がよすぎる……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「正直、ここまでとは……ふうっ、ううっ、んっ、あんっ、あくうっ！！　思\nって、なかった、あんっ、あっ、あっあっあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「まさかあたしがこんな、んっ、チ〇ポのことしか考えられないようになるな\nんて……ふああっ、あっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004130" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「でも、でもこれっ、チ〇ポ、気持ちよすぎて……んんんっ、腰が、勝手に動\nいて、んっ、あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、このタイミングで下から突き上げるなんて、あんた、んっ、\nあっ、ああっ、あっ、ダメ、ダメだったら！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんっ、ダメって言ってるのに、んんんっ、お腹、チ〇ポでごつごつ叩かれ\nたら、ふうあああっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、イく、イく、チ〇ポで、オマ〇コイくっ、ふううっ、あっ、あんっ、\nんんんんっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あああああ、チ〇ポも、膨らんで……イくんだね、いいよ、一緒に、チ〇ポ\nとオマ〇コ、一緒にイこう、ふううっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、イっく、イっくううううううううううううううううううううう\nうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ひああああああっ、オチ〇ポから精液注がれてる、オマ〇コの中、どくどく\nって注がれてるっ、んっ、ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_07" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、まだ、まだ出てるっ！！　オマ〇コ、溺れる、んっ、くああ\nああっ、出されるだけでまた、イって……ふっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はあっ、はっ、んっ……あ、相性とか以前に、気持ちよすぎる……あんたと\nのセックス……んっ、うっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「こんなの、初めてだね……頭の中まで蕩かされて……このあたしが、あんた\nのことしか考えられなくなるなんて……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「でも……まだ満足できてない。あんたもそうだろう？　チ〇ポがオマ〇コの\n中でずっとびくびくしてる……ねえ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたもこんなもんじゃないだろう？　あたしばかりに動かせて、自分は寝\nたままとか、いい男が廃るってもんじゃないか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ひあっ、あっ、あんっ、そんな、いきなり下から、んっ、あっ、激しく突き\n上げるなんて、あんっ、あんっ、あっ！！　あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ、このっ、あたしだって、腰を、んっ、あんっ、あっあっあっ、これ\n、これっ、二人で同時に動いたら、気持ちよさも……んくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「気持ちよさも倍増して、ふああっ、あっ、あんっ！！　さっきイったばかり\nなのに、また身体が……んんっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんっ、チ〇ポで突かれたら、オマ〇コが……んんっ、あっ、あんたも気持\nちいいんだね、身体がぶるぶる震えてる……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ、だったら、あたしも頑張って、チ〇ポをもてなしてあげる、んっ、\nああっ、あんっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「チ〇ポでもてなされてるのはあたしの方って……ふふっ、そうかもねえ。あ\nんっ、あっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だったら、二人で……お互いに気持ちよくなろうじゃないか、んっ！！　そ\nれが相性のよさってことだろうしね。それにさ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それに、二人で一緒に気持ちよくなっていくほうが、なんだか愛しあってる\nって感じがしていいじゃないか、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んふうっ、なんだいその反応は。あたしが愛とか言うのが意外かい？　んん\nっ、あたしだってそういう気持ちはあるさ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ただ、それを抱く相手がいなかっただけで……今まではね。んっ、あっ、そ\nこ、奥、ぐりぐりってするの、気持ちいい、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それってどういうことって……鈍いにもほどがあるね！！　あんっ、お返し\nにオマ〇コできゅって締めてあげる、んっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしがこんな風に思うのは、あんただけだよ。あんただから、この気持ち\nをぶつけるんだ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「この格好のあたしに、愛しあいたいって思わせるような男なんだよ、あんた\nは！！　んっ、ああっ、あんっ、あっあっあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「また、激しくなって、ふあああっ、あたしの腰も、勝手に動いちゃう、んっ\n、ああっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そんなに、今の言葉が嬉しかったのかい？　んっ、ふふっ、現金だねえ、あ\nんっ！！　でも、あたしも嬉しいよ、あくっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしの言葉に喜ぶぐらいには、あたしを愛してくれてるんだろうからね、\nんっ、ああっ、あっ、そんな、本気だなんて、んふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「その本気を今から見せるって、あっ、んっ、チ〇ポ、チ〇ポが膨らんで……\nまたあたしのオマ〇コで、イくんだねっ！！　ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「いいよ、さっきみたいにいっぱい出して、あんたの愛の証をあたしに見せて\nおくれっ、んっ、くう、イっく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004220" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「イっくうううううううううううううっ！！　ふあああっ、あっ、んんっ、オ\nマ〇コに精液来たあああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「さっきのと合わさった特濃精液が、オマ〇コの中でどろどろになって……熱\nい……んっ、お腹の中が溶けてしまいそう……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ、まだ、まだ出るのかい、ふううっ、んっ、あくうっ、本当にお腹が\n火傷してしまいそうだよ……んっ、ふうっ……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「これが愛の証って……ふふっ、そんな風に改めて言われると照れるねえ。ま\nあ、あたしも言ったことだけどさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……でもまあ、そうだね。これって相思相愛って形になるのかね。ふふ\n、まさかあたしがあんたとねえ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「でも、悪くない。悪くないね。いい男になったあんたをもてなすのも、こう\nやって身体を重ねるのも……悪くない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「まあ、あんたは気持ちよけりゃそれでいいのかもしれないけど……あははっ\n、ちょっとからかっただけじゃないか、拗ねるんじゃないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……それにしても愛の証でお腹がたぷたぷだよ。これなら、愛の証が愛\nの結晶になるのも遅くないかもね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしとあんたの子供なら、どう転んでもいい男、いい女になるだろうねえ\n。今から生まれるのが楽しみだよ。ふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それじゃあ、今後ともよろしく……あたしのいい男」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、チ〇ポが抜けて……ふあああっ、あっ、あんっ、んんんんんっ\n！！　精液が身体に……ひあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_13" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んくうっ、本気の証ってこういう……んっ、あたしの身体にこんなに、ふう\nっ、んっ、んんっ、全身が精液で……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふっ、ふうっ、んっ。もう、出し過ぎだよ。あたしの肌の色を真っ白に染め\nる気かい？　んうっ、まだ出して……ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、けれど、そうだね。本気じゃなければ、こんな量は出せないねえ。\nふふっ、ふふふっ、あんたどんだけ私のことを好きなんだい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ははっ、言わなくていいさ。確かに、こんなにぶっかけられて、愛されてな\nいって思うほどあたしは捻くれていないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「こんな風に男にマーキングされて、それでも嬉しいって思っちゃう辺り、あ\nたしはもうあんたに首ったけなんだろうねえ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「まあ、それもいいさ。あんたはそれに値する男だ。あたしを好きにできる男\nだ。だから……よかったよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ただ、あたしは忘れっぽいんだ。あんたに愛されていることを、時々忘れて\nしまうかもしれない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だから、その時はまたこうして愛しあってくれるよね？　ふふ、私は毎日で\nも構わないんだけれどね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「次も身体にかけてもいいし、中でもいいよ。だから、ね？　あたしが忘れな\nいうちに、またこうして会おう。約束だよ。」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2004410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
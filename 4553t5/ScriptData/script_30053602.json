{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00000536_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev005_36b_0000", "ev005_36b_0023" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「まだ寝ていませんね。ま、寝ていたとしたら叩き起こすところでしたが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604101" ]},
		{"command":[ "SETCHARA", "0", "char_00000536_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ちょっと、ここ数日の訓練内容について文句を言いに来たところです。趣旨\nについては理解していますが、なんですかあれは」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604102" ]},
		{"command":[ "SETCHARA", "0", "char_00000536_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「久しぶりに悪の女幹部として活動しろと言われてみれば、ちょっとじゃれあ\nって敗走してばかりではありませんか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604103" ]},
		{"command":[ "SETCHARA", "0", "char_00000536_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あの程度で満足のいく訓練になると、本当に思っているのですか？　ウチと\nしては、不完全燃焼もいいところですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604104" ]},
		{"command":[ "SETCHARA", "0", "char_00000536_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「というわけで、これからウチが悪の女幹部として、ＥＤＯの隊長を襲います\nから。文句ありませんね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふふん。そうやって戸惑いながらも、オチンチンは勃起しているじゃないで\nすか。いやらしい匂いがここまで漂ってきていますよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「パンパンに張り詰めた亀頭が、ウチのお腹にあたって……。んっ、おへその\n下を押してきてます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「抵抗しても無駄ですよ。あなたがウチに犯されるのは、確定事項です。ほら\n……オチンチン、はいっていきますよ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、ああっ！　はいった……本当に、大きいですね……。オマンコが限界\nまでひろがってしまってますよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ど、どうですか……？　悪の女幹部の、キツキツオマンコは……。ふふ、気\n持ちよくて、声もだせないようですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「とにかくこのまま、あなたのオチンチンを肉バイブのように扱って……んっ\n、ウチの欲求不満、解消させてもらいますよ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁっ、くっ、んっ、ふぅ……っ！　オマンコにこすれて……気持ちいいで\nす……んぁっ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604112" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_36b_0000", "ev005_36b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「広がっているカリが……んっ、こうして腰を振ると、ヒダをごりゅごりゅひ\nっかいてきて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はあっ、はあっ、それにオチンチンの熱さも……感じて……っ！　なかなか\n、気持ちいいですよ……んっ、腰をもっと、振っちゃいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「な、なんです？　オマンコが締まって、射精しそうになっているんですか？\n　だめです、ウチが満足するまであなたは我慢してください」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あなたはウチに襲われている側なんですから。ウチの動きに、意見できるな\nんて思わないでくださいよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、あっ、ん……っ！　んぁっ、ああっ、本当に気持ちいい、オ\nチンチンですね……まったく……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こんな状況でも、萎えずに勃起しっぱなし……。むしろ、さらに大きくなっ\nていませんか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「どうやら、こういうシチュエーションが好みのようですね。このオチンチン\nの反応がなによりの証拠です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そのまま、オチンチンを勃起させておくんですよ。あとはウチが、あなたを\n使って勝手に楽しみますから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、んぁっ、ああっ、オチンチン……んっ、く……っ！　もっと締めな\nがら……しごいちゃいますから、ね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、はぁっ、オチンチンがビクビクと反応していますね。気持ちいいんで\nすか、この腰遣いが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「興奮して、身体が火照ってきたようですね……ンッ、あなたの身体から、汗\nが……はぁ、はぁ……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オチンチンだけじゃなく、汗もいやらしい匂いですね……。んふっ、んっ、\nくんくん……ほら、もっと嗅がせてくださいよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「この匂い……う、ウチも……興奮してきます……。はぁ、はぁ, 身体の奥が\nとても、熱くなってきて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、んくっ、嗅ぎながら、腰を振ると……ああっ、オマンコがますます、\n気持ちよくなってしまいます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ああっ、オマンコからどんどん、愛液が……っ！　んっ、くっ、溢れてくる\n……っ！　ああっ、オチンチンに、愛液かきだされる……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「びしょ濡れの、キツキツオマンコに……っ！　ンッ、オチンチン……出し入\nれするの、気持ちいい……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オチンチンのこすれるところが、全部、気持ちよくて……っ！　あっ、ああ\nっ、声も……抑えられない……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こ、このまま、イッてしまいそうです……. はぁ、はぁ、あなたのオチンチ\nンを使って……イキますからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「特別に、中出しすることも許してあげますから……。限界になってる、パン\nパンのオチンチンから精液、だしてくださいよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ほら、とどめの腰振りで、オチンチンから精液をしぼりだしてあげますから\nっ！　んっ、ウチの欲求不満の解消を手伝ってくださいね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、おっきいオチンチンが、暴れて……！　ほら、だして、精\n液……中出し、しちゃってください……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチがイクのにあわせて、あなたの、くっさい精液を……！　んっ、ウチの\n子宮に、たくさん、だして……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ああぁぁあぁ～～～～っ！！　い、いきなりっ、いきなりきたぁっ！　中出\nし……っ！　んぁっ、はぁあああぁぁぁ～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ああっ、こんな、不意打ちぃ……っ！　い、イク……ッ！　塊ザーメン、オ\nマンコの奥にぶつけられて……イク……ッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「イクッ、イッくぅううぅぅ～～～～……っ！　ああっ、オマンコが、中出し\n精液浴びて悦んでますぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、いつまで射精してるんですか……っ！　オチンチンがなか\nで跳ねながら、まだ、精液をぉ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「い、イク……ッ！　中出しされて、まだ……オマンコが、イッてる……っ！\n　ふぅ……ふぅ……まだイク……オマンコが……ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「な……なんですか……？　それだけイけば、満足だろうって……？　なにを\n言っているんですか？　こんなもんじゃ足りませんよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「さあ、ウチのことをもっともっと悦ばせてください。あなたの身体を使って\n……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000536_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ザ・グリードを演じているのかって？　そんなことはありませんが……ふふ\n、そういう体で続きをするのも一興ですかね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「さあ、ここからは『強欲』の幹部としてあなたの精液を搾っていきますよ。\nまだまだオチンチンは元気のようですからね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「本当、こんなにウチのことを昂ぶらせる匂いのあなたを……んっ、そして、\n気持ちいいオチンチンを……あんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「強欲に……求めちゃいますから……。はぁ、はぁ、腰もまた……最初からは\nげしく、いきますよ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604205" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁっ、くっ、ウチの、イッたばかりのオマンコで……はぁ、はぁ、オチン\nチンを……締めつけて……んっく……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604206" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev005_36b_0000", "ev005_36b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ほらほら、どうですか？　ウチも本気で、あなたのオチンチンを責めていき\nますから……ンッ、我慢なんか、させませんよ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、オマンコがもっと、あなたの精液を欲しがって……んっ、\nあなたのオチンチンで、イキたがってます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「この気持ちいいオチンチンで、もっと、もっとウチのことを気持ちよくして\nくださいよね……んぁっ、あっ、はぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ガッチガチのオチンチン……んっ、すごい……奥まで届いて……先っぽで子\n宮を叩いて……っ！　はぁっ、ああっ、いい……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604210" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチのオマンコ……んぁっ、浅いところから、一番深いところまで……感じ\nてくださいよ……んふっ、くぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「まだ、大きくなるんですか……っ！　ずいぶん興奮、しているようですね…\n…。本当に、襲われるのが好きなんですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「お望み通り、襲っちゃいますよ……。あなたの精液、残さずしぼりとってあ\nげましょう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「強欲の幹部は……んぁっ、きっとオマンコも強欲という、しょうもない設定\nなのでしょう？　んっ、なら、そのとおり……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オマンコでっ、んっ、もっと、動いて……っ！　嬉しそうに勃起している変\n態オチンチンを、しごいて……射精, させます……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3604215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},

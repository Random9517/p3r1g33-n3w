{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あなた、来てくれたのね。待ってたわ。なんの用って……うふふ、男と女が\nこの部屋ですることなんて決まってるじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303101" ]},
		{"command":[ "SETCHARA", "0", "char_00025903_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ね、夫はまだ出張中なの。だから、あなたに相手をしてほしくて……私、魔\n女だけどサキュバスだから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303102" ]},
		{"command":[ "SETCHARA", "0", "char_00025903_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「お願い。私にあなたの精を……ね？　いっぱいっぱい、たっぷりの精を私に\nちょうだい。いいでしょう、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303103" ]},
		{"command":[ "SETCHARA", "0", "char_00025903_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あは、この部屋に来た時点で、あなたも期待してたんでしょう？　魔女でサ\nキュバスの私には分かるのよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303104" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_03" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ほらほら。このおちんちんはなんですか～？　もうこんなにおっきくして、\nびくびくさせて、期待してたんでしょう？　ねえ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303105" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「うふふ、いいのよ。誘われたときから、私がこうしてくるのを想像して大き\nくしてくれてたんでしょう？　魔女の格好の私に……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303106" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「今だってあなたの視線、私の股間にじっと注がれてるのが分かるわ……あん\nっ、もう、視線だけで愛撫されてるみたい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふふ、それは私も同じかもね……触ってもないのに、おちんちんが震える\nぐらい見つめちゃってる……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「でもこんな、大きくて、硬くて……匂いも凄くて。顔の前にあるだけで熱気\nがむんむんで……こんなの、見つめちゃうに決まってるじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303109" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んんっ……もう、ダメ。我慢できない！！　あなたの立派なおちんちん、お\nっぱいで挟んであげる……んっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「凄い、おっぱいが火傷しちゃいそう。んふっ、ふっ、こんな、こんなおちん\nちん、挟んでるだけでイっちゃいそう……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303111" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「こうやって、愛情たっぷりにぎゅっぎゅっておっぱいで抱きしめて、あんっ\n、私もきゅんきゅん来ちゃう……あなたのおちんちんで、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「胸がどきどきしてきちゃう。いけない人ね、恋のおまじないをかけるのは魔\n女なのに、あなたはおちんちんでしちゃうなんて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「でももう、私はそれに抗えない……この逞しいおちんちんをおっぱいでぎゅ\nって抱きしめて、撫でて……んんっ、ふうっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「それだけで身体がぞくぞくしちゃう。おっぱいのなかでおちんちんが暴れて\nるのが分かるわ……あんっ、あっ、ダメ、ダメだったら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「もう、おとなしくしなさいってば。ママのいう事を聞かない悪いおちんちん\nは、お口でお仕置きです。あー……むっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ちゅっ、れるっ、れろっ、んっ。味も凄い……んっ、私のおっぱいで気持ち\nよくなってるのが分かるわ。んむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303117" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんっ、だから動いたらダメだって言ってるでしょう。もう、おちんちんに\nキスしてあげられないじゃない。おとなしくして、んんっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303118" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「そうそう、じっとしててね。ほら、お口とおっぱいでいっぱいいっぱい愛し\nてあげるから……んむっ、ちゅっ、れるっ。んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、おいし……うふふ、あなたのおちんちん、味も匂いも素敵だ\nわ。うっとりしちゃう。一級品のおちんちんね。ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303120" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「私も愛をこめて奉仕しなきゃね……おっぱいでこうやってぎゅっとハグしな\nがら、出てきた先端を……んっ、むっ、んんっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「うふふ、こうして唾液を塗りながら舌を動かしてマッサージすると、気持ち\nいいでしょう？　おっぱいと、お口と……二つのマッサージよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303122" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あなたはどっちが好みかしら？　おっぱい？　お口？　それとも両方？　ん\nふっ、顔で分かるわ。両方ね。素直な子は大好きよ。あむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ちゅっ、れるっ、ぴちゅっ、んっ……ふっ、おっぱいでこねて、口でキスす\nるたびにおちんちんが震えてる……気持ちいいのね、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303124" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んんっ、んむうっ、ちゅっ……うふふ、おちんちん、気持ちいい気持ちいい\nって悦んでるわ。先っぽからお汁も漏れ出して……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「おいし……あなたのお汁なら、いつまでも飲んでいられるわ。だからもっと\nもっと出して……ちゅっ、んむっ、れるっ……んくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「おっぱいでぎゅってして、キスしながら吸って……んっ、舌で舐めるのがい\nいの？　じゃあいっぱいしてあげるわね。れるっ、れろっ、んりゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303127" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「口の中でこうしてべろべろって……あんっ、先端がびくびくってしてる。本\n当に好きなのね。じゃあ思いっきり……んむっ、りゅっ、れるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、んくうっ、ふううっ、んっ。凄い……さっきよりも大きくな\nって。舌が押しつぶされそう……元気なおちんちん、好きよ。んむうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303129" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「おっぱいでもぎゅって抱きしめてあげる……あんっ、うふふ、熱くておっぱ\nいもやけどしちゃいそう……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふうっ、口の中も、おっぱいの谷間も、おちんちんではちきれそう……そ\nろそろ出したいの？　いいわよ、好きなタイミングで、ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んむっ、ちゅぶっ、れるっ、んむうっ、ふっ……んんっ、お汁がだくだくで\n……イって、イっていいわよ、あなたの気持ちいいの、一杯出してっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んんうっ！！　ふうううっ、んっ、んんんっ、んぐううっ！！　んっんっん\nっ、ふっ、うっ……んぐっ。凄い濃いのが……口の中いっぱいに……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303133" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ、味も匂いも素敵……んっ、んくっ、おいしい……あなたの愛\n情と気持ちいいのがいっぱい伝わってくる……んぐっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303134" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「くせになりそう……こんなの飲まされたら、もっともっとあなたのことが好\nきになっちゃう。んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303135" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んくっ……んっ、ふふっ、ごちそうさま。たくさん出たわね。嬉しいわ……\nあなたのおちんちんも気持ちよくなって、私も満足して」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303136" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あなたの精液を飲むたびに、喉から全身からじんじん熱くなって……んっ、\nお腹の奥もきゅんきゅんしてるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303137" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「飲ませるだけで女にそんな風に思わせるなんて、本当に罪な男ねあなたは…\n…うふふ、だから好きになったんだけど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんっ！！　好きって言葉に反応したの？　もう、子供じゃないんだから。\nわかってるでしょうに」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303139" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「私はサキュバスだけど、好きじゃない人にこんなことをしたりしないわ。愛\n情たっぷりのご奉仕は、あなただけよ……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303140" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ほら……私のおまんこ、ぐちゅぐちゅになってるの、分かるでしょう？　あ\nなたがずっとじっと見つめてたところ……下着越しでももう濡れて、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303201" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「おちんちんに奉仕してるときもそうだったけど、今、あなたのを飲みこんだ\nらもっともっと身体が熱くなって……あんっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303202" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ねえ、あなた。もう一回……ダメ？　あんっ、口より先におちんちんが返事\nしてる、やんっ、あっ、うふふ、オッケーってことよね、んむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303203" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ちゅっ、んっ、ふう……精液まみれのおちんちんもおいし……んっ、れろっ\n、ちゅっ……また大きくなってきた、んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303204" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、出したばっかりなのに、口の中で熱くなって……んっ、あな\nたも気持ちいいのね、んむっ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「おっぱいの中でまた暴れてる、こぉら、暴れちゃめっ、でしょ。おっぱいで\nぎゅってしてあげるから、おとなしくして、やんっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「もう、悪い子ね。魔女のいうことを聞かないおちんちんは、拘束の魔法よ…\n…おっぱいと口で、んむっ、んっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303207" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「こうして動かなくしてから、私の奉仕を受けてもらうんだから、んんっ、ち\nゅっ、れろっ……んっんっんっ、ふうっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303208" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふうっ、先端からお汁がだくだくもれて……さっきの精液と混じりあって\n、凄い味になってる……んっ、匂いが鼻に抜けて、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「頭がくらくらして来ちゃう……魔女を蕩かす媚薬ね、あなたの精液って……\nんっ、ふうっ、んぐっ、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「うふふ、褒められてやる気になっちゃった？　また先端が膨らんできたわ。\n竿も硬くなって……んっ、おっぱいが弾かれちゃいそう、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「おちんちんが逃げないようにちゃんと抑えて……お口でも、んっ、ちゅっ、\nんむっ、んんっ、れろっ、ちゅううううっ、んぐっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303212" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふうっ、おちんちん、はちきれそうになってきた……また出してくれるの\nね。おいしい精液、いっぱいいっぱい出してくれるのね。んちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「うふふ、嬉しいわ。おちんちんから私への愛情と慈しみが感じられる……ん\nっ、もちろんお汁からも、んくっ、ふっ、んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303214" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ほら、私のおまんこも悦んでぐちゅぐちゅ言ってるでしょう？　触られても\nいないのにパンツの中、もうどろどろになっちゃってるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「これでもう一回あなたの精液を飲んだら……それだけでイっちゃいそう。だ\nから、次もいっぱい出してね……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303216" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「私もいっぱいいっぱい奉仕するから……ふううっ、んむっ、れるっ、れろっ\n、ちゅっ、んんっ、んぐうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んふうっ、おっぱいとお口ではちきれそうになって、熱くなってきて、鉄み\nたいに硬くて……んんっ、ふうっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「イくのね。またイくのね。いいわ、いっぱいだして。私をあなたの精液まみ\nれにしてっ！！　マーキング、いっぱいっぱいしてっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303219" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「出して、精液出してっ！！　私のお口とおっぱいでいっぱい出してっ！！　\nあなたの愛情、感じさせてっ！！　んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303220" ]},
		{"command":[ "WAITINPUT" ]},
																	
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んぐううううっ、んっ、んんっ、むぐっ、んぐっ、んっんっんっ……んぐっ\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303301" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふううううっ、こんな……二回目なのにこんなに濃いの、あなたの愛情がた\nっぷりこめられてるのが分かる……んくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「味からもそれが分かるわ……私のことを愛してくれてる味……んむっ、ふう\nっ、ふうううっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303303" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「こんなのを飲んだら、私もあなたのこと……もっともっと愛しちゃう、んっ\n、んぐっ、ちゅっ、れろっ……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303304" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ、飲んでも飲んでも飽きない……素敵なおちんちんからの素敵\nな精液、ごちそうさま……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303305" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「おいしかったわ。いつも思うけど、あなたのは一級品ね。サキュバスで魔女\nの私が言うんだから、間違いないわ。あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「褒めたらこうしてまた出してくれるし、サキュバス好みのおちんちんだわ。\nうふふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「何回出しても濃厚だし、本当、あの人がいなかったら夫になって欲しいぐら\nいだわ。うふふ、本当よ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「でも、そうねえ。今日はお口とおっぱいだけだったけど、中にも出してもら\nわなきゃ本当の相性は分からないわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303309" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「だから……ね？　今度は私の中に、この濃厚精液をいっぱいいっぱい出して\n、たっぷり飲ませてね。楽しみにしてるわよ、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんっ！！　やっ、ああっ、おちんちんが外れて……んんんっ、んっ、あっ\n、ああっ、顔と、おっぱいに……んううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303401" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふあっ、ああっ、熱い……んっ、くうううっ、顔中に精液が、んふうっ、ん\nっ、ああっ、あうっ、んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「んんんっ、凄い……精液で顔とおっぱいがパックされてる……んっ、顔中に\n塗りたくられてる……んううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303403" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ふっ、ふうっ、ふっ……こんなに濃いのをお口に出してくれないなんて、意\n地悪……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303404" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「あんっ、でも、これも悪くないかも……お肌からあなたの気持ちよさと愛が\n伝わってくるし……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「精液まみれの私を見て、あなたも嬉しそうだし……うふふっ、男の人って、\nこういうの好きよね。私も嫌いじゃないけど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「それにしても、こんなに沢山出して……私の身体から精液が落ちなくなりそ\nう。まあでも、それはそれでいいかも」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303407" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「この匂いを嗅ぐたびに、あなたのおちんちんを思い出せるから……うふふ、\nお仕事してても、お腹の中がきゅんきゅん鳴りそう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303408" ]},
		{"command":[ "SETIMAGE", "0", "still_00025903_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「ねえ、お口でもおっぱいでも、身体でも、どこでもいいから、次もいっぱい\n出してね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "沙世子" ]},
		{"command":[ "SETTEXT", "「いつでも、どこでも私はあなたのおちんちんにご奉仕するから……出したく\nなったら私に言ってね、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_259_0303410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
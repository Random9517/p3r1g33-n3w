{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0045" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00030902_01" ]},
		{"command":[ "SETANIMRANGE", "0", "ev309_02a_0000", "ev309_02a_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あら……貴方も雨宿りかしら？　降り出しちゃうんだもの、困ったものよね\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203101" ]},
		{"command":[ "SETCHARA", "0", "char_00030902_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「たまたま神社があって助かったけど……雨もまだまだ止みそうになくて、少\nし退屈していたの。お話に付き合ってくれないかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203102" ]},
		{"command":[ "SETCHARA", "0", "char_00030902_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「――ふふ、もちろん、私と貴方は『はじめまして』よ。私は貴方の名前を知\nらないし、貴方も私のこと『分からない』でしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203103" ]},
		{"command":[ "SETCHARA", "0", "char_00030902_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「それで、お返事は？　私の退屈しのぎに付き合ってくれるのかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203104" ]},
		{"command":[ "SETCHARA", "0", "char_00030902_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ん？　どうしたの、突然視線を逸らせたりして……私、自分から目を背ける\n人って、あんまり好きじゃないのだけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203105" ]},
		{"command":[ "SETCHARA", "0", "char_00030902_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「私の服？　透けて下着と肌が見えてる？　あら、あらあら……ふふ、そんな\nことを気にしてくれていたの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203106" ]},
		{"command":[ "SETCHARA", "0", "char_00030902_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「紳士なのね……って、言ってあげたいところだけど、下半身の方は素直ね。\nズボンの上からでも分かるほど、オチンポ、勃起しちゃってるわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203107" ]},
		{"command":[ "SETCHARA", "0", "char_00030902_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「何を慌てているの？　人気のない所で興奮した男と女が一緒になったのよ？\n　やることなんて、一つに決まってるじゃない、ふふふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203108" ]},
		{"command":[ "SETCHARA", "0", "char_00030902_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あら素敵。ガチガチに固くて、大きくて逞しい、可愛がり甲斐のある、立派\nなオチンポ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203109" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「何するって……もちろん、ご奉仕よ。貴方、制服越しに見た私のおっぱいに\n興味津々だったでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「だからこうしてぇ……んんっ……濡れ濡れ制服の上から、パイズリでご奉仕\n、してあげようと思ったのよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203111" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「――初対面とか、出合って数分とか、そんな面倒なことはどうでもいいじゃ\nない。私がしてあげるっていってるのよ、それで納得しなさいな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203112" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「自分でもいうのもあれだけど、私、とっても綺麗よ？　こんな綺麗な女にお\nっぱいでご奉仕されるなんて、男の夢なんじゃないかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふっ……そうそう、貴方はただ、私の言葉を受け入れて、流されて……頭\nが蕩けて、私の虜になるまで気持ちよくなってしまえばいいのよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203114" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ほらっ、おっぱいでオチンポを挟んで、内側からぎゅ～って……このまま、\nすりすり、すりすり、ゆっくり擦り上げてあげるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「雨を吸って冷たい制服も、んんっ、しょっ……んぅんっ……こうして、オチ\nンポに擦り合わせていくと、どんどん熱を増していくでしょう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203116" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「シャツのザワザワ感に、その奥にある、柔らかなおっぱいの感触……ほら、\n意識を集中して、シコシコ、シコシコ――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203117" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「この気持ちよさだけに、身体を委ねるの……んんっ……どんどん動きを大き\nくしてあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「オチンポの根元から、もっとぎゅ～って押さえつけて……んぅんっ……皮も\n全部巻き込むように、先っぽまでシコシコ、シコシコ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203119" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふっ、オチンポはとっても素直ね。先っぽをヒクヒクって可愛らしく揺ら\nして、先走り汁も溢れてきちゃったわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203120" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「血管のバキバキ感も素敵ね……んんっ……括れの傘の部分も大きくて、これ\nでどれだけの女を鳴かせてきたのかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「これ、オマンコに入れると、気持ちよさそう……ふふ、またオチンポビクン\nってしたわね。私のおまんこの感触でも想像して、興奮しちゃった？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「――いいえ、何もおかしくないわ。貴方はただ快楽に耽って、私の虜になれ\nばいいの。……やっぱり、意思が強い男は面倒ね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203123" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「なんでもないわ。貴方は気にせず、私の虜になっていけばいいの……そうね\n、おっぱいだけじゃ物足りないなら、お口も使ってあげるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅれるっ……まずはこのどんどん溢れてくる先走り汁から……ちゅ、れる\nぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203125" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「全部舌で掬いとってぇ……れるっ、じゅれるぅ……ちゅ、ちゅるぅ……亀頭\nがピカピカになるまで、舐め回してあげる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、ちゅれるっ……後は、尿道の中までしっかり……じゅる、じ\nゅるるぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203127" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふっ、慌てて腰を引いちゃって、可愛い反応ね。だけど、だぁめ、逃がさ\nない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203128" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「オチンポが暴れない様に、おっぱいでぎゅ～って押さえつけて、一緒にシコ\nシコもしながら、パイズリフェラを堪能させてあげるわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅ、じゅれる、れろぉ……んんっ……やっぱり、大きな括れも素敵よ……\nこうして……あむっ……じゅれるぅ……ぐぶ、ぐぼぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203130" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev309_02a_0000", "ev309_02a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んんっ……口でじゅぼじゅぼするとき、唇に引っかかるみたいになるの、気\n持ちいいでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あむっ……ちゅ、ちゅれる、じゅるぅっ……んくっ、んくっ……ふふ、飲ん\nでも飲んでも、えっちな先走り汁が溢れてくるわ……んちゅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「でも、味がどんどん濃厚になってきた……ちゅ……谷間の中でオチンポがず\nっとビクビクしているし……そろそろなのよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ちゅ、れるぅ……もちろん、我慢なんてしなくていいわ。パイズリを続けな\nがら、オチンポをぱっくり咥え込んであげるから……んちゅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203134" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev309_02a_0000", "ev309_02a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「このまま私の口の中に、びゅーびゅーって射精しちゃいなさいっ……あむっ\n！　じゅ、じゅるる、じゅるぅぅぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んふぅっ……！　むぶっ……じゅる……じゅ、じゅれるぅ……んんっ……じ\nゅるるっ、ごくっ、んっ、んくんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203136" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_10" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふっ……すごい量の精液ね……んちゅ、じゅれるぅ……欲望塗れの男の液\n体が、私の口の中を汚していくのが分かるわ……んっ、じゅれるぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203137" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んくっ、んくっ……ぷはぁ……重くて、濃厚で……ちゅ、じゅれるぅ……喉\nに絡みついてきちゃうのに、もっと欲しくなる、素敵な精液……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203138" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……ふぅ……全部飲み干してあげたわ。ほら……あーん……お口の中\n、精液残ってないでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203139" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふ、この程度で今され照れるなんて、意外と可愛い所があるのかしら？　\nこういう自分からガツガツ来る女は嫌い？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203140" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「――あれ、嬉しい事いってくれるわね。お礼って訳ではないけれど、このま\nま二回戦、始めちゃいましょうか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「今更、遠慮なんてなしよ。谷間の中でオチンポはまだガチガチのまま……一\n回出したぐらいで、満足なんてできないでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203202" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「そうよ、素直な貴方は素敵よ……私の言葉に流されて、気持ちよくなってい\nればいいの……そうして、最後に私の虜になるのよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「今度は、最初から激しくいくわ。少しでも気を抜けば……あっという間に果\nててしまうよ？　気合をいれなさいな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203204" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅるぅぅ……！　じゅぶる、れる、れるれろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203205" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev309_02a_0000", "ev309_02a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅぶ、じゅ、じゅるぅぅう！　ぐぶっ……ぐぶぐぼっ……！　じゅ、じゅ\nぶる……ちゅ、ちゅれる、じゅるぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……ふふっ、また腰を引こうとしたわね……逃がさないわよ……んん\nっ……フェラだけじゃない、パイズリももっと激しくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「はっ、はっ、んぅんっ……！　バッキバキの勃起オチンポを、根元からシコ\nシコ、シコシコっ……もっと強くても大丈夫かしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふ、貴方の好み、分かってきたわ……んんっ！　少し強すぎるぐらいの力\nで、尿道を絞り上げるようにパイズリされるのがいいのね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ほら、また皮も巻き込んで大きく胸の谷間でずりずりしてあげる……んんっ\n、んぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「身体が濡れてたせいで、最初はあれだけ冷えてたオチンポも……今じゃ火傷\nしちゃいそうなほど熱くなって……今にも爆発してしまいそうね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふ、なぁに、その情けない喘ぎ声は……快楽に流された、みっともない吐\n息混じりの喘ぎ声……とっても素敵よ……んちゅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ちゅ、ちゅれっ、れろぉ……！　あーむ……じゅ、じゅぶる、れるれる、れ\nろぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んんっ……オチンポ、大きすぎて、先っぽを口の中に入れるだけでも大変ね\n……でも、貴方の為だもの、ご奉仕、頑張ってあげるわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あーむっ……じゅ、じゅれる、じゅぶるぅ……ぐぶっ……ぐぶぐぼ……じゅ\n、じゅぞぞぞっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203215" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "PLAYANIM", "0", "ev309_02a_0000", "ev309_02a_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「こうひて、オチンポ咥えられたまま喉を鳴らされるの、堪らないでしょ？　\nじゅ、じゅるぅぅ、じゅぞぞぉぉ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「今度はどこに出したい？　また口の中に出して精液をごくごく飲んでほしい\n？　それとも、私の顔を汚す様にぶっかけたい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「いいのよ……貴方が望むように射精して……私の身体に魅了されて……我慢\nなんてせず、欲望の熱をぶちまけちゃいなさい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「あーむっ……じゅ、じゅれる、じゅぞぞぞっ！　最後まで、パイズリフェラ\nでオチンポ、可愛がってあげるから、このままっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「じゅれる、れるれる、れろぉ……！　ぐぶっ、ぐぶぐぼぉ……！　熱い精液\nをぶちまけなさいなっ！　じゅるぅぅぅっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んぅんんっ……！　じゅる……じゅ、じゅれるぅ……！　じゅぞ、ずぞぞぞ\nぉ……！　じゅるるっ、ごくっ、んっ、んくんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203301" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「二度目だというのに、全然衰えない、すごい量……んくっ、んくっ……ドロ\nドロの精液が、こんなにもっ……じゅる、じゅるぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふっ、まだ逃がさないわ……尿道の中が空っぽになるまで、しっかり飲み\n干してあげる……じゅぞ、じゅるうぅ、じゅぞぞぉぉっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203303" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ぷはぁ……ふぅ……ごちそうさまでした……喉に絡みつくほど濃厚で、お腹\nがいっぱいになるほど大量の精液……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203304" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「貴方、中々素敵なオチンポを持っているじゃない。……これなら、まだまだ\n続き、できるわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203305" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふ、これだけ激しくパイズリフェラをしたんだもの……私だって、興奮が\n抑えきれないの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ねぇ…続き、しましょ？　私のオマンコ、堪能したいでしょ？　私の身体で\n、気持ちよくなりたいわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203307" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「なぁに、眉間に皺なんて寄せちゃって――あら、まだ言ってるの？　何度も\n言うけど、私と貴方は『はじめまして』よ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203308" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「男と女が身体を重ねる理由、時間なんて関係ないわ。お互いそうしたいと思\nったら、そうすればいい。それ以上の理由なんていらないでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふ……今度は私のオマンコで、可愛がってあげる。さぁ、私の虜になって\nしまいなさい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203310" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「んぅうんっ……！　二度目なのに、すごい精液の量っ……！　んんっ……！\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203401" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ドロドロで熱い精液が、髪にまでかかってっ……あっ、んんんっ……！全然\n止まらないわね……ふふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「女の顔を自分の精液で汚したいだなんて……最初は乗り気じゃなかったくせ\nに、欲望に素直なところもあるじゃない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「――謝らなくてもいいわ、それは貴方が私に夢中になった証だもの……とっ\nても素敵よ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふっ、ほら、尿道に残った分の精液まで、私のおっぱいでしっかり搾り取\nってあげる……んんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203405" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「これでおしまい……最後までびゅっびゅって出たわね……でも……オチンポ\nは、まだまだ固いまま」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203406" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「……ねぇ、もちろん、これで終わりだなんて言わないわよね？　激しくご奉\n仕したから、私も少し、興奮しちゃったの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203407" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「貴方のオチンポ、貸してもらってもいいかしら？　今度は私のオマンコで、\n一緒に気持ちよくなりましょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「ふふっ、さっきからずっと視線が私の下半身に向いてるの、気付いてるわよ\n？　オチンポ、入れたいのよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203409" ]},
		{"command":[ "SETIMAGE", "0", "still_00030902_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "愛" ]},
		{"command":[ "SETTEXT", "「遠慮なんてする必要ないわ。気持ちいいなら、それでいいじゃない。このま\nま流されて、私の虜になっちゃいなさい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_309_0203410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
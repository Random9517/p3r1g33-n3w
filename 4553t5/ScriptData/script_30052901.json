{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0163" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチとしたことが、民間人に気を取られた隙に、こんなヤツに捕まるだなん\nて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903101" ]},
		{"command":[ "SETCHARA", "0", "char_00000529_01", "4", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ですが、ウチの力を解放すれば、この程度の拘束なんて、すぐに破ってやる\nのです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903102" ]},
		{"command":[ "SETCHARA", "0", "char_00000529_01", "7", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なっ……！？　あ、あなたはさっきの民間人っ……！？　まさか、この触手\nに操られているのですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903103" ]},
		{"command":[ "SETCHARA", "0", "char_00000529_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひっ！？　ど、どうして服を脱いで、オチンポを勃起させているのですっ！\n？　ま、まさか、ウチを襲う気じゃ……イ、イヤぁぁぁーーーっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903104" ]},
		{"command":[ "SETCHARA", "0", "char_00000529_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んむっ！　ぐっ、んぅぅぅっ！　オチンポが口に押し付けられてっ……！　\nや、やめるですよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903105" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あなたは正気を失って、触手に操られているだけなのですっ！　気を強くも\nって、意識を取り戻すのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、ぐっ……あっぐっ！？　締め付けがさらに強くなってっ……ま、ま\nさかウチが抵抗すれば、この民間人ごと殺そうとしてるですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なんて卑怯なっ……！　ウチだけではなく、何の罪もない人を襲い、人質に\nするなんてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふんっ……いい気になっていられるのも、今の内なのです。すぐに仲間が来\nて、ウチとこの人を助けてくれるのですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「それまで、ウチは絶対に負けないのです。悪しき触手なんかに、屈するわけ\nっ……んひゃぁぁぁんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、あんっ！　お、お尻を触手が叩いてくるのですぅ！　痛いっ、痛いの\nですっ！　やめろですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そんなに叩かれたら、お尻が腫れあがるのですっ！　あっ、あぁぁっ！　ん\nひっ！　あっ、ぐっ！　ふんぐぅ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひぃぃっ！？　く、口を大きく開けたら、オチンポが入ってきそうにっ……\n！　この、卑怯者っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、ふぁぁ……オチンポの先っぽから、透明な汁が出てるのですよっ……\nこ、この人、ウチが咥えることを期待してるのですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「い、いや……そんなことないのです。これもすべて触手のせいで……この人\nはただ、操られているだけに決まっているのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んひっ！　あっ、あぁぁっ！　また、お尻を叩かれてっ……！　もしかして\n、ウチが進んでこの人のオチンポを咥えろと言っているのですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひんぎっ！　ふぎっ！　うっ、うぁぁぁっ！　ど、どこまでも卑劣で、卑怯\nな触手なのですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「し、仕方ないのですっ……これもこの人を救うためっ。ウチの口で申し訳な\nいのですが、咥えさせてもらうですよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あむっ……んっ、ぢゅるっ！　ぐっ、じゅぶぶっ！　ぢゅ、くちゅるっ！　\nんっ、んっんっ……ぢゅぶっ、じゅっぷぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぐっ、うぐぐっ……しゅごく大きなオチンポなのれふっ……大きすぎへ、口\nに入りきりゃないのれふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「しょれに匂いも強いひ、味も濃くへっ……うぅっ、触ってもいひゃいのに、\nオマンコが疼いてくるのですぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぢゅ、じゅるるっ……んっ、ぴちゃっ、ぷちゃあぁ……！　こんらの、舐め\nひゃくないのにっ……んちゅ、ちゅっぷっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ！？　んんん～～～～～っ！？　お、お尻を勢いよく叩かれてりゅのれ\nふぅっ！？　な、なんれっ！？　ウチ、オチンポ咥えてりゅのにっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903123" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もひかひて……もっひょ激しく擦ったり、吸ったりしろと言ってるのれふか\nっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ！　ぐっ、んふぅっ！　返事をしゅりゅように、何度もお尻をぶたれ\nへっ……！　この触手、まりゅで意志がありゅみたいなのれふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「うぅぅっ……イヤらけど、やりゃないとこの人の命がっ……あっ、むっ！　\nぐっ、ぢゅるるっ！　ぢゅぞっ、じゅぞぞっ！　ぢゅぞぉぉ～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903126" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぐっぷっ！　ぢゅっぷっ！　ぢゅぢゅぢゅ、んぢゅぷぅっ！　れりゅ、れろ\nろっ！　ぢゅぞっ、ちゅろろっ！　んぶっ、ぢゅぶっ、ずずずぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぱぁぁっ！　はぁ、はぁ……ぐ、ぐるじいのれふっ……喉にょ奥まれ、オ\nチンポが入ってきへぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「い、息がれきなっ……んひぃっ！？　わ、分かってるにょれふっ！　もう休\nまらいから、お尻を叩くのをやめりゅのれふぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「じゅっぽっ！　ぐっぽっ！　ぐむぐむっ、ぢゅ、んぷぷっ！　ちゅぞっ、べ\nろべろっ、んべろっ！　ぢゅろっ、れろっ、んれろぉぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぐぽぐぽっ、ぢゅ、ぢゅぽぽっ！　ぐっ、んっむっ！？　ぐぶっ、ぐふぅ～\n～～っ！？　オチンポが、口にょ中れ跳ねへっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、ぢゅるるっ！　も、もひかして、イキそうらのれふかっ！？　やっ、\nイヤっ……精子を出すにょらけは、ダメらのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「口にょ中に出されひゃら、本当に息がれひなくなりゅれふよっ！　んっ、ず\nずっ、じゅずちゅうぅ！　せ、せめへ、口にょ外にっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっぶっ！　ぐぶぶっ！　じゅぶじゅぶっ、じゅぞぞっ！　ずっ、ぐちゅち\nゅっ！　にっぢゅっ！　ぐっじゅっ！　んぐっ、んんぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、ぶっ！　うぶぅぅっ！　オ、オチンポが激しく暴れへっ……く、くり\nゅっ……ザーメンくりゅのでふぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「きゃあぁぁぁぁぁーーーーーっ！？　あ、熱いのが顔にっ！　ドロドロした\nミルク、かけられてるのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_07" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「触手に拘束されながら、民間人の精子を浴びるだなんてっ……こ、こんなの\n、味わったことがないのですっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なんで屈辱感と敗北感なのですかっ……！　ウチの心まで、真っ白に穢され\nる感じがするですよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「で、でも、ウチは負けないのですっ……！　どれだけザーメンを浴びせられ\nても、耐えてみせるのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁ、あっ！　ひゃ、あひぃっ！　ま、まだ顔にかけられてっ……あんんっ\n！　ど、どれだけ精子を溜め込んでるのですかぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ふぅ……ふぅ……ぐっ、んふぅぅっ……！　この、薄汚い触手めっ……ウチ\nをここまでコケにするとはっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ですが、この人はもう射精したのです。今のうちに力を解放して、触手を倒\nせば……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「えっ……な、なんで一回出したのに、まだオチンポがカタいままなのですっ\n！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「男の人は、一回射精すればしばらく萎えるものなのに……はっ！？　ま、ま\nさか、これもこの触手のせいなのですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「人だけでなく、オチンポまで操るだなんてっ……こんな触手、見たことも聞\nいたこともないのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「いっひぃぃぃぃんっ！？　触手がお尻だけじゃなくて、股間も叩いてくるの\nですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「や、やめっ……やめろですっ！　そこは私の大事なところでっ……はひぃっ\n！　クリトリスとお尻を、同時に叩かれてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっぷっ！？　し、しかもオチンポまで口に押し付けられるだなんてっ……\nさすがに同時は無理なのですよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あなた、早く正気に戻るですっ！　じゃないとまたウチの口にオチンポがっ\n……んむっ！？　ぐっ、むぐぅぅぅ～～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぢゅっぽっ！　ぢゅぶっ、ぐっぷぅ！　ぢゅぶぢゅぶ、じゅっぞっ！　んじ\nゅるっ、ちゅるっ、れりゅるっ！　んぢゅ、むぢゅうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぐ、ぐるじいのですぅっ……！　オチンポが喉の奥まれ入っへきへっ……！\n　しょれに、お尻も叩かれ続けられへぇ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オ、オマンコの割れ目も、細い糸みひゃいなものれ擦られへっ……全身気持\nひよくなりながりゃ、オチンポ咥えてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こにょ快感と苦しみが続いたりゃ、ウチの身体が壊りぇるのですぅ！　も、\nもうイヤっ！　誰か助けて欲しいのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んむぐぅぅぅぅぅっ！？　触手とオチンポが、跳ねたり這いずったりひまく\nってりゅのれふっ！　き、気持ち悪いぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぐぢっぷっ！　ぢゅぶぶっ、んっぷっ！　ぢゅぶふぅ！　も、もう限界らの\nれふっ……頭がフワフワするれふよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっぐっ！？　ぐぶっ、ぢゅぼほぉっ！？　喉奥れオチンポが跳ねへっ……\nま、ましゃか、またイクのれふかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「や、やめるのでふっ！　もうザーメンいらないのれふっ！　ウチのことを穢\nすの、やめてほしいのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「イヤっ……イヤぁぁぁぁぁっ！　お願いらから、もうザーメン出さないれっ\n！　精子いらないっ！　オチンポ汁味わいひゃくないのですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぢゅぶっ、んべろっ！　ちゅるじゅるっ、ぶちゅぷっ！　あっ、あっ！　ま\nひゃ来るっ……オチンポミルクくりゅうぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「やらっ！　やらぁぁぁっ！　オチンポイヤっ！　ザーメンイヤぁぁぁぁぁっ\n！　ぢゅりゅっ！　じゅぞぞっ！　ぢゅぐっ！　にぢゅぐぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903220" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぐっ！？　おっ、おぶふっ！？　こ、こんろは、口にょ中にぃ……ぐぶっ！\n　ぢゅぢゅるるっ、じゅぽほぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「気管に、精子が入り込んれっ……！　ぐる、じっ……ほ、本当に、息がれき\nなっ……ぢゅ、ぱっ！　にちゅるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「おぶっ、おぶぶっ！　ま、まりゃ出てりゅっ……しゃっき、あんらに出しひ\nゃのにっ……あぶっ、んぶぶっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こにょ触手、手ごわしゅぎるのれふぅ……人を操っへ……射精量まで変化し\nゃせるなんへぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こんらの、ウチ一人じゃ太刀打ちれきないのれふっ……こにょ触手のこひょ\n、甘く見すぎてひゃのれふよっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぐぱっ……ぶっ、ぢゅぽぉぉぉっ……おっ、おぉぉっ……やっひょ、しゃせ\nーとまっへぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひっ！？　あっ、あっぐっ！？　まひゃ、オチンポが大きくなっへっ……！\n？　やっ、やらっ……もう本当に無理れふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチの体力も心も、限界れっ……これ以上オチンポれ犯しゃれたりゃ、気が\n狂うのれふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んひっ、じゅ、ぐちゅぷっ！？　触手が叩いたり、擦ったりしゅるらけじゃ\nなくへ……全身に這いよってきへぇ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ま、まひゃか……ウチは今から、触手とオチンポの両方れ犯されへっ……！\n？　イ、イヤっ……イヤぁぁぁぁぁーーーーーっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あぶぐぅぅぅっ！？　ま、また顔にザーメンぶっかけられてるのですぅぅぅ\nっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「濃厚なミルクが、顔いっぱいにっ……か、髪にもたくさんかけられてぇっ！\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「うっぷっ……！　ザーメンの匂いが鼻に響くっ……すごく臭いはずなのに、\nなんでこんなにも香しいのですかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「まさか、これも触手の影響っ……！？　女が発情する匂いが出るように、精\n子を侵食しているのですっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「まるで私たちを倒すことに特化したような触手なのですっ……こんなに危険\nな生物が地球に居たなんてっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「くっ……はぁ、はぁ……！　んっ、はぁぁぁっ……！　触手の拘束が、わず\nかに緩んでいるのですっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「今の内に脱出をして、この人を助けて……そしてこの触手を倒してやるので\nすよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000529_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「よし……今っ！　って、あ、あれ？　余計に触手が絡まって、動けなくなっ\nたのですっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ま、まさか……今のはウチを油断させるための罠っ！？　触手のクセに、そ\nこまで計算できるだなんてっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2903409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んひぃっ！？　あっ、あぁぁっ……拘束が強まって、身体がキツいのですっ\n……！　うっ、うぅっ……こんなところで、ウチは終わるのですかっ！？」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……ああ、もう来てくれていたんですね。遅れてしまってすみません。何の\n用か気になりますよね。実は……頼みたいことがあるのです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403101" ]},
		{"command":[ "SETCHARA", "0", "char_00000524_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「いえ。大変なことではないです。このドレス……１人で脱ぐことができない\n形になっていまして、背中のホックに手が届きません。なので……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403102" ]},
		{"command":[ "SETCHARA", "0", "char_00000524_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「これを脱がせてもらえませんか？　……いいのですか。突然呼び出されて、\nホイホイ言うことを聞くなんてお人好しですね。ですが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403103" ]},
		{"command":[ "SETCHARA", "0", "char_00000524_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「主様のそういうところが、ウチはすごく……。……フフ。ウチに押し倒され\nて、びっくりしましたか。その隙をついて頬にキスもしてしまいますよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403104" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……ちゅっ……。……ドレスを脱ぐために呼んだのではないか、ですか？　\nその通りです。でも……その前に、お礼をしておこうとも思っていました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あ、主様には……いつもいつも、色々なところで助けられていますから。お\n、恩を返さずに貯めておくのも性に合いませんし！　ということで」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「今は何も言わずに……ウチのしたいようにさせてください。あ、ドレスの感\n想は言ってもいいですよ。誉め言葉しか受け付けませんが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「主様がウチを褒めているその間だけ……気持ちのいいことをしてあげます。\nはい、いわゆる胡蝶の夢……一夜の幻だとでも思っていてください」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……ん……♪　おやおや？　これはどういうことですか？　ウチがご奉仕す\nると口にする前から、オチンチンが勃起していたようですが……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そう、ですか。密室に２人きりという状況だけで興奮してしまったんですね\n。まったくイヤラシイ……。でも、これからすることには好都合です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……ウチの身体を……。この薄い胸をこすりつけながら、主様のオチンチン\nを手で刺激します。……ん……。こら、暴れないでください。肉棒の分際で」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「全てウチに任せていれば極上の快楽を味わえるというのに……。ピクピクヒ\nクヒクと、生意気に痙攣して手を弾き返してくるではないですか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ん、んん……っ。本当に、いつ見ても下品で、太すぎる男根ですね。オチン\nチンと呼ぶのも恥ずかしいくらいに腫れています。……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチの小さな手では掴みきれない……。いつもなら、激しくシゴいてすぐに\n射精させてやるのですが、今日はお礼です。優しくしてあげましょう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ゆっくり、ゆっくり……♪　優しく、やさしく……♪　フフフ、今日のウチ\nが優しい気持ちで助かりましたね？　オチンチン全体を撫でますよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「なでなでなで……。撫でながら、少しずつ力をこめていって……。ん、これ\nくらいですか。ちょうどいい力加減で、上下にじっくりシゴくのです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「っはぁっ……♪　今さら、ですが……主様のオチンチンは、すごく硬くて大\nきい……ですね。まじまじと観察すると、そのすごさがよくわかります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチの手首より太いかもしれません。……んっ♪　それに弾力があって、と\nにかく熱いんです。手のひらにつたわるこのゴツゴツとした感触……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こんな凶悪なモノを、いつもオマンコに突き入れられているなんて信じられ\nません。怖すぎます……。ん……。で、ですが……コレが……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「いつもウチをあんなに気持ち良く……。……ごくっ。い、いえ！　唾なんて\n飲んでません！　だ、黙って奉仕されていてください！　……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そういう主様のオチンチンだって……もう先走りが滲み出しているではない\nですか。いいのですよ、リラックスしてもっと気持ち良くなってください」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「確かに主様のオチンチンは、グロテスクでヌラヌラ光っていますが……その\n。ウ、ウチにとっては愛おしい、唯一のものです。……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こうしてシコシコとシゴいていても、愛着のようなものがわいて……。……\nそうです。もっと気持ち良くできる方法がありました。いきますよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ♪　くちゅっ……！　ぴちゃっ……！　ど、どうれひゅか……？　手で\nシゴきながら口で舐めれば、２倍気持ち良くなれるはず……ん、くちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ……♪　これは正解のようですね。反応が段違いです……！　っちゅっ\n、ちゅっ、くちゅっ……！　まずは先端を舐めて、口づけをして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んちゅ、ちゅ、ちゅぅ……。そのまま深く咥えていって……んちゅぅっ！　\nぐちゅっ！　ん！？　んんっ……オチンチンがさらに太くなりまひた……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぷぁ、これですね、こういうのがいいのですね……！　それなら手を動か\nしながら……んちゅっ、ぐちゅっ！　ウチの唾で濡らしつつ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オチンチンをほおばるのですっ……！　じゅぷっ！　ぐちゅっじゅるっ！　\nん、んっ……！　ヌルヌルになったオチンチンを素早く舐め回す……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ぴちゃっ、くちゅっ……♪　そしてしゃぶる……！　っぐちゅっ、じゅぷっ\nぐちゅっ！　あぁあ、いいのですか……？　感じるのですね……っ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403129" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっはっ……♪　んれろっ、ぐちゅっ！　ぐちゅっじゅるっ……！　はぁ、\nはぁっ……！　ぐちゅぅっ♪　じゅるっ、じゅる……！　んんんんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、ここれひゅか……？　オチンチンのくぼんだところ……、れろっ！　\nここや……先っちょ、がとても敏感なのれすね……？　ぴちゃっんれるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁっ、あぁっ……♪　根元を指でぎゅーっと握りながら……ぴちゃっ、先\n端を舐め回すぅ……♪　ぴちゃっ、くちゅっくちゅぅっちゅぱっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「フフフ……♪　射精ひたくなってきたのれひゅか……っ？　わかりまひゅよ\n……♪　オチンチンが一気に膨らんれきまひたから……じゅるるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403133" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ん、はぁっ♪　射精したくてたまらないその姿……もっとウチに見せてくだ\nひゃい……♪　んちゅっ、シゴくスピードをあげますよ……っちゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「っ……んんんっ♪　さぁっ……♪　さぁっ♪　ウチに甘えてください、ウチ\nの口の中に出ひてくだひゃいぃ……♪　ぴちゃっぴちゃっ、出ひてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっんんんんんむっ……♪　んむぅうう♪　イイでひゅよ……っ！　出てま\nす、精液がウチの口の中に……！　喉奥に……！　んっんっんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_06" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひゅごいぃい……♪　火傷しそうなほどに熱い……っ♪　んんんぁっ♪　…\n…あぁああ♪　ダメです、ぁっ、こぼすわけにはいきませんんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「全ての精子を受け止めます……！　んぅううう……！　ん！　んんっ！　ン\nッ……んんんん……っ！　な、なんという勢いなのですか……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁっ……！　口の中が精液でミチミチに……！　っんっ……！　ね、粘り\n気が強すぎて……、全然飲みこめまふぇん、……んっ、濃厚すぎて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、んっぅっ……んん……ごくっ……♪　ごくっ……んくぅ……♪　あ\n……♪　ようやく、なんとか飲めましたです……んぅ、ごくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……ふぁ……。とんでもなく苦労しましたが……その分たくさん飲めた気が\nします。それにしてもすごい量でしたね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチからの感謝の気持ち、伝わりましたか？　……その顔を見るに、まだ足\nりないようですね。それなら……このまま続けますよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「え？　当然ではないですか。言葉で伝えるより……、んんっ、行動で伝えた\n方がわかりやすいでしょう。ウチの気持ち……受けとめてください」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んん、……れろっ♪　ぴちゃっ、ちゅく……♪　くちゅっ、ちゅ、ちゅ……\nっ。はしたないオチンチンですね、もうこんなに硬さを取り戻して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そんなにウチの口と手が好きですか？　それなら、その大好きな手と舌で…\n…いくらでも気持ち良くしてあげますよ。……んん、ちゅっ、ちゅぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んむっ……♪　主様のオチンチンのことは、ウチが一番よく知っています…\n…！　これだけは、誰にも負けません。負けたくありません……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、くちゅっ、ぐちゅっ……じゅるっ！　じゅぷっ！　じゅるっ、ぬち\nゅ……♪　んんっ、手、も休まずに動かしますよ……。んっ、ちゅくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んっ……ぷぁ？　腰を揺らしているのれひゅか……？　んっ、ちょ、舐めに\nくいのでやめてください……！　ぁっ、勝手に動いてしまう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「それならこちらが激しく、強くすればおさえこめますかね？　まったく、手\nのかかるお人です……。いきますよ、……ぐちゅっ！　じゅるっじゅぽっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「むぐっ……♪　んん、こ、これは気をつけないと喉にずるんと入りこんでひ\nまいそうれすね……！　こんな太いものをいれられては困りますっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……ウチの舌で押さえて、……ぴちゃっ、上手く舐めて気管に入らないよう\nに……！　んんっ、ぢゅるっ、じゅぷっじゅっぷっぐちゅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そうです、手でも根元をしっかり固定して……、んんっ。いいですよ、安定\nひてきました……！　ふぅ、これで安心して舐められます……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ん、ちゅっ、ちゅぷっ、くちゅ……んれろっ！　れろっ、ぴちゃっ……ちゅ\nっ、ちゅぅっ……！　ぐっちゅっぐちゅっ！　んんっんっんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「裏筋を手と舌で同時に攻められるのはどうれひゅか……？　んぅ、主様のオ\nチンチンはどこもかしこも性感帯……敏感な弱点ばかりですから、んちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「攻めるこちらは楽で助かります……、くちゅっ♪　んんん、ここを舐めると\nピクピクしますね……。なるほど、参考になります。っちゅっぴちゅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「れろっ……れろっ、くちゅっちゅっちゅぷっ♪　あぁ……♪　なんてわかり\nやすい……。ここですね、っじゅるっ！　じゅっぷっじゅっじゅぷぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ん、はぁっ……♪　んんっ、じゅるっ……！　じゅるっ！　んぷぅ……♪　\nんんっ！　どんどんオチンチンが硬く反り返ってきていますよ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あは……♪　限界を迎えそうになっていますね……っ♪　いいですよ、また\n射精したくなってきたのでしょう？　んっ、ちゅ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチの口で、精液を睾丸から亀頭まで一気にすすりあげてみせますです……\nっ、ほらっ、覚悟して……楽になっちゃってください、出すのです！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んんんんっ……！　じゅぽっ！　じゅっぽっじゅぽっ！　ほら早くっ、出し\nてくだひゃい！　……じゅぷっ、じゅるるるっ！　んぢゅるるるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「むぷっ……♪　んぐぅうっ♪　ンンンッ……！　んんん～～～～っ……♪　\nこ、こぼさないように全部口の中に……っ。んむ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んふぅっ！　な、なんという量ですか……！　んんっうぅっ……！　こんな\n量、口の中に入りきらな……。んむぅうううう～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ん、ん、ん、ん……！　ごくっ……、んんんぅ！　ごくっ……ごくっ……！\n　あ、わ、ま、まだ出ています、しょうこりもなくっ、んぐぅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ごくっ、ごくっ……。んぇ……♪　し、舌に絡みついて上手く口が動かせま\nへんん……っ。んっ、しつこくて長い射精ぃい……♪　……ごくんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あ、主ひゃまはまったく限度というものを知らないっ……！　ごくっ。……\nんんぅっ。く、くさくてネットリした汁がこれでもかとぉ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチがオチンチン、キレイにしますね……。んれろっ、くちゅ……じゅるっ\n。ごくっ、ごく……ぴちゃっ、ぴちゃ……♪　どう、ですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……ん……。ふぅ……♪　やりたい放題できて、少しは気持ちがおさまりま\nした。どうでしたか、気持ち良かったですか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「誰かに感謝を伝えることは……なかなか難しいことですね。ウチなりには精\n一杯しましたが……それでも全然伝わった気がしません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「いつも……そっけなく見えるかもしれませんが、ウチはウチなりに主様のこ\nとを考えているつもりです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「これからも、ウチは努力を怠りません。ですから……たまには傍にいてくれ\nると、嬉しいのです……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「うぁっ！？　ど、どうして急にオチンチンを引き抜いて……？　きゃっ！？\n　じょ、冗談でしょうっ……顔にかけるつもりですか！？　わぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETTEXT", "「あんっ……！？　ンンンッ……！？　よ、よりにもよって顔を狙って……っ\n、ぷぁあああっ……！　あ、主様という人は……んぷぁっ、あぷっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403402" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「な、生臭い臭いですねっ……。あっ♪　ですが……これはウチが出してもら\nった精液です、ウチに責任のある精子なら……浴びて当然ともいえますっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「か、かけてください……！　あっ、精液は臭いですが、主様のものなら……\n嫌いにはなれません、あっ♪　トロトロですごく濃い……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「真っ白な精液を浴びていると……いけない気持ちになってきてしまいます…\n…！　んっ、いつもオマンコに注がれている熱い精子……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「意識すればするほど……！　っぁっ♪　んぁああっ……♪　ヌメリで顔がヌ\nルヌルに……っ。あっ♪　んぁっ、止まりません、んんっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁあああっ……♪　満足してもらえたようで、良かったです……。……ま\nさかこれだけの量を出しておいて満足していないとは言いませんよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000524_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「どうしてウチが、いきなり感謝だの礼だの言い出したのか、ですか？　情け\nない話ですが……ウチは思ったより、主様に頼りっきりなのだと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「最近自覚しまして。……例えば……もし、ウチが本当に王位を継承していた\nら……自分も王族になる可能性は考えていましたか？　それくらい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチは心を主様に預けていて……。な、なんて、い、今のは聞かなかったこ\nとにしてください。あくまで仮定の話！　妄想の話ですからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2403410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
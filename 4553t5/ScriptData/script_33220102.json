		{"command":[ "PLAYVOICE", "v2_322_0104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「ひぁっ、やだっ、あぁっ、気持ちよくなりたくないっ……！　またっ、イキ\nたくなってるのっ、止めなきゃっ……はぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104215" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「んじゅるるっ……むぐっ、はぁぁ……この甘い味ぃ……さっきまで臭くて…\n…マズかったのに……好きに、なって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「んぁっ、そ、そこっ……！　あっ、オマンコ……もっとっ、ずりって……し\nてっ♪　ひぁぅっ……あぁっ、イクっ……またイキそぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104217" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「な、中でっ……さっきと同じ……ビクビクが始まってるっ……！　あぁっ、\n触手ザーメンっ……も、もうすぐ出ちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「やっ、あぁっ、来ないでっ……来たらダメなのにっ……でも、あんなの……\n出されたらっ、私……も、もうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104219" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、イクっ……イッちゃうのっ！　触手チンポに両穴犯されてっ……\nお尻とオマンコっ、両方イクぅぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104220" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「ひぃぃぃぃぃんっ！　あぁっ……なかっ……来てっ……オマンコっ、いっぱ\nいに出されてるっ……！　はへぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「あぁぁ……止まらない……こんなぁ……イ、イクっ！　またイクっ……！　\nお尻にも熱いの……流れ込んでぇ……イクぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「はへぁ……あぁぁ……ずっと、ずっと気持ちいいのが続いてる……こんなの\n……我慢できるわけない……もぉ……何も考えられない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「あぁぁ……もっとズボズボしてぇ……オマンコかき回してぇ……触手チンポ\n……いっぱい出してぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「んぁふっ……あぁ……触手ザーメン気持ちいい……もう、これでいい……は\nふぁ……はっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「わ、私……今、何を……っく……一瞬、気を持っていかれそうになっていた\n……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「ふん……すぐに堕ちなくて悪かったわね……何でも思い通りになると思った\nら……大間違いよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "（でも……今はまだ何とかなってるけど……これからも耐えられるとは限らな\nい……）", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「意識を強く持たなきゃ……必ず助けは来る……それまで、何としても耐えて\nみせる……ひっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「ま、また……触手が動き始めて……うぁっ、こ、来ないでっ、あぁっ、く、\n来るなぁっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104310" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_17" ]},
		{"command":[ "WAITINPUT" ]},

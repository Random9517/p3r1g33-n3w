		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「んぁぶっっ！　しょ、しょくひゅからっ……ザーメンっ……溢れてっ……！\n　からだっ……ドロドロにされてるぅっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「んぁぁぁっ……あぶっ！　何よ……このメチャクチャな量っ……ふぶっ、の\n、飲まないと……んぐっ、窒息ふるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104402" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「ふぁぁ……んっ、んぐっ、むふぅぅっ……ちゅぷっ、んぱっ……あぁ……な\n、なんで……こんなのマズい筈なのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「ちゅぱっ、んちゅぷっ……もっとぉ……もっと欲しい……んっ、ちゅぷぅ…\n…うあっ、あぷっ、いっぱい……掛けてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「はっ、はぁっ、はぁぁぁ……あぁ……すごい……こんなの味わったことない\nの……はふぁぁ……あぁ、はぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104405" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「はふ……あっ、はぁ……はぁ……止まった……あっ、も、もう終わりなの…\n…？　続きは……って……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「な、何言ってるの私……やっと落ち着いたのに……続きを欲しがるなんて…\n…そんなこと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00032201_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「違うっ……今のは違うわっ……！　一瞬、気を取られただけっ……お前たち\nに屈したわけじゃないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「まだ試す……？　ふ、ふん……これだけ出しても、まだし足りないって言う\nの……？　本当にどうしようもないのね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_322_0104409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ソウルイーター" ]},
		{"command":[ "SETTEXT", "「あっ、くっ……また、触手が……うぅっ、いや……だ、誰か……助けてっ…\n…あっ、あぁっ、んぁぁぁっ……！」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「人気のない部屋に刻の道化師であるボクを呼び出すなんて、もしかして、悪\nだくみの相談かい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604101" ]},
		{"command":[ "SETCHARA", "0", "char_00023106_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おやおやぁ？　そんなに興奮してどうしたんだい？　顔も真っ赤じゃないか\n、もしかして、体調不良かい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604102" ]},
		{"command":[ "SETCHARA", "0", "char_00023106_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――あはっ♪　なーんだ、もうばれちゃってるのか♪　そうだよ、つい数時\n間前、キミが飲んだドリンクにいたずらをしたのは、このボクさ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604103" ]},
		{"command":[ "SETCHARA", "0", "char_00023106_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミが飲んだのは、媚薬がたーーっぷり入った特製ドリンク。こうして女の\n子と二人きりになっちゃうと、我慢なんて、できないでしょ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604104" ]},
		{"command":[ "SETCHARA", "0", "char_00023106_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「きぁんっ♪　あはっ、いきなり押し倒してくるなんてがっつくねぇ♪　でも\n、そうでなきゃ、薬を盛った甲斐がないってもんだ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604105" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、んぁんっ♪　なんでボクのマンコがもうこんなに濡れてるのかだって\n？　決まってるじゃん、ボクもあの薬を飲んだからだよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604106" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「どうしてって言われてもね――それはもちろん、こうやって押し倒してもら\nう為に決まってるじゃん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604107" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「言っとくけど、これはキミのせいでもあるんだよ？　キミってば、ボクから\n誘わないと全然手を出してくれないんだもん」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「何度も言ってるけど、これでもキミの事、とーっても気に入ってるんだよ？\n　たまには獣みたいに、めちゃくちゃにされたくなる時もあるの♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「人に薬を盛るなんて、ボク、悪い子でしょ？　だからぁ……んぁんっ♪　ボ\nクのトロトロマンコにいっぱいお仕置き、してほしいなー、なんて♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604110" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ♪　い、一気に奥までチンポ来たぁ♪　ゴリゴリの勃起チンポ\nが、お腹を抉ってっ、あっ、んぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604111" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ♪　チンポ入れられただけなのに、軽くイッちゃった♪　あぁんっ♪\n　そうそう、我慢なんてしなくていいの♪　あっ、あぁあんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604112" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクが悪いんだから、キミは乱暴に腰を振っていいんだよ、もっと乱暴に獣\nみたいに！　ボクの事、気持ちよくしてぇ！　あっ、あぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「す、すごい、腕をぎゅーって押さえつけられて、これっ、ほんとに無理やり\n犯されてる感出てて、いいかもっ♪　んあっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604114" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んくぅうんっ♪　愛液もどんどん溢れて来ちゃって、ぐちゅぐちゅってえっ\nちな音、止まらないや♪　あっ、あぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「で、でもこれっ、んんぅうんっ♪　ちょーっと気持ちよすぎるというか、や\nばいって言うかっ、ひっ、んぁあぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「わ、我ながらナイスな媚薬をえらんだな～♪　ね、ねぇ、さっきから小さく\nイキっぱなしだから、ちょっとぐらいなら力を緩めてくれてもぉ――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604117" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んひゃぁんっ♪　だ、だめだ、キミの目、ガンぎまっちゃってるぅ！　く、\n薬の分量間違えた！？　ひっ、あっ、あぁんんっ♪　んくぅうんっお♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604118" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ♪　でもまぁ、これはこれでいっか♪　こんな獣みたいにがっついて\nくるキミを味わえることなんて、レアだもんね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604119" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「マンコの膣内、もっともっと掻き回して♪　んぁんっ……♪　子宮まで突き\n込んで、何度も、何度も♪　あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふっ♪　ボクもマンコをぎゅ～ってしてあげるね♪　チンポを食い千切\nっちゃうぐらい、強くぎゅ～～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604121" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ、この動き、気に入ってくれた？　――もちろん、キミが望むなら、\nいくらでもやってあげるっ♪　あっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604122" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほぉーら♪　締め付けてぇ、緩めてぇ、また締め付けてぇ、あぁんんっ♪　\nマンコの膣内グネグネするの、気持ちいい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――うん、キミのチンポもとっても気持ちいいよ♪　デカくて熱いギンギン\nチンポで、野生の獣みたいに乱暴に犯されるの、最高に気持ちいいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604124" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んあっ、あっ、あぁんんっ♪　また一気に激しくなったぁ♪　ボクの膣内、\nチンポで全部引き釣りだされちゃうかもぉ♪　あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んひっ、あっ、ふあぁんんっ♪　そこぉ、Ｇスポットももっと突いてっ！　\nガチガチチンポでもっと乱暴に抉ってぐりぐりしてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「これ、いいっ♪　優しくされるのも好きだけど、こうやって乱暴に無茶苦茶\nにされるの、求められてるって感じが強くして、すっごくいいかもぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604127" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁんんっ♪　またイク、何度もイっちゃう♪　チンポ最高過ぎてイ\nクの止まんないっ、んあぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――あはっ♪　分かってるよ、キミのチンポももう限界なんだよね？　この\nままボクの膣内に、精液びゅるびゅるって射精したいんだよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604129" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「わざわざ許可なんて取らなくていいに決まってるじゃん♪　これは薬を盛っ\nたわるーいボクへのお仕置きなんだから♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっああっ、ああぁんっ♪　キミの好きなように腰を振りたくって、チンポ\nをマンコに叩きつけて、ボクの全部を征服しちゃっていいのっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604131" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ♪　チンポ一気に膨れ上がってっ、あぁんんっ♪　お、お腹突\nき破られちゃうぐらい、激しっ、んあぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604132" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「すごいっ、まだ速くなるんだっ、あぁんっ♪　お腹ボコってなっちゃうっ♪\n　キミのチンポの形で、お腹ボコってぇ♪　んあぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「このまま出してぇ♪　蕩けきったボクのぬるぬるマンコの膣内に、精液いっ\nぱいっ、んあぁんっ♪　ボクも一緒にイクからいっぱい出してぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「イックうぅぅぅんっ♪　あっ、ひっ、んひゃぁんんっ♪　まんこの奥、熱い\nのドクドクきてるぅ♪　あっ、ああぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604135" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「これこれぇ！　これを待ってたのぉ♪　子宮に直接ぶちまけられるのだ～い\n好きぃ♪　あっ♪　ふあぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604136" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「またイク、イックゥぅぅんっ♪　精液びゅるるるっ、止まらないっ、んぅぅ\nん♪　やっぱり薬、効きすぎてっ、んくぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604137" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクも子宮アクメ、止まらないや♪　アツアツザーメンを注ぎ込まれるの、\n最高ぅうっ♪　んおっ、おっ、おおぉおんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「まだまだ抜いちゃだめだよっ♪　全部出し切るまで絶対に逃がさないよ～♪\n　ほらほらほらぁ、まだ出せるよね！　もっともっと精液ちょうだい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604139" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んぁあああっ……♪　んふうっ、んんっ、んあぁんっ♪　あはっ♪　キミに\nこうやって無茶苦茶にされるの、やっぱりだ～い好き♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604140" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ふあぁぁあぁ～～……♪　最高の膣内出しだったよぉ♪　こういうのってキ\nメセクって言うんだよね？　んふふ♪　癖になっちゃったらどうしよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……本当はさ、キミにだけ媚薬を盛って、色々イタズラしてやろ～とか、可\n愛がってあげよ～とか、思ってたんだよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「だけどボク、思ってた以上に、キミのこと、大好きになっちゃってるみたい\nでさ？　折角ならボクも一緒に気持ちよくなりたいな～って♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――うん、分かってるよ、一回出したぐらいじゃ、満足できないんだよね？\n　チンポもまだ固いままだし、このままもう一回、しよっか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほら、このボクが珍しくデレてあげたんだからぁ……次は優しく、恋人にす\nるみたいなえっち、お願いしてもいいかな～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あぁんっ♪　いっぱい精液出したから、ボクのマンコ、にゅるにゅるになっ\nちゃってるね♪　チンポが簡単に滑っていっちゃう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604206" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁんんっ♪　さっきみたいな乱暴なチンポもいいけど、じっくり膣\n内を可愛がられるのも、お腹の奥からじわじわきてっ、んくうぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ♪　またイッちゃったぁ♪　気持ちいいのが全然抜けきれてないから\n、チンポで子宮を突かれるとすぐにイっちゃうや♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604208" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――んひゃぁんんっ！？　ちょ、ちょっと待ってっ！？　なんでまた、いき\nなり激しくっ、ひっ、あっ、ふあぁんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604209" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あ、あれ？　恋人みたいに優しくしてくれるって話はぁ！？　――え？　人\nに薬を盛っといてなに言ってんだ？　お仕置きしてって言ったのはボク？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604210" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「確かにそれも言ったけどぉ！　んあぁんっ♪　あっ、ふあぁんっ♪　も～、\n珍しくボクが甘えてあげたのにぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604211" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、んあぁんんっ♪　でもぉ……あはっ♪　まぁ、ボクたちの関係的にこ\nっちの方が正解か～♪　んあぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いいよぉ、このままお仕置き続けて、ボクのマンコめちゃくちゃにしてぇ～\n♪　凶悪チンポで膣内をゴリゴリ削って、突いてっ、んあぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604213" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あ～っ♪　あっぁっあっ♪　それ好きぃ、腰をくっつけたままぐりぐり回す\nの、気持ちいいっ♪　子宮にジワジワきてっ、あっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604214" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「腕ももっとひっぱって！　力づくで腰と腰をぶつけて、マンコを突いて突い\nて、突きまくってぇ！　あぁんっ♪　おっ、おぉんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「またお腹もボコってなるっ、キミのチンポの形でボコってっ、あぁんんっ♪\n　やっぱりキミのチンポ、最高だよぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んっくぅうんっ♪　き、気持ちよすぎてっ、頭の中真っ白になるっ、んぅん\nっ♪　クラクラ揺れてっ、あひっ、ひゃぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604217" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「また来るよっ！　大きいのがマンコの奥から溢れてきちゃうからぁ、アッは\nぁん……♪　クぅっ！　イクッ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604218" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「最後は今までで一番強く、マンコ締め付ける、からぁ！　あぁんんっ♪　キ\nミの精液、今度こそ根こそぎ搾り取ってあげるねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「イク、イクイク、イックうぅうんん♪　キメセクでまたイク！　一緒にイク\nから、キミも来てぇ♪　いっぱい来てぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604220" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_08" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あくぅうううっ♪　二回目なのにっ、すごい量っ♪　あっ、ふあぁんんっ♪\n　マンコに入りきらなくて、溢れて来ちゃうぅっ♪", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604301" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、ひぅんんっ……！　びゅるるぅううって、熱いの、どんどん流れ込ん\nできて、んうぅ！　イクの、止まんないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「頭の中もまっしろでっ、あっ、ふあぁんんっ♪　こんなに大きいの、始めて\n、かもぉ……！　んふうぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604303" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、ひっ、ひぃっ……あは、はははっ♪　駄目だぁ、これぇ……薬でする\nの、本当に癖になっちゃうかもぉ！　んんぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604304" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んぅ……お腹、力入らなくて……あ……んふふ、おしっこ、出ちゃったぁ…\n…ごめん、キミの身体にかかっちゃうね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604305" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――って、なんでそんな嬉しそうな笑顔なのさ。キミ、たまにボクでもびっ\nくりするぐらいの変態さを見せつけてくるよね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「まぁいいや、んんっ……キミが嫌じゃないなら、このままおしっこ、ぜーん\nぶ出し切ってあげる♪　しっかり受け止めてねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604307" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んんっ……チンポ入れたままするおしっこって、なんか変な感じかも……ん\nふふっ、これはこれで気持ちいい、かな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……はい、お終い♪　あーあ、結局最後まで、キミの好きなようにされちゃ\nった感あるな～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「まぁ、キミになら、好き勝手されるのも悪くはないか♪　　ボクが悪いこと\nをしたら、またお仕置き、楽しみにしてるね？　いひひっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んひゃぁん！？　わっ！　な、膣内に出すんじゃないんだっ！？　んんぅん\nんっ♪　すごい、キミの精液がボクの全身に掛かってっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604401" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「でも、これはこれで気持ちいいからだーい好きっ♪　ああぁんっ♪　キミの\n精液で全身をお化粧されるのっ、気持ちいいぃ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「二回目なのに、むしろさっきよりも精液の量が多いみたいだしぃ♪　ボクも\nっ、ッくぅうんっ♪　キミのぶっかけでイクぅん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ……！　んふふっ、薬が効きすぎちゃったのかなぁ、お腹に力入らなく\nて、お漏らししちゃったぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604404" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミに精液ぶちまけられながらぁ、んんぅん……こうやっておしっこするの\n、これはこれでとっても気持ちいいかもぉ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ♪　すっごく熱い視線を感じる♪　人がお漏らししてるところを見て\n鼻息を荒くするなんて、キミってば本当に変態だね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604406" ]},
		{"command":[ "SETIMAGE", "0", "still_00023106_02_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ふぅ……それで、感想はどう？　媚薬でトロトロになっちゃったボクを問答\n無用で犯しまくった気持ちは？　愉しかった？　満足した？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「――人聞きが悪いこというなっていわれても、ほんとのことだからね～♪　\nボク、おしっこ漏らしちゃうまでぐちょぐちょにされちゃったんだもん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「でもぉ……んふふっ♪　やっぱり、キミになら、どんなことをされても嬉し\nいって思っちゃうな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「だから、これからもよろしくね？　ボクがイタズラしたら、気持ちいいお仕\n置き、い～っぱいお願いね？　いひひひっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0604410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
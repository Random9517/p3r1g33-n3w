		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ふーーーーー、いやー泳いだ泳いだ！　やっぱり、休暇は海に限るな！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203101" ]},
		{"command":[ "SETCHARA", "0", "char_00016802_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ビーチはほぼ貸し切りだし、天気も最高。こんなお膳立てをしてくれた主に\nは、ちゃんとお返ししてやらないとダメだよな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203102" ]},
		{"command":[ "SETCHARA", "0", "char_00016802_01", "5", "CENTER", "0" ]},	
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「気にするなって？　まぁまぁ、そう言うなって。こいつはアタシの気持ちで\nもあるんだ。ほら、こっちに来てくれよ、主」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203103" ]},
		{"command":[ "SETCHARA", "0", "char_00016802_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「へへ……この辺ならいいかな。どら、行くぜ……主……アタシのほんの気持\nちってやつだ……んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203104" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「おぉ……何だよ、ちゃっかりチンポ、デカくさせてるんじゃんか。さては、\nアタシが岩陰に連れ込むのを期待してたな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203105" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「まあ、主がアタシのオッパイをガン見してたのはいつものこととして……一\n緒に泳いでる時も、ウズウズしてたんじゃないのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203106" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「へへ……そりゃあ、待たせて悪かったなとしか言えねぇな。いいぜ……んっ\n、ふっ……アタシのオッパイ……存分に楽しんでくれよな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「まずは、挨拶代わりにぎゅっと……挟み込んで……真横から……押し潰して\nいくっ……んっ、んふぅぅうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ふふ……めちゃくちゃ熱いな……アタシのオッパイの中が、じっとり汗ばん\nでいくぜ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203109" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ちょうど、滑りやすくしておきたかったところだしな……どれ……ちょっと\n唾液も足していくからな……んぁぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「れろ……んっ、こんなもんか……？　さ、主……後はアタシに任せて、カラ\nダ……楽にしといてくれよ……んふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203111" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「はっ、んっ、うんっ、んふっ、んっく……はぁぅ……んっ、どうだ……？　\n晴れ渡った空の下でされるパイズリの気分は……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203112" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「んっ、うんっ、んふっ……アタシの乳首も……いい感じに勃っちまって……\nへへ、ますますスケベになっちまってるぜ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「おっと……だからって、いきなり押し付けたりはしないからな？　今は、じ\nっくり乳肉の感触を楽しんでもらうところからだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203114" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「はぁ……んんっ……チンポに浮き上がった血管をやさしーくなぞって……も\nっともっと血の巡りをよくしてやるからな……はんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「あっ、ふっ……んんっ、上……下……んくぅう……おっと、油断するとすぐ\nズレちまうね……んっ、はふっ、んむ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「気持ちいいからって、腰を引いたりしないでくれよ？　そうそう……むしろ\n、前に突き出すようにして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203117" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「アタシのオッパイを犯すつもりで……しっかりチンポをビンビンにさせてな\n……ちゃんと感じさせてやるからさ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「んむっ、あぁ……にゅぷんって……皮がめくれて……戻ってく……自分の手\nでするより細かい所までは行き届かないかもしんねーが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203119" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「この、ちょっと足りない感じも楽しんでくれたら……嬉しいね……えっ？　\n足りないなんてことはない……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「むしろ、気持ちよすぎてどうにかなりそう……ははっ、嬉しいねぇ！　そん\nなモン、お世辞でもやる気になっちまうじゃんか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「いいぜ……もっと、チンポを幸せにしてやるよ……くぅぅ……んっ、アタシ\nのオッパイマンコ……好きなだけ味わってくれ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203122" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ほぉら……またズッポリだ……主のチンポが、アタシのオッパイの中に全部\n飲み込まれちまったぜ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「まるで底なし沼みてぇだろ……？　チンポが抜け出せるかどうか試してみな\nよ……んふっ、くふっ……はーい、残念♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「がっちり中にめり込んでるからな……後はもう、主が射精するまでは逃げら\nれないぜ？　んっ、くふぅ……はぁぁ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「けど……この感じは……んんっ！　うんっ……！　んふぅっ、そうだな……\nアタシのオッパイも……かなりピリピリしちまってる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203126" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「バ、バカ……感じやすいとか……今言うこっちゃねーだろ……？　まぁ、否\n定はしねぇけどよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「んんっ、そろそろ……乳首も……くっつけてみるか……はぁっ、うんっ……\nあっ、んぁんっ！　や、やべぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203128" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「色っぽい声って……そりゃあ出るに決まってんだろ……こんな、はっ、うん\nっ……メチャクチャ敏感になってるんだからな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「乳首と……チンポを……揉みくちゃにしたら……おぉっ、おふっ……先端か\nらジーンって……痺れて来る……んくぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203130" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「んふっ、はっ、あぁ……バーカ……この程度で、アタシがやめるわけねーだ\nろ？　だいたい、主のチンポももうビクビクしてるぜ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「これは……んっ、そろそろ出したくなってる頃合いだよな……？　へへ……\nチンポの震え方でバレバレだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203132" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「もちろん、手加減はなしだぜ……このまま、一気に出すまでやっちまうから\nな……ふっ、んんっ、んくっ、はっ、んんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「そら……このパイズリに……んっ、もう限界が近いだろう……？　アタシに\n出してくれよ……オッパイの中にぶちまけちまいな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203134" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ふっ、はっ、んんっ、んふっ、くぅ……んっ、そうだ……アタシのオッパイ\nマンコにっ……精液……全部……出せっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ひゃはっ……！　出てきた、出てきたっ……んんっ、いいぜ……新鮮なザー\nメンシャワーの洪水だっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203136" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_07" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「こりゃまた……思いっきり出してくれるじゃねぇか……ふふっ、よっぽど溜\nめていやがったな？　勢いが弱まらねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ほうら……もうひと搾りだ。チンポの根元に圧を掛けて……中のザーメンを\n押し出していくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203138" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「んふっ……！　上等だ……へへ、オッパイがザーメンまみれだぜ……オス臭\nいにおいを撒き散らしてくれたなぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203139" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「どうだ、気持ちよかっただろ？　青空の下でのパイズリは最高だよなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203140" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「それにしても、もうちょっと耐えるかと思ったけど、あっさり出しちまった\nなぁ、主？　そんな弱チンポで大丈夫か？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「んっ……早さは関係ない……？　まだ、出せる……へへ……確かに、一発出\nしただけで萎えちまうような軟弱チンポじゃないってか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203202" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「なら、続けてしちまってもいいってことだな？　へへ……アタシも、もう少\nしこのチンポを楽しんでおきたかったんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203203" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「今ならたっぷり出された精液で……くふぅ……んっ、めちゃくちゃ滑りやす\nくなって……いい、感じだぜ……んくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、あ、ふっ……！　人のことを言えない……？　アタシが、感\nじやすく乱れてるって……？　はっ、バカ野郎……そんなの……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203205" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「はひっ、あっ、んふっ……自分でも、分かってるんだよ……そうだよ……こ\nの、チンポがオッパイに擦れる度に……気持ちよくなってんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「んっ、はぁ……谷間の中でビクって震えるチンポの反応が嬉しくて……んふ\nっ、いくらでもカラダが動いちまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203207" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「ふっ、はっ、このまま……しばらくパイズリしてたら……んっ、オッパイの\n日焼けが、間抜けな形になっちまいそうだな……ふふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203208" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「主のチンポが……タトゥーみたいに形になって……案外悪くなかったりして\n……な。ははっ、そこまでずっとこのポーズってことはないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「バカ言ってないで……もっとチンポに集中しなきゃな……んっ、ふっ、この\n跳ねるチンポを、どうどうと押さえつけて……んくっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203210" ]},
		{"command":[ "SETIMAGE", "0", "still_00016802_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「また……あっ、乳首……はふっ、擦れるぅっ……イッたばかりの敏感チンポ\nと、オッパイを、ズリまくるのっ……イイッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "イグニス・アルター" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、ふぁ……やべぇ……高鳴りが止まらねぇ……んくぅっ、もっ\nと……くっつけたい……こっちもぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_168_0203212" ]},

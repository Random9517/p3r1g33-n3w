{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0051" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「くっ……流石は、私が認めた男……今回ばかりは一旦負けを認めて差し上げ\nましょう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203101" ]},
		{"command":[ "SETCHARA", "0", "char_00026002_01", "1", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「それで……何がお望みなのです？　わ、私に……奉仕活動をしろと？　それ\nは……大きく出ましたわね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203102" ]},
		{"command":[ "SETCHARA", "0", "char_00026002_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「いいでしょう、私も誇り高き貴族の娘。例えどのような理不尽な命令であっ\nても、約束は約束……違えません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203103" ]},
		{"command":[ "SETCHARA", "0", "char_00026002_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「そんなに大げさに言うことじゃない？　何を言うんです。我が、身体を使お\nうというですよ？　軽く思われては困ります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203104" ]},
		{"command":[ "SETCHARA", "0", "char_00026002_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「さあ、こちらへいらして下さい。その……まさか、こんな人の多いところと\nいう訳には行きませんから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203105" ]},
		{"command":[ "SETCHARA", "0", "char_00026002_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ……しょっ、あぁ……何ですか……こんなにも大きくさせて……そんな\nに私のご奉仕に期待していたのですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203106" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ああ、わざわざ言わなくても結構です。これだけ勃起したオチンポを見せつ\nけられたら、それが答えも同然ではありませんか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「本当に欲望を隠せない人です。いいですわ……パ、パイズリご奉仕で……オ\nチンポを気持ちよくして差し上げますわ……んふっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、うぅ……岩場が砂浜を隠してくれているとは言え……私……\n結構、大胆なことをしていますわね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203109" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「こんな……水着をずらして……あぁ……お、おっぱいを丸出しにしてしまっ\nて……こんなところを見られたら……スプーン家が何と思われるか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203110" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ですが、務めを投げ出すことは、それ以上の名折れ……貴族のプライドにか\nけても、このご奉仕は行わなければなりませんわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁ……んっ、この特製サンオイルが……ちょうどいいローション代わりに\nなるのですね……あぁ……確かに、よく滑ります……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203112" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ、あぁ……オチンポが直接、乳首に当たって……んくぅっ……それだけ\nで、先端がピリピリ……しますわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はっ、んふっ、あぁ……私の胸……おっぱいが、こんなにもいやらしくひし\nゃげる所を……見せてしまうなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203114" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あ、あまりジロジロ見ないで下さる？　別に見張っていなくても、ご奉仕は\nちゃんと致しますから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「み、見られることも奉仕のうち……んくぅ……そ、そう言われましたら、し\nて差し上げるしかありません……んぅぅ……くっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んふっ、はぁっ、ああ……人の声が……少し届いて来ています……も、もし\n、こっちに来たりしたら……水着を戻して……んっ、でも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203117" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あぁっ、こんなに、みっちりオチンポを挟んでる状態で、とてもそんな時間\nは……あぁ……んっ、は、早く済ませないと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁっ、んっ、あっ、ふっ……いいんですか？　こうして……んっ、パイズ\nリで……オチンポを震わせて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203119" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「フェ、フェラも……？　んっ、た、確かに……パイズリだけだと、時間が掛\nかり過ぎるかも知れません……し、失礼します……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はむぅっ、んっ、ちゅぷぅぅぅ……あぁ……んぷっ、く、咥えてひまいまひ\nたわぁ……じゅぽっ、んっ、オチンポの味ぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203121" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んりゅぷっ、ぁっ、ふっ……これを味わうと……私も……何だか、身体が熱\nくなってしまって……んっ、ふっ、ちゅぷっ、んちゅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「いけません……れろ、これは、あくまでもご奉仕なんですから……私が楽し\nんでいるなんてことは……あっては……んじゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203123" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「別に……いい？　んっ、一緒に楽しむのもご奉仕……そんな、言っておきま\nすが、私は楽しんでいる訳ではありませんのよっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203124" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「これは、あくまでも……んじゅぷっ、負けたことによる代償で、仕方なく…\n…身体を差し出しているのであって、じゅぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「決して、夢中でオチンポをおしゃぶりして……パイズリでおっぱいが気持ち\nよくなっているなど……あ、ありませんからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んふっ、はっ、あっ、んじゅぷっ……あぁ、熱いです……んっ、こんな陽の\n高い場所で……私……オチンポ舐めちゃってますのぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203127" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「じゅぷっ、んちゅぷっ……こんな姿を両親に見られたら……私は……も、も\nうっ、はぁ……んっ、あぁっ、んっ、じゅぷっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んんっ！？　あっ、んふっ……もう、先端から少しお汁が滲んで来ました…\n…ふふっ、やはり私のご奉仕が上手なんですのね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203129" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「当然です……貴族たるもの、どんなことにも精通していなければなりません\n。例え、それがオチンポへのご奉仕でも……例外はないのです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203130" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「じゅぷっ、んんっ、もっと……ぎゅっとおっぱいをめり込ませて……縦にズ\nリズリ……横にもグリグリっ……はぁ、あっ、びくびくしてます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203131" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……んふっ、そろそろ出したくなっていらっしゃいますのね？　は\nぁ……ちゅぷっ、どうされるおつもりですの……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203132" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ、じゅぷっ、このまま……口の中に出す……？　んぅっ、私に……貴方\nの精液を飲ませようと……そんな傍若無人なことを考えてますのね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「じゅぷっ、この身に逆らう術はありません……どうか、射精なさって下さい\nっ……んっ、じゅるっ、ちゅぷっ、んじゅうぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203134" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んんんんんっ……！　んふっ……ふぶっ……！　あっ、んむっ……れてっ、\nるっ……せい……えきっ、んんっーーーっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203135" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_07" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ、んっくっ、んくんっ……んふっ……これを飲まないと……終わらな…\n…んっ、こくんっ、んっ、んっく……んふぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203136" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、ぷぁっ……けほっ、けほけほっ！　い、勢いがありすぎま\nすわっ……！　危うく喉に詰まらせるところでしたわ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203137" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「全部飲んだ……？　と、当然です。どんなことでも万全にこなす……先程か\nら、そう申し上げている筈です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「な、何を頭を撫でていますのっ！？　別に、これは、そういう務めであって\n、そんなねぎらわれるようなことでは……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203139" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ま、まぁ、悪いとは言いませんが……とにかく、お役目を果たしました。満\n足されたのなら、それで結構です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ちょっ……どうして、まだオチンポを大きくさせたままなのですかっ、あん\nなにいっぱい出したでしょうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「一発くらいでは全然って……なるほど……そうですか。これは、私に対する\n挑戦とみなしてよろしいのですね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「いいでしょう……しっかり、貴方が満足されるまで、パイズリ……続けさせ\nていただきますわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ、はぁ……ふっ、んくっ……それにしても、この硬さ……んんっ、おっ\nぱいの中で……こんなにも存在感があるままなんて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203204" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「こうして、肌を重ねれば重ねるほど……んっ、中で大きくなっているような\n気がしてしまいます……そんなことはない筈なのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ごくっ……んっ、はぁ……また……口の中に唾液が溜まって……んっ、舐め\nた方が嬉しい……ですわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203206" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「し、仕方ありませんわ……貴方が、どうしてもと仰るみたいですし……そこ\nまで言うのでしたら……フェラチオも、もう一回……ちゅぷ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203207" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ぴちゃ、んちゅっ……はぁんむ……あぁ……精液の味がまだ残っています…\n…苦くて、ドロドロで……生臭くて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203208" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「美味しくなんかないですのに……ちゅるっ、何故か……オチンポと一緒に味\nわうと……んっ、自然に舌が動いて……あぁ、私……何を……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んっ、分かっています……おっぱいも……ちゃんと、使いますから……んふ\nっ、寄せて……押しつぶして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203210" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「くぅ……乳首が、一層敏感になって……はぁ、破廉恥なことだと意識するほ\nど……この、擦れる感じを味わいたくて……んくぅぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203211" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ、んふっ、ずりゅっ……んむっ……あぁ……もっと強く、もっと激\nしくぅ……私のおっぱいが、いやらしく歪んでますの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203212" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ちゅぱっ……はぁ……こんなに下品にオチンポを頬張って……りゅぷっ、一\n族の誰も行わないような破廉恥なことを私は……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あぁ……んっ、はっ、気持ちいいですか……んっ、はい……私も……オチン\nポの熱を、直接感じて……んんっ、おっぱい感じています……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203214" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「皮の繋ぎ目のところ……ずっとプルプル震えていて……ああ……弱い場所な\nんだって……教えてくれていますの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203215" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んちゅぅぅ……ちゅぅっ、ほら……こうして吸われると……よろしいでしょ\nう？　んっ、私も……怯えてた頃とは違いますわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203216" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「さあ……今度こそ、んっ、満足いく射精をなさって下さい……私のおっぱい\nの中で……溜まったものを……いっぱいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203217" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「この……開放的な青空の下でっ……貴族の娘である私のパイズリご奉仕でっ\n……達することができることを光栄に思うのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁっ、んぁっ、あぁ……震えていますっ、もうすぐですっ……私\nも……あぁっ、気持ちが高ぶって……あっ、あぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203219" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「このままではっ……おっぱいでイッてしまいますっ……！　ですからっ、貴\n方もっ、早くっ……射精なさってぇっっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んんんっ！　むぶっ……あふっ、あっ、んむっ、んぐっ、れてっ、まふわっ\n……またっ、射精……んふぅぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203301" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んぐっ、こくんっ……まだ、こんらに残ってる……あぁ……んむっ、勃起し\nているわけですわ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203302" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「じゅるっ、んちゅぅぅ……少しずつ、飲まないと……むせて……しまいまひ\nゅから……んっ、こく……んくん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ちゅるる……あと少し出そうですか……？　はい……吸い出したら……終わ\nりですから……んちゅぅぅぅ……んはっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203304" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「はふぅ……あぁ……今度はよろしいですね？　もう、後は勃起なさってても\nご自分で処理なさって下さい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「それにしても、勝負の代償に身体を求めてくるとは……これが庶民のやり方\nなのですね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203306" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「えっ……？　違う……？　海の家の手伝いをして欲しかった……？　なっ、\nだって奉仕活動と仰ったではありませんかっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「奉仕にそんな意味はない……そんな……もしかして私、とんでもない勘違い\nを……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「お役目は果たせた……そ、そうですよね！　私のご奉仕は無駄ではありませ\nんでした！　そういうことですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203309" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「また頼む……？　それは……ふ、ふん、また勝負に負けたら考えてあげなく\nもありません。ですが、今度は簡単に負けませんわよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203310" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ひゃんっ！　んぁっ……おっぱいと顔にっ……精液……いっぱい出されてっ\n……んぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203401" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「んぁぷっ、まだこんなに残してましたのね……んっ、勃起したままなのも納\n得ですわ……んはぷっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203402" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「この粘り気……肌に触れると、本当に生命力を感じます……こんなものを中\nに受けたら……ごくっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「ちゅぷっ……あふっ、この味に慣れると……もう、これしか考えられなくな\nりますわね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「あ……射精も落ち着かれたみたいですわね……いかがでしたか？　私のご奉\n仕……ご満足されましたか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203405" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「そうですか。それは、何よりです。私としても、手を抜くわけにはまいりま\nせんから。しっかりと務めさせていただきました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203406" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「えっ……本当は海の家の手伝いをしてもらうつもり……？　ど、どういうこ\nとですか。大分話が違うようでは……私が勘違いを……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203407" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「で、ですが！　戦いに負けての代償と言えば、か、身体を使っての奉仕とい\nうのが……て、定番なのではないかと！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203408" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「うぅっ、下々の世界に慣れて、感覚がおかしくなってしまったのですか……\n？　私としたことが……一生の不覚！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203409" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アンドレッテ" ]},
		{"command":[ "SETTEXT", "「こっちでも問題なし……ふふん、問題ないなら構いませんわ！　えっ……ま\nた次も？　それは……か、考えさせて下さいませ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_260_0203410" ]},
		{"command":[ "SETIMAGE", "0", "still_00026002_01_19" ]},

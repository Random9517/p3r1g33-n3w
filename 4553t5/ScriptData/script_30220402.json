		{"command":[ "PLAYVOICE", "v2_022_0404123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「お手入れは完璧だよ……？　それでも……そうやってまじまじと視線を意識\nしちゃうと……はぁんっ、ゾクゾクしちゃうね……」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00002204_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「はっ、うんっ、あぁっ、あぁ……見て……ボクがおっぱい……ぷるんって揺\nらしながら、浅ましく腰を振ってるとこぉっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「オチンポの硬いとこっ、ごりゅごりゅして欲しくてぇっ……はひっ、へこへ\nこみっともなく腰振っちゃってるの……恥ずかしいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「そうだよ……普段は、研究一筋で……男になんて目もくれない感じだったの\nにぃ……でも、オスのオチンポ知っちゃったからぁ……」", "NORMAL" ]},

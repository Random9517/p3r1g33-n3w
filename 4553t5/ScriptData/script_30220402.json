		{"command":[ "SETIMAGE", "0", "still_00002204_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「行ったり来たりさせてるだけで……気持ちいいのに……ぬちゃぬちゃ音がし\nてぇ……感度も高まっててぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「あひっ、あっ、あぁぉっ！　腰振り……止まらないっ、オマンコ……悦んで\nっ……オチンポにむしゃぶりついちゃうっ……んぁぁっ！」", "NORMAL" ]},

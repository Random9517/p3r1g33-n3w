		{"command":[ "SETIMAGE", "0", "still_00002204_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「はっ、あんっ、あぁんっ……こんな……気持ちよくされたら……もっとサー\nビスしてあげなきゃって……なっちゃうよね……」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00002204_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「あぁ……ちゃんとおねだりしないとダメだよね……ご主人様ぁ……雌奴隷の\n珠緒が……今からオチンポに媚びさせていただきます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404108" ]},
		{"command":[ "SETIMAGE", "0", "still_00002204_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「どうか、この太いオチンポ様を……はしたない珠緒のオマンコが咥え込むこ\nとをお許し下さい……お願い……しますぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「あぁ……ご主人様、優しい……もうＯＫを出してくれるなんて……はひ……\n失礼します……んっ、あっ、はぁぁぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「あぁぁ……ずぶって来たぁ……あぁっ、待ってたオチンポぉ……はぁっ、あ\nぁぁぁんっ……！　ハマっただけで……軽イキするぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404111" ]},
		{"command":[ "SETIMAGE", "0", "still_00002204_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「くぅぅぅん……あぁ……溶けたバターみたいに……滑り込んでいく……奥ま\nで……ずっぽりぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「んんっ……あふっ……熱い……オチンポぉ……オマンコの中が……あっとい\nう間にいっぱいになっちゃった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00002204_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「中……どうかな……んふっ……ボクのオマンコの感触……悪くない……よね\nぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「ふふっ……それならよかった。これで、気持ちよくないユルマンだなんて言\nわれたら……いくら奴隷の立場でも傷つくからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404115" ]},
		{"command":[ "SETIMAGE", "0", "still_00002204_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「それじゃあ、ご主人様の期待に応えるためにも……誠心誠意……心を込めた\nオマンコピストン……させてもらうね……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「はぁっ、あっ、んっふっ、はんっ……うんっ、あっ、んんっ、んくぅっ……\nあぁ……太いオチンポ……いっぱい擦れるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404117" ]},
		{"command":[ "SETIMAGE", "0", "still_00002204_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「しっかりお腹に力を込めて……キュッと、オチンポをマン肉で挟み込んで…\n…ザラザラしたヒダを擦り上げていくぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「ずっぷっ、ぬぷって……スケベな音をさせながら……ふっ、んふっ、身体…\n…上下に揺らしてっ、はぁっ、おっぱいもぷるぷるさせるぅっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「ふふっ……すごく見られてる……オチンポとオマンコが繋がってるとこと…\n…やっぱりおっぱいが揺れるとこが……一番気になるんだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404120" ]},
		{"command":[ "SETIMAGE", "0", "still_00002204_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「いいよ……自慢のおっぱいだからね……ご主人様になら、はしたなく揺らし\nてるとこ……もっと見て欲しい……あっ、ふっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「んっ、んふっ、あんっ、はっ、こうして……両手を頭の後ろに組んでると…\n…もう、何もかもを見せちゃってる感じだよね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404122" ]},
		{"command":[ "SETIMAGE", "0", "still_00002204_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},

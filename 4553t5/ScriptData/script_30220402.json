		{"command":[ "SETIMAGE", "0", "still_00002204_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「くぅんっ……もっと、スケベに腰を振ればいい……？　いいよ……ボクは、\nキミ専属の淫らな踊り子だからね……」", "NORMAL" ]},

		{"command":[ "SETIMAGE", "0", "still_00002204_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「ひゃふっ……！　あんっ、もちろん……おっぱい……乳首もご主人様のもの\nだからぁ……好きにしていいからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},

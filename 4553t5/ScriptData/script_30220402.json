		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「ずっとオチンポをお預けにされて……オナニーも禁止されて……今日、ここ\nで……やっと疼きを治めてくれるのがキミなんだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_022_0404106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「ふふっ……すごいね……あっという間にギチギチに勃起してくれてる……見\nてるだけで口の中がよだれでいっぱいだよ……」", "NORMAL" ]},

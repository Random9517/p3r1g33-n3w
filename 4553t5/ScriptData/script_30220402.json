		{"command":[ "PLAYVOICE", "v2_022_0404125" ]},
		{"command":[ "SETIMAGE", "0", "still_00002204_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "珠魚" ]},
		{"command":[ "SETTEXT", "「はんっ、んぁんっ、はっ、あぁっ……硬いオチンポっ……すごいっ……！　\nごりゅって……ヒダヒダ、抉ってくる感じぃ……」", "NORMAL" ]},

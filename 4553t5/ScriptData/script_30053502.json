		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふふ……ようこそ、ウチの城へ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504101" ]},
		{"command":[ "SETCHARA", "0", "char_00000535_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ここはどこかって？　時間城ですよ。もっとも、以前の女王が支配していた\n時間城ではなく、新たなる女王、ウチが支配している城ですが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ええ、ええ。今や時間城の主はウチです。クリスタルの力を得て……こうし\nてあなたをここへ呼び出すことできるほどになりました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「そこで女王就任を機に、改めてあなたを招待してご挨拶と……提案を、ね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504104" ]},
		{"command":[ "SETCHARA", "0", "char_00000535_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「もはや今のウチは以前とは大違いです。こうやってあなたをEDOから呼び\n出すことも造作もありません」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504105" ]},
		{"command":[ "SETCHARA", "0", "char_00000535_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「つまり……あなたがたにもう勝ち目はありません。ウチが本気になってあな\nたたちを潰す前に、降伏したほうがいいですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504106" ]},
		{"command":[ "SETCHARA", "0", "char_00000535_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「今なら、ウチも寛容な心であなたたちの処遇を考えてあげます。あなたたち\nには散々苦汁をなめさせられましたが、それも昔のこと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「まあ、ウチに降ったとしても、あなたの処遇はさほど変わりませんが……ウ\nチの下でせっせと働いてもらいますから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504108" ]},
		{"command":[ "SETCHARA", "0", "char_00000535_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ん……？　なんです、その顔。それじゃあ今と変わらないって、それは、降\n伏した人間が前と同じ待遇なだけで感謝するべきです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「え……ちょっ、なんでにじり寄って来てるんですか。ちょっと、止まりなさ\nい、止まれ、え……わっ、きゃあっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504110" ]},
		{"command":[ "SETCHARA", "0", "char_00000535_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んん……な、なにをするですか……んっ、あっ、こら、後ろから……ウチの\n身体をまさぐるな、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504111" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_02" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「あうっ、あっ、今と変わりないなら意味がないって……んんっ、あっ、んっ\n、ちょっと、硬いものが当たってるんですが……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふああああっ！？　ちょっ、ちょっと、本気、本気でするですか？　ウチ、\n女王ですよ、んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んんんっ、あっ、あっ、本当に、入って……あっ、あんっ、ああっ、あくう\nっ、んっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「これ、大き……んっ、あんっ、ああああっ！！　ふううっ、女王に、女王の\nウチにこんな、あうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「後ろから、ずぷずぷされるの、ダメっ、あっ、んっ、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504116" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_35b_0000", "ev005_35b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふうっ、うっ、んっ、あなた、調子に乗らないで……んっ、あっ！！　人を\n、人を呼びますよ……んうっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ひうううううっ！！　あっ、あああっ、んっ、うっ！！　んっ、激しく、さ\nれたら、あっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふうううっ、うっ、そんな、押しつぶすみたいに、あっ、んっ、んんっ、あ\nんっ、あああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、ウチの、言葉を……んっ、あっ、あんっ！！　遮るみたいに\n、オチンポで、突かない、でっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ、うっ、オマンコがきゅって締めつけて来てるって、んっ、はあっ、\nあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「それは、あなたが動くから、あんっ、あっ、あああああっ！！　くうううう\nっ、んっ、奥、奥、ダメ……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ダメって言ってるのに、んううううっ、あっ、あああっ、あくうっ！！　そ\nんな、ごりごりって、んうっ、はっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ああああっ、当たってる、んっ、ウチの一番奥に、オチンポの先端が、ごつ\nごつって当たってる、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んぐっ、うっ、あっ、あああああっ！！　ダメ、こんなのダメ、こんなのさ\nれたら、んんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ウチ、ウチ……あなたのオチンポで、気持ちよくなっちゃう……んんっ、あ\nっ、あうっ、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、女王なのに、ウチ、変わったのに、あなたのオチンポで……\nふうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「あああっ、それ、激しくするのダメっ！！　ひううっ、うっ、中、ごりごり\n、ごりごりって擦れて、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「こんな、後ろから入れられて、ふうううっ、んっ、突かれて、んんっ、気持\nち……よく、なってる、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ひああああっ、体重かけるの、ダメです、んっ、あっ、押しつぶされて、お\n腹の奥、つぶされて……あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「頭の中までぐちゃぐちゃにされてるっ、ああああっ、あんっ、オチンポ、オ\nチンポのことしか、考えられなくなってる、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「はあっ、あっ、んっ、身体、熱くなって、オチンポでかき混ぜられて、んっ\n、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ああああっ、あっあっあっ、ダメ、本当に、ダメです……これ、頭の中まで\n……ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「オチンポで突かれてる！！　女王なのに、女王の頭の中まで、オチンポで突\nかれて、あっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ウチ、こんなのされたら、あっ、んっ、あああっ、あっ、んっ、気持ちいい\n、んっ、気持ちいいことしか……ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「オチンポのことしか、考えられなくなる、んっ、あっ、あああああっ、あっ\n、もう、もうだめ、あなたのオチンポで、ウチ、ウチ……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_09" ]},
		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「イく！！　イっちゃう！！　女王がオチンポでイっちゃう、んんんんんっ、\nイっくうううううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「はああっ、あっ、中に、んっ、中にどくどくって精液が……んふうっ、ふっ\n、あんっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ウチのなかに、注がれてる……あなたの精液、全部注がれてる……はっ、ふ\nっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「こんな……こんなにされてるのに、気持ちいい……んっ、ふううううっ、オ\nチンポから、注がれて、気持ちいい……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んんっ……終わったんだから、もういいでしょう……離れて……んっ、あっ\n、なぜ、また硬くして……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「もう軽々と呼び出さないように、徹底的に分からせるって……あっ、んっ、\nんんっ、ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「分かりました、分かりましたから！！　もう、呼び出したりしませんから、\n待って、んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、信じられないって、酷いっ、あっ、んんっ、ふうううっ！！\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504204" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_35b_0000", "ev005_35b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「じょ、女王の名に誓って、しませんからっ、ふああああっ、あっ、奥、出さ\nれた中、かき混ぜないで、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んくううううううっ、うっ、あっ、信じるけど、それはそれとしてもう一回\nって、ふうううっ、そんなの、んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「やあああっ、奥、入れたまま腰動かしたら、んんっ、はっ、あっ、また、ま\nた頭の中がオチンポだけになって……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、あんっ、あくうっ！！　こんな、こんなの女王らしくないのに\n、んっ、それでも……あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「あなたのオチンポが……気持ちいいっ！！　ふうっ、うっ、オマンコの中、\n往復するたびにごりごりってこすられて、ふううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「お腹の中、えぐられて……あっ、ああっ、それ、その動きっ！！　んんんっ\n！！　ウチの中、あなたのオチンポでいっぱいになってる！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504210" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふううううっ、デカくて、太くて、硬いオチンポで、ウチの中いっぱいにさ\nれて……ふああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「頭の中まで、ずぽずぽされて、なにも考えられなくなってる！！　あんっ、\nあっ、あっあっあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふううううううっ！！　ああっ、あんっ、んっ！！　凄い、こんなの、こん\nなことされたら……あっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504213" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「はっ、あっ、どろどろの精液が、いっぱい……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504302" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふうううううっ……女の……ウチの中にこんな注いで……妊娠させる気です\nか、あなたは……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んくうっ！！　妊娠って言葉でまた精液が……どれだけ興奮しているんです\nか……もう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「女王としての威厳が形無しです。結局、こんな場所でしてしまってるし……\n悪い人ですね、あなたは」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「まあ、だからこそ一番に挨拶をしたのですけれど……意味が分からないなら\nいいです。この朴念仁」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ともかく、ウチは自分の意思を示しましたからね。今度はあなたがそうする\n番です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「とはいっても、こんな風に中出しされてるのが答えですけれどね。え、どう\nいうことって……子供が欲しいんでしょう？　あなたとウチの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふふ……でも、それもいいかもしれませんね。そうなるとあなたは女王の夫\n、つまり王配になります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「もし……子供ができていたら、逃がしはしませんよ、あなた？」", "NORMAL" ]},

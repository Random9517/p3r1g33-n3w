		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「んっ、まだ出してるのですか……もう……でも、そんなあなただからこそ…\n…いえ、なんでもないです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「まあ、いいです。今回は女王の寛容さでもって許してあげましょう。あなた\nも、ウチに興奮したってことでしょうし」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「え、じゃあまたしたいって、馬鹿ですか、あなたは！！　あまり調子に乗る\nものじゃないです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504407" ]},

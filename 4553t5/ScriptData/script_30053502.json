		{"command":[ "SETTEXT", "「んくうっ！！　オチンポもまた震えて、ウチの中に出したがってるの、分か\nる、あっ、ああああっ、ぐりぐり、するの、ダメっ……！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「オチンポの先端押しつけてぐりぐりするの、ふううううっ！！　そんなこと\nされたら、オマンコが締めつけて……あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、うっ！！　ああっ、あっ、イく、イく、あなたのオチンポで、\nまたウチ、イく……っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504217" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「イかされるっ！！　あああああっ！！　あなたも、あなたもイって、ウチの\n中に精液吐き出してっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふああああああっ、あっ、イっく、イっく、オチンポでイっく！！」", "NORMAL" ]},

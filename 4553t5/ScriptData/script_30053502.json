		{"command":[ "SETTEXT", "「あくうっ！！　オチンポが抜けて……んんんっ！！　ふああああっ！！　ウ\nチの身体に……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504401" ]},

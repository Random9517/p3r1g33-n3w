		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「お尻と背中が、熱い……んっ、ふっ、あうっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3504403" ]},
		{"command":[ "SETIMAGE", "0", "still_00000535_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ……満足しましたか……？　女王であるウチを襲って、中出し\nして、ぶっかけて……散々好きにして……」", "NORMAL" ]},

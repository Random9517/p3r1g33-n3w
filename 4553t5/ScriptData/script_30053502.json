		{"command":[ "SETNAME", "アナザー・オボロ" ]},
		{"command":[ "SETTEXT", "「ひゃんっ！？　あっ、んっ、ああああっ、そんな、ティッシュみたいにぶっ\nかけてきて、あんっ、あああっ！！」", "NORMAL" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふふ……来たね。なんの用かだって？　ここはそういうことに使われる場所\nだろう？　分かっているんじゃない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804101" ]},
		{"command":[ "SETCHARA", "0", "char_00001808_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「私が君にそういう想いを抱いていたって……いいだろう？　それとも、私と\nするのは嫌だとでも？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804102" ]},
		{"command":[ "SETCHARA", "0", "char_00001808_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「そんなわけはない？　ならいいじゃないか。君も、私としたいだろう？　た\nまに、私をじっと見てるの、気づいているよ……ふふ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804103" ]},
		{"command":[ "SETCHARA", "0", "char_00001808_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ほら……私のこういう姿、見たかったんだろう？　いいんだよ、君のしたい\nように、私を抱いて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804104" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「んっ……ふっ……勃起オチンポ……間近で見ると、凄い物だね……こんなの\n、入るかな……いや、なんでもないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804105" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ほら、好きにしていいんだよ……私のオマンコに、君のチンポを……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「あっ、はっ、入って、来た……んんんんっ！！　これ、思ったよりも、んっ\n、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804107" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふっ、あっ、大きい……私の中、ごつごつって、削ってるのが、分かる……\nんっ、はあっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804108" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev018_08b_0000", "ev018_08b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「んんっ……奥まで、届いて……君のオチンポの形も硬さも分かる……ふうっ\n、うっ、んっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふうううっ、全部、入ったね……んっ、君と私は、深いところで繋がったん\nだ……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふふっ、ふふふふっ、計画、通りだ……ふうっ、ふっ、私と交わったことで\n、君にも私の体質が伝染する……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「なにをって顔をしているね……白々しい、んっ、私の登場シーンをあれだけ\n台無しにしておいて……んんっ、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「オチンポを動かさずに話を……んっ、これはね、報復だよ。私と交わって、\n君を不幸にする……ふふふっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「動かないでって、言ってる……んっ、ふっ、これでもう、君は私と同じ不幸\n体質になったんだよ……んんっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「あっ、うっ！！　だから、動くなって、んんっ、それに、なんでそんな、嬉\nしそうな顔を……あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「え、もうこっちのグリムロックやアナザーと交わってるから、今更って……\nんんっ、あっ、くうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「むしろ、私と交われて嬉しいって……そんな、あっ、んっ、そんなこと言わ\nれても、私はほだされ……ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「さっきから、喋ってるときに、動いて、んっ、あっ、あんっ！！　ふううう\nっ、もう、こんな、こんなの、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「計画が、台無しだ、んっ、うっ！！　あんっ、そもそもいつも仕事や出動で\n不幸な目に遭ってるから変わりないって……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「うう……不幸、不幸だ……せっかく身を挺して実行した計画が無意味だった\nなんて……私は不幸……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「なに、をっ、んっ！！　え……そんな不幸、気持ちよくして吹き飛ばしてや\nるなんて、んっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「そんなむちゃくちゃな、あっ、んんんっ！！　んっ、確かに、嫌じゃないけ\nど、こんなの、んくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804122" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「こんなの、思っていたのとは違うし、んっ、ふっ、君だって……打算ありき\nで女性に求められるの、嫌だろうに、んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「自分は構わないって……んうっ、むしろ打算があっても求められると嬉しい\nって……んっんっんうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「んっ……君、本当に不幸だったんだね……私なんかと交われるのが幸運だっ\nて思えるぐらいに……あんっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「そんな風に自分を卑下するものじゃないって……ふっ、うっ……ふふ、言う\nのは簡単だけどね、不幸ってものはそうさせるのさ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「自分はいま幸せだって……んっ、私と繋がれるのが幸せって……ふううっ、\nんっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「そんな、そんなこと言われても、私は……んっ、ふううっ！！　喋ってる間\nに、動かないでって言ってるのに、んくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「気持ちよすぎて腰が動くって、少しは我慢、あんっ、我慢できないの、んっ\n、あっ、あっあっあっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「本当に、本当に気持ちよさそうな顔……んっ、ふうううっ！！　ううっ、こ\nんな顔されたら、信じたくなっちゃうじゃないか……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「本当に……本当にいま君は幸せで気持ちいいって、信じていいんだね……ん\nっ、私と繋がって、気持ちいいって、嬉しいって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「んくうっ！！　んっ、な、なら……分かった、いいよ、もっともっと気持ち\nよくなって、私も……その、気持ちよく、して……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、激しくて、ふうううっ、あんっ、あああっ！！　凄い、奥ま\nで、オチンポが届いて、ふああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804133" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「頭の中まで、オチンポでごつごつされてるっ！！　んんっ！！　お腹、お腹\nが溶けちゃう、オチンポで溶けちゃう。んううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ああああっ、オマンコの中で、オチンポが膨らんでる、ふっ、うっ、出すん\nだね、ザーメン出すんだね……いいよ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「君が本当に幸せなら、私の中に、全部出していいよ……んっ、あっ、私も、\n私も君のオチンポでイくから、ふううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ああっ、イく、イく、イっく、んんんんっ！！　ふあああああああああああ\nああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804137" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「んくううううっ！！　本当に、ザーメン出されてるっ！！　私のお腹の中に\n、君のザーメンいっぱい出てるっ！！　ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「あっ、あああっ、これ、確かに気持ちいい……んっ、不幸なはずなのに、気\n持ちいい……んっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804139" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「満たされてる感じがする……ああ、私がこんな風に思っていいのかな……ん\nっ、幸せだなんて……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804140" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「んんっ、君のオチンポ、全然萎えていない……硬いままだね……えっ、私に\n分からせるって、なにを……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804201" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ああっ、さっき出したばかりなのに、もう二回目が……んっ、あっ、あんっ\n！！　気持ちいいのを分からせるって、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804202" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev018_08b_0000", "ev018_08b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「不幸じゃない、気持ちいい、幸せを分からせるって、オチンポで分からせる\nなんて、そんな、そんなの、あっ、くううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「本気……なんだね、こんな私を、不幸な私を、本気で、オチンポで幸せに…\n…あっ、ああっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「んっ！！　伝わってる、オチンポから、本気が伝わってきてる、ああっ、は\nっ、あうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「こんな、うまく行かなくて不幸なはずなのに、私のオマンコ、喜んできゅっ\nきゅって締めつけてる、ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「中出ししてきたオチンポのこと、喜んで締めつけてる……ふうううっ、んっ\n、んんっ、はああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ、お腹の奥で、君のこと、求めてる……気持ちよくしてくれる\nオチンポと、君自身のことを……ふううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「お腹がきゅうきゅうなってる、君が、幸せにしてくれるって、信じてきてる\n……んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「私自身も……信じたい……んっ、あっ、君が、私を……変えてくれるって、\n信じたい……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「だから、だからもっとして……不幸とか、そんなこと考えられないぐらい、\nオチンポでめちゃくちゃにしてっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「あああっ、あんっ、あっあっあっ！！　凄い、本当に、お腹の奥まで入れら\nれて、ふああああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804212" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「なにも、考えられないっ！！　オチンポのことだけ、オチンポから気持ちよ\nくしてもらえることだけ、あくうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「凄いっ！！　君のオチンポ、凄いっ！！　んくうっ！！　本当に、私の身体\n、変わってきてる……んんっ、気持ちいいことだけ、ふああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「気持ちいいことだけ、考えてる……んっ、あっ、あああっ、いま、不幸じゃ\nない、私、いま、気持ちいい、幸せ……ああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「君のオチンポで、幸せになってる……ふうううっ、あっ、あんっ、んっ、く\nうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「君も、私のオマンコで幸せになってるのね……んっ、ふっ、分かるわ……一\n回出されてるから、気持ちよくなってるの、分かる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「硬くて、太くて、熱くて……中で震えてる、イきそうなのね……私も、君の\nオチンポでイくから、君も……んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「私のオマンコでイって、いっぱい、幸せになって！！　あんっ、あああっ、\nあっ、イく、イく、またイっく！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「イくううううううううううううううううっ！！　ひあああああああああああ\nっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804220" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「あああああっ、また、中にいっぱい出てる！！　君の気持ちいいしるし、い\nっぱい出てるううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804301" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふうううううっ、んっ、あっ、私の中、満たされてる……君で、満たされて\nるわ……んんんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「はっ、あっ……確かに、これは不幸じゃない……むしろ、幸せ……君の言っ\nてること、分かった気がする」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「不幸にするためじゃなくて、幸せになるために繋がる……こんなに気持ちよ\nくて、嬉しくて、幸せで……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふふっ、自分がこんな風に思うだなんて、考えたこともなかった……不幸だ\n不幸だって、ずっと思ってた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804305" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「君が、それを変えてくれたんだね……素敵だ……こんな、人を不幸にしよう\nとした自分が恥ずかしい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「んっ……全部出し切ったんだね……私の中で、君の幸せを全部出してくれた\nんだね。ふふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804307" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「でも、私の不幸は筋金入りだからね。いまは幸せでも、多分またしばらくす\nれば不幸が強くなってくると思うんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「でも、君がこうしてくれれば、そのたびに幸せになれる。それを確信したよ\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804309" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「だからまた、私を幸せにして……でないと、私はまた不幸に戻っちゃうから\n……お願い、ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ああっ、オチンポが、幸せが抜けちゃう、なんで……ふあああああああああ\nあっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804401" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「私の身体に、ザーメンが……んああああっ、熱い、中も外も、あなたのしる\nしで染められてる……んっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふうううっ、私の肌、あなたのザーメンが塗りたくられてる……ああっ、こ\nんなのでも、幸せって感じてしまう……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ……本当に、私を幸せにしてくれたんだね、君は……んっ、ふ\nふっ、その顔……ここに来るまでは憎かったのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804404" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「いまはとても愛おしい……私を不幸から救ってくれた人……いや、違う、私\nを幸せにしてくれる人……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「ふふっ……でも、考えようによっては君は不幸かもしれないな……なんでだ\nって？　分からないのかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「だって、こうなったらもう、私は君を逃す気はないよ？　どんなことをして\nも、君の側にいるつもりだからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「私を幸せにしてくれた責任、取ってもらうからね……？　ふふふっ、絶対に\n逃がさないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「さしあたっては、定期的にこうやって幸せにしてほしいかな。もちろん、私\nも君を幸せにするから……一緒に、いっぱい気持ちよくなろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_018_0804409" ]},
		{"command":[ "SETIMAGE", "0", "still_00001808_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "グリムロック・ダーク" ]},
		{"command":[ "SETTEXT", "「愛してるよ……こうして面と向かって言うのは少し恥ずかしいね。でも、そ\nう思う。ああ、そうだ、私は今幸せだよ……ふふっ」", "NORMAL" ]},

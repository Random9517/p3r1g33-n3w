		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「隊長が直々にマッサージをしてくれるのか？　それはありがたいな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104101" ]},
		{"command":[ "SETCHARA", "0", "char_00004911_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「体力測定に参加したせいで、身体中が悲鳴を上げていてな……今すぐにでも\nリラックスしたかったところなんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104102" ]},
		{"command":[ "SETCHARA", "0", "char_00004911_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「なにっ？　まずは四つん這いになって欲しい？　そんなマッサージの方法は\n聞いたことないが……まあ、いいだろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104103" ]},
		{"command":[ "SETCHARA", "0", "char_00004911_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あっ……んあっ！　ま、待ってくれ、隊長……その、指がお尻の穴に当たっ\nてっ……んひぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104104" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「それにウェアが……オ、オマンコのところが破けて……これは本当にマッサ\nージなのか……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104105" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふぐっ、んっ！　んぅぅっ……！　オ、オイルを塗るためにウェアが邪魔だ\nったから破いただと……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104106" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「オイルを使うなんて聞いてないぞ！　それにこのオイル、なんだかヌルヌル\nして……ローションみたいだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、ダ、ダメだ……気持ちよくて、オマンコが濡れてしまうっ……あ\nっ、やめっ……あっ、あぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104108" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ、あっふっ……！　私の敏感なところばかり触ってっ……ふひっ\n！？　おっ、おぉぉっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……鼠径部のリンパを流すために触っているだけ？　だ、だっ\nたら、何故尻の穴を弄っているんだ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「肛門に触ることで、オマンコの締まりが良くなる？　ま、まさか……隊長は\n今から、私を犯そうとしているのか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104111" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「待て！　まずは話し合おう！　体力測定の件は、悪かったと本気で思ってい\nる！　だから許して……ふほっ！　おほぉ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「お、お尻の穴に深く指が入り込んでぇ……！？　あっ、あっ！　気持ちいい\nっ！　こんなの、排泄をしているみたいだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふっ！　んっ、はふっ！　い、今から私のオマンコにチンポをぶち込んで、\nオシオキをするだと……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104114" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「や、やめてくれっ！　オマンコは今、敏感になっているんだ！　チンポを挿\nれられたらおかしくなる！　だから……やっ、あっ！　うあぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「おほぉぉぉ～～～っ！？　チ、チンポが入ってくるっ！　隊長の極太チンポ\nがオマンコの肉をゴリゴリ削ってくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「これ、気持ちよすぎるっ！　気持ちよすぎて、頭がおかしくなってしまうぅ\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あっあっ！　ダ、ダメだっ！　このまま快感に流されては……チンポに抵抗\nしないとっ……おっ！？　おひょおぉ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「手足を動かそうとすると筋肉痛がっ……これでは身体が動かせない……！　\n隊長の好きなようにされてしまうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104119" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あっ！　あっ！　んっ、あっ！　隊長のぶっといチンポが出入りして、オマ\nンコえぐられてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104120" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev049_11b_0000", "ev049_11b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「奥に刺さるっ！　私の大事なところに、カタいのが何度も当たって……んひ\nぃぃぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふっ、んふっ！　ぐぐっ、ふんぐっ！　ローションを使わなくても、オマン\nコがヌルヌルになっているだと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あ、当たり前だっ！　敏感なところを触られていたら、誰だって濡れるに決\nまっているだろう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふーっ、ふーっ！　これならもっと奥まで挿れても大丈夫そうだと……！？\n　ま、待てっ……もうじゅうぶん、奥まで入って……ふほぉっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「おぉっ……おっ、おぉぉっ……奥に刺さるっ……子宮口にチンポの先っぽが\n入り込んでぇ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「それにお尻の穴にも、さらに深く指が入ってきている……！　オマンコだけ\nじゃなくて、アナルも犯されるだなんてっ……んぎっ！　んぐぅ～！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104126" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「おっ、あっ！　んぁっ、あっ！　パンパンされるの、気持ちよすぎるっ！　\nチンポを出し入れされるたびに、汁が溢れてくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「も、もう突かないでくれっ！　オマンコをえぐったり、お尻の穴をホジった\nりしないでくれぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「うぁっ、あっ！　あっあっあっ！？　お尻の穴なんて綺麗な言葉を使わない\nで、ケツ穴と言えだと……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「わ、分かった！　言うっ！　ケツ穴と言うから、もうやめっ……おぉぉ～～\n～っ！？　んおっ、おっ！　ほぉぉぉぉっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ケツ穴と言った瞬間、さらにチンポが激しく動いてぇ！？　お、奥のところ\n、何度も突き上げられているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「このままだと、子宮が潰れてしまうっ！　快感と筋肉痛が同時に襲ってきて\n、オマンコがヘンになってしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「おっ、ほぉっ！？　おっ、あっ！　んぁぁっ！？　こ、このまま膣内出しし\nて、ついでに孕ませてやるだと！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「待ってくれ、隊長っ！　今日は危ない日なんだっ！　お願いだから、膣内だ\nけは……！　おぉぉぉっ！？　あっ、あっ、おっ、おぉぉっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104134" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「チンポがオマンコの膣内で膨らんでいるっ！？　やめっ！　やめてくれぇっ\n！　本当に膣内だけは許してっ……んほぉぉぉ～～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「んひぃぃぃっ！？　隊長のザーメンが奥にっ！　し、子宮に出ているぅ！？\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104136" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_10" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「危ない日なのに、こんなにも出されてっ……！　このままでは、本当に妊娠\nしてしまうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104137" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ひぁっ、あっ！　あはぁぁんっ！　早く抜いてくれっ！　これ以上、赤ちゃ\nんの部屋に精液を注がないでくれぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104138" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「おぉぉっ！？　おっ、おほぉっ！？　注ぐなと言っているのに、さらに大量\nの精子が流れ込んでくるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「おっ、んおぉぉっ！　ダメだっ、もう気持ちいいことしか考えられないっ…\n…！　イクッ！　イクッ！　膣内出しされながら、オマンコイクぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あっ……あぁぁっ……子宮が熱いっ……隊長のザーメンでいっぱいになって\nいるのが分かるっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「こんなの、本当に妊娠してっ……な、なんだ？　オシオキとはいえ、好きで\nもない人に膣内出しはしないだと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104202" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ま、待ってくれ、隊長……それは本気で言っているのか？　私みたいな年増\nを好きだと……そう言っているのか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104203" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「本気にしていないなら、もっとオシオキしてやる？　待てっ！　隊長の気持\nちはよく分かった！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「だが、連続というのは私の身体がもたない！　イッたばかりで敏感だし、身\n体中は筋肉痛なのに……ひぃっ！？　またチンポが動いて……んおぉぉ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「おぉ～～～！？　おほっ、おっ！　んほぉ～～～っ！？　オマンコをパンパ\nンされながら、ケツ穴も出し入れされているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104206" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev049_11b_0000", "ev049_11b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「チンポの動きに合わせて、指が動いてっ……！　オマンコもケツ穴も、どっ\nちも感じてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「んふっ！　ふっ、あっ！　ふぁぁぁっ！　気持ちよすぎておかしくなる！　\nも、もう許して……んひゃぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ひゃ、あぁぁっ！　んっ、あっ、んぁぁぁっ！　今度は奥だけでなく、浅い\nところ……Ｇスポットのあたりもズリズリされてぇ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「そこを刺激されると、オマンコが蕩けてしまうぅ！　身体の力も抜けて……\nこのままでは、四つん這いの姿勢すら取れなくんってしまうぞ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「力が入らないなら、入るようにしてやる……？　はぁ、はぁ……！　そんな\nの、どうやって……おっほっ！？　んっほおぉ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「奥の奥までケツ穴に指が入ってくるぅ！？　ケツ穴気持ちよすぎて、身体が\n締まるっ！　排泄の快感で、肛門も締まってしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふほっ！　んおっ、おっ、おぉぉっ！？　浅いところを刺激されているのに\n、オマンコが締まるっ！　こんなの知らない！　味わったことないぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「うあぁぁぁっ！　あっ、あっ！　ひっあっ！？　ふぁぁぁぁ～～～っ！？　\nオマンコとケツ穴、どっちも弄らないでくれぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「こんなに感じさせられたら、全身の震えが止まらなくなってしまうっ！　気\n持ちよすぎて、頭がバカになるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「それに子宮に快感が募って、気持ちいいのが溢れて来るっ！　隊長に二つの\n穴を犯されながら、アクメしてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふっ！　はっ、んっふっ！　うぅぅっ！　チンポが膣内で膨らんで……た、\n隊長もイキそうなのかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104217" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「はぁ、あっ！　はぐっ、おっ、おぉぉっ！？　ま、また膣内に出すのか！？\n　危険日オマンコに、精液をびゅーびゅーするのかっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「それとも、私の身体に精液をかけて……！？　あぁぁぁっ！　もうどっちで\nもいい！　気持ちよすぎて、頭が働かないっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「はひぃっ！？　おっ、おっ、おぉぉっ！　チンポと指が激しく出入りして…\n…く、くるっ！　アクメくるっ！　オマンコイッてしまうぅぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104220" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「おぉ～～～～っ！？　おっ、おぉぉっ……！？　ま、また膣内に出ているっ\n……隊長のザーメンが、子宮に注がれてぇっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「腹の中がいっぱいになっているのに、まだまだ注ぎ込まれるだなんて！　お\nっ、おぉっ！　オマンコ苦しいぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「だが、隊長の精液ならイヤじゃないっ！　危険日だと分かっているのに……\nあ、赤ちゃんが出来るかも知れないのに、嬉しいと思ってしまうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104303" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あぁぁっ！　あっ、んぁぁぁっっ！　もっと注いでくれっ！　私の種付け…\n…いや、オシオキをしてくれっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「このまま隊長の子供を孕ませて欲しいっ！　お願いだっ！　ありったけの精\n子を、子宮に送り込んでくれぇぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふはぁぁぁ……あっ、あぁぁっ……すごい……精液で腹が膨れそうだ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104306" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「隊長のザーメンが子宮どころか、卵巣にまで届いているみたいだ……ふふっ\n。こんなの妊娠確定だな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「そ、それにしても、本当に私でいいのか？　その……他にも若くて可愛い子\nは、ごまんと居るだろう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「な、なに？　それでも私がいいのか……？　ははっ……そんなことを言われ\nたら、断れないじゃないか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「んっ？　オシオキはこれでおしまい？　ここからは子作りセックスをするだ\nと？　さ、さすがは隊長だ……絶倫すぎるな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「んはぁぁぁっ！？　チ、チンポが抜けてっ……あっ、あはぁぁっ！？　熱い\nっ！　ザーメンが身体にかかってりうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「隊長の濃い精液が、オマンコだけでなく身体中に……ふぁぁっ、あっ、あん\nんっ！　二回目なのに、なんて量だっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「それにこの匂い……あっ、はぁぁぁぁ……隊長の精液の香りで、オマンコが\n気持ちよくなってくるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104403" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「イッているのに、またイッて……あっ、あっ！　オマンコホジられていない\nのに、精液の匂いだけでイッてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104404" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「やぁぁぁっ！　み、見ないでくれ、隊長っ！　こんな年増女のはしたないア\nクメっ……んひっ！　おっ、おぉっ！　ふほぉ～～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104405" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_19" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「イクッ！　イクイクッ！　ケツ穴の感覚と隊長のザーメンの匂いで、何度も\n達してしまうぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104406" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふぅー……ふぅー……こんなオシオキをされるとは……は、恥ずかしすぎる\n……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「だが、悪いのは私だ……この罰を受けることで隊長の気が済むのなら、喜ん\nで受け入れよう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104408" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「そ、それに……好きだと言われたのは嬉しいというか……危険日だと承知の\n上で、膣内に出されて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104409" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふふっ……こんな幸せなオシオキなら、何度でも味わいたくなってしまうな\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1104410" ]},
		{"command":[ "SETIMAGE", "0", "still_00004911_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「おひょおぉぉぉっ！？　おっ、ほぉぉぉっ！？　んおっ！　おっ！　おぉぉ\n　ぉ！？　ま、また種付けされてますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1704301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あなたのチンポ、わたしのことを絶対孕ませるって言ってるみたいで……\n　あはぁぁぁんっ！　す、すごいですぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1704302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「こんなツヨツヨザーメンを子宮に流し込まれたらオマンコ屈しちゃう！\n　このチンポじゃないとイケなくなっちゃうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1704303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「そんなのダメなのに身体があなたを受け入れて……んひっ！　おっ、んおぉ\n　ぉっ！　おほっ！　んおぉぉぉっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1704304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「ひゃあぁぁっ！？　あんっ！　あはぁぁぁんっ！　腰の動きがどんどん速く\n　なってぇ！？　イッ、イクッ！　気持ちいいのきちゃいますぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1704219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「くひゅ、ふっ！　おっ、あっ！　んぁ、はぁぁぁっ！　イグッ！　イグイグ\n　ッ！　イケメンチンポでオマンコイかされちゃうぅぅぅんっ！」", "NORMAL" ]},

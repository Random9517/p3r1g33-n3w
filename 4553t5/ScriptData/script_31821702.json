		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETIMAGE", "0", "still_00018217_02_11" ]},
		{"command":[ "SETTEXT", "「くふっ……はっ、あっ……うぁ、あぁぁぁぁっ……オマンコがあなたの精子\n　でいっぱいになってます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1704306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ランニングの後なので、そこまで激しく運動できないかもって思ってました\n　けど……わたしの思い違いでした」", "NORMAL" ]},

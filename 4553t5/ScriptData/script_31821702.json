		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "SETTEXT", "「ふふっ……一緒に運動するのはあんなに渋ってたのに、こっちの運動はすっ\n　ごくやる気なんですね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1704101" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETIMAGE", "0", "still_00018217_02_14" ]},
		{"command":[ "SETTEXT", "「んんっ……んっ、あっ……ウェアが精液まみれになっちゃいましたね……\n　あっ、大丈夫ですよ？　ちゃんと洗えば問題ないので♪」", "NORMAL" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふあぁんんんっ♪　す、すごい、またこんなにいっぱい出てっ、あっ、くぅ\nんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETIMAGE", "0", "still_00018212_02_11" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんんっ♪　わたしも何度もいっちゃってますぅ……♪　ザーメン\nミルクがドクドクって注ぎ込まれる度、何回もっ、あっ、あぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETIMAGE", "0", "still_00018212_02_10" ]},
		{"command":[ "SETTEXT", "「やっぱり膣内出しはいいですね♪　お腹の奥がポカポカして、幸せが全身に\n広がっていくこの感じぃ……最高です……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「最後までしっかりおまんこでぎゅーって搾り取ってあげますからぁ……んぅ\nんっ♪　ぜーんぶ出し切っちゃってくださいねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んぅんっ♪　ふふっ、ほんとにチョコレート効果すごいですねっ……あっ、\nんんっ……いつもの倍以上出てるかもぉ……あぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……ん……すごかったぁ……本当に、頭の中真っ白になっ\nて蕩けちゃうかとおもいましたねぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――どうでした？　わたしのバレンタインチョコ、堪能してもらえましたか\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふふっ♪　お礼の言葉はもちろん嬉しいですけど……ホワイトデーのお返\nし、期待させてもらいますねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「別に高いものを買ってくれって話じゃないですってば。わたしのようなサプライ\nズを期待させてもらおっかなぁーって♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「甘くても苦くてもいいですから……わたしが蕩けちゃうような素敵なお返し\n、よろしくお願いしますねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},

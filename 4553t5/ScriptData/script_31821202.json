{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00018212_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev182_12b_0000", "ev182_12b_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「おかえりなさいませ、ご主人様♪　――ふふっ、どうです、中々様になって\nるでしょー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204101" ]},
		{"command":[ "SETCHARA", "0", "char_00018212_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「この服ですか？　それはほら、今日はバレンタインデーですから。チョコを\n作るにはそれっぽい衣装を着ないと盛り上がらないかなぁーと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「というわけで……はい、ハッピーバレンタイン♪　わたしの手作りチョコで\nすよぉー、喜んで受け取っちゃってくださいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あ、でももちろん義理ですよ？　わたしはほら、あれですから……あくまで\n義理チョコだということを、忘れないでくださいね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204104" ]},
		{"command":[ "SETCHARA", "0", "char_00018212_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほらほら、頑張って手作りしたんですから、早く箱を開けて食べてみてくだ\nさいよぉ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204105" ]},
		{"command":[ "SETCHARA", "0", "char_00018212_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――なーんて♪　ふふっ、中身が空っぽでビックリしました？　サプライズ\n大成功ー！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204106" ]},
		{"command":[ "SETCHARA", "0", "char_00018212_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「って、ああ！？　悲しそうな顔で帰ろうとしないでくださいよ！　流石にそ\nの反応はわたしの良心がじくじく痛みます！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204107" ]},
		{"command":[ "SETCHARA", "0", "char_00018212_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「本当のチョコレートはこっちに用意してますからぁ……改めまして、ハッピ\nーバレンタイ～ン♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204108" ]},
		{"command":[ "SETCHARA", "0", "char_00018212_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほらほら、隊長さんのだーいすきなおっぱいの間に、あまーいチョコを用意\nしてあげましたよ～♪」　", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――もちろんです♪　あなたの為に用意したんですから、好きにぺろぺろ舐\nめて味わっちゃってくださいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あぁん♪　ふふっ、わたしから誘惑しておいてなんですが、ほんと、なんの\n躊躇いもなくペロってきましたねぇ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204111" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "SETIMAGE", "0", "still_00018212_02_01" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんっ♪　おっぱいにチューチュー吸い付いて、隊長さんってば赤\nちゃんみたいになっちゃってますよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ああ、でも……んぅんっ♪　オチンポの方がもうこんなにギンギンにしちゃ\nって、全然赤ちゃんじゃありませんね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「わたしのオマンコに入れたいですか？　だったらほらぁ……言うことがある\nんじゃないですか？　おねだり、とかぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、甘いだけがチョコレートじゃありませんからね♪　ビターなわたし\nも堪能してもらわないとなーって♪　それで……おねだり、します？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――ふふっ、よくできました♪　素直ないい子には、あまーいご褒美をあげ\nましょうねぇ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんぅんっ♪　ふふっ、根元までぜーんぶ入っちゃいました♪　わた\nしのお腹、オチンポの形に膨らんじゃってる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204117" ]},
		{"command":[ "SETIMAGE", "0", "still_00018212_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「オマンコの中でそんなにヒクヒクさせなくても分かってますよ♪　いっぱい\n締め付けてあげますから、気持ちよくなっちゃってくださいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、んあっ、あぁんんっ♪　相変わらず大きくて太くてっ、あぁんんっ♪\n　簡単に子宮まで届いちゃいますねっ、んぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「オチンポが大きく反り返ってるからぁ、んんぅんっ！　ぐりぐりって腰を動\nかすと、おへその裏側に先っぽが当たるのも素敵、あぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほらほらぁ、隊長さんも下から突き上げてください♪　バレンタインなんで\nす、二人一緒にあまーく蕩けちゃいましょう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んぁんっ！　あっ、あぁんんっ♪　それぇ、ポルチオにオチンポくっつけて\nぐりぐりするのっ、やっぱり好きぃ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204122" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev182_12b_0000", "ev182_12b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、腰を振るのもいいですけど、チョコレートをぺろぺろするのはもう\nいいんですか？　わたしのおっぱいにまだまだ残ってますよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁんっ♪　おかしいですね、乳首にはチョコが付いてないはずなの\nに、どうしてちゅーちゅーって吸い付いてくるんですかぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、そんな切なそうな目をしなくても、駄目なんていいませんよ♪　ま\nた赤ちゃんみたいに、甘えてくれてもいいですからねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんっ♪　ふふっ、またオチンポもオマンコのなかでビク\nンってしてる……んっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「いっぱいわたしの好きなところを突いてくれてるからわたしも……んぅんん\nっ！　根元からオチンポぎゅ～ってっ、あっ、あぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「こうやってオマンコの中を全部グネグネさせるの、ほんとに好きですよねぇ\n♪　あっ、んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほら、また口が止まってます……あぁんっ♪　ふふっ、しっかりチョコレー\nトを舐めれて、いい子いい子♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あぁんんっ♪　オチンポ、またビクンってしてっ、んんぅん\nっ♪　もう我慢できませんか？　わたしの膣内に出したいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――今度はおねだりが早いですね♪　あっ、あぁんっ♪　いいですよ、わた\nしもそろそろですからっ、んぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「二人であまーく蕩けて、一緒にいっちゃいましょうね♪　私の子宮にザーメ\nンミルクビュービューって出してぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んあぁんっ！　あっ、ああっ、んあぁんんっ♪　すごいっ、子宮に直接ぐり\nぐりってっ、あっ、くぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「出してっ、そのまま奥に出して！　わたしも一緒にイクから、あぁんっ♪　\nザーメンミルクいっぱい膣内出ししてぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00018212_02_09" ]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「イっくうぅんんんっ～～！　あっ、んんっ、んあぁんんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「な、なんかいつもより量が多くないですか、あっ、んんぅんっ！　びゅーび\nゅーされる度にわたしもイクっ、あっ、くぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204136" ]},
		{"command":[ "SETIMAGE", "0", "still_00018212_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「すごい、まだ止まらないっ……あぁんっ♪　本当に子宮が破裂しちゃうかも\n、あっ、くぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、謝らなくてもいいですよぉ♪　言ったじゃないですか、一緒にあま\nーく蕩けちゃいましょう？　ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204138" ]},
		{"command":[ "SETIMAGE", "0", "still_00018212_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほらほらぁ、このままもっとポルチオもぐりぐりして……あっ、あぁんんっ\n♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んんぅ……ああ、流石にそろそろ終わっちゃいますね……ふふっ、たっぷり\nのザーメンミルク、ご馳走様でした♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふぅ……それにしても、本当によく出しましたねぇ……隊長さん、もしかし\nてメイド服ラブの人だったりしますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――ああ、チョコレートのあれですか。確か血の巡りをよくして興奮しやす\nくなるとかいいますもんねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んぅんっ……つまり、これだけ出したのにまだまだ物足りないと？　ふふっ\n、オチンポ、ずーっと固いままですもんね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「わたしも……んんっ……味見の為にいっぱいチョコレート食べちゃいました\nから……オマンコの奥、まだまだ疼いちゃってます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――え？　今度はわたしがおねだりする番、ですか？　さっきのお返し？　\nふふっ……まったく、仕方がない人ですねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「わたしもまだまだ物足りないですから……あなたのガチガチオチンポで、わ\nたしのオマンコ、あまーく蕩けさせてください♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んあぁんっ！　あっ、ああっ、あぁんんっ♪　すごい、さっきよりも角度が\n付いてるから、わたしの弱いところずりずりってっ、んぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204207" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev182_12b_0000", "ev182_12b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「深いところもいいけどぉ、あっ、んぅんっ！　そうやって浅いところでズボ\nズボされるのもやっぱり好きっ、あっ、んぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「もうチョコレートはほとんどなくなっちゃいましたけど……わたしの身体も\n甘いかもしれませんよ？　もっとぺろぺろしないんですかぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、あぁんっ♪　ほら、また乳首もちゅーちゅっーってしていい\nですからね……んっ、くぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「隊長さんのそういう素直なところ、本当に可愛くてずるいですよねぇ♪　あ\nぁんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、いい子いい子♪　んぁんっ！　もしかして、こうして頭をなでなで\nされるの、好きだったりしますか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「頭を撫でるたび、オチンポが嬉しそうにビクビクしちゃってますよぉ♪　あ\nっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「わたしも、こんなに可愛らしく甘えられちゃうと、またオマンコの奥からウ\nズウズしてきちゃってっ、あっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「もっとほしいって、子宮が自分からオチンポに吸い付いていくのが、自分で\nもわかっちゃいます♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんんっ♪　わたしももっと頑張ってオマンコぎゅーって\nしますから、あぁんっ♪　一緒に気持ちよくなりましょう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んんぁんんっ！　それぇ！　ズドンって突き上げるのいい！　あっ、くぅん\nっ！　あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204217" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「出して、またさっきみたいにびゅーびゅーって、わたしの子宮をあなたのザ\nーメンで満たしてくださいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふあぁっ、あっ、ふあぁんんっ♪　――はいっ、もちろんわたしも一緒です\n！　また一緒にあまーく蕩けちゃいましょう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204219" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「大きいの来るっ、オマンコの奥から来るのっ………！　イクッ、イクイクっ\n、イックうぅぅんんっ～～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},
		

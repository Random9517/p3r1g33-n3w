		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ああぁんんっ♪　オチンポ抜けちゃった、あっ、んぁんっ！　ザーメンミル\nクびゅーびゅーってっ、んぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「膣内出しの方が好き、ですけどぉ……あぁんっ♪　ふふっ、こうやって全身に\nぶっかけられるの、嫌いじゃないんですよねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204402" ]},
		{"command":[ "SETIMAGE", "0", "still_00018212_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「このまま手でシコシコしてあげますから……んぁんっ……最後の一滴まで私\nにぶっかけちゃっていいですよぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「シコシコ、ぎゅっぎゅっ、しこしこ、ぎゅっぎゅ～～♪　ふふっ、オチンポ\nもいい子いい子ぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ……これで全部、みたいですね？　ふふっ、気持ちよかったですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「って、まぁその顔を見る感じ、聞くまでもないみたいですけどね♪　いっぱ\nい出せて、いい子いい子♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「えー、どうして今さら恥ずかしがってるんですかぁ？　こうやって頭を撫で\nられるの、好きなんでしょー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「いいじゃないですか、今日はバレンタインデーなんですから。頭の中をあま\nーく蕩けさせて、わたしに甘えてみませんかー？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――見返り？　それはほら、来月のホワイトデーに期待、でどうですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1204409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「だから……ほら、来てください♪　ぎゅーってしてあげますから、わたしの\n胸の中で、あまーく蕩けちゃってくださいな♪」", "NORMAL" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0094" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00010015_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev100_15b_0000", "ev100_15b_0023" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ。相変わらず簡単に背後が取れるな。もう何年も経っているのに、い\nつまでそんな腑抜けているのだ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504101" ]},
		{"command":[ "SETCHARA", "0", "char_00010015_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ？　なぜ招かれてもいない私が会場に居るのかだと？　そんなの、勝手\nに乱入したに決まっているだろう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504102" ]},
		{"command":[ "SETCHARA", "0", "char_00010015_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「大っぴらに飲み食いしてたのに、誰も注意してこなくてなぁ……つまらな\nくなったから、おまえにちょっかいを出しにきたんだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504103" ]},
		{"command":[ "SETCHARA", "0", "char_00010015_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「迷惑だから今すぐ帰れ？　ふふっ……そう怒るな。いいことをしてやるから\n、機嫌を直せ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504104" ]},
		{"command":[ "SETCHARA", "0", "char_00010015_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほらっ、どうだ……おまえの大きなペニスが、私のアソコにあたっているぞ\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504105" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「今からおまえが大好きなセックスをしてやる。ありがたく思え」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「なんだ？　無理やりはイヤなのか？　だが、こうして指を絡めてしまえば逃\nげられないだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504107" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ……観念して私のアソコを味わうがいい……まずは軽く擦って、アソ\nコを濡らすとしよう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504108" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ……あっ、あっ……！　やぱりこの感触は最高だなっ……大きくて、カ\nタくて、太い。まさに理想のペニスだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504109" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「私のアソコは、もうすっかりおまえの形を覚えてしまったぞ？　こんなふう\nにした責任を取って貰わなくてはな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504110" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「なに？　私のアソコを変えた覚えはない？　無理やり犯されてきただけだと\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504111" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「にゃははっ！　確かにそうだなっ！　だが、アソコが拡がったのは事実だ。\n罪は償うもの……そうだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504112" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あんんっ！　あっ、はぁぁぁっ……亀頭がアソコをえぐってくるっ！　浅い\nところから、どんどん奥に入っていくぞっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504113" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev100_15b_0000", "ev100_15b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ヒダにねっとりと絡みつくこの感じっ……はぁぁっ。私の狭いアソコが、無\n理やり拡げられていくっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「無理やりされているのはおまえの方？　こんなの、ただの逆レイプだと？　\nくふふっ！　何が逆レイプだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こんなにもアソコを勃起させながら興奮しているのに、逆レイプだと言われ\nる筋合いはないなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「それに……こうされると、おまえも嬉しいだろうっ！　んっ！　あっあっ！\n　くっ、あぁぁっ！　ふっ、あはぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふぁ、あっ、んぁぁぁっ！　ぶっといペニスが奥のところでビクビク跳ねて\nくるっ！　私に犯されて、悦んでいるのだなっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「悦んでない？　これはただの自然現象だと？　ふふっ……その強がり、いつ\nまで続くかなぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほらっ、ほらっ！　もっとペニスを肥大化させろっ！　いっぱい奥のところ\nで跳ねさせて、私を感じさせるんだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ぐっ、あっ！　おぉ、おぉぉぉっ！　アソコで擦れば擦るほど、ペニスが膨\nらんでいくっ！　いいぞっ、その調子だっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁ、ぐふっ！　はっ、ふっ！　んっ、んぅぅっ！　やはり私とおまえの身\n体の相性は最高だなっ……こんなに感じるのは、おまえだけだぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「いい加減、私だけのモノになったらどうだ？　そうすればいつでも相手をし\nてやるし、こんなふうに犯されることもなくなるぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「おまえがしたくなったら、いつでもさせてやる……くっ、うぐっ！　無理や\nりではなく、おまえの望むままに私を犯していいんだぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほらっ……想像してみろっ……こんなふうに自分から奥にペニスを突っ込ん\nでっ……あんんっ！　あっ、はぁぁっ！　お、奥に刺さるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「今みたいに亀頭を子宮口に押し当てながらっ……グリグリと撫でまわしたり\nっ……お、奥をトントンと小突いたりぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふはっ、あっ、うぅぅっ！　いま私がしていることを、自分からできるんだ\nぞっ！？　どうだ、嬉しいだろうっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ひゃ、あんっ！　あんんっ！　ペニスが奥のところで跳ねまわっているっ！\n　やはり自分の意志で、私を犯したいのだなっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「な、なに？　確かに自分からするのは好きだけど、私のモノには絶対ならな\nい？　ふふっ……そうか。また振られてしまったなぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「だが、おまえがどれだけ嫌がろうと、このペニスは私のモノだっ！　私だけ\nが味わえるし、好きにできるんだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ、んっ！　おっ、おほぉっ！　気持ちいいところに当たるっ！　ペニス\nが大事なところをえぐってくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504131" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっあっ、あっ、あぁぁぁっ！　膨らみながらビクビクと跳ねまわってっ…\n…そろそろ、イキそうなんだなっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「このまま膣内に出せっ！　おまえのザーメンも、すべて私のモノだっ！　だ\nから子宮に注ぐのは当然だぞっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「膣内に出したくない？　そんなことをしたら妊娠させてしまう？　あははっ\n！　それはいいっ！　おまえとの子供なら大歓迎だっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほらっ！　出せっ！　出せっ！　無理やり膣内出しして、パパになるがいい\nっ！　もちろん、責任は取らせるがなぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっはぁぁぁぁぁ～～～っ！　お、奥に出ているっ！　濃厚なザーメンミル\nクが、子宮にどぴゅどぴゅ出ているぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504136" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「この勢いっ、量っ……最高だっ……！　アソコの奥が悦んでいるっ……種付\nけされて嬉しがっているぞっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「おぉぉっ、おっ、ふぉぉぉっ……膣内出しされながらイクッ！　精液を子宮\nで受け止め、受精しながらイッてしまうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっあっ、ぐっ、おぉぉっ！　イクッ！　イクイクッ！　おまえも好きなだ\nけイケッ！　溜め込んでいる精子をすべて吐き出せっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「逆レイプで種付けしながら、強制的に責任を取らされる恐怖を感じてイキま\nくれぇぇぇっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「くっふっ……はっ、はぁぁぁっ……アソコから精子が溢れてくるっ……お腹\nがいっぱいで苦しいくらいだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504201" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ……これだけ出せば、妊娠は確実だろうなぁ。どうだ？　私との赤ち\nゃんだぞ？　嬉しいだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「くふふっ！　ペニスがアソコの奥で震えているぞ。無理やりパパにさせられ\nて、悦んでいるみたいだなぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「悦んでないが、本当に子供が出来たときは責任を取るだと？　ふふっ……そ\nれはつまり、妊娠すればおまえは私のモノになるということだな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ならば孕むまで犯させてもらおうか。なぁに……まだ夜は始まったばかりだ\nし、おまえも１回射精しただけだ。まだまだいけるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504205" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あんっ！　あっ、あっ！　射精直後のペニスを擦るの、たまらないっ！　お\nまえのキツくて、苦しい声を聞いていると、もっと動きたくなるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504206" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev100_15b_0000", "ev100_15b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぁぁ、あっ、んはぁぁぁっ！　いいっ、いいぞっ！　その悶える声っ……\nすごく興奮するっ！　ずっと聞いていたくなる声だっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「こんなにもおまえを愛しく思うとは……ぐぐっ、ふっ！　んふぅっ！　絶対\nに逃がさないぞ……おまえを手に入れるまで、私は諦めないからなぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ひゃ、あんんっ！　あんっ、あんんっ！　ペニスが抜けて、今度は浅いとこ\nろを擦ってっ……ひゃうっ！　にゃ、んにゅうぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「お、おまえっ！　ペニスを抜こうとしているなっ！？　この状況でも、まだ\n私に抗うとはっ……ひゃにゃあぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ、にゃ、あぁぁっ！　浅いところを刺激されると力が抜けるぅ！　アソ\nコが蕩けて、ペニスが抜けそうになるぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ぐぐっ、んぐぅぅ～～～っ！　ペ、ペニスを抜くなんて、絶対に許さないぞ\nっ！　絶対に孕んで、おまえを私だけのモノにするんだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「だから、このまま挿れ続けてっ……はうぅぅっ！　あっ、うぅぅ！　また奥\nに当たるっ！　太くてカタいのが、子宮口に刺さってくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ！　もう絶対に奥から離さないからなっ！　このままもう一度奥\nのところで……子宮口にペニスをあてながら、イカせてやるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「んっ、おぉっ！　おっ、おぉぉっ！　ひゃ、あぅっ！　あっあっあっ、んっ\nあっ！　にゃ、あぁぁぁっ！　ふにゅうぅぅ～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504215" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぁぁぁっ、イッ、イクッ！　またアソコに気持ちいいのが溜まってきて…\n…イクイクッ！　ひゃ、ぐっ！　んん～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「お、おまえのペニスもビクビク跳ねまくっているなっ！　もうそろそろ、我\n慢の限界なんだろうっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ほらっ、出せっ……！　さっきみたいに、奥で射精するんだっ！　私に種付\nけして、孕ませるんだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっあっ！　あっ、ふひゃあぁっ！　イクッ！　イクッ！　あっ、あっ！　\n奥っ！　種付けっ！　に、妊娠して私のモノにぃっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504219" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふにゃあぁぁぁぁっ！　イクイクッ！　あっ……あっ！？　ふはぁぁぁぁぁ\nぁんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ひゃぐぅぅっ！　あっ、あっ！　いいぞっ……また子宮に精液どぴゅーって\n出ているっ……！　種付けされているぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504301" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、にゃあぁ！　気持ちいいっ……！　おまえに膣内出しされると、\n幸せな気持ちになってくるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「もっとだっ……もっと出せっ……！　私を絶対に受精させる勢いで、精液を\n吐き出しまくれっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504303" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふぁぁぁっ！　あっ、あんんっ！　背中がゾクゾクするっ！　あ、頭が蕩け\nてっ……あっ、あっ！？　また、イクッ……あぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふにゃ、あっ、あっ！　んぁぁぁっ！　イクイクッ！　受精しながらイック\nぅぅぅぅぅ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504305" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふーっ……んふーっ……はっ、ふぅぅぅっ……これだけ出せば、妊娠は確実\nだな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504306" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ……おまえもとうとう、年貢の納め時というヤツだな。責任はしっか\nりと取らせてやるぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504307" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「安心しろ。私はおまえも、子供のことも見捨てたりはしない。大切に……そ\nして自由奔放に育ててやる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふふっ……私と同じように、立派なダークニンジャマスターにしてやるぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「なに？　子供を不良にするような真似はやめろだと？　おまえは何を言って\nいるんだ？　悪鬼悪道こそ、真のニンジャにふさわしいんだぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「にゃふぅぅっ！？　なっ！？　お、おまえっ！　急にペニスを抜いてっ……\nんひゃあぁぁぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504401" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あ、熱々のザーメンが顔にっ……！　それに服にもいっぱいかけられている\nぅ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「や、やめろっ！　無駄打ちをするんじゃないっ！　おまえの精液は全部子宮\nに注いでっ……おっ、おぉぉぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「な、なんだこれはっ……子種をぶっかけられているのに、感じてしまうっ！\n　アソコが気持ちよくなって、イッてしまうぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あぁぁっ、このマタタビのようにクセになる香りっ……あっあっ！　この匂\nいたまらないっ！　ふにゃ、にゃっ！　んにゃあぁぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504405" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「あっ……あぁ……！？　射精が終わってしまったっ……貴重なザーメンが子\n宮ではなく、身体にっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「お、おいっ！　おまえっ！　なんでペニスを抜いたんだっ！？　受精させろ\nと言っただろうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504407" ]},
		{"command":[ "SETIMAGE", "0", "still_00010015_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「私のモノになる気はない？　これからもずっと、抵抗し続けるだと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「ふっ……ふふふっ！　やはりおまえはいいオトコだ。よりいっそう、おまえ\nを屈服させてやりたくなってきたぞ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_100_1504409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａニャンコ先生" ]},
		{"command":[ "SETTEXT", "「これからもおまえのことを追いかけ、迫り続けてやる……私が諦めるのが先\nか、おまえが屈するのか先か……楽しみだなぁ？」", "NORMAL" ]},

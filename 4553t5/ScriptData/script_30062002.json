		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "SETTEXT", "「ねえねえ、ダーリン。今日のダイヤナちゃんの衣装はどうかしら～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004101" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETCHARA", "0", "char_00000620_01", "1", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「……な～に～。そのつまんない反応～。はぁ……ダーリンに聞いたのが間違\nいだったわ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETCHARA", "0", "char_00000620_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「ふふっ。で、も……ダーリンのここ、ダイヤナちゃんを見て興奮してくれて\nるみたい♪　あはっ、嬉し～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "SETTEXT", "「やぁん……ダーリンのオチンポ、本当にギンギンになってる……ダイヤナち\nゃんのこと犯したくてたまらないんだぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_02" ]},
		{"command":[ "SETTEXT", "「あっ、あんっ……そんなにおっぱいも揉んでぇ……それに乳首もクリクリっ\nてされて……ひゃうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_01" ]},
		{"command":[ "SETTEXT", "「えっ……こんな格好、他の人には見せないで欲しいの？　んふふっ♪　ダー\nリン、ダイヤナちゃんを独占したいのぉ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「でもぉ、こ～んなに可愛い女豹が居たら、誰だって独占したくなるわよねぇ\n♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_02" ]},
		{"command":[ "SETTEXT", "「あっ……あんんっ……でも、安心して……ダイヤナちゃんを独占できるのは\n後にも先にもダーリンだけだから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev006_20b_0000", "ev006_20b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「きゃっ♪　オチンポがもっと大きくなって、ダイヤナちゃんのオマンコに当\nたって……あっ、あっ！　オ、オチンポ入ってくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふっ……あっ……あぁぁっ！　ダーリンのすっごく熱い……こんなのオマン\nコが蕩けちゃうぅ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「あんっ！　あっ、あんっ！　ダーリンに抱きしめられながらオマンコズポズ\nポされると、いっぱい甘えたくなっちゃう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「えっ……好きなだけ甘えていいの？　んっふっふっ♪　なら、そうさせても\nらうわね……んっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「にゃぁぁんっ……ごろにゃ～んっ……♪　ダーリンのつよつよオチンポ、す\nっごく気持ちいいにゃぁ～ん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんのオマンコ, メロメロになってるにゃ……あっ、んにゃぁ…\n…お、奥のところに当たって、すっごく気持ちいいにゃぁん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「にゃ、あっ、あっ！　んふっ、にゃ、にゃふぅっ！　ダーリンのが出たり入\nったりするたびに、オマンコが締まってぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「んにゃ、にゃんっ、ふにゃぁぁんっ！　オ, オチンポでヒダをズリズリされ\nると、子宮口が亀頭に吸い付いちゃうにゃぁ～ん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……んっ、にゃぁっ！　ど、どうしたのぉ？　ダイヤナちゃん\nのこと、そんなにジッと見つめてぇ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「にゃんにゃん言うのは可愛いけど、それは豹じゃなくてネコじゃないかって\n？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「そんな小さいことは気にしなくていいのよぉ～。ネコも豹も、どっちも同じ\nネコ科でしょ……あっ、んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それに……ダーリンならダイヤナちゃんがどんな動物でも、い～っぱい愛し\nてくれるでしょぉ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「きゃあっ！？　あっ、あんっ！　急にダーリンの動きが激しく……ひゃうっ\n！　んっ、んんっ！　んぅ～～～っ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「オチンポがズンズンって、オマンコをえぐってくるぅ！　ダイヤナちゃんの\n赤ちゃんのお部屋、いっぱい突かれてるのぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「はぁ, あっ！　あっ、ふぁぁっ！？　な、なぁに？　……ダイヤナちゃんは\n今、女豹なんだから……ちゃんとネコちゃん言葉を使わないとダメ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「だ、だってぇ……んっ、ひゃうぅっ！　こ、こんなに激しくズポズポされた\nら、エッチな声の方が強くなって……んひぃぃぃっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「わ, 分かったわよぉ！　ちゃんと豹になってあげるから……んにゃっ！　に\nゃ、にゃぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダ、ダーリンのオチンポ、すごく奥まで入ってるにゃん！　ダイヤナちゃん\nの弱いところ、ずっと擦ってくるにゃぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「こんなオチンポを味わわされながらおっぱい弄られたら、我慢できなくなる\nにゃん！　気持ちいいの止められないにゃぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふにゅ、にゅ！　うんにゅぅぅっ！　ヒダヒダがオチンポに絡みついて離れ\nないにゃん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「オマンコもぎゅ～って締まって、ダーリンのオチンポの形がはっきり分かっ\nて……にゃ、にゃふっ！　うにゅ, ふにゃぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「にゃん！　んにゃにゃんっ！？　ダ、ダーリンのオチンポ、オマンコの膣内\nで膨らんでるにゃん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「このまま膣内に出して腹ボテ女豹にしてやるだにゃんて……そ、それって、\nダイヤナちゃんのこと、妊娠させる気にゃん！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「イ、イヤじゃないにゃん！　ダーリンとの赤ちゃん欲しいにゃん！　ダーリ\nンのためなら、何人だって産んであげるにゃぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「だからこのまま膣内に……一番深いところで、せーえきびゅーびゅーして欲\nしいにゃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんに種付けしてにゃん！　ダーリンの精子で、受精させて欲し\nいにゃん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「ふにゅ！？　にゅ、うにゅぅぅっ！　にゃ、あっ！　んにゃにゃっ！　あっ\n、イクッ！　イクにゃん！　ダイヤナちゃんもイッちゃうにゃぁぁぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_09" ]},
		{"command":[ "SETTEXT", "「んひっ！　はっ、あっ、ふにゃぁぁぁっ！　す、すごい勢いで精子が出てる\nにゃあぁ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_08" ]},
		{"command":[ "SETTEXT", "「ダイヤナちゃんのオマンコ、ダーリンのザーメンでいっぱいにゃあぁ！　気\n持ちよすぎるにゃんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_08" ]},
		{"command":[ "SETTEXT", "「子宮にいっぱい熱いの流れ込んできて……にゃ、ふにゅぐっ！　こ、これ、\n絶対に受精してるにゃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_09" ]},
		{"command":[ "SETTEXT", "「ダーリンとの赤ちゃん孕んで……ふにゃ、にゃぁぁぁ～っ！　嬉しくて、ま\nたイッちゃうにゃぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_08" ]},
		{"command":[ "SETTEXT", "「あんっ、あんんっ！　好きっ！　好きにゃあぁっ！　ダーリンのこと、大好\nきにゃぁぁぁ～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_04" ]},
		{"command":[ "SETTEXT", "「ふはっ……はぁ……ふぅっ……んふぅぅっ……オマンコから精液が溢れてく\nるわぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004201" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_05" ]},
		{"command":[ "SETTEXT", "「おヘソの下のところがすっごく熱くて……んんっ！　この熱を感じるだけで\n、またイッちゃうかもぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_04" ]},
		{"command":[ "SETTEXT", "「えっ？　ネコちゃん言葉はどうしたかって……？　だって、もうエッチは終\nわったんだし～、別に言わなくてもぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_05" ]},
		{"command":[ "SETTEXT", "「きゃっ！？　な, なに……またオマンコの奥でオチンポが膨らんで……ひぐ\nっ！　ふっ、あっ！　あぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_04" ]},
		{"command":[ "SETTEXT", "「もしかして、まだ犯したりないの……？　まだ出せるから、オチンポズポズ\nポしたいのぉ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000620_02_04" ]},
		{"command":[ "SETTEXT", "「もう……仕方ないわねぇ。大好きなダーリンのために、もう１回だけ付き合\nってあげる……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev006_20b_0000", "ev006_20b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「んんっ！　ぐっ、あぐぅぅっ！　二回目とは思えないくらい、オチンポ勃起\nしてるわぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「それに……ひゃんっ！　あっ、あはぁぁっ！　また気持ちいいところにズン\nズンきてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ふっ、あっ！　ふっぐっ！　な、なぁに？　ちゃんとネコちゃん言葉でしゃ\nべって、可愛い声を聞かせて欲しいのぉ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「わ、分かってるわよぉ……んっ！　にゃ、にゃぁぁッ！ダーリンのオチンポ\n、すっごく気持ちいいにゃあぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「奥をグリグリってされると, 全身が蕩けるにゃ！　でもぉ、オマンコはぎゅ\n～ってしてぇ……ふんにゅ！　にゅうぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「ダーリンのオチンポがオマンコのお肉と密着して離れないにゃぁあ！　出し\n入れのたびに、お肉が引き出されたり、押し込まれたりしてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},
		{"command":[ "SETTEXT", "「にゃん、ふっにゃ！　あっ、あっあっ！　浅いとろこもいいにゃぁ！　Ｇス\nポット擦られると、背筋がゾクゾクするにゃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_006_2004213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ダイヤナ" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0098" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00018211_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev182_11b_0000", "ev182_11b_0023" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「やっと来てくれたんですね、待ちくたびれましたよぉ……え？　何をしてる\nんだって、そんなの見てのとおりですよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104101" ]},
		{"command":[ "SETCHARA", "0", "char_00018211_01", "3", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ど、どうぞ……クリスマスプレゼントです！　――って、なんですかその呆\nれた顔は！　やめて、ちょっと刺さるからその眼で見ないで！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104102" ]},
		{"command":[ "SETCHARA", "0", "char_00018211_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「折角のクリスマスですし、わたし自身がプレゼントです！　みたいなあれ、\n一回やってみたかったんですよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104103" ]},
		{"command":[ "SETCHARA", "0", "char_00018211_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「だけどリボングルグルに巻いていたら、変に絡まって動けなくなっちゃいま\nして……幸い手元にスマホがあったので、あなたに助けを求めたって訳です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104104" ]},
		{"command":[ "SETCHARA", "0", "char_00018211_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「どうして俺にって……そりゃこんな姿、あなた以外に見せられるわけないじ\nゃないですかぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104105" ]},
		{"command":[ "SETCHARA", "0", "char_00018211_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「どのみち隊長さんにもプレゼントするつもりでしたし、もう呼び出しちゃえ\n、と」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104106" ]},
		{"command":[ "SETCHARA", "0", "char_00018211_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――と言う訳で、改めまして『プレゼントはわ・た・し』です♪　遠慮なん\nてせず、思う存分わたしのこと、堪能しちゃってくださいね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あぁんんっ♪　ふふっ、部屋に入ってきた瞬間は呆れてた癖に、オチンポの\n方は最初からやる気満々じゃないですかぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104108" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「カチカチオチンポを一気にぶち込んじゃってっ、あぁんっ♪　ふふっ、オマ\nンコの膣内でヒクヒクしてるのが分かりますよぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104109" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――わたしの姿がエロ過ぎるのが悪い？　リボンの食い込み最高？　我慢な\nんてできるはずがない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104110" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふふっ♪　あなたのその、誉め言葉を濁さずに言ってくれるところ、とっ\nても素敵だと思いますよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ほらほらぁ、オチンポを入れただけで満足しないでくださいな♪　わたしも\nちょっと、我慢できそうにないからぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104112" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「リボンに絡まって身動き一つ取れない女を、思う存分犯し抜いてくださいな\n♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、あぁんんっ♪　反り返ったオチンポが、オマンコの膣内激し\nく掻きまわしてるっ、あっ、んあぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104114" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev182_11b_0000", "ev182_11b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、わたしの弱い所、もう全部ばれちゃってるんですよねぇ、あぁんっ\n！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「それ、奥っ、んぅんんっ！　ポルチオにオチンポくっつけて、ぐりぐりする\nのやっぱり好き、あっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「挑発したのはわたしですけどぉ……今日の隊長さん、ちょーっとやる気満々\n過ぎませんかぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「もしかしてぇ、あっ、あぁんっ♪　身動き取れない女を犯すっていうシチュ\nエーション、お好きだったりするんですかぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、隊長さんは緊縛プレイがお好きと♪　それはそれは、狙ったわけじ\nゃないですけど最高のクリスマスプレゼントをあげちゃいましたかぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んんっ！　あっ、あぁんんっ♪　そうですよ、今のわたしはあなたへのプレ\nゼント……あなたのモノ、ですからね♪　あぁんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「そうやっておっぱいを鷲掴みにして、乳首を乱暴に引っ張るのも、もちろん\n自由ですよぉ♪　あっ、んんっ、くぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「この格好だし、あなたが来てくれるまでの間は、ちょっと肌寒かったりした\nんですけどぉ、あっ、んんぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、今はとってもあったかいです♪　伝わってくる体温が心地よくて、\n胸の奥からポカポカして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「それにぃ……んあぁんっ♪　オマンコも熱々に蕩けちゃってます♪　子宮が\nジンジン疼いて、オチンポに吸い付いちゃってるぅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、ふあんんっ♪　ふふっ、あなたのオチンポもどんどん大きく\nなってきてますね、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「膨らんだ括れで膣内を掻き回されてっ、あっ、んぅんんっ！　そこ、浅い所\n何回もズリズリされるのも好きっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「でもぉ♪　んんんっ！　相手の弱い動きを把握してるのは、あなただけじゃ\nありませんよぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「こうやってオマンコの膣内、グネグネさせるみたいにぃ……あっ、んぅんん\nっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「痛いぐらいの力でオマンコギュ～～ってするの、ほんとうに好きですよねぇ\n♪　あっ、ああっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「オチンポ、またビクンってっ、んんぅんっ♪　カウパーもダラダラ溢れて、\n出したいんですよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「わたしもっ、あっ、んんぅんっ♪　イキそうですよっ、あなたのオチンポで\n、イキそうになってますっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「もちろん、遠慮なんていりませんとも♪　オチンポ根元までぶち込んでっ、\n私の子宮にザーメンミルクビュービュー出しちゃってくださいな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んあぁんっ！　あっ、ひっ、くうんんんっ♪　それ深すぎてっ、あっ、くぅ\nんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104133" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMNET" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「イク、イきます、私も一緒にっ！　あぁんんっ！　出して、お腹がタポタポ\nになるまでザーメンミルクいっぱい出してぇ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「イっくうぅんんんっ～～！　熱いのいっぱい来たぁ……！　あっ、んんっ、\nくうんんんっ～～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104135" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、んあんぁんっ♪　びゅーびゅーってザーメンミルク出るたび、わたし\nも何回もイってっ、んくぅんっ♪", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「イクッ、オマンコイクぅうんっ……♪　気持ちいいの全然止まらない♪　あ\nっ、くうぅんんんっ～～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふふっ♪　相変わらず、すごい射精量ですねぇ……あぁんっ♪　いつも思\nいますけど、子宮が破裂しちゃいそう……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104138" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ダメ、まだ抜かないでくださいよぉ……♪　出したばっかりのオチンポで、\nまたポルチオをぐりぐりしてっ、あっ、んあぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、幸せ、ですねぇ……♪　プレゼントを渡したつもりが、私がプレゼ\nントを貰っちゃった気分です……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104140" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んんっ……やっぱり、一回出したぐらいじゃ満足できませんよねぇ？　オチ\nンポ、小さくなるどころかもっと固くなっちゃってますよぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――私ですか？　そうですねぇ……ふふっ……♪　いいえ、私はもう嫌です\n！　これ以上、無理矢理犯されたくなんてありませーん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「でもぉ……この通り、リボンで拘束されちゃってますからねぇ♪　あーあー\n、嫌なのに抵抗できないなぁー♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104203" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「また無理矢理オチンポぶち込んで、ポルチオぐりぐりされちゃってぇ……い\nっぱい情けない喘ぎ声を上げさせられちゃうんだろうなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「なーんて♪　どうです、隊長さんの性癖に合わせてサービスです♪　気に入\nっては――あぁんんっ♪　貰えたみたいですね、ふふっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104205" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「――お望みなら、その通りにしてやる？　無茶苦茶に犯して、ひぃひぃ言わ\nせてやる？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、なんだかんだ、あなたもノリノリじゃないですかぁ♪　あっ、んん\nぅん♪　すごいっ、もうさっきよりもオチンポかたぁい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、ひっ、ひゃぁんんっ♪　出されたばっかりの精液、ぐちょぐちょって\n掻き回されてっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104208" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev182_11b_0000", "ev182_11b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「さっきイったのですっかり子宮が下りて、赤ちゃんの入り口パクパクしちゃ\nってるからっ、あっ、くぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「すごいっ、あっ、ふぁんんっ♪　子宮の中まで直接オチンポ届いちゃってま\nすよぉ♪　んあぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「またさっきみたいに、おっぱいもぎゅーって鷲掴みにしてほしいですぅ♪　\nくんんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「そうそれっ！　力強く乳首をつねって、乱暴に左右にぐいぐい引っ張ってく\nださい！　本当に身動き取れない相手に乱暴してるみたいにぃ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、くぅんんっ♪　ひっ、あっ、ひゃぁんんっ♪　全身すっかり火照っち\nゃって、熱いのが気持ちいいですねっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「わたしの方からも腰を動かして気持ちよくしてあげたいですけど腕がこれ、\nだからぁ……んくぅんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ♪　こうやってオマンコの膣内、ぐねぐねって動かすだけで許してく\nださいねっ♪　あっ、あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふっ、またオチンポ大きくヒクつき始めたぁ……♪　膨らんだ括れが、わ\nたしのなか全部掻き出すみたいに激しくてっ、んぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104216" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「出したいんですか？　出したいんですよね？　わたしにまた、ザーメンミル\nクびゅーびゅーってぶちまけたいんですよねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「もちろん、好きなタイミングでどうぞ♪　身動きのとれないわたしは、あな\nたの好きなように無茶苦茶にされちゃうんですからぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んひゃっ、あっ、ふあぁんんっ♪　――はいっ、わたしも一緒にイキます！\n　また一緒に幸せになりましょうねっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104219" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「来るっ、大きいの来る！　頭真っ白になっちゃうぐらい大きいのがっ！　イ\nクッ、イクイクっ、イックうぅぅんんっ～～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふあぁんんんっ♪　また奥にきてるぅ……♪　子宮にぴったりくっついたオ\nチンポから、子宮に直接びゅーびゅーって来てるぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あっ、くっ、んぅんんんっ！　すごいっ、わたしずっとイってるぅ！　オマ\nンコがヒクヒクしてっ！　またイクっ、イク、イクぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「あぁ……♪　やっぱり膣内出しされて一緒にイクの、しあわせぇ……♪　身\n体がふわふわって、気持ちいいぃ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104303" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「だめぇ、まだオチンポ抜かないでくださいぃ……♪　ザーメンミルク、全部\n注ぎ込むまで、腰の動きも止めないでぇ……！　んぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……ふふっ、今日もすごかった、ですよぉ……あぁんっ♪\n　オチンポ入れたままなのに、精液逆流してきちゃう……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「……どうでしたぁ？　特別なクリスマスプレゼント、堪能してもらえました\nかぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふふっ♪　貰い過ぎ、なんてことはありませんよ。私もここに……んっ…\n…プレゼントをたっぷり注ぎ込んでもらいましたからねー」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「お相子です♪　……なんですか、その微妙な顔？　え？　クリスマスプレゼ\nントがそんなものでいいのかって？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「それはまぁ、確かに、他の人に自慢するには中々口に出しずらいですねぇ♪\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104309" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ならこの後、クリスマスデート、お願いできますかぁ？　ふふっ♪　素敵な\nクリスマスの思い出、期待していますねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104310" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ああぁんんんっ♪　だめ、オチンポ抜けちゃったあぁ♪　んんんっ！　熱々\nザーメンミルク、身体に掛かってっ、んぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ああでも、これはこれでいいかもぉ……♪　んんんっ！　精液が直接肌にか\nかってっ、あっ、くぅんんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「リボンで身動きが取れない女の身体に精液をぶっかけるなんて、あなたって\nばほんと、変態さんなんですからぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104403" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「なんだかまるで、マーキング見たいですねぇ♪　これは俺のモノだって主張\nされてるみたいで、これはこれで……んぅんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふふっ、そんなに必死に出さなくても、今日のわたしはあなたのモノです\nよぉ♪　なんたってクリスマスプレゼント、ですからねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104405" ]},
		{"command":[ "SETIMAGE", "0", "still_00018211_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「それにしても、ほんとに良く出しましたねぇ……リボンで縛られた全身精液\n塗れの女……客観的に見ると、中々やばい絵面ですねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「んっ……ごめんなさい、そろそろ腕のこれ、解くの手伝ってもらっていいで\nすか？　やっぱり自分じゃ解けなくって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「って、なんですか、そのニヤニヤ顔は？　――え？　わたしはプレゼントだ\nろって？　まだまだ好きに楽しませてもらう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「ふふふっ♪　あなたがそう言うなら、仕方がないですね～♪　わたしはこの\n通り、身動き一つ取れない訳ですからぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ハルミ" ]},
		{"command":[ "SETTEXT", "「お互い精も根も尽き果てるまで……素敵なクリスマスにしましょうねぇ♪\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_182_1104410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んぁあああっ！？　あっ、ぼ、暴走なのです！？　あっ！？　あっ、しょ、 \n少々吸い過ぎました、勢いがつきすぎて、顔に……あ、頭にぃいっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「あっ……！　あっ、ぁっあっ……！　せっかく出してもらった精液……！　 \nそのまま直接飲み干すつもりが、こんなことに……！　んぅっ、うううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「し、しくじりました……！　主様を喜ばせようと思ってしたことが、裏目に \n……！　っひぅうっ！？　そんなにたくさんかけないでほしいのですっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「あっ♪　芳醇な精液の臭いぃい……！　見せつけるように、目の前で震える \n太いオチンポぉおお……！　これでは火照りを、疼きを抑えるどころか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ウチがますます発情して、ダメダメ兎に成り下がってしまうではありません \nか……っ。あっ、な、なんて卑猥な白い液体ですかっ……！　んぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ウチ……、ウチ、ヘンになってしまいます！　あうっ、身体が熱いぃ……！ \n　精液がかかったところが、ジンジン疼いて……たまりません……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「うう、ああ、あぁあああ……♪　な、なんということをしでかしてしまった \nのか……。完全に計算ミスでした、我を忘れた結果がコレです……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「身体についた火を、消すためにした口淫で……ますます燃えあがってしまう \nとは……。主様恐るべしです、もしくはウチが浅はかでした……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……そもそもウチが、口だけで満足できるとは思っていなかった、ですか？ \n　そ、それは……そうですが。一応これでも遠慮してですね……。でも」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203409" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「主様がそのつもりなら、ウチももう、自分を止める必要なはないようですね \n？　それなら……お覚悟を。次は本気で襲わせてもらいますから……！」", "NORMAL" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んううううううぅううう……っ♪　んむぅううううっ♪　んふぅううっ！？ \n　んーっ、んーっ、んんんん～っ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203301" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……。突然呼び出して……すみません。緊急で、どうしても相談 \nしたいことが……ありまして。あまり、余裕がないので本題に入りますが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203101" ]},
		{"command":[ "SETCHARA", "0", "char_00000522_01", "7", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「今、ウチは……獣人形態の反作用で、発情してしまっていると言いますか… \n…。どうにも、身体の火照りがおさまらないのです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「主様は何もしなくていいですから、その……。少しだけ、ウチに好きなよう \nにさせてください。はぁ、はぁ、も、もう我慢できません……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んはぁっ……♪　す、すごいのです、臭いのです……っ。で、ですが、これ \nです、ウチはこれが欲しくて……♪　はぁ、はぁ、あぁ、もっと近くに！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203104" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「すぅうううう……。あ、逃げないでください。じっとしていれば、悪いよう \nにはしません……。すんすんすん……すん、すん……。んんんんっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「むわりと香る汗の臭い……、主様の濃い体臭……っ。今日はまだ、お風呂に \n入っていないようですね。……ああ、いいんです。そっちの方が助かります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「すん、すん、すん……。ん～～～～……♪　鼻の奥に広がるこの、独特の臭 \nいがウチを狂わせるのです……。あぁ、股間全てが臭いですが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「中でも、オチンポの付け根が最高に臭います……！　ここ……ここですね、 \nすんっ……すん、んんんっ……。身体が燃えあがるように疼きます……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……え？　積極的にがっつきすぎていて怖い？　何を言うですか……。いつ \nもは主様がこんな風なのですよ？　たまにはウチがそうなることもあります」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……嫌だというなら、なぜこんなにも硬く勃起させているのですか？　本当 \nは嬉しいのですよね？　期待してましたよね？　すん、すん、すん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「臭いからもわかります。発情したウチに負けない、主様の性の臭い……。い \nつから勃起していたんですか？　もしかして、ウチが来る前から？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……ごくっ……。ここまで太くしているのなら、ウチに同意した、何をされ \nても合意の上ということになりますよね。……それなら……んぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「れろ……っ。ぴちゃっ、こうやって、舌先で裏筋を舐め上げても……ぴちゃ \nっ。問題ないはずです。あぁ、しょっぱくて……すごく美味しい、ぴちゃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「普段なら、自分からこんなことはしません。でも……♪　この巨大なオチン \nポを目の前に突き出されて、オチンポの臭いを嗅いでしまったら……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「獣の本能が、抗うことを許しません。今すぐコレにむしゃぶりついて、メス \nの本気を見せろと身体が命じてくるのです……！　ん、れろっ、れろ、れろ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んふぅ……っ♪　オチンポも、ウチに舐められて喜んでいるみたいですよ？ \n　ビクビク痙攣して、もっともっとと腰を前に進めてくるぅ……。れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「あっ♪　あっ、ま、待ってください♪　そんなに大きなオチンポ、いきなり \nは口の中に入りきりません……たっぷり唾液で濡らしてからです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んん……。ぴちゃっ、ぴちゃ、……れろっ♪　んん……♪　ぴちゃっ、ぴち \nゃ……ちゅぷっ。あ♪　あっ、カウパーが垂れてきて……れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「もったいないですね、全部舐め取ります。……ぴちゃっ♪　くちゅ、ちゅぷ \n……♪　れろっ、れろ……くちゅっ。んぅ……どんどん溢れてきます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「このヌルヌルが、舌にまとわりついて……。んちゅっ、くちゅっ、ぴちゃっ \n、ぴちゃ……♪　はぁ、はぁ、はぁ、あぁ……。頭がクラクラして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「もう何も考えられません、視界がオチンポでいっぱいです……♪　ぴちゃっ \n、ぴちゃ、れろっ、れる、くちゅっ、ちゅぷっ、ぷっちゅっ、くちゅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……ん……♪　オチンポの根元より、さらに下……。睾丸から凄まじくエッ \nチな臭いを感じます。なんですか、このいやらしい臭い、とんでもないです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「こんな臭いを撒き散らしていたら、周囲のメスたちがおかしな気分になって \nしまいます。それはよくありませんから、全部ウチがもらうです……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……ぺちょっ。んむっ、特別に臭う睾丸も、たっぷり唾で濡らし \nて……。それから、いよいよオチンポ全部を味わう時間です……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んむぅううっ♪　ぐちゅっ！　ぐっちゅっ、じゅるっ……！　あは♪　驚き \nまひたか……？　ウチの本気の咥えフェラれひゅ、気持ちいいれひょう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「主様の、くっさい臭い睾丸で作ったベトベトの精液……。世のため人のため \nに、ウチが全部飲み干すことに決めました。……いいですよね♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……んっ♪　ウチが飲みたいだけだろうって？　知りません……っ。そんな \n意地悪を言うオチンポはこうしてやります。丸呑みの刑です……ぐちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んっ♪　ンッ、んっ、んんっ……！　喉の奥までオチンポ咥えて、しゃぶり \n倒すですよ……っ♪　んむぅうっ♪　ぐっちゅっぐちゅっじゅるるるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203128" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「じゅるっ……！　じゅっぷっ、じゅっぽっじゅぽっ……！　んんんぅ、口が \n止められないのれひゅ……！　おいひい……おいひいれす、ぐっちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「安心ひてくらひゃい……♪　ウチが心を込めて、一滴残らず精液を絞り取っ \nてあげますから……！　っじゅるっ！　じゅっぷっじゅっぷっじゅぽっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203130" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ぢゅるっ……じゅるるるっ！　んぁっ、……ぐちゅっ！　口の中が、主ひゃ \nまのオチンポれいっぱいに……っ♪　ぐちゅっ！　ぐっちゅっぐっちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ウチの発情っ♪　おさまるくらい……んっ♪　ドロッドロで粘り気の強い、 \nすごい精液を恵んでくだひゃいねぇ……じゅぷっ！　じゅっぷっじゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「じゅぽっ！　じゅぽっ！　ぐっちゅっずちゅっ……！　……んっ！？　オチ \nンポいきなり、太さが増ひて……！　んっ、精液漏れそうなのれすかっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「溜めて、溜めて、一番臭くなったのを提供してくりゃはい……！　もう少し \nだけ我慢、を……！　じゅるっ！　じゅるっ、ぐっちゅっじゅるるるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んむっ♪　出したいれひゅか♪　精子ドクドクこの口にっ……出すのれすね \nっ！　それなら……吸い上げます！　ぢゅるっ！　じゅるじゅるじゅる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んぷぅうううう……ッ！？　んんんんんん……！　んぐっ、んんんんぅ…… \nっ♪　こ、これはこれはっ♪　生臭くて粘着力の強い精液れひゅね……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_07" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「いいでひゅよ、とっても素晴らひぃれひゅ♪　ほらっ、気合を抜かずに最後 \nまで出しきるのです！　射精に協力しますから……！　んじゅるっじゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んんんんんん～～～～……♪　あっついネバネバが、息も出来ないくりゃい \n次々にぃ……っ♪　んんっ♪　んむっ♪　んん～っ、んんんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ごくっ……ごくっ……。まだです、まだ尿道の奥に残っているはずです…… \n！　ぢゅるっ……じゅるっ。んっ♪　ごくっ……ごくんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ん、ふ……♪　脳が揺れるような……すごい臭さでした。それにまだ、口の \n中に粘り気が残っていて……。ん……くちゅ、くちゅ……ごくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……今何をしたのか、ですか？　舌に絡みついていた精液を、ウチの唾と混 \nぜて飲み干したまでです。あまりに濃くて、一度では飲みきれませんでした」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……でも、それでいいのです。恥ずかしがることはありません……♪　ウチ \nが期待した通りの、いえ、それ以上のこってりとした精液でした……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「と、何を腰を引こうとしているのですか。一度射精したくらいで満足できる \n発情なら、主様をわざわざ呼びつけたりしません。……まだなのです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ウチのお口は……、身体はますます主様の精液を、オチンポを望んで昂った \nままですから。それに……ん、主様の方も終わっていませんよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ウチが熱心にオチンポをおしゃぶりしているところを見て、息を荒げて興奮 \nしてました。その証拠に……ほら。硬さが全然失われていないのです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……もう一度、しゃぶってほしいですよね？　うなずいてください。そうし \nたらウチ……。貪るみたいに、改めてフェラチオさせてもらうです……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……ふふ。そうですか。やっぱりフェラチオ続行希望でしたか。それじゃあ \n、利害も一致したことですので、遠慮なくいかせていただきます……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「あむっ……！　はむ……んむっ……！　じゅぷっ！　……んっ！？　精液で \nオチンポがベタベタです……。まずはこれを綺麗に、ひて……ぐっちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「丁寧にゆっくりと……んっ、時間をかけてしゃぶり尽くすです……♪　んっ \n、んんっ……！　じゅっぷっ……ぐちゅっ……じゅるっ、んんぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んふ、焦らされるともどかしいれひゅか……？　ウチの口の中で、じっくり \nじっくり、ねっとり性感を高めて……一気にすすり取るのれひゅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ですから、最初はゆ～っくり……。じゅる……ぐちゅっ……れろっ、じゅる \n……。ぐちゅっ♪　ぐちゅ……じゅっぷっ、じゅぽ……ん、ん、ん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ウチの舌の感触をしっかりオチンポに覚えさせてから……じゅるっ、少し、 \nずつ、口の動きを速めていきまひゅよ……！　っぐちゅっ！　じゅっぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「じゅるっ！　じゅるっ！　ぐちゅっぐちゅっぐっちゅっずちゅっ！　んっ！ \n　んっ！　根元から……先端まで絞りあげる、動き……っ、じゅるっじゅぷ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「さあ、どんどん激しくしていくです……っ！　ぐっぽっぐぽっ♪　じゅっぽ \nっじゅぽっ！　んんんぁ♪　オチンポ熱くなってきまひた……じゅっぷっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んふふふっ……逃がひませんよぉ……♪　ここまできたら、ウチが射精させ \nるまで……止めることはありません！　っじゅるっ、ぢゅるっぢゅるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「んむっ！　んんっ……！　ぐっちゅっぐっちゅっ……れろっ、んれろっ、れ \nるれるっ……！　ぢゅるっ、じゅっぷっ！　れろっ……れろれろぉっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ぢゅるるるっ……！　んぁああ、いいれひゅね……っ！　ウチの口の中、主 \nひゃまの先走りのお汁でいっぱいになっれきまひた……。んっ、ぢゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203217" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「出ひて……っ、出ひてくらひゃいぃ……！　ウチ、主ひゃまのドロドロの精 \n液が欲ひいれひゅ……っ、ウチを助けると思って、たくさんくだひゃいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「じゅっぷっ！　じゅぽっ、ぐっちゅっずちゅっ……！　精液ぃ……♪　精液 \nっ……！　ぐちゅぷっ！　じゅるっ、ぢゅるっ、じゅるるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203219" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「喉の一番奥れ……！　びゅっびゅっと発射ひてくだひゃい……！　吸い上げ \nまひゅ！　っぢゅぅうううっ！　ぢゅううううっ、じゅるるるるっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203220" ]},

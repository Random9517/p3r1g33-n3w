		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ごくっ……！　ゴクッ、ごくっ……。んぷぁあ……♪　す、すごい臭いです \n、それに……っ、歯でも噛みきれないくらい、ネバネバで……んぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ごくっ……。ごくっ……！　飲んでも飲んでも口の中に溜まって、……んん \nんっ。ごくっ、ごくっ……！　お、溺れてしまいそうです……んんんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ふぅっ……。……んん！？　一息つこうとした隙に、またビュルビュルと… \n…！　この短時間でどうやってこんな量の精液を溜めたのですか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「あっ……。も、もちろんこぼしたりなんてしません！　じゅるっ！　じゅる \nっ……ごくっ、ごくんっ……！　ど、どうです！　飲みきりました！」　", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ぷはぁあ……。息まで精子臭くなってしまったのです。でも……お腹の中は \nポカポカして……。全身に力がみなぎってくるような……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「……前々から思っていたのですが、主様は本当に、ドスケベでエッチの天才 \nなのですね……。突然ウチに襲われて、これだけ射精するのですから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「とんでもなく淫らで、いやらしい男です……。でも、そういうところに、ウ \nチは何度も救われてきたのかもしれません。現に今日だって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「ええ。もちろん、感謝しているですよ？　でもそれ以上に……どうしましょ \nう。主様を知ってしまった身体は、主様だけを求め続けてしまう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "Ａオボロ" ]},
		{"command":[ "SETTEXT", "「これは由々しき事態です。ですが、ウチはこれを解決する気はありません。 \n主様♪　これからもウチとエッチな事をたくさんすると誓ってください……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_2203310" ]},
		{"command":[ "SETIMAGE", "0", "still_00000522_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETIMAGE", "0", "still_00004915_02_01" ]},
		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「う……あ……オチンポがこんなに……私の、格好でこうなってるんだな……\n　なんというか……凄いな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETIMAGE", "0", "still_00004915_02_03" ]},
		{"command":[ "SETTEXT", "「ああ、こうしてるだけで君の興奮が伝わってくるようだ。オチンポがバキバ\n　キに硬くなってて、熱くて、震えてて……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETIMAGE", "0", "still_00004915_02_03" ]},
		{"command":[ "SETTEXT", "「上から入れればいいんだな……んんっ、ふっ、あっ……入って、来た……\n　んうっ、ふうっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETIMAGE", "0", "still_00004915_02_06" ]},
		{"command":[ "SETTEXT", "「んうっ、ふっ、私の中に、君のオチンポが……んんっ、あんっ、あっ、んう\n　っ、待って、今、動くから……んっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504109" ]},
		{"command":[ "WAITINPUT" ]},



		
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev049_15b_0000", "ev049_15b_0023", "true", "ALL" ]},
		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「んうっ、んっ、あんっ、ああっ、こう、動けばいいのか？　んっ、ふっ、\n　あんっ、下から、動かされたら、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「腰、うまく動かせない、んっ、はあっ、こう、こうだな、んっ、オマンコの\n　中で、オチンポが震えてるのがわかる、きゃっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「急に下から、んっ、ふうっ、動かされたら、また腰が、んんっ、この状態で\n　もちゃんと動けって……んんっ、あっ、あうっ、くっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「分かった、ちゃんと、ちゃんとやるから、あんっ！！　んっ、んうっ、こう、\n　こうすればいいんだろう？　ふううっ、あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あっ、これ、君のオチンポが下からぐりぐりって私の奥を、んっ、ああっ、\n　これ、私も気持ちいい、んっ、あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ、分かってる、君も気持ちよくする、頑張って、んっ、ああっ、\n　あんっ、あっ、ふうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「少し、慣れてきた……んっんっんっ、こう、こうすればいいんだろう、ふう\n　うっ、あっ、あんっ、んんっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ふふっ、君も気持ちよさそうな顔になってきているな……んっ、ふっ、あん\n　っ、んっ、もっと、もっと気持ちよくなってくれ……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「私のオマンコで、気持ちよくなってくれ……んっ、あっ、ふううううっ！！\n　これは、お礼でもあるからな……あっ、くっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「もっとお礼が欲しいって、どうやったら……んっ、あんっ、あっ、うさぎ\n　みたいに跳ねてくれって、こうか、んっ、あっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「腰がぴょんぴょんって、んっ、あっ、オチンポが奥まで……あっ、ああっ、\n　あんっ、あっ、んっんっんっ、これ、奥が何回も……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「んふうっ、んっ、あっ、あああっ、これ、これでいいんだなっ、んくうっ、\n　はっ、あっ、私のオマンコも、きゅっきゅってなってる……ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「ふっ、うっ、んっ、んんんっ！！　腰、跳ねて……あんっ、あっ、奥まで\n　勢いよく小突かれてる、あんっ、ああああっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「んんっ、うっ、君のオチンポも、んうっ、気持ちよさそうだ……ふううっ、\n　んっ、あんっ、ああっ、また、下から……ふああああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あんっ、あっ、もっと、うさぎっぽくって……どうやったら、んんっ、あっ、\n　んっ！！　喋り方……？　んうっ、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「それって、もしかして……あんっ、ああっ、あっあっあっ、わかった、わか\n　ったから、下からゴンゴン突かないで……んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「言う……言うから、んっ……私の腰使いで、んんっ、君を気持ちよくして\n　あげる……ぴょん！！　うう、恥ずかしい……あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ、恥ずかしさでオマンコが締まってるって、そんな、そんなの、\n　んっ、あっ、そんなの知らない、ぴょん、んんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「ううううう、こんな恥ずかしい真似をさせて、酷い男だぴょん！！　君は、\n　私を辱めて……んんっ、あっ、あくうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「た、助けてもらったことは感謝してる……ぴょん！！　でも、こんな風に\n　……んんっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「その割には気持ちよさそうって……それは、君のオチンポが……んっ、あう\n　っ、あっ、んくっ、はあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「言う！！　言うから、オチンポ動かさないで、あんっ！！　君のオチンポが\n　気持ち良すぎるから、太くて、硬くて、ごりごりって、私の中、あうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「私の中、こすってくるから、こんな顔になっちゃう！！　なっちゃうぴょん\n　！！　うんんんっ、んっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「腰だって、こんな、うさぎみたいに跳ねて、ふううっ、君のオチンポ、もっ\n　ともっとっておねだりしちゃう、んんっ、あああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、オマンコも、切なくて何回もオチンポにキスして、んんっ、\n　おねだりしちゃってる、ぴょん！！　ふあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETTEXT", "「んんっ、うっ、あっ、ダメ、ダメだ、もうダメ、イく、イく、イっく、君の\n　オチンポでイっく！！　ふううううっ、あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504135" ]},
		{"command":[ "WAITINPUT" ]},




		
		{"command":[ "STOPANIM", "0" ]},

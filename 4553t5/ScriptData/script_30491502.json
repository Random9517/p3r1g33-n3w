		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETCHARA", "0", "char_00004901_01", "4", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「君のおかげで、こうしてまたいつもの日常を過ごすことができている。感謝\n　しているよ。私にできることなら、なんでもしよう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETCHARA", "0", "char_00004901_01", "5", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「え？　それは、その……うう……君がお願いするなら……ええい、誠意は\n　言葉ではなく行動だと、そう言うんだな！！　分かった、少し待っててくれ」", "NORMAL" ]},

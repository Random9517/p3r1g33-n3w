		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETCHARA", "0", "char_00004915_01", "5", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「き、着替えてきたぞ……これでいいんだな。改めてこの格好をすると、なん\n　というか、気恥ずかしいな……君の前だと特に」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_049_1504104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "冴島長官" ]},
		{"command":[ "SETCHARA", "0", "char_00004915_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「そ、それで、どうするんだ？　わ、私が上に？　分かった……えっと、こう\n　か？」", "NORMAL" ]},

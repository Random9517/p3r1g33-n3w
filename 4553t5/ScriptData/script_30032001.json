{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0043" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「お、来たね。遠慮せずに座りなよ。今日はお祝いだ。あたしがもてなしてあ\nげるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003101" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「さあ、飲みなよ。料理もあたしが手ずから用意したんだ。口に合わないって\nことはないと思うよ。遠慮せずに口にするといい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それじゃあ、乾杯……いいね。いい飲みっぷりだ。おかわりはどうだい？　\nふふ、注いであげるよ。あたしがいるのに手酌なんてつまらないだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003103" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふ、酒の飲み方も様になってきたね。ただ飲むだけじゃない、いい男には\n飲み方にも色気が出るもんだからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003104" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「飲み方だけじゃない、仕事やら戦いやら……普段の仕草にもそういうのがに\nじみ出てきてるよ、最近のあんたはね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「このままこなれていったら、いずれはEDOの皆があんたの虜になってしま\nうかもねえ。ふふ、そうなると争奪戦だね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003106" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「褒めすぎだって？　なにか裏があるって……寂しいねえ。あたしは本気だよ\n。あんたはいい男になってる。あたしが惚れるぐらいにね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003107" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「なんだい、信じられないのかい？　悲しいねえ。あたしは嘘なんてつかない\nってのに。じゃあ、しょうがないねえ。身体に教えてあげるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003108" ]},
		{"command":[ "SETCHARA", "0", "char_00000320_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「おっと、ふふ……なんだい、こんなに大きくして。なんだかんだ言って、期\n待してたんじゃないのかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003109" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「責めてるんじゃないよ。嬉しいんだよ。あたしと一緒にいて、チ〇ポ大きく\nしてたってことは、そう思ってくれてたってことだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「そういうの、女冥利に尽きるってことだよ。それにしても……相変わらず大\nきいね、あんたのチ〇ポは」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「見てるだけで興奮して、身体が熱くなってくるよ……振る舞いもそうだけど\n、チ〇ポにも色気がたっぷりだね……ふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「なんだい、まだ信じられないのかい？　疑り深い男だねえ……しょうがない\n、ほら、これで信じられるようにしてあげるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしが、このエファナティカ様が、嘘のためだけにこうして跪いて、パイ\nズリしてやるなんてことあるわけないだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それにほら、チ〇ポで感じてみなよ、あたしの胸の熱さを……あんたに興奮\nしてるからこそ、こんなに火照ってるんだよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……ふっ……このチ〇ポ、亀頭が大きくて、カリ首も深くて、竿も太く\nて……んっ、たまらないチ〇ポだね……ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「胸で挟んでるだけで、チ〇ポの逞しさが分かるよ……んっ、ふうっ、んんっ\n、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「どうだい、あたしのねぎらいのパイズリは……って聞くまでもないか。そん\nなに気持ちよさそうな顔をしてくれているんだからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003118" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふ、なら本格的に……んっ、ふうっ、ふっ……こうして挟み込んで、動か\nして……んっ、あたしの胸の柔らかさ、感じてるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、上下に動かすたびに、チ〇ポがびくびくしてる。気持ちいいのが伝わ\nってくるよ。ふふ、嬉しいねえ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしの胸で気持ちよくなってくれてるってことが嬉しいのさ。あんたがそ\nうなってくれてることがね。んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふ、わからなくていいよ。惚れた男をもてなすのも、気持ちよくするのも\n、女としての喜びってことだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だからあんたはなにも考えず、あたしのパイズリで気持ちよくなっていいの\nさ。ほら、ほらほら。こうやって強く締めつけるのもいいだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……先端からガマン汁が出てきたね……あたしの胸をぬるぬるに汚して\nきたよ。ほら、ぬちゃぬちゃって音がしてきてる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、いいねえ、その顔。最近は凜としたいい顔が多かったのに、チ〇ポ\nをパイズリされたらそんなだらしない顔になっちゃって……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それじゃあ、もっとだらしなくしてやろうかねえ。あー……むっ。れるっ、\nれろっ、ちゅっ、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、先走りだっていうのに、味が濃いね……溜まっていたのかい？　ふふ\nっ、全部出してあげるからね、んっ、むっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、れるっ、ちゅっ、んうっ……ふっ、ガマン汁と唾液でベトベトだね。\nこの状態で動かすとほら……ぬるぬるって、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしの胸も、あんたのチ〇ポも両方どろどろになってる。んんっ、中に入\nれてないけど、一つになった気分だね、これは。ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「悪くないだろう？　そして、気持ちいいだろう？　ここからは本気だからね\n！！　じゅる、ちゅっ、れるっ、んっ、んむうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003130" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、口で舐めながら胸で挟んで動かして……んむっ、れるっ、ちゅっ、吸\nいつきながら胸で揉んで……んっんっんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたのチ〇ポ、膨らんできたね。竿も熱くなって、ねえ、どこに出したい\n？　胸かい？　口かい？　どこでもいいよ、あんたの好きな場所でね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「好きなときに、好きな場所に出していいんだよ。あんたの好きにしな……ふ\nふ、口がいいんだね？　じゃあ……んうっ、ちゅっ、れろれろれろっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、イきな！！　あたしの口の中に精液出しな！！　ほら、イけ、イっち\nまいな！！　ちゅっ、れるっ、んむうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んふうっ、んっ、んむっ、うううううううううううううううっ！！　んっ、\nんっ、んぐうっ、んっ、むっ、ふううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……んんっ、んぐっ、んっ、ふうっ、ふっ……ふうっ。濃いのがたっぷ\nり出たね……んっ、ぐっ、喉に絡みつくよ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふ、でもこれはそれだけあたしの口と胸で気持ちよくなってくれたってこ\nとだからね。嬉しいよ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003137" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ここまでしたんだ。もうあたしの言ってることが嘘じゃないって分かっただ\nろう？　ん、そんなに頷かなくても見えてるよ。ふふ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしはどうでもいい男なんかに身体を許すような女じゃないからね。あん\nたを…本当に認めてるからさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003139" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だからといって、慢心はするんじゃないよ？　これからも、いい男であり続\nけるようにしなきゃね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「それはそうと……まだまだチ〇ポは元気だね。一回出しただけじゃ物足りな\nかったのかい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「はは、いいよ。もう一回してあげるよ。あたしも、あんたがイくところをも\nう一回見たいしね……それじゃあ、あむっ、んっ、れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んふうっ、出したばかりなのにもうカチカチになってる……それに、分かる\nかい、さっきの精液で胸がどろどろになってるの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003203" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「このまま動かしたら、ほら、粘っこい音が……チ〇ポと胸で、んっ、むっ、\nんんっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふふっ、いやらしい音だよねえ。口からも……んむっ、じゅるっ、ちゅっ、\nれるっ、んっ、じゅるるっ、んぐうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ、むっ、ちゅっ……ほら、口と胸でこんな音が鳴って、んっ、あたし\nの身体も熱くなってきた……ほら、チ〇ポで感じるだろう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしも、あんたのチ〇ポが熱くなってるの感じてるよ。んふっ、あたしの\n口と胸で気持ちよくなってるの、分かるよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003207" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ、今の言葉でまた興奮したのかい？　しょうがない男だねえ。まあ、\nそういうところも魅力なんだろうけれど」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んむっ、ちゅっ、れるっ、れろっ、んっ……んぐっ、んっんっんっ、あんた\nのチ〇ポの味、くせになっちゃいそうだねえ。んむっ、れるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「じゅるるるるっ、ふうっ……んふっ、金玉で精液がぐつぐつ煮立ってきてる\nの、分かるよ。ふふっ、あたしのパイズリとフェラでそうなってるのがね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「さっきも出したのに、また出したくなってきたんだろう？　構わないよ、い\nつでも出していい。でもね――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「二回目も、さっきと同じぐらい出して欲しいね。ほら、それが男の貫目って\nやつだろう？　ふふ、いい男は自分だけじゃなくて女も満足させるものさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003212" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、ほらほら、どうする？　もう出してしまうかい？　ん？　もうちょっ\nと咥えてくれって？　しょうがないねえ。あー……むっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ちゅっ、れるっ、んんっ、ふうっ、んむっ、れろれろれろっ。んふうっ、吸\nいながら舐めて……んむっ、ちゅっ、れるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003214" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「キスしながら舐めて、んっ、チ〇ポが張りつめてきたのが分かるよ、んっ、\nむっ、ちゅっ、れるっ、れろっ、んっんっんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あたしのために精液を溜めてるんだね……ふふっ、嬉しいよ。んっ、むっ、\nんむうっ、ふうっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だったらあたしも頑張って奉仕しなきゃね……ちゅっ、れるっ、んむうっ、\nふううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「口だけじゃなくて胸でも……んふうっ、んっ、れるっ、んむっ、ふっ、んん\nんっ！！　あっ、んっ、またチ〇ポがぱんぱんになって、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003218" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「いいよ、イっていいよ。今度は口でも、胸でも、あんたの好きな場所に、好\nきなだけイっていいよ。んむうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ほら、イきな！！　好きなように、目の前のあたしにぶっかけな、ほらっ、\nほらっ、んっ、ちゅっ、んむううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふぐうううううっ、んぐっ、んっ、んんんっ、んむっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_11" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んんっ、んぐうっ、んっ、ふうっ、ふっ、んぶっ……ふふっ、約束通り、二\n回目も濃いのを出してくれたね。嬉しいよ。」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ……それにしても、お願いしたとはいえ本当に大量に出してくれたね。\n喉が妊娠しちまいそうだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「いや、あたしの魔術ならそれができるか……？　なんてね、ふふ、冗談だよ\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたとの子供が欲しかったら、ちゃんとこっちに出してもらうさ。お腹の\n中に……ね？　ふふふふ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だから気兼ねなく、何度だってあたしの口に出していいんだよ。あたしも、\nあんたの精液ならいくらでも飲んであげるからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「この味も、匂いも、チ〇ポも、精液も、あんたのものならば全部受け入れる\nさ。それが今のあたしの気持ちだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んっ、今ので興奮したのかい？　三回目、するかい？　なんてね。さすがに\n連続で三回はあたしの口がもたないよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003308" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「あんたのチ〇ポは立派だからねえ。相手をする方も消耗するのさ。でも一休\nみしたら……ね？　次は口じゃなく胸に出してもらおうかねえ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「次も気持ちよくしてあげるから、期待してるよ。」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んうっ、チ〇ポ、抜いて……胸に、んうううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「ふうっ、あああっ、胸が、熱い、んっ、ああっ、あんっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「凄い、精液で火傷してしまいそうだね。それだけ興奮して熱くなってくれた\nってことなんだろうけど……あんっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「まだ出すのかい。ふふっ、まるで必死にマーキングしてるみたいだね。そん\nなことしなくても、あたしはもうあんたのものなのに」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「でも、こうされるのは悪くないねえ。あたしも、自分があんたのものだって\n自覚ができるしね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「いっそのこと、毎日こうしてマーキングしてもらおうかねえ。顔と胸と口に\n、あんたの匂いと精液をぷんぷんさせてさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「誰がどう見てもあたしがあんたの女だって、一目で分かるように……ふふふ\nふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「冗談だよ。そんなことしなくても、周りは分かってるだろうしね……いや、\nなんでもないよ。ほら、チ〇ポに残ったのも全部出したね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「んふっ、あたしもあんたも満足したね。気持ちよかっただろう？　あたしも\n気持ちよかったよ。あんたに奉仕できて、ね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003409" ]},
		{"command":[ "SETIMAGE", "0", "still_00000320_01_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "エファナティカ" ]},
		{"command":[ "SETTEXT", "「だから、出したくなったらあたしに言いなよ。他の女じゃなく、あたしにね\n。分かったね、きっとだよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_003_2003410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
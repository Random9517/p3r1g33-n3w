		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETCHARA", "0", "char_00000229_01", "5", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「ここなら二人きりだから……ずっと見てても大丈夫。いつも見せないところ\n　とか、際どいところとか……ほら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904104" ]},

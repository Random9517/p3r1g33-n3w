		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「ふあああっ！！　んんっ、急に激しく、あっ、うっ、あんっ！！　もっと\n　気持ちよくなれって、んんっ、あうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「これ以上気持ちよくなったら、頭の中まで溶けちゃう！！　あなたのオチン\n　チンのことしか、考えられなくなっちゃう！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ひあっ、ああああっ！！　それでいいからって、んっ、あっ、あうっ、んう\n　っ！！　奥、ずこずこするの、ダメっ、ふううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ、今、私凄い顔になってる……あなたのオチンチンで、顔まで\n　ぐじゅぐじゅになってる、んううううっ！！」", "NORMAL" ]},

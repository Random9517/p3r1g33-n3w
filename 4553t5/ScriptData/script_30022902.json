		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「いつもと違うから余計興奮したって、嬉しいっ、ふうううっ！！　あなたの\n　ためだから、この格好は、あなたのためだから、あうっ、うっ！！」", "NORMAL" ]},

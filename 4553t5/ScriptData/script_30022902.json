		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「イくうううううううううっ！！　ふああああああっ！！　精液、出されてる\n　うううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「二回目なのに、濃いのが全部私の中に、ああっ、あんっ、んっ、ふうううう\n　ううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000229_02_11" ]},
		{"command":[ "SETTEXT", "「んふうっ、あっ、うっ、んんっ、奥に、私の奥にどくどくって、注がれてい\n　るのがわかる……んうっ、あっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000229_02_12" ]},
		{"command":[ "SETTEXT", "「ふふ……凄い、出されてるだけで気持ちいい……あなたの精液でお腹の中が\n　悦んでる……んっ、うっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000229_02_11" ]},
		{"command":[ "SETTEXT", "「ふううううっ、オマンコが最後の一滴まで欲しがってるの、わかるでしょ？\n　きゅっきゅって締めつけて、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あんっ！！　ほら、あなたも応えてくれるから……んっ、甘えて、オマンコ\n　で抱きついちゃってる……ふっ、あっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000229_02_10" ]},
		{"command":[ "SETTEXT", "「うふふ、たっぷり愛してもらって……嬉しい。お腹の中があなたの愛で満杯\n　になってるのがわかる……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「これ……絶対赤ちゃんできちゃうよね。私とあなたの赤ちゃん……ふふ、\n　きっと可愛い子供になるわ。でも……一人じゃ可哀想よね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ねえ、知ってる？　うさぎって多産の象徴でお守りになってたりするんだっ\n　て。私もあなたの子供、一杯産みたい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「だからね、これからもいっぱいっぱい愛して、いっぱい子供を作ろうね。\n　きっと、幸せで楽しい家族になれるから。愛してる、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},


		{"command":[ "LABEL", "LABEL2" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETCHARA", "0", "char_00000229_01", "6", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「ね、好きなようにじっくり見て？　んっ、すごい視線……見られてるだけで\n　身体が熱くなっちゃう」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904105" ]},

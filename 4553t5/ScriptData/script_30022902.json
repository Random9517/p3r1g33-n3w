		{"command":[ "SETTEXT", "「んっ、あっ、はっ、中で、また大きくなってるの、わかる……私の身体で、\n　気持ちよくなってくれてるの、わかる、あんっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「もっと、もっと激しくして！！　私の中に、消えないぐらいあなたのしるし、\n　いっぱいつけて……ああっ、んっ、んうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「私も、オマンコであなたのおちんちんにいっぱいキスするから、こうして、\n　きゅって、あっ、ああっ、んっ、ごりごりって、きた、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ああっ、オチンチン、ぶるぶるしてる、私の中で、出したいって震えて、\n　ふううっ、いいよ、また、いっぱい出してっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あなたの精液、いっぱい出して！！　私の中、満たしてっ！！　んっ、あっ、\n　はああああっ！！　私も、私もまたイくから、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、イく、イく、またイくっ！！　あなたのオチンチンで、また\n　イっく、んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904220" ]},
		{"command":[ "WAITINPUT" ]},




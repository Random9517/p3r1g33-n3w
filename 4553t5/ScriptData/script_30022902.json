		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んううっ、なんで、オチンチン抜いて……ひあああああっ、身体に、いっぱ\n　い……んんっ、熱いっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あうっ、んっ、私の身体、あなたので染められてる……中も外も、あなたの\n　精液で、あっ、んっ、ふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000229_02_14" ]},
		{"command":[ "SETTEXT", "「ふうっ、ふっ……んんんっ、肌にべっとり貼りついて……あなたが気持ちよ\n　かったのが、精液に現れてる……あんっ、まだ出るの……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「私の身体もあなたにマーキングされてる……ふふっ、誰が見ても、私があな\n　たのものだってわかるぐらい……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000229_02_13" ]},
		{"command":[ "SETTEXT", "「嬉しい……それぐらい、私に独占欲を抱いてくれたんだもの……心配しない\n　で、私はずっとあなたのもの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あなたがしたかったら、いつでもこういうことしていいし、どこでもしてい\n　いよ。それぐらい、あなたのこと好きだから」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「中でも、外でも私の身体に出していいし、口でも顔でも、好きな所に出して\n　くれていいの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あなたにされるなら、なんでも受け入れるわ。なんだってしてあげる。だけ\n　ど、だけどね、一つだけ、お願いがあるの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「有名な話だけど、うさぎは寂しいと死んじゃうって。私も寂しいと哀しく\n　なっちゃう。あなたがいないと、泣いちゃうかも」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「だから私を泣かせないように、これからももっとずっと私の側にいて。私が\n　寂しがらないように……お願い、大好きなあなた」", "NORMAL" ]},

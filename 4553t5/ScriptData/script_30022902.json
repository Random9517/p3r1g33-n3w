		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「もっと、もっとして！！　あなたのオチンチン、もっと感じさせてっ！！\n　んっんっんっ、あっ、凄いっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「奥のところ、ごつごつって、ほら、私のオマンコが悦んでるの、分かるで\n　しょっ、んんっ、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あなたのオチンチンを大好きって抱きしめて、んっ、ちゅっちゅってキス\n　してる、んくうっ、はっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ、ふうっ、あっ、んっ、中で、またおっきくなってる！！　ふああ\n　あっ、あなたの気持ちいいのが、伝わってくるっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あっあっあっ、あんっ、んっ！！　んくうっ！！　ふうううっ、私の中が、\n　ぐちゅぐちゅってかき混ぜられて、ひあああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「気持ちいい！！　気持ちいいのっ！！　あなたのオチンチンでごりごりって\n　されて、気持ちいいっ！！　ふううっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「身体の中、熱くなって、どろどろになって、んんっ、あんっ、ああっ！！\n　あなたのオチンチンで溶かされてるっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふううううっ、ああっ、ダメ、ダメダメっ、こんな、こんな気持ちいいの、\n　おかしくなっちゃう！！」", "NORMAL" ]},

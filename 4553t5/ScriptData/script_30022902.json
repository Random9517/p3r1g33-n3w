		{"command":[ "PLAYVOICE", "v2_002_2904109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000229_02_01" ]},

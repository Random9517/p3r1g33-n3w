		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「きゃっ！！　んっ、急に、あっ、んっ……凄い……オチンチン、がちがちに\n　なってる……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んっ、視線も……私の全部、見られてる……そんなに見たかったんだ。いい\n　よ。いっぱい見て……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904108" ]},

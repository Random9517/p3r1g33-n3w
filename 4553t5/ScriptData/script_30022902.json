		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETCHARA", "0", "char_00000229_01", "2", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「でも……見てるだけでいいの？　私、あなたになら触られてもいいんだよ？\n　触るだけじゃなくて、もっと凄いことも……」", "NORMAL" ]},

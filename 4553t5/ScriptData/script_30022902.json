		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「ふうううっ、んっ、その顔が興奮するって、んうっ、はっ、あっ、意地悪！！\n　あんっ、そんな意地悪言われたら、あんっ！！」", "NORMAL" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「んんっ、中、ごりごりって、あなたのオチンチンがこすって、あんっ、あっ、\n　気持ちいいっ！！　んんんっ！！」", "NORMAL" ]},

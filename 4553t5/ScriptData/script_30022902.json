		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETCHARA", "0", "char_00000229_01", "6", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「私のこの格好……目をそらしたの、見えてたんだから。それで、その後も\n　ちらちら見てはそらしてたでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「見たかったけど、皆の前だと照れて見られなかったんでしょう？　分かって\n　るから……あなた、こういうの好きだったんだね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_2904103" ]},

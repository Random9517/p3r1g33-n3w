		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ああっ、んっ、口の中から……ふうああああっ、あんっ、んんんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103401" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私の顔と、胸に……んんんっ！！　熱い、ふっ、うううっ、んふううっ！！\n」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あんっ、もう、いたずらっ子ですね……顔がべとべとになってしまいました\n……あんっ、まだ、出て……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103403" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「もう、さすがに叱ろうかと思いましたが、そんな顔を見たら……しょうがな\nい人ですね、あなたは」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふうっ、んっ……満足しましたか？　それならいいです……んっ、ふうっ、\nこういう風に振る舞う……そういう強さもあなたには必要でしょうし」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「それに……ふふっ、あなたの精液をこうして振りかけられるのは、なかなか\n悪くないというか……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私があなたのものだというのが、しっかりと分かるというか……ふふっ、今\nの私を見て、あなたの存在が一目で分かりますからね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふふっ……これからは定期的に、こうしてあなたの精液を塗りこんでもらう\nのもいいかもしれませんね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「もっとも、私はあなた以外の男にこんなことをさせる気も、奉仕する気もあ\nりませんが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私の全てはあなたのためにあります。ですから、きちんと受け止めて下さい\nね。でないと……祟ってしまうかもしれませんよ？　なんてね。ふふふ」", "NORMAL" ]},

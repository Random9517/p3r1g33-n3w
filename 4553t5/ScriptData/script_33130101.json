{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あなた、来ましたよ。今日はあのお方からのお言葉はありませんが……どう\nかしましたか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103101" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私と話したかった……ええ、構いませんよ。あなたからそう言ってもらえる\nのは、嬉しいですね。ふふふ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103102" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「さて、なにについてお話ししましょうか。あのお方のお話でも、私のお話で\nも、あなたのお話でも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103103" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "0", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「なんでもいい……そういうのが困りますね。はてさて、話の種はそれなりに\n持っているつもりですが……どれがいいか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103104" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「……それにしても、あなた。ちょっとは隠して下さい。なにを、ではありま\nせん。視線です」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103105" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
 
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「その……私の胸とか腰とかお尻とか……見すぎです。ま、まあ、私の魅力に\n視線が吸い寄せられるのも分からないでもありませんが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「少しはその、慎みとかですね、そういうものを持って下さい。とはいえ……\nそうですね。私はあなたを導くための存在」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「そちらの方も、導かなければなりませんし？　ええ、ええ。そう、そうです\n。だから、今からすることも当たり前ですね。ほら、そこに座って……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103108" ]},
		{"command":[ "SETCHARA", "0", "char_00031301_01", "1", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふふ……いいんですよ。あなたはじっとしてて……私が全部してあげますか\nら。んんっ、大き……立派なチンポです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「それにしても、こんなに硬くして……ふうっ、こんなの見せられたら私も…\n…いえ、そうじゃなく……んっ、あなたはどうされたいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103110" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「やっぱり……胸でしてほしいですか？　なんでって……あなた、ずっとここ\nばかり見てたじゃないですか」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「女性はそういう視線には敏感なんですよ。特に、気になっている人からのは\nね……それよりも、ここがいいんですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふふっ、私が胸を強調したら、チンポがびくんって動きましたから。じゃあ\n、お望み通り胸でチンポを……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103113" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あっ……んんっ、熱い……それに、凄く硬い……んふうっ、んっ、挟んだだ\nけで震えて……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103114" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んっ、こうして、挟んだまま、胸でこねて……ふふっ、気持ちよさそうな顔\nをしてますね……んっ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103115" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私も、気持ちいいですよ。あなたの顔を見て、こうしてチンポを愛撫して…\n…ふっ、うっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あなたの逞しさを感じ取れて……んんんっ、ふっ、んっ。あのお方の息子で\nすもの。こちらも強くなければ……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「はっ……あっ……んっ……ふっ。それにしても、本当に立派なチンポ……先\n端が大きくて、カリ首も膨らんで……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103118" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「こんなので中を擦られたら……ふううっ、想像するだけで興奮してしまいま\nす……んうっ、ふっ、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ですが、今は胸と……口ですね。ふふっ、こんな逞しいのを口で……あー…\n…むっ、んっ、ふううっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103120" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「熱い……舌が火傷しそう……んむっ、うっ、れろっ……ちゅっ、んっ、んむ\nうっ、じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んふうっ、ふっ……胸で感じるのと、口で感じるのはまた違いますね……あ\nなたのチンポの凄さ、しっかりと感じます……ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んんっ、ふっ、じゃあ、胸を動かしながら、口も……んっ、ふっ、ちゅっ、\nじゅるっ、んんぐっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふううっ、んっ、先端から、先走りが出てきて……んっ、おいし……ふうう\nっ、んっ、んんっ、んくっ、じゅるっ……れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103124" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ちゅっ、れるっ……んっんっんっ……ふうっ。気持ちいいですか……って聞\nくまでもないですね。その顔……ふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103125" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「眉を寄せて、口を引き結んで……んっ、れるっ、ちゅっ……腰もがくがく動\nいて……んんっ、むっ、んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「なによりチンポがびくびく震えて……ふふ、私で気持ちよくなってくれてる\nんですね。いい子、いい子です。あなた。んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふふっ、褒めたらもっとチンポが跳ねてますよ……んっ、いいですよ。あな\nたの思うまま、腰もチンポも動かして……んむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ちゅっ、れろっ、れるっ……んふうっ。イくときも、好きなタイミングで…\n…ね？　私のことは気にしないで、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あなたの好きなように快感を味わって、好きなようにイって……私は全て受\nけ止めますから……んっ、ふっ、れろっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふうううっ、むっ、んんっ、れろっ、れるっ……んんぐっ、んっんっんっ…\n…んむっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103131" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んくっ……その顔、イきそうなんですね……いいですよ、イって。私の胸で\n、口で……チンポ、イっていいですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ほら、ほら……イって、んむっ、れるっ、れろっ、ちゅうううううううっ、\nんんぐううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んっ！！　ふうううっ、んっ、んんっ！！　んんぐっ、んっ、ふうううっ、\nんむううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103134" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_06" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふっ……はっ、あっ……濃い……んっ、そんなに気持ちよかったんですね…\n…嬉しい……ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103135" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「味も……凄くて、喉に絡みついて……んふうっ、ふっ、んんっ……立派なチ\nンポに相応しい射精です……んっ、くっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふふっ、気持ちよさそうな顔で……私も奉仕した甲斐があります。んんっ、\nふっ、ほら、最後まで出して……精液、ぴゅって」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あんっ、まだこんなに勢いよく……本当に気持ちよくなってたんですね……\nんっ、それとも私とだから……なんて、自意識過剰かしら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103138" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んんっ、れるっ……ちゅっ……ふうっ。んっ……出したのなら、お掃除しな\nくては……ね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103139" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「れろっ、れるっ、んっ、んくっ……ちゅっ、んむっ、れろれろれろっ、ちゅ\nっ……ふうっ、チンポ、綺麗になってきましたよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103140" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「竿に残っているのも出し切りましょうね……んむ、んっ、ちゅうううううう\nっ、んくっ、んっ、んふうっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103201" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んんっ、むっ、んぐうっ、んっ、あんっ、もう、お掃除してるのに大きくし\nて……しょうがない人ですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103202" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふふ……いいですよ。あなたが満足するまで、何回でもしてあげます……私\nはあなたの導き手ですから……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103203" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ほら……さっきと同じように、胸と口で……んむっ、ちゅっ、れろっ、れる\nっ……んんんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103204" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「先ほど出したもので胸にチンポが吸いついて、ふふっ、ぴったりと密着して\nますね……あんっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んうっ、ぬるぬるで、胸の中を滑って……んっ、ふっ、あむっ、ちゅっ、少\nし大人しくして……あんっ、ああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103206" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「もう、いけないチンポですね……大人しくしないと、気持ちよくなれません\nよ……んっ、ちゅっ、んむっ……そう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103207" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「いい子、いい子……んっ、いい子ですよ、あなたのチンポ……れろっ、ちゅ\nっ、んっ、そうしていたら……私も……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「こうして、舌で先端からなぞって……れろっ、んっ、カリ首も舌でこすって\n……んんっ、れろっ、れるっ……じゅるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103209" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んふうっ、あなたのチンポ、唾液でべとべとで……いやらしくて……逞しく\nて……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103210" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「口でも、胸でも……凄く、あなたを感じる……んっ、ふっ、んんっ、ちゅっ\n、んむっ、れろっ……ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私の身体も熱くなって……んっ、あなたのチンポに伝わってるの……分かり\nます……んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103212" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「さっき出した精液を、胸に塗りこめられてるようで……んっ、はあっ、あん\nっ、奉仕しているのに、気持ちよくなってきて……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あなたもまた、顔が……気持ちよさそうに緩んでます……ふううっ、んっ、\nいいですよ。また、好きな時に……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103214" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ちゅっ、れろっ、んむっ……ふうっ、あなたの好きな時に精液を出して……\n気持ちよくなって、いいですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103215" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「私は、そのためにチンポに奉仕してますから……ほら、んっ、ああっ、見て\n……カリ首が、胸を擦って……あんっ、ああっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「竿をぎゅって締めつけて……んっ、うううっ、ふっ、それで、口で先端を…\n…んむっ、れるっ、じゅるっ、ちゅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103217" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んんんっ、また膨らんできましたね……あなたのチンポが、出したい出した\nい、イきたいイきたいって……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103218" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「先走りが……ちゅるっ、んふうっ、んっ、ふうっ、見せて……もう一回見せ\nて下さい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あなたのチンポがイく瞬間、私に見せて……ね？　ちゅるっ、じゅるっ、れ\nろっ、んむっ、ふうううううううううううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103220" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んんんんっ、んぐっ、んぶっ、ふうううっ！！　んっ、んんっ、んむぐっ、\nんふうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_08" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「はあっ、あっ、んくっ、んうっ、んぐうっ！！　ふっ、はっ……二回目でも\n、凄い量……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「あなたの精液が、私の口を満たして……ふうっ、んっ、鼻に抜ける匂い……\nんんっ、ふうっ、はっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「頭の中まで蕩けそう……チンポに奉仕するのが、こんなに幸せなんて……ん\nっ、ふっ、んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103304" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ふふ、私が気持ちよくなってしまっては、導き手として失格ですね……んっ\n、あんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103305" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「でも、そうなるぐらい、あなたのチンポが立派で……太くて、熱くて……ん\nっ、素敵でした……れろっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「んむっ、んくっ……二回目なのに味も濃厚で……ふふ、そういう意味でも逞\nしいチンポですね……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「先ほどのと合わせて、お腹の中……あなたのでいっぱいです。んっ、そうい\nう意味でも、幸せですね、私は」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103308" ]},
		{"command":[ "SETIMAGE", "0", "still_00031301_01_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「こうして奉仕して、気づきました。あなたからもらえるものは、なんであれ\n私に幸せをもたらしてくれると」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ナイア" ]},
		{"command":[ "SETTEXT", "「ですから、またこうして、あなたのチンポにご奉仕させて下さい……ね？　\n約束ですよ、あなた」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_313_0103310" ]},
		{"command":[ "WAITINPUT" ]},

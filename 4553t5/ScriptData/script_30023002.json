		{"command":[ "SETIMAGE", "0", "still_00000230_02_15" ]},
		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「はぁぁんっ！　あぁっ、出てるっ……！　精液っ……身体っ、掛けられてる\n　っ……あぁっ、ぶっ掛け……されてるぅっ！", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000230_02_14" ]},
		{"command":[ "SETTEXT", "「ふはぁぁ……掛けられるのも気持ちいい……オマンコだけじゃないの……\n　おっぱいも……お尻も……全部熱くなってるぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000230_02_13" ]},
		{"command":[ "SETTEXT", "「はぁぁ……もっとイキたい……この精液の匂いで絶頂したいの……もっと\n　掛けてぇ……ちゅぱっ、はぁん……美味しい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000230_02_14" ]},
		{"command":[ "SETTEXT", "「れろ、ぴちゃ……んちゅ……はふぅ……あぁ、舌が伸びて止まらないわ……\n　こんなに美味しく感じるのもサキュバスになったせいなのよね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「あぁん……終わっちゃった……でも、こんなに出してくれたのね……素敵\n　だったわ……ありがとう……んちゅっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「くすっ、ビックリしてる……そんなに私って普段はぶっきらぼうなのかしら\n　……だとしたら、元の私はちょっと問題ありかも知れないわね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000230_02_13" ]},
		{"command":[ "SETTEXT", "「男の人って、あんまり素っ気ない状態が続くと、やる気も出なくなっちゃう\n　んでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000230_02_14" ]},
		{"command":[ "SETTEXT", "「だったら、もっと気持ちを高めてあげる方にしてあげた方が、いい精液を\n　貰えそうだもの……ふふっ、そうね、私もちゃっかりしてるの」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「でも、こんな機会じゃないと、なかなか素直になれないもの……あなたとの\n　こと……ふふっ、冗談だと思う？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_002_3004409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "カグヤ" ]},
		{"command":[ "SETTEXT", "「そうね……本気かどうかは……また次の時に、いっぱい確かめて……ねっ♪」", "NORMAL" ]},

		{"command":[ "SETCHARA", "0", "char_00033301_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リディア" ]},
		{"command":[ "SETTEXT", "「あ、あぁ……そうだったわね……貴方への歓迎の準備をしなくちゃ……少し\n待っていて、そこのベッドの方へ来てくれる……？」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リディア" ]},
		{"command":[ "SETTEXT", "「えっ……お近づきの印……？　何かプレゼントでも持ってきたっていうの？\n　申し訳ないけれど、艦長という立場上受け取ることは……っ！」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リディア" ]},
		{"command":[ "SETTEXT", "「はっ……？　い、今……何か、あったのかしら？　目の前に何か変な光が入\nったような……」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リディア" ]},
		{"command":[ "SETTEXT", "「その手腕を、ぜひ当艦でも発揮してほしいと思っているわ。仕事は山程ある\nし、今日のところは鋭気を養って……」", "NORMAL" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リディア" ]},
		{"command":[ "SETTEXT", "「んっ……はぁ……あっ、あぁ……ごめんなさい、その……急だったから、準\n備がちゃんと出来てなくて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_333_0104109" ]},

		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リディア" ]},
		{"command":[ "SETTEXT", "「はぁ、んふっ、あぁっ……奥を突くたびに……オ、オチンポって言うの……\n？　わ、分かったわ……あひぁっ、オチンポっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_333_0104120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "リディア" ]},
		{"command":[ "SETTEXT", "「はっ、ふっ、んんっ……オチンポっ！　あぉっ、オチンポっ！　おぉっ！　\nつ、続けてそんなっ、あぉっ、オチンポっ……あぉっ、オチンポぉ！」", "NORMAL" ]},

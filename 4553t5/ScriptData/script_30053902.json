		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_09" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。中出しされる、快感……た、たまりません……。んふぅ\n　……イッた身体が……弛緩、してしまってます……」", "NORMAL" ]},

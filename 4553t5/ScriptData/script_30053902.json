		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_39b_0000", "ev005_39b_0023", "true", "ALL" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひゃうぅん！　ま、またすぐ腰を動かして……んぁっ、待ってください、オ\n　マンコはイッたばかりで、か、感度が……ああぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904202" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「お、オチンチンがまだ硬いままだから、このままもう一回やるって、なに勝\n　手なことぬかしているんですか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ほ、本当に好きに、ウチのオマンコを……んぁっ、ああっ、まだまだ硬いオ\n　チンチンが、出入りして……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、なんであんなに射精したくせに、ガッチガチにしているんで\n　すか……ひゃぁあんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904205" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「中出しされた精液と、愛液とでいっぱいのオマンコを、んぐっ、いやらしい\n　腰遣いで、ぐちゃぐちゃかき混ぜるようにぃ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁっ、はぁっ、往復するたびにオチンチンが、んひっ、ウチのオマンコの\n　いろんなところをこすってきて……ぇ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「い、いい加減に……そんな……っ！　あっ、ひゃんっ！　そんないやらしい\n　動きで、おお、オマンコ責められ続けたらぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「オマンコがまた嬉しそうに、んひっ、オチンチンのことぎゅうぎゅう締めつ\n　けてしまうじゃないですか……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁっ、ああっ、いい……いいです……それぇ……っ！　オマンコの全部を、\n　オチンチンで責められると……はぁあ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「また、ぜ、全身から力が抜けていってしまいます……。んはぁ、ああ……オ\n　チンチンに抵抗できなくなる……うぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、オチンチンがまた……っ！　先っぽまで、パンパンに膨れあ\n　がってきています……んっ、くぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「抵抗できないウチのオマンコを、じゅぼじゅぼと、いやらしい音を立てなが\n　ら責めてきて……あっ、う……んふぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そんなにされたら、また……イク……ッ！　はぁっ、はぁっ、またイキそう\n　に……オマンコ、またぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},

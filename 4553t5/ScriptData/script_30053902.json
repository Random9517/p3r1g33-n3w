		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "SETTEXT", "「う、うぅ……ここは……？　砂浜……？　目が覚めたかって……だ、誰のせ\n　いでこんなことになってると思ってるんですか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904101" ]},

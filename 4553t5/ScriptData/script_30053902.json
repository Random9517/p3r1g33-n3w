		{"command":[ "SETIMAGE", "0", "still_00000539_02_01" ]},
		{"command":[ "SETTEXT", "「……って、なにしてるんですかっ！　お、お詫びにリラックスさせてやるっ\n　て……そ、そんなオチンチンをだして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_05" ]},
		{"command":[ "SETTEXT", "「んひぃいいぃぃっ！？　な、なに、オチンチンを挿れちゃってるんですか！\n　んっ、急に……あ、うぅ……オマンコがいっぱい……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「気持ちよくなれば力が抜けるだろうって、そりゃそういうこともあるでしょ\n　うけど、んっ、ああっ、だからって……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904108" ]},
		{"command":[ "WAITINPUT" ]},




		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "NORMAL" ]},
		{"command":[ "PLAYANIM", "0", "ev005_39b_0000", "ev005_39b_0023", "true", "ALL" ]},
		{"command":[ "SETTEXT", "「そ、そんな、オチンチンを……んひっ、ピストン激しく、オマンコを突いて\n　……あっ、ああぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こんな状況で、感じてしまうなんて……！　ひゃぁあんっ！　オマンコどん\n　どん、濡らしてしまうだなんて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、オマンコが、あなたのオチンチンでいっぱいに……っ！　は\n　ぁっ、はぁっ、限界までひろげられて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「硬いのが、いっぱいこすれているのが……わ、わかる……っ！　んはぁっ、\n　ああっ、奥、奥まで届いてます……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904112" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「も、もっと力を抜けって、なにを無茶言ってるんですかっ、んくぅっ！　こ\n　んな、イかされそうになったら力が入るに決まってるでしょう！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……って、ち、違います！　イキそうになんか、なってない……ひぃいんっ！\n　ちょ、ちょっと、腰がっ、ああぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "SETTEXT", "「激しくオマンコ、ずぼずぼしすぎ……っ！　んぁくっ、んっ、んはぁっ、あ\n　っ、ああぁっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904115" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「キツく締めつけてきて、気持ちいいって、勝手にオチンチンを挿れておいて、\n　勝手に気持ちよくなってるんじゃないですよ！　ひゃぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「う、ウチだって……んっ、んぐっ、あなたのオチンチンのせいで、もう……\n　ああっ、オマンコが、すごく悦んでしまって、いて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「こっちだって勝手に……腰が、んんっ、反応してしまって……。ああっ、こ\n　んな流れで、イかされるわけにはいかないのに……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、カリがぁ……オマンコのヒダをごりごりと削ってきて……っ！\n　んんっ、くぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「中で、いっぱいに溢れた愛液を、んっ、はぁっ！　か、かきだされてしまっ\n　てます……っ！　はぁ、はぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「き、気持ちいい……気持ちよくなって、しまって……。んっ、んくっ、手足\n　に力が、は、入らなく……はぅっ、ん、ふぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ガチガチの亀頭で、んぐっ、子宮のまで……っ！　はぁっ、はぁっ、ゴツゴ\n　ツ、突かれたら……ああっ、頭が真っ白にぃ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オマンコの中を、んぐっ、出入りしているオチンチンのことしか、んはぁっ、\n　か、考えられなくなってしまいます……ぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁああんっ！　ああっ、ああっ、んはっ、はっ、ああっ、ああぁあんっ！\n　オチンチン、くるっ、いっぱい……んっ、きて……ます……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチのオマンコが、ああっ、ガチガチの勃起オチンチンに好き放題されて…\n　…んくぅうっ、どんどん感じさせられて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んぁっ、はぅっ、腰が動いているだなんて。んくっ、そんな恥ずかしいこと、\n　い、言わなくても……結構ですから……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチの意思では、どうすることもできないん、です……！　はぁ、はぁ、ウ\n　チの腰……勝手に、動いてしまって……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "SETTEXT", "「うっ、くぅ……っ！　オチンチンに、オマンコいいように犯されているとい\n　うのに……はぁ、はぁ、もう……気持ちよくて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「と、とまらないん、ですから……っ！　ああっ、オマンコ、気持ちいいんで\n　す……っ！　んっ、く……はぁっ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「もう、無理です……っ！　オマンコ、気持ちよくされすぎて、イク……オマ\n　ンコもう、イッてしまいますからぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「オマンコ気持ちよくなりすぎて、抵抗なんてできません。身体に力が入らな\n　くなってしまって……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「な、なのに、オマンコは締まって……あなたのオチンチンをぎゅうっと締め\n　つけて……んっ、はぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「し、しごいてます……。中が、うねって、あなたのオチンチンのこといっぱ\n　い気持ちよくしようとしちゃってるんです……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、イきますか……あなたも……。う、ウチのオマンコで、そのガ\n　チガチのオチンチンから……射精までして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「う、ウチのオマンコに、はぁ、はぁ、ザーメンをコキ捨てるつもりなんです\n　ね……んくっ、の、望むところ、です……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチも、あなたのオチンチンでイかされたいので……。中出し、されて……\n　いっぱいイキたいので……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「だ、だして……だしてしまってくださいよ……！　はぁ、はぁ、ウチに、あ\n　なたのドロドロザーメン……いっぱい……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んひぃいいいぃぃぃ～～～～っ！！　き、きたっ、ああっ、中出し……ぃ…\n　…っ！　んっ、んん……はぁ……はぁ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904138" ]},
		{"command":[ "WAITINPUT" ]},





		{"command":[ "STOPANIM", "0" ]},

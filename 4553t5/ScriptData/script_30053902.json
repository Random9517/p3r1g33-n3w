		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETCHARA", "0", "char_00000539_01", "7", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「泳ぐ練習をしていたウチの浮き輪をとって、溺れさせるなんて……。げほっ、\n　げほっ。うぐ……まだ口の中がしょっぱいような気が……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904102" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETCHARA", "0", "char_00000539_01", "5", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「人工呼吸で助けてやったって？　ふんっ、あなたが溺れさせたんですから、\n　あなたが救助するのが道理でしょうに」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETCHARA", "0", "char_00000539_01", "0", "CENTER", "0" ]},
		{"command":[ "SETTEXT", "「はぁ……。それにしても、身体がのあちこちがだるいですね……。溺れたと\n　きに闇雲に動かしてしまったからでしょうか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「な、なんですか？　泳ぐときに力が入っているから、もっとリラックスした\n　ほうがいいって？　余計なお世話ですよ、まったく……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904105" ]},
		{"command":[ "WAITINPUT" ]},

		

		{"command":[ "FADEOUT", "NORMAL" ]},

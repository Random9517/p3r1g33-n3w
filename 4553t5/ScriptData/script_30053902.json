		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「また射精するつもりですか。う、ウチに向かって、んくっ、抵抗されないこ\n　とを、いいことにぃ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ま、まあ、仕方ないですね。う、ウチだって……はぁ、はぁ、こんなふうに\n　されたら、最後までされたいですから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「し、しかたなく、あなたの精液をうけとめて、あ、あげますよ……んくっ、\n　ふぅ……はぁ、ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "SETTEXT", "「ど、どんどん激しくなるっ、オチンチンが……ああぁん！　お、オマンコこ\n　するっ、んひぃっ、い、イク、イク、イク……ッ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ウチ、もう……うあぁっ、ああっ、ああイク……イクイク……オマンコ、あ\n　あっ、あなたのオチンチンで、イ、イク……イかされ……ああ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},


		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_11" ]},
		{"command":[ "SETTEXT", "「あはぁあああぁぁぁああぁぁあぁ～～～～っ！！　あっ、ああぁっ、で、で\n　る……でてます……んっ、くぅうううぅぅぅううぅぅ～～～～っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904301" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「精液っ、またっ、ウチの子宮めがけてびゅ～っと放たれてぇええっ！　んっ、\n　うっ、イク……ッ！　お、オマンコ……イッく……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_12" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、オチンチンがビクビク暴れながら、まだ……射精ぇ……っ！\n　んはぁっ、はっ、あ……んく……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「２度目だっていうのに、どれだけ……っ！　ひゃぁあんっ！　し、子宮に…\n　…アツアツザーメンの塊ぶつかってくる……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_11" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……あうぅ……。も、もう……本当にどうにかなりそうなくら\n　い……ウチのこと、イかせてくれましたね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_12" ]},
		{"command":[ "SETTEXT", "「こんなに……オマンコから、溢れてきてしまうじゃないですか……。はぁ…\n　…ん、ふぅ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_10" ]},
		{"command":[ "SETTEXT", "「も、もう……イかされまくったせいで、余計に疲れてしまいましたよ……。\n　これでは、泳ぎの練習どころではありませんね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904307" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「……ちょ、ちょっと。なにまだウチのオマンコの中でオチンチンを硬くして\n　いるんですか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「お、泳ぎの練習をしないのなら、もっとヤらせろって……！？　バカも休み\n　休みいってくださいよ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_12" ]},
		{"command":[ "SETTEXT", "「でも、泳がないなら海ですることもほかにありませんし……。特別につきあ\n　ってあげますよ。ふんっ、感謝してくださいよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},


		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_14" ]},
		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「ひゃぁああっ！？　な、きゅ、急に、オチンチンを抜いて……！？　ああっ、\n　精液が……でて……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904401" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_15" ]},
		{"command":[ "SETTEXT", "「か、身体に……っ！　んぁっ、精液……すっごい匂いのが、はぁっ、はぁっ、\n　ウチの全身に……か、かけられ……てぇ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_14" ]},
		{"command":[ "SETTEXT", "「はぁ……ああぁ……っ！　い、イク……ッ！　精液、かけられて……イッく\n　ぅうううぅぅぅ～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「んくっ、イク、イク……こんなぁ……っ！　ドロドロの、シャワーで全身汚\n　されながら……また、イク……ぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_15" ]},
		{"command":[ "SETTEXT", "「どんだけ、だ、出しているんですか……。ああ……オチンチンが、上下に暴\n　れながら、まだ……真っ白い精液をまき散らして……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「はぁ……はぁ……。こんなに……んっ、精液がかかるたびに、んくっ、身体\n　が反応して、い、イク……んっ、くぅ……っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_14" ]},
		{"command":[ "SETTEXT", "「も、もう……。なんてこと、してくれたんですか……。こんなにイかされた\n　ら、余計に疲れるだけではありませんか……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_13" ]},
		{"command":[ "SETTEXT", "「なんですか、お詫びに……？　それ以上言わないでください。あなたの『お\n　詫び』なんてロクなものじゃないにきまってます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETTEXT", "「そうですね……。ウチがお詫びの内容を決めます。ウチにこんな辱めを与え\n　たのですから、あなたには……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_15" ]},
		{"command":[ "SETTEXT", "「この任務の間、休まずウチに奉仕してもらいましょうか。今回の件を秘密に\n　しておいて欲しかったら、ウチに従うことです。大人しく」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904410" ]},

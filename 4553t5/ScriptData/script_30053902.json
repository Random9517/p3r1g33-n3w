		{"command":[ "SETNAME", "オボロ" ]},
		{"command":[ "SETIMAGE", "0", "still_00000539_02_07" ]},
		{"command":[ "SETTEXT", "「……んんっ！？　ちょ、ちょっと、なにしているんですか？　もう十分にリ\n　ラックスしましたから……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_005_3904201" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0149" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクの様子がおかしい？　え～っ？　なんのこと～？　見ての通り、ボクは\nいつも通りなんですけど～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704101" ]},
		{"command":[ "SETCHARA", "0", "char_00023107_01", "3", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「別に隠さなくていい？　ボクが変身の影響で発情してることくらい、お見通\nし？　……あははっ♪　そっか～。バレちゃってるのかぁ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704102" ]},
		{"command":[ "SETCHARA", "0", "char_00023107_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「はぁ……上手く騙せてると思ってたのになぁ。まぁいいや。バレてるなら、\nこの疼きを解消するために、文字通り一肌脱いでもらおうかな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704103" ]},
		{"command":[ "SETCHARA", "0", "char_00023107_01", "4", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ひゃ、あんんっ……なんでこんな、ワンちゃんスタイルでセックスしようと\nするのかな？　するなら、もっと普通にっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704104" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_02" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「バックの体勢だと、より深くまでチンポが入って気持ちいい？　ふーん……\nキミがそう言うなら、ウソじゃないんだろうね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んっ……いいよ。この体勢で、キミのガチガチになってる勃起チンポ、受け\n入れてあげるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704106" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「でも、ちゃんと満足させてくれないと、許さないからね。もし気持ちよくな\nかったら、キミの身体が真っ赤に染まっちゃうかもっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほらっ……いつまでも入口にチンポあてがってないで、早く挿れてっ……ひ\nゃ、あんんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704108" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「な、なんで割れ目を擦るのさっ！？　ボクのオマンコ、もうこんなに濡れて\nるのにっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「はっ、んぅっ……ふっ、んんっ！　満足させるためには、焦らすことも必要\n？　そんな焦らし、別にいらないんだけど！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクの身体が発情しまくってるって、分かってるでしょ？　なら、早くチン\nポ挿れてっ！　挿れろっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「挿れて欲しいなら、おねだりの言葉くらい言って欲しい？　あはっ♪　なに\n、その鬼畜な感じっ……！　すっごくゾクゾクするんだけど……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704112" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「えーっと、それじゃあ……キミのたくましいチンポ、ボクのオマンコに挿れ\nてズポズポしてっ……！　いっぱい犯して……好きにイジメてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミにならどんな酷いことをされてもいいよっ。ボクのこと壊していいから\n……だから、ボクとセックスしてっ！　チンポハメて、犯しまくって！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704114" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ひゃああぁぁっ！？　い、いきなり、奥までぇっ！？　こんなにも勢いよく\nチンポ押し込まれるなんて、想像してなかったしっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704115" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ぐっ、あぐっ！　ひっぐっ！　んぐうぅぅっ！　オマンコ拡げられて、感じ\nちゃうっ……！　身体がビクビク跳ねまくっちゃうよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはっ……♪　これ、挿れられただけなのにイッちゃうかもっ♪　なんか、\nいつも以上に身体の相性がいいって思っちゃうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704117" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「えっ……オマンコのヒダが、チンポに絡みついてくる？　オマンコのお肉も\nグニグニうごめいて、奉仕してるみたい？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704118" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「そんなっ……ほ、奉仕だなんてっ……！　ボク、全然オマンコに力を入れて\nないのにっ……！　あぅっ、ぐっ！　んっ、んん～～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「な、なんでこんなに身体が反応しちゃうんだろっ……これも、ヴァルキリー\nになったせい、なのかなぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704120" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あんっ、あんっ！　あっ、あはぁんっ！　き、急に動かないでよぉ！　ボク\nのオマンコ、まだ軽く痙攣してるのにっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704121" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「や、やめっ、あっ、あぁぁぁっ！　奥のところ、ズンズンされてるっ！　キ\nミのカタいチンポで、奥を押されまくってるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「気持ちいいっ♪　オマンコ気持ちよすぎるぅ♪　キミに犯されて、子宮が悦\nんでるのが分かるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「本当にいつもより感じてるっ……！　ヴァルキリー化の影響で感度が上がっ\nてるのは分かるけど、なんでこんなにもヨガっちゃうのぉ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704124" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「心なしか、キミのチンポもいつもより大きい気がするし……もしかして、キ\nミにもヴァルキリー化影響が出てたりするのかなっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704125" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「えっ……キミのチンポが大きいのは、大好きな人……ボクとエッチしてるか\nら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ひっうっ！？　んっ、くっ、ふっ！　はうぅぅっ！　お、犯してるのに、そ\nんな愛の告白するなんて卑怯だよっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704127" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「っていうか、本当はボクのこと好きじゃなくて、エッチできるからそういう\nこと言ってるだけでしょ？　ボク、分かってるからさっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ウソじゃない？　本当に、ボクのことが好き？　……あはっ、あははっ♪　\nそうなんだぁ♪　嬉しいなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクもキミのこと好きだよっ。好きな人にこうして無理やり犯されてると、\nオマンコが熱くなってきてっ……！　ふっ、あっ！　あっぐっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「子宮が降りてきて、チンポに吸い付いちゃうっ……！　キミの精子をおねだ\nりして、ちゅっちゅってキスしちゃうよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704131" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「このままボクの子宮に向かって精液どぴゅどぴゅしてっ！　ボクの性欲を、\nキミのザーメンミルクで解消させてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「妊娠してもいいからっ……！　キミの子供なら、何人だって孕んで、産んで\nあげるからさっ！　だから、お、奥にっ……！　あぁぁぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっあっあっ！　んひっ！　がっ、あぅぅぅっ！　チンポの動き、激しっ…\n…！　それに、オマンコの膣内でビクビクしてるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704134" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あぁぁっ！　は、孕まされるっ！　ボクの赤ちゃん部屋に、大好きな人のザ\nーメン注がれちゃうよぉ！　んぅぅっ！　んっ！　んぅ～～～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ……！　あぐっ……！　チンポミルク、どぴゅーってされてるっ……！\n　熱い汁が、奥の奥まで入ってきてるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704136" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_10" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「直接子宮にザーメンを送り込まれてる感じがするっ……！　お腹の奥、熱く\nて、ジンジンしてるよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おっ、おぉぉっ……！　膣内出し気持ちよくて、イッてるっ……！　ボク、\nキミの射精に合わせてイッてるからっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704138" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほら、分かるかな……！？　オマンコが窄んで、チンポを搾り上げてる感じ\nっ……！　これも、ボクなりのおねだりだよっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミに孕ませて欲しい……妊娠したいっていう、ボクの素直な気持ちっ……\n！　あはっ……♪　身体は正直って、まさにこのことだねっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「はっ、んっ……！　はぁ、はぁ……！　うぅっ、くぅぅっ……！　身体が発\n情してることも、ボクの気持ちも、どっちもバレちゃった♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704201" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミって本当に、面白い人だよね……道化であるはずのボクが、こんなにも\n翻弄されちゃうなんてさ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704202" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んっ、んんっ……でも、今度はボクがキミのこと、翻弄する番だから♪　こ\nのまま腰を動かして、ヨガらせてあげるっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「射精したばかりでキツいだろうけど……ボクのことが好きなら、それくらい\n我慢できるよね？　それじゃあ、いっくよぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あんっ、あっあっ、んんぅ～！　ボクの動きに合わせて、チンポがオマンコ\nをズリズリえぐってくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704205" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクのオマンコが気持ちよすぎて、動くのを止められないの？　ふ～ん、そ\nうなんだぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704206" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「チンポキツいはずなのに、オマンコのお肉の感触を味わいたいだなんて。ホ\nント、変態さんだなぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふっ♪　でもまぁ、そんなところも好きだけどね～♪　ほら。ボクの動\nきにもっと合わせて……んっふっ！　ぐっ、うぐぐぅ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704208" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あんっ、あぁぁんっ！　身体が痺れて、蕩けちゃうっ！　トロトロのオマン\nコが、もっとトロトロになっていっちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704209" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「それに身体もぎゅーって収縮してっ……あんっ、あっ！　んはぁぁんっ！　\nオマンコ、さっきよりも強く締まっちゃうよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ひゃふっ！　んっ、んっはぁっ！　この体勢のせいか、奥の奥までチンポが\n入り込んでくるぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704211" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「それに、出し入れのたびに亀頭がＧスポットと擦れ合ってるっ……！　奥と\n浅いところの快感が、交互に襲ってきてぇ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、あぁぁぁっ！　頭、おかしくなるっ！　ボク、気持ちいいことしか考\nえられない、ドスケベになっちゃうかもぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「えへへっ♪　こんなボクでも、好きでいてくれる？　エッチ大好きで、キミ\nとセックスすることしか考えないような女でも、大丈夫かな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704214" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「普段のボクも好きだけど、エッチなボクも好きなの？　あはっ♪　そんなこ\nと言われたら、本気にしちゃうよっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704215" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「もう絶対に、キミから離れてあげないんだからっ……！　キミも、このぶっ\nといチンポも、ボクのモノなんだからっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704216" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミがボクのモノになってくれるなら、ボクもキミのモノになってあげるっ\n！　この身体、いつでも好きに使っていいよっ……！　あっ、あうぅ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「さっきみたいに、膣内出したり……精液まみれにしたりしていいからっ！　\nだから、ボクと一緒にイッてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704218" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミの赤ちゃんの種を感じながらイキたいっ……！　ザーメン味わいながら\n、アクメしたいのぉっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704219" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おっ、おぉぉっっ！　おっ、おほぉ！　イクッ！　イクッ！　オマンコイク\nッ！　気持ちいいの、溢れ出ちゃうぅぅぅ～～～～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704220" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_10" ]},
		{"command":[ "WAITINPUT" ]},
																
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「膣内に出てるっ！　子宮口にチンポくっつけながら、精液どぴゅんされてる\nっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704301" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「熱すぎて、子宮が火傷しそうだよっ……！　それに２回目なのに量もすごく\nて……最初のと合わせて、子宮がパンパンになってるからぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704302" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「これ、絶対に子宮どころか卵管までザーメン入り込んでるっ……ボクの卵子\n、精子まみれにされてるかもぉ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふっ……♪　女泣かせな射精だねっ……♪　こんなことされたら、間違\nいなく妊娠しちゃうよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクとキミとの赤ちゃん……あははっ♪　ワンちゃんみたいな恰好で孕まさ\nれるなんて、素敵すぎるぅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704305" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほら、最後の一滴まで精子出してっ♪　受精したがってるボクの無防備な卵\n子、ザーメンで犯しぬいてぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んん～～～～……はっ、あぁぁ～……なんか、ヤバいくらい興奮しちゃった\nっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704307" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「発情してるっていうのもあるけど、好きな人とのセックスすると、幸せホル\nモンが溢れて止まらなくなっちゃうのかも♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふっ♪　それにしても、キミとの赤ちゃんかぁ～。まさかこんな形で孕\nまされるなんてなぁ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっ、勘違いしないでね。別にイヤとかじゃないよ。ちょっとだけ、夢みて\nるような気分だなぁ～って思っただけだからさ♪　んひひひっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704310" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_11" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっはぁぁぁっ！　精子かけられてるっ！　ボクの身体、キミのミルク、真\nっ白にされちゃってるよぉ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704401" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こんな汚い汁をかけられるの、本当ならイヤなはずなのに……キミの精液だ\nったら、全っ然イヤじゃないかもぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「むしろ、もっとたくさんかけて欲しいっ！　ボクのこと、ザーメンまみれに\nしてっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あっあっ、んぅっ、うぐぐっ！　身体からキミの子種の匂いが取れなくなる\nくらい、いっぱい滲み込ませてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704404" ]},
		{"command":[ "SETIMAGE", "0", "still_00023107_02_17" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いつでもキミの赤ちゃんミルクの匂いを、味わえるようになりたい……！　\nこの変身が解けても、ずっと発情してたいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミとずぅ～っと、エッチなことをしていたいからさ……！　あっはっ！　\nひゃ、んんっ！　くっ、ふっ！　はふぅぅぅっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あははっ♪　すっごい量だね～。身体どころか、髪まで精液でベッタリだよ\n……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704407" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「これじゃあ、本当に匂いが染みついちゃうっ……んふふっ♪　そうなったら\n、ボクもう外を出歩けないなぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「キミのそばで、キミの精液の匂いを撒き散らす痴女になってぇ……あぁんっ\n♪　それって、誰がどう見ても変態だよねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0704409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふっ♪　でもぉ～、キミの女だって言いふらすみたいで、面白いかもっ\n♪　あぁぁんっ！　想像しただけで、オマンコ濡れてきちゃうよぉ～！」", "NORMAL" ]},

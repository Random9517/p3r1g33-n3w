{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "LOADANIMIMAGE", "0", "anim_00000155_02" ]},
		{"command":[ "SETANIMRANGE", "0", "ev001_55b_0000", "ev001_55b_0023" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……よく来てくれたな。せっかくのアニバーサリーだ、私もいつも尽くして\nくれている貴様に褒美をくれてやろう。これが何かわかるか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604101" ]},
		{"command":[ "SETCHARA", "0", "char_00000136_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「今日の記念にもらってきたシャンパンだ。……ああ。遠慮することはない。\n飲むといい。私直々についでやろう。……どうだ。美味いだろう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604102" ]},
		{"command":[ "SETCHARA", "0", "char_00000136_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……ん？　なぜ急に優しくしてくるのか理由がわからず怖い、だと？　下僕\nにしては頭が回るようだな。そうだ。これはただのシャンパンではない」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604103" ]},
		{"command":[ "SETCHARA", "0", "char_00000136_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「なんと、精力が数倍に跳ねあがる特別な媚薬入りの酒なのだ！　くっくっ、\n驚いたか。今回、王位継承戦で戦って思ったのだ。貴様にも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604104" ]},
		{"command":[ "SETCHARA", "0", "char_00000136_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「改めて、私が一番であることを刻みこんでおかなければ、と。フフ……すぐ\nに酔いは回る。ヘロヘロになった貴様を私が攻めたてて……、ん？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604105" ]},
		{"command":[ "SETCHARA", "0", "char_00000136_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
	
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁっ！？　な、何をするっ！？　な、な、な、なぜ圧倒的パワーを持つ私\nがこんなに簡単に、き、貴様にひっくり返されてしまっているのだ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604106" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「っくぅっ……！　やすやすと背後を取られてしまうとは……！　し、しかも\n仰向けにされて、服を脱がされて……！　こんな屈辱的なことがあるか！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……はぁ！？　媚薬のおかげでモリモリパワーがわいてきた！？　馬鹿なっ\n……！　それはそういう薬ではなく、せ、性的な……、……ううぅっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604108" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「す、すごい力だ……！　わ、わかった。私が悪かった。だからや、やはり今\n夜は解散しようではないか。二日酔いになってもいけないからな！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……こ、こら……！　やめろ、言うことを聞けぇ……！　わ、私の身体をま\nさぐるな、もてあそぶな、い、いじるなぁ……！　あっ、そ、そんなぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604110" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ！？　あぅっ……胸を揉むな、……ひんっ！　腰を撫でるな、……あっ\n！　あ、オマンコに触れていいなんて言っていないぞ！　……あぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「わ、私が濡れている、だと？　し、知らんっ……！　強引にされて喜んでい\nるわけでは……！　お、おい、何をしようとしている？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「チンポを取り出して……、ぁっ、わ、私のアソコにあてがって……！　……\nんんぅっ！？　あ、愛液を塗りつけて……ま、まさか……あぁっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604113" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんんんーーーーっ！？　ンぐぅうううっ！？　くふぅううっ！？　んんん\nぁああああぁああっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604114" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「や、やってくれたなァっ……！？　あっ！　す、すごく奥深く……ぅっ、オ\nマンコの一番奥まで、チ、チンポ、チンポで串刺しにぃっ……！　くぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ジ、ジタバタするなと言われても……！　こ、ここまで深く犯されてしまっ\nたら、……あぁっ！　身体が勝手に抵抗、してしまって……んんんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「な、なぁっ……？　そ、それは私が貴様に飲ませたシャンパン？　それをど\nうするつもりだ……。あっ！　わ、私にも飲ませるつもりか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん、んんんん－ーーーっ！？　……ごくっ……！　ごくっ！　あ、あぁああ\nっ、の、飲んでしまった……！　まずい、て、抵抗できなくなる！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「っふぁあああっ……？　と、とろけるぅう……？　頭が、フワフワして、脳\nがトロトロになって……オマンコが蠢きはじめた、も、もうだめだぁあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604119" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ん、あぁ……♪　あぁああああ……♪　き、気持ちいぃい……♪　気持ちい\nひぃいい……っ♪　チンポ、下僕のチンポ、太くて硬くてぇええ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604120" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev001_55b_0000", "ev001_55b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あへぇええ……♪　入れられているだけで、イキっ……イキそうに……！　\nんぁあああっ……。や、やめてくれぇ、か、勘弁してくれええ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「この状態で腰を振られたら……あっあっあっ、チンポ、打ちつけられたら、\nオマンコがおかしくなりゅぅうう……♪　んはぁあ、だめ、だめぇええ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604122" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……誘っている声にしか聞こえない？　そ、そんなことは……！　んぁっ…\n…！　ち、ちがうぅ、こ、腰を揺らしているのは私の意思では……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁっ、や……やぁあ♪　ムズムズする、オマンコうずうずして、じっとし\nていられないぃ……！　ひぃっ、んひっ、尻を揺すってしま、うぅ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604124" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「チンポをおねだりしてしまうっ……！　あぁ、あぁあああ……！　た、頼む\n……頼むぅうっ、動いてくれ、激しく突いて掻き回してくれぇええ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「も、もう、何もしなくても、身体中ゾクゾクしてすぐイキそうなのだっ……\n！　あっ……ああああっ！　イキたい、イカないとどうにかなるぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「な、何？　もっと淫らにねだれ？　くぅううっ……！　そ、それならもうい\nい……！　い、いい、はずなの、に、……ああああっ、抗えないぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604127" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「お願いします、お願いしましゅぅうっ！　アホアホルナテミスのバカオマン\nコを、貴様の強くて格好いい最強のチンポでイカせまくってくださいぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……んぁああああああっ！　あああああっ！　きたぁあっ、ピストン、ピス\nトンきたぁあああ！　んぁああああ！　あぁああっ！　もっと、もっとぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604129" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あひっ！　あひぃいっ♪　イクイクイクぅううっ！　イクッ……イクぅうう\nっ！　あひぃいいっ！　あぅううっ、しゅごい！　しゅごいしゅごいぃい」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こんなのチンポ狂いになるぅううっ♪　チンポっ、チンポ気持ちいいっ！　\nチンポでイクっ……！　チンポ好きっ、チンポ、チンポぉおっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「もっとえぐってくれ、激しくキツくこすってくれぇええっ！　っぅううっう\nっ♪　イクぅううっ！　チンポしゅごい！　チンポかっこいぃいっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604132" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああああぁあああ……！　オマンコが、チンポに媚びてうねうねうねりはじ\nめているっ……！　あぁ、欲しい、精子が欲しい、中出しされたいぃ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604133" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「下僕ぅううっ♪　射精だ！　しゃせいぃっ♪　太いチンポからびゅるびゅる\n精液中出ししてくれぇっ！　あーーーっ♪　しゃせい、しゃせいぃっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604134" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「出して、出してぇええっ♪　んぁうううっ♪　チンポに尽くします、チンポ\n絞ります、ちゃんと締めつけまひゅ、だから射精お願いしますううっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604135" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……ッくぅうううううううんっ……♪　んふぅううううっ♪　ふーーーーっ\n♪　あっ♪　あっ出てるっ！　出てりゅ、精子出てるぅううっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604136" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_08" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、やめないれぇっ♪　奥ぅ……！　奥で出して、びゅるっ……びゅるっ\nて……！　あひぃいいいっ！　イクっ、ずっとイク、イキ死ぬぅううっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あ～～～～～っ！　チンポ絞るのやめられないぃいっ……！　精液ぃいいっ\n……！　アツアツの精液が私のオマンコに、子宮に注がれて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604138" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「熱いっ♪　あちゅいぃいい♪　でもそれがいいっ、……んぁあああっ♪　私\nのオマンコは、貴様専用のオナホールだ、精液を出すための場所ぉおっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だからもっと！　もっと出してくれ！　……あ～～～～っ♪　ビュルビュル\n音がしてる、子宮に精子、精子溜まっていくっ、すごいぞぉおおっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604140" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「っくぅううううっ……♪　んぉおおおお……っ♪　こ、これ以上は溢れるぅ\n……♪　オマンコから逆流するぅうう……♪　はーっ、はぁああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「や、やるではないかぁあ……。私をここまで淫らにし、乱れさせ、絶頂させ\nながら精液をオマンコに流しこむとは……。だ、だが……っ、んぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ま、まだ媚薬の効果が消えない……！　身体の疼きが、収まるどころか精液\nに反応して、どんどん激しくなってくる……！　それに……、あぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「貴様のチンポも……勃起も射精直後とは思えぬ硬さだ！　太く、長く……く\nぅうっ♪　私のオマンコを堂々と貫いたままで……！　はぁ、はぁ、はぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……なあぁ♪　チンポ、チンポを抜かないでくれぇ……♪　このまま……っ\n、中出しされたばかりの、精液まみれのオマンコを攻めてほしいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ♪　抜かずの２回目というやつだ……！　あっ、ぁっ♪　こ、拒むこと\nなんて許さんぞ！　私の膣圧で無理やりチンポを締めつけて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「腰を動かしてやるっ……！　……あぁああっ♪　ぐちゅぅうっ、じゅぷっと\nいやらしい音がして……んんん、チンポがヌルヌル出たり入ったりっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604207" ]},
		{"command":[ "SETANIMSPEED", "0", "FAST" ]},
		{"command":[ "PLAYANIM", "0", "ev001_55b_0000", "ev001_55b_0023", "true", "ALL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁ……ああああっ♪　これはっ、これはハマるぅう！　ピストン、夢中で\nしてしまうぅううっ……！　あぁ♪　にゅるにゅるする、すごい、すごいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604208" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……んんんっ！？　き、貴様も私にリズムを合わせて……あっ♪　協力して\nくれるというのか！　か、感謝するぞ……！　もっと前後に動かせぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あんっ♪　あぁあああんんっ♪　イイっ！　イイぃいいっ……！　イクぅう\nうっ！　もう止められない、イクっ、イキっぱなしになるぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604210" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぁああああっ♪　オマンコの締めつけがキツすぎる？　し、知らんっ……\n！　あっ♪　私にはもう制御できない、……っくぅううっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「貴様のチンポがっ！　硬すぎるのが悪いのだ！　あっ！？　あっぁっ、どう\nしてこんなにっ、オマンコのヒダにフィットした形をしているぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604212" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んひぃいいっ！　一度チンポがオマンコを往復するたびにっ！　あああああ\nっ！　粘膜からビリビリと電流がのぼってくるっ、あっ、ひゅごいぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「オマンコがバカになるっ！　もうなってりゅっ……！　んぁふぅううっ！　\nイクッ……♪　イキすぎて、もう愛液がだだ漏れだ……！　あっあっあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……んんん～っ♪　そ、そうだ！　奥だっ……奥をぉっ♪　１番奥をごりご\nりズリズリ刺激しろぉっ♪　あっ！　チンポの一番太いところぉおおっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604215" ]},
		{"command":[ "SETANIMSPEED", "0", "VERYFAST" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「カリっ、カリがオマンコをほじくって♪　亀頭の先端が子宮の入口にキスし\nているっ！　っああああああああ～っ！　メスの本能が止まらないぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604216" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こんなスゴいチンポに突かれ続けたら！　あっ♪　孕みたくなるのは仕方な\nいだろぉおおっ♪　あ～～～～っ！　硬いぃいっ、大きい、気持ちいいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ♪　ひんっ♪　ひぃんっ……！　精液ぃっ……！　精液をもう１度この\n中に……オマンコに注いでくれぇっ！　あっぁっ、まだ入るからぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「全部っ……ぜんぶ受けとめてみせるから！　お願いだ、濃くてドロドロのザ\nーメン射精してほしい！　今、今欲しいんだ、もう我慢できんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「射精……中出しお願いします！　あっ……あっ、ドピュッとっ♪　ビュルッ\nと私に射精してくれ、ザーメン、ザーメン注入お願いしますぅううっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604220" ]},
		{"command":[ "SETANIMSPEED", "0", "MOMENT" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぅっ！？　あぁっ、あッ♪　あぁっ、あ～～～～っ♪　ああああああ～～\n～っ……♪　あり、がとう、出てるっ、ザーメン出てるぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_11" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっついっ……！　あっつい子種がびゅぶびゅぶ出てるっ……！　んぁああ\nああああっ……！　これだ、これが欲しかったんだ、あっ、しゅごいいいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっぁっあっあっあぁっ……！　何度も何度もチンポが震えてっ、私の膣\n内に……オマンコの一番奥に射精している、種付けを行っているぅうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604303" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あふっ……んんふっ♪　いいっ……いいぞ！　もっと、もっとだぁ……っ！\n　ああああっ、子宮口に精液がかかって……あっ、イクっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604304" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「子宮に精液をぶちまけられてイクぅぅうっ……！　あーーーーっ♪　オマン\nコが喜んでいるのがわかる、チンポに絡みついて、絞りあげて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ♪　あっぁっあぁっ！　頭の中も、オマンコも真っ白だ……！　ザーメ\nンの色に染まって……♪　いいぞ、最高に気持ちいぃいいいっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604306" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……ん……？　わ、私は今まで何をしていたのだ……？　……はっ！？　そ\n、そうだ、貴様に飲ませた媚薬入りのシャンパンっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それを私も飲んでしまって……。……くぅうっ、わ、我ながら不覚……！　\nあれほどまでに、酔ってメロメロになってしまうなんて……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……い、いいか。さっきまでの私のことは忘れろ。貴様も乱れたのだから、\nお互い様だ。本当ならもっと怒るところだが……そ、その……うん」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「すごく気持ち良かったからな。今回ばかりは許してやる。今日のことは２人\nだけの秘密だぞ！　わかったか！　ううう、本当に私としたことが……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ……ありがとうっ……！　って、き、貴様ぁああ……っ♪　な、なぜオ\nマンコではなく私の身体に射精して……！　っぅっ！？　あぁああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_14" ]},
		{"command":[ "STOPANIM", "0" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひぃっ……♪　熱いっ……！　ザーメン熱い、気持ちいいぃっ……！　あぁ\nあ、い、いやだぁ、中出しで、オマンコで絶頂するはずだったのにぃいっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604402" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「身体に精子をぶちまけられてイクなんて……！　んくぅううっ♪　でも、き\n、気持ち良すぎる……！　精液かけられるの気持ちいいっ、イクぅうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あーーーっ♪　あっぁっあぁっ……！　なんとこってりした、素晴らしい精\n液だ……！　あっ♪　身体中にはりついて、流れて……あうぅうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604404" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「なんという濃厚な香り……♪　あぁああ、わ、私の全てが貴様のザーメンの\n臭いに塗り潰されていくぅうう……♪　あっ、たまらないぃっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604405" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ひ、姫たる私が下僕の……っ♪　貴様のザーメンまみれにされてしまうなん\nて、ど、どうしてこんなに興奮してしまうのだ……！　あああああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604406" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んん……。……はっ！？　わ、私としたことが……！　媚薬に負けて、さん\nざんな姿を貴様に晒してしまった……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000155_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……だ、だが、これも全て……貴様を陥れようとした私のせいでもあり……\n。たまには、こういうのも……うん、悪くなかったかもしれない……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604408" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……ん！？　か、勘違いするなよ！　ストレス解消で、という意味だ！　ま\nあストレスが吹き飛ぶくらいには気持ち良かったことは認めてやる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「貴様もしっかり楽しんだだろう。なので今回の件については互いに不問とす\nる！　いいな！？　ふぅ……汗と精液で身体がベタベタになってしまった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_3604410" ]},

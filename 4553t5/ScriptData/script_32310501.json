{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0180" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「つんつん♪　つんつんつん♪　……ねえねえ。……ねえったら。ちょっとこ\nっちに来て。……そう。こっちの狭いとこ。柱の陰……そうそうそう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503101" ]},
		{"command":[ "SETCHARA", "0", "char_00023105_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んふふふ♪　指でつんつんしてごめんね～？　こうでもしなきゃ、キミと２\n人きりになれそうになかったからさぁ。で、何の用か知りたいよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503102" ]},
		{"command":[ "SETCHARA", "0", "char_00023105_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「実は～。最近、キミのために練習してた手品があってさぁ。それを披露させ\nてほしいんだ。今ここでって？　そう。いっくよー、１、２、３！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503103" ]},
		{"command":[ "SETCHARA", "0", "char_00023105_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「そぉれぇ～～～っ♪　あはははっ！？　驚いた！？　そう、瞬間脱衣術！　\nいきなりキミを全裸のすっぽんぽんに剥いちゃう荒業だよ～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503104" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……ま～さ～かこんなトコでマッパにされるなんて思わなかったでしょ？　\nおもしろ～い♪　たのし～い♪　あ、もちろん助けを求めるのはダメだよ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503105" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「シーッ……♪　今キミが声を出したら、もちろん誰かが来ちゃうじゃない？\n　そしたらヘンタイがいる～って大騒ぎになるよね。大事件確定じゃん♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503106" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「それは困るよね～？　と、いうことでじっとして？　それから沈黙お願いし\nまーす♪　……え？　別に嫌がらせとかじゃないよ、ボクたち仲良しじゃん」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「慌てないでってば。すぐに気持ちよ～くしてあげるから。……そんなことよ\nり服返せ？　やーだね。ま、取り返せるなら取り返してみたら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクの手がひきずり出す、圧倒的な快楽に逆らえるならね～♪　……んん？\n　どれどれどれ。あれ～？　もうチンポバッキバキだけど？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503109" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「これはイタズラしてほしそうな、ワルそーな誘惑チンポだね～♪　ひっひっ\nひっ♪　こ・れ♪　イジってほしいでしょ？　いいよ～いくらでも♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503110" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ドレス姿の、いつもと違うボク……。おしとやかで上品なボクがキミの、下\n品でデカすぎる極太チンポを手コキしてあげま～す。遠慮しないで！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503111" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほぉーら、シコ、シコ、シコ……♪　わぁ～、気持ちいいね～っ？　チンポ\nだけじゃないよ？　タマタマも丁寧にモミモミしてあげちゃいまぁーす」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503112" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ほれほれほれ、もみもみもみ♪　シコシコシコ♪　もにゅもにゅもにゅ♪　\nシコシコシコ♪　なかなかのテクニックでしょ？　力加減もばっちり～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「えぇ？　気持ちイイけどそれどころじゃない？　またまた～♪　……って本\n気で怒られたら怖いから～。もっともっと気持ちよくしてみよーっと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……んっ♪　あ～？　油断してたでしょ。そうだよ、タマタマとチンポだけ\nじゃなくて、キミのお尻の穴ぁ……いわゆるアナルを刺激しちゃってまーす」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503115" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ふふふふ、急に触られてビクッとしちゃってさ～？　結構素質あるんじゃな\nいの？　アナルの皺を指でなでなで～。すりすりー♪　あ、震えてる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503116" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「なーんだ、めんどくさい開発なんかしなくても、簡単にボクの指くらい入っ\nちゃいそうだな～？　とはいえ、デリケートな場所だし……ほらほら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ローションを塗ってぇ～。はい、つぷぷぷぷ……♪　あ、お尻の中にボクの\n指が入ってきたのわかる？　チンポがビクビクッて反応したね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503118" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「うん。キミの予想通り……わ、このへんかな？　前立腺っていうのをクニク\nニいじらせてもらおうかなーって。あは……。キミのお尻の中あったか～い」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503119" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ローションでヌルヌルしてるからヘンな感じでしょ～？　さてさて。このへ\nんかな？　なーんかコリコリしたのがあるから……そこをクリクリクリ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503120" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おぉおっ♪　お尻の穴、きゅーってすぼまったぁ♪　そんなに警戒しないで\nよ～。チンポも連動して反応してるね、どれどれもっとやってみよーっと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503121" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「前立腺～、ぬちゅっ♪　ぬちゅぬちゅぬちゅ♪　んん～♪　このローション\nの湿った音～♪　あれ？　もしかして効きすぎた？　イッちゃいそ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503122" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「それはまずいね。……ってことで中断～。もうまわりなんて、ぜーんぜん気\nにならないでしょ。ってことでネタバラシ～。じ・つ・はさぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503123" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「この手品、服を脱がすだけじゃなくて皆から見えなくなる手品も同時にやっ\nてるんだよね。だから声をあげてもよっぽどじゃないとバレないんだよ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503124" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「えへっ、すごい？　ボクってば天才じゃない？　……えぇ～？　バレないっ\nて言われても信用できない？　気が気じゃない？　ふぅーん、そうなんだ～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503125" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「じゃあもっとねっとりシコシコしちゃおーっと。愛をこめてね……♪　シコ\n、シコ、シコ♪　シコシコシコ♪　あ、カウパーが出てきたよ～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「もしかしなくても、キミぃ……裸でチンポいじくられることに興奮してるよ\nね♪　露出……好きでしょ。才能あるよぉ、開花させてこ～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503127" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「そーれ、シコ、シコ、シコ、シコ……♪　んんんっ、どんどんチンポの中に\n芯が通ってきてるカンジ……♪　硬いねぇ、元々おっきいのにさぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「こんっな凶悪なチンポでいつも、ボクはひんひん泣かされてるってわけだぁ\n♪　ん～、悪くないね～♪　もっともっと硬くしてよ……。って、こらっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「今射精しそうになってなかった？　まだダーメ♪　わかるぅ？　この絶妙な\n焦らし具合……♪　イケそうでギリギリイケなくてもどかしいでしょ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503130" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……と、チンポに意識が集中したところでアナルに指ずぶぅ……♪　あはっ\n、ボクの指をギチギチに締めつけてくるぅ♪　キミのアナル力強いねぇ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503131" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ぬぽっ♪　ぬぷっ、ぐちゅっ……あ～♪　女の子のマンコみたいに敏感で、\n貪欲で、ヌルヌルしてるぅ♪　いやらしい音たてちゃってまぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ここ？　ここぉ？　いいよ、射精したくなったら出しちゃっても♪　でも今\n出したらぁ、露出アナル射精がクセになって性癖歪んじゃうかもだよね～」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503133" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「それでもいいならイッてみよっか～。もういいじゃん、ヘンタイになっちゃ\nっても。ほら、皆に見せてあげよ♪　変態露出アナルでイクところ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503134" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いいよいいよ～♪　どんどんイッちゃお～♪　チンポに優しくカウントダウ\nンしてあげるねぇ♪　５～、４、３、２、１……はいどぉぞ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503135" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「びゅるるるるっ♪　どびゅるるるぅ～っ♪　あは～っ！？　すっごい勢いっ\n！　信じられない量の精液がどびゅどびゅ出ちゃってるよぉっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503136" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_03" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「え～っ♪　えぇ～！？　へ～ぇ、射精するところ、こんなにマジマジと見た\nことないんだけど……１人でする時もこんなに出るの？　ほらっほらっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「びゅるるるっ♪　びゅるーっ♪　って壊れた蛇口みたいに真っ白な精液がほ\nとばしっちゃってるじゃない！　毎日こんなに出たら大変そ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503138" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……え？　ボクがシゴき出したから？　いつもより量も多くて色も濃い？　\nわ、わぁあ～♪　そんなこと言われたらドキドキしてきちゃうなぁ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503139" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ふーん♪　そうなんだ～♪　それならもっともっと調子に乗っちゃお～♪　\nあはっ、ドクドク射精するたびにチンポ脈打ってるっ……カワイイなぁ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503140" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……んっ……♪　ボクの手のひらだけじゃ受けとめきれなかったかぁ。ちょ\nっとだけ溢れちゃった。もったいないなぁ～。今度はうまくやるねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503201" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「なに？　このまま続けるつもりなのか、って？　それさ、本気で質問してな\nいでしょ。自分が一番わかってるんじゃない？　まだ足りないってこと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「もっとしてほしいよねぇ？　だってほら、ボクの手の中で精液まみれになり\nながら……チンポはずーっと元気なままだもん。やめてほしくないんだよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503203" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……ボクの小手先の手品なんかより、こっちのチンポの方がイリュージョン\nじゃない？　普通射精して、さらにでっかくなるとかありえるの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503204" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「フフ……。ボクがニヤニヤしてる？　楽しそう？　楽しいよ～そりゃあ♪　\nまだまだキミで遊べるってことだし……って口がすべった」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「まだまだキミにご奉仕できるし♪　ってことで、ボーナスステージってこと\nで、もう１回このチンポには気持ち良くなってもらうことにしまーす」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503206" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「わ～……♪　精液が潤滑油がわりになって、すっごく手コキしやすくなった\nよ～♪　にゅるんっ、にゅるっ、ぬるぬるって指がすべるぅっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503207" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「っとととっ！？　今までよりも手の動きが大きくなるわけだぁ……♪　んっ\n、ヌルッ♪　ぬるるっ♪　あっはっ、これ面白過ぎっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「それに、精液の臭いが強くなってきてる……♪　ボクの手の中であっためら\nれてるから？　あ、臭いって手品でどこまでごまかせるんだっけぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503209" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ん、んんっ♪　まわりの人たちもびっくりするだろうなぁ～？　キミとボク\nの姿は見えないのに、濃ゆ～い精子の臭いだけがプンプンしてくるなんて」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503210" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「誰かが発情しちゃったらどーしよ♪　とびっきりキケンなチンポだからさ、\n臭いだけでも女の子をムラムラさせちゃうかもしれないじゃない？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んっ♪　やっぱり本能でわかっちゃうよね、この精子がアブないって♪　マ\nンコに注入されたら、トロけてそのまま妊娠させられちゃうって♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503212" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ってことで、つよーい精子をもう１回作ってくださーい♪　このおっきなタ\nマタマでね♪　ん～、ずっしり重くていいなあ、シワシワも愛おし～い♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「え？　ふざけてないよぉ。真剣に手コキしてる、よ♪　その証拠にチンポビ\nンビンのままじゃない。でも疑うなら～。こっちも攻めなおしてあげよう♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503214" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「そぉれ、ぬぷぷぷぷ……♪　あれれ？　キミのアナル、さっきよりすんなり\nボクの指をくわえこんでるね。禁断の快楽を知ってしまったかな～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503215" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「男の人のお尻の穴ってさぁ、ボクらのマンコみたいなものだから……こうし\nてにゅぷにゅぷされるとたまらないでしょ？　どんどん敏感になるよねぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「男の人のマンコ♪　ケツマンコで感じまくりながらチンポでも快感を得られ\nるなんて、欲張りすぎ♪　はぁ、はぁ……すごい、指があったかい♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いいよ～♪　タマタマから精液あがってきてるね～♪　このまま派手にイッ\nてみよっか～……♪　そぉれ、それっ、いつまで耐えられる～？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ドレス姿の淑女が集うパーティー会場で、全裸になってアナルイキするの恥\nずかしいね～♪　ヘンタイになっちゃうとこボクによーく見せて～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503219" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「前立腺を何度も刺激して、射精スイッチをオンにしてあげる～♪　ぐりぐり\nぐりっ♪　チンポも丁寧にシゴいて……ほらっ、出していいよっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503220" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「びゅるーっ♪　びゅっびゅっびゅーっ♪　シゴけばシゴくほど勢い良く出る\nねー♪　んっ、根元からぁ……先っちょまで気持ち良く絞り出すよ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503301" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_05" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「おぉおおっ……♪　どぴゅどぴゅどぴゅって、ボクの手の中で爆発してるぅ\n……♪　まったく、やらしいんだからキミってば……♪　いいよぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「枯れて何日か出なくなるまで出しちゃえ♪　はい、びゅーっ♪　びゅーっ♪\n　びゅるるるっ、びゅーっ……♪　手どころか腕にまでかかってる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503303" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「熱い雫がだらだらこぼれて……すごい臭いが充満してる♪　キミの精液、お\n気に入りなんだよね～っ。このぬめり、指でもてあそぶと気持ちいいんだぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503304" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あ、まだ出そう？　うんうん、性豪で素晴らしい限りだよ♪　はーい、搾る\nよぉ～。ぎゅううう～♪　びゅるびゅるびゅるっ、むぎゅうううっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503305" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あはははっ！　最後にぴゅぴゅぴゅって飛び出したぁ！　はーい、お疲れ様\nぁ♪　これだけ出したら当分射精しなくて大丈夫そうだね～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503306" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……むふふふ♪　２回目は、１回目より上手に精液受け止められたんじゃな\n～い？　ボクってば、Hの最中にも成長してる……褒めてくれていいよお？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ん？　そんなことより早く服を着せてくれって？　もう着ちゃうの～？　せ\nっかくだから、この解放感……じっくり味わっておけばいいのにぃ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503308" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あ～ん、そんなに怒んないでよ～♪　可愛いイタズラじゃないか～♪　でも\n……キミに露出とお尻の才能があったことはよーく覚えておくよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503309" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「あ、ヤバいヤツに秘密を握られちゃったとか思った？　フフフ、そのとーり\n♪　ボクに見つかったからには、諦めて堕落の道を歩もうね～♪　ふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503310" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「んっ！？　あはっ……！？　これはすごいねっ、記録に残りそうなスーパー\n射精！　あっ……あっ、空中にどんどん精液が飛んでくよっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503401" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_07" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクの手だけじゃもう押さえていられない……！　あっ♪　あぁっ、せっか\nくのパーティー会場が、キミの精子に染められてく……興奮しちゃうよぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503402" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「いいね、いいねっ♪　普段できないこと、しちゃいけないこと、ボクと一緒\nに思う存分やってみようよ……いっぱい精液ぶちまけちゃおうっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503403" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「今なら誰にも見られないし……っ、あっ♪　ボクは見ていてあげられるから\n……！　あぁ……♪　すっごいっ、２回目とは思えないこの大量の精液っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503404" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「やっぱりキミを悪だくみの相棒に選ぶと楽しい……！　ほらっ、もっと出し\nていいよっ！　びゅーっ、びゅーって……あああ、うっとりだ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「びちゃびちゃ床にかかってるこの精液……。この量、このヌルヌルがいつも\nボクのマンコに注がれてるなんて……信じられないくらいだなぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503406" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ふー……♪　今日はいっぱい、キミで遊べて楽しかったよ～♪　たまにはこ\nういうHもいいよね、ボクが冷静なままキミを好きなだけもてあそべる」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503407" ]},
		{"command":[ "SETIMAGE", "0", "still_00023105_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「……冷静、っていうのは正しくないか。うんうん。たくさん興奮させてもら\nったけど♪　今までにないやり方だったからもう楽しくってさ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503408" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ねえねえ～。これからは、たまーにこういうHもしようよ～♪　え？　恥ず\nかしいからやだ～？　乙女みたいなこと言わないで♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "ジェスタ" ]},
		{"command":[ "SETTEXT", "「ボクはキミとこれからも、たっくさん刺激的なイケナイことをしたいんだよ\nね～。だから、身体は空けといてよね、すぐに誘いにいくからさ～♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_231_0503410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「どうやら、まったく反省していないようだからな。今度は私のマンコで、精\nも根も尽き果てるまで、貴様の全てを搾り取ってやる♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104101" ]},
		{"command":[ "SETCHARA", "0", "char_00000141_01", "8", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},		
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「言っておくが、貴様から動くのは禁止だぞ？　念を押しておくがこれはお仕\n置き、なのだからな」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104102" ]},
		{"command":[ "SETCHARA", "0", "char_00000141_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――なに？　その割に私のマンコが既に濡れているようだ？　お仕置きと言\nいながら私も期待してるだろ、だと？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104103" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そ、それは……仕方ないだろ……貴様の痴態をあれ程見せられて、精液の匂\nいをたっぷり嗅がされたんだ……こ、興奮するに決まってるだろ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104104" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「な、なな、そ、そういうところが可愛い、だとっ……！？　や、やめろ、後\nろから頭を撫でるなぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そんなお世辞を言ったところで、手加減はしてやらないからな……！　これ\nだから貴様は……まったく……まったくぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104106" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ほ、ほら、いい加減始めるぞ！　このままチンポを呑み込んでやるから、貴\n様はただ私のされるがままとなっているがいい……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104107" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぅんっ……！　さっきあれだけ出したというのに、このチンポの固さっ…\n…あっ、んぅんっ……流石、だなっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104108" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「熱々チンポが、どんどん奥まで入ってくるっ……あっ、あぁんんっ……私の\n膣内も濡れ濡れだから、簡単に全部入ってっ……んあんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104109" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ああ、やはりいいなっ……貴様と繋がっているだけで、胸の奥まで熱が込み\n上がってくるみたいでっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――っ！　な、なんでもない、今のは無しだ！　これは罰なんだからな！　\n甲斐性なしの貴様へ罰を与えているだけだからな！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104111" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んぁんっ……！　このまま私のマンコ全てで貴様のチンポを絞り上げ\nていくからな、しっかり反省するんだぞ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104112" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んあっ、あぁんんっ……！　ああこら、貴様は腰を動かすな。これは\n罰なんだからな、全部私がするんだっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104113" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっああっ、あぁんんっ！　チンポをズボズボさせるのもいいが、こうやっ\nて前後にも腰を動かしてっ……んあっ、んふぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104114" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「亀頭をヘソの裏側にぐりぐり押し当てるのも、やはりいいなっ……！　あっ\n、んふっ、んっふぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104115" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んひゃぁんっ……！？　お、おいっ、だから貴様から動くなとっ、あひっ！\n　あっ、んひゃぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104116" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――そ、そういうのはもう終わり？　す、素直な私の方が好き、だとっ？　\nんあぁんっ！　き、貴様はいつもずるい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104117" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あひっ、あっ、ふあぁんっ！　分かった、分かったからぁ……！　そうだ、\n私ももう、我慢なんてできないんだっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「お仕置きなんてもう、どうでもいい！　貴様のチンポをもっと感じたい、貴\n様からも、もっと気持ちよくしてほしいっ！　だから――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふあぁんんっ！　おっ、んくぅうんっ！　来たっ、下からズドンと、赤ちゃ\nんの部屋まで来たぁ！　あぁんんっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104120" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「フフ、フフフっ♪　ああ、そうだな、ここからは二人一緒にだ。私のマンコ\nを好きに使っていいから、私のことも気持ちよくしてくれ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104121" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあっ、あっ、あぁんんっ！　んぅんんっ！　チンポのデコボコでマンコの\n膣内を削られるの、いいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104122" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「エラの部分が入り口に引っかかるからっ、んあぁんんっ！　ズブズブされる\n度に、膣内を全部引っ張り出されるみたいでっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104123" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――わ、わかった、さっきみたいに腰を前後に振ればいいんだな……んふっ\n、あっ、んっふぅうんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104124" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「やはりこの動き、へその裏の敏感なところに亀頭がゴリゴリ擦れてっ、ひっ\n、あっ、チンポすご過ぎるぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104125" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「貴様ももっと下から突き上げてくれ！　あぁんんっ！　チンポで子宮を押し\n上げて、身体の芯まで響くぐらいの勢いでっ、んっふぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104126" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そう、それだっ、んあぁんんっ！　マンコから愛液が噴き出して、じゅぶじ\nゅぶってっ、あっ、ああぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104127" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私と貴様の匂いがまじりあって、頭クラクラ、するぅ……！　繋がったとこ\nろから熱が伝わってきてっ、ああぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104128" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だ、駄目だ、まだイくな！　お仕置きは終わったけどっ、イク時は一緒にイ\nきたい、からぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104129" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、あっああぁんんっ！　マンコの膣内でチンポがヒクついてっ\n……！　私も太腿が痙攣してっ、んくぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「腰の動き、止まらない！　パンパンって、みっともなく腰を打ち付けるのが\n気持ちよすぎてっ、ひっ、んあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104131" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「マンコをぎゅーって締めるからな！　精液を搾り取ってやるから、このまま\n膣内に全部出してくれ！　私の子宮を貴様の子種で満たしてくれ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104132" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_03" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んうぅんんっ！　一気に腰の動きが早まってっ、あひっ、あっ、ふあぁんん\nっ！　そうだ、必至に腰を振りたくって、私を突き上げてくれっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104133" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、あぁんんっ！　く、来る、チンポが膨らんでっ、あぁんんっ\n！　私もイク、一緒にイクからっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104134" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「イク、イクイクイク、イックゥぅううん！　膣内出し射精で、イックうぅぅ\nんんっ～～～～！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104135" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_06" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁぁ～～～～っ！！　な、なんてっ、勢いだ！　子宮に直接精液が流れ\n込んできてっ、あっ、ああっ、んああぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104136" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「またイクっ、精液を受け止めるたびにイクっ、イックうぅぅんっ！　ああ、\n熱々チンポミルク、最高だぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「駄目だ、まだ射精を止めないでくれっ……！　もっといっぱい、貴様の精液\nで感じていたい、からぁ……！　んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104138" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ほら、マンコの膣内、最後までグネグネしてやるからぁ……！　貴様も腰を\n止めないでくれぇ……あっ、んんっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……繋がってるところから、精液がどんどん逆流してきて\nる……なんて下品な音だ……フフフっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104140" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「……これだけ出しておいて、まだチンポ、こんなに固いままだとは……相変\nわらずの絶倫っぷりだな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104201" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――なに？　まだまだいける？　このままもう一回？　そうだな……フフっ\n、私も、少し物足りないと思っていたところだ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104202" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「さっきも言った通り、お仕置きはもう終わりだ――だから、その……ここか\nら先は、今日も頑張っていた貴様へのご褒美、だな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104203" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあっ、あっ、んぅんんっ！　またいきなり、深くまでくるじゃないかっ、\nあぁんっ！　膣内出しのお陰で、滑りも良くてっ、んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104204" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――分かってる、もっと締め付けてほしいのだろうっ……んぅんっ……こう\nして、チンポを食い千切る勢いでマンコを締め付けてっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104205" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「私もまた、腰を動かすからな！　パンパンって尻を打ち付けてやるから、私\nのマンコを、思う存分堪能しろっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104206" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ、あっ、くぅんんっ……！　こうやって、円を描くように腰を回して\nっ、締め付けて、叩きつけるっ、あっ、んくぅんぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104207" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふふっ♪　貴様の好きな動きは全て把握してるからなっ♪　どうだ、気持ち\nいいだろう♪　さっきから情けない喘ぎ声が漏れてしまっているぞ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104208" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっくぅうんっ！？　ま、待て、その角度は刺激か強すぎてっ、んひゃぁん\nっ！　おっ、んひゃぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104209" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――じ、弱点を把握してるのはそっちも一緒だと？　フフっ、そうだな、私\nの身体のことは、全て貴様に把握されてるのだったな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104210" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「なら、お互い気持ちい所を擦り合ってっ、一緒に気持ちよくなろうではない\nか……♪　あっ、んあぁんっ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104211" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「こ、この体勢だと、チンポがズボズボされているのがよく見える……！　あ\nぁんっ！　繋がってるところが白く泡だって、下品でっ、んあぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104212" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「それに角度がいい感じでっ、あっ、あぁんんっ！　チンポの突き込みに合わ\nせて、お腹がボコって膨らんでるっ！　あっ、んひゃぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104213" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「そこっ、奥もいいけど、入り口の浅い所、チンポのエラでしつこく擦られる\nもいいっ！　気持ちいいっ！　んっくぅうんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、ああっ、んはぁんんっ！　わ、分かってる！　もっと激しく、腰がガ\nクガクになるまで跳ねて、マンコを抉ってっ、んひっ、あっ、ふぁんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104215" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「来た、チンポがヒクついて、また大きくっ……んあぁんっ！　私も限界だか\nらっ、もう我慢できない、からぁ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104216" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「出してくれ！　私のドロドロのエロマンコに、熱々精液を思う存分ぶちまけ\nてくれ！　また、一緒にっ、んあぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あひっ、あっ、ひ、ふぁんんっ！　あた、ま、真っ白になるぅ……！　激し\nすぎて息、できなっ、ひあっ、は、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「イクぅっ！　またイクっ、あひっ、あっ、ふあぁんんっ！　ガチガチチンポ\nでイクのっ、イきたいのぉ！　だからぁ……ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「チンポミルク出してえぇ！　全部受け止めるからっ、んあぁんっ！　私の全\nてを染め上げてくれぇ！　んあぁんっ！　イク、イクイク、イックゥん！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104220" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んひゃあぁんん～～～～っ！！　あっ、ひっ、ふあぁんんっ！　こんなすご\nい量、やっぱり受け止めきれないぃ……♪　オマンコから逆流するぅ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104301" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_10" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「ふ、ふふふっ……♪　まだこれほどの量を出せるとは……普段の貴様は情け\nないのに、これだけは本当に、他の追随を許さないな……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あっ、んあぁんっ！　んふぅんっ！　ああ、マンコ全てが気持ちいい……♪\n　貴様の精液を膣内に出されてイクの、最高だぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104303" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んぅんっ……はぁ、はぁ、はぁ……さ、流石にもう出ない、よな……？　ど\nうだ……私のマンコで、満足できたか……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104304" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「わ、私か……？　それは、その……わざわざ言わせるな。……気持ちよかっ\nたに決まってるだろうが」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104305" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「――なに？　そのチョロさは反省しろ？　お仕置きが必要だ？　はぁ……貴\n様はいつでもブレん奴だなぁ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「だが、そうだな……ふふっ、中途半端になってしまったが、本来貴様にお仕\n置きをしてやる予定だったな♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104307" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「おっと、逃がすものか。煽ってきたのは貴様だぞ？　どちらが先に相手を反\n省させられるか、勝負と行こうじゃないか♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104308" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_09" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「なーに、夜はまだまだ長い。それに……んんっ……チンポもほら、もう固さ\nを取り戻している。もう数戦は、いけるよな？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104309" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「言ったろう？　貴様が嘆いても逃がしてやらないと。最後の一滴まで搾り取\nってやるからな、覚悟するんだな……ふふふっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104310" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_09" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ！　ああっ、マンコからチンポが抜けてっ……んんぅんっ！　\n身体に掛かるっ、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104401" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_13" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「す、すごい、顔にまで飛んでっ、あっ、んあぁんんっ！　駄目だ、この匂い\n更に頭、クラクラして……あっ、ああっ、ふあぁんんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104402" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「精液が付着したところ、全部熱い……顔も、胸も、腹も……ピリピリ痺れて\n、全身がイってるみたいだ……んんぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104403" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「あぁ、まだ止まらないでくれ……もっと欲しい、私の全身がドロドロの精液\n塗れになるまで、もっとかけてくれぇ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104404" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んんっ……子宮で直接受け止められなかったのは残念だが、\nこうして貴様にマーキングされるのは、これはこれで、悪くないな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「んんっ……！　流石にもう打ち止めか……ふふっ、どうだ、満足するまで出\nし切ったか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104406" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「よかった……私も満足だ。本来は貴様に罰を与えたかったのだが……まぁ、\nこういう日があっても悪くないよな、うん……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104407" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「な、なんだその笑い方は！　こ、こら、頭を撫でるなと言っているだろう！\n　くぅぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104408" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「まぁ、いい……もう少し、このままくっついていてもいいか？　ふふっ……\n心満意足、貴様の身体は暖かくて心地いいな……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104409" ]},
		{"command":[ "SETIMAGE", "0", "still_00000141_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ルナテミス" ]},
		{"command":[ "SETTEXT", "「安心しろ、貴様が不甲斐なくとも、私が支えてやる。これからも末永くよろ\nしく頼むぞ、私の愛おしい下僕……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_001_4104410" ]},
		{"command":[ "WAITINPUT" ]},

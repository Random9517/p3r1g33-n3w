{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_03" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「くっ……やっぱり脱出できない……この拘束具、すごい強度……片腕だけで\nも自由になれば、やりようもあるのに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404101" ]},	
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あの怪獣、ほんとに何がしたいのでしょう……私の事捕らえて拘束までした\nのに、その後は何かする訳でもなく、爆発音のした方に向かって行くし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404102" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「ただ……ここだと、少し人目につきますよね……ぱっと見た感じ、近くに逃\nげ遅れた民間人はいないみたいではあるけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404103" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「多分、この拘束具のせい……認識阻害フィールドも使えない……やっぱり、\n羞恥プレイ的に私を恥ずかしがらせること自体が目的？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404104" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あの変態怪獣だと、それもありえそう。とにかく、怪獣が戻って来るまでに\n、この状況をどうにかしないと――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404105" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あ……隊長さん！　助けに来てくれたんですね……！　ふふふ、信じてまし\nたよ、いざという時の隊長さんは、とってもすごくてかっこいいって！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404106" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「もしかして、さっきの爆発音、隊長さんが？　ふふっ、確かに、完璧な陽動\nでしたよ。怪獣は音に連られて向かっていきました」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404107" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「片腕でもいいので、拘束を外してくれれば、自分でどうにかできそうなんで\nすけど……っ！？　隊長さん、怪獣が戻ってきてます！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404108" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_01" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「一度どこかに隠れてっ……ああ、駄目、周りの建物壊され過ぎてて、隠れる\n場所がない……！　えっと、ええっとっ……！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404109" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_02" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「仕方ありません、私の身体の中に隠れてください……！　隊長さんの大きさ\nなら、私のオマンコの膣内に身体ごと入って隠れられますよね！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404110" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「そうはならんやろ、じゃないんです！　そうするんです！　隊長さんまで捕\nまっちゃったら、本当に終わりなんですから！　ほら、早くっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404111" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んんっ……よかった、間に合った……あっ、んっ……隊長さん、苦しいとは\n思いますが、少しだけジッとしててくださいね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404112" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「怪獣が戻ってきました……ああでも、やっぱり一定の距離からは近くにこな\nいみたいで――んぅんっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404113" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「た、隊長さん、どうしました、いきなりジタバタし始めて、んぅんっ！　さ\nっきの戦いの興奮が抜けきってないから、そんなに動かれると……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404114" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんっ……！　ごめんなさい、もしかして苦しいですか？　オマン\nコ、そんなに締め付けてるつもりはないんですけどっ、あぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404115" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「そうやって、腕をジタバタされちゃうと……んぅんっ……！　多分、肘だと\n思うんですけどっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404116" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「オマンコ壁の、気持ちいい部分にちょうどいい感じに当たって、もっと締め\n付けちゃうことになっちゃいますから、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404117" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「駄目、当たり前だけど隊長さんに声、届いてないよね……あぁんっ……！　\nオマンコの中で暴れられちゃうと、また街中で気持ちよくなっちゃう……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404118" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「それにこれ、隊長さん、またおちんぽも固くしてる、よね？　んんっ！　オ\nマンコの壁に擦り付けるようにして、気持ちよくなってる気がするっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404119" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んぅんっ……！　全身をグネグネさせる動き、駄目っ、あぁ\nんっ！　隊長さんの身体の凸凹をはっきり感じちゃう……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404120" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「締め付けない様にしないと、おまんこの中で隊長さんが潰れない様に、力を\n抜かないといけないのにっ……あっ、んぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404121" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「……っ！？　あれ、逃げ遅れた民間人？　倒れた建物の陰になって、怪獣に\nは見つかっていないみたいだけど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404122" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「うっ……私、見られちゃってる……街中で貼り付けにされた上に、オマンコ\nに隊長さんを入れて、気持ちよくなってるの、見られちゃってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404123" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_04" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「――きゃんっ！　あ、あの怪獣、また鞭みたいな触手でっ！　あうっ、くん\nんっ……！　私が恥ずかしがってるの分かって、攻撃してきてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404124" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_05" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あうっ、ぐっ、あぁぁんっ……！　こんな、最悪な状況なのに、私また、気\n持ちよくなって……んぅんっ！　こ、これが羞恥プレイっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404125" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「ああっ……！？　ごめんなさい隊長さん、オマンコの膣内、ぎゅーって締め\n付けちゃいましたよねっ！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404126" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あぁんんっ！　苦しいのはわかりますけど、両脚をジタバタしてもがくのも\nやめてくださいっ、あっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404127" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_07" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「オマンコの壁、ガンガン蹴られてっ、んぅんっ！　隊長さん、おちんぽもっ\nと固くしてっ……これ、わざとぐりぐり押し付けてきてますよねっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404128" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「隊長さん、そういうところあるからっ……あっ、あぁんんっ！　このままだ\nと、私またイっちゃう、街中で恥ずかしいままイっちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404129" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「人目に晒されて、怪獣には触手で打たれて、オマンコに人を挿入して、イっ\nちゃうなんてっ……すごい、変態みたいっ……んんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404130" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「だめ、そういう恥ずかしいこと考えると、変な気持ちになっちゃうって学ん\nだばかりなのにっ、あっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404131" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「た、隊長さん、苦しいのかさっきから息が荒くなってるっ！　おまんこの中\nにふーふー息を吹きかけられるの、すごいっ、んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404132" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、あぁんんっ！　また、ジタバタが大きくなった！　隊長さん\n、全身擦り付けるみたいにして、気持ちよくなろうとしてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404133" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「このヒクヒクしてる、感触、オチンポですよねっ、あぁんっ！　隊長さんも\n出したいんだ、私のおまんこの中にいたまま、オチンポミルク……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404134" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_06" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んあんんっ！　んんっ！　駄目、イっちゃうっ！　こんな街中で、愛しい隊\n長さんをオマンコに入れたままイっちゃうっ、イクッ、イクぅぅンンっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404135" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_08" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んあぁんんんっ～～～！！　隊長さんも一緒に出してるのが分かりますっ…\n…！　ドクドクって、熱いオチンポミルクを直接中で出されてるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404136" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_13" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「ひゃんんっ……！　あ、あの怪獣、また私がイクのに合わせるみたいに、敏\n感な乳首ばっかり狙ってっ、あっ、んぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404137" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「今はダメ、イッてるところだから、オマンコの膣内ぎゅーぎゅーしちゃって\nるのにっ……あっ、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404138" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_12" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「これ以上気持ちよくなって、締め付けちゃうと、隊長さんの事、オマンコの\n膣内で本当に潰しちゃうことになっちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404139" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「隊長さん、もう少しだけ堪えてくださいっ……んんっ……私も、どうにか気\n持ちよくなり過ぎないように、頑張りますからね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404140" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_11" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んんっ……変態怪獣が、どこかに行く……？　私が恥ずかし\nがりながらイクのを見たから、満足したのかしら……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404201" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_26" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「いえ、またすぐに戻ってくる可能性もあるわよね……隊長さん、今のうちに\nオマンコから出て――って、言葉は届かないんだった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404202" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_27" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「これ、どうすればいいかしら……両手は使えないから指で隊長さんを引っこ\n抜くこともできないし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404203" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_25" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「オマンコの動きだけで、隊長さんを押し出す？　こんな街中、人目がある場\n所で、オマンコに必死に力を入れて、隊長さんを産むみたいにひり出すの？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404204" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「すごく恥ずかしいけど……あの怪獣がまた戻ってくる前にやりきらないと…\n…悩んでる暇なんてないわよね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404205" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_27" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「すぅー、はぁー……よしっ……！　んんっ、隊長さん、出てきてくださいっ\n……んんっ、んぅんっ……私のオマンコの中から、出てきてっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404206" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んぅんんっ……！　でもこれ、やっぱり恥ずかしすぎるかも\nっ……んんっ、んんん～～っ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404207" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_29" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「――ひゃぁんっ！　た、隊長さん、どうしてまた、そんなにバタバタ暴れ始\nめるんですかっ！？　あっ、んぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404208" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_27" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「おまんこグネグネさせちゃってるから、隊長さん、また苦しくなっちゃって\nるんですねっ、あっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404209" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「さっきよりも大きく暴れられたら、くぅうんんっ！　入り口の浅い所、蹴ら\nないでっ、んぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404210" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_25" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「駄目っ……！　これ、前に隊長さんをバイブみたいにして気持ちよくなった\nの思い出しちゃうっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404211" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、あぁんんっ！　んぅうんっ！　マン肉をガンガン蹴られてるっ！　G\nスポットにちょうど当たるみたいになってっ、あっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404212" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_29" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「やっぱり意識しちゃうと、隊長さんの身体の形を、オマンコの膣内ではっき\nり感じちゃう様になっちゃうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404213" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_27" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、んぅんっ！　スペースを確保するためかしら、両手でグイグイオマン\nコの壁を押し出す動きも、気持ちいいっ、あぁんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404214" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ……んんっ、んぅんっ……！　あと少しで隊長さんをオマンコ出\nせそう、だけどっ……くぅんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404215" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_25" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「駄目、このままじゃ私の方が先にイっちゃう！　オマンコの膣内で隊長さん\nを感じながら、またイっちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404216" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_27" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あと少し、あと少しっ……んんっ、んぅんんっ……！　んあぁんっ！　待っ\nて隊長さん、体勢が変わったから伸ばした腕が子宮口にぶつかってっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404217" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、んんっ、んあぁんんっ！　また両脚もバタバタして、マン肉蹴っ飛ば\nしてきてるっ！　ひゃ、ふあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404218" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「それにこれ、隊長さんオチンポヒクヒクさせてるっ！　オマンコで全身圧迫\nされて、隊長さんもまたミルクを出したくなってるっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404219" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あと少しなのにダメ、イク、またイっちゃうのっ！　隊長さんをオマンコか\nら産み落とす前に、またイっちゃううぅぅんっ～～！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404220" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_29" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SELECT", "膣内から外に射精","LABEL1","膣内で射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んあぁんんっ！　こ、これはっ……！　おちんぽの角度の問題かしら、私の\nおまんこから隊長さんのおちんぽミルクが発射されてるみたいっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404301" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_15" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あっ、んあぁんんっ！　すごい勢いっ……まるで私が、射精しちゃってるみ\nたいっ……熱いのが、ドクドクってオマンコから溢れてっ、あぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404302" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「ああ、見られてる、息をひそめてる民間人の人たちに、恥ずかしくオマンコ\n射精してる瞬間、見られてるわっ！　んぅんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404303" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_14" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「これ、本当に癖になっちゃったらどうしましょう……認識阻害フィールを張\nらずに、外でセックスするのって、解放感があって、いいかも……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404304" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んぅんんっ……！　隊長さんのおちんぽミルク、まだ出てる……あぁんっ…\n…膣内から出ていっちゃうの、少しもったいない気もするわね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404305" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_16" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「あふうっ……んっ……とりあえず、射精は終わったみたいだけど……隊長さ\nん、まだ出てこれないわよね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404306" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「私も一緒にイッちゃったから、オマンコグネグネして、隊長さん奥まで戻っ\nちゃった……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404307" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_18" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「ああ、でも……んんっ！　さっきイった時に腕もビクンってして、拘束が壊\nれそう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404308" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「怪獣が戻ってくる前に拘束を破壊して、民間人を救助して……隊長さんたち\nと避難……よしっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404309" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「恥ずかしい姿を見せちゃったけど、私はヒーロー……反撃開始よ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404310" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_16" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEOUT", "SLOW" ,"WHITE"]},
		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「んっくぅぅんんっ！　隊長さんの熱いおちんぽミルク、またドクドクって出\nてるぅっ！　あっ、んあぁんんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404401" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_24" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「だめ、折角隊長さん、入り口まで近づいてたのにっ、くぅんっ！　私もイッ\nちゃったから、おまんこグネグネして、奥まで入っていっちゃうっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404402" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_23" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「隊長さんの全てが欲しいって、一番奥で感じたいってっ、おまんこで呑み込\nんでいっちゃうわっ……！　あっ、んぅんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404403" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「でもやっぱり、お腹の中から隊長さんの全てを感じるの、気持ちいい……愛\nしてるって気持ちが湧き出てきて、とっても気持ちいいわ……んぅんっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404404" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_20" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「それに……これ、羞恥を覚えながらするセックス……本当に癖になっちゃい\nそうかも……私、ヒーローなのにっ……んあぁんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404405" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「はぁ、はぁ、はぁ……流石にもう、出ないわよね……今度こそ本当に、隊長\nさんをおまんこから出してあげないと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404406" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「とりあえず、もう少し力を入れれば腕の拘束は壊れそうだから……あれ、隊\n長さん、さっきからなんだか動きが弱くなってきたような……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404407" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_21" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「た、隊長さん？　もしかして、私のおまんこの中で窒息とか、愛液でおぼれ\nたりとかしてませんか！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404408" ]},
		{"command":[ "SETIMAGE", "0", "still_00021004_02_22" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「いくらえっちな隊長さんでも、そんな死に方いやですよね！？　ま、待って\nてください、すぐに開放してあげますから！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404409" ]},
		{"command":[ "WAITINPUT" ]},

		{"command":[ "SETNAME", "ミラクルマム" ]},
		{"command":[ "SETTEXT", "「隊長さん力を抜いちゃ駄目！　諦めちゃ駄目です！　隊長さん？　隊長さー\nーん！？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_210_0404410" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}
{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "WAR_BGM7" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「悪の女幹部なんて、本当に存在したのねぇ。悪の女幹部……。幹部、幹部か\nぁ……。わたしも少しだけ、憧れる……かも」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103101" ]},
		{"command":[ "SETCHARA", "0", "char_00030001_01", "0", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ねえ、あなただったら、幹部になったわたしに何をしてほしい？　いたずら\n？　拘束？　わたしは……やっぱり、ダメな部下を折檻してみたいわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103102" ]},
		{"command":[ "SETCHARA", "0", "char_00030001_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あなたも、わたしに叱られるのは嫌いじゃないでしょう？　……って、きゃ\nあっ！？　お、おち○ぽが勃起しているじゃないの！　も、もぉっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103103" ]},
		{"command":[ "SETCHARA", "0", "char_00030001_01", "3", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「何を考えているのよぉ。……で……でも……そういう方向がいいなら……。\nごくっ。プランを変更するわ。脱いでちょうだい。そうよ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103104" ]},
		{"command":[ "SETCHARA", "0", "char_00030001_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「わたしが今から、うんといやらしい折檻をしてあげる。いいかしら？　想像\nしてみて……わたしは悪いわる～い女幹部よぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103105" ]},
		{"command":[ "SETCHARA", "0", "char_00030001_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_01" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んんっ♪　悪い幹部なんだから、こうやって……。あなたのおち○ぽをお仕\n置きしちゃうの。どう？　怖い？　なぁんて……ふふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103106" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「随分嬉しそうじゃない……♪　んっ、もう……♪　これじゃあお仕置きなの\nか、ご褒美なのかわからないわねぇ。……え？　なあに？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103107" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「もっともっと、悪の女幹部にお仕置きされている感じを出しながらしてほし\nい……？　注文の多い部下ねぇ。でも、いいわよ。なりきるのね……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103108" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……あぁら？　あなた。上司に対して、この生意気なおち○ぽ具合はどうい\nうことなのかしらぁ？　あなたは今、わたしに叱られているんでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103109" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「それなのに、こんなところばかり元気にして。フン、隠そうとしても無駄よ\nぉ。あなたのおち○ぽのことは、幹部のわたしが誰よりも知り尽くしている」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……んっ。この硬さ……大きさ。蒸れたニオイ……。いつもより太くしてい\nるみたいだけど？　もっと徹底的に調査して折檻しなくちゃねぇ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103111" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ん……んんっ、わたしの胸……。はぁっ、柔らかいところをぎゅうっと押し\n付けられるのが、……はぁっ、好きみたいね……？　違うかしらぁ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……もごもご言っていないで、ハッキリ答えなさい！　どうなのっ？　好き\nなんでしょうっ……。あっ♪　こうやって刺激されるのがっ……んんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「大きな胸におち○ぽを押し潰されて……！　んっ、めちゃくちゃにシゴかれ\nると感じるんでしょうっ？　知っているわよ、あなたがわたしの……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103114" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「この膨らみをいつも盗み見て、１人で興奮していたのを、ねっ……！　まっ\nたく……いやらしいおち○ぽね、わたしにバレてないとでも思ったの……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103115" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んっ、ほぉらっ……♪　左右から乳房に挟まれて……。もみくちゃにされる\nと気持ちいいのよね？　ん、んっ、んんっ……！　正直に白状なさい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103116" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「本当はこうしてお仕置きをしてほしいから、わざとミスをしたのよねぇ？　\nはぁっ、はぁ、そうでなくちゃ、このおち○ぽの熱さは異常だわっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103117" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「わたしに……んんっ、胸で絞られてっ……！　はぁっ……、おち○ぽの先っ\nちょから、透明なお汁をにじませている……。期待していたのよ、ねっ？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「悪い事をして、……あぁっ♪　わたしのおっぱいにっ、イジメてほしいって\n……んんぅっ、虐げられたいって妄想していたんでしょう……！　んぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103119" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……ふふふふふっ。ごまかそうとすればするほど、おち○ぽがピクピク震え\nて教えてくれるわ。嘘がつけない性格って損ねぇ……。ほらっ、ほらほらっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103120" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「やめてなんてあげないわよぉ……♪　た～っぷりいじめてあげる……。んん\nっ……！　キツぅくおち○ぽをシゴいて……こすって……。はぁっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103121" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「胸をっ、大きく揺らし、ながらっ……あっ♪　容赦ない攻めを続けるわぁっ\n……！　っん……！　んんっ、どうっ？　つらいでしょうっ、んんんんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103122" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「どんどん速度をあげて、力を強める、わよぉ……！　……っん……♪　な、\nなあに？　その顔は……。わたしも気持ち良くなっているんじゃないか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103123" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ば、馬鹿なことを言わないでっ……！　わたしは幹部として、出来の悪い部\n下のしつけをしている、だけよ……！　た、楽しくなんかないしっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103124" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あっ♪　気持ち良くなんてなっている、わけっ……。あんっ、な、無いでし\nょうっ……！　……そんな反抗的なことを言うなら、こうよ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「はぁっ♪　んんっ、あんっ、んんっ……♪　全力で、おち○ぽを磨きぬいて\n、あげるっ……！　二度とわたしに逆らえなくなる、ようにっ……。あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103126" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「どうっ……？　自分の立場、が、よくわかったかしらっ……？　ふふふふ、\nだんだん腰が浮いてきている、わよぉっ……。もう降参かしらぁっ……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103127" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ふふっ、うふふふっ♪　嫌だと言っても、もう離してなんてあげないわぁ…\n…♪　こんなにおち○ぽを熱くしておいてっ、往生際が悪いわよぉっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103128" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「もっともっと追いつめてあげるぅ……！　んんっ……。い、いいわよぉ、ど\nんどん硬さが増して……っ。あぁ……！　胸の中で暴れて、るぅ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103129" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁああっ……♪　よーくおち○ぽにっ、刻んでおきなさいっ。わ\nたしの言うことを聞かないとこうよ！　こうっ、こうっ……！　あぁんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103130" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……もう射精したい？　精液を出してしまいたい……っ？　そ、そのタイミ\nングはわたしが決めるわ！　あなたはっ、ただシゴかれていなさいっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103131" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「まだよ……！　まだ出しちゃだめっ……。限界まで、はぁ、我慢、して……\n！　はぁっ、はぁ、はぁ……！　んっ、んんっ、んんんんっ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103132" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「わ、わかるわねぇ……？　わたしのシゴき方が激しくなって、きたのがっ…\n…！　あっ♪　あぁっ……。わたしが出せと命令したら出すのよっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「いいわねっ……！　まだ……まだよ、頑張りなさい……！　んっ……、こら\nっ、自分から腰を動かすんじゃないわぁ、わたしがする、からっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「じっとして……。はぁっ♪　あぁっ、どうやら限界まで溜まった、ようねっ\n……。それじゃあ見ていてあげるから……出しなさい！　ほらっ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103135" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んっ……！　ンンンっ……！？　い、いいわよっ、そのまま出し続けてっ…\n…！　あっ♪　すごいニオイ……濃厚な精液の香り……！　ああああっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103136" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_09" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「そ、そんなに私の胸が気持ち良かったのね……っ♪　ふふふふっ、はしたな\nくおち○ぽをビクつかせて……！　見ていてあげると言ったでしょうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103137" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「よーく見せなさい、全てをさらけ出して！　んっ……！　射精する時の表情\nも、動きも、……あはぁっ♪　精液の濃さも、色も……監視対象よ！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103138" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あぁっ……♪　あああああっ……♪　胸の中で脈打つこの感じ……っ。クセ\nになりそうだわぁ……！　んっ……まだよ、ありったけ出しなさい！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103139" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んんんっ……！　んんんんっ……♪　すごい量ねぇ……♪　胸の間から、溢\nれてこぼれるくらい……。すごすぎるわぁ……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103140" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「自分でもわかっているんじゃない？　この精液の粘り気……ニオイ、そして\n色……。今までにないくらい上質な精液がほとばしったのが……♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「わたしに責められて、追いつめられて感じてしまうなんて、恥ずかしいと思\nわないの？　……んっ？　も、もうしっかり出たから演技は終わり？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103202" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「な、何を言っているのよ……。あなたがわたしに、悪の女幹部になりきって\nほしいって言ったのよ？　それに……まだお仕置きは終わってないわぁ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……んっ♪　任務もまともにこなせていないのに、射精ばっかり上手なあな\nたの……。元気すぎるおち○ぽには、まだまだしつけが必要よ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103204" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「いやだと言うなら、刺激されても反応しなければいいだけよ？　はぁっ♪　\nどう？　精液でぬるぬるの胸に、包まれてヌルヌルシゴきたてられるのは♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103205" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……んっ、んんっ……♪　ふふふふっ、どうやらおち○ぽも、わたしの胸の\n中にまだいたいみたいよぉ。いい子、いい子……素直なのはいいことよぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103206" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んっ、はぁっ♪　ぬめりを帯びた胸で……、んぁっ♪　柔らかくなりかけた\nおち○ぽを攻めていると、妙な気分に……んっ、なってきたけれど……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103207" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「さすがねぇ♪　すぐに復活してきてる……♪　あっ♪　やだわぁ、むしろさ\nっきよりも元気いっぱいに……！　んぁっ、ふ、太さがどんどん増してっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103208" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「わ、わたしの胸を押し戻してくるぅ……♪　んんっ、ま、負けるものですか\nぁ……！　わたしは悪の女幹部、なのよぉ、あんっ……強いのよ……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103209" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「だから……！　っあっ♪　にゅるにゅるって、濡れたおち○ぽをこすってい\nる間にだって……んんっ、平気な顔をし続けてみせる、んだからぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103210" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……あぁっ♪　んああぁっ♪　すべりが良くなって……んんんっ！　わたし\nの方まで感じちゃう……！　んんんっ、で、でもあなたもそれは同じよねっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……あっ♪　気持ちいいんでしょう？　このお仕置きが好きになってきたの\nよねぇ？　んんっ、幹部の胸に、自由にもてあそばれて……。んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103212" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「おち○ぽ喜んでるものぉっ……♪　はぁああっ♪　ぐにゅぐにゅされて幸せ\nだって、すっごくわかりやすく反応してる♪　あっ……す、すごいわっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「まったく……♪　こんな方向にばっかり才能があって、困った部下ねぇ……\nっ。この才能をっ、んんっ、もっと任務に活かしなさい……！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103214" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んっ……、はぁっ……♪　はぁ、はぁ……♪　ふぅっ……あぁっ♪　んっ、\nあぁっ……♪　仕方ないから、今日は私が射精させてあげるけど……っ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103215" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「これで調子に乗ったりしちゃだめだからねぇっ……！　わ、わかったのっ…\n…？　答えるまで激しくシゴき続けてあげるわ……！　んっんっぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103216" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「嬉しそうにしないでよぉ……。んっ……！　んんっ、は、ぁ、っ♪　限度を\nしらないおち○ぽねっ、どこまでも硬くなって……あっ、んぁあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「今にも爆発してしまいそうじゃないっ……♪　あんっ……んん、ふぅっ、ふ\nぅっ……ふぅううっ♪　あら？　どうしたのぉ、苦しそうねぇ？　ふふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「まさか、また射精させてほしくなったのかしら？　んふふふっ、こらえしょ\nうがないわねぇ。どうしようかしらぁ……。なんて、嘘よ。……んっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103219" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「部下のしつけはきっちり最後までしないとねぇ。ほらっ、出していいわよぉ\n……！　出して……、あっ、胸の奥に……ああああっ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103220" ]},
		{"command":[ "WAITINPUT" ]},
								
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あっ♪　んっ、んんっ……んんんん～っ……！　さっき出したばっかりなの\nに、なんて勢いなのぉっ……！　あっ、んっ、お、抑えきれないぃっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103301" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_13" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あぁっ！　溢れちゃう、だめっ……♪　あぁんっ♪　暴れないでぇ、逃がさ\nないわよぉ……！　んんんっ、音が聞こえそうなくらい激しい射精ねぇっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103302" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「いいっ？　精液出しながらよぉおっく反省するのよ……！　あっ♪　今日の\nお仕置きのこと、絶対に忘れないで……あっ♪　わ、わかればいいの！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103303" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_12" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「そうしたら後は……あぁっ♪　出したいように出していいわ……！　んっ、\nちゃんと出来た部下にご褒美をあげるのも女幹部の役目でしょうっ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103304" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あっ、ネバネバしたあなたの体液……どんどん胸に溜まっていくわぁ……！\n　見えるでしょう、自分の精液で真っ白になったわたしの胸……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103305" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_14" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ぬらぬらっといやらしいぬめりでいっぱい……！　っんっ♪　このニオイ、\n洗ってもきっと当分とれないわよぉ……。だって濃すぎるんですものぉ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……ふぅうっ……。我ながら、なかなかいい演技ができたわ。ねえ？　悪の\n女幹部になった私のこと……どう思った？　良かったかしら？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103307" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「えっ！？　友理奈様のことが大好きです！？　だ、誰がそこまで正直に言え\nって言ったのよぉっ。………ん、う、うん……で、でも……そう……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103308" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「そんなにこういうプレイが好きなら……。って、も、もういいの！　友理奈\n様に夢中ですなんて……。……う、うう……。ふぁい……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103309" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「はっ！？　私自身のことじゃなくってっ！　演技について聞いてたのよ！　\n……本当に……調子狂っちゃう……。あ、ありがと……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103310" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「ひゃぁっ……！？　あぁっ！　あんっ！？　あっぁっ……！　ど、どこに精\n液をかけているのよぉっ……！　そこは顔、よ……！　んぷっ、ぷぁっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103401" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_18" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「あぅっ……んぅううっ♪　もぉおっ……♪　驚かせないでぇ……！　照準が\n外れてしまったことはしょうがないけど……。あっ！？　ドロドロぉ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103402" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「それに顔中に、精液のニオイが広がって……息が止まりそうよぉ……！　ん\nっ、んんっ！？　あっ……全然止まらない、こんなに溜まっていたなんてぇ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……も、もうこうなったら全部出すまであなたも終われないでしょうっ。か\nけて……！　んんっ！　びちゃっ、びちゃって真っ白な雨みたいに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103404" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「んぷっ！　んんっ、んんんぅっ……んんっ！　んぷぁっ……ああっ、ああ…\n…！　にがぁい……！　あっ♪　んっ、顔をつたって雫が垂れて……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「はぁっ、はぁあっ……！　ぽたぽた胸に流れ落ちていくぅ……。どこまでや\nんちゃなおち○ぽなのぉ、あっ♪　あっ、もうだめぇえ……っ♪」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103406" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_19" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「……んんんっ……。相当気に入ってくれたのね、悪の女幹部プレイ……。叱\nられて興奮するなんて、あなたの新しい一面を知った気分よぉ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103407" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_17" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「私も楽しそうにしてた？　ノリノリで演じてた？　そ、それは……。こんな\n機会、なかなかあるものじゃないし……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103408" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「悪の女幹部って、やってみると結構ストレス解消になるのかも。も、もちろ\nん！　ずっと続けるつもりはないけど、たまになら……面白かったわ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103409" ]},
		{"command":[ "SETIMAGE", "0", "still_00030001_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "友理奈" ]},
		{"command":[ "SETTEXT", "「だから、これからも……あなたがどうしてもして欲しい時には、してあげて\nもいいわよぉ。その時は、わたしにだけこっそり教えてね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_300_0103410" ]},
		{"command":[ "WAITINPUT" ]},

{
	"scriptCommands" :  [
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETIMAGE", "0", "bg_0004" ]},
		{"command":[ "DISPIMAGE","0", "TRUE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "PLAYBGM", "BGM_015" ]},
		{"command":[ "SPOTCHARA", "0", "1", "2", "3" ]},
		{"command":[ "WAITMOVE" ]},
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「隊長さま、ごきげんよう。来てくれると思いましたよ。私もそのために仕事\nを全部終わらせましたからね、ふふ……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503101" ]},
		{"command":[ "SETCHARA", "0", "char_00003305_01", "6", "CENTER", "0" ]},
		{"command":[ "DISPCHARA", "0", "TRUE" ]},
		{"command":[ "DISPTEXT", "TRUE" ]},
		{"command":[ "DISPNAME", "TRUE" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「なんの用事かですって？　もう、分かっているのでしょう？　私が気づいて\nいなかったとでも？　ねえ、隊長さま？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503102" ]},
		{"command":[ "SETCHARA", "0", "char_00003305_01", "2", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「この装い、ずっと見てたでしょう？　仕事しているときもずっと、隊長さま\nの視線を感じていましたから……ええ、丸わかりでしたよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503103" ]},
		{"command":[ "SETCHARA", "0", "char_00003305_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「腕とか、脚とか、肩とか……胸とか。この服は肌の露出もそうですが、身体\nのラインも浮き出ますからねえ。いえいえ、責めてるわけじゃないんです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503104" ]},
		{"command":[ "SETCHARA", "0", "char_00003305_01", "6", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「むしろ隊長さまに見てもらいたくて着た服なんですから、見てもらわないと\n困ります。でもね……そんな風に見つめられると、私としてもね……？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503105" ]},
		{"command":[ "SETCHARA", "0", "char_00003305_01", "8", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「身体が熱くなってきて……それに、もっともっと隊長さまに見て欲しくて。\nね、そこのソファに座ってください。それで、ほら……もっと近くに……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503106" ]},
		{"command":[ "SETCHARA", "0", "char_00003305_01", "5", "CENTER", "0" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ほら、これぐらい近くで見てくれていいんですよ。ふふ……隊長さまの視線\n、凄く感じます。とくに……ここにね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503107" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_01" ]},
		{"command":[ "DISPCHARA", "0", "FALSE" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んっ……隊長さま、こうして欲しかったんでしょう？　ずっとここ、見てま\nしたもの。人の望みを率先して叶えるのも上役の役目……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503108" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ふふ、隊長さまのオチンポ、嬉しそうに跳ねてますね。私のここで挟まれる\nの、想像していたんですか？　ほら、ほら」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503109" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「本当に悪いお人ですねえ。人が真面目に仕事して、これだってハロウィンの\n一環での格好ですのに。そんな女を欲情した目で見て……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503110" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「お披露目で登壇していた時も見ていたんでしょう？　色んな殿方の視線を感\nじましたけど……隊長さまのが一番熱くて、思わず興奮して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503111" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「おかげで、仕事よりもこの時間のことばかり考えるようになってしまって…\n…ですから、隊長さまにはおしおきです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503112" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「私をこんな風にさせる悪いオチンポ、しごいてしごいて、吸血鬼のようにザ\nーメンを吸い尽くしてさしあげますよ……こんな風に、ふうっ、うっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503113" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ほら、ほら、隊長さまはおっぱいで密着されるのが好きですか？　それとも\nこうやってぎゅっぎゅって揉まれるのが好きですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503114" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「両方ですか。あんっ、全く強欲なお人ですね。でもそこが好き……いえ、な\nんでもありません。じゃあ両方でしてさしあげますからね、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503115" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「こうして密着してから……ぎゅぎゅって動かして、あんっ、ふっ、あ、これ\n私も気持ちいい……んっんっんっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503116" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ああ、隊長さまのお顔も気持ちよさそうで……おっぱい、本当にお好きなん\nですね。今もじっと見つめて、んっ、あっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503117" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「隊長さまのオチンポが胸の中に出たり入ったり、分かりますか？　ふふ、汗\nと先走りで谷間がにゅるにゅるになって……ふあっ、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503118" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「あっ、凄い、おっぱいの中でオチンポが暴れてる……んんっ、大人しくして\nください、あっ、ああっ、んっ、おっぱいの中で、熱い、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503119" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「隊長さまのオチンポ、熱くて硬くて……私のおっぱいを自分のモノにしよう\nって、そんな気持ちが伝わってきます、あっ、んうううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503120" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ふふ、そんなに張り切らなくても、今となっては私の身体を好きにできるの\nは隊長さましかおりませんよ……あんっ、あっ、またっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503121" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「今の言葉を聞いてますます興奮したって……しようのない人ですね。私の服\nに興奮して、私の言葉に興奮して……ふふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503122" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「隊長さまも大概私のことを好きなんですね。相思相愛ってやつですか、悪く\nないです……だから、もっともっとこのおっぱいで愛してさしあげます」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503123" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んんっ、ふうっ、こうしてオチンポを挟んで揉んで、この格好を初めて見た\nときからこうして欲しいって思っていたんでしょう。ほらっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503124" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ふふっ、オチンポの先からお汁がだらだらとこぼれていますよ……ええ、分\nかってます。私の口で、吸血鬼の口でしゃぶって欲しいんでしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503125" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「いいんですよ。隊長さまのオチンポ、おっぱいで挟みながら口で、あー……\nむっ、んっ、んむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503126" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「れるっ、れろっ、こうして、吸いながら舐めると……んっ、ふうっ、嬉しそ\nうに先っぽからお汁が漏れていますね……んくっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503127" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「いいですよ。いくらでも出してくれて……この装いの通りに、全部吸い尽く\nして差し上げますから……んっんっんっ、んむうっ、れるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503128" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「それとも、唇で吸いつく方がいいですか？　ちゅっ、んっ。先端がぶるぶる\n震えて……もう言わなくても分かりますよ。どっちも好き、でしょう？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503129" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「なら、こうして……んむっ、れるっ……ちゅっ、んんっ、ふふっ、おっぱい\nと口と、隊長さまのオチンポが気持ちよさそうに震えてます……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503130" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「先端からだくだくお汁が溢れて、竿が硬くなって、熱くなって……出したい\nんですね？　私に隊長さまの精液……ちゅっ、れるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503131" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「いいですよ。私の口に、この口の中に、隊長さまの精液、沢山出してくださ\nい……この装いの通りに、全部吸い尽くしますから。んむっ、んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503132" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んっんっんっ、ちゅっ、ほら、出して、隊長さまの気持ちいいの、出してく\nださい。口の中に、遠慮せず、さあ、んっ、んんっ、れるっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503133" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んむうっ、先っぽが膨らんできて……さあ、出して、隊長さまの気持ちいい\nの、たっぷりと、私に吸わせて……んむっ、ちゅっ、んぐうっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503134" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「あっ、来た、隊長さまのオチンポ、びくびくって……来た、あっ、ああっ、\nんんんんんっ、オチンポから精液来たっ！！　んむっ、んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503135" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_12" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},	
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んぐうううっ、んっ、んんっ、んくっ、んふうっ、ふっ……たっぷりと出し\nましたね、喉に絡みついて、濃くて……匂いも凄くて……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503136" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んくっ、んっ、んぐっ……口の中、隊長さまのでいっぱい……んふうっ……\nたまらないですね、この味……やみつきになりそうです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503137" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_11" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んふっ、竿の中に残ってるのも吸い尽くしますから……ちゅっ、んっ、んむ\nっ、ふうっ……んふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503138" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_10" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ふううっ、ごちそうさま……隊長さまの気持ちいいしるし、たっぷりと飲ま\nせていただきました。ふふ、精がつくとは文字通りですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503139" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んっ、まだ出て……れるっ、ちゅっ、ふう。おいし……お残しはいけません\nからね。全部いただかないと」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503140" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_05" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「出したオチンポを綺麗にするのも女の務め……隊長さまはじっとしていてく\nださいね。れるっ、ちゅっ……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503201" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「先端も、カリ首も、竿も、根元も……全部、口と舌できれいにしますから。\nんんっ、ふうっ、れるっ、ちゅっ、んくっ、ふっ……おいし」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503202" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「こうして舌で舐め取って……唇で吸い取って……んふうっ、隊長さまは残り\n汁も美味ですね……んっ、ふっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503203" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んんっ、んむっ……あら？　隊長さまのオチンポ、また硬くなってきました\nよ。どうしたんですか？　さっきので物足りなかったんですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503204" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ふふっ、冗談です。もう一回……ですね？　いいですよ。またこうしてぎゅ\nって挟んで、先端にキスして……ちゅっ、れる、んむっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503205" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_04" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「あんっ、んっ、さっきよりも硬くなってきましたね……じゃあ、私もさっき\nよりも強く挟んで、こすってさしあげます……んっ、ふうっ、ふっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503206" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_06" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「先端はこうして舐めて咥えて……んむっ、ちゅっ、れるっ、れろっ、んくっ\n。またお汁が漏れてきましたね。元気なオチンポで逞しいです……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503207" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_07" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「おっぱいで上下に擦りながら口で吸いついて……んふうっ、隊長さまの顔、\n気持ちよさそう……さっきの精液でまたぬるぬるになって、あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503208" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「私も気持ちよくなってきた……んっ、本当に吸血鬼になったみたい。隊長さ\nまの精で昂ぶってる……んうっ、んくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503209" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「だから、もっと……隊長さまの精液、もっとください。全部吸い尽くしてみ\nせますから。ちゅっ、んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503210" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んむっ、ちゅぶっ、れるっ、れろ、ちゅっ……ふううっ、凄い、ばっきばき\nに硬くなって、お汁がだらだらこぼれてきて……んっ、男の匂いが……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503211" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ああ、隊長さまの視線も、口とおっぱいに……それだけで熱くなって、んっ\n、オチンポも私の口で気持ちよくなりたいって震えて……んんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503212" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んうっ、あっ、こんなに情熱的に求められたら、女として……隊長さまの女\nとしても……んっ、ああっ、んっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503213" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ああっ、好き、隊長さま、好き、隊長さまも、隊長さまのオチンポも！！　\nおっぱいと口で、全力で愛してあげますっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503214" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「だから隊長さまも、気持ちいいの、全部出してください！！　私の好きなと\nころに、口でも、おっぱいでも、顔でも、全部っ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503215" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_08" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んんっ、んっ、ちゅっ、れろっ、んっ、おっぱいの中で、オチンポが跳ねて\n暴れてます。そろそろイきそうなんですね、んむっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503216" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ちゅっ、ちゅっちゅっちゅっ、いいですよ！！　いつでも好きなときにイっ\nてください！！　キスがいいですか、揉むのがいいですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503217" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「それとも、吸血鬼のように吸うのがいいですか？　こんな風に……ちゅうう\nううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503218" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んっ、んんっ、あっ、来た、隊長さまの精液、せり上がってきてるの分かる\n、ふうっ、じゃあ、最後にもう一回、咥えながら……んむっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503219" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_09" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ちゅっ、ちゅううっ、れるっ、れろっ、んんんんっ、出して、隊長さまの精\n液、いっぱい出してっ！！　ちゅうううううっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503220" ]},
		{"command":[ "WAITINPUT" ]},
																			
		{"command":[ "SELECT", "そのまま射精","LABEL1","外して射精","LABEL2" ]},

		{"command":[ "LABEL", "LABEL1" ]},
		{"command":[ "FADEIN", "NORMAL" ]},
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んふうううううっ、んっ、また、口にいっぱい……んんっ、んぐっ、んっ、\nふうううっ、んっんっんっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503301" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_14" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「二回目なのになんて濃い……あんっ、まだ出てきて……んっ、はっ、んくっ\n、こくっ、んっ、ふっ、口の中が精液でいっぱいに……んうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503302" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_13" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んぐっ……ふっ、ごちそうさまでした。隊長さまの精液、とっても美味でし\nたわ。ふふふふ、こういう風に言えば、吸血鬼らしいですかね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503303" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ふふ、でも隊長さまの精液、本当においしくて、飲んだら幸せになって……\n愛する人のものならなんでもそう思えるものですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503304" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んふっ、この残り汁も……んっ、れるっ、ちゅっ……本当に吸ってるだけで\n元気になるみたいで……んくっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503305" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「隊長さまも同じ気持ちって……私にぶっかけただけで元気になるって、ふふ\n、それって気持ちよかっただけじゃないですか？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503306" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「いえいえ、そういうことにしておきますか。ずっと私を視線で追ってた、エ\nッチで節操なしで、それでも愛しい私の隊長さま……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503307" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_01" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「こんな大量で濃いものを口じゃなくて中に出されたら……一回で子を孕んで\nしまいそうですね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503308" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「まあでも、それは次のお楽しみにしておきましょう。この装い、隊長さまの\nお気に入りみたいですしね。ですから――」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503309" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_02" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「今日だけじゃなく、また私の相手をしてくださいね？　でないと……本当に\n吸血鬼みたいに隊長さまを吸い尽くしてしまうかも、ですよ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503310" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_03" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "JUMP", "END" ]},

		{"command":[ "LABEL", "LABEL2" ]},
		{"command":[ "FADEIN", "NORMAL" ]},	
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「あっ、んっ、オチンポが、隊長さまのオチンポ、おっぱいから外れて、んあ\nあああああっ、あっ！！」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503401" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_17" ]},
		{"command":[ "FADEOUT", "NORMAL" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ふうううっ、熱い……顔とおっぱいに、隊長さまの精液が……んっ、んんっ\n、ふうっ、ふはあっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503402" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「んんんっ、ふうっ、口の中もいいですけど、こうしてかけられるのも……ん\nっ、悪くないですね。隊長さまのモノになった気がします……あんっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503403" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「ふふ、他の男ならこんなことをされるのは願い下げですが、隊長さまなら…\n…隊長さまだけになら許せます。んっ、ふうっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503404" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_15" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「こんなどろどろにされて、濃い精液の匂いと味を染みつけさせられて、それ\nでも嬉しく思ってしまうなんて……んっ」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503405" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「吸血鬼は他人を魅了して血を吸うなんて言われていますが、こんな格好をし\nていても私は隊長さまに魅了されてしまっていますね」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503406" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「え？　隊長さまも私に魅了されてしまっているって……ふふ、時折とんでも\nなく口がうまくなりますね、あなたは。でも悪くないです」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503407" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「あんっ、精液まみれの笑顔を見てオチンポをびくびくさせるなんて、もう、\nさっき言ったいい言葉が台無しですよ。まったく」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503408" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_16" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「でもそんな隊長さまだから、私の相手をしてくれるんですよね。いまだって\nこんなに興奮して……」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503409" ]},
		{"command":[ "WAITINPUT" ]},
		
		{"command":[ "SETNAME", "七重" ]},
		{"command":[ "SETTEXT", "「隊長さん、またいっぱいしましょうね。顔でも口でもおっぱいでも、どこで\nも好きなようにかけていいですから……ね？」", "NORMAL" ]},
		{"command":[ "PLAYVOICE", "v2_033_0503410" ]},
		{"command":[ "SETIMAGE", "0", "still_00003305_01_17" ]},
		{"command":[ "WAITINPUT" ]},
		{"command":[ "LABEL", "END" ]},
		{"command":[ "EXIT" ]}
	]
}